import {
  json_read,
  json_read_field,
  json_read_index,
  json_text_live_handle_count,
  JsonRead,
  JsonReadNull,
  JsonReadBool,
  JsonReadNumber,
  JsonReadString,
  JsonReadArray,
  JsonReadObject,
  JsonReadMissing,
  JsonReadErr
} from '../../lib/mlc/common/stdlib/data/json_text.mlc'

fn request_body(name: string) -> string =
  "{\"name\":\"" + name + "\"}"

fn is_null(value: JsonRead) -> bool =
  match value {
    JsonReadNull => true,
    _ => false
  }

fn bool_flag(value: JsonRead) -> i32 =
  match value {
    JsonReadBool(flag) => if flag then 1 else 0 end,
    _ => -1
  }

fn number_text(value: JsonRead) -> string =
  match value {
    JsonReadNumber(text) => text,
    _ => ""
  }

fn string_text(value: JsonRead) -> string =
  match value {
    JsonReadString(text) => text,
    _ => ""
  }

fn array_text(value: JsonRead) -> string =
  match value {
    JsonReadArray(text) => text,
    _ => ""
  }

fn object_text(value: JsonRead) -> string =
  match value {
    JsonReadObject(text) => text,
    _ => ""
  }

fn is_missing(value: JsonRead) -> bool =
  match value {
    JsonReadMissing => true,
    _ => false
  }

fn error_text(value: JsonRead) -> string =
  match value {
    JsonReadErr(text) => text,
    _ => ""
  }

fn main() -> i32 = do
  if json_text_live_handle_count() != 0 then return 1 end
  if is_null(json_read("null")) == false then return 2 end
  if bool_flag(json_read("true")) != 1 then return 3 end
  if bool_flag(json_read("false")) != 0 then return 4 end
  if number_text(json_read("9007199254740993")) != "9007199254740993" then return 5 end
  if string_text(json_read("\"a\\\"b\"")) != "a\"b" then return 6 end
  if array_text(json_read("[1,\"b\"]")) != "[1,\"b\"]" then return 7 end
  if object_text(json_read_field("{\"user\":{\"id\":1}}", "user")) != "{\"id\":1}" then return 8 end
  if is_missing(json_read_field("{\"id\":1}", "missing")) == false then return 9 end
  if error_text(json_read("{")) == "" then return 10 end
  if error_text(json_read_field("[]", "name")) != "json value is not an object" then return 11 end
  if string_text(json_read_index("[1,\"b\"]", 1)) != "b" then return 12 end
  if is_missing(json_read_index("[1]", 3)) == false then return 13 end
  if error_text(json_read_index("{}", 0)) != "json value is not an array" then return 14 end
  if string_text(json_read_field(request_body("ada"), "name")) != "ada" then return 15 end
  json_text_live_handle_count()
end
