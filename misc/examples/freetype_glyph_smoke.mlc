// FreeType raster via MLC text_shaping (thin freetype_abi).
import {
  text_shaping_new,
  text_shaping_shape,
  text_shaping_glyph_id_at,
  text_shaping_rasterize_glyph
} from '../gui/text_shaping'

fn main() -> i32 = do
  const font_path = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
  let mut state = text_shaping_new()
  const shaped = text_shaping_shape(state, font_path, 32, "A")
  if shaped.error_code != 0 || shaped.glyph_count < 1 then
    return 1
  end
  const glyph_id = text_shaping_glyph_id_at(0)
  if glyph_id <= 0 then
    return 1
  end
  const raster = text_shaping_rasterize_glyph(shaped.state, font_path, 32, glyph_id)
  if raster.error_code != 0 then
    return 1
  end
  const width = raster.width
  const rows = raster.rows
  if width < 8 || rows < 8 then
    return 2
  end
  if width > 64 || rows > 64 then
    return 3
  end
  0
end
