import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import { https_send } from '../../lib/mlc/common/stdlib/net/https_client.mlc'
import {
  HttpsRequest,
  HttpsResult,
  HttpsOk,
  HttpsErr
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn request_for(proxy_url: string) -> HttpsRequest =
  HttpsRequest {
    method: "GET",
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + "/echo",
    headers: [],
    body: "",
    timeout_milliseconds: 5000,
    max_response_bytes: 4194304,
    ca_bundle_path: get_or("HTTPS_TEST_CA", ""),
    proxy_url: proxy_url
  }

fn status_of(result: HttpsResult) -> i32 =
  match result {
    HttpsOk(response) => response.status,
    HttpsErr(_) => -1
  }

fn main() -> i32 = do
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" || get_or("HTTPS_TEST_PROXY", "") == "" then
    return 1
  end
  if status_of(https_send(request_for(get_or("HTTPS_TEST_PROXY", "")))) != 200 then return 2 end
  if status_of(https_send(request_for(""))) != 200 then return 3 end
  0
end
