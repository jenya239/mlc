import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import {
  https_session_open,
  https_session_close,
  https_session_send,
  https_live_session_count,
  https_live_handle_count
} from '../../lib/mlc/common/stdlib/net/https_client.mlc'
import {
  HttpsRequest,
  HttpsResponse,
  HttpsResult,
  HttpsOk,
  HttpsErr
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn request_for(body: string) -> HttpsRequest =
  HttpsRequest {
    method: "POST",
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + "/session_echo",
    headers: [],
    body: body,
    timeout_milliseconds: 5000,
    max_response_bytes: 4194304,
    ca_bundle_path: get_or("HTTPS_TEST_CA", "")
  }

fn status_of(result: HttpsResult) -> i32 =
  match result {
    HttpsOk(response) => response.status,
    HttpsErr(_) => -1
  }

fn body_of(result: HttpsResult) -> string =
  match result {
    HttpsOk(response) => response.body,
    HttpsErr(_) => ""
  }

fn main() -> i32 = do
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" then return 1 end
  const session = https_session_open()
  if session < 0 then return 2 end
  const first = https_session_send(session, request_for("one"))
  if status_of(first) != 200 || body_of(first) != "one" then
    https_session_close(session)
    return 3
  end
  const second = https_session_send(session, request_for("two"))
  https_session_close(session)
  if status_of(second) != 200 || body_of(second) != "two" then return 4 end
  if https_live_session_count() != 0 then return 5 end
  if https_live_handle_count() != 0 then return 6 end
  0
end
