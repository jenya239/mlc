import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import { https_send_async } from '../../lib/mlc/common/stdlib/net/https_async.mlc'
import {
  HttpsRequest,
  HttpsResult,
  HttpsOk,
  HttpsErr
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn request_for(method: string, path: string, body: string) -> HttpsRequest =
  HttpsRequest {
    method: method,
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + path,
    headers: [],
    body: body,
    timeout_milliseconds: 5000,
    max_response_bytes: 4194304,
    ca_bundle_path: get_or("HTTPS_TEST_CA", ""),
    proxy_url: ""
  }

fn ok_body(result: HttpsResult) -> string =
  match result {
    HttpsOk(response) => response.body,
    HttpsErr(_) => ""
  }

fn is_ok(result: HttpsResult) -> bool =
  match result {
    HttpsOk(_) => true,
    HttpsErr(_) => false
  }

fn user_request(identifier: string) -> HttpsRequest =
  request_for("POST", "/echo", identifier)

fn orders_request(user: HttpsResult) -> HttpsRequest =
  request_for("POST", "/echo", ok_body(user))

fn main() -> i32 = do
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" then
    return 1
  end
  let user = block_on(https_send_async(user_request("user-1")))
  if is_ok(user) == false then
    return 2
  end
  let orders = block_on(https_send_async(orders_request(user)))
  if is_ok(orders) == false || ok_body(orders) != "user-1" then
    return 3
  end
  println("https_send_async_sequential body=user-1")
  0
end
