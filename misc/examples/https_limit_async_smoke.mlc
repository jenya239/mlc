import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import { https_send_async } from '../../lib/mlc/common/stdlib/net/https_async.mlc'
import {
  HttpsRequest,
  HttpsResult,
  HttpsOk,
  HttpsErr,
  ResponseTooLarge
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn request_for(max_response_bytes: i32) -> HttpsRequest =
  HttpsRequest {
    method: "GET",
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + "/compressed",
    headers: [],
    body: "",
    timeout_milliseconds: 5000,
    max_response_bytes: max_response_bytes,
    ca_bundle_path: get_or("HTTPS_TEST_CA", ""),
    proxy_url: ""
  }

fn body_of(result: HttpsResult) -> string =
  match result {
    HttpsOk(response) => response.body,
    HttpsErr(_) => ""
  }

fn status_of(result: HttpsResult) -> i32 =
  match result {
    HttpsOk(response) => response.status,
    HttpsErr(_) => -1
  }

fn failure_is_too_large(result: HttpsResult) -> bool =
  match result {
    HttpsOk(_) => false,
    HttpsErr(failure) => match failure.kind {
      ResponseTooLarge => true,
      _ => false
    }
  }

fn main() -> i32 = do
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" then return 1 end
  let decoded = block_on(https_send_async(request_for(16)))
  if status_of(decoded) != 200 || body_of(decoded) != "hello-compressed" then return 2 end
  let limited = block_on(https_send_async(request_for(15)))
  if failure_is_too_large(limited) == false then return 3 end
  println("https_limit_async decoded=hello-compressed failure=6")
  0
end
