import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import {
  https_send_async,
  task_all
} from '../../lib/mlc/common/stdlib/net/https_async.mlc'
import {
  HttpsRequest,
  HttpsResult,
  HttpsOk,
  HttpsErr
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn request_for(method: string, path: string, body: string) -> HttpsRequest =
  HttpsRequest {
    method: method,
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + path,
    headers: [],
    body: body,
    timeout_milliseconds: 5000,
    max_response_bytes: 4194304,
    ca_bundle_path: get_or("HTTPS_TEST_CA", ""),
    proxy_url: ""
  }

fn ok_body(result: HttpsResult) -> string =
  match result {
    HttpsOk(response) => response.body,
    HttpsErr(_) => ""
  }

fn main() -> i32 = do
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" then
    return 1
  end
  let models = https_send_async(request_for("POST", "/echo", "models-body"))
  let billing = https_send_async(request_for("POST", "/echo", "billing-body"))
  let pair = block_on(task_all(models, billing))
  if ok_body(pair.first_result) != "models-body" || ok_body(pair.second_result) != "billing-body" then
    return 2
  end
  println("https_task_all models=models-body billing=billing-body")
  0
end
