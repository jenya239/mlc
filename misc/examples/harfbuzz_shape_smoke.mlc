// HarfBuzz shape via MLC text_shaping (thin harfbuzz_abi).
import {
  text_shaping_new,
  text_shaping_shape,
  text_shaping_glyph_id_at,
  text_shaping_glyph_advance_at
} from '../gui/text_shaping'

type ShapedGlyph = { glyph_id: i32, x_advance: i32 }

fn text_shaper_shape(font_path: string, text: string, pixel_size: i32) -> [ShapedGlyph] = do
  let mut glyphs: [ShapedGlyph] = []
  let mut state = text_shaping_new()
  const shaped = text_shaping_shape(state, font_path, pixel_size, text)
  if shaped.error_code != 0 then
    return glyphs
  end
  let mut index = 0
  while index < shaped.glyph_count do
    glyphs.push(ShapedGlyph {
      glyph_id: text_shaping_glyph_id_at(index),
      x_advance: text_shaping_glyph_advance_at(index)
    })
    index = index + 1
  end
  glyphs
end

fn main() -> i32 = do
  const font_path = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
  const glyphs = text_shaper_shape(font_path, "Привет", 32)
  if glyphs.length() != 6 then
    return 1
  end
  let mut index = 0
  while index < glyphs.length() do
    if glyphs[index].glyph_id <= 0 then
      return 2
    end
    if glyphs[index].x_advance <= 0 then
      return 3
    end
    index = index + 1
  end
  const latin = text_shaper_shape(font_path, "Hi", 32)
  if latin.length() != 2 then
    return 4
  end
  0
end
