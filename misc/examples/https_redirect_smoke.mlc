import { get_or } from '../../lib/mlc/common/stdlib/env/env.mlc'
import {
  https_send_following_redirects,
  https_redirect_target,
  https_redirect_headers,
  https_redirect_method,
  https_redirect_body,
  https_redirect_hop_budget
} from '../../lib/mlc/common/stdlib/net/https_redirect.mlc'
import {
  HttpsHeader,
  HttpsRequest,
  HttpsResult,
  HttpsFailureKind,
  HttpsOk,
  HttpsErr,
  TransportFailed
} from '../../lib/mlc/common/stdlib/net/https_request.mlc'

fn credential_headers() -> [HttpsHeader] =
  [
    HttpsHeader { name: "Authorization", value: "Bearer secret" },
    HttpsHeader { name: "Cookie", value: "session=secret" },
    HttpsHeader { name: "Accept", value: "text/plain" }
  ]

fn header_value(headers: [HttpsHeader], name: string) -> string = do
  let mut index = 0
  let mut found = ""
  while index < headers.length() && found == "" do
    if headers[index].name == name then found = headers[index].value end
    index = index + 1
  end
  found
end

fn check_target() -> i32 = do
  if https_redirect_hop_budget(2) != 2 then return 2 end
  if https_redirect_hop_budget(-1) != 0 then return 3 end
  if https_redirect_hop_budget(11) != 10 then return 4 end
  if https_redirect_target("https://h/a/b", "c") != "https://h/a/c" then return 5 end
  if https_redirect_target("https://h/a/b", "/c") != "https://h/c" then return 6 end
  if https_redirect_target("https://h/a/b?x=1", "?y=2") != "https://h/a/b?y=2" then return 7 end
  if https_redirect_target("https://h/a/b", "https://other/z") != "https://other/z" then return 8 end
  if https_redirect_target("https://h/a", "http://other/") != "" then return 9 end
  if https_redirect_target("https://h/a/b", "../c") != "https://h/c" then return 10 end
  if https_redirect_target("https://h/a", "//other/z") != "https://other/z" then return 11 end
  if https_redirect_target("https://h/a/b#f", "https://other/z#q") != "https://other/z" then return 12 end
  if https_redirect_method(302, "POST") != "GET" then return 13 end
  if https_redirect_method(303, "HEAD") != "HEAD" then return 14 end
  if https_redirect_method(307, "POST") != "POST" then return 15 end
  if https_redirect_body(302, "POST", "payload") != "" then return 16 end
  if https_redirect_body(307, "POST", "payload") != "payload" then return 17 end
  const kept = https_redirect_headers(credential_headers(), "https://H/a", "https://h:443/b")
  if header_value(kept, "Authorization") != "Bearer secret" then return 18 end
  if header_value(kept, "Cookie") != "session=secret" then return 19 end
  const stripped = https_redirect_headers(credential_headers(), "https://h/a", "https://h:8443/b")
  if header_value(stripped, "Authorization") != "" then return 20 end
  if header_value(stripped, "Cookie") != "" then return 21 end
  if header_value(stripped, "Accept") != "text/plain" then return 22 end
  0
end

fn request_for(method: string, path: string, headers: [HttpsHeader], body: string) -> HttpsRequest =
  HttpsRequest {
    method: method,
    url: "https://127.0.0.1:" + get_or("HTTPS_TEST_PORT", "") + path,
    headers: headers,
    body: body,
    timeout_milliseconds: 5000,
    max_response_bytes: 4194304,
    ca_bundle_path: get_or("HTTPS_TEST_CA", ""),
    proxy_url: ""
  }

fn status_of(result: HttpsResult) -> i32 =
  match result {
    HttpsOk(response) => response.status,
    HttpsErr(_) => -1
  }

fn body_of(result: HttpsResult) -> string =
  match result {
    HttpsOk(response) => response.body,
    HttpsErr(_) => ""
  }

fn failure_message(result: HttpsResult) -> string =
  match result {
    HttpsOk(_) => "",
    HttpsErr(failure) => failure.message
  }

fn failure_kind_is_transport(kind: HttpsFailureKind) -> bool =
  match kind {
    TransportFailed => true,
    _ => false
  }

fn failure_is_transport(result: HttpsResult) -> bool =
  match result {
    HttpsOk(_) => false,
    HttpsErr(failure) => failure_kind_is_transport(failure.kind)
  }

fn main() -> i32 = do
  const target_code = check_target()
  if target_code != 0 then return target_code end
  if get_or("HTTPS_TEST_PORT", "") == "" || get_or("HTTPS_TEST_CA", "") == "" then return 1 end
  const held = https_send_following_redirects(request_for("GET", "/redirect/same", credential_headers(), ""), 0)
  if status_of(held) != 302 then return 30 end
  const same = https_send_following_redirects(request_for("GET", "/redirect/same", credential_headers(), ""), 3)
  if status_of(same) != 200 || body_of(same) != "method=GET auth=yes cookie=yes" then return 31 end
  const cross = https_send_following_redirects(request_for("GET", "/redirect/cross", credential_headers(), ""), 3)
  if status_of(cross) != 200 || body_of(cross) != "method=GET auth=no cookie=no" then return 32 end
  const plain = https_send_following_redirects(request_for("GET", "/redirect/http", [], ""), 3)
  if status_of(plain) != 302 || body_of(plain) != "stop" then return 33 end
  const limited = https_send_following_redirects(request_for("GET", "/redirect/loop", [], ""), 2)
  if failure_is_transport(limited) == false || failure_message(limited) != "redirect hop limit" then return 34 end
  const kept = https_send_following_redirects(request_for("POST", "/redirect/keep", [], "kept"), 2)
  if status_of(kept) != 200 || body_of(kept) != "kept" then return 35 end
  0
end
