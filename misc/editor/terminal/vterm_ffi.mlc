  "mlc::terminal::vterm_create" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_destroy(vterm_handle: i64) -> i32 =
  "mlc::terminal::vterm_destroy" from "mlc/terminal/vterm_abi.hpp" thread_affine
