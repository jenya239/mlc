extern fn vterm_last_cell_background_red() -> i32 =
  "mlc::terminal::vterm_last_cell_background_red" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_background_green() -> i32 =
  "mlc::terminal::vterm_last_cell_background_green" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_background_blue() -> i32 =
  "mlc::terminal::vterm_last_cell_background_blue" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_background_index() -> i32 =
  "mlc::terminal::vterm_last_cell_background_index" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_damage_count(screen_handle: i64) -> i32 =
  "mlc::terminal::vterm_damage_count" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_resize(vterm_handle: i64, rows: i32, columns: i32) -> i32 =
  "mlc::terminal::vterm_resize" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_size_rows(vterm_handle: i64) -> i32 =
  "mlc::terminal::vterm_size_rows" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_size_columns(vterm_handle: i64) -> i32 =
  "mlc::terminal::vterm_size_columns" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_screen_set_scrollback_capacity(screen_handle: i64, capacity: i32) -> i32 =
  "mlc::terminal::vterm_screen_set_scrollback_capacity" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_screen_scrollback_capacity(screen_handle: i64) -> i32 =
  "mlc::terminal::vterm_screen_scrollback_capacity" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_screen_scrollback_line_count(screen_handle: i64) -> i32 =
  "mlc::terminal::vterm_screen_scrollback_line_count" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_screen_scrollback_line_text(screen_handle: i64, index: i32) -> string =
  "mlc::terminal::vterm_screen_scrollback_line_text" from "mlc/terminal/vterm_abi.hpp" thread_affine

export type VtermCell = {
  codepoint: i32,
  text: string,
  width: i32,
  foreground_is_indexed: bool,
  foreground_red: i32,
  foreground_green: i32,
  foreground_blue: i32,
  foreground_index: i32,
  background_is_indexed: bool,
  background_red: i32,
  background_green: i32,
  background_blue: i32,
  background_index: i32
}

export fn vterm_terminal_create(rows: i32, columns: i32) -> i64 = vterm_create(rows, columns)
export fn vterm_terminal_destroy(vterm_handle: i64) -> i32 = vterm_destroy(vterm_handle)
export fn vterm_terminal_screen(vterm_handle: i64) -> i64 = vterm_obtain_screen(vterm_handle)
export fn vterm_terminal_write(vterm_handle: i64, bytes: string) -> i32 = vterm_write_input(vterm_handle, bytes)
export fn vterm_terminal_damage_count(screen_handle: i64) -> i32 = vterm_damage_count(screen_handle)
export fn vterm_terminal_resize(vterm_handle: i64, rows: i32, columns: i32) -> i32 =
  vterm_resize(vterm_handle, rows, columns)
export fn vterm_terminal_size_rows(vterm_handle: i64) -> i32 = vterm_size_rows(vterm_handle)
export fn vterm_terminal_size_columns(vterm_handle: i64) -> i32 = vterm_size_columns(vterm_handle)
export fn vterm_terminal_set_scrollback_capacity(screen_handle: i64, capacity: i32) -> i32 =
  vterm_screen_set_scrollback_capacity(screen_handle, capacity)
export fn vterm_terminal_scrollback_capacity(screen_handle: i64) -> i32 =
  vterm_screen_scrollback_capacity(screen_handle)
export fn vterm_terminal_scrollback_line_count(screen_handle: i64) -> i32 =
  vterm_screen_scrollback_line_count(screen_handle)
export fn vterm_terminal_scrollback_line_text(screen_handle: i64, index: i32) -> string =
  vterm_screen_scrollback_line_text(screen_handle, index)

// One-byte ASCII ESC string. MLC string literals have no hex/control-byte
// escape syntax, so VT100/ANSI sequence construction (SGR colors here,
// arrow-key input in §102d) composes this with plain text via concatenation.
export fn vterm_control_escape_byte() -> string = vterm_escape_byte()

export fn vterm_cell_at(screen_handle: i64, row: i32, column: i32) -> VtermCell = do
  const status = vterm_read_screen_cell(screen_handle, row, column)
  if status != 0 then
    return VtermCell {
      codepoint: 0, text: " ", width: 0, foreground_is_indexed: false,
      foreground_red: 0, foreground_green: 0, foreground_blue: 0, foreground_index: 0,
      background_is_indexed: false,
      background_red: 0, background_green: 0, background_blue: 0, background_index: 0
    }
  end
  VtermCell {
    codepoint: vterm_last_cell_codepoint(),
    text: vterm_last_cell_utf8(),
    width: vterm_last_cell_width(),
    foreground_is_indexed: vterm_last_cell_foreground_is_indexed() != 0,
    foreground_red: vterm_last_cell_foreground_red(),
    foreground_green: vterm_last_cell_foreground_green(),
    foreground_blue: vterm_last_cell_foreground_blue(),
    foreground_index: vterm_last_cell_foreground_index(),
    background_is_indexed: vterm_last_cell_background_is_indexed() != 0,
    background_red: vterm_last_cell_background_red(),
    background_green: vterm_last_cell_background_green(),
    background_blue: vterm_last_cell_background_blue(),
    background_index: vterm_last_cell_background_index()
  }
end
