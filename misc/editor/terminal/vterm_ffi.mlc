  "mlc::terminal::vterm_obtain_screen" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_write_input(vterm_handle: i64, bytes: string) -> i32 =
  "mlc::terminal::vterm_write_input" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_escape_byte() -> string =
  "mlc::terminal::vterm_escape_byte" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_read_screen_cell(screen_handle: i64, row: i32, column: i32) -> i32 =
  "mlc::terminal::vterm_read_screen_cell" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_codepoint() -> i32 =
  "mlc::terminal::vterm_last_cell_codepoint" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_utf8() -> string =
  "mlc::terminal::vterm_last_cell_utf8" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_width() -> i32 =
  "mlc::terminal::vterm_last_cell_width" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_foreground_is_indexed() -> i32 =
  "mlc::terminal::vterm_last_cell_foreground_is_indexed" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_foreground_red() -> i32 =
  "mlc::terminal::vterm_last_cell_foreground_red" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_foreground_green() -> i32 =
  "mlc::terminal::vterm_last_cell_foreground_green" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_foreground_blue() -> i32 =
  "mlc::terminal::vterm_last_cell_foreground_blue" from "mlc/terminal/vterm_abi.hpp" thread_affine
extern fn vterm_last_cell_foreground_index() -> i32 =
  "mlc::terminal::vterm_last_cell_foreground_index" from "mlc/terminal/vterm_abi.hpp" thread_affine
