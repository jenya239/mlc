// TRACK_EDITOR_TERMINAL §102b — PTY spawn/read/write FFI bindings.
// forkpty owns slave tty setup (setsid/TIOCSCTTY/stdin-out-err dup); this
// module only owns the master-fd read/write/spawn/close surface.

extern fn pty_spawn(command_line: string) -> i32 =
  "mlc::terminal::pty_spawn" from "mlc/terminal/pty_abi.hpp" thread_affine
extern fn pty_write(master_fd: i32, bytes: string) -> i32 =
  "mlc::terminal::pty_write" from "mlc/terminal/pty_abi.hpp" thread_affine
extern fn pty_read(master_fd: i32, max_bytes: i32, timeout_ms: i32) -> string =
  "mlc::terminal::pty_read" from "mlc/terminal/pty_abi.hpp" thread_affine
extern fn pty_read_until_eof(master_fd: i32, max_total_bytes: i32, timeout_ms: i32) -> string =
  "mlc::terminal::pty_read_until_eof" from "mlc/terminal/pty_abi.hpp" thread_affine
extern fn pty_close(master_fd: i32) -> i32 =
  "mlc::terminal::pty_close" from "mlc/terminal/pty_abi.hpp" thread_affine

export fn pty_terminal_spawn(command_line: string) -> i32 = pty_spawn(command_line)
export fn pty_terminal_write(master_fd: i32, bytes: string) -> i32 = pty_write(master_fd, bytes)
export fn pty_terminal_read(master_fd: i32, max_bytes: i32, timeout_ms: i32) -> string =
  pty_read(master_fd, max_bytes, timeout_ms)
export fn pty_terminal_read_until_eof(master_fd: i32, max_total_bytes: i32, timeout_ms: i32) -> string =
  pty_read_until_eof(master_fd, max_total_bytes, timeout_ms)
export fn pty_terminal_close(master_fd: i32) -> i32 = pty_close(master_fd)
