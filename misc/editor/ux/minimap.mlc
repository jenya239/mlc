// TRACK_EDITOR_MINIMAP STEP=2 — geometry, cache key, viewport indicator, click→scroll.
// TRACK_EDITOR_MINIMAP_ZOOM_SCALE STEP=2 — pixel size scales with font zoom.
// TRACK_EDITOR_MINIMAP_WIDTH_ZOOM STEP=2 — strip width scales with font zoom.
import { Rect, rect_new } from '../../gui/layout'
import { editor_ux_clamp_scroll_offset } from './scroll'
import { editor_font_size_default } from './font_zoom'

export fn editor_ux_minimap_width() -> i32 = 64
export fn editor_ux_minimap_pixel_size() -> i32 = 2
export fn editor_ux_minimap_line_height() -> i32 = 3

// Base 2 at default font; scales linearly with Ctrl+wheel zoom.
export fn editor_ux_minimap_pixel_size_for_font(font_size: i32) -> i32 = do
  const base_font = editor_font_size_default()
  if base_font <= 0 then
    return editor_ux_minimap_pixel_size()
  end
  let mut size = (editor_ux_minimap_pixel_size() * font_size) / base_font
  if size < 1 then
    size = 1
  end
  size
end

// Base 64 at default font; floor 32 so text band still fits.
export fn editor_ux_minimap_width_for_font(font_size: i32) -> i32 = do
  const base_font = editor_font_size_default()
  if base_font <= 0 then
    return editor_ux_minimap_width()
  end
  let mut width = (editor_ux_minimap_width() * font_size) / base_font
  if width < 32 then
    width = 32
  end
  width
end

export type MinimapLayout = {
  text_rect: Rect,
  minimap_rect: Rect,
  enabled: i32
}

export type MinimapCacheState = {
  // TRACK_EDITOR_HYGIENE §107e — key on document version, not full text.
  version: i32,
  rebuild_count: i32
}

fn editor_ux_minimap_layout_with_width(
  content_band: Rect,
  width: i32
) -> MinimapLayout = do
  const min_text = 80
  if content_band.width < width + min_text then
    return MinimapLayout {
      text_rect: content_band,
      minimap_rect: rect_new(0, 0, 0, 0),
      enabled: 0
    }
  end
  const text_width = content_band.width - width
  MinimapLayout {
    text_rect: rect_new(
      content_band.x,
      content_band.y,
      text_width,
      content_band.height
    ),
    minimap_rect: rect_new(
      content_band.x + text_width,
      content_band.y,
      width,
      content_band.height
    ),
    enabled: 1
  }
end

export fn editor_ux_minimap_layout(content_band: Rect) -> MinimapLayout =
  editor_ux_minimap_layout_with_width(content_band, editor_ux_minimap_width())

export fn editor_ux_minimap_layout_for_font(
  content_band: Rect,
  font_size: i32
) -> MinimapLayout =
  editor_ux_minimap_layout_with_width(
    content_band, editor_ux_minimap_width_for_font(font_size)
  )

// TRACK_EDITOR_WRAPPED_TEXT_BLEEDS_INTO_MINIMAP STEP=2 —
// Clip editor glyph batch to non-minimap strip (right edge = minimap_rect.x).
export fn editor_ux_content_clip_rect(
  editor_rect: Rect,
  minimap_layout: MinimapLayout
) -> Rect = do
  if minimap_layout.enabled == 0 then
    editor_rect
  else
    let mut width = minimap_layout.minimap_rect.x - editor_rect.x
    if width < 0 then
      width = 0
    end
    rect_new(editor_rect.x, editor_rect.y, width, editor_rect.height)
  end
end

export fn editor_ux_minimap_needs_rebuild(
  prev_version: i32,
  next_version: i32
) -> i32 = do
  if prev_version != next_version then
    return 1
  end
  0
end

export fn editor_ux_minimap_cache_new(document_version: i32) -> MinimapCacheState =
  MinimapCacheState { version: document_version, rebuild_count: 1 }

export fn editor_ux_minimap_cache_tick(
  state: MinimapCacheState,
  document_version: i32
) -> MinimapCacheState = do
  if editor_ux_minimap_needs_rebuild(state.version, document_version) == 0 then
    return state
  end
  MinimapCacheState {
    version: document_version,
    rebuild_count: state.rebuild_count + 1
  }
end

// TRACK_EDITOR_PERF_DOGFOOD §109i — ≤1 sample row per strip pixel.
export fn editor_ux_minimap_sample_count(
  line_count: i32,
  strip_height: i32
) -> i32 = do
  let mut height = strip_height
  if height < 1 then
    height = 1
  end
  let mut lines = line_count
  if lines < 1 then
    lines = 1
  end
  if lines <= height then
    return lines
  end
  height
end

export fn editor_ux_minimap_sample_source_line(
  sample_index: i32,
  sample_count: i32,
  line_count: i32
) -> i32 = do
  if sample_count <= 0 || line_count <= 0 then
    return 0
  end
  let mut index = sample_index
  if index < 0 then
    index = 0
  end
  let mut source = (index * line_count) / sample_count
  if source >= line_count then
    source = line_count - 1
  end
  if source < 0 then
    source = 0
  end
  source
end

export fn editor_ux_minimap_viewport_indicator(
  minimap_rect: Rect,
  content_height: i32,
  viewport_height: i32,
  scroll_y: i32
) -> Rect = do
  if minimap_rect.width <= 0 || minimap_rect.height <= 0 then
    return rect_new(0, 0, 0, 0)
  end
  let mut content_h = content_height
  if content_h <= 0 then
    content_h = 1
  end
  let mut viewport_h = viewport_height
  if viewport_h <= 0 then
    viewport_h = 1
  end
  let mut height = viewport_h * minimap_rect.height / content_h
  if height < 4 then
    height = 4
  end
  if height > minimap_rect.height then
    height = minimap_rect.height
  end
  let mut top = scroll_y * minimap_rect.height / content_h
  if top < 0 then
    top = 0
  end
  if top + height > minimap_rect.height then
    top = minimap_rect.height - height
  end
  if top < 0 then
    top = 0
  end
  rect_new(minimap_rect.x, minimap_rect.y + top, minimap_rect.width, height)
end

// Click/drag in strip → scroll so mapped doc y is near viewport center.
export fn editor_ux_minimap_scroll_at_y(
  click_y: i32,
  minimap_rect: Rect,
  content_height: i32,
  viewport_height: i32
) -> i32 = do
  if minimap_rect.height <= 0 then
    return 0
  end
  let mut content_h = content_height
  if content_h <= 0 then
    content_h = 1
  end
  let mut rel_y = click_y - minimap_rect.y
  if rel_y < 0 then
    rel_y = 0
  end
  if rel_y > minimap_rect.height then
    rel_y = minimap_rect.height
  end
  const doc_y = rel_y * content_h / minimap_rect.height
  const scroll_y = doc_y - viewport_height / 2
  editor_ux_clamp_scroll_offset(scroll_y, content_h, viewport_height)
end
