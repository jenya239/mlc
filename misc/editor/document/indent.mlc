// TRACK_EDITOR_INDENT_MODEL STEP=2 — config + indent/outdent edits.
// TRACK_EDITOR_HYGIENE §107l — range indent/outdent without full stringify.
import {
  TextDocument,
  document_byte_length,
  document_byte_slice,
  document_insert
} from './piece_table'
import { document_delete } from './document_delete'
import {
  EditorSelection,
  selection_collapsed,
  selection_is_empty,
  selection_start,
  selection_end,
  selection_clamp
} from './selection'
import { EditResult, edit_insert_text } from './edit'

export type EditorIndentConfig = {
  use_tabs: i32,
  indent_width: i32
}

export fn editor_indent_config_default() -> EditorIndentConfig =
  EditorIndentConfig {
    use_tabs: 0,
    indent_width: 2
  }

export fn editor_indent_config_set_width(
  config: EditorIndentConfig,
  width: i32
) -> EditorIndentConfig = do
  let mut clamped = width
  if clamped < 1 then
    clamped = 1
  end
  if clamped > 8 then
    clamped = 8
  end
  EditorIndentConfig {
    use_tabs: config.use_tabs,
    indent_width: clamped
  }
end

export fn editor_indent_config_set_use_tabs(
  config: EditorIndentConfig,
  use_tabs: i32
) -> EditorIndentConfig =
  EditorIndentConfig {
    use_tabs: use_tabs,
    indent_width: config.indent_width
  }

export fn editor_indent_unit(config: EditorIndentConfig) -> string = do
  if config.use_tabs != 0 then
    return "\t"
  end
  let mut unit = ""
  let mut index = 0
  while index < config.indent_width do
    unit = unit + " "
    index = index + 1
  end
  unit
end

fn document_line_start_before(document: TextDocument, offset: i32) -> i32 = do
  let mut index = offset
  while index > 0 do
    const previous = index - 1
    if document_byte_slice(document, previous, index) == "\n" then
      return index
    end
    index = previous
  end
  0
end

fn document_line_end_after(document: TextDocument, offset: i32) -> i32 = do
  let mut index = offset
  const length = document_byte_length(document)
  while index < length do
    if document_byte_slice(document, index, index + 1) == "\n" then
      return index
    end
    index = index + 1
  end
  length
end

fn outdent_line_body(body: string, indent_width: i32) -> string = do
  if body.byte_size() == 0 then
    return body
  end
  if body.byte_at(0) == "\t" then
    return body.byte_substring(1, body.byte_size() - 1)
  end
  let mut remove_count = 0
  let mut scanning = 1
  while scanning != 0 &&
      remove_count < indent_width &&
      remove_count < body.byte_size() do
    if body.byte_at(remove_count) == " " then
      remove_count = remove_count + 1
    else
      scanning = 0
    end
  end
  if remove_count == 0 then
    return body
  end
  body.byte_substring(remove_count, body.byte_size() - remove_count)
end

type IndentLineSpan = {
  first_line_start: i32,
  last_line_start: i32
}

fn selection_line_span_starts(
  document: TextDocument,
  selection: EditorSelection
) -> IndentLineSpan = do
  const range_start = selection_start(selection)
  const range_end = selection_end(selection)
  const first_line_start = document_line_start_before(document, range_start)
  const raw_last_line_start = document_line_start_before(document, range_end)
  let mut last_line_start = raw_last_line_start
  if !selection_is_empty(selection) &&
      range_end == raw_last_line_start &&
      raw_last_line_start > first_line_start then
    last_line_start = document_line_start_before(document, raw_last_line_start - 1)
  end
  IndentLineSpan {
    first_line_start: first_line_start,
    last_line_start: last_line_start
  }
end

fn rewrite_indent_span(
  document: TextDocument,
  first_line_start: i32,
  last_line_start: i32,
  indent_width: i32,
  unit: string,
  mode_indent: i32
) -> TextDocument = do
  let mut new_span = ""
  let mut first_iteration = 1
  let mut cursor = first_line_start
  while cursor <= last_line_start do
    const line_end = document_line_end_after(document, cursor)
    let mut body = document_byte_slice(document, cursor, line_end)
    if mode_indent != 0 then
      body = unit + body
    else
      body = outdent_line_body(body, indent_width)
    end
    if first_iteration == 0 then
      new_span = new_span + "\n"
    end
    new_span = new_span + body
    first_iteration = 0
    cursor = line_end + 1
  end
  const last_line_end = document_line_end_after(document, last_line_start)
  const working = document_delete(document, first_line_start, last_line_end)
  document_insert(working, first_line_start, new_span)
end

// Tab: collapsed → insert unit at caret; range → prepend unit on intersecting lines.
export fn edit_indent_tab(
  document: TextDocument,
  selection: EditorSelection,
  config: EditorIndentConfig
) -> EditResult = do
  const unit = editor_indent_unit(config)
  if selection_is_empty(selection) then
    return edit_insert_text(document, selection, unit)
  end
  if document_byte_length(document) <= 0 then
    return EditResult { document: document, selection: selection }
  end
  const span = selection_line_span_starts(document, selection)
  const next_document = rewrite_indent_span(
    document, span.first_line_start, span.last_line_start, config.indent_width, unit, 1
  )
  const range_start = selection_start(selection)
  EditResult {
    document: next_document,
    selection: selection_clamp(
      selection_collapsed(range_start),
      document_byte_length(next_document)
    )
  }
end

// Shift+Tab: outdent intersecting lines (collapsed → caret line).
export fn edit_outdent_lines(
  document: TextDocument,
  selection: EditorSelection,
  config: EditorIndentConfig
) -> EditResult = do
  if document_byte_length(document) <= 0 then
    return EditResult { document: document, selection: selection }
  end
  const span = selection_line_span_starts(document, selection)
  const next_document = rewrite_indent_span(
    document, span.first_line_start, span.last_line_start, config.indent_width, "", 0
  )
  const range_start = selection_start(selection)
  EditResult {
    document: next_document,
    selection: selection_clamp(
      selection_collapsed(range_start),
      document_byte_length(next_document)
    )
  }
end
