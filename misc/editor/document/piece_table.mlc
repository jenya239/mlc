// TRACK_EDITOR_MVP STEP=9 — piece-table TextDocument (byte offsets).
// File path load deferred until by-value FFI wrappers for mlc::file exist;
// open path = document_from_string (fixture / caller-supplied bytes).

export type PieceSource = Original | Added

export type Piece = {
  source: PieceSource,
  start: i32,
  length: i32
}

export type TextDocument = {
  original: string,
  added: string,
  pieces: [Piece],
  // TRACK_EDITOR_HYGIENE §107e — monotonic; bump on insert/delete (not on bytes).
  // i32: editor counters are i32; i64 + literal 1 fails checked_add codegen.
  version: i32
}

fn piece_new(source: PieceSource, start: i32, length: i32) -> Piece =
  Piece { source: source, start: start, length: length }

fn buffer_slice(doc: TextDocument, source: PieceSource, start: i32, length: i32) -> string = do
  match source
  | Original => doc.original.substring(start, length)
  | Added => doc.added.substring(start, length)
  end
end

export fn document_from_string(text: string) -> TextDocument = do
  let mut pieces: [Piece] = []
  if text.length() > 0 then
    pieces.push(piece_new(Original, 0, text.length()))
  end
  TextDocument { original: text, added: "", pieces: pieces, version: 0 }
end

export fn document_byte_length(doc: TextDocument) -> i32 = do
  let mut total = 0
  let mut index = 0
  while index < doc.pieces.length() do
    total = total + doc.pieces[index].length
    index = index + 1
  end
  total
end

export fn document_to_string(doc: TextDocument) -> string = do
  let mut out = ""
  let mut index = 0
  while index < doc.pieces.length() do
    const piece = doc.pieces[index]
    out = out + buffer_slice(doc, piece.source, piece.start, piece.length)
    index = index + 1
  end
  out
end

// TRACK_EDITOR_CLIPBOARD_SLICE_NO_FULL_STRINGIFY — range without full flatten.
export fn document_byte_slice(
  doc: TextDocument,
  byte_start: i32,
  byte_end: i32
) -> string = do
  let mut start = byte_start
  let mut finish = byte_end
  const total = document_byte_length(doc)
  if start < 0 then
    start = 0
  end
  if finish < start then
    finish = start
  end
  if start > total then
    start = total
  end
  if finish > total then
    finish = total
  end
  if start == finish then
    return ""
  end
  let mut out = ""
  let mut cursor = 0
  let mut index = 0
  while index < doc.pieces.length() do
    const piece = doc.pieces[index]
    const piece_start = cursor
    const piece_end = cursor + piece.length
    if piece_end > start && piece_start < finish then
      const overlap_start = if piece_start > start then piece_start else start
      const overlap_end = if piece_end < finish then piece_end else finish
      const local_start = piece.start + (overlap_start - piece_start)
      const local_length = overlap_end - overlap_start
      out = out + buffer_slice(doc, piece.source, local_start, local_length)
    end
    cursor = piece_end
    if cursor >= finish then
      return out
    end
    index = index + 1
  end
  out
end

export fn document_original_length(doc: TextDocument) -> i32 =
  doc.original.length()

export fn document_added_length(doc: TextDocument) -> i32 =
  doc.added.length()

// Insert at byte_offset; appends to `added`, never rewrites `original`.
export fn document_insert(
  doc: TextDocument,
  byte_offset: i32,
  text: string
) -> TextDocument = do
  if text.length() == 0 then
    return doc
  end
  let mut offset = byte_offset
  if offset < 0 then
    offset = 0
  end
  const total = document_byte_length(doc)
  if offset > total then
    offset = total
  end

  let mut pieces: [Piece] = []
  let mut remaining = offset
  let mut index = 0
  let mut inserted = 0
  while index < doc.pieces.length() do
    const piece = doc.pieces[index]
    if inserted == 0 && remaining <= 0 then
      pieces.push(piece_new(Added, doc.added.length(), text.length()))
      inserted = 1
    end
    if inserted == 0 && remaining < piece.length then
      if remaining > 0 then
        pieces.push(piece_new(piece.source, piece.start, remaining))
      end
      pieces.push(piece_new(Added, doc.added.length(), text.length()))
      inserted = 1
      const tail = piece.length - remaining
      if tail > 0 then
        pieces.push(piece_new(piece.source, piece.start + remaining, tail))
      end
    else
      pieces.push(piece)
      if inserted == 0 then
        remaining = remaining - piece.length
      end
    end
    index = index + 1
  end
  if inserted == 0 then
    pieces.push(piece_new(Added, doc.added.length(), text.length()))
  end
  TextDocument {
    original: doc.original,
    added: doc.added + text,
    pieces: pieces,
    version: doc.version + 1
  }
end
