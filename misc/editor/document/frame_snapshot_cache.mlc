// TRACK_EDITOR_IDLE_BUSY_LOOP_92PCT_CPU STEP=2 —
// Idle dirty=false reuses snapshot; dirty tick re-flattens (+ Profile scopes).
// TRACK_EDITOR_HYGIENE §107f — apply_edit path keeps flatten_count.
import {
  TextDocument
} from './piece_table'
import {
  DocumentFrameSnapshot,
  document_frame_snapshot,
  document_frame_snapshot_apply_edit
} from './frame_snapshot'

export type DocumentFrameSnapshotCache = {
  snapshot: DocumentFrameSnapshot,
  snapshot_count: i32,
  dirty: i32
}

export fn frame_snapshot_cache_new(
  document: TextDocument
) -> DocumentFrameSnapshotCache =
  DocumentFrameSnapshotCache {
    snapshot: document_frame_snapshot(document),
    snapshot_count: 1,
    dirty: 1
  }

export fn frame_snapshot_cache_tick(
  state: DocumentFrameSnapshotCache,
  document: TextDocument,
  dirty: i32
) -> DocumentFrameSnapshotCache = do
  if dirty == 0 then
    return DocumentFrameSnapshotCache {
      snapshot: state.snapshot,
      snapshot_count: state.snapshot_count,
      dirty: 0
    }
  end
  Profile.scope_begin("frame_snapshot")
  const snapshot = document_frame_snapshot(document)
  Profile.scope_end("frame_snapshot")
  // §109g Critic — full dirty rebuild must bump flatten_count so L2 cannot
  // false-green when apply_edit is replaced by tick(..., 1).
  DocumentFrameSnapshotCache {
    snapshot: DocumentFrameSnapshot {
      text: snapshot.text,
      line_index: snapshot.line_index,
      flatten_count: state.snapshot.flatten_count + 1
    },
    snapshot_count: state.snapshot_count + 1,
    dirty: dirty
  }
end

export fn frame_snapshot_cache_apply_edit(
  state: DocumentFrameSnapshotCache,
  byte_start: i32,
  removed_len: i32,
  inserted: string
) -> DocumentFrameSnapshotCache = do
  Profile.scope_begin("frame_snapshot_edit")
  const snapshot = document_frame_snapshot_apply_edit(
    state.snapshot, byte_start, removed_len, inserted
  )
  Profile.scope_end("frame_snapshot_edit")
  DocumentFrameSnapshotCache {
    snapshot: snapshot,
    snapshot_count: state.snapshot_count + 1,
    dirty: 1
  }
end
