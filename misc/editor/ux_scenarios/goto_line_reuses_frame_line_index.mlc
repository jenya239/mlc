// TRACK_EDITOR_GOTO_LINE_REUSE_FRAME_LINE_INDEX STEP=2 — L2: goto helpers reuse LineIndex.
import { rect_new } from '../../gui/layout'
import { ux_focus_editor } from '../../gui/ux/snapshot'
import {
  CaretAt,
  ux_check_expect
} from '../../gui/ux/expect'
import { shell_panels_new } from '../ui/shell_panels'
import {
  tab_set_new,
  tab_set_open
} from '../workspace/tabs'
import {
  selection_collapsed,
  selection_new
} from '../document/selection'
import {
  editor_ux_state_new,
  editor_ux_snapshot,
  EditorUxState
} from '../ux/probe'
import { editor_ux_insert_text } from '../ux/edit_apply'
import { editor_text_metrics_default } from '../ux/overflow'
import {
  editor_ux_goto_line,
  editor_ux_goto_line_from_selection
} from '../ux/goto_line'
import { line_index_from_string } from '../document/line_index'

fn main() -> i32 = do
  const bounds = rect_new(0, 0, 320, 200)
  const panels = shell_panels_new(bounds, 1, 4, 4, "/proj", "proj")
  let mut tabs = tab_set_new()
  tabs = tab_set_open(tabs, "/proj/a.mlc", "")

  let mut state = editor_ux_state_new(
    320,
    200,
    panels,
    tabs,
    selection_collapsed(0)
  )
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: ux_focus_editor(),
    panels: state.panels,
    tabs: state.tabs,
    selection: state.selection,
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }

  const metrics = editor_text_metrics_default()
  let mut body = "30"
  let mut line = 2
  while line <= 40 do
    body = body + "\nL" + line.to_string()
    line = line + 1
  end
  state = editor_ux_insert_text(state, body)
  const line_index = line_index_from_string(body)

  state = editor_ux_goto_line(state, metrics, 10, line_index)
  let mut snapshot = editor_ux_snapshot(state)
  if ux_check_expect(snapshot, CaretAt(9, 0)).ok == 0 then
    println("ux_fail goto_line_reuses_frame_line_index goto")
    return 1
  end

  // Select "30" at start → from_selection jumps to line 30.
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: state.focus,
    panels: state.panels,
    tabs: state.tabs,
    selection: selection_new(0, 2),
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }
  state = editor_ux_goto_line_from_selection(state, metrics, line_index)
  snapshot = editor_ux_snapshot(state)
  if ux_check_expect(snapshot, CaretAt(29, 0)).ok == 0 then
    println("ux_fail goto_line_reuses_frame_line_index from_selection")
    return 2
  end

  println("ux_ok goto_line_reuses_frame_line_index")
  0
end
