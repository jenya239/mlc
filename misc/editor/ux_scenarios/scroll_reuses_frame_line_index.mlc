// TRACK_EDITOR_SCROLL_REUSE_FRAME_LINE_INDEX STEP=2 — L2: scroll helpers reuse LineIndex.
import { rect_new } from '../../gui/layout'
import { ux_focus_editor } from '../../gui/ux/snapshot'
import { shell_panels_new } from '../ui/shell_panels'
import {
  tab_set_new,
  tab_set_open,
  tab_set_active
} from '../workspace/tabs'
import { selection_collapsed } from '../document/selection'
import {
  editor_ux_state_new,
  EditorUxState,
  editor_tab_strip_height_live
} from '../ux/probe'
import { editor_ux_insert_text } from '../ux/edit_apply'
import { editor_text_metrics_default } from '../ux/overflow'
import {
  editor_ux_ensure_caret_visible,
  editor_ux_caret_in_viewport,
  editor_ux_clamp_scroll_y
} from '../ux/scroll'
import { line_index_from_string } from '../document/line_index'

fn main() -> i32 = do
  const bounds = rect_new(0, 0, 320, 200)
  const panels = shell_panels_new(bounds, 1, 4, 4, "/proj", "proj")
  let mut tabs = tab_set_new()
  tabs = tab_set_open(tabs, "/proj/a.mlc", "")

  let mut state = editor_ux_state_new(
    320,
    200,
    panels,
    tabs,
    selection_collapsed(0),
    editor_tab_strip_height_live())
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: ux_focus_editor(),
    panels: state.panels,
    tabs: state.tabs,
    selection: state.selection,
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }

  const metrics = editor_text_metrics_default()
  let mut body = "L0"
  let mut line = 1
  while line < 40 do
    body = body + "\nL" + line.to_string()
    line = line + 1
  end
  state = editor_ux_insert_text(state, body)

  const line_index = line_index_from_string(body)
  state = editor_ux_ensure_caret_visible(state, metrics, line_index)
  if editor_ux_caret_in_viewport(state, metrics, line_index) == 0 then
    println("ux_fail scroll_reuses_frame_line_index caret")
    return 1
  end
  const clamped = editor_ux_clamp_scroll_y(
    state, metrics, state.scroll_offset_y + 100000, line_index
  )
  if clamped < state.scroll_offset_y then
    println("ux_fail scroll_reuses_frame_line_index clamp")
    return 2
  end
  if tab_set_active(state.tabs).name.byte_size() == 0 then
    println("ux_fail scroll_reuses_frame_line_index tab")
    return 3
  end

  println("ux_ok scroll_reuses_frame_line_index")
  0
end
