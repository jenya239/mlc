// TRACK_EDITOR_SHARED_SYNTAX_SPAN_CACHE STEP=2 — L2: one full-buffer cache; same version no rebuild.
import {
  editor_ux_syntax_span_cache_new,
  editor_ux_syntax_span_cache_tick
} from '../ux/syntax_span_cache'

fn main() -> i32 = do
  let mut cache = editor_ux_syntax_span_cache_new()
  const source = "fn main() -> i32 = 1\nlet x = 2\n"
  cache = editor_ux_syntax_span_cache_tick(cache, 0, source, 0, source.byte_size())
  if cache.rebuild_count != 1 then
    println("ux_fail shared_syntax_span_cache_stable first rebuild")
    return 1
  end
  // Simulate scroll: same full-buffer key must not re-lex.
  const after_scroll = editor_ux_syntax_span_cache_tick(
    cache, 0, source, 0, source.byte_size()
  )
  if after_scroll.rebuild_count != cache.rebuild_count then
    println("ux_fail shared_syntax_span_cache_stable scroll rebuild")
    return 2
  end
  cache = after_scroll
  const edited = "fn main() -> i32 = 1\nlet x = 3\n"
  const after_edit = editor_ux_syntax_span_cache_tick(
    cache, 1, edited, 0, edited.byte_size()
  )
  if after_edit.rebuild_count != cache.rebuild_count + 1 then
    println("ux_fail shared_syntax_span_cache_stable edit rebuild")
    return 3
  end
  println("ux_ok shared_syntax_span_cache_stable")
  0
end
