// TRACK_EDITOR_HYGIENE §107i — same-version span retick must not rebuild.
import {
  editor_ux_syntax_span_cache_new,
  editor_ux_syntax_span_cache_tick
} from '../ux/syntax_span_cache'

fn main() -> i32 = do
  let mut cache = editor_ux_syntax_span_cache_new()
  const source = "fn hover() -> i32 = 1\n"
  cache = editor_ux_syntax_span_cache_tick(cache, 7, source, 0, source.byte_size())
  if cache.rebuild_count != 1 then
    println("ux_fail hover_no_full_compare first rebuild")
    return 1
  end
  // Same version + range: hover / layout_skip path must not re-lex.
  const after_same = editor_ux_syntax_span_cache_tick(
    cache, 7, source, 0, source.byte_size()
  )
  if after_same.rebuild_count != 1 then
    println("ux_fail hover_no_full_compare same_version_rebuild")
    return 2
  end
  // Version bump (content edit) must rebuild once.
  const edited = "fn hover() -> i32 = 2\n"
  const after_edit = editor_ux_syntax_span_cache_tick(
    after_same, 8, edited, 0, edited.byte_size()
  )
  if after_edit.rebuild_count != 2 then
    println("ux_fail hover_no_full_compare version_bump")
    return 3
  end
  println("ux_ok hover_no_full_compare")
  0
end
