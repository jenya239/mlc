// TRACK_EDITOR_PROBE_REUSE_LINE_INDEX_TEXT STEP=2 — L2: snapshot text from line_index.text.
import { rect_new } from '../../gui/layout'
import { ux_focus_editor } from '../../gui/ux/snapshot'
import {
  CaretAt,
  TextContains,
  ux_check_expect
} from '../../gui/ux/expect'
import { shell_panels_new } from '../ui/shell_panels'
import {
  tab_set_new,
  tab_set_open
} from '../workspace/tabs'
import { selection_collapsed } from '../document/selection'
import {
  editor_ux_state_new,
  editor_ux_snapshot,
  EditorUxState
} from '../ux/probe'
import { editor_ux_insert_text } from '../ux/edit_apply'
import { line_index_from_string } from '../document/line_index'

fn main() -> i32 = do
  const bounds = rect_new(0, 0, 320, 200)
  const panels = shell_panels_new(bounds, 1, 4, 4, "/proj", "proj")
  let mut tabs = tab_set_new()
  tabs = tab_set_open(tabs, "/proj/a.mlc", "")

  let mut state = editor_ux_state_new(
    320,
    200,
    panels,
    tabs,
    selection_collapsed(0)
  )
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: ux_focus_editor(),
    panels: state.panels,
    tabs: state.tabs,
    selection: state.selection,
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }

  const source = "alpha\nbeta\ngamma"
  state = editor_ux_insert_text(state, source)
  const line_index = line_index_from_string(source)
  const snapshot = editor_ux_snapshot(state, line_index)
  if ux_check_expect(snapshot, TextContains("beta")).ok == 0 then
    println("ux_fail probe_reuses_line_index_text text")
    return 1
  end
  if ux_check_expect(snapshot, CaretAt(2, 5)).ok == 0 then
    println("ux_fail probe_reuses_line_index_text caret")
    return 2
  end
  if snapshot.document_text != source then
    println("ux_fail probe_reuses_line_index_text identity")
    return 3
  end

  println("ux_ok probe_reuses_line_index_text")
  0
end
