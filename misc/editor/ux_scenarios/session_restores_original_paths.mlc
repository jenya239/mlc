// TRACK_EDITOR_HYGIENE §107b — session restore must keep original absolute paths.
import {
  tab_set_new,
  tab_set_open_buffer,
  tab_set_set_active,
  tab_set_count
} from '../workspace/tabs'
import {
  open_buffer_from_text,
  open_buffer_from_path,
  open_buffer_save,
  open_buffer_has_error
} from '../document/save'
import {
  workspace_session_save_tabs,
  workspace_session_load,
  workspace_session_restore_tabs
} from '../workspace/session'

extern fn file_exists(path: string) -> bool
  = "mlc::file::exists_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_remove(path: string) -> bool
  = "mlc::file::remove_file_value" from "mlc/io/file_abi.hpp" blocking

fn path_has_editor_live(path: string) -> bool =
  path.contains("editor_live_")

fn main() -> i32 = do
  const dir = ".tmp/ux_session_restores_original_paths"
  const path_a = dir + "/alpha.txt"
  const path_b = dir + "/beta.txt"
  const session_file = dir + "/session.txt"
  const payload_a = "alpha-body\n"
  const payload_b = "beta-body\n"

  if file_exists(session_file) then
    const _rm_session = file_remove(session_file)
  end
  if file_exists(".tmp/editor_live_buffer.txt") then
    const _rm_live = file_remove(".tmp/editor_live_buffer.txt")
  end

  let mut seed = open_buffer_from_text(path_a, payload_a)
  seed = open_buffer_save(seed)
  if open_buffer_has_error(seed) then
    println("ux_fail session_restores_original_paths seed_a")
    return 1
  end
  seed = open_buffer_from_text(path_b, payload_b)
  seed = open_buffer_save(seed)
  if open_buffer_has_error(seed) then
    println("ux_fail session_restores_original_paths seed_b")
    return 2
  end

  const opened_a = open_buffer_from_path(path_a)
  const opened_b = open_buffer_from_path(path_b)
  if open_buffer_has_error(opened_a) || open_buffer_has_error(opened_b) then
    println("ux_fail session_restores_original_paths open")
    return 3
  end

  let mut tabs = tab_set_new()
  tabs = tab_set_open_buffer(tabs, path_a, opened_a)
  tabs = tab_set_open_buffer(tabs, path_b, opened_b)
  tabs = tab_set_set_active(tabs, 1)
  if tab_set_count(tabs) != 2 then
    println("ux_fail session_restores_original_paths pre_count")
    return 4
  end

  // Same helper CmdSaveSession / save_demo_session uses (original paths).
  if !workspace_session_save_tabs(session_file, ".tmp", tabs, 0, 0, 0) then
    println("ux_fail session_restores_original_paths save")
    return 5
  end

  const session = workspace_session_load(session_file)
  let mut restored = workspace_session_restore_tabs(session)

  if tab_set_count(restored) != 2 then
    println("ux_fail session_restores_original_paths count")
    return 6
  end

  let mut index = 0
  while index < tab_set_count(restored) do
    const path = restored.tabs[index].path
    if path_has_editor_live(path) then
      println("ux_fail session_restores_original_paths editor_live_path")
      return 7
    end
    index = index + 1
  end

  let mut saw_a = 0
  let mut saw_b = 0
  index = 0
  while index < tab_set_count(restored) do
    const path = restored.tabs[index].path
    if path == path_a then
      saw_a = 1
    end
    if path == path_b then
      saw_b = 1
    end
    index = index + 1
  end
  if saw_a == 0 || saw_b == 0 then
    println("ux_fail session_restores_original_paths missing_original")
    return 8
  end

  println("ux_ok session_restores_original_paths")
  0
end
