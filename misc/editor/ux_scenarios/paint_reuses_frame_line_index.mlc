// TRACK_EDITOR_PAINT_REUSE_FRAME_LINE_INDEX STEP=2 — L2: paint helpers reuse LineIndex.
import { rect_new } from '../../gui/layout'
import { ux_focus_editor } from '../../gui/ux/snapshot'
import { shell_panels_new } from '../ui/shell_panels'
import {
  tab_set_new,
  tab_set_open,
  tab_set_active
} from '../workspace/tabs'
import { selection_collapsed } from '../document/selection'
import {
  editor_ux_state_new,
  EditorUxState
} from '../ux/probe'
import { editor_ux_insert_text } from '../ux/edit_apply'
import { editor_text_metrics_default } from '../ux/overflow'
import { editor_ux_current_line_draw_report } from '../ux/current_line_hl'
import { editor_ux_trailing_ws_draw_report } from '../ux/trailing_ws'
import { status_bar_from_buffer } from '../ui/status_bar'
import { line_index_from_string } from '../document/line_index'

fn main() -> i32 = do
  const bounds = rect_new(0, 0, 800, 600)
  const panels = shell_panels_new(bounds, 1, 4, 4, "/proj", "proj")
  let mut tabs = tab_set_new()
  tabs = tab_set_open(tabs, "/proj/a.mlc", "")

  let mut state = editor_ux_state_new(
    800,
    600,
    panels,
    tabs,
    selection_collapsed(0)
  )
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: ux_focus_editor(),
    panels: state.panels,
    tabs: state.tabs,
    selection: state.selection,
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }

  const metrics = editor_text_metrics_default()
  state = editor_ux_insert_text(state, "aaa  \nbbb\nccc ")
  state = EditorUxState {
    window_width: state.window_width,
    window_height: state.window_height,
    focus: state.focus,
    panels: state.panels,
    tabs: state.tabs,
    selection: selection_collapsed(6),
    scroll_offset_x: state.scroll_offset_x,
    scroll_offset_y: state.scroll_offset_y,
    cursor_shape: state.cursor_shape,
    clock_ms: state.clock_ms,
    tab_strip_height: state.tab_strip_height,
    overflows: state.overflows
  }

  // One LineIndex for paint path (frame snapshot reuse); no helper re-flatten.
  const line_index = line_index_from_string("aaa  \nbbb\nccc ")
  const current_line = editor_ux_current_line_draw_report(
    state, metrics, line_index
  )
  if current_line.highlights.length() != 1 then
    println("ux_fail paint_reuses_frame_line_index current_line count")
    return 1
  end
  if current_line.highlights[0].line != 1 then
    println("ux_fail paint_reuses_frame_line_index current_line")
    return 2
  end

  const trailing = editor_ux_trailing_ws_draw_report(state, metrics, line_index)
  if trailing.highlights.length() != 2 then
    println("ux_fail paint_reuses_frame_line_index trailing count")
    return 3
  end

  const active = tab_set_active(state.tabs)
  const status = status_bar_from_buffer(active.buffer, 6, line_index)
  if status.line != 2 || status.column != 1 then
    println("ux_fail paint_reuses_frame_line_index status")
    return 4
  end

  println("ux_ok paint_reuses_frame_line_index")
  0
end
