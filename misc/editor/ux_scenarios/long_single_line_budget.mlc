// TRACK_EDITOR_HYGIENE §107h — 1MB single-line wrap/shape under budget.
import { line_index_from_string } from '../document/line_index'
import { editor_resolve_font_path } from '../config/font_path'
import { visual_rows_for_line_pixel_budget } from '../layout/word_wrap'
import { editor_measure_mono_char_width } from '../ux/font_zoom'
import { editor_perf_now_us } from '../ui/perf'

fn build_long_line(byte_target: i32) -> string = do
  const chunk = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ__"
  let mut body = ""
  while body.byte_size() < byte_target do
    body = body + chunk
  end
  if body.byte_size() > byte_target then
    body = body.byte_substring(0, byte_target)
  end
  body
end

fn main() -> i32 = do
  const font_path = editor_resolve_font_path("")
  const pixel_size = 13
  const char_width = editor_measure_mono_char_width(font_path, pixel_size)
  if char_width < 1 then
    println("ux_fail long_single_line_budget char_width")
    return 1
  end

  const line = build_long_line(1048576)
  if line.byte_size() != 1048576 then
    println("ux_fail long_single_line_budget size got " + line.byte_size().to_string())
    return 2
  end
  const line_index = line_index_from_string(line)
  const viewport_width = char_width * 80
  const started_us = editor_perf_now_us()
  const rows = visual_rows_for_line_pixel_budget(
    line, line_index, 0, viewport_width, font_path, pixel_size
  )
  const elapsed_us = editor_perf_now_us() - started_us
  if rows.length() < 1 then
    println("ux_fail long_single_line_budget empty_rows")
    return 3
  end
  println("long_single_line_budget_us=" + elapsed_us.to_string())
  println("ux_ok long_single_line_budget")
  0
end
