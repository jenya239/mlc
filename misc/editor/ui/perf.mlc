// TRACK_EDITOR_RENDER_ARCHITECTURE §97a — wall-clock counters for demo_live.
// TRACK_EDITOR_HYGIENE §107j — visible_collect_count (one collect per content frame).
// TRACK_EDITOR_RETAINED_PAINT §108a — content/text rebuild counters.
// TRACK_EDITOR_RETAINED_PAINT §108c — chrome_rebuild_count.
// TRACK_EDITOR_PERF_DOGFOOD §109b — per-iteration frame reason tallies.
extern fn editor_perf_monotonic_us() -> i32
  = "mlc::profile::monotonic_micros_i32" from "mlc/core/profile.hpp"

export type EditorPerfCounters = {
  frames: i32,
  layout_us: i32,
  shaping_us: i32,
  draw_us: i32,
  total_us: i32,
  lines_touched: i32,
  primitives: i32,
  visible_collect_count: i32,
  content_rebuild_count: i32,
  text_layer_rebuild_count: i32,
  chrome_rebuild_count: i32,
  content_frame_count: i32,
  chrome_frame_count: i32,
  present_frame_count: i32,
  idle_wait_count: i32
}

export fn editor_perf_now_us() -> i32 =
  editor_perf_monotonic_us()

export fn editor_perf_new() -> EditorPerfCounters =
  EditorPerfCounters {
    frames: 0,
    layout_us: 0,
    shaping_us: 0,
    draw_us: 0,
    total_us: 0,
    lines_touched: 0,
    primitives: 0,
    visible_collect_count: 0,
    content_rebuild_count: 0,
    text_layer_rebuild_count: 0,
    chrome_rebuild_count: 0,
    content_frame_count: 0,
    chrome_frame_count: 0,
    present_frame_count: 0,
    idle_wait_count: 0
  }

export fn editor_perf_tick_frame(counters: EditorPerfCounters) -> EditorPerfCounters =
  EditorPerfCounters {
    frames: counters.frames + 1,
    layout_us: counters.layout_us,
    shaping_us: counters.shaping_us,
    draw_us: counters.draw_us,
    total_us: counters.total_us,
    lines_touched: counters.lines_touched,
    primitives: counters.primitives,
    visible_collect_count: counters.visible_collect_count,
    content_rebuild_count: counters.content_rebuild_count,
    text_layer_rebuild_count: counters.text_layer_rebuild_count,
    chrome_rebuild_count: counters.chrome_rebuild_count,
    content_frame_count: counters.content_frame_count,
    chrome_frame_count: counters.chrome_frame_count,
    present_frame_count: counters.present_frame_count,
    idle_wait_count: counters.idle_wait_count
  }

export fn editor_perf_accumulate_frame(
  counters: EditorPerfCounters,
  layout_us: i32,
  draw_us: i32,
  total_us: i32,
  visible_collect_count: i32
) -> EditorPerfCounters =
  EditorPerfCounters {
    frames: counters.frames + 1,
    layout_us: counters.layout_us + layout_us,
    shaping_us: counters.shaping_us,
    draw_us: counters.draw_us + draw_us,
    total_us: counters.total_us + total_us,
    lines_touched: counters.lines_touched,
    primitives: counters.primitives,
    visible_collect_count: counters.visible_collect_count + visible_collect_count,
    content_rebuild_count: counters.content_rebuild_count,
    text_layer_rebuild_count: counters.text_layer_rebuild_count,
    chrome_rebuild_count: counters.chrome_rebuild_count,
    content_frame_count: counters.content_frame_count,
    chrome_frame_count: counters.chrome_frame_count,
    present_frame_count: counters.present_frame_count,
    idle_wait_count: counters.idle_wait_count
  }

