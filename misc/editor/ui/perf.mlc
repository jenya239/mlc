export fn editor_perf_format_wake_counters(counters: EditorPerfCounters, hit_id: string) -> string =
  "content_rebuild_count=" + counters.content_rebuild_count.to_string()
    + "\nchrome_rebuild_count=" + counters.chrome_rebuild_count.to_string()
    + "\ntext_layer_rebuild_count=" + counters.text_layer_rebuild_count.to_string()
    + "\ncontent_frame_count=" + counters.content_frame_count.to_string()
    + "\nchrome_frame_count=" + counters.chrome_frame_count.to_string()
    + "\npresent_frame_count=" + counters.present_frame_count.to_string()
    + "\nidle_wait_count=" + counters.idle_wait_count.to_string()
    + "\nhit=" + hit_id
    + "\n"

export fn editor_perf_format(counters: EditorPerfCounters) -> string =
  "[mlc-editor] perf frames=" + counters.frames.to_string()
    + " layout_us=" + counters.layout_us.to_string()
    + " shaping_us=" + counters.shaping_us.to_string()
    + " draw_us=" + counters.draw_us.to_string()
    + " lines_touched=" + counters.lines_touched.to_string()
    + " primitives=" + counters.primitives.to_string()
    + " visible_collect_count=" + counters.visible_collect_count.to_string()

export fn editor_perf_format_demo_live(counters: EditorPerfCounters) -> string =
  "[mlc-editor] demo_live_perf frames=" + counters.frames.to_string()
    + " layout_us=" + counters.layout_us.to_string()
    + " draw_us=" + counters.draw_us.to_string()
    + " total_us=" + counters.total_us.to_string()
    + " visible_collect_count=" + counters.visible_collect_count.to_string()

// TRACK_EDITOR_TERMINAL §102g — same counters, distinct tag for the gate.
export fn editor_perf_format_demo_live_terminal(counters: EditorPerfCounters) -> string =
  "[mlc-editor] demo_live_terminal_perf frames=" + counters.frames.to_string()
    + " layout_us=" + counters.layout_us.to_string()
    + " draw_us=" + counters.draw_us.to_string()
    + " total_us=" + counters.total_us.to_string()
    + " visible_collect_count=" + counters.visible_collect_count.to_string()

// TRACK_EDITOR_HYGIENE §107d — full path (no skip branches), distinct tag.
export fn editor_perf_format_demo_live_full(counters: EditorPerfCounters) -> string =
  "[mlc-editor] demo_live_perf_full frames=" + counters.frames.to_string()
    + " layout_us=" + counters.layout_us.to_string()
    + " draw_us=" + counters.draw_us.to_string()
    + " total_us=" + counters.total_us.to_string()
    + " visible_collect_count=" + counters.visible_collect_count.to_string()
