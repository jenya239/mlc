extern fn f64_to_i32(value: f64) -> i32
  = "mlc::math::f64_to_i32" from "mlc/math/math.hpp"
extern fn i32_to_f64(value: i32) -> f64
  = "mlc::math::i32_to_f64" from "mlc/math/math.hpp"
extern fn is_directory(path: string) -> bool
  = "mlc::file::is_directory_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_exists(path: string) -> bool
  = "mlc::file::exists_value" from "mlc/io/file_abi.hpp" blocking
extern fn is_regular_file(path: string) -> bool
  = "mlc::file::is_regular_file_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking

fn resolve_editor_root() -> string = do
  const env_root = get_or("MLC_EDITOR_ROOT", "")
  if env_root != "" then
    return env_root
  end
  const argv = args()
  if argv.length() >= 1 && argv[0] != "" then
    return argv[0]
  end
  "."
end

fn root_display_name(path: string) -> string =
  if path == "." then "cwd" else path

fn tree_uses_disk(tree: FileTree) -> i32 = do
  const path = tree.nodes[tree.root_id].path
  if path == "/demo" || path.starts_with("/demo/") then
    return 0
  end
  1
end

fn listing_entries_for(path: string, use_disk: i32) -> [DirEntry] = do
  if use_disk != 0 then
    return dir_entries_from_disk(path)
  end
  demo_dir_entries(path)
end

fn browse_panels_to(panels: ShellPanels, path: string) -> ShellPanels = do
  const use_disk = tree_uses_disk(panels.tree)
  const name = path_leaf_name(path)
  const entries = listing_entries_for(path, use_disk)
  panels_with_tree(panels, folder_browser_at(path, name, entries))
end

fn header_height() -> i32 = editor_app_header_height()
fn tab_bar_height() -> i32 = editor_app_tab_bar_height()
fn toolbar_height() -> i32 = editor_app_toolbar_height()
fn status_height() -> i32 = editor_app_status_height()
fn session_path() -> string = ".tmp/editor_live_session.txt"

// §109a — phase markers for dogfood harness (stdout + optional phase file).
extern fn dogfood_phase_file_write(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn dogfood_phase_file_read(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking

fn dogfood_trim_newline(text: string) -> string = do
  if text.byte_size() > 0 && text.byte_at(text.byte_size() - 1) == "\n" then
    return text.byte_substring(0, text.byte_size() - 1)
  end
  text
end

fn push_line(
  lines: [StaticTextLine],
  text: string,
  pixel_size: i32,
  pen_x: i32,
  pen_y: i32
) -> [StaticTextLine] = do
  let mut out = lines
  out.push(StaticTextLine {
    text: text,
    pixel_size: pixel_size,
    pen_x: pen_x,
    pen_y: pen_y,
    red: 1.0,
    green: 1.0,
    blue: 1.0,
    alpha: 0.0
  })
  out
end

fn sample_main_text() -> string =
  "// TRACK_EDITOR_MVP live demo\nfn main() -> i32 = do\n  println(\"hello from mlc-editor\")\n  let mut n = 0\n  while n < 3 do\n    n = n + 1\n  end\n  0\nend\n"

fn sample_readme_text() -> string =
  "# mlc-editor\n\nType / Enter / Backspace.\nWheel scroll. Click-drag select.\nFolders: breadcrumbs and back/forward; click a file to open.\n"

fn sample_notes_text() -> string =
  "notes\nline two\nline three\nline four\nline five\nline six\nline seven\nline eight\nline nine\nline ten\n"

fn sample_lib_text() -> string =
  "fn add(a: i32, b: i32) -> i32 = a + b\n"

fn sample_util_text() -> string =
  "fn clamp(value: i32, low: i32, high: i32) -> i32 = do\n  if value < low then\n    return low\n  end\n  if value > high then\n    return high\n  end\n  value\nend\n"

fn sample_guide_text() -> string =
  "# Guide\n\nOpen `src/` or `docs/` via the folder list (or `..`).\nUse breadcrumbs / back / forward to navigate.\nClick a file to open.\n"

fn sample_changelog_text() -> string =
  "## Changelog\n\n- folder breadcrumbs + back/forward\n- scissor / cursor / clipboard\n"

// Mock FS when resolved root is missing / not a directory.
fn demo_dir_entries(dir_path: string) -> [DirEntry] = do
  let mut entries: [DirEntry] = []
  if dir_path == "/demo" then
    entries.push(dir_entry_new("src", 1))
    entries.push(dir_entry_new("docs", 1))
    entries.push(dir_entry_new("main.mlc", 0))
    entries.push(dir_entry_new("README.md", 0))
    entries.push(dir_entry_new("notes.txt", 0))
  else if dir_path == "/demo/src" then
    entries.push(dir_entry_new("lib.mlc", 0))
    entries.push(dir_entry_new("util.mlc", 0))
  else if dir_path == "/demo/docs" then
    entries.push(dir_entry_new("guide.md", 0))
    entries.push(dir_entry_new("changelog.md", 0))
  end
  entries
end

fn panels_with_tree(panels: ShellPanels, tree: FileTree) -> ShellPanels =
  ShellPanels {
    bounds: panels.bounds,
    split: panels.split,
    panes: panels.panes,
    tree: tree,
    dragging: panels.dragging,
    drag_origin_x: panels.drag_origin_x,
    drag_origin_numerator: panels.drag_origin_numerator
  }

fn text_for_path(path: string) -> string = do
  if path != "/demo" && !path.starts_with("/demo/") then
    if file_exists(path) then
      return file_read_to_string(path)
    end
    return "// " + path + "\n"
  end
  if path == "/demo/main.mlc" || path.ends_with("/main.mlc") then
    return sample_main_text()
  end
  if path == "/demo/README.md" || path.ends_with("/README.md") then
    return sample_readme_text()
  end
  if path == "/demo/notes.txt" || path.ends_with("/notes.txt") then
    return sample_notes_text()
  end
  if path == "/demo/src/lib.mlc" || path.ends_with("/lib.mlc") then
    return sample_lib_text()
  end
  if path == "/demo/src/util.mlc" || path.ends_with("/util.mlc") then
    return sample_util_text()
  end
  if path == "/demo/docs/guide.md" || path.ends_with("/guide.md") then
    return sample_guide_text()
  end
  if path == "/demo/docs/changelog.md" || path.ends_with("/changelog.md") then
    return sample_changelog_text()
  end
  "// " + path + "\n"
end

fn line_text_at(
  full_text: string,
  line_index: LineIndex,
  line: i32
) -> string = do
  const start = line_index_line_start(line_index, line)
  let mut end_exclusive = line_index.text_length
  if line + 1 < line_index_line_count(line_index) then
    end_exclusive = line_index_line_start(line_index, line + 1)
  end
  let mut length = end_exclusive - start
  if length > 0 && full_text.byte_at(end_exclusive - 1) == "\n" then
    length = length - 1
  end
  if length < 0 then
    length = 0
  end
  full_text.byte_substring(start, length)
end

fn line_display_column_end_at(
  full_text: string,
  line_index: LineIndex,
  line: i32
) -> i32 = do
  const start = line_index_line_start(line_index, line)
  let mut end_exclusive = line_index.text_length
  if line + 1 < line_index_line_count(line_index) then
    end_exclusive = line_index_line_start(line_index, line + 1)
  end
  if end_exclusive > start && full_text.byte_at(end_exclusive - 1) == "\n" then
    end_exclusive = end_exclusive - 1
  end
  if end_exclusive < start then
    return 0
  end
  line_index_offset_to_position(line_index, full_text, end_exclusive).column
end

fn apply_edit(tabs: TabSet, next_document: TextDocument) -> TabSet = do
  const active = tab_set_active(tabs)
  const buffer = open_buffer_set_document(active.buffer, next_document)
  tab_set_update_active_buffer(tabs, buffer)
end

// §109g — apply_edit snapshot path with mismatch fallback to full flatten.
fn frame_layout_after_span_edit(
  layout: EditorFrameLayout,
  document: TextDocument,
  span: EditApplySpan
) -> EditorFrameLayout = do
  let mut next = frame_layout_tick_snapshot_edit(
    layout, span.byte_start, span.removed_len, span.inserted
  )
  if !line_index_matches_document(
    next.snapshot_cache.snapshot.line_index, document
  ) then
    next = frame_layout_tick_snapshot(next, document, 1)
  end
  next
end

fn toolbar_button_rect(index: i32, bar_y: i32) -> Rect =
  editor_app_toolbar_button_rect(index, bar_y)

fn save_demo_session(
  tabs: TabSet,
  caret: i32,
  scroll_offset_y: i32,
  scroll_offset_x: i32
) -> i32 = do
  if workspace_session_save_tabs(
    session_path(),
    ".tmp",
    tabs,
    caret,
    scroll_offset_y,
    scroll_offset_x
  ) then
    return 1
  end
  0
end

fn load_demo_session() -> TabSet = do
  const session = workspace_session_load(session_path())
  if session.paths.length() == 0 then
    return tab_set_new()
  end
  workspace_session_restore_tabs(session)
end

fn load_demo_session_view(tabs: TabSet) -> SessionActiveView = do
  const session = workspace_session_load(session_path())
  workspace_session_clamped_active_view(session, tabs)
end

fn try_open_path(tabs: TabSet, path: string) -> TabSet = do
  if file_exists(path) && is_regular_file(path) then
    const buffer = open_buffer_from_path(path)
    if open_buffer_has_error(buffer) then
      return tabs
    end
    return tab_set_open_buffer(tabs, path, buffer)
  end
  tabs
end

// Virtual /demo samples keep text_for_path; disk uses open_buffer.
fn open_path_into_tabs(tabs: TabSet, path: string) -> TabSet = do
  if file_exists(path) && is_regular_file(path) then
    return try_open_path(tabs, path)
  end
  tab_set_open(tabs, path, text_for_path(path))
end

// Disk root + empty session used to leave zero tabs → first frame break.
fn open_disk_starter(root: string) -> TabSet = do
  let mut tabs = tab_set_new()
  tabs = try_open_path(tabs, root + "/README.md")
  if tab_set_has_active(tabs) then
    return tabs
  end
  tabs = try_open_path(tabs, root + "/misc/editor/README.md")
  if tab_set_has_active(tabs) then
    return tabs
  end
  tabs = try_open_path(tabs, root + "/misc/editor/demo_live.mlc")
  if tab_set_has_active(tabs) then
    return tabs
  end
  tabs = try_open_path(tabs, root + "/docs/agent/CONTINUITY.md")
  if tab_set_has_active(tabs) then
    return tabs
  end
  const entries = dir_entries_from_disk(root)
  let mut index = 0
  while index < entries.length() do
    const entry = entries[index]
    if entry.is_directory == 0 then
      const path = root + "/" + entry.name
      tabs = try_open_path(tabs, path)
      if tab_set_has_active(tabs) then
        return tabs
      end
    end
    index = index + 1
  end
  tab_set_open(
    tabs,
    root + "/untitled.md",
    "# mlc editor\n\nOpen a file from the tree.\n"
  )
end

fn open_mock_starter() -> TabSet = do
  let mut tabs = tab_set_new()
  tabs = tab_set_open(tabs, "/demo/main.mlc", sample_main_text())
  tabs = tab_set_open(tabs, "/demo/README.md", sample_readme_text())
  tabs = tab_set_open(tabs, "/demo/notes.txt", sample_notes_text())
  tab_set_set_active(tabs, 0)
end

fn ensure_tabs(tabs: TabSet, panels: ShellPanels) -> TabSet = do
  if tab_set_has_active(tabs) then
    return tabs
  end
  if tree_uses_disk(panels.tree) != 0 then
    return open_disk_starter(panels.tree.nodes[panels.tree.root_id].path)
  end
  open_mock_starter()
end

fn dogfood_path_basename(path: string) -> string = do
  let mut index = path.byte_size()
  while index > 0 do
    index = index - 1
    if path.byte_at(index) == "/" then
      return path.byte_substring(index + 1, path.byte_size() - index - 1)
    end
  end
  path
end

fn dogfood_open_forbidden(path: string) -> bool = do
  if path.byte_size() == 0 then
    return true
  end
  dogfood_path_basename(path).starts_with("README")
end

fn dogfood_emit(phase_file: string, marker: string) -> i32 = do
  println("[dogfood] " + marker)
  if phase_file.byte_size() > 0 then
    const written = dogfood_phase_file_write(phase_file, marker + "\n")
    if !written then
      println("[dogfood] FAIL: cannot write phase file")
    end
  end
  0
end

fn wake_emit_counters(
  counters_file: string,
  counters: EditorPerfCounters,
  hit_id: string
) -> i32 = do
  if counters_file.byte_size() > 0 then
    const body = editor_perf_format_wake_counters(counters, hit_id)
    const written = dogfood_phase_file_write(counters_file, body)
    if !written then
      println("[wake] FAIL: cannot write counters file")
    end
  end
  0
end

fn main() -> i32 = do
  const begin_status = glfw_gl_context_begin(1100, 760)
  if begin_status != 0 then
    return begin_status
  end

  println("[mlc-editor] live demo — Esc / window close to quit")

  const theme = theme_solarized_light()
  let mut solid = solid_renderer_create()
  if solid.program < 0 then
    const error_code = solid.program
    glfw_gl_context_end()
    return error_code
  end

  const font_path = editor_resolve_font_path("")
  let mut text_state = static_text_create(1024, font_path, 1)
  if text_state.renderer.program < 0 then
    const error_code = text_state.renderer.program
    solid_renderer_destroy(solid)
    glfw_gl_context_end()
    return error_code
  end

  const chrome_top = header_height() + tab_bar_height() + toolbar_height()
  const resolved_root = resolve_editor_root()
  println("[mlc-editor] root=" + resolved_root)
  let mut tree_root = "/demo"
  let mut tree_name = "demo"
  if is_directory(resolved_root) then
    tree_root = resolved_root
    tree_name = root_display_name(resolved_root)
  end
  let mut panels = shell_panels_new(
    rect_new(0, chrome_top, 1100, 760 - chrome_top - status_height()),
    28, 100, 4,
    tree_root, tree_name
  )
  panels = browse_panels_to(panels, tree_root)
  let mut folder_nav = folder_nav_new(folder_current_path(panels.tree))

  let mut tabs = ensure_tabs(load_demo_session(), panels)
  const terminal_perf_enabled = has("MLC_EDITOR_TERMINAL_PERF")
  const perf_full_enabled = has("MLC_EDITOR_PERF_FULL")
  const perf_baseline_enabled = has("MLC_EDITOR_PERF")
  // §108d L2: same-hit pointer jitter without GLFW mouse (measure harness).
  const hover_cpu_probe = has("MLC_EDITOR_HOVER_CPU_PROBE")
  // §109a: visible dogfood baseline phases (not PERF skip-heavy).
  const dogfood_probe = has("MLC_EDITOR_PERF_DOGFOOD")
  const dogfood_phase_file = get_or("MLC_EDITOR_PERF_DOGFOOD_PHASE_FILE", "")
  const dogfood_cmd_file = get_or("MLC_EDITOR_PERF_DOGFOOD_CMD_FILE", "")
  // §109b: wake-on-hover probe (honest text-rect + reason counters).
  const wake_probe = has("MLC_EDITOR_PERF_WAKE_PROBE")
  const wake_counters_file = get_or("MLC_EDITOR_PERF_WAKE_COUNTERS_FILE", "")
  // Counters run for baseline, terminal, or full. Heavy skips only on baseline/terminal
  // when PERF_FULL is not set (FULL overrides skips).
  const perf_enabled =
    perf_baseline_enabled || terminal_perf_enabled || perf_full_enabled
  const perf_skip_heavy =
    (perf_baseline_enabled || terminal_perf_enabled) && !perf_full_enabled
  // §107d: PERF_FULL must not take the skip-heavy path (Critic sabotage (1)).
  if perf_full_enabled && perf_skip_heavy then
    println("[mlc-editor] FAIL: MLC_EDITOR_PERF_FULL still skips heavy path")
    return 1
  end
  let mut perf_counters = editor_perf_new()
  let mut perf_frame_limit = 30
  if perf_full_enabled then
    // Full path is far costlier per frame; default 5 (script FRAMES default matches).
    perf_frame_limit = 5
  end
  if (perf_enabled && !terminal_perf_enabled) || dogfood_probe then
    const perf_open = get_or("MLC_EDITOR_PERF_OPEN", "")
    if dogfood_probe && dogfood_open_forbidden(perf_open) then
      println("[mlc-editor] FAIL: MLC_EDITOR_PERF_OPEN missing or README*")
      return 1
    end
    if perf_open.byte_size() > 0 then
      tabs = try_open_path(tabs, perf_open)
    end
  end
  const startup_view = load_demo_session_view(tabs)
  if tab_set_has_active(tabs) then
    println("[mlc-editor] open " + tab_set_active(tabs).path)
  end
  if dogfood_probe && tab_set_has_active(tabs) then
    if dogfood_open_forbidden(tab_set_active(tabs).path) then
      println("[mlc-editor] FAIL: dogfood open path is README*")
      return 1
    end
  end

  let mut app = editor_app_state_new(
    1100, 760, panels, tabs, selection_collapsed(startup_view.caret)
  )
  app = editor_app_set_scroll_y(app, startup_view.scroll_offset_y)
  app = editor_app_set_scroll_x(app, startup_view.scroll_offset_x)
  if terminal_perf_enabled then
    // Fixed grid — independent of content-rect font metrics (those come later).
    app = editor_app_open_terminal(app, 24, 80, "sh")
    // Rising-edge Enter via live encode path (not write_bytes bypass).
    app = editor_app_terminal_frame(app, "seq 1 100000", 0, 1, "", 0)
    app = editor_app_terminal_frame(app, "", 0, 0, "", 0)
  end
  let mut zoom_font_size = editor_font_size_default()
  let mut metrics = editor_font_metrics_from_size(zoom_font_size)
  const command_bindings = command_bus_default_bindings()
  let mut tree_scroll_y = 0
  let mut last_tree_click_frame = 0 - 1000
  let mut last_tree_click_path = ""
  let mut multi_click = editor_ux_multi_click_new()
  let mut multi = multi_selection_from_single(app.ux.selection)
  let mut find_session = find_session_new()
  let mut dragging_tab_index = 0 - 1
  let mut context_menu = editor_ux_context_menu_hidden()
  let mut mouse_right_was_down = 0
  let mut indent_config = editor_indent_config_default()
  let mut minimap_lines: [StaticTextLine] = []
  let mut minimap_glyph_batch = static_text_glyph_batch_new()
  let mut minimap_cached_height = 0 - 1
  let mut minimap_cached_font_size = 0 - 1
  let mut editor_glyph_batch = static_text_glyph_batch_new()
  let mut editor_glyph_fingerprint = ""
  let mut minimap_drag = 0
  let mut scrollbar_drag = 0
  let mut frame_layout = frame_layout_new_pixel(
    document_from_string(""),
    "", line_index_from_string(""), 1, font_path, zoom_font_size, metrics.line_height
  )
  let mut last_width = 0
  let mut last_height = 0
  let mut last_mouse_x = 0 - 1
  let mut last_mouse_y = 0 - 1
  let mut last_mouse_down = 0
  let mut last_mouse_right_down = 0
  let mut last_backspace = 0
  let mut last_enter = 0
  let mut last_active_index = 0 - 1
  let mut clock_ms = 0
  let mut last_blink_visible = 0
  let mut last_caret_x = 0
  let mut last_caret_y = 0
  let mut last_caret_w = 0
  let mut last_caret_h = 0
  let mut last_caret_valid = 0
  let mut last_caret_rects: [CaretOverlayRect] = caret_overlay_empty()
  let mut cached_visual_rows: [VisualRow] = []
  let mut cached_visual_rows_valid = 0
  let mut last_chrome_hit_id = "none"
  let mut last_context_menu_visible = false
  let mut last_overlay_visible = false
  let mut text_layer_batch = editor_ux_text_layer_batch_new()
  let mut chrome_layer_batch = editor_ux_chrome_layer_batch_new()
  // §109a dogfood — shell drives phases via CMD_FILE (ack on PHASE_FILE).
  let mut dogfood_phase = ""
  let mut dogfood_type_chars = 0
  let mut dogfood_burst_done_ms = 0
  let mut dogfood_jitter_flip = 0
  let mut dogfood_stall_printed = 0
  let mut dogfood_emit_sink = 0
  // §109f — cumulative span lex bytes for dogfood markers.
  let mut span_lex_bytes = 0
  // §109b — prior-frame text-rect center (updated after layout; kill fixed 420).
  let mut dogfood_probe_x = 420
  let mut dogfood_probe_y = chrome_top + 80
  let mut wake_emit_sink = 0
  let mut wake_last_hit_id = "none"

  while glfw_gl_context_should_close() == 0 do
    if dogfood_probe then
      if dogfood_phase.byte_size() == 0 then
        dogfood_phase = "warmup"
        dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "phase=warmup")
      end
      if dogfood_cmd_file.byte_size() > 0 then
        const raw_cmd = dogfood_trim_newline(dogfood_phase_file_read(dogfood_cmd_file))
        if raw_cmd == "quit" then
          dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "done")
          break
        else if raw_cmd.byte_size() > 0 && raw_cmd != dogfood_phase then
          if raw_cmd == "idle_away" || raw_cmd == "still_over_text" ||
              raw_cmd == "text_jitter" || raw_cmd == "scroll" ||
              raw_cmd == "type" then
            dogfood_phase = raw_cmd
            dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "phase=" + raw_cmd)
            dogfood_emit_sink = dogfood_emit(
              dogfood_phase_file,
              "glyph_shape_calls=" + perf_counters.glyph_shape_calls.to_string()
            )
            dogfood_emit_sink = dogfood_emit(
              dogfood_phase_file,
              "editor_glyph_shape_calls=" +
                perf_counters.editor_glyph_shape_calls.to_string()
            )
            dogfood_emit_sink = dogfood_emit(
              dogfood_phase_file,
              "content_frame_count=" +
                perf_counters.content_frame_count.to_string()
            )
            dogfood_emit_sink = dogfood_emit(
              dogfood_phase_file,
              "span_lex_bytes=" + span_lex_bytes.to_string()
            )
            dogfood_emit_sink = dogfood_emit(
              dogfood_phase_file,
              "span_rebuild_count=" +
                frame_layout.span_cache.rebuild_count.to_string()
            )
            if raw_cmd == "type" then
              dogfood_type_chars = 0
              dogfood_stall_printed = 0
            end
          end
        end
      end
      if dogfood_phase == "warmup" || dogfood_phase == "idle_away" then
        glfw_gl_input_test_set(1200, 800, 0, 0)
      else if dogfood_phase == "text_jitter" then
        dogfood_jitter_flip = 1 - dogfood_jitter_flip
        glfw_gl_input_test_set(dogfood_probe_x + dogfood_jitter_flip, dogfood_probe_y, 0, 0)
      else if dogfood_phase == "still_over_text" ||
          dogfood_phase == "scroll" ||
          dogfood_phase == "type" then
        glfw_gl_input_test_set(dogfood_probe_x, dogfood_probe_y, 0, 0)
      end
      if dogfood_phase == "type" && dogfood_type_chars < 20 then
        glfw_gl_text_test_push("x")
        dogfood_type_chars = dogfood_type_chars + 1
        if dogfood_type_chars == 20 then
          dogfood_burst_done_ms = app.frame_index
          dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "type_burst_done")
          dogfood_emit_sink = dogfood_emit(
            dogfood_phase_file,
            "span_lex_bytes=" + span_lex_bytes.to_string()
          )
          dogfood_emit_sink = dogfood_emit(
            dogfood_phase_file,
            "span_rebuild_count=" + frame_layout.span_cache.rebuild_count.to_string()
          )
          dogfood_emit_sink = dogfood_emit(
            dogfood_phase_file,
            "content_frame_count=" +
              perf_counters.content_frame_count.to_string()
          )
        end
      end
      // Emit stall before idle-continue can skip the bottom of the loop.
      if dogfood_type_chars >= 20 && dogfood_stall_printed == 0 &&
          app.frame_index > dogfood_burst_done_ms then
        const stall_ms = (app.frame_index - dogfood_burst_done_ms) * 16
        dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "type_stall_ms=" + stall_ms.to_string())
        dogfood_emit_sink = dogfood_emit(dogfood_phase_file, "phase=type_end")
        dogfood_stall_printed = 1
      end
    end

    const scaled_font_size = f64_to_i32(
      i32_to_f64(zoom_font_size) * glfw_gl_window_content_scale_y()
    )

    const context_menu_visible_now = editor_ux_context_menu_is_visible(context_menu)
    const overlay_visible_now = dirty_close_overlay_is_visible(app.overlay)
    const frame_in = frame_input_poll(
      last_width, last_height,
      last_mouse_x, last_mouse_y, last_mouse_down, last_mouse_right_down,
      last_backspace, last_enter,
      context_menu_visible_now,
      overlay_visible_now,
      last_context_menu_visible,
      last_overlay_visible
    )
    last_context_menu_visible = context_menu_visible_now
    last_overlay_visible = overlay_visible_now
    const input = frame_in.input
    if input.escape != 0 then
      if editor_ux_context_menu_is_visible(context_menu) then
        context_menu = editor_ux_context_menu_dismiss(context_menu)
      else if !dirty_close_overlay_is_visible(app.overlay) then
        break
      end
    end

    let mut toolbar_tool = -1

    const width = frame_in.width
    const height = frame_in.height
    let mut pending_scroll_y = frame_in.pending_scroll_y
    let mut pending_binding_key = frame_in.pending_binding_key
    let mut pending_drop_path = frame_in.pending_drop_path
    let mut content_dirty = frame_in.content_dirty
    let mut pointer_dirty = frame_in.pointer_dirty
    let mut chrome_dirty = frame_in.chrome_dirty
    if dogfood_probe && dogfood_phase == "scroll" then
      content_dirty = 1
    end
    // §108d: raise pointer_dirty every tick; hit-stable plan clears it (same-hit hover).
    if hover_cpu_probe then
      pointer_dirty = 1
    end
    if app.ux.tabs.active_index != last_active_index then
      content_dirty = 1
    end

    last_mouse_x = input.mouse_x
    last_mouse_y = input.mouse_y
    last_mouse_down = input.mouse_down
    last_mouse_right_down = input.mouse_right_down
    last_backspace = input.backspace
    last_enter = input.enter

    // §108a — hit-stable pointer: same chrome hit-style id → no frame.
    const content_top = header_height() + tab_bar_height() + toolbar_height()
    const content_height = height - content_top - status_height()
    panels = shell_panels_set_bounds(
      panels, rect_new(0, content_top, width, content_height)
    )
    const tab_bar_y = header_height()
    const toolbar_y = header_height() + tab_bar_height()
    const tab_strip = ux_rect_new(0, tab_bar_y, width, tab_bar_height())
    const hit_slots = editor_ux_chrome_hit_slots_basic(
      width, height,
      header_height(), tab_bar_height(), toolbar_height(), status_height(),
      panels.panes.first, panels.panes.second
    )
    const chrome_hit_id = editor_ux_chrome_hit_style_id(
      input.mouse_x, input.mouse_y, hit_slots
    )
    if content_dirty == 0 && pointer_dirty != 0 then
      const hit_plan = editor_ux_chrome_hit_pointer_plan(
        pointer_dirty, last_chrome_hit_id, chrome_hit_id
      )
      if hit_plan.schedule_frame == 0 then
        pointer_dirty = 0
      else
        chrome_dirty = 1
        last_chrome_hit_id = hit_plan.next_hit_id
      end
    else if content_dirty != 0 then
      last_chrome_hit_id = chrome_hit_id
    end
    if wake_probe && chrome_hit_id != wake_last_hit_id then
      println("[wake] hit=" + chrome_hit_id)
      wake_last_hit_id = chrome_hit_id
    end

    let mut paint_dirty = 0
    // Idle before layout/chrome work — stable-hit pointer does not paint.
    if content_dirty == 0 && pointer_dirty == 0 && chrome_dirty == 0 && !perf_enabled then
      glfw_gl_context_wait_events_timeout(0.05)
      clock_ms = clock_ms + caret_blink_idle_wait_ms()
      paint_dirty = caret_blink_paint_dirty(
        clock_ms, caret_blink_period_ms(), last_blink_visible
      )
      if paint_dirty == 0 then
        perf_counters = editor_perf_note_idle_wait(perf_counters)
        if wake_probe then
          wake_emit_sink = wake_emit_counters(
            wake_counters_file, perf_counters, last_chrome_hit_id
          )
        end
        continue
      end
      // Paint-only blink: app.overlay carets without clearing / reshaping the frame.
      // idle_multi_caret_overlay: all cached last_caret_rects
      if caret_overlay_count(last_caret_rects) > 0 then
        const blink_on = caret_blink_visible(clock_ms, caret_blink_period_ms())
        if blink_on then
          last_blink_visible = 1
        else
          last_blink_visible = 0
        end
        solid = solid_renderer_begin(solid)
        let mut caret_overlay_ops: [EditorPaintOp] = []
        let mut overlay_index = 0
        while overlay_index < caret_overlay_count(last_caret_rects) do
          const overlay_rect = last_caret_rects[overlay_index]
          caret_overlay_ops.push(editor_paint_op_rect(
            "caret_overlay_erase",
            overlay_rect.x,
            overlay_rect.y,
            overlay_rect.width,
            overlay_rect.height,
            theme.background_red,
            theme.background_green,
            theme.background_blue,
            1.0
          ))
          if blink_on then
            caret_overlay_ops.push(editor_paint_op_rect(
              "caret_overlay",
              overlay_rect.x,
              overlay_rect.y,
              overlay_rect.width,
              overlay_rect.height,
              theme.caret_red,
              theme.caret_green,
              theme.caret_blue,
              1.0
            ))
          end
          overlay_index = overlay_index + 1
        end
        solid = editor_paint_ops_flatten(solid, width, height, caret_overlay_ops)
        const overlay_status = solid_renderer_flush_over(solid, width, height)
        if overlay_status != 0 then
          static_text_destroy(text_state)
          solid_renderer_destroy(solid)
          glfw_gl_context_end()
          return overlay_status
        end
        glfw_gl_context_swap_poll()
        perf_counters = editor_perf_note_present_frame(perf_counters)
        if wake_probe then
          wake_emit_sink = wake_emit_counters(
            wake_counters_file, perf_counters, last_chrome_hit_id
          )
        end
        continue
      end
      // Blink phase changed but no cached caret overlay yet — wait for a
      // content frame; do not fall through into a full wrap retick.
      perf_counters = editor_perf_note_idle_wait(perf_counters)
      if wake_probe then
        wake_emit_sink = wake_emit_counters(
          wake_counters_file, perf_counters, last_chrome_hit_id
        )
      end
      continue
    else
      clock_ms = clock_ms + 16
    end


    app = editor_app_set_tabs(app, ensure_tabs(app.ux.tabs, panels))
    let mut active = tab_set_active(app.ux.tabs)
    let mut document = active.buffer.document
    // Snapshot/layout retick only on real content changes — not pointer hover.
    frame_layout = frame_layout_tick_snapshot(frame_layout, document, content_dirty)
    let mut frame = frame_layout.snapshot_cache.snapshot
    let mut line_index = frame.line_index
    let mut draw_text = frame.text
    if perf_enabled then
      app = editor_app_wheel_scroll(app, metrics, 0 - 3, line_index)
    end

    // Pointer/chrome-only hover: reuse last visual rows / skip HarfBuzz wrap retick.
    let mut layout_skip = 0
    if content_dirty == 0 &&
        (pointer_dirty != 0 || chrome_dirty != 0) &&
        cached_visual_rows_valid != 0 then
      layout_skip = 1
    end
    if content_dirty != 0 then
      perf_counters = editor_perf_note_content_rebuild(perf_counters)
    end

    last_width = width
    last_height = height
    last_active_index = app.ux.tabs.active_index
    let mut perf_frame_t0 = 0
    let mut perf_layout_us = 0
    let mut perf_draw_t0 = 0
    if perf_enabled then
      perf_frame_t0 = editor_perf_now_us()
    end

    // TRACK_EDITOR_DROP_FILE STEP=3 — drain OS drop queue → open/activate app.ux.tabs
    let mut drop_path = pending_drop_path
    while drop_path.byte_size() > 0 do
      const before_count = tab_set_count(app.ux.tabs)
      const before_active = app.ux.tabs.active_index
      const drop_state = editor_ux_open_dropped_path(
        editor_ux_state_new(width, height, panels, app.ux.tabs, app.ux.selection, app.ux.tab_strip_height),
        drop_path
      )
      app = editor_app_set_tabs(app, drop_state.tabs)
      app = editor_app_set_selection(app, drop_state.selection)
      if tab_set_count(app.ux.tabs) != before_count || app.ux.tabs.active_index != before_active then
        active = tab_set_active(app.ux.tabs)
        document = active.buffer.document
        frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
        app = editor_app_set_history(app, history_new())
        multi = multi_selection_from_single(app.ux.selection)
        app = editor_app_set_last_command(app, "drop_open")
      end
      drop_path = glfw_gl_take_drop_path()
    end

    // Classic tab-strip layout: shared by hit-test and draw this frame.
    let mut tab_display_titles: [string] = []
    let mut tab_title_index = 0
    while tab_title_index < tab_set_count(app.ux.tabs) do
      const layout_tab = app.ux.tabs.tabs[tab_title_index]
      let mut layout_title = layout_tab.name
      if tab_is_dirty(layout_tab) then
        layout_title = layout_title + "*"
      end
      tab_display_titles.push(layout_title)
      tab_title_index = tab_title_index + 1
    end
    let mut tab_widths = tab_strip_layout_from_titles(
      tab_strip.width, tab_display_titles, metrics.char_width
    )

    const tree_rect = shell_panels_tree_rect(panels)
    const editor_rect = shell_panels_editor_rect(panels)
    const divider = panels.panes.divider
    const line_count = line_index_line_count(line_index)
    const gutter_metrics = gutter_metrics_new(metrics.char_width, 8, 8, 36)
    const gutter_width = gutter_width_for_line_count(line_count, gutter_metrics)
    const panes = gutter_layout(editor_rect, gutter_width)
    const content_band = panes.text
    const minimap_layout = editor_ux_minimap_layout_for_font(content_band, zoom_font_size)
    const text_rect = minimap_layout.text_rect
    const minimap_rect = minimap_layout.minimap_rect
    const minimap_enabled = minimap_layout.enabled
    // §109b — refresh dogfood/wake probe to live text-rect center for next frame.
    if text_rect.width > 0 && text_rect.height > 0 then
      dogfood_probe_x = text_rect.x + text_rect.width / 2
      dogfood_probe_y = text_rect.y + text_rect.height / 2
    end
    // §109e — dogfood scroll: bump offset without ensure_caret_visible (caret at
    // line 0 would snap wheel_scroll back every frame).
    if dogfood_probe && dogfood_phase == "scroll" then
      let mut dogfood_line_h = metrics.line_height
      if dogfood_line_h < 1 then
        dogfood_line_h = 1
      end
      app = editor_app_set_scroll_y(app, app.ux.scroll_offset_y + 3 * dogfood_line_h)
      content_dirty = 1
    end
    const content_clip = editor_ux_content_clip_rect(editor_rect, minimap_layout)
    const gutter_rect = panes.gutter
    const wrap_columns = wrap_max_columns(text_rect.width - 8, metrics.char_width)
    const wrap_viewport_width = text_rect.width - 8
    // Early path reuses prior-frame wrap metrics on frame_layout (late tick is sole retick).
    const visual_row_count = frame_layout.visual_row_count
    let mut wrapped_content_height = frame_layout.wrapped_content_height
    app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
    app = editor_app_clamp_scroll_to_content(
      app, wrapped_content_height, text_rect.height
    )
    let mut visible_row_budget = text_rect.height / metrics.line_height + 3
    if visible_row_budget < 1 then
      visible_row_budget = 1
    end
    let mut visual_rows = cached_visual_rows
    // §107j — early phase reuses cache; single collect is late (post tick_pixel).
    const tree_list_rect = folder_list_rect(tree_rect)
    const folder_rows = folder_tree_browser_rows(panels.tree)
    const crumbs_origin_x = folder_nav_crumbs_origin_x(tree_rect)
    const breadcrumb_segments = folder_breadcrumb_segments(
      folder_current_path(panels.tree), crumbs_origin_x, 8
    )
    const breadcrumb_rect = rect_new(
      tree_rect.x, tree_rect.y, tree_rect.width, folder_breadcrumb_height()
    )
    const nav_back_rect = folder_nav_back_rect(tree_rect)
    const nav_forward_rect = folder_nav_forward_rect(tree_rect)
    tree_scroll_y = folder_clamp_scroll(
      tree_scroll_y, folder_rows.length(), tree_list_rect.height
    )
    const tree_hovered =
      point_in_rect(point_new(input.mouse_x, input.mouse_y), tree_rect) != 0

    app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
    glfw_gl_cursor_set(
      editor_ux_cursor_shape_at(app.ux, input.mouse_x, input.mouse_y)
    )

    const viewport = viewport_metrics_new(
      metrics.line_height, text_rect.height, text_rect.width, 1
    )
    let mut visible = visible_line_range(line_count, app.ux.scroll_offset_y, viewport)
    let mut view_metrics = editor_view_metrics_new(
      metrics.line_height, metrics.char_width,
      text_rect.x + 4, text_rect.y + 2,
      app.ux.scroll_offset_x, app.ux.scroll_offset_y,
      text_rect.height / metrics.line_height
    )

    const scroll_ticks = f64_to_i32(pending_scroll_y * 3.0)
    const wheel_editor_hovered =
      point_in_rect(point_new(input.mouse_x, input.mouse_y), editor_rect)
    const wheel_target = editor_wheel_hover_target(
      if tree_hovered then 1 else 0,
      wheel_editor_hovered
    )
    if scroll_ticks != 0 && wheel_target == editor_wheel_target_tree() then
      tree_scroll_y = folder_clamp_scroll(
        tree_scroll_y - scroll_ticks * folder_row_height(),
        folder_rows.length(),
        tree_list_rect.height
      )
    else if scroll_ticks != 0 && wheel_target == editor_wheel_target_editor() then
      if glfw_gl_mod_ctrl_down() != 0 then
        const zoomed = editor_ux_font_zoom(zoom_font_size, scroll_ticks)
        zoom_font_size = zoomed.font_size
        metrics = zoomed.metrics
        app = editor_app_set_last_command(app, "font_zoom")
      else if glfw_gl_mod_shift_down() != 0 then
        let mut char_width = metrics.char_width
        if char_width <= 0 then
          char_width = 1
        end
        const content_width =
          frame_layout.max_columns_cache.max_columns * char_width
        app = editor_app_wheel_scroll_horizontal(
          app, metrics, scroll_ticks, content_width, text_rect.width
        )
        app = editor_app_set_last_command(app, "scroll_x")
        view_metrics = editor_view_metrics_new(
          metrics.line_height, metrics.char_width,
          text_rect.x + 4, text_rect.y + 2,
          app.ux.scroll_offset_x, app.ux.scroll_offset_y,
          text_rect.height / metrics.line_height
        )
      else
        app = editor_app_wheel_scroll(app, metrics, scroll_ticks, line_index)
        app = editor_app_clamp_scroll_to_content(
          app, wrapped_content_height, text_rect.height
        )
        visible = visible_line_range(line_count, app.ux.scroll_offset_y, viewport)
        view_metrics = editor_view_metrics_new(
          metrics.line_height, metrics.char_width,
          text_rect.x + 4, text_rect.y + 2,
          app.ux.scroll_offset_x, app.ux.scroll_offset_y,
          text_rect.height / metrics.line_height
        )
        // §107j — no mid-frame collect; late path refreshes visual_rows for paint.
      end
    end

    if dirty_close_overlay_is_visible(app.overlay) then
      if input.mouse_down != 0 && app.mouse_was_down == 0 then
        const before_visible = dirty_close_overlay_is_visible(app.overlay)
        const before_count = tab_set_count(app.ux.tabs)
        const outcome = dirty_close_overlay_click(
          app.ux.tabs, app.overlay, input.mouse_x, input.mouse_y, width, height
        )
        app = editor_app_set_tabs(app, outcome.tabs)
        app = editor_app_set_overlay(app, outcome.overlay)
        if before_visible && !dirty_close_overlay_is_visible(app.overlay) then
          if tab_set_count(app.ux.tabs) < before_count then
            if tab_set_has_active(app.ux.tabs) then
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              app = editor_app_set_selection(app, selection_collapsed(0))
              app = editor_app_set_history(app, history_new())
            end
            app = editor_app_set_last_command(app, "close_discard")
          else
            app = editor_app_set_last_command(app, "close_cancel")
          end
        end
      end
      app = editor_app_set_mouse_was_down(app, input.mouse_down)
      mouse_right_was_down = input.mouse_right_down
    else if editor_ux_context_menu_is_visible(context_menu) then
      if input.mouse_down != 0 && app.mouse_was_down == 0 then
        const menu_click = editor_ux_context_menu_click(
          context_menu, input.mouse_x, input.mouse_y
        )
        context_menu = menu_click.menu
        if context_menu_action_is_copy(menu_click.action) then
          if !selection_is_empty(app.ux.selection) then
            app = editor_app_set_clipboard(app, edit_copy(document, app.ux.selection, app.clipboard))
            clipboard_push_to_os(app.clipboard)
            app = editor_app_set_last_command(app, "context_copy")
          end
        else if context_menu_action_is_cut(menu_click.action) then
          if !selection_is_empty(app.ux.selection) then
            app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
            const cut_span = edit_apply_span_replace_selection(app.ux.selection, "")
            const cut_result = edit_cut(document, app.ux.selection, app.clipboard)
            app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, cut_result.document))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_after_span_edit(frame_layout, document, cut_span)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, cut_result.selection)
            multi = multi_selection_from_single(app.ux.selection)
            app = editor_app_set_clipboard(app, cut_result.clipboard)
            clipboard_push_to_os(app.clipboard)
            app = editor_app_set_last_command(app, "context_cut")
          end
        else if context_menu_action_is_paste(menu_click.action) then
          app = editor_app_set_clipboard(app, clipboard_pull_from_os(app.clipboard))
          app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
          const paste_span = edit_apply_span_replace_selection(
            app.ux.selection, clipboard_get(app.clipboard)
          )
          const paste_result = edit_paste(document, app.ux.selection, app.clipboard)
          app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, paste_result.document))
          active = tab_set_active(app.ux.tabs)
          document = active.buffer.document
          frame_layout = frame_layout_after_span_edit(frame_layout, document, paste_span)
          frame = frame_layout.snapshot_cache.snapshot
          line_index = frame.line_index
          draw_text = frame.text
          app = editor_app_set_selection(app, paste_result.selection)
          multi = multi_selection_from_single(app.ux.selection)
          app = editor_app_set_last_command(app, "context_paste")
        end
      end
      app = editor_app_set_mouse_was_down(app, input.mouse_down)
      mouse_right_was_down = input.mouse_right_down
    else if input.mouse_right_down != 0 && mouse_right_was_down == 0 &&
        point_in_rect(point_new(input.mouse_x, input.mouse_y), text_rect) != 0 then
      app = editor_app_set_editor_focused(app, 1)
      context_menu = editor_ux_context_menu_open_at(
        context_menu, input.mouse_x, input.mouse_y
      )
      app = editor_app_set_last_command(app, "context_menu")
      mouse_right_was_down = input.mouse_right_down
    else if input.mouse_down != 0 && app.mouse_was_down == 0 then
      let mut handled = 0
      let mut tool = 0
      const toolbar_count = editor_app_toolbar_count()
      while tool < toolbar_count do
        if point_in_rect(point_new(input.mouse_x, input.mouse_y), toolbar_button_rect(tool, toolbar_y)) != 0 then
          toolbar_tool = tool
          handled = 1
        end
        tool = tool + 1
      end

      if handled == 0 && shell_panels_divider_hit(panels, input.mouse_x, input.mouse_y) != 0 then
        if dragging_tab_index < 0 then
          panels = shell_panels_begin_drag(panels, input.mouse_x)
          app = editor_app_set_selecting_text(app, 0)
          handled = 1
        end
      end

      if handled == 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        app = editor_app_commit_session(
          app, app.history, app.clipboard, app.overlay, app.editor_focused, app.last_command,
          app.mouse_was_down, app.backspace_was_down, app.enter_was_down, app.selecting_text
        )
        const close_hit = tab_strip_hit_close_index_from_widths(
          tab_strip, tab_widths, input.mouse_x, input.mouse_y
        )
        const tab_click = editor_app_click_tab_strip(
          app, tab_strip, tab_widths, input.mouse_x, input.mouse_y
        )
        if tab_click.handled != 0 then
          app = tab_click.app
          if tab_set_has_active(app.ux.tabs) then
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
          end
          if close_hit < 0 then
            const title_hit = tab_strip_hit_index_from_widths(
              tab_strip, tab_widths, input.mouse_x, input.mouse_y
            )
            if title_hit >= 0 then
              dragging_tab_index = title_hit
            end
          end
          handled = 1
        end
      end

      if handled == 0 && minimap_enabled != 0 &&
          point_in_rect(point_new(input.mouse_x, input.mouse_y), minimap_rect) != 0 then
        const mapped = editor_ux_minimap_scroll_at_y(
          input.mouse_y, minimap_rect, wrapped_content_height, text_rect.height
        )
        app = editor_app_set_scroll_y(app, mapped)
        app = editor_app_set_scroll_y(app, mapped)
        minimap_drag = 1
        scrollbar_drag = 0
        app = editor_app_set_selecting_text(app, 0)
        app = editor_app_set_last_command(app, "minimap_scroll")
        handled = 1
      end

      // scrollbar_thumb_drag: press on Y/X content track → scroll
      if handled == 0 then
        const scroll_track_y = editor_ux_content_scrollbar_track_y(text_rect)
        if point_in_rect(point_new(input.mouse_x, input.mouse_y), scroll_track_y) != 0 then
          const mapped_y = editor_ux_content_scrollbar_scroll_at_y(
            input.mouse_y, text_rect, wrapped_content_height, text_rect.height
          )
          app = editor_app_set_scroll_y(app, mapped_y)
          app = editor_app_set_scroll_y(app, mapped_y)
          scrollbar_drag = 1
          minimap_drag = 0
          app = editor_app_set_selecting_text(app, 0)
          app = editor_app_set_last_command(app, "scrollbar_thumb_drag")
          handled = 1
        end
      end
      if handled == 0 then
        const scroll_track_x = editor_ux_content_scrollbar_track_x(text_rect)
        if point_in_rect(point_new(input.mouse_x, input.mouse_y), scroll_track_x) != 0 then
          let mut drag_char_width = metrics.char_width
          if drag_char_width <= 0 then
            drag_char_width = 1
          end
          const drag_content_width =
            frame_layout.max_columns_cache.max_columns * drag_char_width
          const mapped_x = editor_ux_content_scrollbar_scroll_at_x(
            input.mouse_x, text_rect, drag_content_width, text_rect.width
          )
          app = editor_app_set_scroll_x(app, mapped_x)
          scrollbar_drag = 2
          minimap_drag = 0
          app = editor_app_set_selecting_text(app, 0)
          app = editor_app_set_last_command(app, "scrollbar_thumb_drag")
          handled = 1
        end
      end

      if handled == 0 && point_in_rect(point_new(input.mouse_x, input.mouse_y), text_rect) != 0 then
        if dragging_tab_index < 0 then
          app = editor_app_set_editor_focused(app, 1)
          const click_offset = wrap_offset_at_point_pixel(
            draw_text, line_index, wrap_viewport_width, font_path, zoom_font_size,
            text_rect.x + 4, text_rect.y + 2, app.ux.scroll_offset_y, app.ux.scroll_offset_x,
            metrics.line_height,
            input.mouse_x, input.mouse_y
          )
          if glfw_gl_mod_shift_down() != 0 then
            app = editor_app_set_selection(app, editor_ux_shift_click_extend(
              line_index, app.ux.selection, click_offset, 1
            ))
            multi = multi_selection_from_single(app.ux.selection)
          else if glfw_gl_mod_ctrl_down() != 0 then
            multi = editor_ux_add_cursor(multi, click_offset)
            app = editor_app_set_selection(app, multi_selection_primary(multi))
          else
            const click_clock_ms = app.frame_index * 16
            const multi_result = editor_ux_apply_multi_click(
              line_index, multi_click, click_offset, click_clock_ms
            )
            multi_click = multi_result.state
            app = editor_app_set_selection(app, selection_clamp(
              multi_result.selection, line_index.text_length
            ))
            multi = multi_selection_from_single(app.ux.selection)
          end
          app = editor_app_set_selecting_text(app, 1)
          minimap_drag = 0
          scrollbar_drag = 0
          handled = 1
        end
      end

      // folder_scrollbar_thumb_drag: press on tree track → tree_scroll_y
      if handled == 0 then
        const folder_track = folder_scrollbar_track(tree_list_rect)
        if point_in_rect(point_new(input.mouse_x, input.mouse_y), folder_track) != 0 then
          tree_scroll_y = folder_scrollbar_scroll_at_y(
            input.mouse_y, tree_list_rect, folder_rows.length()
          )
          scrollbar_drag = 3
          minimap_drag = 0
          app = editor_app_set_selecting_text(app, 0)
          app = editor_app_set_last_command(app, "folder_scrollbar_thumb_drag")
          handled = 1
        end
      end

      if handled == 0 then
        const folder_click = folder_browser_resolve_click(
          tree_rect,
          breadcrumb_segments,
          breadcrumb_rect,
          folder_rows,
          tree_list_rect,
          tree_scroll_y,
          folder_nav,
          last_tree_click_path,
          last_tree_click_frame,
          app.frame_index,
          input.mouse_x,
          input.mouse_y
        )
        if folder_click.handled != 0 then
          app = editor_app_set_editor_focused(app, 0)
          folder_nav = folder_click.folder_nav
          tree_scroll_y = folder_click.tree_scroll_y
          last_tree_click_path = folder_click.last_tree_click_path
          last_tree_click_frame = folder_click.last_tree_click_frame
          if folder_click.last_command.byte_size() > 0 then
            app = editor_app_set_last_command(app, folder_click.last_command)
          end
          const action = folder_click.action
          if action == folder_click_nav_back() ||
            action == folder_click_nav_forward() ||
            action == folder_click_breadcrumb() ||
            action == folder_click_parent() ||
            action == folder_click_enter_dir() then
            panels = browse_panels_to(panels, folder_click.path)
          else if action == folder_click_toggle_expand() then
            let mut toggle_node_id = 0 - 1
            let mut toggle_row = 0
            while toggle_row < folder_rows.length() do
              if folder_rows[toggle_row].path == folder_click.path then
                toggle_node_id = folder_rows[toggle_row].node_id
              end
              toggle_row = toggle_row + 1
            end
            if toggle_node_id >= 0 then
              const use_disk = tree_uses_disk(panels.tree)
              const toggle_entries =
                listing_entries_for(folder_click.path, use_disk)
              panels = panels_with_tree(
                panels,
                folder_tree_toggle_node(
                  panels.tree, toggle_node_id, toggle_entries
                )
              )
            end
          else if action == folder_click_open_file() then
            const open_path = folder_click.path
            app = editor_app_set_tabs(app, open_path_into_tabs(app.ux.tabs, open_path))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, selection_collapsed(0))
            app = editor_app_set_history(app, history_new())
          end
          app = editor_app_set_selecting_text(app, 0)
          handled = 1
        end
      end
    end

    if !dirty_close_overlay_is_visible(app.overlay) then
      let mut binding_key = ""
      if toolbar_tool < 0 then
        binding_key = pending_binding_key
        pending_binding_key = ""
      end
      if app.editor_focused != 0 && editor_ux_is_nav_key(binding_key) then
        if glfw_gl_mod_ctrl_down() != 0 &&
            (binding_key == "left" || binding_key == "right") then
          app = editor_app_set_selection(app, editor_ux_apply_word_nav_key(
            line_index,
            app.ux.selection,
            binding_key,
            glfw_gl_mod_shift_down()
          ))
          app = editor_app_set_last_command(app, "nav_word_" + binding_key)
        else
          app = editor_app_set_selection(app, editor_ux_apply_nav_key(
            line_index,
            app.ux.selection,
            view_metrics,
            binding_key,
            glfw_gl_mod_shift_down()
          ))
          app = editor_app_set_last_command(app, "nav_" + binding_key)
        end
        multi = multi_selection_from_single(app.ux.selection)
        binding_key = ""
      end
      if app.editor_focused != 0 && binding_key == "delete" &&
          glfw_gl_mod_ctrl_down() != 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        app = editor_app_delete_word_forward(app)
        multi = multi_selection_from_single(app.ux.selection)
        active = tab_set_active(app.ux.tabs)
        document = active.buffer.document
        frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
        app = editor_app_set_last_command(app, "delete_word_forward")
        binding_key = ""
      end
      if app.editor_focused != 0 && binding_key == "tab" &&
          glfw_gl_mod_ctrl_down() == 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        if glfw_gl_mod_shift_down() != 0 then
          app = editor_app_outdent_lines(app, indent_config)
          app = editor_app_set_last_command(app, "outdent")
        else
          app = editor_app_indent_tab(app, indent_config)
          app = editor_app_set_last_command(app, "indent")
        end
        multi = multi_selection_from_single(app.ux.selection)
        active = tab_set_active(app.ux.tabs)
        document = active.buffer.document
        frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
        binding_key = ""
      end
      const dispatch_command = editor_app_frame_command_from_inputs(
        toolbar_tool,
        command_bindings,
        app.editor_focused,
        glfw_gl_mod_ctrl_down(),
        glfw_gl_mod_shift_down(),
        glfw_gl_mod_alt_down(),
        binding_key
      )
      if command_id_tag(dispatch_command) != "none" then
        app = editor_app_set_last_command(app, command_id_tag(dispatch_command))
        match dispatch_command
        | CmdPrevTab => do
            app = editor_app_set_tabs(app, tab_set_activate_prev(app.ux.tabs))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, selection_collapsed(0))
            app = editor_app_set_history(app, history_new())
          end
        | CmdNextTab => do
            app = editor_app_set_tabs(app, tab_set_activate_next(app.ux.tabs))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, selection_collapsed(0))
            app = editor_app_set_history(app, history_new())
          end
        | CmdCloseTab => do
            const closing_terminal = editor_app_terminal_tab_active(app)
            const close_outcome = tab_set_request_close(app.ux.tabs, app.ux.tabs.active_index)
            app = editor_app_set_tabs(app, close_outcome.tabs)
            app = editor_app_set_overlay(app, close_outcome.overlay)
            if closing_terminal && !dirty_close_overlay_is_visible(app.overlay) then
              app = editor_app_close_terminal(app)
            end
            if !dirty_close_overlay_is_visible(app.overlay) && tab_set_has_active(app.ux.tabs) then
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              app = editor_app_set_selection(app, selection_collapsed(0))
              app = editor_app_set_history(app, history_new())
            end
          end
        | CmdUndo => do
            const undo_result = history_undo(app.history, document, app.ux.selection)
            if undo_result.applied != 0 then
              app = editor_app_set_history(app, undo_result.history)
              app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, undo_result.document))
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              app = editor_app_set_selection(app, undo_result.selection)
            end
          end
        | CmdRedo => do
            const redo_result = history_redo(app.history, document, app.ux.selection)
            if redo_result.applied != 0 then
              app = editor_app_set_history(app, redo_result.history)
              app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, redo_result.document))
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              app = editor_app_set_selection(app, redo_result.selection)
            end
          end
        | CmdSelectAll => do
            app = editor_app_set_selection(app, edit_select_all(document))
          end
        | CmdFind => do
            const find_applied = find_session_seed_from_selection(
              find_session, draw_text, app.ux.selection
            )
            find_session = find_applied.session
            app = editor_app_set_selection(app, find_applied.selection)
          end
        | CmdFindNext => do
            const find_next_applied = find_session_next(find_session, app.ux.selection)
            find_session = find_next_applied.session
            app = editor_app_set_selection(app, find_next_applied.selection)
          end
        | CmdFindPrev => do
            const find_prev_applied = find_session_prev(find_session, app.ux.selection)
            find_session = find_prev_applied.session
            app = editor_app_set_selection(app, find_prev_applied.selection)
          end
        | CmdGotoLine => do
            app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
            app = editor_app_goto_line_from_selection(app, metrics, line_index)
          end
        | CmdReplaceOne => do
            app = editor_app_set_clipboard(app, clipboard_pull_from_os(app.clipboard))
            if !clipboard_is_empty(app.clipboard) then
              find_session = find_session_set_replacement(
                find_session, clipboard_get(app.clipboard)
              )
            end
            const replace_one_result = find_replace_one(
              find_session, document, app.ux.selection
            )
            if replace_one_result.applied != 0 then
              app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
              app = editor_app_set_tabs(app, apply_edit(
                app.ux.tabs, replace_one_result.document
              ))
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
            end
            find_session = replace_one_result.session
            app = editor_app_set_selection(app, replace_one_result.selection)
          end
        | CmdReplaceAll => do
            app = editor_app_set_clipboard(app, clipboard_pull_from_os(app.clipboard))
            if !clipboard_is_empty(app.clipboard) then
              find_session = find_session_set_replacement(
                find_session, clipboard_get(app.clipboard)
              )
            end
            const replace_all_result = find_replace_all(
              find_session, document, app.ux.selection
            )
            if replace_all_result.applied != 0 then
              app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
              app = editor_app_set_tabs(app, apply_edit(
                app.ux.tabs, replace_all_result.document
              ))
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
            end
            find_session = replace_all_result.session
            app = editor_app_set_selection(app, replace_all_result.selection)
          end
        | CmdToggleLineComment => do
            app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
            const comment_language = status_bar_language_from_path(active.path)
            app = editor_app_toggle_line_comment(app, comment_language)
            multi = multi_selection_from_single(app.ux.selection)
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
          end
        | CmdCopy => do
            app = editor_app_set_clipboard(app, edit_copy(document, app.ux.selection, app.clipboard))
            clipboard_push_to_os(app.clipboard)
          end
        | CmdCut => do
            app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
            const cut_span = edit_apply_span_replace_selection(app.ux.selection, "")
            const cut_result = edit_cut(document, app.ux.selection, app.clipboard)
            app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, cut_result.document))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_after_span_edit(frame_layout, document, cut_span)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, cut_result.selection)
            app = editor_app_set_clipboard(app, cut_result.clipboard)
            clipboard_push_to_os(app.clipboard)
          end
        | CmdPaste => do
            app = editor_app_set_clipboard(app, clipboard_pull_from_os(app.clipboard))
            app = editor_app_set_history(app, history_push_before_edit(app.history, document, app.ux.selection))
            const paste_span = edit_apply_span_replace_selection(
              app.ux.selection, clipboard_get(app.clipboard)
            )
            const paste_result = edit_paste(document, app.ux.selection, app.clipboard)
            app = editor_app_set_tabs(app, apply_edit(app.ux.tabs, paste_result.document))
            active = tab_set_active(app.ux.tabs)
            document = active.buffer.document
            frame_layout = frame_layout_after_span_edit(frame_layout, document, paste_span)
            frame = frame_layout.snapshot_cache.snapshot
            line_index = frame.line_index
            draw_text = frame.text
            app = editor_app_set_selection(app, paste_result.selection)
          end
        | CmdSave => do
            app = editor_app_save_active_buffer(app)
            if tab_set_has_active(app.ux.tabs) then
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
            end
          end
        | CmdSaveSession => do
            if save_demo_session(
              app.ux.tabs,
              selection_caret(app.ux.selection),
              app.ux.scroll_offset_y,
              app.ux.scroll_offset_x
            ) != 0 then
              app = editor_app_set_last_command(app, "session_save")
            else
              app = editor_app_set_last_command(app, "session_save_fail")
            end
          end
        | CmdLoadSession => do
            const loaded = load_demo_session()
            if tab_set_count(loaded) > 0 then
              app = editor_app_set_tabs(app, loaded)
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              const loaded_view = load_demo_session_view(app.ux.tabs)
              app = editor_app_set_selection(app, selection_collapsed(loaded_view.caret))
              app = editor_app_set_scroll_y(app, loaded_view.scroll_offset_y)
              app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
              app = editor_app_set_scroll_y(app, loaded_view.scroll_offset_y)
              app = editor_app_set_scroll_x(app, loaded_view.scroll_offset_x)
              app = editor_app_set_history(app, history_new())
              app = editor_app_set_last_command(app, "session_load")
            else
              app = editor_app_set_last_command(app, "session_load_empty")
            end
          end
        | CmdOpenTerminal => do
            const cell_rows = text_rect.height / metrics.line_height
            const cell_columns = text_rect.width / metrics.char_width
            let mut open_rows = cell_rows
            if open_rows < 8 then
              open_rows = 8
            end
            let mut open_columns = cell_columns
            if open_columns < 40 then
              open_columns = 40
            end
            app = editor_app_open_terminal(app, open_rows, open_columns, "sh")
            if tab_set_has_active(app.ux.tabs) then
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
            end
          end
        | CmdNone => do
          end
        end
      end
    end

    if !dirty_close_overlay_is_visible(app.overlay) then
      if input.mouse_down != 0 && panels.dragging != 0 then
        panels = shell_panels_drag_to(panels, input.mouse_x)
      end
      if input.mouse_down != 0 && minimap_drag != 0 &&
          panels.dragging == 0 && minimap_enabled != 0 then
        const mapped_drag = editor_ux_minimap_scroll_at_y(
          input.mouse_y, minimap_rect, wrapped_content_height, text_rect.height
        )
        app = editor_app_set_scroll_y(app, mapped_drag)
        app = editor_app_set_scroll_y(app, mapped_drag)
        app = editor_app_set_last_command(app, "minimap_scroll")
      end
      if input.mouse_down != 0 && scrollbar_drag == 1 &&
          panels.dragging == 0 && minimap_drag == 0 then
        const mapped_sb_y = editor_ux_content_scrollbar_scroll_at_y(
          input.mouse_y, text_rect, wrapped_content_height, text_rect.height
        )
        app = editor_app_set_scroll_y(app, mapped_sb_y)
        app = editor_app_set_scroll_y(app, mapped_sb_y)
        app = editor_app_set_last_command(app, "scrollbar_thumb_drag")
      end
      if input.mouse_down != 0 && scrollbar_drag == 2 &&
          panels.dragging == 0 && minimap_drag == 0 then
        let mut drag_char_width_move = metrics.char_width
        if drag_char_width_move <= 0 then
          drag_char_width_move = 1
        end
        const drag_content_width_move =
          frame_layout.max_columns_cache.max_columns * drag_char_width_move
        const mapped_sb_x = editor_ux_content_scrollbar_scroll_at_x(
          input.mouse_x, text_rect, drag_content_width_move, text_rect.width
        )
        app = editor_app_set_scroll_x(app, mapped_sb_x)
        app = editor_app_set_last_command(app, "scrollbar_thumb_drag")
      end
      if input.mouse_down != 0 && scrollbar_drag == 3 &&
          panels.dragging == 0 && minimap_drag == 0 then
        tree_scroll_y = folder_scrollbar_scroll_at_y(
          input.mouse_y, tree_list_rect, folder_rows.length()
        )
        app = editor_app_set_last_command(app, "folder_scrollbar_thumb_drag")
      end
      if input.mouse_down != 0 && app.selecting_text != 0 &&
          panels.dragging == 0 && dragging_tab_index < 0 &&
          minimap_drag == 0 && scrollbar_drag == 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        app = editor_app_set_scroll_y(app, app.ux.scroll_offset_y)
        app = editor_app_drag_text_autoscroll(
          app, metrics, input.mouse_x, input.mouse_y, line_index
        )
      end
      if input.mouse_down == 0 && app.mouse_was_down != 0 then
        panels = shell_panels_end_drag(panels)
        if dragging_tab_index >= 0 then
          const drop_hit = tab_strip_hit_index_from_widths(
            tab_strip, tab_widths, input.mouse_x, input.mouse_y
          )
          if drop_hit >= 0 && drop_hit != dragging_tab_index then
            app = editor_app_set_tabs(app, tab_set_move(app.ux.tabs, dragging_tab_index, drop_hit))
            if tab_set_has_active(app.ux.tabs) then
              active = tab_set_active(app.ux.tabs)
              document = active.buffer.document
              frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
              frame = frame_layout.snapshot_cache.snapshot
              line_index = frame.line_index
              draw_text = frame.text
              app = editor_app_set_selection(app, selection_collapsed(0))
            end
            app = editor_app_set_last_command(app, "reorder_tab")
          end
          dragging_tab_index = 0 - 1
        end
        app = editor_app_set_selecting_text(app, 0)
        minimap_drag = 0
        scrollbar_drag = 0
      end
      app = editor_app_set_mouse_was_down(app, input.mouse_down)
      mouse_right_was_down = input.mouse_right_down

      if editor_app_terminal_tab_active(app) then
        app = editor_app_terminal_frame(
          app,
          input.text_buffer,
          input.backspace,
          input.enter,
          pending_binding_key,
          glfw_gl_mod_ctrl_down()
        )
        pending_binding_key = ""
      else if input.text_buffer.length() > 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        // §107f — single-caret insert knows the edit span; keep full tick for multi.
        // Autoclose may expand/skip the typed bytes — length mismatch falls back.
        const insert_byte_start = selection_start(app.ux.selection)
        const insert_removed_len =
          selection_end(app.ux.selection) - insert_byte_start
        const insert_text = input.text_buffer
        let mut insert_used_apply_edit = 0
        if multi_selection_count(multi) > 1 then
          const multi_insert = editor_app_insert_text_with_multi(
            app, multi, insert_text
          )
          app = multi_insert.app
          multi = multi_insert.multi
        else
          app = editor_app_insert_text(app, insert_text)
          multi = multi_selection_from_single(app.ux.selection)
          insert_used_apply_edit = 1
        end
        active = tab_set_active(app.ux.tabs)
        document = active.buffer.document
        if insert_used_apply_edit != 0 then
          frame_layout = frame_layout_tick_snapshot_edit(
            frame_layout, insert_byte_start, insert_removed_len, insert_text
          )
          if !line_index_matches_document(
            frame_layout.snapshot_cache.snapshot.line_index, document
          ) then
            frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
          end
        else
          frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
        end
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
      end
      if !editor_app_terminal_tab_active(app) && input.enter != 0 && app.enter_was_down == 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        const newline_span = edit_apply_span_newline(document, app.ux.selection)
        app = editor_app_insert_newline(app)
        multi = multi_selection_from_single(app.ux.selection)
        active = tab_set_active(app.ux.tabs)
        document = active.buffer.document
        frame_layout = frame_layout_after_span_edit(frame_layout, document, newline_span)
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
      end
      if !editor_app_terminal_tab_active(app) && input.backspace != 0 && app.backspace_was_down == 0 then
        app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
        if glfw_gl_mod_ctrl_down() != 0 then
          app = editor_app_delete_word_backward(app)
          app = editor_app_set_last_command(app, "delete_word_backward")
          multi = multi_selection_from_single(app.ux.selection)
          active = tab_set_active(app.ux.tabs)
          document = active.buffer.document
          // Allowlist: word-delete span not in §109g cut — full flatten.
          frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
        else
          const backspace_span = edit_apply_span_backspace(document, app.ux.selection)
          app = editor_app_backspace(app)
          multi = multi_selection_from_single(app.ux.selection)
          active = tab_set_active(app.ux.tabs)
          document = active.buffer.document
          frame_layout = frame_layout_after_span_edit(frame_layout, document, backspace_span)
        end
        frame = frame_layout.snapshot_cache.snapshot
        line_index = frame.line_index
        draw_text = frame.text
      end
      app = editor_app_set_enter_was_down(app, input.enter)
      app = editor_app_set_backspace_was_down(app, input.backspace)
    else
      app = editor_app_set_mouse_was_down(app, input.mouse_down)
    end

    app = editor_app_set_tabs(app, ensure_tabs(app.ux.tabs, panels))
    active = tab_set_active(app.ux.tabs)
    document = active.buffer.document
    if editor_app_terminal_tab_active(app) then
      // Idle drain only — must not zero enter/backspace edge state (see
      // editor_app_terminal_drain).
      app = editor_app_terminal_drain(app)
    end
    if !line_index_matches_document(frame.line_index, document) then
      frame_layout = frame_layout_tick_snapshot(frame_layout, document, 1)
      frame = frame_layout.snapshot_cache.snapshot
    end
    line_index = frame.line_index
    draw_text = frame.text
    app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
    if !(dogfood_probe && dogfood_phase == "scroll") then
      app = editor_app_ensure_caret_visible(app, metrics, line_index)
    end
    const wrap_columns_now = wrap_max_columns(text_rect.width - 8, metrics.char_width)
    const wrap_viewport_width_now = text_rect.width - 8
    let mut perf_layout_t0 = 0
    let mut frame_visible_collect_count = 0
    if perf_enabled then
      perf_layout_t0 = editor_perf_now_us()
    end
    let mut skip_full_pixel_wrap_now = 0
    if perf_skip_heavy || layout_skip != 0 then
      skip_full_pixel_wrap_now = 1
    end
    // §109e — scroll-only: wrap cache is version-stable; skip full pixel wrap retick.
    if dogfood_probe && dogfood_phase == "scroll" then
      skip_full_pixel_wrap_now = 1
    end
    if layout_skip == 0 then
      frame_layout = frame_layout_tick_pixel(
        frame_layout, document.version, draw_text, line_index,
        wrap_viewport_width_now, font_path, zoom_font_size, metrics.line_height,
        skip_full_pixel_wrap_now
      )
      frame_layout = frame_layout_tick_max_columns(
        frame_layout, document.version, line_index
      )
    end
    const visual_row_count_now = frame_layout.visual_row_count
    let mut wrapped_content_height_now = frame_layout.wrapped_content_height
    app = editor_app_clamp_scroll_to_content(
      app, wrapped_content_height_now, text_rect.height
    )
    visible = visible_line_range(line_index_line_count(line_index), app.ux.scroll_offset_y, viewport)
    if layout_skip == 0 then
      // §107j — single visible-row collect per content frame.
      visual_rows = collect_visible_visual_rows_pixel_budget_cached(
        draw_text, line_index, wrap_viewport_width_now, font_path, zoom_font_size,
        frame_layout.wrap_count_cache.prefix_visual_rows,
        app.ux.scroll_offset_y / metrics.line_height, visible_row_budget
      ).rows
      cached_visual_rows = visual_rows
      cached_visual_rows_valid = 1
      if perf_enabled then
        frame_visible_collect_count = 1
      end
    end
    if perf_enabled then
      perf_layout_us = editor_perf_now_us() - perf_layout_t0
    end

    // Refresh classic tab layout after input may have changed app.ux.tabs.
    tab_display_titles = []
    tab_title_index = 0
    while tab_title_index < tab_set_count(app.ux.tabs) do
      const hover_layout_tab = app.ux.tabs.tabs[tab_title_index]
      let mut hover_layout_title = hover_layout_tab.name
      if tab_is_dirty(hover_layout_tab) then
        hover_layout_title = hover_layout_title + "*"
      end
      tab_display_titles.push(hover_layout_title)
      tab_title_index = tab_title_index + 1
    end
    tab_widths = tab_strip_layout_from_titles(
      tab_strip.width, tab_display_titles, metrics.char_width
    )

    if perf_enabled then
      perf_draw_t0 = editor_perf_now_us()
    end
    solid = solid_renderer_begin(solid)
    // §108c — rebuild chrome EditorPaintOp layer (bands+tabs+nav), store, count.
    // §109e — scroll-only dogfood: replay retained chrome ops (hit-stable).
    let mut chrome_layer_ops: [EditorPaintOp] = []
    const scroll_only_chrome =
      dogfood_probe && dogfood_phase == "scroll" &&
      editor_ux_chrome_layer_batch_can_replay(chrome_layer_batch, 1) != 0
    if scroll_only_chrome then
      chrome_layer_ops = chrome_layer_batch.ops
    else
    chrome_layer_ops = editor_paint_ops_chrome_bands(
      width,
      height,
      header_height(),
      tab_bar_y,
      tab_bar_height(),
      toolbar_y,
      toolbar_height(),
      theme.background_red,
      theme.background_green,
      theme.background_blue,
      theme.panel_red,
      theme.panel_green,
      theme.panel_blue
    )
    let mut hover_tab_index = 0
    while hover_tab_index < tab_widths.length() do
      const tab_ux = tab_strip_title_rect_from_widths(
        tab_strip, tab_widths, hover_tab_index
      )
      const tab_slot = rect_new(tab_ux.x, tab_ux.y, tab_ux.width, tab_ux.height)
      let mut tab_base_red = theme.panel_red
      let mut tab_base_green = theme.panel_green
      let mut tab_base_blue = theme.panel_blue
      if hover_tab_index == app.ux.tabs.active_index then
        tab_base_red = theme.selection_red
        tab_base_green = theme.selection_green
        tab_base_blue = theme.selection_blue
      end
      const tab_fill = editor_ux_chrome_hover_draw_entry(
        input, tab_slot, tab_base_red, tab_base_green, tab_base_blue
      )
      chrome_layer_ops.push(editor_paint_op_rect(
        "tab_slot",
        tab_fill.x,
        tab_fill.y,
        tab_fill.width,
        tab_fill.height,
        tab_fill.red,
        tab_fill.green,
        tab_fill.blue,
        1.0
      ))
      hover_tab_index = hover_tab_index + 1
    end
    chrome_layer_ops.push(editor_paint_op_rect(
      "tree_panel",
      tree_rect.x,
      tree_rect.y,
      tree_rect.width,
      tree_rect.height,
      theme.panel_red,
      theme.panel_green,
      theme.panel_blue,
      1.0
    ))
    const breadcrumb_fill = editor_ux_chrome_hover_draw_entry(
      input, breadcrumb_rect, theme.panel_red, theme.panel_green, theme.panel_blue
    )
    chrome_layer_ops.push(editor_paint_op_rect(
      "breadcrumb",
      breadcrumb_fill.x,
      breadcrumb_fill.y,
      breadcrumb_fill.width,
      breadcrumb_fill.height,
      breadcrumb_fill.red,
      breadcrumb_fill.green,
      breadcrumb_fill.blue,
      1.0
    ))
    if folder_nav_can_back(folder_nav) != 0 then
      const nav_back_fill = editor_ux_chrome_hover_draw_entry(
        input, nav_back_rect, theme.panel_red, theme.panel_green, theme.panel_blue
      )
      chrome_layer_ops.push(editor_paint_op_rect(
        "nav_back",
        nav_back_fill.x,
        nav_back_fill.y,
        nav_back_fill.width,
        nav_back_fill.height,
        nav_back_fill.red,
        nav_back_fill.green,
        nav_back_fill.blue,
        1.0
      ))
    end
    if folder_nav_can_forward(folder_nav) != 0 then
      const nav_forward_fill = editor_ux_chrome_hover_draw_entry(
        input, nav_forward_rect, theme.panel_red, theme.panel_green, theme.panel_blue
      )
      chrome_layer_ops.push(editor_paint_op_rect(
        "nav_forward",
        nav_forward_fill.x,
        nav_forward_fill.y,
        nav_forward_fill.width,
        nav_forward_fill.height,
        nav_forward_fill.red,
        nav_forward_fill.green,
        nav_forward_fill.blue,
        1.0
      ))
    end
    // §109h — toolbar hover fills inside retained chrome layer.
    let mut hover_tool_index = 0
    const hover_toolbar_count = editor_app_toolbar_count()
    while hover_tool_index < hover_toolbar_count do
      const tool_slot = toolbar_button_rect(hover_tool_index, toolbar_y)
      const tool_fill = editor_ux_chrome_hover_draw_entry(
        input, tool_slot, theme.panel_red, theme.panel_green, theme.panel_blue
      )
      chrome_layer_ops.push(editor_paint_op_rect(
        "toolbar_hover",
        tool_fill.x,
        tool_fill.y,
        tool_fill.width,
        tool_fill.height,
        tool_fill.red,
        tool_fill.green,
        tool_fill.blue,
        1.0
      ))
      hover_tool_index = hover_tool_index + 1
    end
    chrome_layer_batch = editor_ux_chrome_layer_batch_store(
      chrome_layer_batch, chrome_layer_ops
    )
    perf_counters = editor_perf_note_chrome_rebuild(perf_counters)
    end
    solid = editor_paint_ops_flatten(solid, width, height, chrome_layer_batch.ops)
    const draw_folder_rows = folder_tree_browser_rows(panels.tree)
    const draw_crumbs = folder_breadcrumb_segments(
      folder_current_path(panels.tree), crumbs_origin_x, 8
    )
    tree_scroll_y = folder_clamp_scroll(
      tree_scroll_y, draw_folder_rows.length(), tree_list_rect.height
    )
    // §109h — visible-range tree hover (+1 row margin); count visits.
    const tree_hover_range = folder_visible_row_range(
      tree_scroll_y, tree_list_rect.height, draw_folder_rows.length(), 1
    )
    let mut hover_row_index = tree_hover_range.first_index
    let mut tree_row_visits = 0
    while hover_row_index < tree_hover_range.end_index do
      tree_row_visits = tree_row_visits + 1
      const row_slot = folder_row_rect(
        tree_list_rect, hover_row_index, tree_scroll_y
      )
      const row_fill = editor_ux_chrome_hover_draw_entry(
        input, row_slot, theme.panel_red, theme.panel_green, theme.panel_blue
      )
      solid = solid_renderer_rect(
        solid, width, height,
        row_fill.x, row_fill.y, row_fill.width, row_fill.height,
        row_fill.red, row_fill.green, row_fill.blue, 1.0
      )
      hover_row_index = hover_row_index + 1
    end
    perf_counters = editor_perf_note_tree_row_visits(perf_counters, tree_row_visits)
    if tree_hovered then
      const thumb = folder_scrollbar_thumb(
        tree_list_rect, draw_folder_rows.length(), tree_scroll_y
      )
      if thumb.width > 0 then
        const folder_thumb_slot = rect_new(thumb.x, thumb.y, thumb.width, thumb.height)
        const folder_thumb_fill = editor_ux_chrome_hover_draw_entry(
          input, folder_thumb_slot, theme.muted_red, theme.muted_green, theme.muted_blue
        )
        let mut folder_scroll_ops: [EditorPaintOp] = []
        folder_scroll_ops.push(editor_paint_op_rect(
          "folder_scrollbar",
          folder_thumb_fill.x,
          folder_thumb_fill.y,
          folder_thumb_fill.width,
          folder_thumb_fill.height,
          folder_thumb_fill.red,
          folder_thumb_fill.green,
          folder_thumb_fill.blue,
          1.0
        ))
        solid = editor_paint_ops_flatten(solid, width, height, folder_scroll_ops)
      end
    end
    let mut text_pane_ops: [EditorPaintOp] = []
    text_pane_ops.push(editor_paint_op_rect(
      "text_pane",
      editor_rect.x,
      editor_rect.y,
      editor_rect.width,
      editor_rect.height,
      theme.background_red,
      theme.background_green,
      theme.background_blue,
      1.0
    ))
    solid = editor_paint_ops_flatten(solid, width, height, text_pane_ops)
    let mut chrome_tail_ops: [EditorPaintOp] = []
    if minimap_enabled != 0 then
      chrome_tail_ops.push(editor_paint_op_rect(
        "minimap",
        minimap_rect.x,
        minimap_rect.y,
        minimap_rect.width,
        minimap_rect.height,
        theme.panel_red,
        theme.panel_green,
        theme.panel_blue,
        1.0
      ))
    end
    let mut gutter_ops: [EditorPaintOp] = []
    gutter_ops.push(editor_paint_op_rect(
      "gutter",
      gutter_rect.x,
      gutter_rect.y,
      gutter_rect.width,
      gutter_rect.height,
      theme.gutter_red,
      theme.gutter_green,
      theme.gutter_blue,
      1.0
    ))
    solid = editor_paint_ops_flatten(solid, width, height, gutter_ops)
    chrome_tail_ops.push(editor_paint_op_rect(
      "divider",
      divider.x,
      divider.y,
      divider.width,
      divider.height,
      theme.accent_red,
      theme.accent_green,
      theme.accent_blue,
      1.0
    ))
    chrome_tail_ops.push(editor_paint_op_rect(
      "status",
      0,
      height - status_height(),
      width,
      status_height(),
      theme.status_red,
      theme.status_green,
      theme.status_blue,
      1.0
    ))
    solid = editor_paint_ops_flatten(solid, width, height, chrome_tail_ops)

    let mut flush_status = solid_renderer_flush(
      solid, width, height, theme.background_red, theme.background_green, theme.background_blue
    )
    if flush_status != 0 then
      solid_renderer_destroy(solid)
      static_text_destroy(text_state)
      glfw_gl_context_end()
      return flush_status
    end

    solid = solid_renderer_begin(solid)
    editor_gl_scissor_enable_rect(height, content_clip)

    // Glyph colors carry Solarized tags; app.ux.selection highlight rects stay below.
    // §109f — visible-range span tick; cover/reuse + rebuild prefetch pad
    // live in syntax_span_cache_tick (caller passes unpadded visible bytes).
    // Baseline/terminal perf smoke: skip O(n) lex on 100k fixtures.
    // PERF_FULL keeps spans live (TRACK_EDITOR_HYGIENE §107d).
    // §107i — pointer-only hover (layout_skip) reuses span_cache; no retick.
    let mut syntax_spans = frame_layout.span_cache.spans
    if layout_skip == 0 && !perf_skip_heavy then
      let mut span_range_start = 0
      let mut span_range_end = 0
      if visual_rows.length() > 0 then
        span_range_start = visual_rows[0].byte_start
        span_range_end = visual_rows[visual_rows.length() - 1].byte_end
      end
      const span_rebuild_before = frame_layout.span_cache.rebuild_count
      frame_layout = frame_layout_tick_spans(
        frame_layout, document.version, draw_text,
        span_range_start, span_range_end
      )
      syntax_spans = frame_layout.span_cache.spans
      if frame_layout.span_cache.rebuild_count != span_rebuild_before then
        let mut lex_bytes = frame_layout.span_cache.range_end -
          frame_layout.span_cache.range_start
        if lex_bytes < 0 then
          lex_bytes = 0
        end
        span_lex_bytes = span_lex_bytes + lex_bytes
      end
    end

    // Current-line band under find/app.ux.selection (Decision: panel tint ~0.55).
    const current_line_metrics = EditorTextMetrics {
      line_height: metrics.line_height,
      char_width: metrics.char_width
    }
    const current_line_report = editor_ux_current_line_draw_report(
      app.ux, current_line_metrics, line_index
    )
    let mut text_content_ops: [EditorPaintOp] = []
    let mut current_line_index = 0
    while current_line_index < current_line_report.highlights.length() do
      const current_line_highlight = current_line_report.highlights[current_line_index]
      if current_line_highlight.width > 0 then
        text_content_ops.push(editor_paint_op_rect(
          "current_line",
          current_line_highlight.x,
          current_line_highlight.y,
          current_line_highlight.width,
          current_line_highlight.height,
          theme.panel_red,
          theme.panel_green,
          theme.panel_blue,
          0.55
        ))
      end
      current_line_index = current_line_index + 1
    end

    // Trailing whitespace runs (Decision: muted app.ux.selection tint).
    const trailing_ws_report = editor_ux_trailing_ws_draw_report(
      app.ux, current_line_metrics, line_index
    )
    let mut trailing_ws_index = 0
    while trailing_ws_index < trailing_ws_report.highlights.length() do
      const trailing_ws_highlight = trailing_ws_report.highlights[trailing_ws_index]
      if trailing_ws_highlight.width > 0 then
        text_content_ops.push(editor_paint_op_rect(
          "trailing_ws",
          trailing_ws_highlight.x,
          trailing_ws_highlight.y,
          trailing_ws_highlight.width,
          trailing_ws_highlight.height,
          theme.selection_red,
          theme.selection_green,
          theme.selection_blue,
          0.35
        ))
      end
      trailing_ws_index = trailing_ws_index + 1
    end

    // text_draw_scroll_x: shared scrolled origin for find/fill/caret/glyphs
    const text_pen_x = text_pen_x_scrolled(text_rect.x + 4, app.ux.scroll_offset_x)

    if find_session.matches.length() > 0 then
      const find_report = find_visible_highlights(
        find_session,
        line_index,
        visible.first_line,
        visible.last_line,
        text_pen_x,
        text_rect.y + 2,
        0,
        metrics.line_height,
        metrics.char_width
      )
      let mut find_index = 0
      while find_index < find_report.highlights.length() do
        const find_highlight = find_report.highlights[find_index]
        if find_highlight.width > 0 then
          if find_highlight.is_active != 0 then
            text_content_ops.push(editor_paint_op_rect(
              "find_active",
              find_highlight.x,
              find_highlight.y,
              find_highlight.width,
              find_highlight.height,
              theme.accent_red,
              theme.accent_green,
              theme.accent_blue,
              0.45
            ))
          else
            text_content_ops.push(editor_paint_op_rect(
              "find_match",
              find_highlight.x,
              find_highlight.y,
              find_highlight.width,
              find_highlight.height,
              theme.muted_red,
              theme.muted_green,
              theme.muted_blue,
              0.35
            ))
          end
        end
        find_index = find_index + 1
      end
    end

    // multi_selection_fill: one visual-row fill pass per multi range
    let mut multi_index = 0
    while multi_index < multi_selection_count(multi) do
      const range_sel = multi.selections[multi_index]
      if !selection_is_empty(range_sel) then
        const range_start = selection_start(range_sel)
        const range_end = selection_end(range_sel)
        const fill_spans = selection_fill_visual_rows(
          draw_text, visual_rows, range_start, range_end,
          font_path, zoom_font_size
        )
        let mut span_index = 0
        while span_index < fill_spans.length() do
          const span = fill_spans[span_index]
          const highlight_width = span.x1 - span.x0
          if highlight_width > 0 then
            text_content_ops.push(editor_paint_op_rect(
              "selection",
              text_pen_x + span.x0,
              text_rect.y + 2 + span.visual_row_index * metrics.line_height,
              highlight_width,
              metrics.line_height,
              theme.selection_red,
              theme.selection_green,
              theme.selection_blue,
              1.0
            ))
          end
          span_index = span_index + 1
        end
      end
      multi_index = multi_index + 1
    end

    // multi_caret_draw: one caret per multi app.ux.selection range
    // idle_multi_caret_overlay: refill last_caret_rects for paint-only blink
    const blink_on = caret_blink_visible(
      clock_ms,
      caret_blink_period_ms()
    )
    if blink_on then
      last_blink_visible = 1
    else
      last_blink_visible = 0
    end
    last_caret_valid = 0
    last_caret_rects = caret_overlay_empty()
    let mut caret_multi_index = 0
    while caret_multi_index < multi_selection_count(multi) do
      const caret_sel = multi.selections[caret_multi_index]
      const caret_byte = selection_caret(caret_sel)
      const caret_position = line_index_offset_to_position(
        line_index,
        draw_text,
        caret_byte
      )
      const caret_visual = visual_row_index_for_caret_pixel_budget_cached(
        draw_text, line_index, wrap_viewport_width_now, font_path, zoom_font_size,
        frame_layout.wrap_count_cache.prefix_visual_rows,
        caret_position.line, caret_position.column
      )
      const caret_row = caret_visual - (app.ux.scroll_offset_y / metrics.line_height)
      if caret_row >= 0 && caret_row < visual_rows.length() then
        const caret_row_info = visual_rows[caret_row]
        const caret_x = text_pen_x + pixel_x_for_byte_offset(
          draw_text, caret_row_info.byte_start, caret_row_info.byte_end,
          caret_byte, font_path, zoom_font_size
        )
        const caret_y = text_rect.y + 2 + caret_row * metrics.line_height
        const caret_w = 1
        const caret_h = metrics.line_height - 2
        last_caret_rects = caret_overlay_add(
          last_caret_rects, caret_x, caret_y, caret_w, caret_h
        )
        if blink_on then
          text_content_ops.push(editor_paint_op_rect(
            "caret",
            caret_x,
            caret_y,
            caret_w,
            caret_h,
            theme.caret_red,
            theme.caret_green,
            theme.caret_blue,
            1.0
          ))
        end
        if caret_multi_index == multi.primary_index then
          last_caret_x = caret_x
          last_caret_y = caret_y
          last_caret_w = caret_w
          last_caret_h = caret_h
          last_caret_valid = 1
        end
      end
      caret_multi_index = caret_multi_index + 1
    end
    solid = editor_paint_ops_flatten(solid, width, height, text_content_ops)

    const editor_hovered =
      point_in_rect(point_new(input.mouse_x, input.mouse_y), editor_rect)
    let mut scrollbar_ops: [EditorPaintOp] = []
    const content_thumb = editor_ux_content_scrollbar_thumb(
      editor_hovered, text_rect, wrapped_content_height_now, app.ux.scroll_offset_y
    )
    if content_thumb.width > 0 then
      const content_thumb_slot = rect_new(
        content_thumb.x, content_thumb.y, content_thumb.width, content_thumb.height
      )
      const content_thumb_fill = editor_ux_chrome_hover_draw_entry(
        input, content_thumb_slot, theme.muted_red, theme.muted_green, theme.muted_blue
      )
      scrollbar_ops.push(editor_paint_op_rect(
        "content_scrollbar",
        content_thumb_fill.x,
        content_thumb_fill.y,
        content_thumb_fill.width,
        content_thumb_fill.height,
        content_thumb_fill.red,
        content_thumb_fill.green,
        content_thumb_fill.blue,
        1.0
      ))
    end
    // horizontal_scrollbar: bottom thumb when content wider than viewport
    let mut horizontal_char_width = metrics.char_width
    if horizontal_char_width <= 0 then
      horizontal_char_width = 1
    end
    const horizontal_content_width =
      frame_layout.max_columns_cache.max_columns * horizontal_char_width
    const content_thumb_x = editor_ux_content_scrollbar_thumb_x(
      editor_hovered, text_rect, horizontal_content_width, app.ux.scroll_offset_x
    )
    if content_thumb_x.width > 0 then
      const content_thumb_x_slot = rect_new(
        content_thumb_x.x, content_thumb_x.y, content_thumb_x.width, content_thumb_x.height
      )
      const content_thumb_x_fill = editor_ux_chrome_hover_draw_entry(
        input, content_thumb_x_slot, theme.muted_red, theme.muted_green, theme.muted_blue
      )
      scrollbar_ops.push(editor_paint_op_rect(
        "content_scrollbar_x",
        content_thumb_x_fill.x,
        content_thumb_x_fill.y,
        content_thumb_x_fill.width,
        content_thumb_x_fill.height,
        content_thumb_x_fill.red,
        content_thumb_x_fill.green,
        content_thumb_x_fill.blue,
        1.0
      ))
    end
    solid = editor_paint_ops_flatten(solid, width, height, scrollbar_ops)
    if minimap_enabled != 0 then
      editor_gl_scissor_enable_rect(height, minimap_rect)
      const minimap_indicator = editor_ux_minimap_viewport_indicator(
        minimap_rect, wrapped_content_height_now, text_rect.height, app.ux.scroll_offset_y
      )
      if minimap_indicator.width > 0 then
        let mut minimap_indicator_ops: [EditorPaintOp] = []
        minimap_indicator_ops.push(editor_paint_op_rect(
          "minimap_indicator",
          minimap_indicator.x,
          minimap_indicator.y,
          minimap_indicator.width,
          minimap_indicator.height,
          theme.muted_red,
          theme.muted_green,
          theme.muted_blue,
          1.0
        ))
        solid = editor_paint_ops_flatten(solid, width, height, minimap_indicator_ops)
      end
    end

    let mut overlay_ops: [EditorPaintOp] = []
    if dirty_close_overlay_is_visible(app.overlay) then
      editor_gl_scissor_disable()
      overlay_ops.push(editor_paint_op_rect(
        "dirty_close_panel", width / 2 - 180, height / 2 - 70, 360, 140,
        theme.panel_red, theme.panel_green, theme.panel_blue, 1.0
      ))
      const discard_rect = dirty_close_overlay_discard_rect(width, height)
      const discard_fill = editor_ux_chrome_hover_draw_entry(
        input, discard_rect, theme.danger_red, theme.danger_green, theme.danger_blue
      )
      const cancel_rect = dirty_close_overlay_cancel_rect(width, height)
      const cancel_fill = editor_ux_chrome_hover_draw_entry(
        input, cancel_rect, theme.accent_red, theme.accent_green, theme.accent_blue
      )
      overlay_ops.push(editor_paint_op_rect(
        "dirty_close_discard",
        discard_fill.x, discard_fill.y, discard_fill.width, discard_fill.height,
        discard_fill.red, discard_fill.green, discard_fill.blue, 1.0
      ))
      overlay_ops.push(editor_paint_op_rect(
        "dirty_close_cancel",
        cancel_fill.x, cancel_fill.y, cancel_fill.width, cancel_fill.height,
        cancel_fill.red, cancel_fill.green, cancel_fill.blue, 1.0
      ))
    end

    if editor_ux_context_menu_is_visible(context_menu) then
      editor_gl_scissor_disable()
      const menu_panel = editor_ux_context_menu_panel_rect(context_menu)
      overlay_ops.push(editor_paint_op_rect(
        "context_menu",
        menu_panel.x, menu_panel.y, menu_panel.width, menu_panel.height,
        theme.panel_red, theme.panel_green, theme.panel_blue, 1.0
      ))
      let mut menu_item_index = 0
      while menu_item_index < editor_ux_context_menu_item_count() do
        const item_rect = editor_ux_context_menu_item_rect(
          context_menu, menu_item_index
        )
        const item_fill = editor_ux_chrome_hover_draw_entry(
          input, item_rect, theme.muted_red, theme.muted_green, theme.muted_blue
        )
        overlay_ops.push(editor_paint_op_rect(
          "context_menu_item",
          item_fill.x, item_fill.y, item_fill.width, item_fill.height,
          item_fill.red, item_fill.green, item_fill.blue, 1.0
        ))
        menu_item_index = menu_item_index + 1
      end
    end
    solid = editor_paint_ops_flatten(solid, width, height, overlay_ops)

    flush_status = solid_renderer_flush_over(solid, width, height)
    editor_gl_scissor_disable()
    if flush_status != 0 then
      static_text_destroy(text_state)
      solid_renderer_destroy(solid)
      glfw_gl_context_end()
      return flush_status
    end

    let mut chrome_lines: [StaticTextLine] = []
    chrome_lines = push_line(
      chrome_lines,
      "mlc-editor MVP  SessSave/Load  cmd=" + app.last_command,
      13, 12, 20
    )

    tab_display_titles = []
    tab_title_index = 0
    while tab_title_index < tab_set_count(app.ux.tabs) do
      const draw_tab = app.ux.tabs.tabs[tab_title_index]
      let mut draw_title = draw_tab.name
      if tab_is_dirty(draw_tab) then
        draw_title = draw_title + "*"
      end
      tab_display_titles.push(draw_title)
      tab_title_index = tab_title_index + 1
    end
    tab_widths = tab_strip_layout_from_titles(
      tab_strip.width, tab_display_titles, metrics.char_width
    )

    let mut tab_index = 0
    while tab_index < tab_set_count(app.ux.tabs) do
      const title = tab_display_titles[tab_index]
      const title_rect = tab_strip_title_rect_from_widths(
        tab_strip, tab_widths, tab_index
      )
      const close_rect = tab_strip_close_rect_from_widths(
        tab_strip, tab_widths, tab_index
      )
      const max_cols = tab_strip_title_area_display_columns(
        title_rect.width, metrics.char_width
      )
      const drawn_title = tab_strip_truncate_title(title, max_cols)
      chrome_lines = push_line(
        chrome_lines, drawn_title, 13, title_rect.x + 8, tab_bar_y + 18
      )
      chrome_lines = push_line(
        chrome_lines, "x", 13, close_rect.x + 5, tab_bar_y + 18
      )
      tab_index = tab_index + 1
    end

    let mut tool_index = 0
    const draw_toolbar_count = editor_app_toolbar_count()
    while tool_index < draw_toolbar_count do
      const button = toolbar_button_rect(tool_index, toolbar_y)
      chrome_lines = push_line(
        chrome_lines,
        editor_app_toolbar_label_at(tool_index),
        11,
        button.x + 4,
        button.y + 16
      )
      tool_index = tool_index + 1
    end

    if editor_ux_context_menu_is_visible(context_menu) then
      const menu_labels = ["Cut", "Copy", "Paste"]
      let mut menu_label_index = 0
      while menu_label_index < menu_labels.length() do
        const label_rect = editor_ux_context_menu_item_rect(
          context_menu, menu_label_index
        )
        chrome_lines = push_line(
          chrome_lines,
          menu_labels[menu_label_index],
          13,
          label_rect.x + 8,
          label_rect.y + 16
        )
        menu_label_index = menu_label_index + 1
      end
    end

    const draw_tree_rows = draw_folder_rows
    chrome_lines = push_line(
      chrome_lines, "<", 12, nav_back_rect.x + 3, tree_rect.y + 12
    )
    chrome_lines = push_line(
      chrome_lines, ">", 12, nav_forward_rect.x + 3, tree_rect.y + 12
    )
    let mut crumb_text = ""
    let mut crumb_index = 0
    while crumb_index < draw_crumbs.length() do
      if crumb_index > 0 then
        crumb_text = crumb_text + "/"
      end
      crumb_text = crumb_text + draw_crumbs[crumb_index].label
      crumb_index = crumb_index + 1
    end
    chrome_lines = push_line(
      chrome_lines, crumb_text, 12, crumbs_origin_x, tree_rect.y + 12
    )

    let mut tree_lines: [StaticTextLine] = []
    const tree_glyph_range = folder_visible_row_range(
      tree_scroll_y, tree_list_rect.height, draw_tree_rows.length(), 1
    )
    let mut row_index = tree_glyph_range.first_index
    let mut tree_glyph_visits = 0
    while row_index < tree_glyph_range.end_index do
      tree_glyph_visits = tree_glyph_visits + 1
      const folder_row = draw_tree_rows[row_index]
      let mut label = folder_row.name
      if folder_row.kind == folder_row_directory() then
        if file_tree_is_expanded(panels.tree, folder_row.node_id) != 0 then
          label = "▾ " + label
        else
          label = "▸ " + label
        end
      end
      if folder_row.kind == folder_row_parent() then
        label = ".."
      end
      const pen_y =
        tree_list_rect.y + 14 + row_index * folder_row_height() - tree_scroll_y
      const pen_x = tree_list_rect.x + 8 + folder_row.depth * 10
      tree_lines = push_line(
        tree_lines, label, 13, pen_x, pen_y
      )
      row_index = row_index + 1
    end
    perf_counters = editor_perf_note_tree_row_visits(perf_counters, tree_glyph_visits)

    const status = status_bar_format(
      status_bar_from_buffer(
        active.buffer, selection_caret(app.ux.selection), line_index
      )
    )
    chrome_lines = push_line(chrome_lines, status, 12, 12, height - 8)

    if dirty_close_overlay_is_visible(app.overlay) then
      chrome_lines = push_line(
        chrome_lines, "Close dirty tab? " + app.overlay.name, 15,
        width / 2 - 140, height / 2 - 30
      )
      chrome_lines = push_line(
        chrome_lines, "Discard", 14, width / 2 - 100, height / 2 + 40
      )
      chrome_lines = push_line(
        chrome_lines, "Cancel", 14, width / 2 + 40, height / 2 + 40
      )
    end

    if !(dogfood_probe && dogfood_phase == "scroll") then
    let mut chrome_drawn = static_text_draw_lines_colored(
      text_state, chrome_lines, width, height, 0,
      theme.text_red, theme.text_green, theme.text_blue, 1.0
    )
    text_state = chrome_drawn.state
    if chrome_drawn.error_code != 0 then
      static_text_destroy(text_state)
      solid_renderer_destroy(solid)
      glfw_gl_context_end()
      return chrome_drawn.error_code
    end

    editor_gl_scissor_enable_rect(height, tree_list_rect)
    const tree_drawn = static_text_draw_lines_colored(
      text_state, tree_lines, width, height, 0,
      theme.text_red, theme.text_green, theme.text_blue, 1.0
    )
    editor_gl_scissor_disable()
    text_state = tree_drawn.state
    if tree_drawn.error_code != 0 then
      static_text_destroy(text_state)
      solid_renderer_destroy(solid)
      glfw_gl_context_end()
      return tree_drawn.error_code
    end
    end

    if minimap_enabled != 0 && !perf_skip_heavy &&
        !(dogfood_probe && dogfood_phase == "scroll") then
      const prev_rebuild = frame_layout.minimap_cache.rebuild_count
      frame_layout = frame_layout_tick_minimap(frame_layout, document.version)
      let mut minimap_lines_dirty = 0
      if frame_layout.minimap_cache.rebuild_count != prev_rebuild ||
          minimap_cached_height != minimap_rect.height ||
          minimap_cached_font_size != zoom_font_size then
        minimap_lines_dirty = 1
        minimap_lines = []
        const minimap_pixel = editor_ux_minimap_pixel_size_for_font(zoom_font_size)
        const minimap_spans = frame_layout.span_cache.spans
        let mut map_line = 0
        let mut map_line_count = line_index_line_count(line_index)
        if map_line_count < 1 then
          map_line_count = 1
        end
        while map_line < line_index_line_count(line_index) do
          const map_byte_start = line_index_line_start(line_index, map_line)
          let mut map_byte_end = line_index.text_length
          if map_line + 1 < line_index_line_count(line_index) then
            map_byte_end = line_index_line_start(line_index, map_line + 1)
          end
          if map_byte_end > map_byte_start &&
              draw_text.byte_at(map_byte_end - 1) == "\n" then
            map_byte_end = map_byte_end - 1
          end
          const pen_y =
            minimap_rect.y + (map_line * minimap_rect.height) / map_line_count + 2
          minimap_lines = editor_ux_append_syntax_colored_row(
            minimap_lines,
            theme,
            draw_text,
            minimap_spans,
            map_byte_start,
            map_byte_end,
            minimap_pixel,
            minimap_rect.x + 1,
            pen_y,
            1
          )
          map_line = map_line + 1
        end
        minimap_cached_height = minimap_rect.height
        minimap_cached_font_size = zoom_font_size
      end
      if minimap_lines_dirty != 0 || minimap_glyph_batch.valid == 0 then
        const minimap_rebuilt = static_text_glyph_batch_rebuild_colored(
          text_state, minimap_glyph_batch, minimap_lines, width, height,
          theme.text_red, theme.text_green, theme.text_blue, 1.0
        )
        text_state = minimap_rebuilt.state
        minimap_glyph_batch = minimap_rebuilt.batch
        perf_counters = editor_perf_note_glyph_shape_calls(
          perf_counters, minimap_rebuilt.shape_calls
        )
        if minimap_rebuilt.error_code != 0 then
          static_text_glyph_batch_destroy(minimap_glyph_batch)
          static_text_destroy(text_state)
          solid_renderer_destroy(solid)
          glfw_gl_context_end()
          return minimap_rebuilt.error_code
        end
      end
      editor_gl_scissor_enable_rect(height, minimap_rect)
      const minimap_drawn = static_text_glyph_batch_draw(
        text_state, minimap_glyph_batch, width, height
      )
      editor_gl_scissor_disable()
      text_state = minimap_drawn.state
      perf_counters = editor_perf_note_glyph_batch_draw_calls(
        perf_counters, minimap_drawn.batch_draw_calls
      )
      if minimap_drawn.error_code != 0 then
        static_text_glyph_batch_destroy(minimap_glyph_batch)
        static_text_destroy(text_state)
        solid_renderer_destroy(solid)
        glfw_gl_context_end()
        return minimap_drawn.error_code
      end
    end

    let mut editor_lines: [StaticTextLine] = []
    if editor_app_terminal_tab_active(app) && app.terminal.active != 0 then
      text_layer_batch = editor_ux_text_layer_batch_invalidate(text_layer_batch)
      const terminal_origin_x = text_rect.x + 4
      const terminal_origin_y = text_rect.y + 2
      const terminal_default_red = f64_to_i32(theme.background_red * 255.0)
      const terminal_default_green = f64_to_i32(theme.background_green * 255.0)
      const terminal_default_blue = f64_to_i32(theme.background_blue * 255.0)
      app = editor_app_set_terminal(
        app,
        terminal_panel_session_grid_cache_tick(
          app.terminal,
          metrics.char_width,
          metrics.line_height,
          terminal_origin_x,
          terminal_origin_y,
          14,
          scaled_font_size,
          terminal_default_red,
          terminal_default_green,
          terminal_default_blue
        )
      )
      solid = terminal_grid_draw_cached_backgrounds(
        solid,
        app.terminal.cached_bg_rects,
        width,
        height
      )
      const terminal_bg_flush = solid_renderer_flush_over(solid, width, height)
      if terminal_bg_flush != 0 then
        solid_renderer_destroy(solid)
        static_text_destroy(text_state)
        glfw_gl_context_end()
        return terminal_bg_flush
      end
      solid = solid_renderer_begin(solid)
      editor_lines = app.terminal.cached_text_lines
    else if editor_ux_text_layer_batch_can_replay(text_layer_batch, layout_skip) != 0 then
      editor_lines = text_layer_batch.lines
    else
      let mut draw_row = 0
      while draw_row < visual_rows.length() do
        const row = visual_rows[draw_row]
        const baseline = gutter_baseline_y(text_rect.y + 2, metrics.line_height, draw_row, 14)
        let mut gutter_label = ""
        if row.is_wrap_continue == 0 then
          gutter_label = gutter_line_label(row.doc_line)
        end
        editor_lines = push_line(
          editor_lines, gutter_label, 13,
          gutter_label_pen_x(gutter_rect, 8), baseline
        )
        editor_lines = editor_ux_append_syntax_colored_row(
          editor_lines,
          theme,
          draw_text,
          syntax_spans,
          row.byte_start,
          row.byte_end,
          scaled_font_size,
          text_pen_x,
          baseline,
          metrics.char_width
        )
        draw_row = draw_row + 1
      end
      text_layer_batch = editor_ux_text_layer_batch_store(text_layer_batch, editor_lines)
      perf_counters = editor_perf_note_text_layer_rebuild(perf_counters)
    end

    editor_gl_scissor_enable_rect(height, content_clip)
    // §109e — retained editor glyph batch (separate from minimap). Invalidate on
    // version/font/theme/width/visible-row identity; draw-only when fingerprint matches.
    let mut editor_glyph_fp = editor_glyph_fingerprint
    if editor_app_terminal_tab_active(app) && app.terminal.active != 0 then
      if content_dirty != 0 || editor_glyph_batch.valid == 0 then
        editor_glyph_fp =
          "term|" + perf_counters.content_frame_count.to_string() + "|" +
          editor_lines.length().to_string()
      end
    else
      let mut row_fp = ""
      let mut row_i = 0
      while row_i < visual_rows.length() do
        const fp_row = visual_rows[row_i]
        row_fp = row_fp + fp_row.doc_line.to_string() + ":" +
          fp_row.is_wrap_continue.to_string() + ":" +
          fp_row.byte_start.to_string() + ":" +
          fp_row.byte_end.to_string() + ";"
        row_i = row_i + 1
      end
      editor_glyph_fp =
        document.version.to_string() + "|" +
        zoom_font_size.to_string() + "|" +
        scaled_font_size.to_string() + "|" +
        text_rect.width.to_string() + "|" +
        app.ux.scroll_offset_y.to_string() + "|" +
        f64_to_i32(theme.text_red * 1000.0).to_string() + "|" +
        f64_to_i32(theme.keyword_red * 1000.0).to_string() + "|" +
        row_fp
    end
    if editor_glyph_fingerprint != editor_glyph_fp || editor_glyph_batch.valid == 0 then
      const editor_rebuilt = static_text_glyph_batch_rebuild_colored(
        text_state, editor_glyph_batch, editor_lines, width, height,
        theme.text_red, theme.text_green, theme.text_blue, 1.0
      )
      text_state = editor_rebuilt.state
      editor_glyph_batch = editor_rebuilt.batch
      editor_glyph_fingerprint = editor_glyph_fp
      perf_counters = editor_perf_note_editor_glyph_shape_calls(
        perf_counters, editor_rebuilt.shape_calls
      )
      if editor_rebuilt.error_code != 0 then
        static_text_glyph_batch_destroy(editor_glyph_batch)
        static_text_glyph_batch_destroy(minimap_glyph_batch)
        static_text_destroy(text_state)
        solid_renderer_destroy(solid)
        glfw_gl_context_end()
        return editor_rebuilt.error_code
      end
    end
    const editor_drawn = static_text_glyph_batch_draw(
      text_state, editor_glyph_batch, width, height
    )
    editor_gl_scissor_disable()
    text_state = editor_drawn.state
    perf_counters = editor_perf_note_glyph_batch_draw_calls(
      perf_counters, editor_drawn.batch_draw_calls
    )
    if editor_drawn.error_code != 0 then
      static_text_glyph_batch_destroy(editor_glyph_batch)
      static_text_glyph_batch_destroy(minimap_glyph_batch)
      static_text_destroy(text_state)
      solid_renderer_destroy(solid)
      glfw_gl_context_end()
      return editor_drawn.error_code
    end

    if perf_enabled then
      const perf_draw_us = editor_perf_now_us() - perf_draw_t0
      const perf_total_us = editor_perf_now_us() - perf_frame_t0
      perf_counters = editor_perf_accumulate_frame(
        perf_counters, perf_layout_us, perf_draw_us, perf_total_us,
        frame_visible_collect_count
      )
      if perf_counters.frames >= perf_frame_limit then
        if terminal_perf_enabled then
          println(editor_perf_format_demo_live_terminal(perf_counters))
        else if perf_full_enabled then
          println(editor_perf_format_demo_live_full(perf_counters))
        else
          println(editor_perf_format_demo_live(perf_counters))
        end
        break
      end
    end

    glfw_gl_context_swap_poll()
    if content_dirty != 0 then
      perf_counters = editor_perf_note_content_frame(perf_counters)
    else
      perf_counters = editor_perf_note_chrome_frame(perf_counters)
    end
    if wake_probe || (dogfood_probe && wake_counters_file.byte_size() > 0) then
      wake_emit_sink = wake_emit_counters(
        wake_counters_file, perf_counters, chrome_hit_id
      )
    end
    app = editor_app_commit_session(
      app, app.history, app.clipboard, app.overlay, app.editor_focused, app.last_command,
      app.mouse_was_down, app.backspace_was_down, app.enter_was_down, app.selecting_text
    )
    app = editor_app_sync_shell(app, width, height, panels, app.ux.tabs, app.ux.selection)
    app = editor_app_bump_frame(app)
  end

  static_text_glyph_batch_destroy(editor_glyph_batch)
  static_text_glyph_batch_destroy(minimap_glyph_batch)
  static_text_destroy(text_state)
  solid_renderer_destroy(solid)
  // §107g — window close must release PTY/vterm (tab-strip/"CmdCloseTab" alone are not enough).
  app = editor_app_close_terminal(app)
  glfw_gl_context_end()
  println("[mlc-editor] live closed")
  0
end
