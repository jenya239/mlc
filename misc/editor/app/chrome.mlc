// TRACK_EDITOR_HYGIENE §107p — single toolbar label+command table.
import { Rect, rect_new } from '../../gui/layout'
import {
  CommandId,
  CmdUndo,
  CmdRedo,
  CmdCopy,
  CmdCut,
  CmdPaste,
  CmdSelectAll,
  CmdCloseTab,
  CmdNextTab,
  CmdPrevTab,
  CmdNone,
  CmdSaveSession,
  CmdLoadSession
} from '../commands/bus'

export type ToolbarEntry = {
  label: string,
  command: CommandId
}

export fn editor_app_line_height() -> i32 = 14
export fn editor_app_font_size() -> i32 = 11
export fn editor_app_header_height() -> i32 = 18
export fn editor_app_tab_bar_height() -> i32 = 18
export fn editor_app_toolbar_height() -> i32 = 18
export fn editor_app_status_height() -> i32 = 16

export fn editor_app_toolbar_button_rect(index: i32, bar_y: i32) -> Rect =
  rect_new(4 + index * 52, bar_y + 1, 50, editor_app_toolbar_height() - 2)

export fn editor_app_toolbar_entries() -> [ToolbarEntry] = do
  let mut entries: [ToolbarEntry] = []
  entries.push(ToolbarEntry { label: "<Prev", command: CmdPrevTab })
  entries.push(ToolbarEntry { label: "Next>", command: CmdNextTab })
  entries.push(ToolbarEntry { label: "Close", command: CmdCloseTab })
  entries.push(ToolbarEntry { label: "Undo", command: CmdUndo })
  entries.push(ToolbarEntry { label: "Redo", command: CmdRedo })
  entries.push(ToolbarEntry { label: "SelAll", command: CmdSelectAll })
  entries.push(ToolbarEntry { label: "Copy", command: CmdCopy })
  entries.push(ToolbarEntry { label: "Cut", command: CmdCut })
  entries.push(ToolbarEntry { label: "Paste", command: CmdPaste })
  entries.push(ToolbarEntry { label: "SessSv", command: CmdSaveSession })
  entries.push(ToolbarEntry { label: "SessLd", command: CmdLoadSession })
  entries
end

export fn editor_app_toolbar_count() -> i32 =
  editor_app_toolbar_entries().length()

export fn editor_app_toolbar_label_at(index: i32) -> string = do
  const entries = editor_app_toolbar_entries()
  if index < 0 || index >= entries.length() then
    return ""
  end
  entries[index].label
end

export fn editor_app_toolbar_command_at(tool: i32) -> CommandId = do
  const entries = editor_app_toolbar_entries()
  if tool < 0 || tool >= entries.length() then
    return CmdNone
  end
  entries[tool].command
end
