// TRACK_EDITOR_RENDER_ARCHITECTURE §97b — wrap + snapshot + spans + minimap owned by one layout object.
// TRACK_EDITOR_HYGIENE §107e — caches keyed by document.version.
import {
  LineIndex,
  line_index_line_count
} from '../document/line_index'
import {
  TextDocument
} from '../document/piece_table'
import {
  DocumentFrameSnapshotCache,
  frame_snapshot_cache_new,
  frame_snapshot_cache_tick,
  frame_snapshot_cache_apply_edit
} from '../document/frame_snapshot_cache'
import {
  DocumentWrapCountCache,
  wrap_count_cache_new_pixel,
  wrap_count_cache_tick_pixel
} from '../layout/wrap_cache'
import {
  SyntaxSpanCacheState,
  editor_ux_syntax_span_cache_new,
  editor_ux_syntax_span_cache_tick
} from '../ux/syntax_span_cache'
import {
  MinimapCacheState,
  editor_ux_minimap_cache_new,
  editor_ux_minimap_cache_tick
} from '../ux/minimap'
import {
  MaxLineColumnsCache,
  max_line_columns_cache_new,
  max_line_columns_cache_tick
} from '../ux/overflow'

export type EditorFrameLayout = {
  wrap_count_cache: DocumentWrapCountCache,
  visual_row_count: i32,
  wrapped_content_height: i32,
  snapshot_cache: DocumentFrameSnapshotCache,
  span_cache: SyntaxSpanCacheState,
  minimap_cache: MinimapCacheState,
  max_columns_cache: MaxLineColumnsCache
}

fn frame_layout_with_wrap(
  layout: EditorFrameLayout,
  cache: DocumentWrapCountCache,
  line_height: i32
) -> EditorFrameLayout = do
  let mut height = cache.visual_row_count * line_height
  if height < 0 then
    height = 0
  end
  EditorFrameLayout {
    wrap_count_cache: cache,
    visual_row_count: cache.visual_row_count,
    wrapped_content_height: height,
    snapshot_cache: layout.snapshot_cache,
    span_cache: layout.span_cache,
    minimap_cache: layout.minimap_cache,
    max_columns_cache: layout.max_columns_cache
  }
end

export fn frame_layout_new_pixel(
  document: TextDocument,
  text: string,
  line_index: LineIndex,
  viewport_width_px: i32,
  font_path: string,
  pixel_size: i32,
  line_height: i32
) -> EditorFrameLayout = do
  const cache = wrap_count_cache_new_pixel(
    document.version, text, line_index, viewport_width_px, font_path, pixel_size
  )
  let mut height = cache.visual_row_count * line_height
  if height < 0 then
    height = 0
  end
  EditorFrameLayout {
    wrap_count_cache: cache,
    visual_row_count: cache.visual_row_count,
    wrapped_content_height: height,
    snapshot_cache: frame_snapshot_cache_new(document),
    span_cache: editor_ux_syntax_span_cache_new(),
    minimap_cache: editor_ux_minimap_cache_new(document.version),
    max_columns_cache: max_line_columns_cache_new(document.version, line_index)
  }
end

// skip_full_pixel_wrap=1: use line_count (perf smoke / avoid O(n) HarfBuzz).
export fn frame_layout_tick_pixel(
  layout: EditorFrameLayout,
  document_version: i32,
  text: string,
  line_index: LineIndex,
  viewport_width_px: i32,
  font_path: string,
  pixel_size: i32,
  line_height: i32,
  skip_full_pixel_wrap: i32
) -> EditorFrameLayout = do
  if skip_full_pixel_wrap != 0 then
    const count = line_index_line_count(line_index)
    let mut height = count * line_height
    if height < 0 then
      height = 0
    end
    return EditorFrameLayout {
      wrap_count_cache: layout.wrap_count_cache,
      visual_row_count: count,
      wrapped_content_height: height,
      snapshot_cache: layout.snapshot_cache,
      span_cache: layout.span_cache,
      minimap_cache: layout.minimap_cache,
      max_columns_cache: layout.max_columns_cache
    }
  end
  frame_layout_with_wrap(
    layout,
    wrap_count_cache_tick_pixel(
      layout.wrap_count_cache, document_version, text, line_index,
      viewport_width_px, font_path, pixel_size
    ),
    line_height
  )
end

export fn frame_layout_tick_snapshot(
  layout: EditorFrameLayout,
  document: TextDocument,
  dirty: i32
) -> EditorFrameLayout =
  EditorFrameLayout {
    wrap_count_cache: layout.wrap_count_cache,
    visual_row_count: layout.visual_row_count,
    wrapped_content_height: layout.wrapped_content_height,
    snapshot_cache: frame_snapshot_cache_tick(
      layout.snapshot_cache, document, dirty
    ),
    span_cache: layout.span_cache,
    minimap_cache: layout.minimap_cache,
    max_columns_cache: layout.max_columns_cache
  }

export fn frame_layout_tick_snapshot_edit(
  layout: EditorFrameLayout,
  byte_start: i32,
  removed_len: i32,
  inserted: string
) -> EditorFrameLayout =
  EditorFrameLayout {
    wrap_count_cache: layout.wrap_count_cache,
    visual_row_count: layout.visual_row_count,
    wrapped_content_height: layout.wrapped_content_height,
    snapshot_cache: frame_snapshot_cache_apply_edit(
      layout.snapshot_cache, byte_start, removed_len, inserted
    ),
    span_cache: layout.span_cache,
    minimap_cache: layout.minimap_cache,
    max_columns_cache: layout.max_columns_cache
  }

export fn frame_layout_tick_spans(
  layout: EditorFrameLayout,
  document_version: i32,
  text: string,
  range_start: i32,
  range_end: i32
) -> EditorFrameLayout =
  EditorFrameLayout {
    wrap_count_cache: layout.wrap_count_cache,
    visual_row_count: layout.visual_row_count,
    wrapped_content_height: layout.wrapped_content_height,
    snapshot_cache: layout.snapshot_cache,
    span_cache: editor_ux_syntax_span_cache_tick(
      layout.span_cache, document_version, text, range_start, range_end
    ),
    minimap_cache: layout.minimap_cache,
    max_columns_cache: layout.max_columns_cache
  }

export fn frame_layout_tick_minimap(
  layout: EditorFrameLayout,
  document_version: i32
) -> EditorFrameLayout =
  EditorFrameLayout {
    wrap_count_cache: layout.wrap_count_cache,
    visual_row_count: layout.visual_row_count,
    wrapped_content_height: layout.wrapped_content_height,
    snapshot_cache: layout.snapshot_cache,
    span_cache: layout.span_cache,
    minimap_cache: editor_ux_minimap_cache_tick(
      layout.minimap_cache, document_version
    ),
    max_columns_cache: layout.max_columns_cache
  }

export fn frame_layout_tick_max_columns(
  layout: EditorFrameLayout,
  document_version: i32,
  line_index: LineIndex
) -> EditorFrameLayout =
  EditorFrameLayout {
    wrap_count_cache: layout.wrap_count_cache,
    visual_row_count: layout.visual_row_count,
    wrapped_content_height: layout.wrapped_content_height,
    snapshot_cache: layout.snapshot_cache,
    span_cache: layout.span_cache,
    minimap_cache: layout.minimap_cache,
    max_columns_cache: max_line_columns_cache_tick(
      layout.max_columns_cache, document_version, line_index
    )
  }
