extern fn audio_render_capacity() -> i32
  = "mlc::audio::audio_render_capacity" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_prepare(length: i32) -> i32
  = "mlc::audio::audio_render_prepare" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_length() -> i32
  = "mlc::audio::audio_render_length" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_occupied(index: i32) -> i32
  = "mlc::audio::audio_render_occupied" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_store(index: i32, sample: i32) -> i32
  = "mlc::audio::audio_render_store" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_load(index: i32) -> i32
  = "mlc::audio::audio_render_load" from "mlc/audio/render_buffer.hpp" blocking

extern fn audio_render_heap_bytes() -> i32
  = "mlc::audio::audio_render_heap_bytes" from "mlc/audio/render_buffer.hpp" blocking

fn fail(message: string) -> i32 = do
  println("[audio render_buffer_probe] FAIL: " + message)
  1
end

fn fill_ramp(length: i32) -> i32 = do
  if audio_render_prepare(length) == 0 then
    return 0
  end
  let mut index = 0
  while index < length do
    if audio_render_store(index, index * 3) == 0 then
      return 0
    end
    index = index + 1
  end
  1
end

fn expect_sample(index: i32, expected: i32) -> i32 = do
  if audio_render_occupied(index) == 0 then
    return fail("missing sample " + index.to_string())
  end
  let actual = audio_render_load(index)
  if actual != expected then
    return fail("sample " + index.to_string() + "=" + actual.to_string())
  end
  0
end

fn main() -> i32 = do
  if audio_render_capacity() != 64 then
    return fail("capacity")
  end
  if audio_render_prepare(0) != 0 then
    return fail("empty prepare accepted")
  end
  if audio_render_prepare(audio_render_capacity() + 1) != 0 then
    return fail("oversize prepare accepted")
  end
  if fill_ramp(8) == 0 then
    return fail("warmup")
  end
  let before = audio_render_heap_bytes()
  if fill_ramp(8) == 0 then
    return fail("fill")
  end
  let after = audio_render_heap_bytes()
  if before < 0 || after != before then
    return fail("heap before=" + before.to_string() + " after=" + after.to_string())
  end
  if audio_render_length() != 8 then
    return fail("length")
  end
  if expect_sample(0, 0) != 0 then
    return 1
  end
  if expect_sample(1, 3) != 0 then
    return 1
  end
  if expect_sample(7, 21) != 0 then
    return 1
  end
  if audio_render_store(8, 1) != 0 then
    return fail("store past length")
  end
  if audio_render_prepare(4) == 0 then
    return fail("short prepare")
  end
  if audio_render_occupied(3) == 0 || audio_render_occupied(4) != 0 then
    return fail("short length")
  end
  if audio_render_load(3) != 0 then
    return fail("short sample was not cleared")
  end
  println("[audio] render_buffer_probe ok")
  0
end
