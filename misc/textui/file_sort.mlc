import {
  ButtonData,
  WidgetId,
  WidgetKind,
  WidgetStore,
  widget_node_with_kind,
  widget_store_keep
} from './store'

export fn file_sort_name() -> string = "name"

export fn file_sort_time() -> string = "time"

export fn file_sort_size() -> string = "size"

export fn file_sort_kind() -> string = "type"

fn caption_name() -> string = "Name"

fn caption_time() -> string = "Time"

fn caption_size() -> string = "Size"

fn caption_kind() -> string = "Type"

fn button_text(kind: WidgetKind) -> string =
  match kind
    | KindButton(data) => data.text
    | KindBox(_) => ""
    | KindLabel(_) => ""
    | KindCheckbox(_) => ""
    | KindScrollView => ""
    | KindListView(_) => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""
    | KindIcon(_) => ""
    | KindTextView => ""

export fn file_sort_caption(order_name: string) -> string = do
  if order_name == file_sort_time() then
    return caption_time()
  end
  if order_name == file_sort_size() then
    return caption_size()
  end
  if order_name == file_sort_kind() then
    return caption_kind()
  end
  return caption_name()
end

export fn file_sort_is(caption: string) -> bool =
  caption == caption_name() || caption == caption_time() || caption == caption_size() || caption == caption_kind()

export fn file_sort_order(caption: string) -> string = do
  if caption == caption_time() then
    return file_sort_time()
  end
  if caption == caption_size() then
    return file_sort_size()
  end
  if caption == caption_kind() then
    return file_sort_kind()
  end
  return file_sort_name()
end

export fn file_sort_next(caption: string) -> string = do
  if caption == caption_name() then
    return caption_time()
  end
  if caption == caption_time() then
    return caption_size()
  end
  if caption == caption_size() then
    return caption_kind()
  end
  return caption_name()
end

fn sort_button(store: WidgetStore) -> WidgetId = do
  let mut index = 0
  while index < store.nodes.length() do
    const text = button_text(store.nodes[index].kind)
    if file_sort_is(text) then
      return store.nodes[index].id
    end
    index = index + 1
  end
  return WidgetId { index: 0 - 1 }
end

fn store_with_button_text(store: WidgetStore, id: WidgetId, text: string) -> WidgetStore = do
  if id.index < 0 || id.index >= store.nodes.length() then
    return store
  end
  const node = store.nodes[id.index]
  const next_kind = match node.kind
    | KindButton(_) => KindButton(ButtonData { text: text })
    | KindBox(data) => KindBox(data)
    | KindLabel(data) => KindLabel(data)
    | KindCheckbox(data) => KindCheckbox(data)
    | KindScrollView => KindScrollView
    | KindListView(data) => KindListView(data)
    | KindSplitter(data) => KindSplitter(data)
    | KindTextField(data) => KindTextField(data)
    | KindIcon(data) => KindIcon(data)
    | KindTextView => KindTextView
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_kind(node, next_kind))
  return widget_store_keep(nodes, store)
end

export fn file_sort_order_of(store: WidgetStore) -> string = do
  const id = sort_button(store)
  if id.index < 0 || id.index >= store.nodes.length() then
    return file_sort_name()
  end
  return file_sort_order(button_text(store.nodes[id.index].kind))
end

export fn file_sort_show(store: WidgetStore, order_name: string) -> WidgetStore =
  store_with_button_text(store, sort_button(store), file_sort_caption(order_name))

export fn file_sort_set(store: WidgetStore, id: WidgetId, caption: string) -> WidgetStore =
  store_with_button_text(store, id, caption)
