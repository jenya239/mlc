import {
  ButtonData,
  WidgetId,
  WidgetKind,
  WidgetStore,
  widget_node_with_kind,
  widget_store_keep
} from './store'

export fn file_sort_name() -> string = "name"

export fn file_sort_time() -> string = "time"

export fn file_sort_size() -> string = "size"

export fn file_sort_kind() -> string = "type"

fn caption_name() -> string = "Name"

fn caption_time() -> string = "Time"

fn caption_size() -> string = "Size"

fn caption_kind() -> string = "Type"

fn button_text(kind: WidgetKind) -> string =
  match kind
    | KindButton(data) => data.text
    | KindBox(_) => ""
    | KindLabel(_) => ""
    | KindCheckbox(_) => ""
    | KindScrollView => ""
    | KindListView(_) => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""
    | KindIcon(_) => ""
    | KindTextView => ""

export fn file_sort_plain(caption: string) -> string = do
  if caption.byte_size() > 0 && caption.byte_at(0) == "*" then
    return caption.byte_substring(1, caption.byte_size() - 1)
  end
  return caption
end

export fn file_sort_marked(caption: string) -> bool =
  caption.byte_size() > 0 && caption.byte_at(0) == "*"

export fn file_sort_is(caption: string) -> bool = do
  const plain = file_sort_plain(caption)
  return plain == caption_name() || plain == caption_time() || plain == caption_size() || plain == caption_kind()
end

export fn file_sort_order(caption: string) -> string = do
  const plain = file_sort_plain(caption)
  if plain == caption_time() then
    return file_sort_time()
  end
  if plain == caption_size() then
    return file_sort_size()
  end
  if plain == caption_kind() then
    return file_sort_kind()
  end
  return file_sort_name()
end

export fn file_sort_next(caption: string) -> string = do
  const plain = file_sort_plain(caption)
  if plain == caption_name() then
    return caption_time()
  end
  if plain == caption_time() then
    return caption_size()
  end
  if plain == caption_size() then
    return caption_kind()
  end
  return caption_name()
end

fn store_with_button_text(store: WidgetStore, id: WidgetId, text: string) -> WidgetStore = do
  if id.index < 0 || id.index >= store.nodes.length() then
    return store
  end
  const node = store.nodes[id.index]
  const next_kind = match node.kind
    | KindButton(_) => KindButton(ButtonData { text: text })
    | KindBox(data) => KindBox(data)
    | KindLabel(data) => KindLabel(data)
    | KindCheckbox(data) => KindCheckbox(data)
    | KindScrollView => KindScrollView
    | KindListView(data) => KindListView(data)
    | KindSplitter(data) => KindSplitter(data)
    | KindTextField(data) => KindTextField(data)
    | KindIcon(data) => KindIcon(data)
    | KindTextView => KindTextView
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_kind(node, next_kind))
  return widget_store_keep(nodes, store)
end

export fn file_sort_order_of(store: WidgetStore) -> string = do
  let mut index = 0
  while index < store.nodes.length() do
    const text = button_text(store.nodes[index].kind)
    if file_sort_marked(text) && file_sort_is(text) then
      return file_sort_order(text)
    end
    index = index + 1
  end
  return file_sort_name()
end

export fn file_sort_show(store: WidgetStore, order_name: string) -> WidgetStore = do
  let mut next = store
  let mut index = 0
  while index < next.nodes.length() do
    const text = button_text(next.nodes[index].kind)
    if file_sort_is(text) then
      const plain = file_sort_plain(text)
      let mut shown = plain
      if file_sort_order(plain) == order_name then
        shown = "*" + plain
      end
      next = store_with_button_text(next, next.nodes[index].id, shown)
    end
    index = index + 1
  end
  return next
end
