import { Theme } from './theme'
import {
  TextShapingState,
  text_shaping_shape,
  text_shaping_glyph_advance_at,
  text_shaping_glyph_cluster_at,
  text_shaping_line_height
} from '../gui/text_shaping'

export type WrapWidth = WrapWidthNone | WrapWidthPixels(i32)

export type TextLine = {
  byte_start: i32,
  byte_end: i32,
  top: i32,
  height: i32,
  width: i32
}

export type TextCluster = {
  byte_offset: i32,
  x: i32,
  width: i32,
  line_index: i32
}

export type TextLayout = {
  text: string,
  font_id: i32,
  pixel_size: i32,
  wrap_width: WrapWidth,
  pixel_width: i32,
  pixel_height: i32,
  lines: [TextLine],
  clusters: [TextCluster]
}

export type TextLayoutCache = {
  by_key: Map<string, TextLayout>,
  rebuilds: i32
}

export fn text_layout_cache_new() -> TextLayoutCache = do
  let mut by_key: Map<string, TextLayout> = Map.new()
  TextLayoutCache { by_key: by_key, rebuilds: 0 }
end

export type TextLayoutBuildResult = {
  shaping: TextShapingState,
  cache: TextLayoutCache,
  layout: TextLayout
}

export fn wrap_width_none() -> WrapWidth =
  WrapWidthNone

export fn text_layout_empty() -> TextLayout = do
  let mut lines: [TextLine] = []
  let mut clusters: [TextCluster] = []
  TextLayout {
    text: "",
    font_id: 0,
    pixel_size: 0,
    wrap_width: WrapWidthNone,
    pixel_width: 0,
    pixel_height: 0,
    lines: lines,
    clusters: clusters
  }
end

fn wrap_width_to_string(wrap_width: WrapWidth) -> string =
  match wrap_width
    | WrapWidthPixels(value) => value.to_string()
    | WrapWidthNone => "none"

fn text_layout_key(font_path: string, pixel_size: i32, wrap_width: WrapWidth, text: string) -> string =
  font_path + "|" + pixel_size.to_string() + "|" + wrap_width_to_string(wrap_width) + "|" + text

type ParagraphGlyphs = {
  clusters: [TextCluster],
  width: i32
}

type ParagraphShape = {
  shaping: TextShapingState,
  clusters: [TextCluster],
  width: i32
}

type HardLineLayout = {
  shaping: TextShapingState,
  layout: TextLayout
}

fn append_paragraph_glyphs(
  clusters: [TextCluster],
  glyph_count: i32,
  paragraph_start: i32,
  line_index: i32
) -> ParagraphGlyphs = do
  let mut next_clusters = clusters
  let mut width = 0
  let mut glyph_index = 0
  while glyph_index < glyph_count do
    const advance = text_shaping_glyph_advance_at(glyph_index) / 64
    next_clusters.push(TextCluster {
      byte_offset: paragraph_start + text_shaping_glyph_cluster_at(glyph_index),
      x: width,
      width: advance,
      line_index: line_index
    })
    width = width + advance
    glyph_index = glyph_index + 1
  end
  ParagraphGlyphs { clusters: next_clusters, width: width }
end

fn shape_paragraph(
  shaping: TextShapingState,
  font_path: string,
  pixel_size: i32,
  text: string,
  paragraph_start: i32,
  paragraph_end: i32,
  line_index: i32,
  clusters: [TextCluster]
) -> ParagraphShape = do
  if paragraph_end <= paragraph_start then
    return ParagraphShape { shaping: shaping, clusters: clusters, width: 0 }
  end
  const paragraph = text.byte_substring(paragraph_start, paragraph_end - paragraph_start)
  const shape_result = text_shaping_shape(shaping, font_path, pixel_size, paragraph)
  const glyphs = append_paragraph_glyphs(
    clusters,
    shape_result.glyph_count,
    paragraph_start,
    line_index
  )
  ParagraphShape {
    shaping: shape_result.state,
    clusters: glyphs.clusters,
    width: glyphs.width
  }
end

fn build_hard_line_layout(
  shaping: TextShapingState,
  font_path: string,
  pixel_size: i32,
  text: string,
  wrap_width: WrapWidth
) -> HardLineLayout = do
  const line_height = text_shaping_line_height(shaping, font_path, pixel_size)
  let mut current = shaping
  let mut lines: [TextLine] = []
  let mut clusters: [TextCluster] = []
  let mut pixel_width = 0
  let mut paragraph_start = 0
  let mut line_index = 0
  let mut byte_index = 0
  let mut finished = false
  const size = text.byte_size()
  while finished == false do
    let mut at_newline = false
    if byte_index < size && text.byte_at(byte_index) == "\n" then
      at_newline = true
    end
    if byte_index == size || at_newline then
      const shaped = shape_paragraph(
        current,
        font_path,
        pixel_size,
        text,
        paragraph_start,
        byte_index,
        line_index,
        clusters
      )
      current = shaped.shaping
      clusters = shaped.clusters
      if shaped.width > pixel_width then
        pixel_width = shaped.width
      end
      lines.push(TextLine {
        byte_start: paragraph_start,
        byte_end: byte_index,
        top: line_index * line_height,
        height: line_height,
        width: shaped.width
      })
      if at_newline then
        paragraph_start = byte_index + 1
        line_index = line_index + 1
      else
        finished = true
      end
    end
    if finished == false then
      byte_index = byte_index + 1
    end
  end
  HardLineLayout {
    shaping: current,
    layout: TextLayout {
      text: text,
      font_id: 0,
      pixel_size: pixel_size,
      wrap_width: wrap_width,
      pixel_width: pixel_width,
      pixel_height: lines.length() * line_height,
      lines: lines,
      clusters: clusters
    }
  }
end

export fn text_layout_build(
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  text: string,
  wrap_width: WrapWidth
) -> TextLayoutBuildResult = do
  const key = text_layout_key(theme.font_path, theme.font_size_pixels, wrap_width, text)
  let mut by_key = cache.by_key
  if by_key.has(key) then
    return TextLayoutBuildResult {
      shaping: shaping,
      cache: cache,
      layout: by_key.get(key)
    }
  end
  const built = build_hard_line_layout(
    shaping,
    theme.font_path,
    theme.font_size_pixels,
    text,
    wrap_width
  )
  by_key.set(key, built.layout)
  TextLayoutBuildResult {
    shaping: built.shaping,
    cache: TextLayoutCache {
      by_key: by_key,
      rebuilds: cache.rebuilds + 1
    },
    layout: built.layout
  }
end
