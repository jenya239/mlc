import { WidgetKind } from './store'

export type UserSelect = UserSelectNone | UserSelectText

export fn kind_user_select(kind: WidgetKind) -> UserSelect =
  match kind
    | KindLabel(_) => UserSelectText
    | KindIcon(_) => UserSelectText
    | KindBox(_) => UserSelectNone
    | KindButton(_) => UserSelectNone
    | KindScrollView => UserSelectNone
    | KindListView(_) => UserSelectNone
    | KindSplitter(_) => UserSelectNone
    | KindTextField(_) => UserSelectText

export fn kind_is_text_selectable(kind: WidgetKind) -> bool =
  match kind_user_select(kind)
    | UserSelectText => true
    | UserSelectNone => false

export fn kind_is_clickable(kind: WidgetKind) -> bool =
  match kind
    | KindButton(_) => true
    | KindLabel(_) => false
    | KindIcon(_) => false
    | KindBox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindTextField(_) => false
