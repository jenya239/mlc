import { get_or } from 'Env'
import { normalize_path, path_inside_jail } from './directory_jail'

extern fn file_byte_size(path: string) -> i32
  = "mlc::file::file_byte_size_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_write_string(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_remove(path: string) -> bool
  = "mlc::file::remove_file_value" from "mlc/io/file_abi.hpp" blocking
extern fn path_is_directory(path: string) -> bool
  = "mlc::file::is_directory_value" from "mlc/io/file_abi.hpp" blocking
extern fn list_dir_names(path: string) -> [string]
  = "mlc::file::list_dir_names_value" from "mlc/io/file_abi.hpp" blocking
extern fn list_dir_flags(path: string) -> [i32]
  = "mlc::file::list_dir_is_directory_value" from "mlc/io/file_abi.hpp" blocking

fn read_byte_limit() -> i32 = 262144

fn search_file_limit() -> i32 = 65536

fn search_file_count() -> i32 = 40

fn list_name_limit() -> i32 = 200

fn directory_walk_limit() -> i32 = 40

fn result_byte_limit() -> i32 = 12000

fn depth_limit() -> i32 = 6

fn ends_with(text: string, suffix: string) -> bool = do
  if text.byte_size() < suffix.byte_size() then
    return false
  end
  text.byte_substring(text.byte_size() - suffix.byte_size(), suffix.byte_size()) == suffix
end

fn starts_with(text: string, prefix: string) -> bool = do
  if text.byte_size() < prefix.byte_size() then
    return false
  end
  text.byte_substring(0, prefix.byte_size()) == prefix
end

fn slash_count(path: string) -> i32 = do
  let mut count = 0
  let mut index = 0
  while index < path.byte_size() do
    if path.byte_at(index) == "/" then
      count = count + 1
    end
    index = index + 1
  end
  count
end

fn last_segment(path: string) -> string = do
  let mut start = 0
  let mut index = 0
  while index < path.byte_size() do
    if path.byte_at(index) == "/" then
      start = index + 1
    end
    index = index + 1
  end
  path.byte_substring(start, path.byte_size() - start)
end

fn contains_directory(path: string, name: string) -> bool = do
  const needle = "/" + name
  if path == needle then
    return true
  end
  if ends_with(path, needle) then
    return true
  end
  path.index_of(needle + "/") >= 0
end

fn secret_name(name: string) -> bool = do
  if name == ".env" || name == ".netrc" || name == ".pgpass" || name == "credentials" then
    return true
  end
  if starts_with(name, ".env.") || starts_with(name, "id_rsa") || starts_with(name, "id_ed25519") || starts_with(name, "id_ecdsa") then
    return true
  end
  ends_with(name, ".pem") || ends_with(name, ".key") || ends_with(name, ".kdbx") || ends_with(name, ".gpg") || ends_with(name, ".p12") || ends_with(name, ".pfx")
end

fn secret_path(path: string) -> bool = do
  if secret_name(last_segment(path)) then
    return true
  end
  if contains_directory(path, ".ssh") || contains_directory(path, ".gnupg") || contains_directory(path, ".aws") || contains_directory(path, ".kube") || contains_directory(path, ".docker") || contains_directory(path, ".password-store") || contains_directory(path, ".mozilla") || contains_directory(path, ".thunderbird") || contains_directory(path, ".pki") || contains_directory(path, "keyrings") then
    return true
  end
  if path.index_of("/.config/google-chrome") >= 0 || path.index_of("/.config/chromium") >= 0 || path.index_of("/.config/BraveSoftware") >= 0 || path.index_of("/.config/microsoft-edge") >= 0 || path.index_of("/.config/vivaldi") >= 0 then
    return true
  end
  path == "/etc/shadow" || path == "/etc/gshadow" || path == "/etc/sudoers" || starts_with(path, "/etc/sudoers") || starts_with(path, "/etc/security")
end

fn system_prefix(path: string) -> bool = do
  if path == "/" || path == "/usr" || path == "/bin" || path == "/sbin" || path == "/lib" || path == "/lib64" || path == "/etc" || path == "/boot" || path == "/proc" || path == "/sys" || path == "/dev" || path == "/run" || path == "/snap" || path == "/opt" || path == "/var" then
    return true
  end
  starts_with(path, "/usr/") || starts_with(path, "/bin/") || starts_with(path, "/sbin/") || starts_with(path, "/lib/") || starts_with(path, "/lib64/") || starts_with(path, "/etc/") || starts_with(path, "/boot/") || starts_with(path, "/proc/") || starts_with(path, "/sys/") || starts_with(path, "/dev/") || starts_with(path, "/run/") || starts_with(path, "/snap/") || starts_with(path, "/opt/") || starts_with(path, "/var/")
end

fn private_tree(path: string) -> bool =
  path == "/proc" || starts_with(path, "/proc/") || path == "/sys" || starts_with(path, "/sys/") || path == "/dev" || starts_with(path, "/dev/") || path == "/run" || starts_with(path, "/run/") || path == "/boot" || starts_with(path, "/boot/")

fn inside_root(root: string, path: string) -> bool = do
  if root == "" then
    return false
  end
  path_inside_jail(root, path)
end

fn expand_home(home: string, requested: string) -> string = do
  if home == "" then
    return requested
  end
  if requested == "~" then
    return home
  end
  if requested.byte_size() > 1 && requested.byte_at(0) == "~" && requested.byte_at(1) == "/" then
    return home + requested.byte_substring(1, requested.byte_size() - 1)
  end
  requested
end

fn resolve_path(home: string, workspace_root: string, requested: string) -> string = do
  const expanded = expand_home(home, requested)
  if expanded.byte_size() == 0 then
    return ""
  end
  if expanded.byte_at(0) == "/" then
    return normalize_path(expanded)
  end
  if workspace_root == "" then
    return ""
  end
  let mut root = workspace_root
  if ends_with(root, "/") && root.byte_size() > 1 then
    root = root.byte_substring(0, root.byte_size() - 1)
  end
  normalize_path(root + "/" + expanded)
end

export fn workspace_resolve(home: string, workspace_root: string, requested: string) -> string =
  resolve_path(home, workspace_root, requested)

fn decision(home: string, workspace_root: string, path: string, writing: bool) -> string = do
  if path == "" then
    return "refused: outside"
  end
  if secret_path(path) then
    return "refused: secret"
  end
  if private_tree(path) || (writing && system_prefix(path)) then
    return "refused: system"
  end
  if inside_root(home, path) || inside_root(workspace_root, path) then
    return ""
  end
  "refused: outside"
end

fn binary_name(name: string) -> bool =
  ends_with(name, ".png") || ends_with(name, ".jpg") || ends_with(name, ".jpeg") || ends_with(name, ".webp") || ends_with(name, ".gif") || ends_with(name, ".mp3") || ends_with(name, ".flac") || ends_with(name, ".ogg") || ends_with(name, ".wav") || ends_with(name, ".m4a") || ends_with(name, ".mp4") || ends_with(name, ".mov") || ends_with(name, ".mkv") || ends_with(name, ".webm") || ends_with(name, ".avi") || ends_with(name, ".so") || ends_with(name, ".o") || ends_with(name, ".a")

fn text_name(name: string) -> bool = do
  if binary_name(name) then
    return false
  end
  name.index_of(".") < 0 || ends_with(name, ".txt") || ends_with(name, ".md") || ends_with(name, ".json") || ends_with(name, ".mlc") || ends_with(name, ".csv") || ends_with(name, ".log") || ends_with(name, ".toml") || ends_with(name, ".yml") || ends_with(name, ".yaml") || ends_with(name, ".xml") || ends_with(name, ".html") || ends_with(name, ".css") || ends_with(name, ".js") || ends_with(name, ".ts") || ends_with(name, ".rs") || ends_with(name, ".py") || ends_with(name, ".rb") || ends_with(name, ".go") || ends_with(name, ".c") || ends_with(name, ".h") || ends_with(name, ".cpp") || ends_with(name, ".hpp")
end

export fn workspace_home() -> string =
  normalize_path(get_or("HOME", ""))

export fn workspace_list(home: string, workspace_root: string, requested: string) -> string = do
  const path = resolve_path(home, workspace_root, requested)
  const refusal = decision(home, workspace_root, path, false)
  if refusal != "" then
    return refusal
  end
  if path_is_directory(path) == false then
    return "refused: missing"
  end
  const names = list_dir_names(path)
  const flags = list_dir_flags(path)
  let mut report = ""
  let mut index = 0
  let mut shown = 0
  while index < names.length() && index < flags.length() && shown < list_name_limit() do
    const child = path + "/" + names[index]
    if secret_path(child) == false then
      let kind = "file "
      if flags[index] != 0 then
        kind = "dir "
      end
      report = report + kind + names[index] + "\n"
      shown = shown + 1
    end
    index = index + 1
  end
  if shown == 0 then
    report = "empty\n"
  end
  if index < names.length() then
    report = report + "truncated\n"
  end
  report
end

export fn workspace_read(home: string, workspace_root: string, requested: string) -> string = do
  const path = resolve_path(home, workspace_root, requested)
  const refusal = decision(home, workspace_root, path, false)
  if refusal != "" then
    return refusal
  end
  if path_is_directory(path) then
    return "refused: directory"
  end
  const size = file_byte_size(path)
  if size < 0 then
    return "refused: missing"
  end
  if binary_name(last_segment(path)) then
    return "refused: binary " + size.to_string()
  end
  if size > read_byte_limit() then
    return "refused: large " + size.to_string()
  end
  file_read_to_string(path)
end

export fn workspace_write(home: string, workspace_root: string, requested: string, content: string) -> string = do
  const path = resolve_path(home, workspace_root, requested)
  const refusal = decision(home, workspace_root, path, true)
  if refusal != "" then
    return refusal
  end
  if content.byte_size() > read_byte_limit() then
    return "refused: large"
  end
  if path_is_directory(path) then
    return "refused: directory"
  end
  if file_write_string(path, content) == false then
    return "refused: missing"
  end
  "wrote " + content.byte_size().to_string()
end

export fn workspace_delete(home: string, workspace_root: string, requested: string) -> string = do
  const path = resolve_path(home, workspace_root, requested)
  const refusal = decision(home, workspace_root, path, true)
  if refusal != "" then
    return refusal
  end
  if path_is_directory(path) then
    return "refused: directory"
  end
  if file_remove(path) == false then
    return "refused: missing"
  end
  "deleted"
end

fn append_match(report: string, path: string) -> string = do
  if report.byte_size() >= result_byte_limit() then
    return report
  end
  report + path + "\n"
end

fn search_file(path: string, name: string, query: string, reads: i32) -> i32 = do
  if name.index_of(query) >= 0 then
    return 1
  end
  if reads >= search_file_count() || text_name(name) == false then
    return 0
  end
  const size = file_byte_size(path)
  if size < 0 || size > search_file_limit() then
    return 0
  end
  if file_read_to_string(path).index_of(query) >= 0 then
    return 3
  end
  2
end

export fn workspace_search(home: string, workspace_root: string, requested: string, query: string) -> string = do
  if query == "" then
    return "refused: query"
  end
  const start = resolve_path(home, workspace_root, requested)
  const refusal = decision(home, workspace_root, start, false)
  if refusal != "" then
    return refusal
  end
  if path_is_directory(start) == false then
    return "refused: missing"
  end
  let mut directories: [string] = []
  directories.push(start)
  let mut cursor = 0
  let mut report = ""
  let mut reads = 0
  const base_depth = slash_count(start)
  while cursor < directories.length() && cursor < directory_walk_limit() && report.byte_size() < result_byte_limit() do
    const directory = directories[cursor]
    const names = list_dir_names(directory)
    const flags = list_dir_flags(directory)
    let mut index = 0
    while index < names.length() && index < flags.length() && report.byte_size() < result_byte_limit() do
      const name = names[index]
      const child = directory + "/" + name
      if secret_path(child) == false && secret_name(name) == false then
        if flags[index] != 0 then
          if slash_count(child) - base_depth <= depth_limit() && directories.length() < directory_walk_limit() then
            directories.push(child)
          end
        else
          const found = search_file(child, name, query, reads)
          if found >= 2 then
            reads = reads + 1
          end
          if found == 1 || found == 3 then
            report = append_match(report, child)
          end
        end
      end
      index = index + 1
    end
    cursor = cursor + 1
  end
  if report == "" then
    return "none\n"
  end
  report
end
