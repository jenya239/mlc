export type WidgetId = {
  index: i32
}

export fn widget_id_none() -> WidgetId =
  WidgetId { index: -1 }

export fn widget_id_is_none(id: WidgetId) -> bool =
  id.index == -1

export fn widget_id_equals(first: WidgetId, second: WidgetId) -> bool =
  first.index == second.index

export type Overflow = OverflowVisible | OverflowHidden

export fn overflow_is_hidden(overflow: Overflow) -> bool =
  match overflow
    | OverflowHidden => true
    | OverflowVisible => false

export type BoxDirection = DirectionRow | DirectionColumn

export type BoxData = {
  direction: BoxDirection,
  padding: i32,
  gap: i32
}

export type LabelData = {
  text: string
}

export type ButtonData = {
  text: string
}

export type CheckboxData = {
  text: string,
  checked: bool
}

export type ListData = {
  texts: [string]
}

export type IconData = {
  name: string
}

export type SplitterData = {
  direction: BoxDirection,
  ratio_thousandths: i32
}

export type FieldMark = {
  text: string,
  caret: i32,
  anchor: i32
}

export type FieldData = {
  text: string,
  undo: [FieldMark],
  redo: [FieldMark]
}

export fn field_data_new(text: string) -> FieldData = do
  let mut undo: [FieldMark] = []
  let mut redo: [FieldMark] = []
  return FieldData { text: text, undo: undo, redo: redo }
end

export type WidgetKind =
  KindBox(BoxData)
  | KindLabel(LabelData)
  | KindButton(ButtonData)
  | KindCheckbox(CheckboxData)
  | KindScrollView
  | KindListView(ListData)
  | KindSplitter(SplitterData)
  | KindTextField(FieldData)
  | KindIcon(IconData)

export fn kind_is_box(kind: WidgetKind) -> bool =
  match kind
    | KindBox(_) => true
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindTextField(_) => false
    | KindIcon(_) => false

export fn kind_is_scroll_view(kind: WidgetKind) -> bool =
  match kind
    | KindScrollView => true
    | KindBox(_) => false
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindTextField(_) => false
    | KindIcon(_) => false

export fn kind_is_list_view(kind: WidgetKind) -> bool =
  match kind
    | KindListView(_) => true
    | KindBox(_) => false
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindSplitter(_) => false
    | KindTextField(_) => false
    | KindIcon(_) => false

export fn kind_is_splitter(kind: WidgetKind) -> bool =
  match kind
    | KindSplitter(_) => true
    | KindBox(_) => false
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindTextField(_) => false
    | KindIcon(_) => false

export fn kind_is_text_field(kind: WidgetKind) -> bool =
  match kind
    | KindTextField(_) => true
    | KindBox(_) => false
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindIcon(_) => false

export type WidgetNode = {
  id: WidgetId,
  parent: WidgetId,
  children: [WidgetId],
  kind: WidgetKind,
  overflow: Overflow,
  grow: i32,
  visible: bool
}

export type WidgetStore = {
  nodes: [WidgetNode],
  root: WidgetId,
  overlay: WidgetId,
  about: WidgetId,
  menu: WidgetId,
  dialog: WidgetId,
  place_x: i32,
  place_y: i32,
  placed: bool
}

export fn widget_store_empty() -> WidgetStore = do
  let mut nodes: [WidgetNode] = []
  return widget_store_make(
    nodes, widget_id_none(), widget_id_none(), widget_id_none(), widget_id_none(), widget_id_none(), 0, 0, false
  )
end

export fn widget_node_with_kind(node: WidgetNode, kind: WidgetKind) -> WidgetNode =
  WidgetNode {
    id: node.id,
    parent: node.parent,
    children: node.children,
    kind: kind,
    overflow: node.overflow,
    grow: node.grow,
    visible: node.visible
  }

fn widget_node_with_children(node: WidgetNode, children: [WidgetId]) -> WidgetNode =
  WidgetNode {
    id: node.id,
    parent: node.parent,
    children: children,
    kind: node.kind,
    overflow: node.overflow,
    grow: node.grow,
    visible: node.visible
  }

export fn widget_store_append(
  store: WidgetStore,
  parent: WidgetId,
  kind: WidgetKind,
  overflow: Overflow,
  grow: i32,
  visible: bool
) -> WidgetStore = do
  const new_id = WidgetId { index: store.nodes.length() }
  const new_node = WidgetNode {
    id: new_id,
    parent: parent,
    children: [],
    kind: kind,
    overflow: overflow,
    grow: grow,
    visible: visible
  }
  let mut next_nodes = store.nodes
  next_nodes.push(new_node)
  if widget_id_is_none(parent) == false then
    const parent_node = next_nodes[parent.index]
    let mut parent_children = parent_node.children
    parent_children.push(new_id)
    next_nodes.set(parent.index, widget_node_with_children(parent_node, parent_children))
  end
  let mut next_root = store.root
  if widget_id_is_none(store.root) then
    next_root = new_id
  end
  return widget_store_make(
    next_nodes, next_root, store.overlay, store.about, store.menu, store.dialog,
    store.place_x, store.place_y, store.placed
  )
end

export fn widget_store_add_box(
  store: WidgetStore,
  parent: WidgetId,
  data: BoxData,
  overflow: Overflow,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindBox(data), overflow, grow, visible)

export fn widget_store_add_label(
  store: WidgetStore,
  parent: WidgetId,
  data: LabelData,
  overflow: Overflow,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindLabel(data), overflow, grow, visible)

export fn widget_store_add_button(
  store: WidgetStore,
  parent: WidgetId,
  data: ButtonData,
  overflow: Overflow,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindButton(data), overflow, grow, visible)

export fn widget_store_add_scroll_view(
  store: WidgetStore,
  parent: WidgetId,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindScrollView, OverflowHidden, grow, visible)

export fn widget_store_add_list_view(
  store: WidgetStore,
  parent: WidgetId,
  data: ListData,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindListView(data), OverflowVisible, grow, visible)

export fn widget_store_add_splitter(
  store: WidgetStore,
  parent: WidgetId,
  data: SplitterData,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindSplitter(data), OverflowHidden, grow, visible)

export fn widget_store_add_text_field(
  store: WidgetStore,
  parent: WidgetId,
  data: FieldData,
  grow: i32,
  visible: bool
) -> WidgetStore =
  widget_store_append(store, parent, KindTextField(data), OverflowHidden, grow, visible)

export fn widget_store_set_list_texts(store: WidgetStore, id: WidgetId, texts: [string]) -> WidgetStore = do
  if id.index < 0 || id.index >= store.nodes.length() then
    return store
  end
  const node = store.nodes[id.index]
  const next_kind = match node.kind
    | KindListView(_) => KindListView(ListData { texts: texts })
    | KindBox(data) => KindBox(data)
    | KindLabel(data) => KindLabel(data)
    | KindButton(data) => KindButton(data)
    | KindCheckbox(data) => KindCheckbox(data)
    | KindScrollView => KindScrollView
    | KindTextField(data) => KindTextField(data)
    | KindSplitter(data) => KindSplitter(data)
    | KindIcon(data) => KindIcon(data)
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_kind(node, next_kind))
  return widget_store_keep(nodes, store)
end

fn widget_node_with_visible(node: WidgetNode, visible: bool) -> WidgetNode =
  WidgetNode {
    id: node.id,
    parent: node.parent,
    children: node.children,
    kind: node.kind,
    overflow: node.overflow,
    grow: node.grow,
    visible: visible
  }

fn widget_store_make(
  nodes: [WidgetNode],
  root: WidgetId,
  overlay: WidgetId,
  about: WidgetId,
  menu: WidgetId,
  dialog: WidgetId,
  place_x: i32,
  place_y: i32,
  placed: bool
) -> WidgetStore =
  WidgetStore {
    nodes: nodes,
    root: root,
    overlay: overlay,
    about: about,
    menu: menu,
    dialog: dialog,
    place_x: place_x,
    place_y: place_y,
    placed: placed
  }

export fn widget_store_keep(nodes: [WidgetNode], store: WidgetStore) -> WidgetStore =
  widget_store_make(
    nodes, store.root, store.overlay, store.about, store.menu, store.dialog,
    store.place_x, store.place_y, store.placed
  )

export fn widget_store_with_overlay(store: WidgetStore, overlay: WidgetId) -> WidgetStore =
  widget_store_make(
    store.nodes, store.root, overlay, store.about, store.menu, store.dialog,
    store.place_x, store.place_y, store.placed
  )

export fn widget_store_with_about(store: WidgetStore, about: WidgetId) -> WidgetStore =
  widget_store_make(
    store.nodes, store.root, store.overlay, about, store.menu, store.dialog,
    store.place_x, store.place_y, store.placed
  )

export fn widget_store_with_menu(store: WidgetStore, menu: WidgetId) -> WidgetStore =
  widget_store_make(
    store.nodes, store.root, store.overlay, store.about, menu, store.dialog,
    store.place_x, store.place_y, store.placed
  )

export fn widget_store_with_dialog(store: WidgetStore, dialog: WidgetId) -> WidgetStore =
  widget_store_make(
    store.nodes, store.root, store.overlay, store.about, store.menu, dialog,
    store.place_x, store.place_y, store.placed
  )

export fn widget_store_with_place(store: WidgetStore, place_x: i32, place_y: i32, placed: bool) -> WidgetStore =
  widget_store_make(
    store.nodes, store.root, store.overlay, store.about, store.menu, store.dialog,
    place_x, place_y, placed
  )

export fn widget_store_set_visible(store: WidgetStore, id: WidgetId, visible: bool) -> WidgetStore = do
  if id.index < 0 || id.index >= store.nodes.length() then
    return store
  end
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_visible(nodes[id.index], visible))
  return widget_store_keep(nodes, store)
end
