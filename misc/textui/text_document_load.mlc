import {
  TerminatorCarriageReturn,
  TerminatorCarriageReturnLineFeed,
  TerminatorLineFeed,
  TerminatorLineSeparator,
  TerminatorNone,
  TerminatorParagraphSeparator,
  LineTerminator,
  TextLine,
  text_line_new,
  text_line_separator_bytes,
  text_paragraph_separator_bytes
} from './text_line'

fn utf8_bounds() -> string = "€¿Âßà áìíŸîïðñóô"

fn utf8_bound(index: i32) -> string = do
  utf8_bounds().byte_at(index)
end

fn continuation_byte(byte: string) -> bool = do
  byte >= utf8_bound(0) && byte <= utf8_bound(1)
end

fn continuations_follow(bytes: string, index: i32, count: i32) -> bool = do
  let mut offset = 0
  while offset < count do
    if index + offset >= bytes.byte_size() then
      return false
    end
    if continuation_byte(bytes.byte_at(index + offset)) == false then
      return false
    end
    offset = offset + 1
  end
  true
end

fn utf8_sequence_width(bytes: string, index: i32) -> i32 = do
  const current = bytes.byte_at(index)
  const size = bytes.byte_size()
  if current >= utf8_bound(2) && current <= utf8_bound(3) then
    if continuations_follow(bytes, index + 1, 1) then
      return 2
    end
    return 0
  end
  if current == utf8_bound(4) then
    if index + 2 < size && bytes.byte_at(index + 1) >= utf8_bound(5) && bytes.byte_at(index + 1) <= utf8_bound(1) && continuation_byte(bytes.byte_at(index + 2)) then
      return 3
    end
    return 0
  end
  if current >= utf8_bound(6) && current <= utf8_bound(7) then
    if continuations_follow(bytes, index + 1, 2) then
      return 3
    end
    return 0
  end
  if current == utf8_bound(8) then
    if index + 2 < size && bytes.byte_at(index + 1) >= utf8_bound(0) && bytes.byte_at(index + 1) <= utf8_bound(9) && continuation_byte(bytes.byte_at(index + 2)) then
      return 3
    end
    return 0
  end
  if current >= utf8_bound(10) && current <= utf8_bound(11) then
    if continuations_follow(bytes, index + 1, 2) then
      return 3
    end
    return 0
  end
  if current == utf8_bound(12) then
    if index + 3 < size && bytes.byte_at(index + 1) >= utf8_bound(13) && bytes.byte_at(index + 1) <= utf8_bound(1) && continuations_follow(bytes, index + 2, 2) then
      return 4
    end
    return 0
  end
  if current >= utf8_bound(14) && current <= utf8_bound(15) then
    if continuations_follow(bytes, index + 1, 3) then
      return 4
    end
    return 0
  end
  if current == utf8_bound(16) then
    if index + 3 < size && bytes.byte_at(index + 1) >= utf8_bound(0) && bytes.byte_at(index + 1) <= utf8_bound(17) && continuations_follow(bytes, index + 2, 2) then
      return 4
    end
    return 0
  end
  0
end

export fn text_bytes_are_utf8(bytes: string) -> bool = do
  let mut index = 0
  const size = bytes.byte_size()
  while index < size do
    const current = bytes.byte_at(index)
    if current < utf8_bound(0) then
      index = index + 1
    else
      const width = utf8_sequence_width(bytes, index)
      if width == 0 then
        return false
      end
      index = index + width
    end
  end
  true
end

type LineBreak = {
  present: bool,
  terminator: LineTerminator,
  width: i32
}

fn line_break_at(bytes: string, index: i32) -> LineBreak = do
  const size = bytes.byte_size()
  if index >= size then
    return LineBreak { present: false, terminator: TerminatorNone, width: 0 }
  end
  const current = bytes.byte_at(index)
  if current == "\r" then
    if index + 1 < size && bytes.byte_at(index + 1) == "\n" then
      return LineBreak { present: true, terminator: TerminatorCarriageReturnLineFeed, width: 2 }
    end
    return LineBreak { present: true, terminator: TerminatorCarriageReturn, width: 1 }
  end
  if current == "\n" then
    return LineBreak { present: true, terminator: TerminatorLineFeed, width: 1 }
  end
  if index + 3 <= size && bytes.byte_substring(index, 3) == text_line_separator_bytes() then
    return LineBreak { present: true, terminator: TerminatorLineSeparator, width: 3 }
  end
  if index + 3 <= size && bytes.byte_substring(index, 3) == text_paragraph_separator_bytes() then
    return LineBreak { present: true, terminator: TerminatorParagraphSeparator, width: 3 }
  end
  LineBreak { present: false, terminator: TerminatorNone, width: 0 }
end

export fn text_lines_from_bytes(bytes: string) -> [TextLine] = do
  let mut lines: [TextLine] = []
  let mut start = 0
  let mut index = 0
  let mut next_identifier = 0
  const size = bytes.byte_size()
  while index < size do
    const found = line_break_at(bytes, index)
    if found.present then
      lines.push(text_line_new(next_identifier, bytes.byte_substring(start, index - start), found.terminator))
      next_identifier = next_identifier + 1
      index = index + found.width
      start = index
    else
      index = index + 1
    end
  end
  if start < size || lines.length() == 0 then
    lines.push(text_line_new(next_identifier, bytes.byte_substring(start, size - start), TerminatorNone))
  end
  lines
end

