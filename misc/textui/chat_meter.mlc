import { ChatConfig } from './chat_http'
import { ChatMessage, ChatModel, ChatRole } from './chat_model'
import { ChatScene } from './chat_scene'
import { field_caption } from './widget_field'
import {
  LabelData,
  WidgetId,
  WidgetKind,
  WidgetStore,
  widget_node_with_kind,
  widget_store_keep
} from './store'
import { UiState, ui_state_with_listing_revision } from './ui_state'

export type ChatChrome = {
  store: WidgetStore,
  state: UiState
}

fn contains_text(text: string, piece: string) -> bool =
  text.index_of(piece) >= 0

export fn chat_provider_name(base_url: string) -> string = do
  if contains_text(base_url, "api.meta.ai") then
    return "Meta"
  end
  if contains_text(base_url, "api.openai.com") then
    return "OpenAI"
  end
  if contains_text(base_url, "api.anthropic.com") then
    return "Anthropic"
  end
  "HTTP"
end

export fn chat_provider_line(config: ChatConfig) -> string = do
  const provider = chat_provider_name(config.base_url)
  if config.model.byte_size() == 0 then
    return provider
  end
  provider + " · " + config.model
end

fn tokens_of(text: string) -> i32 = do
  const bytes = text.byte_size()
  if bytes <= 0 then
    return 0
  end
  let mut count = bytes / 4
  if count < 1 then
    count = 1
  end
  count
end

fn add_message_tokens(input_tokens: i32, output_tokens: i32, message: ChatMessage) -> [i32] = do
  if message.failed then
    return [input_tokens, output_tokens]
  end
  const count = tokens_of(message.text)
  const chosen = match message.role
    | RoleUser => [input_tokens + count, output_tokens]
    | RoleAssistant => [input_tokens, output_tokens + count]
  return chosen
end

fn muse_context(model: string) -> i32 = do
  if contains_text(model, "muse-spark") then
    return 1048576
  end
  0
end

fn input_micro_per_million(model: string) -> i32 = do
  if contains_text(model, "muse-spark") && contains_text(model, "contributor") then
    return 100000
  end
  if contains_text(model, "muse-spark") then
    return 1250000
  end
  0
end

fn output_micro_per_million(model: string) -> i32 = do
  if contains_text(model, "muse-spark") && contains_text(model, "contributor") then
    return 200000
  end
  if contains_text(model, "muse-spark") then
    return 4250000
  end
  0
end

fn scaled_micro(tokens: i32, micro_per_million: i32) -> i32 = do
  if tokens <= 0 || micro_per_million <= 0 then
    return 0
  end
  const per_thousand = micro_per_million / 1000
  const whole = tokens / 1000
  const part = tokens % 1000
  whole * per_thousand + part * per_thousand / 1000
end

fn compact_count(value: i32) -> string = do
  if value >= 1000000 then
    const whole = value / 1000000
    const fraction = (value % 1000000) / 100000
    return whole.to_string() + "." + fraction.to_string() + "M"
  end
  if value >= 1000 then
    const whole = value / 1000
    const fraction = (value % 1000) / 100
    return whole.to_string() + "." + fraction.to_string() + "k"
  end
  value.to_string()
end

fn four_digits(value: i32) -> string = do
  let mut text = value.to_string()
  while text.byte_size() < 4 do
    text = "0" + text
  end
  text
end

fn format_microdollars(micro: i32) -> string = do
  let mut amount = micro
  if amount < 0 then
    amount = 0
  end
  const dollars = amount / 1000000
  const fraction = (amount % 1000000) / 100
  "$" + dollars.to_string() + "." + four_digits(fraction)
end

export fn chat_meter_line(config: ChatConfig, model: ChatModel, draft: string) -> string = do
  let mut input_tokens = tokens_of(config.system_prompt) + tokens_of(draft)
  let mut output_tokens = 0
  let mut index = 0
  while index < model.messages.length() do
    const counted = add_message_tokens(input_tokens, output_tokens, model.messages[index])
    input_tokens = counted[0]
    output_tokens = counted[1]
    index = index + 1
  end
  const used = input_tokens + output_tokens
  let mut line = "токены ≈ " + compact_count(used)
  const context = muse_context(config.model)
  if context > 0 then
    line = line + " · контекст " + compact_count(used) + " / " + compact_count(context)
  end
  const price = scaled_micro(input_tokens, input_micro_per_million(config.model)) + scaled_micro(output_tokens, output_micro_per_million(config.model))
  if input_micro_per_million(config.model) > 0 then
    line = line + " · " + format_microdollars(price)
  end
  line
end

fn label_text(kind: WidgetKind) -> string =
  match kind
    | KindLabel(data) => data.text
    | KindBox(_) => ""
    | KindButton(_) => ""
    | KindCheckbox(_) => ""
    | KindScrollView => ""
    | KindListView(_) => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""
    | KindIcon(_) => ""

fn set_label(store: WidgetStore, id: WidgetId, text: string) -> WidgetStore = do
  if id.index < 0 || id.index >= store.nodes.length() then
    return store
  end
  if label_text(store.nodes[id.index].kind) == text then
    return store
  end
  const node = store.nodes[id.index]
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_kind(node, KindLabel(LabelData { text: text })))
  widget_store_keep(nodes, store)
end

export fn chat_sync_chrome(
  store: WidgetStore,
  state: UiState,
  scene: ChatScene,
  config: ChatConfig,
  model: ChatModel
) -> ChatChrome = do
  const draft = field_caption(store.nodes[scene.composer.index].kind)
  const title = chat_provider_line(config)
  const meter = chat_meter_line(config, model, draft)
  const titled = set_label(store, scene.title, title)
  const metered = set_label(titled, scene.meter, meter)
  if metered.nodes.length() == store.nodes.length() && label_text(metered.nodes[scene.meter.index].kind) == label_text(store.nodes[scene.meter.index].kind) && label_text(metered.nodes[scene.title.index].kind) == label_text(store.nodes[scene.title.index].kind) then
    return ChatChrome { store: store, state: state }
  end
  ChatChrome {
    store: metered,
    state: ui_state_with_listing_revision(state, state.listing_revision + 1)
  }
end
