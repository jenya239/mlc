import { syntax_language_c } from './text_syntax_language'
import { syntax_quote_backtick, syntax_quote_double, syntax_quote_none, syntax_quote_single } from './text_syntax_kind'
import { text_syntax_line } from './text_syntax'

export type TextHighlightMode =
  ModeCode
  | ModeBlock
  | ModeQuoteDouble
  | ModeQuoteSingle
  | ModeQuoteBacktick

export type TextHighlightSpan = {
  start_offset: i32,
  end_offset: i32
}

export type TextHighlightLine = {
  mode_out: TextHighlightMode,
  spans: [TextHighlightSpan]
}

export type TextHighlightRecord = {
  stored: bool,
  mode_out: TextHighlightMode
}

export type TextHighlightCursor = {
  watermark: i32,
  mode: TextHighlightMode,
  records: [TextHighlightRecord],
  scanned: i32,
  language: i32
}

fn mode_code(mode: TextHighlightMode) -> i32 =
  match mode
    | ModeCode => 0
    | ModeBlock => 1
    | ModeQuoteDouble => 2
    | ModeQuoteSingle => 3
    | ModeQuoteBacktick => 4

fn mode_is_block(mode: TextHighlightMode) -> bool =
  mode_code(mode) == 1

fn mode_same(left: TextHighlightMode, right: TextHighlightMode) -> bool =
  mode_code(left) == mode_code(right)

export fn text_highlight_mode_block(mode: TextHighlightMode) -> bool =
  mode_is_block(mode)

export fn text_highlight_mode_quote(mode: TextHighlightMode) -> i32 = do
  const code = mode_code(mode)
  if code == 2 then
    return syntax_quote_double()
  end
  if code == 3 then
    return syntax_quote_single()
  end
  if code == 4 then
    return syntax_quote_backtick()
  end
  syntax_quote_none()
end

fn mode_from_flags(block: bool, quote: i32) -> TextHighlightMode = do
  if quote == syntax_quote_double() then
    return ModeQuoteDouble
  end
  if quote == syntax_quote_single() then
    return ModeQuoteSingle
  end
  if quote == syntax_quote_backtick() then
    return ModeQuoteBacktick
  end
  if block then
    return ModeBlock
  end
  ModeCode
end

fn empty_spans() -> [TextHighlightSpan] = do
  let mut spans: [TextHighlightSpan] = []
  spans
end

fn empty_records() -> [TextHighlightRecord] = do
  let mut records: [TextHighlightRecord] = []
  records
end

fn blank_record() -> TextHighlightRecord = do
  TextHighlightRecord { stored: false, mode_out: ModeCode }
end

fn find_marker(text: string, start: i32, first: string, second: string) -> i32 = do
  let mut index = start
  const limit = text.byte_size() - 1
  while index < limit do
    if text.byte_at(index) == first && text.byte_at(index + 1) == second then
      return index
    end
    index = index + 1
  end
  0 - 1
end

fn earlier_marker(left: i32, right: i32) -> i32 = do
  if left < 0 then
    return right
  end
  if right < 0 then
    return left
  end
  if left <= right then
    return left
  end
  right
end

export fn text_highlight_line(text: string, mode: TextHighlightMode) -> TextHighlightLine = do
  let mut spans = empty_spans()
  let mut index = 0
  let mut block = mode_is_block(mode)
  let mut block_start = 0
  while index < text.byte_size() do
    if block then
      const close = find_marker(text, index, "*", "/")
      if close < 0 then
        spans.push(TextHighlightSpan { start_offset: block_start, end_offset: text.byte_size() })
        return TextHighlightLine { mode_out: ModeBlock, spans: spans }
      end
      spans.push(TextHighlightSpan { start_offset: block_start, end_offset: close + 2 })
      index = close + 2
      block = false
    else
      const line_mark = find_marker(text, index, "/", "/")
      const block_mark = find_marker(text, index, "/", "*")
      const chosen = earlier_marker(line_mark, block_mark)
      if chosen < 0 then
        return TextHighlightLine { mode_out: ModeCode, spans: spans }
      end
      if line_mark >= 0 && chosen == line_mark then
        spans.push(TextHighlightSpan { start_offset: line_mark, end_offset: text.byte_size() })
        return TextHighlightLine { mode_out: ModeCode, spans: spans }
      end
      block = true
      block_start = block_mark
      index = block_mark + 2
    end
  end
  if block then
    spans.push(TextHighlightSpan { start_offset: block_start, end_offset: text.byte_size() })
    return TextHighlightLine { mode_out: ModeBlock, spans: spans }
  end
  TextHighlightLine { mode_out: ModeCode, spans: spans }
end

fn record_at(records: [TextHighlightRecord], index: i32) -> TextHighlightRecord = do
  if index < 0 || index >= records.length() then
    return blank_record()
  end
  records[index]
end

fn store_record(records: [TextHighlightRecord], index: i32, mode: TextHighlightMode) -> [TextHighlightRecord] = do
  let mut copy = records
  while copy.length() < index do
    copy.push(blank_record())
  end
  const record = TextHighlightRecord { stored: true, mode_out: mode }
  if copy.length() == index then
    copy.push(record)
  else
    copy.set(index, record)
  end
  copy
end

export fn text_highlight_mode_before(cursor: TextHighlightCursor, line_index: i32) -> TextHighlightRecord = do
  if line_index <= 0 then
    return TextHighlightRecord { stored: true, mode_out: ModeCode }
  end
  record_at(cursor.records, line_index - 1)
end

export fn text_highlight_invalidate(cursor: TextHighlightCursor, line_index: i32) -> TextHighlightCursor = do
  let mut watermark = line_index
  if watermark < 0 then
    watermark = 0
  end
  if cursor.watermark < watermark then
    watermark = cursor.watermark
  end
  let mut records = empty_records()
  let mut index = 0
  while index < watermark && index < cursor.records.length() do
    records.push(cursor.records[index])
    index = index + 1
  end
  let mut mode = ModeCode
  if watermark > 0 then
    const previous = record_at(records, watermark - 1)
    if previous.stored then
      mode = previous.mode_out
    end
  end
  TextHighlightCursor {
    watermark: watermark,
    mode: mode,
    records: records,
    scanned: cursor.scanned,
    language: cursor.language
  }
end

export fn text_highlight_feed(cursor: TextHighlightCursor, text: string, line_count: i32) -> TextHighlightCursor = do
  if cursor.watermark >= line_count then
    return cursor
  end
  const syntax = text_syntax_line(
    text,
    mode_is_block(cursor.mode),
    text_highlight_mode_quote(cursor.mode),
    cursor.language
  )
  const mode_out = mode_from_flags(syntax.mode_block, syntax.mode_quote)
  const previous = record_at(cursor.records, cursor.watermark)
  const records = store_record(cursor.records, cursor.watermark, mode_out)
  let mut watermark = cursor.watermark + 1
  if previous.stored && mode_same(previous.mode_out, mode_out) then
    watermark = line_count
  end
  TextHighlightCursor {
    watermark: watermark,
    mode: mode_out,
    records: records,
    scanned: cursor.scanned + 1,
    language: cursor.language
  }
end

export fn text_highlight_cursor_with_language(language: i32) -> TextHighlightCursor =
  TextHighlightCursor {
    watermark: 0,
    mode: ModeCode,
    records: empty_records(),
    scanned: 0,
    language: language
  }

export fn text_highlight_cursor_new() -> TextHighlightCursor =
  text_highlight_cursor_with_language(syntax_language_c())

export fn text_highlight_resume(cursor: TextHighlightCursor, line_index: i32) -> TextHighlightCursor = do
  let mut mode = ModeCode
  if line_index > 0 then
    mode = record_at(cursor.records, line_index - 1).mode_out
  end
  TextHighlightCursor {
    watermark: line_index,
    mode: mode,
    records: cursor.records,
    scanned: cursor.scanned,
    language: cursor.language
  }
end

export fn text_highlight_ensure(cursor: TextHighlightCursor, lines: [string], budget: i32) -> TextHighlightCursor = do
  if cursor.watermark >= lines.length() || budget <= 0 then
    return cursor
  end
  let mut index = cursor.watermark
  let mut mode = cursor.mode
  let mut records = cursor.records
  let mut scanned = cursor.scanned
  let mut used = 0
  while index < lines.length() && used < budget do
    const highlighted = text_highlight_line(lines[index], mode)
    const previous = record_at(cursor.records, index)
    records = store_record(records, index, highlighted.mode_out)
    scanned = scanned + 1
    used = used + 1
    if previous.stored && mode_same(previous.mode_out, highlighted.mode_out) then
      return TextHighlightCursor {
        watermark: lines.length(),
        mode: highlighted.mode_out,
        records: records,
        scanned: scanned,
        language: cursor.language
      }
    end
    mode = highlighted.mode_out
    index = index + 1
  end
  TextHighlightCursor {
    watermark: index,
    mode: mode,
    records: records,
    scanned: scanned,
    language: cursor.language
  }
end
