import { join_path, strip_trailing_slash } from './directory_rows'
import { path_inside_jail } from './directory_jail'
import { path_bar_current } from './path_bar'
import { activated_row_text } from './row_label'
import { folder_queue } from './music_queue'
import { playback_bar_is, playback_bar_reading, playback_bar_text, playback_pointer_engaged, playback_reading_of, playback_scrub_commits, playback_seek_milliseconds, playback_shown_position, playback_transport_is } from './playback_bar'
import { playback_output_decide } from './playback_output'
import { LayoutResult } from './layout_result'
import { Theme } from './theme'
import {
  ButtonData,
  WidgetId,
  WidgetKind,
  WidgetStore,
  widget_id_is_none,
  widget_node_with_kind,
  widget_store_keep
} from './store'
import { UiEvent } from './ui_event'
import { UiState, pointer_click_owns, ui_state_with_listing_revision } from './ui_state'

extern fn music_play_list(paths: string, start_index: i32) -> unit
  = "mlc::music_player::play_list_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_next() -> unit
  = "mlc::music_player::next_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_previous() -> unit
  = "mlc::music_player::previous_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_seek(milliseconds: i32) -> unit
  = "mlc::music_player::seek_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_toggle() -> unit
  = "mlc::music_player::toggle_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_release_player() -> unit
  = "mlc::music_player::release_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_active() -> i32
  = "mlc::music_player::active_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_paused() -> i32
  = "mlc::music_player::paused_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_position_milliseconds() -> i32
  = "mlc::music_player::position_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_duration_milliseconds() -> i32
  = "mlc::music_player::duration_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_title() -> string
  = "mlc::music_player::title_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_path() -> string
  = "mlc::music_player::path_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_queue_paths() -> string
  = "mlc::music_player::queue_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_queue_index() -> i32
  = "mlc::music_player::queue_index_value" from "mlc/audio/music_player.hpp" blocking
extern fn music_restore_player(paths: string, start_index: i32, position_milliseconds: i32, paused: i32) -> unit
  = "mlc::music_player::restore_value" from "mlc/audio/music_player.hpp" blocking
extern fn video_transport_borrowed() -> i32
  = "mlc::image_preview::video_transport_borrowed" from "mlc/gl/video_preview.hpp" blocking
extern fn video_transport_request_step(step: i32) -> unit
  = "mlc::image_preview::video_transport_request_step" from "mlc/gl/video_preview.hpp" blocking
extern fn video_transport_request_toggle() -> unit
  = "mlc::image_preview::video_transport_request_toggle" from "mlc/gl/video_preview.hpp" blocking
extern fn video_transport_request_seek(milliseconds: i32) -> unit
  = "mlc::image_preview::video_transport_request_seek" from "mlc/gl/video_preview.hpp" blocking
extern fn video_position_milliseconds() -> i32
  = "mlc::image_preview::video_position_milliseconds" from "mlc/gl/video_preview.hpp" blocking
extern fn video_duration_milliseconds() -> i32
  = "mlc::image_preview::video_duration_milliseconds" from "mlc/gl/video_preview.hpp" blocking
extern fn video_is_paused() -> bool
  = "mlc::image_preview::video_is_paused" from "mlc/gl/video_preview.hpp" blocking
extern fn video_is_full() -> bool
  = "mlc::image_preview::video_is_full" from "mlc/gl/video_preview.hpp" blocking
extern fn video_shown_path() -> string
  = "mlc::image_preview::video_path_value" from "mlc/gl/image_preview.hpp" blocking

export type MusicView = {
  store: WidgetStore,
  state: UiState
}

fn ends_with(text: string, suffix: string) -> bool = do
  if text.byte_size() < suffix.byte_size() then
    return false
  end
  return text.byte_substring(text.byte_size() - suffix.byte_size(), suffix.byte_size()) == suffix
end

fn audio_file_name(name: string) -> bool = do
  if ends_with(name, ".mp3") || ends_with(name, ".MP3") || ends_with(name, ".flac") || ends_with(name, ".FLAC") then
    return true
  end
  if ends_with(name, ".ogg") || ends_with(name, ".OGG") || ends_with(name, ".wav") || ends_with(name, ".WAV") then
    return true
  end
  return ends_with(name, ".m4a") || ends_with(name, ".M4A")
end

fn button_text(kind: WidgetKind) -> string =
  match kind
    | KindButton(data) => data.text
    | KindBox(_) => ""
    | KindLabel(_) => ""
    | KindCheckbox(_) => ""
    | KindScrollView => ""
    | KindListView(_) => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""
    | KindIcon(_) => ""
    | KindTextView => ""

fn renamed_button(kind: WidgetKind, text: string) -> WidgetKind =
  match kind
    | KindButton(_) => KindButton(ButtonData { text: text })
    | KindBox(data) => KindBox(data)
    | KindLabel(data) => KindLabel(data)
    | KindCheckbox(data) => KindCheckbox(data)
    | KindScrollView => KindScrollView
    | KindListView(data) => KindListView(data)
    | KindSplitter(data) => KindSplitter(data)
    | KindTextField(data) => KindTextField(data)
    | KindIcon(data) => KindIcon(data)
    | KindTextView => KindTextView

fn transport_caption(text: string) -> bool =
  playback_transport_is(text)

fn find_transport(store: WidgetStore) -> WidgetId = do
  let mut index = 0
  while index < store.nodes.length() do
    if transport_caption(button_text(store.nodes[index].kind)) then
      return store.nodes[index].id
    end
    index = index + 1
  end
  return widget_id_none()
end

fn set_button_text(store: WidgetStore, id: WidgetId, text: string) -> WidgetStore = do
  if widget_id_is_none(id) then
    return store
  end
  const node = store.nodes[id.index]
  let mut nodes = store.nodes
  nodes.set(id.index, widget_node_with_kind(node, renamed_button(node.kind, text)))
  return widget_store_keep(nodes, store)
end

fn caption_now() -> string = do
  if music_active() != 0 && music_paused() == 0 then
    return "Pause"
  end
  return "Play"
end

fn press_on_widget(state: UiState, widget: WidgetId) -> bool =
  pointer_click_owns(state.pointer, widget)

fn find_progress(store: WidgetStore) -> WidgetId = do
  let mut index = 0
  while index < store.nodes.length() do
    if playback_bar_is(button_text(store.nodes[index].kind)) then
      return store.nodes[index].id
    end
    index = index + 1
  end
  return widget_id_none()
end

fn start_folder(store: WidgetStore, state: UiState, root: string, chosen: string) -> unit = do
  const queue = folder_queue(store, state, root, chosen)
  if queue.paths != "" then
    music_play_list(queue.paths, queue.start)
  end
end

fn file_title(path: string) -> string = do
  let mut start = 0
  let mut index = 0
  while index < path.byte_size() do
    if path.byte_at(index) == "/" then
      start = index + 1
    end
    index = index + 1
  end
  if start >= path.byte_size() then
    return path
  end
  return path.byte_substring(start, path.byte_size() - start)
end

fn audio_path(store: WidgetStore, state: UiState, owner: WidgetId, root: string) -> string = do
  const name = activated_row_text(store, state, owner)
  if audio_file_name(name) == false then
    return ""
  end
  const path = join_path(strip_trailing_slash(path_bar_current(store)), name)
  if path_inside_jail(root, path) == false then
    return ""
  end
  return path
end

export fn music_playing() -> i32 = do
  if music_active() == 0 || music_paused() != 0 then
    return 0
  end
  return 1
end

export fn music_play_path(path: string) -> unit =
  music_play_list(path, 0)

export fn music_release() -> unit =
  music_release_player()

export fn music_follow_video(yielded: bool) -> bool = do
  const decision = playback_output_decide(video_is_full(), music_active() != 0, music_paused() != 0, yielded)
  if decision.pause_music then
    music_toggle()
  end
  if decision.resume_music then
    music_toggle()
  end
  return decision.yielded
end

export fn music_track() -> string =
  music_path()

export fn music_queue_text() -> string =
  music_queue_paths()

export fn music_track_index() -> i32 =
  music_queue_index()

export fn music_position_seconds() -> i32 = do
  let mut seconds = music_position_milliseconds() / 1000
  if seconds < 0 then
    seconds = 0
  end
  return seconds
end

export fn music_is_paused() -> bool =
  music_paused() != 0

export fn music_restore(track: string, queue: string, index: i32, position_seconds: i32, paused: bool) -> unit = do
  let mut paths = queue
  if track != "" && paths == "" then
    paths = track
  end
  if track != "" then
    let mut milliseconds = position_seconds * 1000
    if milliseconds < 0 then
      milliseconds = 0
    end
    let mut paused_flag = 0
    if paused then
      paused_flag = 1
    end
    music_restore_player(paths, index, milliseconds, paused_flag)
  end
end

export fn music_host(
  store: WidgetStore,
  state: UiState,
  layout: LayoutResult,
  theme: Theme,
  events: [UiEvent],
  root: string,
  mouse_x: i32,
  mouse_y: i32,
  left_down: bool
) -> MusicView = do
  const borrowed = video_transport_borrowed() != 0
  const music_free = video_is_full() == false
  let mut next_store = store
  let mut index = 0
  while index < events.length() do
    const event = events[index]
    if event.activated then
      const path = audio_path(next_store, state, event.widget, root)
      if path != "" then
        start_folder(next_store, state, root, path)
      end
    end
    if event.activated == false && widget_id_is_none(event.widget) == false then
      const caption = button_text(next_store.nodes[event.widget.index].kind)
      if caption == "Prev" && borrowed then
        video_transport_request_step(0 - 1)
      end
      if caption == "Prev" && borrowed == false && music_free then
        music_previous()
      end
      if caption == "Next" && borrowed then
        video_transport_request_step(1)
      end
      if caption == "Next" && borrowed == false && music_free then
        music_next()
      end
      if transport_caption(caption) && borrowed then
        video_transport_request_toggle()
      end
      if transport_caption(caption) && borrowed == false && music_free && music_active() != 0 then
        music_toggle()
      end
      if transport_caption(caption) && borrowed == false && music_free && music_active() == 0 then
        start_folder(next_store, state, root, "")
      end
    end
    index = index + 1
  end
  const progress = find_progress(next_store)
  let mut scrubbing = false
  let mut scrub_position = 0
  if playback_pointer_engaged(left_down, press_on_widget(state, progress)) then
    if widget_id_is_none(progress) == false then
      if progress.index < layout.rects.length() then
        let mut duration = music_duration_milliseconds()
        if borrowed then
          duration = video_duration_milliseconds()
        end
        const rect = layout.rects[progress.index]
        const pointer_milliseconds = playback_seek_milliseconds(rect.x, rect.width, mouse_x, duration)
        const shown_before = playback_bar_reading(button_text(next_store.nodes[progress.index].kind)).position_milliseconds
        if playback_scrub_commits(shown_before, pointer_milliseconds, duration) then
          if borrowed then
            video_transport_request_seek(pointer_milliseconds)
          end
          if borrowed == false && music_free then
            music_seek(pointer_milliseconds)
          end
        end
        scrubbing = true
        scrub_position = playback_shown_position(pointer_milliseconds, duration)
      end
    end
  end
  let mut changed = false
  let mut play_caption = caption_now()
  let mut position = playback_shown_position(music_position_milliseconds(), music_duration_milliseconds())
  let mut bar_duration = music_duration_milliseconds()
  let mut title = music_title()
  if borrowed then
    if video_is_paused() then
      play_caption = "Play"
    else
      play_caption = "Pause"
    end
    position = playback_shown_position(video_position_milliseconds(), video_duration_milliseconds())
    bar_duration = video_duration_milliseconds()
    title = file_title(video_shown_path())
  end
  if scrubbing then
    position = scrub_position
  end
  const bar = playback_bar_text(playback_reading_of(title, position, bar_duration))
  const transport = find_transport(next_store)
  if widget_id_is_none(transport) == false && button_text(next_store.nodes[transport.index].kind) != play_caption then
    next_store = set_button_text(next_store, transport, play_caption)
    changed = true
  end
  if widget_id_is_none(progress) == false && button_text(next_store.nodes[progress.index].kind) != bar then
    next_store = set_button_text(next_store, progress, bar)
    changed = true
  end
  if changed then
    return MusicView {
      store: next_store,
      state: ui_state_with_listing_revision(state, state.listing_revision + 1)
    }
  end
  return MusicView { store: next_store, state: state }
end
