import { WidgetStore, WidgetId, widget_id_equals, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { Theme } from './theme'
import { hit_test } from './hit'
import { UiState, PointerClick, ui_state_with } from './ui_state'
import { UiInput } from './ui_input'
import { UiEvent, ui_event_button_clicked } from './ui_event'
import { pointer_past_pixels } from './pointer_slop'
import { path_bar_is_back, path_bar_is_crumb, path_bar_is_forward } from './path_bar'

export fn begin_click_press(state: UiState, owner: WidgetId, input: UiInput) -> UiState =
  ui_state_with(
    state,
    state.selection,
    GrabClick,
    PointerClickSession(PointerClick {
      owner: owner,
      origin_x: input.mouse_x,
      origin_y: input.mouse_y
    }),
    state.last_press,
    state.clipboard,
    owner
  )

export fn click_release_events(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> [UiEvent] = do
  let mut events: [UiEvent] = []
  match state.pointer
    | PointerIdle => events
    | PointerText(_) => events
    | PointerScrollSession(_) => events
    | PointerListSession(_) => events
    | PointerSplitSession(_) => events
    | PointerClickSession(session) => do
      const hit = hit_test(store, layout, theme, input.mouse_x, input.mouse_y)
      const path_button = path_bar_is_back(store, session.owner) || path_bar_is_forward(store, session.owner) || path_bar_is_crumb(store, session.owner)
      let mut same_button = widget_id_is_none(hit) == false && widget_id_equals(hit, session.owner)
      if same_button == false && path_button then
        same_button = pointer_past_pixels(session.origin_x, session.origin_y, input.mouse_x, input.mouse_y, 12) == false
      end
      if same_button == false then
        return events
      end
      events.push(ui_event_button_clicked(session.owner))
      events
    end
  end
end
