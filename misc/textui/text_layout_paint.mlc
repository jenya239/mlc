import { ColorRgba } from './theme'
import { TextLayout } from './text_layout'
import { TextOp } from './draw_op'

fn line_text(layout: TextLayout, byte_start: i32, byte_end: i32) -> string = do
  if byte_end <= byte_start then
    return ""
  end
  let mut text = layout.text.byte_substring(byte_start, byte_end - byte_start)
  if text.byte_size() > 0 && text.byte_at(text.byte_size() - 1) == "\n" then
    text = text.byte_substring(0, text.byte_size() - 1)
  end
  text
end

export fn text_layout_text_ops(
  layout: TextLayout,
  origin_x: i32,
  origin_y: i32,
  color: ColorRgba
) -> [TextOp] = do
  let mut operations: [TextOp] = []
  let mut line_index = 0
  while line_index < layout.lines.length() do
    const line = layout.lines[line_index]
    const text = line_text(layout, line.byte_start, line.byte_end)
    if text.byte_size() > 0 then
      operations.push(TextOp {
        origin_x: origin_x,
        origin_y: origin_y + line.top,
        color: color,
        text: text
      })
    end
    line_index = line_index + 1
  end
  operations
end
