import { get_or } from 'Env'

extern fn file_read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_write_string(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_exists(path: string) -> bool
  = "mlc::file::exists_value" from "mlc/io/file_abi.hpp" blocking

export type WindowPlacement = {
  x: i32,
  y: i32,
  width: i32,
  height: i32,
  restored: bool
}

export type ParsedInteger = {
  value: i32,
  ok: bool
}

fn window_placement_absent() -> WindowPlacement =
  WindowPlacement { x: 0, y: 0, width: 1280, height: 800, restored: false }

fn minimum_window_width() -> i32 = 160
fn minimum_window_height() -> i32 = 120

fn digit_value(character: string) -> i32 = do
  if character == "0" then
    return 0
  else if character == "1" then
    return 1
  else if character == "2" then
    return 2
  else if character == "3" then
    return 3
  else if character == "4" then
    return 4
  else if character == "5" then
    return 5
  else if character == "6" then
    return 6
  else if character == "7" then
    return 7
  else if character == "8" then
    return 8
  else if character == "9" then
    return 9
  end
  return 0 - 1
end

export fn parse_integer(text: string) -> ParsedInteger = do
  if text.byte_size() == 0 then
    return ParsedInteger { value: 0, ok: false }
  end
  let mut sign = 1
  let mut index = 0
  if text.byte_at(0) == "-" then
    sign = 0 - 1
    index = 1
  end
  if index >= text.byte_size() then
    return ParsedInteger { value: 0, ok: false }
  end
  let mut value = 0
  while index < text.byte_size() do
    const digit = digit_value(text.byte_at(index))
    if digit < 0 then
      return ParsedInteger { value: 0, ok: false }
    end
    value = value * 10 + digit
    index = index + 1
  end
  return ParsedInteger { value: value * sign, ok: true }
end

fn starts_with(text: string, prefix: string) -> bool = do
  if text.byte_size() < prefix.byte_size() then
    return false
  end
  return text.byte_substring(0, prefix.byte_size()) == prefix
end

fn suffix_after(text: string, prefix: string) -> string =
  text.byte_substring(prefix.byte_size(), text.byte_size() - prefix.byte_size())

export fn window_placement_encode(placement: WindowPlacement) -> string =
  "x=" + placement.x.to_string() + "\n" +
  "y=" + placement.y.to_string() + "\n" +
  "width=" + placement.width.to_string() + "\n" +
  "height=" + placement.height.to_string() + "\n"

export fn window_placement_decode(text: string) -> WindowPlacement = do
  let mut x = 0
  let mut y = 0
  let mut width = 0
  let mut height = 0
  let mut saw_x = false
  let mut saw_y = false
  let mut saw_width = false
  let mut saw_height = false
  let mut line_start = 0
  let mut index = 0
  const length = text.byte_size()
  while index <= length do
    if index == length || text.byte_at(index) == "\n" then
      const line_length = index - line_start
      if line_length > 0 then
        const line = text.byte_substring(line_start, line_length)
        if starts_with(line, "x=") then
          const parsed = parse_integer(suffix_after(line, "x="))
          if parsed.ok == false then
            return window_placement_absent()
          end
          x = parsed.value
          saw_x = true
        else if starts_with(line, "y=") then
          const parsed = parse_integer(suffix_after(line, "y="))
          if parsed.ok == false then
            return window_placement_absent()
          end
          y = parsed.value
          saw_y = true
        else if starts_with(line, "width=") then
          const parsed = parse_integer(suffix_after(line, "width="))
          if parsed.ok == false then
            return window_placement_absent()
          end
          width = parsed.value
          saw_width = true
        else if starts_with(line, "height=") then
          const parsed = parse_integer(suffix_after(line, "height="))
          if parsed.ok == false then
            return window_placement_absent()
          end
          height = parsed.value
          saw_height = true
        end
      end
      line_start = index + 1
    end
    index = index + 1
  end
  if saw_x == false || saw_y == false || saw_width == false || saw_height == false then
    return window_placement_absent()
  end
  if width < minimum_window_width() || height < minimum_window_height() then
    return window_placement_absent()
  end
  return WindowPlacement {
    x: x,
    y: y,
    width: width,
    height: height,
    restored: true
  }
end

fn config_directory() -> string = do
  const configured = get_or("XDG_CONFIG_HOME", "")
  if configured != "" then
    return configured
  end
  const home = get_or("HOME", "")
  if home == "" then
    return ""
  end
  home + "/.config"
end

export fn window_placement_config_path() -> string = do
  const directory = config_directory()
  if directory == "" then
    return ""
  end
  directory + "/mlc/textui-window"
end

export fn window_placement_load_path(path: string) -> WindowPlacement = do
  if path == "" || file_exists(path) == false then
    return window_placement_absent()
  end
  window_placement_decode(file_read_to_string(path))
end

export fn window_placement_save_path(path: string, placement: WindowPlacement) -> bool = do
  if path == "" then
    return false
  end
  if placement.width < minimum_window_width() || placement.height < minimum_window_height() then
    return false
  end
  file_write_string(path, window_placement_encode(placement))
end

export fn window_placement_load() -> WindowPlacement =
  window_placement_load_path(window_placement_config_path())

export fn window_placement_save(placement: WindowPlacement) -> bool =
  window_placement_save_path(window_placement_config_path(), placement)
