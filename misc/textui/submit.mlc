import { Theme } from './theme'
import { image_preview_draw } from './image_preview'
import { DrawOp, FillRectOp, TextOp } from './draw_op'
import { Rect } from './geometry'
import { TextShapingState, text_shaping_ascender } from '../gui/text_shaping'
import {
  GlyphAtlas,
  GlyphCache,
  TextRenderer,
  glyph_atlas_new,
  glyph_cache_new,
  text_renderer_create,
  text_renderer_destroy,
  text_scratch_u8_clear,
  text_scratch_u8_resize_zero,
  text_scratch_f32_clear
} from '../gui/text_renderer'
import { color_equal, text_op_color } from './submit_color'
import { submit_flush_text } from './submit_flush'
import {
  SolidRenderer,
  solid_renderer_create,
  solid_renderer_begin,
  solid_renderer_rect,
  solid_renderer_flush,
  solid_renderer_flush_over,
  solid_renderer_destroy
} from '../gui/solid_renderer'
import {
  GlyphRun,
  GlyphRunsBuild,
  submit_atlas_size,
  glyph_runs_key,
  push_run_quads,
  ensure_glyph_runs
} from './submit_text'
import { submit_clip_push, submit_clip_pop, submit_scissor_apply } from './submit_clip'
import { submit_stroke_rect } from './submit_stroke'

export type SubmitResources = {
  text_renderer: TextRenderer,
  solid_renderer: SolidRenderer,
  atlas: GlyphAtlas,
  cache: GlyphCache,
  glyph_runs: Map<string, [GlyphRun]>,
  error_code: i32
}

export type SubmitFrameResult = {
  resources: SubmitResources,
  shaping: TextShapingState,
  vertex_count: i32,
  atlas_dirty: i32,
  error_code: i32
}

fn resources_with(
  resources: SubmitResources,
  text_renderer: TextRenderer,
  solid_renderer: SolidRenderer
) -> SubmitResources =
  SubmitResources {
    text_renderer: text_renderer,
    solid_renderer: solid_renderer,
    atlas: resources.atlas,
    cache: resources.cache,
    glyph_runs: resources.glyph_runs,
    error_code: resources.error_code
  }

fn resources_from_build(
  resources: SubmitResources,
  built: GlyphRunsBuild
) -> SubmitResources =
  SubmitResources {
    text_renderer: resources.text_renderer,
    solid_renderer: resources.solid_renderer,
    atlas: built.atlas,
    cache: built.cache,
    glyph_runs: built.glyph_runs,
    error_code: 0
  }

fn submit_fill_rect(
  renderer: SolidRenderer,
  window_width: i32,
  window_height: i32,
  data: FillRectOp
) -> SolidRenderer =
  solid_renderer_rect(
    renderer, window_width, window_height,
    data.rect.x, data.rect.y, data.rect.width, data.rect.height,
    data.color.red, data.color.green, data.color.blue, data.color.alpha
  )

fn submit_solid_fill(
  renderer: SolidRenderer,
  window_width: i32,
  window_height: i32,
  operation: DrawOp
) -> SolidRenderer =
  match operation
    | OpFillRect(data) => submit_fill_rect(renderer, window_width, window_height, data)
    | OpStrokeRect(data) => submit_stroke_rect(renderer, window_width, window_height, data)
    | OpPushClip(_) => renderer
    | OpPopClip => renderer
    | OpText(_) => renderer

fn submit_text_op(
  resources: SubmitResources,
  shaping: TextShapingState,
  theme: Theme,
  window_width: i32,
  window_height: i32,
  data: TextOp
) -> SubmitFrameResult = do
  const built = ensure_glyph_runs(
    resources.atlas,
    resources.cache,
    shaping,
    resources.glyph_runs,
    theme.font_path,
    theme.font_size_pixels,
    data.text
  )
  if built.error_code != 0 then
    return SubmitFrameResult {
      resources: resources,
      shaping: built.shaping,
      vertex_count: 0,
      atlas_dirty: 0,
      error_code: built.error_code
    }
  end
  const key = glyph_runs_key(theme.font_path, theme.font_size_pixels, data.text)
  const runs = built.glyph_runs.get(key)
  const baseline_y = data.origin_y + text_shaping_ascender(
    built.shaping, theme.font_path, theme.font_size_pixels
  )
  const vertices = push_run_quads(
    window_width, window_height, data.origin_x, baseline_y, submit_atlas_size(), runs
  )
  SubmitFrameResult {
    resources: resources_from_build(resources, built),
    shaping: built.shaping,
    vertex_count: vertices,
    atlas_dirty: built.atlas_dirty,
    error_code: 0
  }
end

fn empty_text_step(
  resources: SubmitResources,
  shaping: TextShapingState
) -> SubmitFrameResult =
  SubmitFrameResult {
    resources: resources,
    shaping: shaping,
    vertex_count: 0,
    atlas_dirty: 0,
    error_code: 0
  }

export fn submit_create() -> SubmitResources = do
  const text_renderer = text_renderer_create(submit_atlas_size())
  const solid_renderer = solid_renderer_create()
  let mut glyph_runs: Map<string, [GlyphRun]> = Map.new()
  if text_renderer.program < 0 then
    return SubmitResources {
      text_renderer: text_renderer,
      solid_renderer: solid_renderer,
      atlas: glyph_atlas_new(submit_atlas_size()),
      cache: glyph_cache_new(512),
      glyph_runs: glyph_runs,
      error_code: text_renderer.program
    }
  end
  if solid_renderer.program < 0 then
    return SubmitResources {
      text_renderer: text_renderer,
      solid_renderer: solid_renderer,
      atlas: glyph_atlas_new(submit_atlas_size()),
      cache: glyph_cache_new(512),
      glyph_runs: glyph_runs,
      error_code: solid_renderer.program
    }
  end
  text_scratch_u8_clear()
  text_scratch_u8_resize_zero(submit_atlas_size() * submit_atlas_size())
  SubmitResources {
    text_renderer: text_renderer,
    solid_renderer: solid_renderer,
    atlas: glyph_atlas_new(submit_atlas_size()),
    cache: glyph_cache_new(512),
    glyph_runs: glyph_runs,
    error_code: 0
  }
end

export fn submit_destroy(resources: SubmitResources) -> i32 = do
  text_renderer_destroy(resources.text_renderer)
  solid_renderer_destroy(resources.solid_renderer)
  0
end

fn flush_solid_pass(
  renderer: SolidRenderer,
  window_width: i32,
  window_height: i32,
  theme: Theme,
  already_cleared: bool
) -> i32 = do
  if already_cleared then
    return solid_renderer_flush_over(renderer, window_width, window_height)
  end
  solid_renderer_flush(
    renderer, window_width, window_height,
    theme.background.red, theme.background.green, theme.background.blue
  )
end

export fn submit_frame(
  resources: SubmitResources,
  shaping: TextShapingState,
  theme: Theme,
  operations: [DrawOp],
  window_width: i32,
  window_height: i32,
  clear_framebuffer: bool
) -> SubmitFrameResult = do
  let mut solid_renderer = solid_renderer_begin(resources.solid_renderer)
  let mut current = resources
  let mut current_shaping = shaping
  let mut atlas_dirty = 0
  let mut vertex_count = 0
  let mut operation_index = 0
  let mut clips: [Rect] = []
  let mut already_cleared = clear_framebuffer == false
  while operation_index < operations.length() do
    const clip_change = match operations[operation_index]
      | OpPushClip(_) => true
      | OpPopClip => true
      | OpFillRect(_) => false
      | OpStrokeRect(_) => false
      | OpText(_) => false
    if clip_change then
      const flush_status = flush_solid_pass(
        solid_renderer, window_width, window_height, theme, already_cleared
      )
      if flush_status != 0 then
        return SubmitFrameResult {
          resources: resources_with(current, current.text_renderer, solid_renderer),
          shaping: current_shaping,
          vertex_count: 0,
          atlas_dirty: 0,
          error_code: flush_status
        }
      end
      already_cleared = true
      solid_renderer = solid_renderer_begin(solid_renderer)
      clips = match operations[operation_index]
        | OpPushClip(rect) => submit_clip_push(clips, rect)
        | OpPopClip => submit_clip_pop(clips)
        | OpFillRect(_) => clips
        | OpStrokeRect(_) => clips
        | OpText(_) => clips
      submit_scissor_apply(window_height, clips)
    else
      solid_renderer = submit_solid_fill(
        solid_renderer, window_width, window_height, operations[operation_index]
      )
    end
    operation_index = operation_index + 1
  end
  const last_solid = flush_solid_pass(
    solid_renderer, window_width, window_height, theme, already_cleared
  )
  if last_solid != 0 then
    return SubmitFrameResult {
      resources: resources_with(current, current.text_renderer, solid_renderer),
      shaping: current_shaping,
      vertex_count: 0,
      atlas_dirty: 0,
      error_code: last_solid
    }
  end
  submit_scissor_apply(window_height, [])
  image_preview_draw(window_width, window_height, clear_framebuffer)
  text_scratch_f32_clear()
  clips = []
  operation_index = 0
  let mut active_color = theme.foreground
  while operation_index < operations.length() do
    const clip_change = match operations[operation_index]
      | OpPushClip(_) => true
      | OpPopClip => true
      | OpFillRect(_) => false
      | OpStrokeRect(_) => false
      | OpText(_) => false
    if clip_change then
      const flushed = submit_flush_text(
        current.text_renderer, window_width, window_height,
        active_color, vertex_count, atlas_dirty
      )
      if flushed.error_code != 0 then
        return SubmitFrameResult {
          resources: resources_with(current, current.text_renderer, solid_renderer),
          shaping: current_shaping,
          vertex_count: vertex_count,
          atlas_dirty: flushed.atlas_dirty,
          error_code: flushed.error_code
        }
      end
      atlas_dirty = flushed.atlas_dirty
      text_scratch_f32_clear()
      vertex_count = 0
      clips = match operations[operation_index]
        | OpPushClip(rect) => submit_clip_push(clips, rect)
        | OpPopClip => submit_clip_pop(clips)
        | OpFillRect(_) => clips
        | OpStrokeRect(_) => clips
        | OpText(_) => clips
      submit_scissor_apply(window_height, clips)
    else
      const operation_color = text_op_color(operations[operation_index], active_color)
      if color_equal(operation_color, active_color) then
        active_color = operation_color
      else
        const previous_color = active_color
        if vertex_count > 0 then
          const flushed = submit_flush_text(
            current.text_renderer, window_width, window_height,
            previous_color, vertex_count, atlas_dirty
          )
          if flushed.error_code != 0 then
            return SubmitFrameResult {
              resources: resources_with(current, current.text_renderer, solid_renderer),
              shaping: current_shaping,
              vertex_count: vertex_count,
              atlas_dirty: flushed.atlas_dirty,
              error_code: flushed.error_code
            }
          end
          atlas_dirty = flushed.atlas_dirty
          vertex_count = 0
          text_scratch_f32_clear()
        end
        active_color = operation_color
      end
      const prepared = match operations[operation_index]
        | OpFillRect(_) => empty_text_step(current, current_shaping)
        | OpStrokeRect(_) => empty_text_step(current, current_shaping)
        | OpPushClip(_) => empty_text_step(current, current_shaping)
        | OpPopClip => empty_text_step(current, current_shaping)
        | OpText(data) => submit_text_op(
          current, current_shaping, theme, window_width, window_height, data
        )
      if prepared.error_code != 0 then
        return prepared
      end
      if prepared.atlas_dirty == 1 then
        atlas_dirty = 1
      end
      vertex_count = vertex_count + prepared.vertex_count
      current = prepared.resources
      current_shaping = prepared.shaping
    end
    operation_index = operation_index + 1
  end
  const flushed = submit_flush_text(
    current.text_renderer, window_width, window_height,
    active_color, vertex_count, atlas_dirty
  )
  submit_scissor_apply(window_height, [])
  return SubmitFrameResult {
    resources: resources_with(current, current.text_renderer, solid_renderer),
    shaping: current_shaping,
    vertex_count: vertex_count,
    atlas_dirty: atlas_dirty,
    error_code: flushed.error_code
  }
end
