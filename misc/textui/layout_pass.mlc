import { Rect, rect_new } from './geometry'
import { Theme } from './theme'
import { WidgetStore, widget_id_is_none } from './store'
import { TextShapingState } from '../gui/text_shaping'
import { TextLayout, TextLayoutCache, text_layout_empty } from './text_layout'
import { LayoutResult, layout_result_from_parts } from './layout_result'
import { LayoutWork, measure_node, layout_node } from './layout_box'

export type LayoutColumnResult = {
  shaping: TextShapingState,
  cache: TextLayoutCache,
  layout: LayoutResult
}

fn empty_work(
  store: WidgetStore,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  scroll_offsets: [i32]
) -> LayoutWork = do
  let mut rects: [Rect] = []
  let mut text_layouts: [TextLayout] = []
  let mut index = 0
  while index < store.nodes.length() do
    rects.push(rect_new(0, 0, 0, 0))
    text_layouts.push(text_layout_empty())
    index = index + 1
  end
  LayoutWork {
    shaping: shaping,
    cache: cache,
    rects: rects,
    text_layouts: text_layouts,
    scroll_offsets: scroll_offsets
  }
end

fn finish_work(store: WidgetStore, work: LayoutWork) -> LayoutColumnResult =
  LayoutColumnResult {
    shaping: work.shaping,
    cache: work.cache,
    layout: layout_result_from_parts(store, work.rects, work.text_layouts)
  }

export fn layout_ui(
  store: WidgetStore,
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  viewport_width: i32,
  viewport_height: i32,
  scroll_offsets: [i32]
) -> LayoutColumnResult = do
  let mut work = empty_work(store, shaping, cache, scroll_offsets)
  if widget_id_is_none(store.root) then
    return finish_work(store, work)
  end
  let mut width = viewport_width
  let mut height = viewport_height
  if width <= 0 || height <= 0 then
    const measured = measure_node(work, store, theme, store.root)
    work = measured.work
    if width <= 0 then
      width = measured.size.width
    end
    if height <= 0 then
      height = measured.size.height
    end
  end
  work = layout_node(work, store, theme, store.root, 0, 0, width, height)
  finish_work(store, work)
end

export fn layout_column(
  store: WidgetStore,
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache
) -> LayoutColumnResult = do
  let mut scroll_offsets: [i32] = []
  layout_ui(store, theme, shaping, cache, 0, 0, scroll_offsets)
end
