import { Rect, rect_new } from './geometry'
import { Theme } from './theme'
import {
  WidgetStore,
  WidgetKind,
  widget_id_is_none
} from './store'
import { TextShapingState } from '../gui/text_shaping'
import { TextLayoutCache, text_layout_build, wrap_width_none } from './text_layout'
import { label_preferred_size } from './widget_label'
import { LayoutResult, layout_result_from_rects } from './layout_result'

export type LayoutColumnResult = {
  shaping: TextShapingState,
  cache: TextLayoutCache,
  layout: LayoutResult
}

type ChildLayoutResult = {
  shaping: TextShapingState,
  cache: TextLayoutCache,
  width: i32,
  height: i32
}

fn box_padding_of(kind: WidgetKind) -> i32 =
  match kind
    | KindBox(data) => data.padding
    | KindLabel(_) => 0

fn box_gap_of(kind: WidgetKind) -> i32 =
  match kind
    | KindBox(data) => data.gap
    | KindLabel(_) => 0

fn effective_gap(theme: Theme, box_gap: i32) -> i32 = do
  if box_gap > 0 then
    return box_gap
  end
  theme.gap
end

fn layout_child(
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  parent_padding: i32,
  kind: WidgetKind
) -> ChildLayoutResult =
  match kind
    | KindLabel(data) => do
      const build_result = text_layout_build(shaping, cache, theme, data.text, wrap_width_none())
      const preferred = label_preferred_size(theme, parent_padding, build_result.layout)
      ChildLayoutResult {
        shaping: build_result.shaping,
        cache: build_result.cache,
        width: preferred.width,
        height: preferred.height
      }
    end
    | KindBox(_) => ChildLayoutResult {
      shaping: shaping,
      cache: cache,
      width: 0,
      height: 0
    }

export fn layout_column(
  store: WidgetStore,
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache
) -> LayoutColumnResult = do
  let mut rects: [Rect] = []
  let mut fill_index = 0
  while fill_index < store.nodes.length() do
    rects.push(rect_new(0, 0, 0, 0))
    fill_index = fill_index + 1
  end
  let mut current_shaping = shaping
  let mut current_cache = cache
  if widget_id_is_none(store.root) then
    return LayoutColumnResult {
      shaping: current_shaping,
      cache: current_cache,
      layout: layout_result_from_rects(store, rects)
    }
  end
  const root = store.nodes[store.root.index]
  const root_padding = box_padding_of(root.kind)
  const gap = effective_gap(theme, box_gap_of(root.kind))
  let mut cursor_y = root_padding
  let mut max_child_width = 0
  let mut child_index = 0
  while child_index < root.children.length() do
    const child_id = root.children[child_index]
    const child_node = store.nodes[child_id.index]
    const child_result = layout_child(
      current_shaping,
      current_cache,
      theme,
      root_padding,
      child_node.kind
    )
    current_shaping = child_result.shaping
    current_cache = child_result.cache
    rects.set(child_id.index, rect_new(root_padding, cursor_y, child_result.width, child_result.height))
    if child_result.width > max_child_width then
      max_child_width = child_result.width
    end
    cursor_y = cursor_y + child_result.height + gap
    child_index = child_index + 1
  end
  let mut total_height = root_padding * 2
  if root.children.length() > 0 then
    total_height = cursor_y - gap + root_padding
  end
  rects.set(store.root.index, rect_new(0, 0, max_child_width + root_padding * 2, total_height))
  LayoutColumnResult {
    shaping: current_shaping,
    cache: current_cache,
    layout: layout_result_from_rects(store, rects)
  }
end
