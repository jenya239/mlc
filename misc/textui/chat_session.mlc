import { guest_program_run_with_grant } from '../../script_vm/guest_program'
import { workspace_tool_run } from './chat_files'
import { CommandReady, CommandRefused, command_request } from './command_run'
import {
  command_host_launch,
  command_staged_arguments,
  command_staged_call_identifier,
  command_staged_generation,
  command_staged_name,
  command_staged_text,
  command_take_ready
} from './command_host'
import { ChatConfig, chat_build_file_followup, chat_build_guest_followup, chat_build_request } from './chat_http'
import {
  ChatMessage,
  ChatModel,
  ReplyFailed,
  ReplyFileCall,
  ReplyGuestCall,
  ReplyText,
  RoleAssistant,
  RoleUser,
  chat_apply_reply,
  chat_history_for_request
} from './chat_model'
import {
  TransportDelivery,
  TransportDone,
  TransportIdle,
  transport_poll,
  transport_start
} from './chat_transport'

fn request_character_budget() -> i32 =
  100000

fn guest_round_limit() -> i32 =
  8

fn dispatch_send(config: ChatConfig, model: ChatModel) -> ChatModel = do
  if config.api_key.byte_size() == 0 then
    return chat_apply_reply(
      model,
      model.generation,
      ReplyFailed("MLC_CHAT_API_KEY не задан")
    )
  end
  const history = chat_history_for_request(model, request_character_budget())
  transport_start(model.generation, chat_build_request(config, history))
  model
end

export fn chat_session_dispatch(
  config: ChatConfig,
  model: ChatModel,
  send_requested: bool
) -> ChatModel = do
  if send_requested then
    return dispatch_send(config, model)
  end
  model
end

fn guest_rounds(messages: [ChatMessage]) -> i32 = do
  let mut index = 0
  let mut last_user = 0 - 1
  while index < messages.length() do
    const user = match messages[index].role
      | RoleUser => true
      | RoleAssistant => false
    if user then
      last_user = index
    end
    index = index + 1
  end
  let mut count = 0
  let mut cursor = last_user + 1
  while cursor < messages.length() do
    const text = messages[cursor].text
    if text.index_of("run_guest\n") == 0 || text.index_of("file_") == 0 || text.index_of("run_command\n") == 0 then
      count = count + 1
    end
    cursor = cursor + 1
  end
  count
end

fn guest_visible(result: string) -> string =
  "run_guest\n" + result

fn note_tool_result(model: ChatModel, text: string) -> ChatModel = do
  let mut shown = text
  if shown.byte_size() > 2000 then
    shown = shown.byte_substring(0, 2000) + "\n…"
  end
  let mut messages = model.messages
  messages.push(ChatMessage {
    role: RoleAssistant,
    text: shown,
    failed: false,
    provider: "",
    model_name: ""
  })
  ChatModel {
    messages: messages,
    pending: true,
    generation: model.generation,
    revision: model.revision + 1
  }
end

fn continue_guest(
  config: ChatConfig,
  model: ChatModel,
  generation: i32,
  call_identifier: string,
  source: string,
  grant_text: string
) -> ChatModel = do
  if generation != model.generation then
    return model
  end
  const result = guest_program_run_with_grant(source, grant_text)
  if guest_rounds(model.messages) + 1 >= guest_round_limit() then
    return chat_apply_reply(
      model,
      generation,
      ReplyText(guest_visible(result) + "outcome=guest_round_limit\n")
    )
  end
  const history = chat_history_for_request(model, request_character_budget())
  transport_start(
    generation,
    chat_build_guest_followup(config, history, call_identifier, source, result)
  )
  note_tool_result(model, guest_visible(result))
end

fn deliver_tool_result(
  config: ChatConfig,
  model: ChatModel,
  generation: i32,
  name: string,
  call_identifier: string,
  arguments: string,
  result: string
) -> ChatModel = do
  const visible = name + "\n" + result
  if guest_rounds(model.messages) + 1 >= guest_round_limit() then
    return chat_apply_reply(model, generation, ReplyText(visible + "outcome=guest_round_limit\n"))
  end
  const history = chat_history_for_request(model, request_character_budget())
  transport_start(
    generation,
    chat_build_file_followup(config, history, name, call_identifier, arguments, result)
  )
  note_tool_result(model, visible)
end

fn command_start(
  config: ChatConfig,
  model: ChatModel,
  generation: i32,
  name: string,
  call_identifier: string,
  arguments: string,
  command: string,
  directory: string
) -> ChatModel = do
  const launched = command_host_launch(generation, name, call_identifier, arguments, command, directory)
  if launched == 0 then
    return deliver_tool_result(config, model, generation, name, call_identifier, arguments, "refused: busy")
  end
  model
end

fn continue_command(
  config: ChatConfig,
  model: ChatModel,
  generation: i32,
  name: string,
  call_identifier: string,
  arguments: string,
  workspace_root: string
) -> ChatModel = do
  if generation != model.generation then
    return model
  end
  const request = command_request(workspace_root, arguments)
  match request do
    | CommandRefused(text) => deliver_tool_result(config, model, generation, name, call_identifier, arguments, text)
    | CommandReady(command, directory) => command_start(config, model, generation, name, call_identifier, arguments, command, directory)
  end
end

fn continue_file(
  config: ChatConfig,
  model: ChatModel,
  generation: i32,
  name: string,
  call_identifier: string,
  arguments: string,
  workspace_root: string
) -> ChatModel = do
  if generation != model.generation then
    return model
  end
  if name == "run_command" then
    return continue_command(config, model, generation, name, call_identifier, arguments, workspace_root)
  end
  deliver_tool_result(
    config,
    model,
    generation,
    name,
    call_identifier,
    arguments,
    workspace_tool_run(workspace_root, name, arguments)
  )
end

fn finish_command(config: ChatConfig, model: ChatModel) -> ChatModel = do
  const generation = command_staged_generation()
  if generation != model.generation then
    return model
  end
  deliver_tool_result(
    config,
    model,
    generation,
    command_staged_name(),
    command_staged_call_identifier(),
    command_staged_arguments(),
    command_staged_text()
  )
end

fn settle(
  config: ChatConfig,
  model: ChatModel,
  delivery: TransportDelivery,
  grant_text: string,
  workspace_root: string
) -> ChatModel =
  match delivery.outcome
    | ReplyGuestCall(call_identifier, source) => continue_guest(config, model, delivery.generation, call_identifier, source, grant_text)
    | ReplyFileCall(name, call_identifier, arguments) => continue_file(config, model, delivery.generation, name, call_identifier, arguments, workspace_root)
    | ReplyText(text) => chat_apply_reply(model, delivery.generation, ReplyText(text))
    | ReplyFailed(text) => chat_apply_reply(model, delivery.generation, ReplyFailed(text))

export fn chat_session_poll(
  config: ChatConfig,
  model: ChatModel,
  grant_text: string,
  workspace_root: string
) -> ChatModel = do
  if command_take_ready() != 0 then
    return finish_command(config, model)
  end
  const polled = transport_poll()
  const updated = match polled
    | TransportIdle => model
    | TransportDone(delivery) => settle(config, model, delivery, grant_text, workspace_root)
  updated
end

export fn chat_wait_seconds(model: ChatModel) -> f64 = do
  if model.pending then
    return 0.05
  end
  0.0 - 1.0
end
