import { Rect } from './geometry'
import { ColorRgba } from './theme'

export type FillRectOp = {
  rect: Rect,
  color: ColorRgba
}

export type StrokeRectOp = {
  rect: Rect,
  color: ColorRgba,
  line_width: i32
}

export type TextOp = {
  origin_x: i32,
  origin_y: i32,
  color: ColorRgba,
  text: string
}

export type DrawOp =
  OpFillRect(FillRectOp)
  | OpStrokeRect(StrokeRectOp)
  | OpPushClip(Rect)
  | OpPopClip
  | OpText(TextOp)
