export type UiInput = {
  mouse_x: i32,
  mouse_y: i32,
  left_pressed: bool,
  left_down: bool,
  left_released: bool,
  control_down: bool,
  copy_pressed: bool,
  wheel_y: i32,
  now_ms: i32,
  text: string,
  binding_key: string,
  shift_down: bool,
  backspace_pressed: bool,
  enter_pressed: bool,
  paste_text: string
}

export fn ui_input_idle(now_ms: i32) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: now_ms,
    text: "",
    binding_key: "",
    shift_down: false,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }
