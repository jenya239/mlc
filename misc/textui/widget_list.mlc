import { Rect, rect_new, rect_intersect, rect_is_empty } from './geometry'
import { Theme } from './theme'
import { ColorRgba } from './theme'
import { DrawOp, FillRectOp, StrokeRectOp, TextOp } from './draw_op'
import { LayoutResult } from './layout_result'
import { list_icon_name, paint_named_icon } from './icon'
import { WidgetStore, WidgetId, kind_is_list_view, widget_id_is_none } from './store'
import { UiState } from './ui_state'
import { scroll_content_child } from './widget_scroll'

extern fn image_preview_background() -> i32
  = "mlc::image_preview::background_value" from "mlc/gl/image_preview.hpp" blocking

fn readable_color(color: ColorRgba) -> ColorRgba = do
  if image_preview_background() == 0 then
    return color
  end
  return ColorRgba { red: color.red, green: color.green, blue: color.blue, alpha: 0.78 }
end

fn row_fill_color(color: ColorRgba) -> ColorRgba = do
  if image_preview_background() == 0 then
    return color
  end
  return ColorRgba { red: color.red, green: color.green, blue: color.blue, alpha: 0.45 }
end

export fn list_row_inset(theme: Theme) -> i32 = do
  let mut inset = theme.font_size_pixels / 6
  if inset < 1 then
    inset = 1
  end
  inset
end

export fn list_row_height(theme: Theme) -> i32 = do
  let mut descender = theme.font_size_pixels / 4
  if descender < 1 then
    descender = 1
  end
  const height = theme.font_size_pixels + list_row_inset(theme) * 2 + descender
  if height < 1 then
    return 1
  end
  return height
end

export fn list_content_height(theme: Theme, row_count: i32) -> i32 =
  row_count * list_row_height(theme)

export fn list_selected_at(selected: [i32], index: i32) -> i32 = do
  if index < 0 then
    return 0 - 1
  end
  if index >= selected.length() then
    return 0 - 1
  end
  selected[index]
end

export fn list_selected_put(selected: [i32], index: i32, value: i32) -> [i32] = do
  let mut next = selected
  while next.length() <= index do
    next.push(0 - 1)
  end
  next.set(index, value)
  return next
end

export fn list_index_at(rect: Rect, theme: Theme, row_count: i32, y: i32) -> i32 = do
  if row_count <= 0 then
    return 0 - 1
  end
  if y < rect.y || y >= rect.y + rect.height then
    return 0 - 1
  end
  const index = (y - rect.y) / list_row_height(theme)
  if index < 0 || index >= row_count then
    return 0 - 1
  end
  return index
end

export fn list_index_clamped(rect: Rect, theme: Theme, row_count: i32, y: i32) -> i32 = do
  if row_count <= 0 then
    return 0 - 1
  end
  let mut index = (y - rect.y) / list_row_height(theme)
  if index < 0 then
    index = 0
  end
  if index >= row_count then
    index = row_count - 1
  end
  return index
end

fn list_first_row(rect: Rect, clip: Rect, row_height: i32, row_count: i32) -> i32 = do
  if row_count <= 0 || rect_is_empty(clip) then
    return row_count
  end
  let mut top = clip.y - rect.y
  if top < 0 then
    top = 0
  end
  let mut index = top / row_height
  if index < 0 then
    index = 0
  end
  if index > row_count then
    index = row_count
  end
  return index
end

fn list_last_row(rect: Rect, clip: Rect, row_height: i32, row_count: i32) -> i32 = do
  if row_count <= 0 || rect_is_empty(clip) then
    return 0
  end
  let mut bottom = clip.y + clip.height - rect.y
  if bottom < 0 then
    return 0
  end
  let mut index = (bottom + row_height - 1) / row_height
  if index < 0 then
    index = 0
  end
  if index > row_count then
    index = row_count
  end
  return index
end

fn push_row_fill(operations: [DrawOp], row: Rect, color: ColorRgba) -> [DrawOp] = do
  let mut next = operations
  next.push(OpFillRect(FillRectOp { rect: row, color: color }))
  return next
end

export fn list_text_dx(theme: Theme, show_icons: bool) -> i32 = do
  if show_icons == false then
    return 0
  end
  return theme.font_size_pixels + list_row_inset(theme)
end

export fn paint_list_rows(
  theme: Theme,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  texts: [string],
  operations: [DrawOp],
  show_icons: bool
) -> [DrawOp] = do
  let mut next = operations
  const row_height = list_row_height(theme)
  const rect = layout.rects[node_index]
  const clip = layout.clips[node_index]
  const selected = list_selected_at(state.list_selected, node_index)
  const row_count = texts.length()
  let mut index = list_first_row(rect, clip, row_height, row_count)
  const last = list_last_row(rect, clip, row_height, row_count)
  while index < last do
    const row = rect_new(rect.x, rect.y + index * row_height, rect.width, row_height)
    if rect_is_empty(rect_intersect(row, clip)) == false then
      let mut ink = theme.foreground
      if state.hover.index == node_index then
        ink = readable_color(theme.foreground)
      end
      if index == selected then
        let mut fill = theme.list_inactive
        if state.focus.index == node_index then
          fill = theme.list_selected
        end
        if state.hover.index == node_index then
          fill = row_fill_color(fill)
        end
        next = push_row_fill(next, row, fill)
      else if state.hover.index == node_index && index == state.list_hover_row then
        next = push_row_fill(next, row, row_fill_color(theme.list_hover))
      end
      if show_icons then
        const icon_size = theme.font_size_pixels
        next = paint_named_icon(
          next,
          list_icon_name(texts[index]),
          row.x + theme.padding,
          row.y + (row_height - icon_size) / 2,
          icon_size,
          ink
        )
      end
      next.push(OpText(TextOp {
        origin_x: row.x + theme.padding + list_text_dx(theme, show_icons),
        origin_y: row.y + list_row_inset(theme),
        color: ink,
        text: texts[index]
      }))
    end
    index = index + 1
  end
  return next
end

export fn paint_focused_list_ring(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  operations: [DrawOp]
) -> [DrawOp] = do
  const child = scroll_content_child(store, WidgetId { index: node_index })
  if widget_id_is_none(child) then
    return operations
  end
  if state.focus.index != child.index then
    return operations
  end
  if kind_is_list_view(store.nodes[child.index].kind) == false then
    return operations
  end
  let mut next = operations
  next.push(OpStrokeRect(StrokeRectOp {
    rect: layout.rects[node_index],
    color: theme.button_stroke,
    line_width: 1
  }))
  next
end
