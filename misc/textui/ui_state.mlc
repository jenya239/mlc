import { WidgetId, widget_id_none, widget_id_equals } from './store'
import { Selection, selection_none } from './selection'
import { ClipboardBuffer, clipboard_buffer_empty } from './clipboard'

export type GrabKind = GrabNone | GrabText | GrabClick | GrabScroll | GrabList | GrabSplit

export type DragGranularity = DragGranularityChar | DragGranularityWord

export type PointerDrag = {
  owner: WidgetId,
  origin_x: i32,
  origin_y: i32,
  anchor: i32,
  mark: i32,
  claimed: bool,
  granularity: DragGranularity
}

export fn pointer_drag_claimed(drag: PointerDrag) -> PointerDrag =
  PointerDrag {
    owner: drag.owner,
    origin_x: drag.origin_x,
    origin_y: drag.origin_y,
    anchor: drag.anchor,
    mark: drag.mark,
    claimed: true,
    granularity: drag.granularity
  }

export type PointerClick = {
  owner: WidgetId,
  origin_x: i32,
  origin_y: i32
}

export type PointerScroll = {
  owner: WidgetId,
  origin_y: i32,
  origin_offset: i32
}

export type PointerList = {
  owner: WidgetId
}

export type PointerSplit = {
  owner: WidgetId,
  origin_position: i32,
  origin_ratio: i32
}

export type PointerSession =
  PointerIdle
  | PointerText(PointerDrag)
  | PointerClickSession(PointerClick)
  | PointerScrollSession(PointerScroll)
  | PointerListSession(PointerList)
  | PointerSplitSession(PointerSplit)

export type LastPress = {
  owner: WidgetId,
  x: i32,
  y: i32,
  time_ms: i32,
  count: i32
}

export type LastPressSession = LastPressNone | LastPressSome(LastPress)

export type UiState = {
  selection: Selection,
  grab: GrabKind,
  pointer: PointerSession,
  last_press: LastPressSession,
  clipboard: ClipboardBuffer,
  hover: WidgetId,
  scroll_offsets: [i32],
  pick_enabled: bool,
  inspected: WidgetId,
  list_selected: [i32],
  list_hover_row: i32,
  splitter_ratios: [i32],
  focus: WidgetId,
  field_caret: i32,
  field_scroll_x: i32,
  field_revision: i32,
  listing_revision: i32,
  overlay_open: bool,
  overlay_revision: i32
}

export fn grab_is_none(grab: GrabKind) -> bool =
  match grab
    | GrabNone => true
    | GrabText => false
    | GrabClick => false
    | GrabScroll => false
    | GrabList => false
    | GrabSplit => false

export fn grab_is_text(grab: GrabKind) -> bool =
  match grab
    | GrabNone => false
    | GrabText => true
    | GrabClick => false
    | GrabScroll => false
    | GrabList => false
    | GrabSplit => false

export fn pointer_click_owns(pointer: PointerSession, owner: WidgetId) -> bool =
  match pointer
    | PointerClickSession(session) => widget_id_equals(session.owner, owner)
    | PointerIdle => false
    | PointerText(_) => false
    | PointerScrollSession(_) => false
    | PointerListSession(_) => false
    | PointerSplitSession(_) => false

export fn pointer_is_list(pointer: PointerSession) -> bool =
  match pointer
    | PointerListSession(_) => true
    | PointerIdle => false
    | PointerText(_) => false
    | PointerClickSession(_) => false
    | PointerScrollSession(_) => false
    | PointerSplitSession(_) => false

export fn pointer_list_owner(pointer: PointerSession) -> WidgetId =
  match pointer
    | PointerListSession(session) => session.owner
    | PointerIdle => widget_id_none()
    | PointerText(_) => widget_id_none()
    | PointerClickSession(_) => widget_id_none()
    | PointerScrollSession(_) => widget_id_none()
    | PointerSplitSession(_) => widget_id_none()

export fn pointer_split_owns(pointer: PointerSession, owner: WidgetId) -> bool =
  match pointer
    | PointerSplitSession(session) => widget_id_equals(session.owner, owner)
    | PointerIdle => false
    | PointerText(_) => false
    | PointerClickSession(_) => false
    | PointerScrollSession(_) => false
    | PointerListSession(_) => false

export fn ui_state_new() -> UiState = do
  let mut scroll_offsets: [i32] = []
  let mut list_selected: [i32] = []
  let mut splitter_ratios: [i32] = []
  UiState {
    selection: selection_none(),
    grab: GrabNone,
    pointer: PointerIdle,
    last_press: LastPressNone,
    clipboard: clipboard_buffer_empty(),
    hover: widget_id_none(),
    scroll_offsets: scroll_offsets,
    pick_enabled: false,
    inspected: widget_id_none(),
    list_selected: list_selected,
    list_hover_row: 0 - 1,
    splitter_ratios: splitter_ratios,
    focus: widget_id_none(),
    field_caret: 0,
    field_scroll_x: 0,
    field_revision: 0,
    listing_revision: 0,
    overlay_open: false,
    overlay_revision: 0
  }
end

export fn ui_state_with(
  state: UiState,
  selection: Selection,
  grab: GrabKind,
  pointer: PointerSession,
  last_press: LastPressSession,
  clipboard: ClipboardBuffer,
  hover: WidgetId
) -> UiState =
  UiState {
    selection: selection,
    grab: grab,
    pointer: pointer,
    last_press: last_press,
    clipboard: clipboard,
    hover: hover,
    scroll_offsets: state.scroll_offsets,
    pick_enabled: state.pick_enabled,
    inspected: state.inspected,
    list_selected: state.list_selected,
    list_hover_row: state.list_hover_row,
    splitter_ratios: state.splitter_ratios,
    focus: state.focus,
    field_caret: state.field_caret,
    field_scroll_x: state.field_scroll_x,
    field_revision: state.field_revision,
    listing_revision: state.listing_revision,
    overlay_open: state.overlay_open,
    overlay_revision: state.overlay_revision
  }

