import { Theme } from './theme'
import { WidgetStore, WidgetId, widget_id_none, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { handle_press } from './update_pointer_press'
import { apply_pick_press } from './inspect'
import { handle_text_drag } from './update_pointer_text'
import { click_release_events } from './update_pointer_click'
import { handle_scroll_drag } from './update_scroll'
import { hit_test } from './hit'
import { kind_is_clickable } from './user_select'
import {
  UiState,
  ui_state_with
} from './ui_state'
import { UiInput } from './ui_input'
import { UiEvent } from './ui_event'

export type PointerUpdate = {
  state: UiState,
  events: [UiEvent]
}

fn pointer_while_down(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState =
  match state.pointer
    | PointerIdle => state
    | PointerClickSession(_) => state
    | PointerText(drag) => handle_text_drag(layout, theme, state, input, drag)
    | PointerScrollSession(session) => handle_scroll_drag(store, layout, state, input, session)

fn hover_from_hit(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  pick_enabled: bool,
  x: i32,
  y: i32
) -> WidgetId = do
  const hit = hit_test(store, layout, theme, x, y)
  if widget_id_is_none(hit) then
    return widget_id_none()
  end
  if pick_enabled then
    if hit.index == store.root.index then
      return widget_id_none()
    end
    return hit
  end
  if kind_is_clickable(store.nodes[hit.index].kind) then
    return hit
  end
  return widget_id_none()
end

fn release_pointer(state: UiState) -> UiState =
  ui_state_with(
    state,
    state.selection,
    GrabNone,
    PointerIdle,
    state.last_press,
    state.clipboard,
    state.hover
  )

export fn update_pointer(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> PointerUpdate = do
  let mut current = state
  let mut events: [UiEvent] = []
  if input.left_pressed && current.pick_enabled then
    current = apply_pick_press(store, layout, theme, current, input)
  end
  if input.left_pressed && current.pick_enabled == false then
    current = handle_press(store, layout, theme, current, input)
  end
  if input.left_down then
    current = pointer_while_down(store, layout, theme, current, input)
  end
  if input.left_released then
    events = click_release_events(store, layout, theme, current, input)
    current = release_pointer(current)
  end
  current = ui_state_with(
    current,
    current.selection,
    current.grab,
    current.pointer,
    current.last_press,
    current.clipboard,
    hover_from_hit(
      store, layout, theme, current.pick_enabled, input.mouse_x, input.mouse_y
    )
  )
  PointerUpdate {
    state: current,
    events: events
  }
end
