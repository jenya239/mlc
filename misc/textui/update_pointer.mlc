import { Theme } from './theme'
import { WidgetStore, WidgetId, widget_id_none, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { handle_press } from './update_pointer_press'
import { apply_pick_press } from './inspect'
import { handle_text_drag } from './update_pointer_text'
import { click_release_events } from './update_pointer_click'
import { menu_release } from './menu'
import { handle_scroll_drag } from './update_scroll'
import { handle_list_drag, list_hover_row_at } from './update_list'
import { handle_split_drag } from './update_split'
import { hit_test } from './hit'
import { kind_is_clickable } from './user_select'
import { kind_is_list_view, kind_is_splitter } from './store'
import {
  UiState,
  LastPress,
  ui_state_with,
  ui_state_with_list_hover_row,
  pointer_is_list,
  pointer_list_owner
} from './ui_state'
import { UiInput } from './ui_input'
import { UiEvent, ui_event_row_activated } from './ui_event'

export type PointerUpdate = {
  state: UiState,
  events: [UiEvent]
}

fn pointer_while_down(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState =
  match state.pointer
    | PointerIdle => state
    | PointerClickSession(_) => state
    | PointerText(drag) => handle_text_drag(layout, theme, state, input, drag)
    | PointerScrollSession(session) => handle_scroll_drag(store, layout, state, input, session)
    | PointerListSession(session) => handle_list_drag(store, layout, theme, state, input, session.owner)
    | PointerSplitSession(session) => handle_split_drag(store, layout, theme, state, input, session)

fn hover_from_hit(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  pick_enabled: bool,
  x: i32,
  y: i32
) -> WidgetId = do
  const hit = hit_test(store, layout, theme, x, y)
  if widget_id_is_none(hit) then
    return widget_id_none()
  end
  if pick_enabled then
    if hit.index == store.root.index then
      return widget_id_none()
    end
    return hit
  end
  const kind = store.nodes[hit.index].kind
  if kind_is_clickable(kind) || kind_is_list_view(kind) || kind_is_splitter(kind) then
    return hit
  end
  return widget_id_none()
end

fn last_press_count(state: UiState) -> i32 =
  match state.last_press
    | LastPressNone => 0
    | LastPressSome(press) => press.count

fn release_pointer(state: UiState) -> UiState =
  ui_state_with(
    state,
    state.selection,
    GrabNone,
    PointerIdle,
    state.last_press,
    state.clipboard,
    state.hover
  )

export fn update_pointer(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> PointerUpdate = do
  let mut current = state
  let mut events: [UiEvent] = []
  if input.left_pressed && current.pick_enabled then
    current = apply_pick_press(store, layout, theme, current, input)
  end
  if input.left_pressed && current.pick_enabled == false then
    current = handle_press(store, layout, theme, current, input)
    if pointer_is_list(current.pointer) && last_press_count(current) >= 2 then
      events.push(ui_event_row_activated(pointer_list_owner(current.pointer)))
    end
  end
  if input.left_down then
    current = pointer_while_down(store, layout, theme, current, input)
  end
  const menu_gesture = store.placed && current.overlay_open
  if input.left_released && menu_gesture then
    const released = menu_release(store, layout, theme, current, input)
    events = released.events
    current = release_pointer(released.state)
  end
  if input.left_released && menu_gesture == false then
    events = click_release_events(store, layout, theme, current, input)
    current = release_pointer(current)
  end
  const hover = hover_from_hit(
    store, layout, theme, current.pick_enabled, input.mouse_x, input.mouse_y
  )
  current = ui_state_with(
    current,
    current.selection,
    current.grab,
    current.pointer,
    current.last_press,
    current.clipboard,
    hover
  )
  current = ui_state_with_list_hover_row(
    current,
    list_hover_row_at(store, layout, theme, hover, input.mouse_y)
  )
  return PointerUpdate {
    state: current,
    events: events
  }
end
