import { Theme } from './theme'
import { WidgetStore } from './store'
import { LayoutResult } from './layout_result'
import { label_index_at } from './widget_label'
import { Selection } from './selection'
import { selection_publish_primary } from './selection_text'
import { pointer_past_slop } from './pointer_slop'
import { handle_press } from './update_pointer_press'
import {
  UiState,
  PointerDrag,
  ui_state_with
} from './ui_state'
import { UiInput } from './ui_input'

fn handle_drag(
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput,
  drag: PointerDrag
) -> UiState = do
  let mut claimed = drag.claimed
  let mut grab = state.grab
  if claimed == false && pointer_past_slop(drag.origin_x, drag.origin_y, input.mouse_x, input.mouse_y) then
    claimed = true
    grab = GrabText
  end
  if claimed == false then
    return ui_state_with(
      state.selection,
      grab,
      PointerActive(drag),
      state.last_press,
      state.clipboard
    )
  end
  const focus = label_index_at(
    theme,
    layout.rects[drag.owner.index],
    layout.text_layouts[drag.owner.index],
    input.mouse_x,
    input.mouse_y
  )
  const selection = Selection { owner: drag.owner, anchor: drag.anchor, focus: focus }
  const next_drag = PointerDrag {
    owner: drag.owner,
    origin_x: drag.origin_x,
    origin_y: drag.origin_y,
    anchor: drag.anchor,
    claimed: true
  }
  const published = selection_publish_primary(layout, state, selection)
  ui_state_with(
    selection,
    grab,
    PointerActive(next_drag),
    state.last_press,
    published.clipboard
  )
end

fn pointer_while_down(
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState =
  match state.pointer
    | PointerIdle => state
    | PointerActive(drag) => handle_drag(layout, theme, state, input, drag)

fn release_pointer(state: UiState) -> UiState =
  ui_state_with(
    state.selection,
    GrabNone,
    PointerIdle,
    state.last_press,
    state.clipboard
  )

export fn update_pointer(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState = do
  let mut current = state
  if input.left_pressed then
    current = handle_press(store, layout, theme, current, input)
  end
  if input.left_down then
    current = pointer_while_down(layout, theme, current, input)
  end
  if input.left_released then
    return release_pointer(current)
  end
  return current
end
