fn slop_pixels() -> i32 = 4

export fn pointer_double_click_ms() -> i32 = 400

fn distance_squared(ax: i32, ay: i32, bx: i32, by: i32) -> i32 = do
  const delta_x = ax - bx
  const delta_y = ay - by
  delta_x * delta_x + delta_y * delta_y
end

export fn pointer_past_slop(ax: i32, ay: i32, bx: i32, by: i32) -> bool =
  distance_squared(ax, ay, bx, by) >= slop_pixels() * slop_pixels()
