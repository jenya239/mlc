fn fail(message: string) -> i32 = do
  println("[script_vm script_frame_pump_unit] FAIL: " + message)
  1
end

fn gallery_service_drain() -> string = "gallery_inline"

fn chat_service_drain() -> string = "chat_inline"

fn shared_pump_name() -> string = "script_frame_pump"

fn main() -> i32 = do
  let gallery = gallery_service_drain()
  let chat = chat_service_drain()
  if gallery == chat && gallery == shared_pump_name() then
    println("[script_vm] script_frame_pump_unit ok")
    return 0
  end
  fail(
    "service drain is not shared gallery=" + gallery
      + " chat=" + chat
      + " pump=" + shared_pump_name()
  )
end
