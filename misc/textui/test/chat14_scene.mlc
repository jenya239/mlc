import { Theme, theme_default } from '../theme'
import { chat_model_new } from '../chat_model'
import { ChatScene, build_chat_scene } from '../chat_scene'
import { chat_apply_events, chat_initial_state } from '../chat_update'
import { field_caption, widget_store_set_field_data } from '../widget_field'
import { WidgetStore, field_data_multiline, widget_id_equals, widget_id_is_none } from '../store'
import { TextShapingState, text_shaping_new } from '../../gui/text_shaping'
import { TextLayoutCache, text_layout_cache_new } from '../text_layout'
import { Rect } from '../geometry'
import { LayoutColumnResult, layout_ui } from '../layout_pass'
import { UiInput } from '../ui_input'
import { ui_update } from '../ui_update'

fn numbered_lines(count: i32) -> string = do
  let mut text = ""
  let mut index = 0
  while index < count do
    if index > 0 then
      text = text + "\n"
    end
    text = text + index.to_string()
    index = index + 1
  end
  text
end

fn place(
  store: WidgetStore,
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache
) -> LayoutColumnResult = do
  let mut offsets: [i32] = []
  let mut ratios: [i32] = []
  layout_ui(store, theme, shaping, cache, 900, 700, offsets, ratios)
end

fn text_input(text: string, enter_pressed: bool, shift_down: bool) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: 0,
    text: text,
    binding_key: "",
    shift_down: shift_down,
    backspace_pressed: false,
    enter_pressed: enter_pressed,
    paste_text: ""
  }

fn click_input(x: i32, y: i32) -> UiInput =
  UiInput {
    mouse_x: x,
    mouse_y: y,
    left_pressed: true,
    left_down: true,
    left_released: true,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: 0,
    text: "",
    binding_key: "",
    shift_down: false,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }

fn with_composer(store: WidgetStore, scene: ChatScene, text: string) -> WidgetStore =
  widget_store_set_field_data(store, scene.composer, field_data_multiline(text, 6))

fn composer_text(store: WidgetStore, scene: ChatScene) -> string =
  field_caption(store.nodes[scene.composer.index].kind)

fn rect_of(laid: LayoutColumnResult, index: i32) -> Rect =
  laid.layout.rects[index]

fn main() -> i32 = do
  const theme = theme_default()
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  const scene = build_chat_scene()
  const root_children = scene.store.nodes[scene.store.root.index].children
  if root_children.length() != 3 then
    return -1
  end
  if widget_id_equals(root_children[1], scene.transcript) then
    return -1
  end
  if scene.store.nodes[scene.catalog_list.index].visible == false then
    return -1
  end
  if widget_id_is_none(scene.store.menu) || scene.store.placed then
    return -1
  end
  if scene.store.nodes[scene.store.menu.index].visible then
    return -1
  end
  if widget_id_equals(root_children[2], scene.composer) then
    return -1
  end
  if scene.store.nodes[scene.transcript.index].children.length() != 0 then
    return -1
  end
  if scene.store.nodes[scene.stop.index].visible then
    return -2
  end
  let mut laid = place(scene.store, theme, shaping, cache)
  shaping = laid.shaping
  cache = laid.cache
  const header = rect_of(laid, root_children[0].index)
  const transcript = rect_of(laid, scene.transcript.index)
  const composer = rect_of(laid, scene.composer.index)
  if transcript.x <= header.x || transcript.width >= 900 - 16 || transcript.width < 300 then
    return -3
  end
  if transcript.y != header.y + header.height + theme.gap then
    return -4
  end
  if composer.x != transcript.x || composer.width != transcript.width then
    return -5
  end
  const provider = rect_of(laid, scene.provider_button.index)
  const model_button = rect_of(laid, scene.model_button.index)
  const route = scene.store.nodes[scene.provider_button.index].parent
  if widget_id_equals(scene.store.nodes[scene.model_button.index].parent, route) == false then
    return -5
  end
  if widget_id_equals(scene.store.nodes[route.index].parent, scene.store.nodes[scene.composer.index].parent) == false then
    return -5
  end
  if widget_id_equals(scene.store.nodes[scene.send.index].parent, scene.store.nodes[scene.composer.index].parent) then
    return -5
  end
  if provider.y < transcript.y + transcript.height || model_button.y != provider.y then
    return -5
  end
  if model_button.x <= provider.x then
    return -5
  end
  if provider.x < transcript.x || model_button.x + model_button.width > transcript.x + transcript.width then
    return -5
  end
  if composer.y < provider.y + provider.height then
    return -5
  end
  const empty_transcript = transcript.height
  const empty_composer = composer.height

  const four = with_composer(scene.store, scene, numbered_lines(4))
  laid = place(four, theme, shaping, cache)
  const four_transcript = rect_of(laid, scene.transcript.index).height
  const four_composer = rect_of(laid, scene.composer.index).height
  if four_composer - empty_composer != empty_transcript - four_transcript then
    return -6
  end
  if four_composer <= empty_composer then
    return -6
  end
  const six = with_composer(scene.store, scene, numbered_lines(6))
  const eight = with_composer(scene.store, scene, numbered_lines(8))
  const six_height = rect_of(place(six, theme, shaping, cache), scene.composer.index).height
  const eight_height = rect_of(place(eight, theme, shaping, cache), scene.composer.index).height
  if six_height != eight_height || six_height <= four_composer then
    return -7
  end

  let mut model = chat_model_new()
  let mut state = chat_initial_state(scene)
  if widget_id_equals(state.focus, scene.composer) == false then
    return -8
  end
  laid = place(scene.store, theme, shaping, cache)
  const typed = ui_update(
    scene.store, laid.layout, theme, state, text_input("hello", false, false)
  )
  const entered = ui_update(
    typed.store, laid.layout, theme, typed.state, text_input("", true, false)
  )
  const sent = chat_apply_events(scene, model, entered.store, entered.state, entered.events)
  if sent.send_requested == false || sent.model.pending == false then
    return -9
  end
  if sent.model.messages.length() != 1 || sent.model.messages[0].text != "hello" then
    return -9
  end
  if composer_text(sent.store, scene) != "" then
    return -10
  end
  if widget_id_equals(sent.state.focus, scene.composer) == false then
    return -10
  end
  if sent.store.nodes[scene.stop.index].visible == false || sent.state.listing_revision != 1 then
    return -11
  end

  const spaces = ui_update(
    scene.store, laid.layout, theme, state, text_input("   ", false, false)
  )
  const blank = ui_update(
    spaces.store, laid.layout, theme, spaces.state, text_input("", true, false)
  )
  if blank.events.length() == 0 then
    return -12
  end
  const rejected_blank = chat_apply_events(scene, model, blank.store, blank.state, blank.events)
  if rejected_blank.send_requested || composer_text(rejected_blank.store, scene) != "   " then
    return -12
  end
  if rejected_blank.model.messages.length() != 0 || rejected_blank.state.listing_revision != 0 then
    return -12
  end

  laid = place(sent.store, theme, shaping, cache)
  const more = ui_update(
    sent.store, laid.layout, theme, sent.state, text_input("more", false, false)
  )
  laid = place(more.store, theme, shaping, cache)
  const send_rect = rect_of(laid, scene.send.index)
  const send_click = ui_update(
    more.store,
    laid.layout,
    theme,
    more.state,
    click_input(send_rect.x + send_rect.width / 2, send_rect.y + send_rect.height / 2)
  )
  if send_click.events.length() == 0 then
    return -13
  end
  const rejected_pending = chat_apply_events(
    scene, sent.model, send_click.store, send_click.state, send_click.events
  )
  if rejected_pending.send_requested || rejected_pending.model.messages.length() != 1 then
    return -13
  end
  if composer_text(rejected_pending.store, scene) != "more" then
    return -13
  end

  laid = place(sent.store, theme, shaping, cache)
  const stop_rect = rect_of(laid, scene.stop.index)
  const stop_click = ui_update(
    sent.store,
    laid.layout,
    theme,
    sent.state,
    click_input(stop_rect.x + stop_rect.width / 2, stop_rect.y + stop_rect.height / 2)
  )
  if stop_click.events.length() == 0 then
    return -14
  end
  const stopped = chat_apply_events(
    scene, sent.model, stop_click.store, stop_click.state, stop_click.events
  )
  if stopped.model.pending || stopped.model.messages.length() != 2 then
    return -14
  end
  if stopped.model.messages[1].text != "Остановлено" then
    return -14
  end
  if stopped.store.nodes[scene.stop.index].visible then
    return -15
  end

  laid = place(sent.store, theme, shaping, cache)
  const fresh_rect = rect_of(laid, scene.new_chat.index)
  const fresh_click = ui_update(
    sent.store,
    laid.layout,
    theme,
    sent.state,
    click_input(fresh_rect.x + fresh_rect.width / 2, fresh_rect.y + fresh_rect.height / 2)
  )
  if fresh_click.events.length() == 0 then
    return -16
  end
  const ignored = chat_apply_events(
    scene, sent.model, fresh_click.store, fresh_click.state, fresh_click.events
  )
  if ignored.fresh_requested || ignored.model.messages.length() != 1 || ignored.model.pending == false then
    return -16
  end
  const cleared = chat_apply_events(
    scene, stopped.model, fresh_click.store, fresh_click.state, fresh_click.events
  )
  if cleared.fresh_requested == false || cleared.model.messages.length() != 0 || cleared.model.pending then
    return -16
  end
  if cleared.store.nodes[scene.stop.index].visible then
    return -16
  end
  if chat_model_new().pending then
    return -17
  end

  laid = place(scene.store, theme, shaping, cache)
  const back_rect = rect_of(laid, scene.back.index)
  const back_click = ui_update(
    scene.store,
    laid.layout,
    theme,
    chat_initial_state(scene),
    click_input(back_rect.x + back_rect.width / 2, back_rect.y + back_rect.height / 2)
  )
  if back_click.events.length() == 0 then
    return -18
  end
  const leaving = chat_apply_events(
    scene, chat_model_new(), back_click.store, back_click.state, back_click.events
  )
  if leaving.leave_requested == false then
    return -18
  end
  if cleared.leave_requested || cleared.provider_requested then
    return -19
  end
  laid = place(scene.store, theme, shaping, cache)
  const provider_rect = rect_of(laid, scene.provider_button.index)
  const provider_click = ui_update(
    scene.store,
    laid.layout,
    theme,
    chat_initial_state(scene),
    click_input(provider_rect.x + provider_rect.width / 2, provider_rect.y + provider_rect.height / 2)
  )
  if provider_click.events.length() == 0 then
    return -20
  end
  const choosing = chat_apply_events(
    scene, chat_model_new(), provider_click.store, provider_click.state, provider_click.events
  )
  if choosing.provider_requested == false || choosing.model_requested then
    return -20
  end
  const model_rect = rect_of(laid, scene.model_button.index)
  const model_click = ui_update(
    scene.store,
    laid.layout,
    theme,
    chat_initial_state(scene),
    click_input(model_rect.x + model_rect.width / 2, model_rect.y + model_rect.height / 2)
  )
  const modeling = chat_apply_events(
    scene, chat_model_new(), model_click.store, model_click.state, model_click.events
  )
  if modeling.model_requested == false then
    return -21
  end
  0
end
