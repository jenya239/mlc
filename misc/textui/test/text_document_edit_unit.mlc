import { text_document_from_bytes, text_document_line, text_document_line_count, text_document_next_line_identifier, text_document_replace, text_document_to_bytes } from '../text_document'
import { text_edit_invert, text_edit_map_offset, GravityAfter, GravityBefore } from '../text_edit'
import { text_line_index_offset_of } from '../text_line_index'

fn replace_one_line() -> i32 = do
  const document = text_document_from_bytes("a\nb\nc")
  const replaced = text_document_replace(document, 2, 3, "B")
  if replaced.accepted == false || replaced.edit.removed_text != "b" then
    return 1
  end
  const built = text_document_to_bytes(replaced.document)
  if built.accepted == false || built.bytes != "a\nB\nc" then
    return 2
  end
  const untouched = text_document_line(replaced.document, 0)
  const touched = text_document_line(replaced.document, 1)
  const last = text_document_line(replaced.document, 2)
  if untouched.line_identifier != 0 || untouched.revision != 0 then
    return 3
  end
  if touched.line_identifier != 1 || touched.revision != 1 || touched.text != "B" then
    return 4
  end
  if last.line_identifier != 2 || last.revision != 0 then
    return 5
  end
  0
end

fn replace_inserts_line() -> i32 = do
  const document = text_document_from_bytes("a\nb\nc")
  const replaced = text_document_replace(document, 2, 3, "x\ny")
  const built = text_document_to_bytes(replaced.document)
  if built.accepted == false || built.bytes != "a\nx\ny\nc" then
    return 6
  end
  if text_document_line_count(replaced.document) != 4 then
    return 7
  end
  const touched = text_document_line(replaced.document, 1)
  const inserted = text_document_line(replaced.document, 2)
  const last = text_document_line(replaced.document, 3)
  if touched.line_identifier != 1 || touched.revision != 1 then
    return 8
  end
  if inserted.line_identifier != 3 || inserted.revision != 0 || inserted.text != "y" then
    return 9
  end
  if last.line_identifier != 2 || last.revision != 0 then
    return 10
  end
  if text_document_next_line_identifier(replaced.document) != 4 then
    return 11
  end
  0
end

fn gravity_and_invert() -> i32 = do
  const document = text_document_from_bytes("a\nb\nc")
  const replaced = text_document_replace(document, 2, 4, "Q")
  const before = text_edit_map_offset(replaced.edit, 3, GravityBefore)
  const after = text_edit_map_offset(replaced.edit, 3, GravityAfter)
  if before == after then
    return 12
  end
  if before != 2 || after != 3 then
    return 13
  end
  const inverted = text_edit_invert(replaced.edit)
  const restored = text_document_replace(replaced.document, inverted.start_offset, inverted.end_offset, inverted.inserted_text)
  const built = text_document_to_bytes(restored.document)
  if built.accepted == false || built.bytes != "a\nb\nc" then
    return 14
  end
  0
end

fn point_update() -> i32 = do
  let mut text = ""
  let mut index = 0
  while index < 512 do
    text = text + "a\n"
    index = index + 1
  end
  const document = text_document_from_bytes(text)
  const replaced = text_document_replace(document, 0, 1, "bbbbbbbbbb")
  if replaced.accepted == false then
    return 15
  end
  const far = text_line_index_offset_of(replaced.document.line_index, 512)
  if far.value != 1033 then
    return 16
  end
  if replaced.document.line_index.updates >= 64 then
    return 17
  end
  0
end

fn main() -> i32 = do
  const one = replace_one_line()
  if one != 0 then
    return one
  end
  const inserted = replace_inserts_line()
  if inserted != 0 then
    return inserted
  end
  const gravity = gravity_and_invert()
  if gravity != 0 then
    return gravity
  end
  point_update()
end
