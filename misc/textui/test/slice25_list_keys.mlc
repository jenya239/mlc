import { Theme, theme_default } from '../theme'
import {
  ListData,
  OverflowVisible,
  WidgetId,
  WidgetStore,
  widget_id_equals,
  widget_id_none,
  widget_store_add_box,
  widget_store_add_list_view,
  widget_store_add_scroll_view,
  widget_store_add_text_field,
  field_data_new,
  widget_store_empty,
  BoxData,
  DirectionColumn
} from '../store'
import { text_shaping_new } from '../../gui/text_shaping'
import { text_layout_cache_new } from '../text_layout'
import { layout_ui } from '../layout_pass'
import { paint_ui_frame } from '../paint_pass'
import { ui_state_new, ui_state_with_field, ui_state_with_list_selected } from '../ui_state'
import { UiInput } from '../ui_input'
import { ui_update } from '../ui_update'
import { ui_event_is_activate_on } from '../ui_event'
import { DrawOp } from '../draw_op'
import { Rect } from '../geometry'
import { list_row_height, list_selected_at, list_selected_put } from '../widget_list'
import { scroll_offset_at } from '../widget_scroll'

fn column_data() -> BoxData =
  BoxData { direction: DirectionColumn, padding: 0, gap: 0 }

fn row_texts() -> [string] = do
  let mut texts: [string] = []
  let mut index = 0
  while index < 10 do
    texts.push("row" + index.to_string())
    index = index + 1
  end
  texts
end

fn build_list() -> WidgetStore = do
  let mut store = widget_store_empty()
  store = widget_store_add_scroll_view(store, widget_id_none(), 1, true)
  widget_store_add_list_view(
    store, store.root, ListData { texts: row_texts() }, 0, true
  )
end

fn build_field_and_list() -> WidgetStore = do
  let mut store = widget_store_empty()
  store = widget_store_add_box(
    store, widget_id_none(), column_data(), OverflowVisible, 0, true
  )
  store = widget_store_add_text_field(
    store, store.root, field_data_new("/tmp"), 0, true
  )
  store = widget_store_add_scroll_view(store, store.root, 1, true)
  const scroller = store.nodes[store.nodes.length() - 1].id
  widget_store_add_list_view(
    store, scroller, ListData { texts: row_texts() }, 0, true
  )
end

fn keys(binding_key: string, backspace_pressed: bool, enter_pressed: bool) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: 0,
    text: "",
    binding_key: binding_key,
    shift_down: false,
    backspace_pressed: backspace_pressed,
    enter_pressed: enter_pressed,
    paste_text: ""
  }

fn fill_matches(operations: [DrawOp], red: f64) -> bool = do
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpFillRect(data) => data.color.red == red
      | OpText(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      return true
    end
    index = index + 1
  end
  false
end

fn viewport_ring(operations: [DrawOp], rect: Rect, red: f64) -> i32 = do
  let mut count = 0
  let mut index = 0
  while index < operations.length() do
    const stroke = match operations[index]
      | OpStrokeRect(data) => data.rect.y == rect.y && data.rect.height == rect.height && data.color.red == red
      | OpFillRect(_) => false
      | OpText(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if stroke then
      count = count + 1
    end
    index = index + 1
  end
  count
end

fn main() -> i32 = do
  const theme = theme_default()
  const store = build_list()
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  let mut ratios: [i32] = []
  let mut state = ui_state_new()
  const laid = layout_ui(store, theme, shaping, cache, 200, 90, state.scroll_offsets, ratios)
  shaping = laid.shaping
  cache = laid.cache
  const list = store.nodes[1].id
  state = ui_state_with_field(state, list, 0, 0)
  const down = ui_update(store, laid.layout, theme, state, keys("down", false, false))
  if list_selected_at(down.state.list_selected, list.index) != 0 then
    return 0 - 1
  end
  if widget_id_equals(down.state.focus, list) == false then
    return 0 - 2
  end
  const again = ui_update(store, laid.layout, theme, down.state, keys("down", false, false))
  if list_selected_at(again.state.list_selected, list.index) != 1 then
    return 0 - 3
  end
  const up = ui_update(store, laid.layout, theme, again.state, keys("up", false, false))
  if list_selected_at(up.state.list_selected, list.index) != 0 then
    return 0 - 4
  end
  const ended = ui_update(store, laid.layout, theme, up.state, keys("end", false, false))
  if list_selected_at(ended.state.list_selected, list.index) != 9 then
    return 0 - 5
  end
  if scroll_offset_at(ended.state.scroll_offsets, store.root.index) <= 0 then
    return 0 - 6
  end
  const home = ui_update(store, laid.layout, theme, ended.state, keys("home", false, false))
  if list_selected_at(home.state.list_selected, list.index) != 0 then
    return 0 - 7
  end
  if scroll_offset_at(home.state.scroll_offsets, store.root.index) != 0 then
    return 0 - 8
  end
  const paged = ui_update(store, laid.layout, theme, home.state, keys("page_down", false, false))
  const step = list_row_height(theme)
  let mut visible = laid.layout.rects[store.root.index].height / step
  visible = visible - 1
  if visible < 1 then
    visible = 1
  end
  if list_selected_at(paged.state.list_selected, list.index) != visible then
    return 0 - 9
  end
  const entered = ui_update(store, laid.layout, theme, paged.state, keys("", false, true))
  if entered.events.length() != 1 || ui_event_is_activate_on(entered.events[0], list) == false then
    return 0 - 10
  end
  const backed = ui_update(store, laid.layout, theme, paged.state, keys("left", false, false))
  if backed.list_back == false then
    return 0 - 11
  end
  const erased = ui_update(store, laid.layout, theme, paged.state, keys("", true, false))
  if erased.list_back == false then
    return 0 - 12
  end

  const mixed = build_field_and_list()
  let mut mixed_state = ui_state_new()
  const mixed_laid = layout_ui(
    mixed, theme, shaping, cache, 200, 160, mixed_state.scroll_offsets, ratios
  )
  const field = mixed.nodes[1].id
  const mixed_list = mixed.nodes[3].id
  mixed_state = ui_state_with_field(mixed_state, field, 0, 0)
  mixed_state = ui_state_with_list_selected(
    mixed_state,
    list_selected_put(mixed_state.list_selected, mixed_list.index, 2)
  )
  const field_down = ui_update(
    mixed, mixed_laid.layout, theme, mixed_state, keys("down", false, false)
  )
  if list_selected_at(field_down.state.list_selected, mixed_list.index) != 2 then
    return 0 - 13
  end

  const quiet = ui_state_with_list_selected(
    ui_state_new(),
    list_selected_put([], list.index, 0)
  )
  const quiet_paint = paint_ui_frame(theme, store, laid.layout, quiet)
  if fill_matches(quiet_paint, theme.list_inactive.red) == false then
    return 0 - 14
  end
  if fill_matches(quiet_paint, theme.list_selected.red) then
    return 0 - 15
  end
  const scroll_rect = laid.layout.rects[store.root.index]
  if viewport_ring(quiet_paint, scroll_rect, theme.button_stroke.red) != 0 then
    return 0 - 16
  end
  const focused_paint = paint_ui_frame(theme, store, laid.layout, down.state)
  if fill_matches(focused_paint, theme.list_selected.red) == false then
    return 0 - 17
  end
  if viewport_ring(focused_paint, scroll_rect, theme.button_stroke.red) != 1 then
    return 0 - 18
  end
  0
end
