import { theme_default } from '../theme'
import {
  BoxData,
  ButtonData,
  DirectionColumn,
  LabelData,
  OverflowVisible,
  WidgetId,
  WidgetStore,
  widget_id_equals,
  widget_id_none,
  widget_store_add_box,
  widget_store_add_button,
  widget_store_add_label,
  widget_store_empty
} from '../store'
import { text_shaping_new } from '../../gui/text_shaping'
import { text_layout_cache_new } from '../text_layout'
import { layout_column } from '../layout_pass'
import { ui_state_new, grab_is_none } from '../ui_state'
import { UiInput } from '../ui_input'
import { ui_update } from '../ui_update'
import { clipboard_copy_selection } from '../update_copy'
import { selection_is_empty } from '../selection'
import { UiEvent, ui_event_is_click_on } from '../ui_event'

fn root_box_data() -> BoxData =
  BoxData { direction: DirectionColumn, padding: 8, gap: 10 }

fn build_store() -> WidgetStore = do
  let mut store = widget_store_empty()
  store = widget_store_add_box(
    store, widget_id_none(), root_box_data(), OverflowVisible, 0, true
  )
  store = widget_store_add_label(
    store, store.root, LabelData { text: "one" }, OverflowVisible, 0, true
  )
  store = widget_store_add_button(
    store, store.root, ButtonData { text: "Copy" }, OverflowVisible, 0, true
  )
  widget_store_add_button(
    store, store.root, ButtonData { text: "Ping" }, OverflowVisible, 0, true
  )
end

fn pointer_at(x: i32, y: i32, pressed: bool, down: bool, released: bool, now_ms: i32) -> UiInput =
  UiInput {
    mouse_x: x,
    mouse_y: y,
    left_pressed: pressed,
    left_down: down,
    left_released: released,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: now_ms
  }

fn clicked_owner(events: [UiEvent], owner: WidgetId) -> bool = do
  let mut index = 0
  while index < events.length() do
    if ui_event_is_click_on(events[index], owner) then
      return true
    end
    index = index + 1
  end
  false
end

fn main() -> i32 = do
  const theme = theme_default()
  const store = build_store()
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  const laid_out = layout_column(store, theme, shaping, cache)
  shaping = laid_out.shaping
  cache = laid_out.cache
  const layout = laid_out.layout
  const label = store.nodes[1].id
  const copy = store.nodes[2].id
  const ping = store.nodes[3].id
  const label_rect = layout.rects[label.index]
  const copy_rect = layout.rects[copy.index]
  const ping_rect = layout.rects[ping.index]
  const ping_mid_y = ping_rect.y + ping_rect.height / 2
  const copy_mid_y = copy_rect.y + copy_rect.height / 2
  const label_mid_y = label_rect.y + label_rect.height / 2

  let mut state = ui_state_new()
  const ping_down = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + 10, ping_mid_y, true, true, false, 0)
  )
  state = ping_down.state
  const ping_up = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + 10, ping_mid_y, false, false, true, 16)
  )
  state = ping_up.state
  if clicked_owner(ping_up.events, ping) == false then
    return -1
  end
  if selection_is_empty(state.selection) == false then
    return -1
  end

  const drag_down = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + 6, ping_mid_y, true, true, false, 100)
  )
  state = drag_down.state
  const drag_move = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + ping_rect.width - 6, ping_mid_y, false, true, false, 116)
  )
  state = drag_move.state
  if selection_is_empty(state.selection) == false then
    return -2
  end
  const drag_up = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + ping_rect.width - 6, ping_mid_y, false, false, true, 132)
  )
  state = drag_up.state
  if clicked_owner(drag_up.events, ping) == false then
    return -2
  end
  if grab_is_none(state.grab) == false then
    return -2
  end

  const miss_down = ui_update(
    store, layout, theme, state,
    pointer_at(ping_rect.x + 10, ping_mid_y, true, true, false, 200)
  )
  state = miss_down.state
  const miss_up = ui_update(
    store, layout, theme, state,
    pointer_at(0, 0, false, false, true, 216)
  )
  state = miss_up.state
  if clicked_owner(miss_up.events, ping) then
    return -3
  end

  const select_down = ui_update(
    store, layout, theme, state,
    pointer_at(label_rect.x + 6, label_mid_y, true, true, false, 300)
  )
  state = select_down.state
  const select_move = ui_update(
    store, layout, theme, state,
    pointer_at(label_rect.x + label_rect.width - 6, label_mid_y, false, true, false, 316)
  )
  state = select_move.state
  const select_up = ui_update(
    store, layout, theme, state,
    pointer_at(label_rect.x + label_rect.width - 6, label_mid_y, false, false, true, 332)
  )
  state = select_up.state
  if widget_id_equals(state.selection.owner, label) == false then
    return -4
  end
  if selection_is_empty(state.selection) then
    return -4
  end
  const selected = state.clipboard.primary
  const copy_down = ui_update(
    store, layout, theme, state,
    pointer_at(copy_rect.x + 10, copy_mid_y, true, true, false, 400)
  )
  state = copy_down.state
  const copy_up = ui_update(
    store, layout, theme, state,
    pointer_at(copy_rect.x + 10, copy_mid_y, false, false, true, 416)
  )
  state = copy_up.state
  if widget_id_equals(state.selection.owner, label) == false then
    return -5
  end
  if clicked_owner(copy_up.events, copy) == false then
    return -5
  end
  state = clipboard_copy_selection(layout, state)
  if state.clipboard.clipboard != selected then
    return -5
  end
  0
end
