import {
  LabelData,
  OverflowVisible,
  WidgetId,
  widget_id_none,
  widget_store_add_label,
  widget_store_empty
} from '../store'
import {
  script_transaction_commit,
  script_transaction_new,
  script_transaction_stage_set_label_text
} from '../script_transaction'
import { ui_state_new } from '../ui_state'
import {
  FrameRequest,
  FrameRequestLayout,
  FrameRequestNone,
  FrameRequestPaint,
  frame_request,
  frame_signature,
  frame_signature_with_script_damage
} from '../frame_request'
import {
  ScriptDamageKind,
  ScriptDamageLayoutPaint,
  ScriptDamageNone,
  ScriptDamagePaint,
  ScriptDamageRejected,
  script_damage_for_set_label_text,
  script_damage_needs_layout,
  script_damage_revision_delta
} from '../script_damage'

fn fail(message: string) -> i32 = do
  println("[script_vm script_frame_damage_unit] FAIL: " + message)
  1
end

fn viewport_width() -> i32 = 800

fn viewport_height() -> i32 = 600

fn original_text() -> string = "first"

fn staged_text() -> string = "staged-first"

fn request_kind(request: FrameRequest) -> string =
  match request
    | FrameRequestNone => "none"
    | FrameRequestPaint => "paint"
    | FrameRequestLayout => "layout"

fn check_committed_label() -> i32 = do
  let mut store = widget_store_empty()
  store = widget_store_add_label(store, widget_id_none(), LabelData { text: original_text() }, OverflowVisible, 0, true)
  let state = ui_state_new()
  let previous = frame_signature(state, viewport_width(), viewport_height())
  let mut transaction = script_transaction_new(store)
  transaction = script_transaction_stage_set_label_text(transaction, WidgetId { index: 0 }, staged_text())
  transaction = script_transaction_commit(transaction)
  let damage = script_damage_for_set_label_text(true)
  let next = frame_signature_with_script_damage(
    state,
    viewport_width(),
    viewport_height(),
    previous.script_damage_revision + script_damage_revision_delta(damage)
  )
  let request = frame_request(previous, next)
  let damage_status = match damage
    | ScriptDamageLayoutPaint => 0
    | ScriptDamagePaint => fail("SetLabelText damage was not layout+paint")
    | ScriptDamageNone => fail("SetLabelText damage was not layout+paint")
    | ScriptDamageRejected => fail("SetLabelText damage was not layout+paint")
  if damage_status != 0 then
    return damage_status
  end
  if previous.listing_revision != next.listing_revision then
    return fail("script damage reused listing_revision")
  end
  if request_kind(request) != "layout" || transaction.revision != 1 || !script_damage_needs_layout(damage) then
    return fail(
      "committed SetLabelText requested " + request_kind(request)
        + " revision=" + transaction.revision.to_string()
    )
  end
  0
end

fn check_noop() -> i32 = do
  let state = ui_state_new()
  let previous = frame_signature_with_script_damage(state, viewport_width(), viewport_height(), 1)
  let next = frame_signature_with_script_damage(state, viewport_width(), viewport_height(), 1)
  let request = frame_request(previous, next)
  let damage = script_damage_for_set_label_text(false)
  let damage_status = match damage
    | ScriptDamageNone => 0
    | ScriptDamageLayoutPaint => fail("noop damage was not none")
    | ScriptDamagePaint => fail("noop damage was not none")
    | ScriptDamageRejected => fail("noop damage was not none")
  if damage_status != 0 then
    return damage_status
  end
  if request_kind(request) != "none" then
    return fail("noop requested " + request_kind(request))
  end
  0
end

fn main() -> i32 = do
  let mut status = check_committed_label()
  if status == 0 then
    status = check_noop()
  end
  if status != 0 then
    return status
  end
  println("[script_vm] script_frame_damage_unit ok")
  0
end
