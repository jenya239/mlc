import { database_blocked, database_close, database_file_path, database_open } from '../chat_database'
import { SqliteHandleErr, SqliteHandleOk, open_file } from '../../../lib/mlc/common/stdlib/db/sqlite.mlc'
import { query_close, query_exec, query_i64_is, query_text } from '../statement_query'

fn opened_handle(path: string) -> i32 =
  match open_file(path)
    | SqliteHandleOk(handle) => handle
    | SqliteHandleErr(_) => 0

fn legacy_sql() -> string =
  "CREATE TABLE conversation (" +
  "id INTEGER PRIMARY KEY, title TEXT NOT NULL DEFAULT '', created_at INTEGER NOT NULL, " +
  "updated_at INTEGER NOT NULL, archived INTEGER NOT NULL DEFAULT 0, " +
  "provider TEXT NOT NULL DEFAULT '', model TEXT NOT NULL DEFAULT '');" +
  "CREATE TABLE message (" +
  "id INTEGER PRIMARY KEY, conversation_id INTEGER NOT NULL, ordinal INTEGER NOT NULL, " +
  "role INTEGER NOT NULL, body TEXT NOT NULL, failed INTEGER NOT NULL, created_at INTEGER NOT NULL);" +
  "CREATE TABLE app_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);" +
  "INSERT INTO conversation (title, created_at, updated_at) VALUES ('legacy', 2, 2);" +
  "INSERT INTO message (conversation_id, ordinal, role, body, failed, created_at) VALUES (1, 1, 1, 'old', 0, 2);"

fn migrate_legacy(path: string) -> i32 = do
  const handle = opened_handle(path)
  if handle == 0 then
    return 28
  end
  if query_exec(handle, legacy_sql()) != 0 then
    query_close(handle)
    return 29
  end
  if query_exec(handle, "PRAGMA user_version=2") != 0 then
    query_close(handle)
    return 30
  end
  if query_close(handle) != 0 then
    return 31
  end
  const migrated = database_open(path, "")
  if migrated == 0 then
    return 32
  end
  if query_i64_is(migrated, "PRAGMA user_version", 3) == false then
    database_close(migrated)
    return 33
  end
  if query_text(migrated, "SELECT name FROM pragma_table_info('message') WHERE name = 'provider'") != "provider" then
    database_close(migrated)
    return 34
  end
  if query_text(migrated, "SELECT name FROM pragma_table_info('message') WHERE name = 'model'") != "model" then
    database_close(migrated)
    return 35
  end
  if query_text(migrated, "SELECT provider FROM message") != "" then
    database_close(migrated)
    return 36
  end
  if query_text(migrated, "SELECT model FROM message") != "" then
    database_close(migrated)
    return 37
  end
  if query_text(migrated, "SELECT body FROM message") != "old" then
    database_close(migrated)
    return 38
  end
  database_close(migrated)
end

fn main() -> i32 = do
  const path = database_file_path()
  if path == "" then
    return 2
  end
  const jail = path + "_jail"
  if database_blocked("", path) then
    return 3
  end
  if database_blocked(jail, path) then
    return 4
  end
  if database_blocked(jail, jail + "/nested.sqlite") == false then
    return 5
  end
  if database_blocked(jail, jail + "/../outside.sqlite") then
    return 6
  end
  if database_open(jail + "/nested.sqlite", jail) != 0 then
    return 7
  end
  const legacy = migrate_legacy(path + ".v2")
  if legacy != 0 then
    return legacy
  end
  const database = database_open(path, "")
  if database == 0 then
    return 8
  end
  if query_i64_is(database, "PRAGMA user_version", 3) == false then
    return 9
  end
  if query_text(database, "SELECT name FROM pragma_table_info('conversation') WHERE name = 'provider'") != "provider" then
    return 9
  end
  if query_text(database, "SELECT name FROM pragma_table_info('conversation') WHERE name = 'model'") != "model" then
    return 9
  end
  if query_text(database, "SELECT name FROM pragma_table_info('message') WHERE name = 'provider'") != "provider" then
    return 9
  end
  if query_text(database, "SELECT name FROM pragma_table_info('message') WHERE name = 'model'") != "model" then
    return 9
  end
  if query_i64_is(database, "PRAGMA foreign_keys", 1) == false then
    return 10
  end
  if query_text(database, "PRAGMA journal_mode") != "wal" then
    return 11
  end
  const missing = query_exec(
    database,
    "INSERT INTO message (conversation_id, ordinal, role, body, failed, created_at) VALUES (999, 1, 0, 'x', 0, 1)"
  )
  if missing != 19 then
    return 12
  end
  if query_exec(
    database,
    "INSERT INTO conversation (title, created_at, updated_at) VALUES ('', 1, 1)"
  ) != 0 then
    return 13
  end
  if query_exec(
    database,
    "INSERT INTO message (conversation_id, ordinal, role, body, failed, created_at) VALUES (1, 1, 0, 'a', 0, 1)"
  ) != 0 then
    return 14
  end
  const duplicate = query_exec(
    database,
    "INSERT INTO message (conversation_id, ordinal, role, body, failed, created_at) VALUES (1, 1, 0, 'b', 0, 1)"
  )
  if duplicate != 19 then
    return 15
  end
  if query_exec(
    database,
    "INSERT INTO conversation (title, created_at, updated_at, archived) VALUES ('old', 1, 1, 1)"
  ) != 0 then
    return 16
  end
  const closed = database_close(database)
  if closed != 0 then
    return 17
  end
  const reopened = database_open(path, "")
  if reopened == 0 then
    return 18
  end
  if query_i64_is(reopened, "PRAGMA user_version", 3) == false then
    return 19
  end
  if query_i64_is(reopened, "SELECT COUNT(*) FROM message", 1) == false then
    return 20
  end
  if query_i64_is(reopened, "SELECT COUNT(*) FROM conversation WHERE title = 'old'", 0) == false then
    return 21
  end
  const bulk = query_exec(
    reopened,
    "WITH RECURSIVE counter(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM counter WHERE n < 201) " +
    "INSERT INTO conversation (title, created_at, updated_at, archived) " +
    "SELECT 'kept', 2000000000, n, 1 FROM counter"
  )
  if bulk != 0 then
    return 22
  end
  if database_close(reopened) != 0 then
    return 23
  end
  const retained = database_open(path, "")
  if retained == 0 then
    return 24
  end
  if query_i64_is(retained, "SELECT COUNT(*) FROM conversation WHERE archived = 1", 200) == false then
    return 25
  end
  if query_i64_is(retained, "SELECT COUNT(*) FROM conversation WHERE archived = 0", 1) == false then
    return 26
  end
  if database_close(retained) != 0 then
    return 27
  end
  0
end
