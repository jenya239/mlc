import { theme_default } from '../theme'
import { text_shaping_new } from '../../gui/text_shaping'
import {
  TextLayout,
  text_layout_build,
  text_layout_cache_new,
  wrap_width_none,
  wrap_width_pixels
} from '../text_layout'
import {
  text_layout_caret_point,
  text_layout_caret_x,
  text_layout_index_at,
  text_layout_selection_rects
} from '../text_layout_hit'
import {
  text_layout_line_end_target,
  text_layout_line_of_byte
} from '../text_layout_lines'

fn prefix_width(layout: TextLayout) -> i32 = do
  let mut width = 0
  let mut cluster_index = 0
  while cluster_index < layout.clusters.length() do
    const cluster = layout.clusters[cluster_index]
    if cluster.byte_offset < 2 then
      width = width + cluster.width
    end
    cluster_index = cluster_index + 1
  end
  width
end

fn main() -> i32 = do
  const theme = theme_default()
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  const sample = "ab cd\n\nef gh"

  const plain = text_layout_build(shaping, cache, theme, sample, wrap_width_none())
  shaping = plain.shaping
  cache = plain.cache
  const wrapped = text_layout_build(
    shaping, cache, theme, sample, wrap_width_pixels(prefix_width(plain.layout) + 1)
  )
  shaping = wrapped.shaping
  cache = wrapped.cache
  const layout = wrapped.layout
  if layout.lines.length() < 4 then
    return -1
  end
  const first = layout.lines[0]
  if first.byte_end <= first.byte_start || layout.text.byte_at(first.byte_end - 1) != " " then
    return -2
  end
  const second = layout.lines[1]
  if second.byte_end >= layout.text.byte_size() || layout.text.byte_at(second.byte_end) != "\n" then
    return -3
  end
  const blank = layout.lines[2]
  if blank.byte_start != blank.byte_end then
    return -4
  end

  let mut line_index = 0
  while line_index < 3 do
    const line = layout.lines[line_index]
    const hit = text_layout_index_at(layout, 0, line.top)
    if hit != line.byte_start then
      return -5
    end
    line_index = line_index + 1
  end

  const hard_hit = text_layout_index_at(layout, second.width + 8, second.top)
  if layout.text.byte_at(hard_hit) != "\n" then
    return -6
  end
  if hard_hit != text_layout_line_end_target(layout, 1) then
    return -7
  end

  const soft_hit = text_layout_index_at(layout, first.width + 8, first.top)
  if soft_hit != first.byte_end - 1 || layout.text.byte_at(soft_hit) != " " then
    return -8
  end

  if text_layout_line_of_byte(layout, second.byte_start) != 1 then
    return -9
  end

  const origin = text_layout_caret_point(layout, 0)
  if origin.y != 0 || origin.x != 0 then
    return -10
  end
  const third = text_layout_caret_point(layout, blank.byte_start)
  if third.y != first.height * 2 then
    return -11
  end

  const after_blank = layout.lines[3]
  const boxes = text_layout_selection_rects(layout, second.byte_start, after_blank.byte_start + 1)
  if boxes.length() != 3 then
    return -12
  end
  if boxes[0].y >= boxes[1].y || boxes[1].y >= boxes[2].y then
    return -13
  end
  if boxes[0].width <= 0 || boxes[1].width <= 0 || boxes[2].width <= 0 then
    return -14
  end

  const trailing = text_layout_build(shaping, cache, theme, "a\n", wrap_width_none())
  shaping = trailing.shaping
  cache = trailing.cache
  const end_index = trailing.layout.text.byte_size()
  if text_layout_line_of_byte(trailing.layout, end_index) != 1 then
    return -15
  end
  if text_layout_caret_x(trailing.layout, end_index) != 0 then
    return -16
  end
  const end_point = text_layout_caret_point(trailing.layout, end_index)
  if end_point.x != 0 || end_point.y != trailing.layout.lines[1].top then
    return -17
  end

  const hello_built = text_layout_build(shaping, cache, theme, "hello", wrap_width_none())
  const hello = hello_built.layout
  if text_layout_index_at(hello, 0, 0) != 0 then
    return -18
  end
  if text_layout_index_at(hello, hello.pixel_width + 8, 0) != hello.text.byte_size() then
    return -19
  end
  const hello_boxes = text_layout_selection_rects(hello, 0, hello.text.byte_size())
  if hello_boxes.length() != 1 || hello_boxes[0].width <= 0 then
    return -20
  end
  if text_layout_caret_x(hello, 0) != 0 then
    return -21
  end
  0
end
