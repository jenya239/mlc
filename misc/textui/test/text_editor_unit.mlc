import { text_document_from_bytes, text_document_line, text_document_line_count, text_document_to_bytes } from '../text_document'
import { text_line_index_of_identifier } from '../text_line_index'
import { rect_new } from '../geometry'
import { Theme, theme_default } from '../theme'
import {
  text_editor_choice,
  text_editor_closed,
  text_editor_closes,
  text_editor_on_input,
  text_editor_open_document,
  text_editor_opens
} from '../text_editor'
import { text_editor_bar_visible, text_editor_pointer } from '../text_editor_pointer'
import { editor_whitespace_color, paint_editor_line_number, paint_editor_whitespace, text_editor_gutter_width, text_editor_text_x } from '../text_editor_gutter'
import { paint_editor_line_text, syntax_comment_color, text_editor_highlight_advance } from '../text_editor_highlight'
import { text_highlight_line, text_highlight_mode_before } from '../text_highlight'
import { text_view_selection_spans } from '../text_view_selection'
import { text_view_maximum_anchor } from '../text_view_state'
import { DrawOp } from '../draw_op'
import { UiInput } from '../ui_input'

fn font_path() -> string = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

fn input_with(text: string, binding_key: string, control_down: bool, backspace_pressed: bool) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: control_down,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: 0,
    text: text,
    binding_key: binding_key,
    shift_down: false,
    backspace_pressed: backspace_pressed,
    enter_pressed: false,
    paste_text: ""
  }

fn pointer_input(mouse_x: i32, mouse_y: i32, left_pressed: bool, left_down: bool, shift_down: bool) -> UiInput =
  UiInput {
    mouse_x: mouse_x,
    mouse_y: mouse_y,
    left_pressed: left_pressed,
    left_down: left_down,
    left_released: false,
    control_down: false,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: 0,
    text: "",
    binding_key: "",
    shift_down: shift_down,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }

fn wheel_input(wheel_y: i32) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: false,
    copy_pressed: false,
    wheel_y: wheel_y,
    now_ms: 0,
    text: "",
    binding_key: "",
    shift_down: false,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }

fn repeated_lines(count: i32) -> string = do
  let mut text = ""
  let mut index = 0
  while index < count do
    text = text + "abcdef\n"
    index = index + 1
  end
  text
end

fn fill_matches(operations: [DrawOp], width: i32, height: i32, alpha: f64) -> bool = do
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpFillRect(data) => data.rect.width == width && data.rect.height == height && data.color.alpha == alpha
      | OpText(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      return true
    end
    index = index + 1
  end
  false
end

fn fill_bar(operations: [DrawOp], alpha: f64) -> bool = do
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpFillRect(data) => data.rect.height == 1 && data.rect.width > 2 && data.color.alpha == alpha
      | OpText(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      return true
    end
    index = index + 1
  end
  false
end

fn text_matches(operations: [DrawOp], text: string, red: f64) -> bool = do
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpText(data) => data.text == text && data.color.red == red
      | OpFillRect(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      return true
    end
    index = index + 1
  end
  false
end

fn comment_painted(operations: [DrawOp], theme: Theme) -> bool = do
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpText(text) => text.text.index_of("//") == 0 && text.color.red == syntax_comment_color().red
      | OpFillRect(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      return true
    end
    index = index + 1
  end
  false
end

fn main() -> i32 = do
  const keep = text_editor_choice(false, "", false, true, false, "Makefile", "/tmp/Makefile")
  if text_editor_opens(keep) || text_editor_closes(keep) then
    return 1
  end
  const opened = text_editor_choice(false, "", true, true, false, "README", "/tmp/README")
  if text_editor_opens(opened) == false then
    return 2
  end
  const same = text_editor_choice(true, "/tmp/README", true, true, false, "README", "/tmp/README")
  if text_editor_opens(same) || text_editor_closes(same) then
    return 3
  end
  const closed = text_editor_choice(true, "/tmp/README", true, true, false, "clip.mp4", "")
  if text_editor_closes(closed) == false then
    return 4
  end
  const inside = text_editor_choice(true, "/tmp/README", true, true, true, "clip.mp4", "")
  if text_editor_opens(inside) || text_editor_closes(inside) then
    return 5
  end
  const outside = text_editor_choice(true, "/tmp/README", true, false, false, "clip.mp4", "")
  if text_editor_closes(outside) then
    return 6
  end
  const editor = text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "/home/jenya/workspaces/current/mlc/tmp/text_editor_unit_note.txt",
    text_document_from_bytes("ab"),
    64,
    16,
    font_path(),
    16
  )
  if editor.open == false || text_document_line(editor.document, 0).text != "ab" then
    return 7
  end
  const inserted = text_editor_on_input(editor, input_with("Z", "", false, false), false, false, "")
  if text_document_line(inserted.document, 0).text != "Zab" then
    return 8
  end
  const saved = text_editor_on_input(inserted, input_with("s", "s", true, false), false, false, "")
  if text_document_line(saved.document, 0).text != "Zab" then
    return 9
  end
  const removed = text_editor_on_input(inserted, input_with("", "", false, true), false, false, "")
  if text_document_line(removed.document, 0).text != "ab" then
    return 10
  end
  const ignored = text_editor_on_input(inserted, input_with("Q", "", false, false), true, false, "")
  if text_document_line(ignored.document, 0).text != "Zab" then
    return 11
  end
  if text_editor_bar_visible(editor) then
    return 12
  end
  const theme = theme_default()
  const long_band = rect_new(10, 20, 200, 48)
  const long_editor = text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "",
    text_document_from_bytes(repeated_lines(20)),
    48,
    16,
    font_path(),
    16
  )
  if text_editor_bar_visible(long_editor) == false || text_document_line_count(long_editor.document) != 20 then
    return 13
  end
  const bar_x = long_band.x + long_band.width - theme.scrollbar_width
  const scrolled = text_editor_pointer(
    long_editor,
    long_band,
    theme,
    16,
    pointer_input(bar_x, long_band.y + long_band.height - 1, true, true, false)
  )
  const scrolled_anchor = text_line_index_of_identifier(scrolled.document.line_index, scrolled.view.anchor_line_identifier)
  if scrolled_anchor != text_view_maximum_anchor(scrolled.view, scrolled.document) then
    return 14
  end
  if scrolled.view.caret_line_identifier != long_editor.view.caret_line_identifier || scrolled.view.caret_byte != 0 then
    return 15
  end
  const wheeled = text_editor_on_input(long_editor, wheel_input(1), false, false, "")
  const wheeled_anchor = text_line_index_of_identifier(wheeled.document.line_index, wheeled.view.anchor_line_identifier)
  if wheeled_anchor != 1 then
    return 16
  end
  const capped = text_editor_on_input(wheeled, wheel_input(100), false, false, "")
  const capped_anchor = text_line_index_of_identifier(capped.document.line_index, capped.view.anchor_line_identifier)
  if capped_anchor != text_view_maximum_anchor(capped.view, capped.document) then
    return 17
  end
  const upward = text_editor_on_input(long_editor, wheel_input(0 - 3), false, false, "")
  if text_line_index_of_identifier(upward.document.line_index, upward.view.anchor_line_identifier) != 0 then
    return 18
  end
  const select_band = rect_new(10, 20, 240, 64)
  const source = text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "",
    text_document_from_bytes("abcdef\nabcdef\nzzzz"),
    64,
    16,
    font_path(),
    16
  )
  const origin_x = text_editor_text_x(select_band.x, theme, text_document_line_count(source.document))
  const origin_y = select_band.y + theme.padding
  const pressed = text_editor_pointer(source, select_band, theme, 16, pointer_input(origin_x, origin_y, true, true, false))
  if pressed.view.caret_byte != 0 || pressed.view.bound_byte != 0 then
    return 19
  end
  const dragged = text_editor_pointer(
    pressed,
    select_band,
    theme,
    16,
    pointer_input(origin_x + 40, origin_y + 16, false, true, false)
  )
  if dragged.view.bound_line_identifier == dragged.view.caret_line_identifier then
    return 20
  end
  if dragged.view.caret_byte == 0 then
    return 21
  end
  const spans = text_view_selection_spans(dragged.view, dragged.document)
  if spans.length() < 2 || spans[0].right <= spans[0].left then
    return 22
  end
  const deleted = text_editor_on_input(dragged, input_with("", "", false, true), false, false, "")
  const before = text_document_to_bytes(dragged.document)
  const after = text_document_to_bytes(deleted.document)
  if before.accepted == false || after.accepted == false || after.bytes.byte_size() >= before.bytes.byte_size() then
    return 23
  end
  if after.bytes.index_of("zzzz") < 0 || after.bytes.index_of("abcdef\nabcdef") >= 0 then
    return 24
  end
  const released = text_editor_pointer(pressed, select_band, theme, 16, pointer_input(origin_x, origin_y, false, false, false))
  const shifted = text_editor_pointer(
    released,
    select_band,
    theme,
    16,
    pointer_input(origin_x + 40, origin_y, true, true, true)
  )
  if shifted.view.bound_byte != 0 || shifted.view.caret_byte == 0 then
    return 25
  end
  if text_view_selection_spans(shifted.view, shifted.document).length() != 1 then
    return 26
  end
  const comment_editor = text_editor_highlight_advance(text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "",
    text_document_from_bytes("alpha // note"),
    64,
    16,
    font_path(),
    16
  ))
  const comment_line = text_document_line(comment_editor.document, 0)
  const comment_mode = text_highlight_mode_before(comment_editor.highlight, 0)
  const comment_spans = text_highlight_line(comment_line.text, comment_mode.mode_out)
  if comment_mode.stored == false || comment_spans.spans.length() != 1 || comment_spans.spans[0].start_offset != 6 then
    return 27
  end
  let mut comment_operations: [DrawOp] = []
  comment_operations = paint_editor_line_text(comment_operations, theme, comment_editor, comment_line, 0, 0, 0)
  if comment_painted(comment_operations, theme) == false then
    return 28
  end
  const block_editor = text_editor_highlight_advance(text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "",
    text_document_from_bytes("/*\nstill\n*/\ncode"),
    80,
    16,
    font_path(),
    16
  ))
  const block_inside = text_highlight_line(
    text_document_line(block_editor.document, 1).text,
    text_highlight_mode_before(block_editor.highlight, 1).mode_out
  )
  const trailing_code = text_highlight_line(
    text_document_line(block_editor.document, 3).text,
    text_highlight_mode_before(block_editor.highlight, 3).mode_out
  )
  if text_highlight_mode_before(block_editor.highlight, 1).stored == false || block_inside.spans.length() != 1 then
    return 29
  end
  if trailing_code.spans.length() != 0 then
    return 30
  end
  const edited = text_editor_on_input(comment_editor, input_with("Z", "", false, false), false, false, "")
  if edited.highlight.watermark != 0 then
    return 31
  end
  if text_editor_gutter_width(theme, 100) <= text_editor_gutter_width(theme, 9) then
    return 32
  end
  const spaced = text_editor_open_document(
    text_editor_closed(font_path(), 16),
    "spaced.txt",
    text_document_from_bytes("a b\n\t"),
    64,
    16,
    font_path(),
    16
  )
  let mut marks: [DrawOp] = []
  marks = paint_editor_whitespace(marks, spaced, text_document_line(spaced.document, 0), 0, 0, 16)
  marks = paint_editor_whitespace(marks, spaced, text_document_line(spaced.document, 1), 0, 16, 16)
  marks = paint_editor_line_number(marks, theme, 0, 0, 0, 2)
  if fill_matches(marks, 2, 2, editor_whitespace_color().alpha) == false then
    return 33
  end
  if fill_bar(marks, editor_whitespace_color().alpha) == false then
    return 34
  end
  if text_matches(marks, "1", theme.muted.red) == false then
    return 35
  end
  0
end
