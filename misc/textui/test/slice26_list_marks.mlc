import { get_or } from 'Env'
import { Theme, theme_default } from '../theme'
import {
  BoxData,
  DirectionColumn,
  ListData,
  OverflowVisible,
  WidgetKind,
  WidgetStore,
  field_data_new,
  widget_id_none,
  widget_store_add_box,
  widget_store_add_list_view,
  widget_store_add_scroll_view,
  widget_store_add_text_field,
  widget_store_empty
} from '../store'
import { text_shaping_new } from '../../gui/text_shaping'
import { text_layout_cache_new } from '../text_layout'
import { layout_ui } from '../layout_pass'
import { paint_ui_frame } from '../paint_pass'
import { ui_state_new, ui_state_with_list_selected } from '../ui_state'
import { UiEvent, ui_event_row_activated } from '../ui_event'
import { UiInput } from '../ui_input'
import { ui_update } from '../ui_update'
import { DrawOp } from '../draw_op'
import { list_row_height, list_row_marked, list_selected_at, list_selected_put } from '../widget_list'
import { list_replace_marks } from '../list_marks'
import { file_clipboard_offer, file_clipboard_public, file_clipboard_transfer } from '../file_clipboard'
import { file_clipboard_paste } from '../file_clipboard_os'
import { attach_file_menu, menu_apply, menu_list_id, menu_open } from '../menu'
import { DialogTarget } from '../dialog'
import { open_as_host } from '../open_as'
import { open_as_image_mark, open_as_image_name, open_as_image_path } from '../open_as_pin'

extern fn create_directories(path: string) -> bool
  = "mlc::file::create_directories_value" from "mlc/io/file_abi.hpp" blocking
extern fn write_string(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking

fn column_data() -> BoxData =
  BoxData { direction: DirectionColumn, padding: 0, gap: 0 }

fn names() -> [string] = do
  let mut texts: [string] = []
  texts.push("..")
  texts.push("a")
  texts.push("b")
  texts.push("c")
  texts
end

fn build_list() -> WidgetStore = do
  let mut store = widget_store_empty()
  store = widget_store_add_scroll_view(store, widget_id_none(), 1, true)
  widget_store_add_list_view(store, store.root, ListData { texts: names() }, 0, true)
end

fn pointer(
  x: i32,
  y: i32,
  pressed: bool,
  down: bool,
  now_ms: i32,
  control_down: bool,
  shift_down: bool
) -> UiInput =
  UiInput {
    mouse_x: x,
    mouse_y: y,
    left_pressed: pressed,
    left_down: down,
    left_released: false,
    control_down: control_down,
    copy_pressed: false,
    wheel_y: 0,
    now_ms: now_ms,
    text: "",
    binding_key: "",
    shift_down: shift_down,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }

fn keys(binding_key: string, control_down: bool, copy_pressed: bool) -> UiInput =
  UiInput {
    mouse_x: 0,
    mouse_y: 0,
    left_pressed: false,
    left_down: false,
    left_released: false,
    control_down: control_down,
    copy_pressed: copy_pressed,
    wheel_y: 0,
    now_ms: 0,
    text: "",
    binding_key: binding_key,
    shift_down: false,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }

fn fill_count(operations: [DrawOp], red: f64) -> i32 = do
  let mut count = 0
  let mut index = 0
  while index < operations.length() do
    const found = match operations[index]
      | OpFillRect(data) => data.color.red == red
      | OpText(_) => false
      | OpStrokeRect(_) => false
      | OpPushClip(_) => false
      | OpPopClip => false
    if found then
      count = count + 1
    end
    index = index + 1
  end
  count
end

fn menu_texts(store: WidgetStore) -> [string] = do
  const list_id = menu_list_id(store)
  const texts = match store.nodes[list_id.index].kind
    | KindListView(data) => data.texts
    | KindBox(_) => []
    | KindLabel(_) => []
    | KindIcon(_) => []
    | KindButton(_) => []
    | KindCheckbox(_) => []
    | KindScrollView => []
    | KindSplitter(_) => []
    | KindTextField(_) => []
  texts
end

fn selection_cases() -> i32 = do
  const theme = theme_default()
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  let mut ratios: [i32] = []
  let mut offsets: [i32] = []
  const store = build_list()
  const laid = layout_ui(store, theme, shaping, cache, 200, 160, offsets, ratios)
  shaping = laid.shaping
  cache = laid.cache
  const list = store.nodes[1].id
  const rect = laid.layout.rects[list.index]
  const row_height = list_row_height(theme)
  const row_y = rect.y + 1
  const pressed = ui_update(
    store, laid.layout, theme, ui_state_new(),
    pointer(rect.x + 4, row_y + row_height, true, true, 0, false, false)
  )
  if list_selected_at(pressed.state.list_selected, list.index) != 1 then
    return 0 - 1
  end
  const added = ui_update(
    store, laid.layout, theme, pressed.state,
    pointer(rect.x + 4, row_y + row_height * 3, true, true, 800, true, false)
  )
  if list_row_marked(added.state.list_marks, list.index, 1, 0 - 1) == false then
    return 0 - 2
  end
  if list_row_marked(added.state.list_marks, list.index, 3, 0 - 1) == false then
    return 0 - 3
  end
  if list_selected_at(added.state.list_selected, list.index) != 3 then
    return 0 - 3
  end
  const ranged = ui_update(
    store, laid.layout, theme, pressed.state,
    pointer(rect.x + 4, row_y + row_height * 3, true, true, 1600, false, true)
  )
  if list_row_marked(ranged.state.list_marks, list.index, 2, 0 - 1) == false then
    return 0 - 4
  end
  const dragged = ui_update(
    store, laid.layout, theme, pressed.state,
    pointer(rect.x + 4, row_y + row_height * 2, false, true, 2000, false, false)
  )
  if list_selected_at(dragged.state.list_selected, list.index) != 2 then
    return 0 - 5
  end
  if list_row_marked(dragged.state.list_marks, list.index, 1, 0 - 1) then
    return 0 - 5
  end
  const covered = ui_update(store, laid.layout, theme, pressed.state, keys("a", true, false))
  if list_row_marked(covered.state.list_marks, list.index, 0, 0 - 1) then
    return 0 - 6
  end
  if list_row_marked(covered.state.list_marks, list.index, 1, 0 - 1) == false then
    return 0 - 6
  end
  if list_row_marked(covered.state.list_marks, list.index, 3, 0 - 1) == false then
    return 0 - 6
  end
  const painted = paint_ui_frame(theme, store, laid.layout, added.state)
  if fill_count(painted, theme.list_inactive.red) < 2 then
    return 0 - 7
  end
  0
end

fn clipboard_cases() -> i32 = do
  const root = get_or("TMPDIR", "/tmp") + "/mlc_list_clip"
  const source = root + "/src"
  const destination = root + "/dst"
  if create_directories(source) == false || create_directories(destination) == false then
    return 0 - 8
  end
  if write_string(source + "/note.txt", "hello") == false then
    return 0 - 8
  end
  if write_string(source + "/moved.txt", "moved") == false then
    return 0 - 8
  end
  let mut store = widget_store_empty()
  store = widget_store_add_box(store, widget_id_none(), column_data(), OverflowVisible, 0, true)
  store = widget_store_add_text_field(store, store.root, field_data_new(source), 0, true)
  store = widget_store_add_list_view(
    store, store.root, ListData { texts: ["note.txt", "moved.txt"] }, 0, true
  )
  const list = store.nodes[store.nodes.length() - 1].id
  let mut state = list_replace_marks(ui_state_new(), list.index, 0)
  state = file_clipboard_offer(store, state, keys("c", true, true))
  if file_clipboard_public(state.clipboard.clipboard) != source + "/note.txt" then
    return 0 - 9
  end
  const copied = file_clipboard_transfer(root, destination, source + "/note.txt", false)
  if copied != 1 || read_to_string(destination + "/note.txt") != "hello" then
    return 0 - 10
  end
  const moved = file_clipboard_transfer(root, destination, source + "/moved.txt", true)
  if moved != 1 || read_to_string(destination + "/moved.txt") != "moved" then
    return 0 - 11
  end
  if read_to_string(source + "/moved.txt") != "" then
    return 0 - 11
  end
  const pasted = file_clipboard_paste(
    store,
    state,
    root,
    "mlc-file-copy\n" + source + "/note.txt"
  )
  if pasted.state.listing_revision < 1 then
    return 0 - 16
  end
  if read_to_string(source + "/note copy.txt") != "hello" then
    return 0 - 16
  end
  0
end

fn menu_cases() -> i32 = do
  if open_as_image_name("shot.png") == false || open_as_image_name("note.txt") then
    return 0 - 12
  end
  if open_as_image_path(open_as_image_mark("/tmp/shot.png")) != "/tmp/shot.png" then
    return 0 - 12
  end
  const opened = menu_open(attach_file_menu(widget_store_empty()), ui_state_new(), 8, 8)
  const list_id = menu_list_id(opened.store)
  const texts = menu_texts(opened.store)
  if texts.length() != 5 || texts[4] != "Open as" then
    return 0 - 13
  end
  const state = ui_state_with_list_selected(
    opened.state,
    list_selected_put(opened.state.list_selected, list_id.index, 4)
  )
  let mut events: [UiEvent] = []
  events.push(ui_event_row_activated(list_id))
  const kept = menu_apply(opened.store, state, events)
  if kept.state.overlay_open == false then
    return 0 - 14
  end
  const hosted = open_as_host(
    kept.store,
    kept.state,
    events,
    DialogTarget { list_index: 0, row: 0 },
    ""
  )
  const modes = menu_texts(hosted.store)
  if modes.length() != 2 || modes[0] != "Text" || modes[1] != "Image" then
    return 0 - 15
  end
  if hosted.state.overlay_open == false then
    return 0 - 15
  end
  0
end

fn main() -> i32 = do
  const selected = selection_cases()
  if selected != 0 then
    return selected
  end
  const copied = clipboard_cases()
  if copied != 0 then
    return copied
  end
  menu_cases()
end
