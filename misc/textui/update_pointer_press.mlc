import { Theme } from './theme'
import { WidgetStore, WidgetId, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { hit_test } from './hit'
import { kind_is_text_selectable } from './user_select'
import { label_index_at, label_word_range } from './widget_label'
import { Selection, selection_none } from './selection'
import { selection_publish_primary } from './selection_text'
import { pointer_double_click_ms, pointer_past_slop } from './pointer_slop'
import {
  UiState,
  PointerDrag,
  LastPress,
  ui_state_with
} from './ui_state'
import { UiInput } from './ui_input'

fn press_count(state: UiState, owner: WidgetId, x: i32, y: i32, now_ms: i32) -> i32 =
  match state.last_press
    | LastPressNone => 1
    | LastPressSome(previous) => do
      if previous.owner.index != owner.index then
        return 1
      end
      if now_ms - previous.time_ms > pointer_double_click_ms() then
        return 1
      end
      if pointer_past_slop(previous.x, previous.y, x, y) then
        return 1
      end
      previous.count + 1
    end

fn begin_text_press(
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  owner: WidgetId,
  input: UiInput
) -> UiState = do
  const count = press_count(state, owner, input.mouse_x, input.mouse_y, input.now_ms)
  const last_press = LastPressSome(LastPress {
    owner: owner,
    x: input.mouse_x,
    y: input.mouse_y,
    time_ms: input.now_ms,
    count: count
  })
  if count >= 2 then
    const range = label_word_range(
      theme,
      layout.rects[owner.index],
      layout.text_layouts[owner.index],
      input.mouse_x,
      input.mouse_y
    )
    const selection = Selection { owner: owner, anchor: range.start, focus: range.finish }
    const drag = PointerDrag {
      owner: owner,
      origin_x: input.mouse_x,
      origin_y: input.mouse_y,
      anchor: range.start,
      claimed: true
    }
    const published = selection_publish_primary(layout, state, selection)
    return ui_state_with(
      selection,
      GrabText,
      PointerActive(drag),
      last_press,
      published.clipboard
    )
  end
  const index = label_index_at(
    theme,
    layout.rects[owner.index],
    layout.text_layouts[owner.index],
    input.mouse_x,
    input.mouse_y
  )
  const selection = Selection { owner: owner, anchor: index, focus: index }
  const drag = PointerDrag {
    owner: owner,
    origin_x: input.mouse_x,
    origin_y: input.mouse_y,
    anchor: index,
    claimed: false
  }
  ui_state_with(
    selection,
    GrabNone,
    PointerActive(drag),
    last_press,
    state.clipboard
  )
end

export fn handle_press(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState = do
  const hit = hit_test(store, layout, input.mouse_x, input.mouse_y)
  if widget_id_is_none(hit) then
    return ui_state_with(
      selection_none(),
      GrabNone,
      PointerIdle,
      state.last_press,
      state.clipboard
    )
  end
  const node = store.nodes[hit.index]
  if kind_is_text_selectable(node.kind) == false then
    return ui_state_with(
      selection_none(),
      GrabNone,
      PointerIdle,
      state.last_press,
      state.clipboard
    )
  end
  begin_text_press(layout, theme, state, hit, input)
end
