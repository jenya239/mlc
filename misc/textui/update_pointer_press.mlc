import { Theme } from './theme'
import {
  WidgetStore,
  WidgetId,
  widget_id_equals,
  widget_id_is_none,
  widget_id_none,
  kind_is_scroll_view,
  kind_is_list_view,
  kind_is_splitter,
  kind_is_text_field
} from './store'
import { LayoutResult } from './layout_result'
import { hit_test } from './hit'
import { kind_is_text_selectable, kind_is_clickable } from './user_select'
import { begin_scroll_press } from './update_scroll'
import { begin_list_press, list_press_count } from './update_list'
import { begin_split_press } from './update_split'
import { begin_field_press } from './update_field'
import { label_index_at, label_word_range } from './widget_label'
import { Selection, selection_none } from './selection'
import { selection_publish_primary } from './selection_text'
import { pointer_double_click_ms, pointer_past_slop } from './pointer_slop'
import { begin_click_press } from './update_pointer_click'
import { menu_list_id } from './menu'
import {
  UiState,
  PointerDrag,
  LastPress,
  grab_is_none,
  ui_state_with,
  ui_state_with_field
} from './ui_state'
import { UiInput } from './ui_input'

fn press_count(state: UiState, owner: WidgetId, x: i32, y: i32, now_ms: i32) -> i32 =
  match state.last_press
    | LastPressNone => 1
    | LastPressSome(previous) => do
      if previous.owner.index != owner.index then
        return 1
      end
      if now_ms - previous.time_ms > pointer_double_click_ms() then
        return 1
      end
      if pointer_past_slop(previous.x, previous.y, x, y) then
        return 1
      end
      previous.count + 1
    end

fn begin_text_press(
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  owner: WidgetId,
  input: UiInput
) -> UiState = do
  const count = press_count(state, owner, input.mouse_x, input.mouse_y, input.now_ms)
  const last_press = LastPressSome(LastPress {
    owner: owner,
    x: input.mouse_x,
    y: input.mouse_y,
    time_ms: input.now_ms,
    count: count
  })
  if count >= 3 then
    const limit = layout.text_layouts[owner.index].text.byte_size()
    const selection = Selection { owner: owner, anchor: 0, focus: limit }
    const drag = PointerDrag {
      owner: owner,
      origin_x: input.mouse_x,
      origin_y: input.mouse_y,
      anchor: 0,
      mark: limit,
      claimed: false,
      granularity: DragGranularityChar
    }
    const published = selection_publish_primary(layout, state, selection)
    return ui_state_with(
      published,
      selection,
      GrabNone,
      PointerText(drag),
      last_press,
      published.clipboard,
      published.hover
    )
  end
  if count >= 2 then
    const range = label_word_range(
      theme,
      layout.rects[owner.index],
      layout.text_layouts[owner.index],
      input.mouse_x,
      input.mouse_y
    )
    const selection = Selection { owner: owner, anchor: range.start, focus: range.finish }
    const drag = PointerDrag {
      owner: owner,
      origin_x: input.mouse_x,
      origin_y: input.mouse_y,
      anchor: range.start,
      mark: range.finish,
      claimed: true,
      granularity: DragGranularityWord
    }
    const published = selection_publish_primary(layout, state, selection)
    return ui_state_with(
      published,
      selection,
      GrabText,
      PointerText(drag),
      last_press,
      published.clipboard,
      published.hover
    )
  end
  const index = label_index_at(
    theme,
    layout.rects[owner.index],
    layout.text_layouts[owner.index],
    input.mouse_x,
    input.mouse_y
  )
  const selection = Selection { owner: owner, anchor: index, focus: index }
  const drag = PointerDrag {
    owner: owner,
    origin_x: input.mouse_x,
    origin_y: input.mouse_y,
    anchor: index,
    mark: index,
    claimed: false,
    granularity: DragGranularityChar
  }
  ui_state_with(
    state,
    selection,
    GrabNone,
    PointerText(drag),
    last_press,
    state.clipboard,
    state.hover
  )
end

fn release_focus(state: UiState) -> UiState =
  ui_state_with_field(state, widget_id_none(), state.field_caret, state.field_scroll_x)

fn clear_pointer(state: UiState) -> UiState =
  ui_state_with(
    state,
    selection_none(),
    GrabNone,
    PointerIdle,
    state.last_press,
    state.clipboard,
    state.hover
  )

export fn handle_press(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState = do
  const hit = hit_test(store, layout, theme, input.mouse_x, input.mouse_y)
  if widget_id_is_none(hit) then
    return release_focus(clear_pointer(state))
  end
  const node = store.nodes[hit.index]
  if widget_id_is_none(store.overlay) == false && hit.index == store.overlay.index then
    return release_focus(begin_click_press(state, hit, input))
  end
  if store.placed && widget_id_equals(hit, menu_list_id(store)) then
    return release_focus(begin_click_press(state, hit, input))
  end
  if kind_is_text_field(node.kind) then
    return begin_field_press(
      layout,
      theme,
      state,
      hit,
      input,
      press_count(state, hit, input.mouse_x, input.mouse_y, input.now_ms)
    )
  end
  if kind_is_text_selectable(node.kind) then
    return begin_text_press(layout, theme, state, hit, input)
  end
  if kind_is_clickable(node.kind) then
    return release_focus(begin_click_press(state, hit, input))
  end
  if kind_is_scroll_view(node.kind) then
    const scrolled = begin_scroll_press(store, layout, theme, state, input, hit)
    if grab_is_none(scrolled.grab) == false then
      return release_focus(scrolled)
    end
  end
  if kind_is_list_view(node.kind) then
    return release_focus(begin_list_press(
      store,
      layout,
      theme,
      state,
      input,
      hit,
      list_press_count(store, layout, theme, state, hit, input.mouse_y, input.now_ms)
    ))
  end
  if kind_is_splitter(node.kind) then
    return release_focus(begin_split_press(store, layout, theme, state, input, hit))
  end
  return release_focus(clear_pointer(state))
end
