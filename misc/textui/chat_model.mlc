export type ChatRole = RoleUser | RoleAssistant

export type ChatMessage = {
  role: ChatRole,
  text: string,
  failed: bool,
  provider: string,
  model_name: string
}

export type ReplyOutcome = ReplyText(string) | ReplyFailed(string)

export type ChatModel = {
  messages: [ChatMessage],
  pending: bool,
  generation: i32,
  revision: i32
}

export type ChatSubmit = {
  model: ChatModel,
  accepted: bool
}

export fn chat_model_new() -> ChatModel = do
  let mut messages: [ChatMessage] = []
  ChatModel {
    messages: messages,
    pending: false,
    generation: 0,
    revision: 0
  }
end

export fn chat_submit(model: ChatModel, text: string) -> ChatSubmit = do
  const trimmed = text.trim()
  if trimmed.byte_size() == 0 || model.pending then
    return ChatSubmit { model: model, accepted: false }
  end
  let mut messages = model.messages
  messages.push(ChatMessage {
    role: RoleUser,
    text: trimmed,
    failed: false,
    provider: "",
    model_name: ""
  })
  ChatSubmit {
    model: ChatModel {
      messages: messages,
      pending: true,
      generation: model.generation + 1,
      revision: model.revision + 1
    },
    accepted: true
  }
end

fn last_user_message(messages: [ChatMessage]) -> ChatMessage = do
  let mut found = ChatMessage {
    role: RoleUser,
    text: "",
    failed: false,
    provider: "",
    model_name: ""
  }
  let mut index = 0
  while index < messages.length() do
    const user = match messages[index].role
      | RoleUser => true
      | RoleAssistant => false
    if user then
      found = messages[index]
    end
    index = index + 1
  end
  found
end

fn assistant_message(text: string, failed: bool, messages: [ChatMessage]) -> ChatMessage = do
  const sent = last_user_message(messages)
  ChatMessage {
    role: RoleAssistant,
    text: text,
    failed: failed,
    provider: sent.provider,
    model_name: sent.model_name
  }
end

export fn chat_stamp_submission(
  model: ChatModel,
  provider: string,
  model_name: string
) -> ChatModel = do
  const count = model.messages.length()
  if count == 0 || model.pending == false then
    return model
  end
  const last = model.messages[count - 1]
  const user = match last.role
    | RoleUser => true
    | RoleAssistant => false
  if user == false then
    return model
  end
  let mut messages = model.messages
  messages.set(count - 1, ChatMessage {
    role: last.role,
    text: last.text,
    failed: last.failed,
    provider: provider,
    model_name: model_name
  })
  ChatModel {
    messages: messages,
    pending: model.pending,
    generation: model.generation,
    revision: model.revision
  }
end

export fn chat_apply_reply(
  model: ChatModel,
  generation: i32,
  outcome: ReplyOutcome
) -> ChatModel = do
  if generation != model.generation then
    return model
  end
  const reply = match outcome
    | ReplyText(text) => assistant_message(text, false, model.messages)
    | ReplyFailed(text) => assistant_message(text, true, model.messages)
  let mut messages = model.messages
  messages.push(reply)
  ChatModel {
    messages: messages,
    pending: false,
    generation: model.generation,
    revision: model.revision + 1
  }
end

export fn chat_cancel(model: ChatModel) -> ChatModel = do
  if model.pending then
    let mut messages = model.messages
    messages.push(assistant_message("Остановлено", true, model.messages))
    return ChatModel {
      messages: messages,
      pending: false,
      generation: model.generation + 1,
      revision: model.revision + 1
    }
  end
  model
end

export fn chat_clear(model: ChatModel) -> ChatModel = do
  let mut messages: [ChatMessage] = []
  ChatModel {
    messages: messages,
    pending: false,
    generation: model.generation + 1,
    revision: model.revision + 1
  }
end

fn messages_without_failed(messages: [ChatMessage]) -> [ChatMessage] = do
  let mut kept: [ChatMessage] = []
  let mut index = 0
  while index < messages.length() do
    if messages[index].failed then
    else
      kept.push(messages[index])
    end
    index = index + 1
  end
  kept
end

fn last_user_index(messages: [ChatMessage]) -> i32 = do
  let mut found = 0 - 1
  let mut index = 0
  while index < messages.length() do
    const user = match messages[index].role
      | RoleUser => true
      | RoleAssistant => false
    if user then
      found = index
    end
    index = index + 1
  end
  found
end

fn messages_text_length(messages: [ChatMessage]) -> i32 = do
  let mut total = 0
  let mut index = 0
  while index < messages.length() do
    total = total + messages[index].text.byte_size()
    index = index + 1
  end
  total
end

fn drop_oldest_except(messages: [ChatMessage], protected_index: i32) -> [ChatMessage] = do
  let mut result: [ChatMessage] = []
  let mut index = 0
  let mut removed = false
  while index < messages.length() do
    const keep = removed || index == protected_index
    if keep then
      result.push(messages[index])
    else
      removed = true
    end
    index = index + 1
  end
  result
end

export fn chat_history_for_request(
  model: ChatModel,
  maximum_characters: i32
) -> [ChatMessage] = do
  let mut kept = messages_without_failed(model.messages)
  while messages_text_length(kept) > maximum_characters do
    const protected_index = last_user_index(kept)
    const next = drop_oldest_except(kept, protected_index)
    if next.length() == kept.length() then
      break
    end
    kept = next
  end
  kept
end
