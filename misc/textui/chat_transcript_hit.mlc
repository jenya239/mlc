import { Theme } from './theme'
import { ChatModel } from './chat_model'
import { TextShapingState } from '../gui/text_shaping'
import {
  TextLayout,
  TextLayoutCache,
  text_layout_build,
  wrap_width_none,
  wrap_width_pixels
} from './text_layout'
import { text_layout_index_at } from './text_layout_hit'
import { Rect } from './geometry'
import {
  TranscriptView,
  transcript_content_limit,
  transcript_role_label
} from './chat_transcript_layout'

export type BodyLayout = {
  layout: TextLayout,
  top: i32,
  shaping: TextShapingState,
  cache: TextLayoutCache
}

fn clamp_index(index: i32, limit: i32) -> i32 = do
  if index < 0 then
    return 0
  end
  if index > limit then
    return limit
  end
  index
end

export fn transcript_block_at_y(view: TranscriptView, content_y: i32) -> i32 = do
  if content_y < 0 then
    return 0 - 1
  end
  let mut index = 0
  while index < view.index.tops.length() do
    const top = view.index.tops[index]
    const bottom = top + view.index.heights[index]
    if content_y >= top && content_y < bottom then
      return index
    end
    index = index + 1
  end
  0 - 1
end

fn message_body(
  model: ChatModel,
  view: TranscriptView,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  width: i32,
  message: i32
) -> BodyLayout = do
  if message < 0 || message >= model.messages.length() || message >= view.index.tops.length() then
    const empty = text_layout_build(shaping, cache, theme, "", wrap_width_none())
    return BodyLayout {
      layout: empty.layout,
      top: 0,
      shaping: empty.shaping,
      cache: empty.cache
    }
  end
  const entry = model.messages[message]
  const role = text_layout_build(
    shaping, cache, theme, transcript_role_label(entry.role), wrap_width_none()
  )
  const body = text_layout_build(
    role.shaping,
    role.cache,
    theme,
    entry.text,
    wrap_width_pixels(transcript_content_limit(theme, width))
  )
  BodyLayout {
    layout: body.layout,
    top: view.index.tops[message] + theme.padding + role.layout.pixel_height,
    shaping: body.shaping,
    cache: body.cache
  }
end

export fn transcript_index_in_message(
  model: ChatModel,
  view: TranscriptView,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  rect: Rect,
  scroll: i32,
  message: i32,
  mouse_x: i32,
  mouse_y: i32
) -> BodyLayout = do
  const placed = message_body(model, view, shaping, cache, theme, rect.width, message)
  const local_x = mouse_x - rect.x - theme.padding
  const local_y = mouse_y - rect.y + scroll - placed.top
  BodyLayout {
    layout: placed.layout,
    top: clamp_index(
      text_layout_index_at(placed.layout, local_x, local_y),
      placed.layout.text.byte_size()
    ),
    shaping: placed.shaping,
    cache: placed.cache
  }
end

export fn transcript_body_press_index(
  model: ChatModel,
  view: TranscriptView,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  rect: Rect,
  scroll: i32,
  mouse_x: i32,
  mouse_y: i32
) -> BodyLayout = do
  const content_y = mouse_y - rect.y + scroll
  const block = transcript_block_at_y(view, content_y)
  if block < 0 || block >= model.messages.length() then
    const empty = text_layout_build(shaping, cache, theme, "", wrap_width_none())
    return BodyLayout { layout: empty.layout, top: 0 - 1, shaping: empty.shaping, cache: empty.cache }
  end
  const placed = message_body(model, view, shaping, cache, theme, rect.width, block)
  const body_bottom = placed.top + placed.layout.pixel_height
  if content_y < placed.top || content_y >= body_bottom then
    return BodyLayout { layout: placed.layout, top: 0 - 1, shaping: placed.shaping, cache: placed.cache }
  end
  const local_x = mouse_x - rect.x - theme.padding
  const local_y = content_y - placed.top
  BodyLayout {
    layout: placed.layout,
    top: clamp_index(
      text_layout_index_at(placed.layout, local_x, local_y),
      placed.layout.text.byte_size()
    ),
    shaping: placed.shaping,
    cache: placed.cache
  }
end
