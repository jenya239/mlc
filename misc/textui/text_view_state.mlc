import { TextDocument, text_document_line, text_document_line_count } from './text_document'
import { text_line_index_of_identifier } from './text_line_index'
import { TextShapeCache, TextShapeRequest, text_shape_cache_empty, text_shape_cache_frame } from './text_shape_cache'

export type TextHoverToken = {
  line_identifier: i32,
  revision: i32,
  start_offset: i32,
  end_offset: i32,
  present: bool
}

export type TextCaretAffinity =
  AffinityDownstream
  | AffinityUpstream

export type TextViewState = {
  anchor_line_identifier: i32,
  anchor_vertical_offset: i32,
  viewport_height: i32,
  row_height: i32,
  horizontal_scroll: i32,
  content_width: i32,
  layout_height: i32,
  shape_cache: TextShapeCache,
  hover_token: TextHoverToken,
  caret_line_identifier: i32,
  caret_byte: i32,
  bound_line_identifier: i32,
  bound_byte: i32,
  caret_affinity: TextCaretAffinity,
  goal_x: i32,
  goal_x_present: bool
}

fn hover_token_absent() -> TextHoverToken = do
  TextHoverToken {
    line_identifier: 0,
    revision: 0,
    start_offset: 0,
    end_offset: 0,
    present: false
  }
end

fn empty_identifiers() -> [i32] = do
  let mut identifiers: [i32] = []
  identifiers
end

fn empty_requests() -> [TextShapeRequest] = do
  let mut requests: [TextShapeRequest] = []
  requests
end

export fn text_view_state_new(
  viewport_height: i32,
  row_height: i32,
  content_width: i32,
  font_path: string,
  pixel_size: i32
) -> TextViewState = do
  TextViewState {
    anchor_line_identifier: 0,
    anchor_vertical_offset: 0,
    viewport_height: viewport_height,
    row_height: row_height,
    horizontal_scroll: 0,
    content_width: content_width,
    layout_height: viewport_height,
    shape_cache: text_shape_cache_empty(font_path, pixel_size, 0, 4096),
    hover_token: hover_token_absent(),
    caret_line_identifier: 0,
    caret_byte: 0,
    bound_line_identifier: 0,
    bound_byte: 0,
    caret_affinity: AffinityDownstream,
    goal_x: 0,
    goal_x_present: false
  }
end

fn anchor_index(document: TextDocument, line_identifier: i32) -> i32 = do
  const found = text_line_index_of_identifier(document.line_index, line_identifier)
  const count = text_document_line_count(document)
  if found < 0 || found >= count then
    return 0
  end
  found
end

export fn text_view_visible_identifiers(state: TextViewState, document: TextDocument) -> [i32] = do
  let mut identifiers = empty_identifiers()
  if state.row_height <= 0 || state.viewport_height <= 0 then
    return identifiers
  end
  let mut index = anchor_index(document, state.anchor_line_identifier)
  let mut used = 0 - state.anchor_vertical_offset
  const count = text_document_line_count(document)
  while index < count && used < state.viewport_height do
    identifiers.push(text_document_line(document, index).line_identifier)
    used = used + state.row_height
    index = index + 1
  end
  identifiers
end

fn request_for_identifier(document: TextDocument, line_identifier: i32) -> TextShapeRequest = do
  const line = text_document_line(document, anchor_index(document, line_identifier))
  TextShapeRequest {
    line_identifier: line.line_identifier,
    revision: line.revision,
    token_revision: 0,
    text: line.text
  }
end

fn visible_requests(state: TextViewState, document: TextDocument) -> [TextShapeRequest] = do
  const identifiers = text_view_visible_identifiers(state, document)
  let mut requests = empty_requests()
  let mut index = 0
  while index < identifiers.length() do
    requests.push(request_for_identifier(document, identifiers[index]))
    index = index + 1
  end
  requests
end

fn entry_span(positions: [i32]) -> i32 = do
  if positions.length() == 0 then
    return 0
  end
  positions[positions.length() - 1]
end

fn grown_content_width(state: TextViewState, cache: TextShapeCache) -> i32 = do
  let mut width = state.content_width
  let mut index = 0
  while index < cache.entries.length() do
    const span = entry_span(cache.entries[index].boundary_positions)
    if span > width then
      width = span
    end
    index = index + 1
  end
  width
end

export fn text_view_frame(state: TextViewState, document: TextDocument) -> TextViewState = do
  const cache = text_shape_cache_frame(
    state.shape_cache,
    visible_requests(state, document),
    0,
    0 - 1,
    state.horizontal_scroll
  )
  TextViewState {
    anchor_line_identifier: state.anchor_line_identifier,
    anchor_vertical_offset: state.anchor_vertical_offset,
    viewport_height: state.viewport_height,
    row_height: state.row_height,
    horizontal_scroll: state.horizontal_scroll,
    content_width: grown_content_width(state, cache),
    layout_height: state.viewport_height,
    shape_cache: cache,
    hover_token: state.hover_token,
    caret_line_identifier: state.caret_line_identifier,
    caret_byte: state.caret_byte,
    bound_line_identifier: state.bound_line_identifier,
    bound_byte: state.bound_byte,
    caret_affinity: state.caret_affinity,
    goal_x: state.goal_x,
    goal_x_present: state.goal_x_present
  }
end

export fn text_view_page_rows(state: TextViewState) -> i32 = do
  if state.row_height < 1 || state.viewport_height < 1 then
    return 1
  end
  let mut rows = 0
  let mut used = 0
  while used < state.viewport_height do
    rows = rows + 1
    used = used + state.row_height
  end
  if rows < 1 then
    return 1
  end
  rows
end

export fn text_view_maximum_anchor(state: TextViewState, document: TextDocument) -> i32 = do
  const extra = text_document_line_count(document) - text_view_page_rows(state)
  if extra < 0 then
    return 0
  end
  extra
end

export fn text_view_with_viewport(state: TextViewState, viewport_height: i32) -> TextViewState = do
  if viewport_height < 1 || viewport_height == state.viewport_height then
    return state
  end
  TextViewState {
    anchor_line_identifier: state.anchor_line_identifier,
    anchor_vertical_offset: state.anchor_vertical_offset,
    viewport_height: viewport_height,
    row_height: state.row_height,
    horizontal_scroll: state.horizontal_scroll,
    content_width: state.content_width,
    layout_height: viewport_height,
    shape_cache: state.shape_cache,
    hover_token: state.hover_token,
    caret_line_identifier: state.caret_line_identifier,
    caret_byte: state.caret_byte,
    bound_line_identifier: state.bound_line_identifier,
    bound_byte: state.bound_byte,
    caret_affinity: state.caret_affinity,
    goal_x: state.goal_x,
    goal_x_present: state.goal_x_present
  }
end

export fn text_view_scroll_to_index(state: TextViewState, document: TextDocument, line_index: i32) -> TextViewState = do
  let mut next = line_index
  if next < 0 then
    next = 0
  end
  const maximum = text_view_maximum_anchor(state, document)
  if next > maximum then
    next = maximum
  end
  const current = anchor_index(document, state.anchor_line_identifier)
  if next == current && state.anchor_vertical_offset == 0 then
    return state
  end
  TextViewState {
    anchor_line_identifier: text_document_line(document, next).line_identifier,
    anchor_vertical_offset: 0,
    viewport_height: state.viewport_height,
    row_height: state.row_height,
    horizontal_scroll: state.horizontal_scroll,
    content_width: state.content_width,
    layout_height: state.layout_height,
    shape_cache: state.shape_cache,
    hover_token: state.hover_token,
    caret_line_identifier: state.caret_line_identifier,
    caret_byte: state.caret_byte,
    bound_line_identifier: state.bound_line_identifier,
    bound_byte: state.bound_byte,
    caret_affinity: state.caret_affinity,
    goal_x: state.goal_x,
    goal_x_present: state.goal_x_present
  }
end

export fn text_view_wheel(state: TextViewState, document: TextDocument, delta: i32) -> TextViewState = do
  if delta == 0 then
    return state
  end
  const count = text_document_line_count(document)
  if count <= 0 then
    return state
  end
  let mut next = anchor_index(document, state.anchor_line_identifier)
  if delta > 0 then
    next = next + 1
  else
    next = next - 1
  end
  if next < 0 then
    next = 0
  end
  if next >= count then
    next = count - 1
  end
  TextViewState {
    anchor_line_identifier: text_document_line(document, next).line_identifier,
    anchor_vertical_offset: 0,
    viewport_height: state.viewport_height,
    row_height: state.row_height,
    horizontal_scroll: state.horizontal_scroll,
    content_width: state.content_width,
    layout_height: state.viewport_height,
    shape_cache: state.shape_cache,
    hover_token: state.hover_token,
    caret_line_identifier: state.caret_line_identifier,
    caret_byte: state.caret_byte,
    bound_line_identifier: state.bound_line_identifier,
    bound_byte: state.bound_byte,
    caret_affinity: state.caret_affinity,
    goal_x: state.goal_x,
    goal_x_present: state.goal_x_present
  }
end
