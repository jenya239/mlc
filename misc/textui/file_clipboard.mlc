import { WidgetId, WidgetKind, WidgetStore, widget_id_is_none } from './store'
import { ClipboardBuffer, clipboard_set_clipboard } from './clipboard'
import { selection_is_empty } from './selection'
import { UiInput } from './ui_input'
import { UiState, ui_state_with } from './ui_state'
import { normalize_path, path_inside_jail } from './directory_jail'
import { join_path, strip_trailing_slash } from './directory_rows'
import { path_bar_current } from './path_bar'
import { list_marked_rows, list_marks_target } from './list_marks'

extern fn path_exists(path: string) -> bool
  = "mlc::file::exists_value" from "mlc/io/file_abi.hpp" blocking
extern fn path_is_directory(path: string) -> bool
  = "mlc::file::is_directory_value" from "mlc/io/file_abi.hpp" blocking
extern fn list_dir_names(path: string) -> [string]
  = "mlc::file::list_dir_names_value" from "mlc/io/file_abi.hpp" blocking
extern fn read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn write_string(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn rename_file(old_path: string, new_path: string) -> bool
  = "mlc::file::rename_file_value" from "mlc/io/file_abi.hpp" blocking
extern fn create_directories(path: string) -> bool
  = "mlc::file::create_directories_value" from "mlc/io/file_abi.hpp" blocking
extern fn remove_tree(path: string) -> bool
  = "mlc::file::remove_tree_value" from "mlc/io/file_abi.hpp" blocking

fn copy_header() -> string = "mlc-file-copy"

fn cut_header() -> string = "mlc-file-cut"

fn line_break(text: string) -> i32 = do
  let mut index = 0
  while index < text.byte_size() do
    if text.byte_at(index) == "\n".byte_at(0) then
      return index
    end
    index = index + 1
  end
  return 0 - 1
end

fn first_line(text: string) -> string = do
  const break_at = line_break(text)
  if break_at < 0 then
    return text
  end
  return text.byte_substring(0, break_at)
end

fn after_first_line(text: string) -> string = do
  const break_at = line_break(text)
  if break_at < 0 then
    return ""
  end
  const start = break_at + 1
  return text.byte_substring(start, text.byte_size() - start)
end

fn file_header(text: string) -> bool =
  first_line(text) == copy_header() || first_line(text) == cut_header()

export fn file_clipboard_public(text: string) -> string = do
  if file_header(text) then
    return after_first_line(text)
  end
  return text
end

fn split_lines(text: string) -> [string] = do
  let mut lines: [string] = []
  let mut start = 0
  let mut index = 0
  while index <= text.byte_size() do
    const at_end = index == text.byte_size()
    let mut broke = false
    if at_end == false && text.byte_at(index) == "\n".byte_at(0) then
      broke = true
    end
    if at_end || broke then
      const length = index - start
      if length > 0 then
        lines.push(text.byte_substring(start, length))
      end
      start = index + 1
    end
    index = index + 1
  end
  return lines
end

fn list_names(kind: WidgetKind) -> [string] =
  match kind
    | KindListView(data) => data.texts
    | KindBox(_) => []
    | KindLabel(_) => []
    | KindIcon(_) => []
    | KindButton(_) => []
    | KindCheckbox(_) => []
    | KindScrollView => []
    | KindSplitter(_) => []
    | KindTextField(_) => []

fn ends_with_slash(text: string) -> bool = do
  if text.byte_size() == 0 then
    return false
  end
  return text.byte_at(text.byte_size() - 1) == "/"
end

fn strip_one_slash(text: string) -> string = do
  if ends_with_slash(text) == false then
    return text
  end
  return text.byte_substring(0, text.byte_size() - 1)
end

fn entry_path(directory: string, entry: string) -> string =
  join_path(strip_trailing_slash(directory), strip_one_slash(entry))

fn base_name(path: string) -> string = do
  const stripped = strip_one_slash(path)
  let mut index = stripped.byte_size() - 1
  while index >= 0 do
    if stripped.byte_at(index) == "/" then
      return stripped.byte_substring(index + 1, stripped.byte_size() - index - 1)
    end
    index = index - 1
  end
  return stripped
end

fn selected_paths(store: WidgetStore, state: UiState, list_id: WidgetId) -> [string] = do
  let mut paths: [string] = []
  const names = list_names(store.nodes[list_id.index].kind)
  const directory = path_bar_current(store)
  const rows = list_marked_rows(state, list_id.index)
  let mut index = 0
  while index < rows.length() do
    const row = rows[index]
    if row >= 0 && row < names.length() then
      const name = names[row]
      if name != "" && name != ".." then
        paths.push(entry_path(directory, name))
      end
    end
    index = index + 1
  end
  return paths
end

fn with_clipboard(state: UiState, clipboard: ClipboardBuffer) -> UiState =
  ui_state_with(
    state,
    state.selection,
    state.grab,
    state.pointer,
    state.last_press,
    clipboard,
    state.hover
  )

export fn file_clipboard_offer(store: WidgetStore, state: UiState, input: UiInput) -> UiState = do
  if input.control_down == false then
    return state
  end
  let mut cutting = false
  if input.copy_pressed == false then
    if input.binding_key != "x" then
      return state
    end
    cutting = true
  end
  if selection_is_empty(state.selection) == false then
    return state
  end
  if focus_is_text_field(store, state) then
    return state
  end
  const list_id = list_marks_target(store, state)
  if widget_id_is_none(list_id) then
    return state
  end
  const paths = selected_paths(store, state, list_id)
  if paths.length() == 0 then
    return state
  end
  let mut header = copy_header()
  if cutting then
    header = cut_header()
  end
  let mut text = header
  let mut index = 0
  while index < paths.length() do
    text = text + "\n" + paths[index]
    index = index + 1
  end
  return with_clipboard(state, clipboard_set_clipboard(state.clipboard, text))
end

fn same_path(left: string, right: string) -> bool =
  normalize_path(left) == normalize_path(right)

fn path_contains(parent: string, child: string) -> bool = do
  const base = normalize_path(parent)
  const next = normalize_path(child)
  if next == base then
    return true
  end
  const prefix = base + "/"
  if next.byte_size() < prefix.byte_size() then
    return false
  end
  return next.byte_substring(0, prefix.byte_size()) == prefix
end

fn last_dot(name: string) -> i32 = do
  let mut found = 0 - 1
  let mut index = 0
  while index < name.byte_size() do
    if name.byte_at(index) == "." then
      found = index
    end
    index = index + 1
  end
  return found
end

fn named_copy(name: string, ordinal: i32) -> string = do
  if ordinal <= 0 then
    return name
  end
  let mut stem = name
  let mut suffix = ""
  const dot = last_dot(name)
  if dot > 0 then
    stem = name.byte_substring(0, dot)
    suffix = name.byte_substring(dot, name.byte_size() - dot)
  end
  if ordinal == 1 then
    return stem + " copy" + suffix
  end
  return stem + " copy " + ordinal.to_string() + suffix
end

fn unused_path(directory: string, name: string, root: string) -> string = do
  let mut ordinal = 0
  while ordinal < 50 do
    const candidate = join_path(directory, named_copy(name, ordinal))
    if path_inside_jail(root, candidate) && path_exists(candidate) == false then
      return candidate
    end
    ordinal = ordinal + 1
  end
  return ""
end

fn copy_entry(source: string, destination: string, root: string, depth: i32) -> bool = do
  if depth > 24 then
    return false
  end
  if path_inside_jail(root, source) == false || path_inside_jail(root, destination) == false then
    return false
  end
  if same_path(source, destination) || path_contains(source, destination) then
    return false
  end
  if path_is_directory(source) then
    if create_directories(destination) == false then
      return false
    end
    const names = list_dir_names(source)
    let mut index = 0
    let mut copied = true
    while index < names.length() do
      const child_source = join_path(source, names[index])
      const child_destination = join_path(destination, names[index])
      if copy_entry(child_source, child_destination, root, depth + 1) == false then
        copied = false
      end
      index = index + 1
    end
    return copied
  end
  return write_string(destination, read_to_string(source))
end

fn move_entry(source: string, destination: string, root: string) -> bool = do
  if path_inside_jail(root, source) == false || path_inside_jail(root, destination) == false then
    return false
  end
  if same_path(source, destination) then
    return false
  end
  if rename_file(source, destination) then
    return true
  end
  if copy_entry(source, destination, root, 0) == false then
    return false
  end
  return remove_tree(source)
end

fn transfer_one(source: string, directory: string, root: string, cutting: bool) -> bool = do
  if path_exists(source) == false || path_inside_jail(root, source) == false then
    return false
  end
  const name = base_name(source)
  if name == "" || name == "." || name == ".." then
    return false
  end
  if cutting && same_path(join_path(directory, name), source) then
    return false
  end
  const destination = unused_path(directory, name, root)
  if destination == "" then
    return false
  end
  if cutting then
    return move_entry(source, destination, root)
  end
  return copy_entry(source, destination, root, 0)
end

export fn file_clipboard_transfer(
  root: string,
  directory: string,
  paste_text: string,
  cutting: bool
) -> i32 = do
  if root == "" || directory == "" || path_inside_jail(root, directory) == false then
    return 0
  end
  const parent = strip_trailing_slash(directory)
  let mut count = 0
  const lines = split_lines(paste_text)
  let mut index = 0
  while index < lines.length() do
    if transfer_one(lines[index], parent, root, cutting) then
      count = count + 1
    end
    index = index + 1
  end
  return count
end
