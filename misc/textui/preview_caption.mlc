import { Theme } from './theme'
import { WidgetStore, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { DrawOp, TextOp } from './draw_op'
import { UiState } from './ui_state'
import { hovered_image_path, image_preview_file_pane, preview_side_rect } from './image_preview'

extern fn image_preview_picture_width() -> i32
  = "mlc::image_preview::picture_width_value" from "mlc/gl/image_preview.hpp" blocking
extern fn image_preview_picture_height() -> i32
  = "mlc::image_preview::picture_height_value" from "mlc/gl/image_preview.hpp" blocking
extern fn preview_file_byte_size(path: string) -> i32
  = "mlc::file::file_byte_size_value" from "mlc/io/file_abi.hpp" blocking

fn extension_label(path: string) -> string = do
  let mut dot = -1
  let mut index = 0
  while index < path.byte_size() do
    if path.byte_at(index) == "." then
      dot = index
    end
    index = index + 1
  end
  if dot < 0 || dot + 1 >= path.byte_size() then
    return ""
  end
  return path.byte_substring(dot + 1, path.byte_size() - dot - 1)
end

fn format_byte_count(size: i32) -> string = do
  if size < 0 then
    return ""
  end
  if size < 1024 then
    return size.to_string() + " B"
  end
  if size < 1048576 then
    return (size / 1024).to_string() + " KB"
  end
  const tenths = size / 104858
  return (tenths / 10).to_string() + "." + (tenths % 10).to_string() + " MB"
end

fn append_piece(text: string, piece: string) -> string = do
  if piece == "" then
    return text
  end
  if text == "" then
    return piece
  end
  return text + "   " + piece
end

fn preview_caption_text(path: string, width: i32, height: i32) -> string = do
  let mut text = ""
  if width > 0 && height > 0 then
    text = width.to_string() + " x " + height.to_string()
  end
  text = append_piece(text, format_byte_count(preview_file_byte_size(path)))
  return append_piece(text, extension_label(path))
end

fn caption_top(image_top: i32, image_height: i32, pane_top: i32, pane_height: i32, line: i32) -> i32 = do
  const below = image_top + image_height + 4
  if below + line <= pane_top + pane_height then
    return below
  end
  let mut over = image_top + image_height - line - 4
  if over < pane_top then
    over = pane_top
  end
  return over
end

export fn paint_preview_caption(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  root: string,
  operations: [DrawOp]
) -> [DrawOp] = do
  const path = hovered_image_path(store, state, root)
  if path == "" then
    return operations
  end
  const card = preview_side_rect(store, layout, theme)
  if card.width < 1 || card.height < 1 then
    return operations
  end
  const pane = image_preview_file_pane(store)
  if widget_id_is_none(pane) || pane.index < 0 || pane.index >= layout.clips.length() then
    return operations
  end
  const clip = layout.clips[pane.index]
  const picture_width = image_preview_picture_width()
  const picture_height = image_preview_picture_height()
  const caption = preview_caption_text(path, picture_width, picture_height)
  if caption == "" then
    return operations
  end
  const origin_x = card.x
  const origin_y = caption_top(
    card.y,
    card.height,
    clip.y,
    clip.height,
    theme.font_size_pixels
  )
  let mut next = operations
  next.push(OpText(TextOp {
    origin_x: origin_x,
    origin_y: origin_y,
    color: theme.foreground,
    text: caption
  }))
  return next
end
