import { Theme } from './theme'
import { WidgetStore, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { DrawOp, TextOp } from './draw_op'
import { UiState } from './ui_state'
import { hovered_image_path, image_preview_file_pane } from './image_preview'

extern fn image_preview_picture_width() -> i32
  = "mlc::image_preview::picture_width_value" from "mlc/gl/image_preview.hpp" blocking
extern fn image_preview_picture_height() -> i32
  = "mlc::image_preview::picture_height_value" from "mlc/gl/image_preview.hpp" blocking
extern fn image_preview_fit_width() -> i32
  = "mlc::image_preview::picture_fit_width_value" from "mlc/gl/image_preview.hpp" blocking
extern fn image_preview_fit_height() -> i32
  = "mlc::image_preview::picture_fit_height_value" from "mlc/gl/image_preview.hpp" blocking
extern fn preview_file_byte_size(path: string) -> i32
  = "mlc::file::file_byte_size_value" from "mlc/io/file_abi.hpp" blocking

fn extension_label(path: string) -> string = do
  let mut dot = -1
  let mut index = 0
  while index < path.byte_size() do
    if path.byte_at(index) == "." then
      dot = index
    end
    index = index + 1
  end
  if dot < 0 || dot + 1 >= path.byte_size() then
    return ""
  end
  return path.byte_substring(dot + 1, path.byte_size() - dot - 1)
end

fn format_byte_count(size: i32) -> string = do
  if size < 0 then
    return ""
  end
  if size < 1024 then
    return size.to_string() + " B"
  end
  if size < 1048576 then
    return (size / 1024).to_string() + " KB"
  end
  const tenths = size / 104858
  return (tenths / 10).to_string() + "." + (tenths % 10).to_string() + " MB"
end

fn append_piece(text: string, piece: string) -> string = do
  if piece == "" then
    return text
  end
  if text == "" then
    return piece
  end
  return text + "   " + piece
end

fn preview_caption_text(path: string, width: i32, height: i32) -> string = do
  let mut text = ""
  if width > 0 && height > 0 then
    text = width.to_string() + " x " + height.to_string()
  end
  text = append_piece(text, format_byte_count(preview_file_byte_size(path)))
  return append_piece(text, extension_label(path))
end

fn contained_size(source_width: i32, source_height: i32, dest_width: i32, dest_height: i32) -> i32 = do
  if source_width > dest_width || source_height > dest_height then
    if dest_width * source_height <= dest_height * source_width then
      return dest_width
    end
    if source_height > 0 then
      return dest_height * source_width / source_height
    end
    return dest_width
  end
  return source_width
end

fn contained_height(source_width: i32, source_height: i32, dest_width: i32, dest_height: i32) -> i32 = do
  if source_width > dest_width || source_height > dest_height then
    if dest_width * source_height <= dest_height * source_width then
      if source_width > 0 then
        return dest_width * source_height / source_width
      end
      return dest_height
    end
    return dest_height
  end
  return source_height
end

fn caption_top(image_top: i32, image_height: i32, pane_top: i32, pane_height: i32, line: i32) -> i32 = do
  const below = image_top + image_height + 4
  if below + line <= pane_top + pane_height then
    return below
  end
  let mut over = image_top + image_height - line - 4
  if over < pane_top then
    over = pane_top
  end
  return over
end

export fn paint_preview_caption(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  root: string,
  operations: [DrawOp]
) -> [DrawOp] = do
  const path = hovered_image_path(store, state, root)
  if path == "" then
    return operations
  end
  const pane = image_preview_file_pane(store)
  if widget_id_is_none(pane) || pane.index < 0 || pane.index >= layout.clips.length() then
    return operations
  end
  const rect = layout.clips[pane.index]
  if rect.width < 1 || rect.height < 1 then
    return operations
  end
  const picture_width = image_preview_picture_width()
  const picture_height = image_preview_picture_height()
  const fit_width = image_preview_fit_width()
  const fit_height = image_preview_fit_height()
  const caption = preview_caption_text(path, picture_width, picture_height)
  if caption == "" then
    return operations
  end
  let mut origin_x = rect.x + 8
  let mut origin_y = rect.y + rect.height - theme.font_size_pixels - 8
  if fit_width > 0 && fit_height > 0 then
    let mut card_width = contained_size(fit_width, fit_height, rect.width, rect.height)
    let mut card_height = contained_height(fit_width, fit_height, rect.width, rect.height)
    if card_width < 1 then
      card_width = 1
    end
    if card_height < 1 then
      card_height = 1
    end
    if card_width > rect.width then
      card_width = rect.width
    end
    if card_height > rect.height then
      card_height = rect.height
    end
    origin_x = rect.x + (rect.width - card_width) / 2
    origin_y = caption_top(
      rect.y + (rect.height - card_height) / 2,
      card_height,
      rect.y,
      rect.height,
      theme.font_size_pixels
    )
  end
  let mut next = operations
  next.push(OpText(TextOp {
    origin_x: origin_x,
    origin_y: origin_y,
    color: theme.foreground,
    text: caption
  }))
  return next
end
