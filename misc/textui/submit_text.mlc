import {
  TextShapingState,
  text_shaping_shape,
  text_shaping_glyph_id_at,
  text_shaping_glyph_advance_at,
  text_shaping_rasterize_glyph
} from '../gui/text_shaping'
import {
  AtlasSlot,
  GlyphAtlas,
  GlyphCache,
  GlyphCacheKey,
  glyph_atlas_pack,
  glyph_cache_get,
  glyph_cache_insert
} from '../gui/text_renderer'

extern fn gl_scratch_u8_blit_glyph_a8(atlas_width: i32, dest_x: i32, dest_y: i32) -> i32
  = "mlc::gl::gl_scratch_u8_blit_glyph_a8" from "mlc/gl/text_window_helpers.hpp"
extern fn gl_scratch_push_screen_quad(
  window_width: i32, window_height: i32,
  pixel_x: i32, pixel_y: i32, pixel_width: i32, pixel_height: i32,
  atlas_size: i32, slot_x: i32, slot_y: i32, slot_width: i32, slot_height: i32
) -> unit
  = "mlc::gl::gl_scratch_push_screen_quad" from "mlc/gl/text_window_helpers.hpp"

export fn submit_atlas_size() -> i32 = 512

fn empty_slot() -> AtlasSlot =
  AtlasSlot { page_index: -1, x: 0, y: 0, width: 0, height: 0 }

export type GlyphRun = {
  slot: AtlasSlot,
  bearing_x: i32,
  bearing_y: i32,
  advance: i32
}

export type GlyphRunsBuild = {
  atlas: GlyphAtlas,
  cache: GlyphCache,
  shaping: TextShapingState,
  glyph_runs: Map<string, [GlyphRun]>,
  atlas_dirty: i32,
  error_code: i32
}

export fn glyph_runs_key(font_path: string, pixel_size: i32, text: string) -> string =
  font_path + "|" + pixel_size.to_string() + "|" + text

export fn push_run_quads(
  window_width: i32,
  window_height: i32,
  origin_x: i32,
  baseline_y: i32,
  atlas_size_pixels: i32,
  runs: [GlyphRun]
) -> i32 = do
  let mut cursor_x = origin_x
  let mut vertices = 0
  let mut run_index = 0
  while run_index < runs.length() do
    const run = runs[run_index]
    if run.slot.width > 0 && run.slot.height > 0 then
      gl_scratch_push_screen_quad(
        window_width, window_height,
        cursor_x + run.bearing_x, baseline_y - run.bearing_y,
        run.slot.width, run.slot.height,
        atlas_size_pixels, run.slot.x, run.slot.y, run.slot.width, run.slot.height
      )
      vertices = vertices + 6
    end
    cursor_x = cursor_x + run.advance
    run_index = run_index + 1
  end
  vertices
end

export fn ensure_glyph_runs(
  atlas: GlyphAtlas,
  cache: GlyphCache,
  shaping: TextShapingState,
  glyph_runs: Map<string, [GlyphRun]>,
  font_path: string,
  pixel_size: i32,
  text: string
) -> GlyphRunsBuild = do
  const key = glyph_runs_key(font_path, pixel_size, text)
  if glyph_runs.has(key) then
    return GlyphRunsBuild {
      atlas: atlas,
      cache: cache,
      shaping: shaping,
      glyph_runs: glyph_runs,
      atlas_dirty: 0,
      error_code: 0
    }
  end
  const shaped = text_shaping_shape(shaping, font_path, pixel_size, text)
  if shaped.error_code != 0 then
    return GlyphRunsBuild {
      atlas: atlas,
      cache: cache,
      shaping: shaped.state,
      glyph_runs: glyph_runs,
      atlas_dirty: 0,
      error_code: shaped.error_code
    }
  end
  let mut working_atlas = atlas
  let mut working_cache = cache
  let mut working_shaping = shaped.state
  let mut runs: [GlyphRun] = []
  let mut atlas_dirty = 0
  let mut glyph_index = 0
  while glyph_index < shaped.glyph_count do
    const glyph_id = text_shaping_glyph_id_at(glyph_index)
    const cache_key = GlyphCacheKey {
      font_id: 0, glyph_index: glyph_id, size_px: pixel_size, mode: 0
    }
    const cached = glyph_cache_get(working_cache, cache_key)
    working_cache = cached.cache
    let mut slot = cached.slot
    let mut bearing_x = cached.bearing_x
    let mut bearing_y = cached.bearing_y
    if cached.found == 0 then
      const raster = text_shaping_rasterize_glyph(
        working_shaping, font_path, pixel_size, glyph_id
      )
      if raster.error_code == 0 then
        bearing_x = raster.bearing_x
        bearing_y = raster.bearing_y
        if raster.width > 0 && raster.rows > 0 then
          const pack = glyph_atlas_pack(working_atlas, 0, raster.width, raster.rows)
          if pack.error_code == 0 then
            working_atlas = pack.atlas
            if gl_scratch_u8_blit_glyph_a8(submit_atlas_size(), pack.slot.x, pack.slot.y) == 0 then
              slot = pack.slot
              const inserted = glyph_cache_insert(
                working_cache, cache_key, slot, bearing_x, bearing_y
              )
              working_cache = inserted.cache
              atlas_dirty = 1
            end
          end
        else
          slot = empty_slot()
        end
      end
    end
    runs.push(GlyphRun {
      slot: slot,
      bearing_x: bearing_x,
      bearing_y: bearing_y,
      advance: text_shaping_glyph_advance_at(glyph_index) / 64
    })
    glyph_index = glyph_index + 1
  end
  let mut next_runs = glyph_runs
  next_runs.set(key, runs)
  GlyphRunsBuild {
    atlas: working_atlas,
    cache: working_cache,
    shaping: working_shaping,
    glyph_runs: next_runs,
    atlas_dirty: atlas_dirty,
    error_code: 0
  }
end
