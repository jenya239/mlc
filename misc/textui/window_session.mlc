import { has } from 'Env'
import {
  glfw_gl_window_height,
  glfw_gl_window_width,
  glfw_gl_window_x,
  glfw_gl_window_y
} from '../../lib/mlc/common/stdlib/gl/gl_window.mlc'
import { checkbox_named_checked, checkbox_set_named } from './checkbox'
import { path_inside_jail } from './directory_jail'
import { sandbox_root_from } from './fm_sandbox'
import { path_bar_current } from './path_bar'
import {
  music_is_paused,
  music_position_seconds,
  music_queue_text,
  music_restore,
  music_track,
  music_track_index
} from './music_host'
import { WidgetStore, kind_is_splitter } from './store'
import { UiState, ui_state_with_splitter_ratios } from './ui_state'
import { splitter_ratio_at, splitter_ratios_put } from './widget_split'
import { show_effect_mode } from './visual_effect'
import {
  WindowPlacement,
  window_placement_config_path,
  parse_integer,
  window_placement_decode
} from './window_placement'

extern fn file_read_to_string(path: string) -> string
  = "mlc::file::read_to_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_write_string(path: string, content: string) -> bool
  = "mlc::file::write_string_value" from "mlc/io/file_abi.hpp" blocking
extern fn file_exists(path: string) -> bool
  = "mlc::file::exists_value" from "mlc/io/file_abi.hpp" blocking
extern fn directory_exists(path: string) -> bool
  = "mlc::file::is_directory_value" from "mlc/io/file_abi.hpp" blocking

export type WindowSession = {
  placement: WindowPlacement,
  jail: bool,
  hidden: bool,
  effect_mode: i32,
  path: string,
  sandbox: string,
  directory_ratio: i32,
  dense: bool,
  track: string,
  queue: string,
  track_index: i32,
  position_seconds: i32,
  paused: bool
}

export type GalleryStart = {
  store: WidgetStore,
  sandbox: string,
  jail_root: string,
  path: string,
  effect_mode: i32
}

fn absent_session() -> WindowSession =
  WindowSession {
    placement: WindowPlacement { x: 0, y: 0, width: 1280, height: 800, restored: false },
    jail: true,
    hidden: false,
    effect_mode: 1,
    path: "",
    sandbox: "",
    directory_ratio: 280,
    dense: false,
    track: "",
    queue: "",
    track_index: 0,
    position_seconds: 0,
    paused: false
  }

fn starts_with(text: string, prefix: string) -> bool = do
  if text.byte_size() < prefix.byte_size() then
    return false
  end
  return text.byte_substring(0, prefix.byte_size()) == prefix
end

fn suffix_after(text: string, prefix: string) -> string =
  text.byte_substring(prefix.byte_size(), text.byte_size() - prefix.byte_size())

fn flag_on(text: string) -> bool =
  text == "1"

fn effect_mode_from(text: string) -> i32 = do
  if text == "0" then
    return 0
  end
  if text == "2" then
    return 2
  end
  if text == "3" then
    return 3
  end
  return 1
end

fn seconds_from(text: string) -> i32 = do
  const parsed = parse_integer(text)
  if parsed.ok == false || parsed.value < 0 then
    return 0
  end
  return parsed.value
end

fn append_queue_path(queue: string, path: string) -> string = do
  if path == "" then
    return queue
  end
  if queue == "" then
    return path
  end
  return queue + "\n" + path
end

fn directory_ratio_from(text: string) -> i32 = do
  const parsed = parse_integer(text)
  if parsed.ok == false || parsed.value < 80 || parsed.value > 920 then
    return 280
  end
  return parsed.value
end

fn read_session(text: string) -> WindowSession = do
  let mut jail = true
  let mut hidden = false
  let mut effect_mode = 1
  let mut path = ""
  let mut sandbox = ""
  let mut directory_ratio = 280
  let mut dense = false
  let mut track = ""
  let mut queue = ""
  let mut track_index = 0
  let mut position_seconds = 0
  let mut paused = false
  let mut line_start = 0
  let mut index = 0
  const length = text.byte_size()
  while index <= length do
    if index == length || text.byte_at(index) == "\n" then
      const line_length = index - line_start
      if line_length > 0 then
        const line = text.byte_substring(line_start, line_length)
        if starts_with(line, "jail=") then
          jail = flag_on(suffix_after(line, "jail="))
        end
        if starts_with(line, "hidden=") then
          hidden = flag_on(suffix_after(line, "hidden="))
        end
        if starts_with(line, "effect=") then
          effect_mode = effect_mode_from(suffix_after(line, "effect="))
        end
        if starts_with(line, "path=") then
          path = suffix_after(line, "path=")
        end
        if starts_with(line, "sandbox=") then
          sandbox = suffix_after(line, "sandbox=")
        end
        if starts_with(line, "directories=") then
          directory_ratio = directory_ratio_from(suffix_after(line, "directories="))
        end
        if starts_with(line, "dense=") then
          dense = flag_on(suffix_after(line, "dense="))
        end
        if starts_with(line, "track=") then
          track = suffix_after(line, "track=")
        end
        if starts_with(line, "position=") then
          position_seconds = seconds_from(suffix_after(line, "position="))
        end
        if starts_with(line, "paused=") then
          paused = flag_on(suffix_after(line, "paused="))
        end
        if starts_with(line, "track_index=") then
          track_index = seconds_from(suffix_after(line, "track_index="))
        end
        if starts_with(line, "queue=") then
          queue = append_queue_path(queue, suffix_after(line, "queue="))
        end
      end
      line_start = index + 1
    end
    index = index + 1
  end
  return WindowSession {
    placement: window_placement_decode(text),
    jail: jail,
    hidden: hidden,
    effect_mode: effect_mode,
    path: path,
    sandbox: sandbox,
    directory_ratio: directory_ratio,
    dense: dense,
    track: track,
    queue: queue,
    track_index: track_index,
    position_seconds: position_seconds,
    paused: paused
  }
end

export fn window_session_load() -> WindowSession = do
  const path = window_placement_config_path()
  if path == "" || file_exists(path) == false then
    return absent_session()
  end
  return read_session(file_read_to_string(path))
end

fn append_saved_queue(text: string, queue: string) -> string = do
  let mut result = text
  let mut line_start = 0
  let mut index = 0
  const length = queue.byte_size()
  while index <= length do
    if index == length || queue.byte_at(index) == "\n" then
      const line_length = index - line_start
      if line_length > 0 then
        result = result + "queue=" + queue.byte_substring(line_start, line_length) + "\n"
      end
      line_start = index + 1
    end
    index = index + 1
  end
  return result
end

fn append_player(text: string) -> string = do
  const track = music_track()
  let mut next = text
  if track != "" then
    next = next + "track=" + track + "\n" +
      "position=" + music_position_seconds().to_string() + "\n" +
      "paused=" + flag_text(music_is_paused()) + "\n" +
      "track_index=" + music_track_index().to_string() + "\n"
    next = append_saved_queue(next, music_queue_text())
  end
  return next
end

fn flag_text(value: bool) -> string = do
  if value then
    return "1"
  end
  return "0"
end

fn directory_splitter_index(store: WidgetStore) -> i32 = do
  let mut index = 0
  while index < store.nodes.length() do
    if kind_is_splitter(store.nodes[index].kind) then
      return index
    end
    index = index + 1
  end
  return 0 - 1
end

fn directory_ratio_saved(store: WidgetStore, ratios: [i32]) -> i32 = do
  const index = directory_splitter_index(store)
  if index < 0 then
    return 280
  end
  return splitter_ratio_at(ratios, index, 280)
end

export fn session_with_directory(state: UiState, store: WidgetStore, session: WindowSession) -> UiState = do
  const index = directory_splitter_index(store)
  if index < 0 then
    return state
  end
  return ui_state_with_splitter_ratios(
    state,
    splitter_ratios_put(state.splitter_ratios, index, session.directory_ratio)
  )
end

fn encode_session(
  store: WidgetStore,
  effect_mode: i32,
  sandbox: string,
  jail_root: string,
  splitter_ratios: [i32],
  dense_enabled: bool
) -> string = do
  const placement = WindowPlacement {
    x: glfw_gl_window_x(),
    y: glfw_gl_window_y(),
    width: glfw_gl_window_width(),
    height: glfw_gl_window_height(),
    restored: true
  }
  const text = "x=" + placement.x.to_string() + "\n" +
    "y=" + placement.y.to_string() + "\n" +
    "width=" + placement.width.to_string() + "\n" +
    "height=" + placement.height.to_string() + "\n" +
    "jail=" + flag_text(jail_root != "") + "\n" +
    "hidden=" + flag_text(checkbox_named_checked(store, "Hidden")) + "\n" +
    "effect=" + effect_mode.to_string() + "\n" +
    "sandbox=" + sandbox + "\n" +
    "path=" + path_bar_current(store) + "\n" +
    "directories=" + directory_ratio_saved(store, splitter_ratios).to_string() + "\n" +
    "dense=" + flag_text(dense_enabled) + "\n"
  return append_player(text)
end

export fn window_session_store(
  previous: string,
  store: WidgetStore,
  effect_mode: i32,
  sandbox: string,
  jail_root: string,
  splitter_ratios: [i32],
  dense_enabled: bool
) -> string = do
  if has("MLC_TEXTUI_BENCH") then
    return previous
  end
  const text = encode_session(store, effect_mode, sandbox, jail_root, splitter_ratios, dense_enabled)
  if text == previous then
    return previous
  end
  const path = window_placement_config_path()
  if path != "" then
    file_write_string(path, text)
  end
  return text
end

export fn gallery_start(store: WidgetStore, session: WindowSession) -> GalleryStart = do
  let mut next = checkbox_set_named(store, "Jail", session.jail)
  next = checkbox_set_named(next, "Hidden", session.hidden)
  next = show_effect_mode(next, session.effect_mode)
  const sandbox = sandbox_root_from(session.sandbox)
  let mut jail_root = ""
  if session.jail then
    jail_root = sandbox
  end
  let mut path = sandbox
  if session.jail == false then
    path = "/"
  end
  if session.path != "" && directory_exists(session.path) then
    if session.jail == false || path_inside_jail(sandbox, session.path) then
      path = session.path
    end
  end
  if path == "" then
    path = "/home/jenya/workspaces/current/mlc"
    jail_root = ""
  end
  if has("MLC_TEXTUI_BENCH") == false && session.track != "" && file_exists(session.track) then
    if session.jail == false || path_inside_jail(sandbox, session.track) then
      music_restore(session.track, session.queue, session.track_index, session.position_seconds, session.paused)
    end
  end
  return GalleryStart {
    store: next,
    sandbox: sandbox,
    jail_root: jail_root,
    path: path,
    effect_mode: session.effect_mode
  }
end
