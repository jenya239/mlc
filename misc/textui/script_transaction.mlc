import {
  LabelData,
  WidgetId,
  WidgetKind,
  WidgetStore,
  widget_node_with_kind,
  widget_store_keep
} from './store'

export type ScriptLabelPatch = {
  widget: WidgetId,
  text: string
}

export type ScriptTransaction = {
  store: WidgetStore,
  patches: [ScriptLabelPatch],
  revision: i32
}

fn empty_patches() -> [ScriptLabelPatch] = do
  let mut patches: [ScriptLabelPatch] = []
  patches
end

export fn script_transaction_new(store: WidgetStore) -> ScriptTransaction = do
  ScriptTransaction { store: store, patches: empty_patches(), revision: 0 }
end

export fn script_transaction_stage_set_label_text(
  transaction: ScriptTransaction,
  widget: WidgetId,
  text: string
) -> ScriptTransaction = do
  let mut patches = transaction.patches
  patches.push(ScriptLabelPatch { widget: widget, text: text })
  ScriptTransaction { store: transaction.store, patches: patches, revision: transaction.revision }
end

fn kind_is_label(kind: WidgetKind) -> bool =
  match kind
    | KindLabel(_) => true
    | KindBox(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindTextField(_) => false
    | KindIcon(_) => false

fn widget_is_label(store: WidgetStore, widget: WidgetId) -> bool = do
  if widget.index < 0 || widget.index >= store.nodes.length() then
    false
  else
    kind_is_label(store.nodes[widget.index].kind)
  end
end

fn patches_are_valid(store: WidgetStore, patches: [ScriptLabelPatch]) -> bool = do
  let mut index = 0
  while index < patches.length() do
    if !widget_is_label(store, patches[index].widget) then
      return false
    end
    index = index + 1
  end
  true
end

fn apply_set_label_text(store: WidgetStore, widget: WidgetId, text: string) -> WidgetStore = do
  let node = store.nodes[widget.index]
  let mut nodes = store.nodes
  nodes.set(widget.index, widget_node_with_kind(node, KindLabel(LabelData { text: text })))
  widget_store_keep(nodes, store)
end

fn apply_patches(store: WidgetStore, patches: [ScriptLabelPatch]) -> WidgetStore = do
  let mut next = store
  let mut index = 0
  while index < patches.length() do
    let patch = patches[index]
    next = apply_set_label_text(next, patch.widget, patch.text)
    index = index + 1
  end
  next
end

export fn script_transaction_commit(transaction: ScriptTransaction) -> ScriptTransaction = do
  if !patches_are_valid(transaction.store, transaction.patches) then
    ScriptTransaction { store: transaction.store, patches: empty_patches(), revision: transaction.revision }
  else
    ScriptTransaction {
      store: apply_patches(transaction.store, transaction.patches),
      patches: empty_patches(),
      revision: transaction.revision + 1
    }
  end
end
