import { DrawOp } from './draw_op'
import { theme_default } from './theme'
import { UiInput } from './ui_input'
import { ui_update } from './ui_update'
import { UiState, ui_state_with_listing_revision } from './ui_state'
import { selection_is_empty } from './selection'
import { layout_ui } from './layout_pass'
import { field_align_scroll } from './widget_field'
import { frame_request, frame_request_layouts, frame_request_paints, frame_signature } from './frame_request'
import { paint_overlay_frame, paint_tree_frame } from './paint_pass'
import { paint_transcript } from './chat_transcript'
import {
  TranscriptSelection,
  transcript_consume_press,
  transcript_copy_text,
  transcript_input,
  transcript_pointer_routed
} from './chat_transcript_input'
import { TranscriptView, transcript_measure } from './chat_transcript_layout'
import { chat_apply_events } from './chat_update'
import { chat_session_dispatch, chat_session_poll } from './chat_session'
import {
  ChatWorld,
  chat_transcript_rect,
  chat_view_at_bottom
} from './chat_world'

export type ChatFrameResult = {
  world: ChatWorld,
  ops_under: [DrawOp],
  ops_over: [DrawOp],
  paints: bool,
  clipboard: string
}

fn view_changed(before: TranscriptView, after: TranscriptView) -> bool = do
  if before.width != after.width then
    return true
  end
  if before.measured_count != after.measured_count then
    return true
  end
  if before.scroll_y != after.scroll_y then
    return true
  end
  if before.stick_to_bottom != after.stick_to_bottom then
    return true
  end
  before.index.total != after.index.total
end

fn selection_changed(before: TranscriptSelection, after: TranscriptSelection) -> bool = do
  if before.message != after.message then
    return true
  end
  if before.anchor != after.anchor then
    return true
  end
  if before.focus != after.focus then
    return true
  end
  before.dragging != after.dragging
end

fn join_operations(left: [DrawOp], right: [DrawOp]) -> [DrawOp] = do
  let mut joined = left
  let mut index = 0
  while index < right.length() do
    joined.push(right[index])
    index = index + 1
  end
  joined
end

fn frame_clipboard(
  world: ChatWorld,
  input: UiInput,
  field_selection_empty: bool
) -> string = do
  if input.copy_pressed == false || input.control_down == false then
    return ""
  end
  if field_selection_empty then
    const bounds = chat_transcript_rect(world.layout, world.scene)
    return transcript_copy_text(
      world.model,
      world.selection,
      world.shaping,
      world.cache,
      theme_default(),
      bounds.width
    )
  end
  world.state.clipboard.clipboard
end

export fn chat_frame_run(
  world: ChatWorld,
  input: UiInput,
  width: i32,
  height: i32
) -> ChatFrameResult = do
  const theme = theme_default()
  const revision_before = world.model.revision
  const view_before = world.view
  const selection_before = world.selection
  let mut model = chat_session_poll(world.model)
  const bounds = chat_transcript_rect(world.layout, world.scene)
  const routed = transcript_pointer_routed(input, bounds)
  let mut delivered = input
  if routed then
    delivered = transcript_consume_press(input, bounds)
  end
  const handled = transcript_input(
    theme,
    world.view,
    world.selection,
    model,
    world.shaping,
    world.cache,
    bounds,
    input,
    0
  )
  const updated = ui_update(world.store, world.layout, theme, world.state, delivered)
  const applied = chat_apply_events(
    world.scene,
    model,
    updated.store,
    updated.state,
    updated.events
  )
  model = chat_session_dispatch(world.config, applied.model, applied.send_requested)
  let mut state = applied.state
  if model.revision != revision_before || view_changed(view_before, handled.view) || selection_changed(selection_before, handled.selection) then
    state = ui_state_with_listing_revision(state, state.listing_revision + 1)
  end
  let mut store = applied.store
  let mut view = handled.view
  let mut shaping = handled.shaping
  let mut cache = handled.cache
  let mut layout = world.layout
  const request = frame_request(world.presented, frame_signature(state, width, height))
  if frame_request_layouts(request) then
    let mut offsets = state.scroll_offsets
    let mut ratios = state.splitter_ratios
    const laid = layout_ui(store, theme, shaping, cache, width, height, offsets, ratios)
    shaping = laid.shaping
    cache = laid.cache
    layout = laid.layout
    state = field_align_scroll(store, layout, theme, state)
    const next_bounds = chat_transcript_rect(layout, world.scene)
    const measured = transcript_measure(model, view, shaping, cache, theme, next_bounds.width)
    view = chat_view_at_bottom(measured.view, next_bounds.height)
    shaping = measured.shaping
    cache = measured.cache
  end
  const paints = frame_request_paints(request)
  let mut painted_under = world.painted_under
  let mut painted_over = world.painted_over
  if paints then
    const tree = paint_tree_frame(theme, store, layout, state)
    const transcript = paint_transcript(theme, model, view, shaping, cache, chat_transcript_rect(layout, world.scene))
    painted_under = join_operations(tree, transcript)
    painted_over = paint_overlay_frame(theme, store, layout, state)
  end
  let mut presented = world.presented
  if paints then
    presented = frame_signature(state, width, height)
  end
  const next = ChatWorld {
    store: store,
    state: state,
    model: model,
    view: view,
    selection: handled.selection,
    scene: world.scene,
    config: world.config,
    shaping: shaping,
    cache: cache,
    layout: layout,
    presented: presented,
    painted_under: painted_under,
    painted_over: painted_over
  }
  ChatFrameResult {
    world: next,
    ops_under: painted_under,
    ops_over: painted_over,
    paints: paints,
    clipboard: frame_clipboard(next, input, selection_is_empty(state.selection))
  }
end
