export type ColorRgba = {
  red: f64,
  green: f64,
  blue: f64,
  alpha: f64
}

export fn color_rgba_new(red: f64, green: f64, blue: f64, alpha: f64) -> ColorRgba =
  ColorRgba { red: red, green: green, blue: blue, alpha: alpha }

export type Theme = {
  font_path: string,
  font_size_pixels: i32,
  padding: i32,
  gap: i32,
  background: ColorRgba,
  foreground: ColorRgba,
  muted: ColorRgba,
  selection_background: ColorRgba,
  button_background: ColorRgba,
  button_hover: ColorRgba,
  button_pressed: ColorRgba,
  button_stroke: ColorRgba,
  scrollbar_track: ColorRgba,
  scrollbar_thumb: ColorRgba,
  scrollbar_width: i32,
  inspect_hover: ColorRgba,
  inspect_stroke: ColorRgba,
  list_hover: ColorRgba,
  list_selected: ColorRgba,
  list_inactive: ColorRgba,
  splitter_sash: ColorRgba,
  splitter_hover: ColorRgba,
  splitter_width: i32,
  splitter_min: i32,
  overlay_scrim: ColorRgba,
  overlay_background: ColorRgba,
  overlay_stroke: ColorRgba
}

export fn theme_content_inset(theme: Theme) -> i32 =
  theme.padding

export fn theme_with_font_size(theme: Theme, font_size_pixels: i32) -> Theme =
  Theme {
    font_path: theme.font_path,
    font_size_pixels: font_size_pixels,
    padding: theme.padding,
    gap: theme.gap,
    background: theme.background,
    foreground: theme.foreground,
    muted: theme.muted,
    selection_background: theme.selection_background,
    button_background: theme.button_background,
    button_hover: theme.button_hover,
    button_pressed: theme.button_pressed,
    button_stroke: theme.button_stroke,
    scrollbar_track: theme.scrollbar_track,
    scrollbar_thumb: theme.scrollbar_thumb,
    scrollbar_width: theme.scrollbar_width,
    inspect_hover: theme.inspect_hover,
    inspect_stroke: theme.inspect_stroke,
    list_hover: theme.list_hover,
    list_selected: theme.list_selected,
    list_inactive: theme.list_inactive,
    splitter_sash: theme.splitter_sash,
    splitter_hover: theme.splitter_hover,
    splitter_width: theme.splitter_width,
    splitter_min: theme.splitter_min,
    overlay_scrim: theme.overlay_scrim,
    overlay_background: theme.overlay_background,
    overlay_stroke: theme.overlay_stroke
  }

export fn theme_default() -> Theme =
  Theme {
    font_path: "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    font_size_pixels: 12,
    padding: 8,
    gap: 10,
    background: color_rgba_new(0.07, 0.08, 0.10, 1.0),
    foreground: color_rgba_new(0.91, 0.92, 0.93, 1.0),
    muted: color_rgba_new(0.55, 0.58, 0.62, 1.0),
    selection_background: color_rgba_new(0.20, 0.40, 0.80, 0.35),
    button_background: color_rgba_new(0.16, 0.19, 0.22, 1.0),
    button_hover: color_rgba_new(0.23, 0.26, 0.31, 1.0),
    button_pressed: color_rgba_new(0.11, 0.13, 0.16, 1.0),
    button_stroke: color_rgba_new(0.36, 0.40, 0.44, 1.0),
    scrollbar_track: color_rgba_new(0.10, 0.12, 0.15, 1.0),
    scrollbar_thumb: color_rgba_new(0.42, 0.45, 0.50, 1.0),
    scrollbar_width: 8,
    inspect_hover: color_rgba_new(0.30, 0.82, 0.88, 1.0),
    inspect_stroke: color_rgba_new(1.0, 0.72, 0.30, 1.0),
    list_hover: color_rgba_new(0.11, 0.14, 0.17, 1.0),
    list_selected: color_rgba_new(0.16, 0.25, 0.37, 1.0),
    list_inactive: color_rgba_new(0.12, 0.16, 0.20, 1.0),
    splitter_sash: color_rgba_new(0.16, 0.19, 0.22, 1.0),
    splitter_hover: color_rgba_new(0.42, 0.45, 0.50, 1.0),
    splitter_width: 6,
    splitter_min: 80,
    overlay_scrim: color_rgba_new(0.0, 0.0, 0.0, 0.45),
    overlay_background: color_rgba_new(0.12, 0.14, 0.17, 1.0),
