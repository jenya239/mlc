import { Rect, rect_contains, rect_is_empty, rect_new } from './geometry'
import { Theme } from './theme'
import { WidgetStore, widget_id_is_none } from './store'
import { LayoutResult } from './layout_result'
import { DrawOp, FillRectOp } from './draw_op'
import { UiInput } from './ui_input'
import { UiState } from './ui_state'
import { list_row_height, list_row_inset } from './widget_list'
import { image_preview_file_pane } from './image_preview'
import { text_document_line, text_document_line_count } from './text_document'
import { paint_editor_line_number, paint_editor_whitespace, text_editor_text_x } from './text_editor_gutter'
import { paint_editor_minimap } from './text_editor_minimap'
import { text_line_index_of_identifier } from './text_line_index'
import { text_grapheme_boundaries } from './text_graphemes'
import { text_view_entry_index, text_view_position_of_byte } from './text_view_input'
import { text_view_line_selection } from './text_view_selection'
import { text_view_visible_identifiers } from './text_view_state'
import { scroll_bar_rect, scroll_thumb_rect } from './widget_scroll'
import { text_editor_bar_visible, text_editor_content_height, text_editor_scroll_offset } from './text_editor_pointer'
import { paint_editor_line_text } from './text_editor_highlight'
import { TextEditor } from './text_editor'
import { focus_is_text_field } from './list_marks'

export fn text_editor_band(store: WidgetStore, layout: LayoutResult) -> Rect = do
  const pane = image_preview_file_pane(store)
  if widget_id_is_none(pane) || pane.index < 0 || pane.index >= layout.clips.length() then
    return rect_new(0, 0, 0, 0)
  end
  const clip = layout.clips[pane.index]
  if rect_is_empty(clip) || clip.width < 80 || clip.height < 16 then
    return rect_new(0, 0, 0, 0)
  end
  const band_width = clip.width / 2
  if band_width < 40 then
    return rect_new(0, 0, 0, 0)
  end
  rect_new(clip.x + clip.width - band_width, clip.y, band_width, clip.height)
end

export fn text_editor_pointer_inside(editor: TextEditor, store: WidgetStore, layout: LayoutResult, mouse_x: i32, mouse_y: i32) -> bool = do
  if editor.open == false then
    return false
  end
  rect_contains(text_editor_band(store, layout), mouse_x, mouse_y)
end

export fn text_editor_prepare_input(
  editor: TextEditor,
  store: WidgetStore,
  state: UiState,
  layout: LayoutResult,
  input: UiInput
) -> UiInput = do
  if editor.open == false || state.overlay_open || focus_is_text_field(store, state) then
    return input
  end
  let mut wheel_y = input.wheel_y
  if text_editor_pointer_inside(editor, store, layout, input.mouse_x, input.mouse_y) then
    wheel_y = 0
  end
  UiInput {
    mouse_x: input.mouse_x,
    mouse_y: input.mouse_y,
    left_pressed: input.left_pressed,
    left_down: input.left_down,
    left_released: input.left_released,
    control_down: input.control_down,
    copy_pressed: input.copy_pressed,
    wheel_y: wheel_y,
    now_ms: input.now_ms,
    text: "",
    binding_key: "",
    shift_down: input.shift_down,
    backspace_pressed: false,
    enter_pressed: false,
    paste_text: ""
  }
end

fn caret_x(editor: TextEditor) -> i32 = do
  const line_index = text_line_index_of_identifier(editor.document.line_index, editor.view.caret_line_identifier)
  if line_index < 0 then
    return 0
  end
  const line = text_document_line(editor.document, line_index)
  const found = text_view_entry_index(editor.view, line.line_identifier, line.revision)
  if found < 0 then
    return 0
  end
  const boundaries = text_grapheme_boundaries(line.text)
  const positions = editor.view.shape_cache.entries[found].boundary_positions
  text_view_position_of_byte(boundaries, positions, editor.view.caret_byte) - editor.view.horizontal_scroll
end

export fn paint_text_editor(theme: Theme, store: WidgetStore, layout: LayoutResult, operations: [DrawOp], editor: TextEditor) -> [DrawOp] = do
  if editor.open == false then
    return operations
  end
  const band = text_editor_band(store, layout)
  if rect_is_empty(band) then
    return operations
  end
  const row_height = list_row_height(theme)
  if row_height < 1 then
    return operations
  end
  let mut painted = operations
  painted.push(OpFillRect(FillRectOp { rect: band, color: theme.background }))
  painted.push(OpPushClip(band))
  const line_count = text_document_line_count(editor.document)
  const origin_x = text_editor_text_x(band.x, theme, line_count)
  const origin_y = band.y + theme.padding
  const identifiers = text_view_visible_identifiers(editor.view, editor.document)
  let mut index = 0
  while index < identifiers.length() do
    const line_index = text_line_index_of_identifier(editor.document.line_index, identifiers[index])
    if line_index >= 0 then
      const line = text_document_line(editor.document, line_index)
      const row_y = origin_y + index * row_height
      painted = paint_editor_line_number(painted, theme, band.x, row_y, line_index, line_count)
      const span = text_view_line_selection(editor.view, editor.document, line.line_identifier)
      const span_left = span.left - editor.view.horizontal_scroll
      const span_right = span.right - editor.view.horizontal_scroll
      if span_right > span_left then
        painted.push(OpFillRect(FillRectOp {
          rect: rect_new(
            origin_x + span_left,
            row_y,
            span_right - span_left,
            row_height
          ),
          color: theme.selection_background
        }))
      end
      painted = paint_editor_line_text(
        painted,
        theme,
        editor,
        line,
        line_index,
        origin_x,
        row_y + list_row_inset(theme)
      )
      painted = paint_editor_whitespace(painted, editor, line, origin_x, row_y, row_height)
    end
    index = index + 1
  end
  let mut caret_row = 0
  let mut caret_found = false
  let mut caret_index = 0
  while caret_index < identifiers.length() do
    if identifiers[caret_index] == editor.view.caret_line_identifier then
      caret_row = caret_index
      caret_found = true
    end
    caret_index = caret_index + 1
  end
  if caret_found then
    painted.push(OpFillRect(FillRectOp {
      rect: rect_new(origin_x + caret_x(editor), origin_y + caret_row * row_height, 2, row_height),
      color: theme.foreground
    }))
  end
  painted = paint_editor_minimap(painted, theme, editor, band)
  if text_editor_bar_visible(editor) then
    painted.push(OpFillRect(FillRectOp {
      rect: scroll_bar_rect(theme, band),
      color: theme.scrollbar_track
    }))
    painted.push(OpFillRect(FillRectOp {
      rect: scroll_thumb_rect(theme, band, text_editor_scroll_offset(editor), text_editor_content_height(editor)),
      color: theme.scrollbar_thumb
    }))
  end
  painted.push(OpPopClip)
  painted
end
