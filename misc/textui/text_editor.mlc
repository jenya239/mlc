import { TextDocument, text_document_from_bytes, text_document_line } from './text_document'
import { KindTextView } from './store'
import { kind_is_text_view, text_view_open } from './text_view_open'
import { text_line_index_of_identifier } from './text_line_index'
import { TextViewState, text_view_frame, text_view_scroll_to_index, text_view_state_new, text_view_visible_identifiers } from './text_view_state'
import { text_view_move_horizontal, text_view_move_vertical, text_view_press_at } from './text_view_input'
import { text_view_backspace, text_view_break_line, text_view_delete_forward, text_view_insert_text } from './text_view_keys'
import { TextHighlightCursor, text_highlight_cursor_new, text_highlight_cursor_with_language, text_highlight_invalidate } from './text_highlight'
import { syntax_language_from_path } from './text_syntax_language'
import { text_view_save } from './text_view_save'
import { UiInput } from './ui_input'

export type TextEditor = {
  path: string,
  document: TextDocument,
  view: TextViewState,
  open: bool,
  revision: i32,
  gesture: i32,
  edge_clock_ms: i32,
  highlight: TextHighlightCursor,
  minimap_grab_line: i32,
  minimap_grab_y: i32
}

export fn text_editor_gesture_idle() -> i32 = 0

export fn text_editor_gesture_selecting() -> i32 = 1

export fn text_editor_gesture_scrolling() -> i32 = 2

export fn text_editor_gesture_minimap() -> i32 = 3

export type TextEditorChoice =
  EditorKeep
  | EditorClose
  | EditorOpen

export fn text_editor_opens(choice: TextEditorChoice) -> bool =
  match choice
    | EditorOpen => true
    | EditorKeep => false
    | EditorClose => false

export fn text_editor_closes(choice: TextEditorChoice) -> bool =
  match choice
    | EditorClose => true
    | EditorKeep => false
    | EditorOpen => false

export fn text_editor_closed(font_path: string, pixel_size: i32) -> TextEditor = do
  const document = text_document_from_bytes("")
  TextEditor {
    path: "",
    document: document,
    view: text_view_state_new(1, 1, 0, font_path, pixel_size),
    open: false,
    revision: 0,
    gesture: text_editor_gesture_idle(),
    edge_clock_ms: 0,
    highlight: text_highlight_cursor_new(),
    minimap_grab_line: 0,
    minimap_grab_y: 0
  }
end

fn editor_with(editor: TextEditor, path: string, document: TextDocument, view: TextViewState, open: bool) -> TextEditor =
  TextEditor {
    path: path,
    document: document,
    view: view,
    open: open,
    revision: editor.revision + 1,
    gesture: editor.gesture,
    edge_clock_ms: editor.edge_clock_ms,
    highlight: editor.highlight,
    minimap_grab_line: editor.minimap_grab_line,
    minimap_grab_y: editor.minimap_grab_y
  }

export fn text_editor_with_gesture(editor: TextEditor, gesture: i32, edge_clock_ms: i32) -> TextEditor = do
  if editor.gesture == gesture && editor.edge_clock_ms == edge_clock_ms then
    return editor
  end
  TextEditor {
    path: editor.path,
    document: editor.document,
    view: editor.view,
    open: editor.open,
    revision: editor.revision,
    gesture: gesture,
    edge_clock_ms: edge_clock_ms,
    highlight: editor.highlight,
    minimap_grab_line: editor.minimap_grab_line,
    minimap_grab_y: editor.minimap_grab_y
  }
end

export fn text_editor_with_minimap_grab(
  editor: TextEditor,
  gesture: i32,
  edge_clock_ms: i32,
  grab_line: i32,
  grab_y: i32
) -> TextEditor = do
  if editor.gesture == gesture && editor.edge_clock_ms == edge_clock_ms && editor.minimap_grab_line == grab_line && editor.minimap_grab_y == grab_y then
    return editor
  end
  TextEditor {
    path: editor.path,
    document: editor.document,
    view: editor.view,
    open: editor.open,
    revision: editor.revision,
    gesture: gesture,
    edge_clock_ms: edge_clock_ms,
    highlight: editor.highlight,
    minimap_grab_line: grab_line,
    minimap_grab_y: grab_y
  }
end

export fn text_editor_with_highlight(editor: TextEditor, highlight: TextHighlightCursor) -> TextEditor =
  TextEditor {
    path: editor.path,
    document: editor.document,
    view: editor.view,
    open: editor.open,
    revision: editor.revision,
    gesture: editor.gesture,
    edge_clock_ms: editor.edge_clock_ms,
    highlight: highlight,
    minimap_grab_line: editor.minimap_grab_line,
    minimap_grab_y: editor.minimap_grab_y
  }

export fn text_editor_close(editor: TextEditor) -> TextEditor = do
  if editor.open == false then
    return editor
  end
  text_editor_with_gesture(editor_with(editor, "", editor.document, editor.view, false), text_editor_gesture_idle(), 0)
end

export fn text_editor_choice(
  editor_open: bool,
  current_path: string,
  pressed: bool,
  in_file_list: bool,
  press_in_editor: bool,
  name: string,
  candidate: string
) -> TextEditorChoice = do
  if pressed == false || press_in_editor || in_file_list == false || name == "" then
    return EditorKeep
  end
  if candidate != "" then
    if editor_open && candidate == current_path then
      return EditorKeep
    end
    return EditorOpen
  end
  EditorClose
end

fn viewport_of(viewport_height: i32, row_height: i32) -> i32 = do
  if viewport_height >= row_height && row_height > 0 then
    return viewport_height
  end
  if row_height > 0 then
    return row_height * 8
  end
  1
end

export fn text_editor_open_document(
  editor: TextEditor,
  path: string,
  document: TextDocument,
  viewport_height: i32,
  row_height: i32,
  font_path: string,
  pixel_size: i32
) -> TextEditor = do
  const height = viewport_of(viewport_height, row_height)
  let mut view = text_view_frame(text_view_state_new(height, row_height, 0, font_path, pixel_size), document)
  const first = text_document_line(document, 0)
  view = text_view_press_at(view, document, KindTextView, first.line_identifier, 0, false)
  text_editor_with_highlight(
    text_editor_with_gesture(editor_with(editor, path, document, view, true), text_editor_gesture_idle(), 0),
    text_highlight_cursor_with_language(syntax_language_from_path(path))
  )
end

export fn text_editor_open_path(
  editor: TextEditor,
  path: string,
  viewport_height: i32,
  row_height: i32,
  font_path: string,
  pixel_size: i32
) -> TextEditor = do
  const opened = text_view_open(path, 65536, 40, row_height)
  if kind_is_text_view(opened.kind) == false then
    return editor
  end
  text_editor_open_document(editor, path, opened.document, viewport_height, row_height, font_path, pixel_size)
end

fn view_changed(before: TextViewState, after: TextViewState) -> bool = do
  if before.caret_line_identifier != after.caret_line_identifier || before.caret_byte != after.caret_byte then
    return true
  end
  if before.bound_line_identifier != after.bound_line_identifier || before.bound_byte != after.bound_byte then
    return true
  end
  before.anchor_line_identifier != after.anchor_line_identifier || before.anchor_vertical_offset != after.anchor_vertical_offset
end

fn with_view(editor: TextEditor, view: TextViewState) -> TextEditor = do
  if view_changed(editor.view, view) == false then
    return editor
  end
  editor_with(editor, editor.path, editor.document, view, true)
end

export fn text_editor_place(
  editor: TextEditor,
  origin_x: i32,
  origin_y: i32,
  row_height: i32,
  mouse_x: i32,
  mouse_y: i32,
  keep_bound: bool
) -> TextEditor = do
  if editor.open == false || row_height < 1 then
    return editor
  end
  const identifiers = text_view_visible_identifiers(editor.view, editor.document)
  if identifiers.length() == 0 then
    return editor
  end
  let mut row = 0
  const local_y = mouse_y - origin_y
  if local_y > 0 then
    row = local_y / row_height
  end
  if row < 0 then
    row = 0
  end
  if row >= identifiers.length() then
    row = identifiers.length() - 1
  end
  const placed = text_view_press_at(
    editor.view,
    editor.document,
    KindTextView,
    identifiers[row],
    mouse_x - origin_x,
    keep_bound
  )
  with_view(editor, placed)
end

export fn text_editor_scroll_to_line(editor: TextEditor, line_index: i32) -> TextEditor = do
  if editor.open == false then
    return editor
  end
  const framed = text_view_frame(text_view_scroll_to_index(editor.view, editor.document, line_index), editor.document)
  with_view(editor, framed)
end

fn accepted_edit(editor: TextEditor, document: TextDocument, view: TextViewState) -> TextEditor = do
  let mut line_index = text_line_index_of_identifier(document.line_index, view.caret_line_identifier)
  if line_index < 0 then
    line_index = 0
  end
  const invalidated = text_editor_with_highlight(editor, text_highlight_invalidate(editor.highlight, line_index))
  editor_with(invalidated, invalidated.path, document, view, true)
end

export fn text_editor_on_input(editor: TextEditor, input: UiInput, field_focused: bool, overlay_open: bool, jail: string) -> TextEditor = do
  if editor.open == false || field_focused || overlay_open then
    return editor
  end
  if input.control_down && input.binding_key == "s" then
    text_view_save(editor.path, jail, editor.document)
    return editor
  end
  if input.backspace_pressed then
    const result = text_view_backspace(editor.view, editor.document)
    if result.accepted then
      return accepted_edit(editor, result.document, result.state)
    end
  end
  if input.enter_pressed then
    const result = text_view_break_line(editor.view, editor.document)
    if result.accepted then
      return accepted_edit(editor, result.document, result.state)
    end
  end
  if input.binding_key == "delete" then
    const result = text_view_delete_forward(editor.view, editor.document)
    if result.accepted then
      return accepted_edit(editor, result.document, result.state)
    end
  end
  let mut view = editor.view
  let mut moved = false
  if input.binding_key == "left" then
    view = text_view_move_horizontal(view, editor.document, 0 - 1, input.shift_down)
    moved = true
  end
  if input.binding_key == "right" then
    view = text_view_move_horizontal(view, editor.document, 1, input.shift_down)
    moved = true
  end
  if input.binding_key == "up" then
    view = text_view_move_vertical(view, editor.document, 0 - 1, input.shift_down)
    moved = true
  end
  if input.binding_key == "down" then
    view = text_view_move_vertical(view, editor.document, 1, input.shift_down)
    moved = true
  end
  if input.wheel_y != 0 then
    const anchor = text_line_index_of_identifier(editor.document.line_index, view.anchor_line_identifier)
    view = text_view_frame(text_view_scroll_to_index(view, editor.document, anchor + input.wheel_y), editor.document)
    moved = true
  end
  if moved then
    return with_view(editor, view)
  end
  if input.control_down then
    return editor
  end
  if input.paste_text != "" then
    const result = text_view_insert_text(editor.view, editor.document, input.paste_text)
    if result.accepted then
      return accepted_edit(editor, result.document, result.state)
    end
  end
  if input.text != "" && input.enter_pressed == false && input.backspace_pressed == false then
    const result = text_view_insert_text(editor.view, editor.document, input.text)
    if result.accepted then
      return accepted_edit(editor, result.document, result.state)
    end
  end
  editor
end
