import { Theme } from './theme'
import { LayoutResult } from './layout_result'
import { hit_test } from './hit'
import {
  BoxData,
  DirectionColumn,
  ListData,
  OverflowHidden,
  WidgetId,
  WidgetKind,
  WidgetStore,
  kind_is_list_view,
  widget_id_equals,
  widget_id_is_none,
  widget_id_none,
  widget_store_add_box,
  widget_store_add_list_view,
  widget_store_set_visible,
  widget_store_with_menu,
  widget_store_with_overlay,
  widget_store_with_place
} from './store'
import { UiEvent, ui_event_button_clicked, ui_event_row_activated } from './ui_event'
import { UiInput } from './ui_input'
import { UiState, PointerSession, ui_state_with_list_selected } from './ui_state'
import { list_index_at, list_selected_at, list_selected_put } from './widget_list'
import {
  OverlayView,
  overlay_dismiss,
  ui_state_with_overlay_open,
  ui_state_with_overlay_revision
} from './overlay'

export type MenuRelease = {
  state: UiState,
  events: [UiEvent]
}

export type MenuHost = {
  store: WidgetStore,
  state: UiState,
  right_down: bool,
  target_list: i32,
  target_row: i32
}

fn layer_box() -> BoxData =
  BoxData { direction: DirectionColumn, padding: 0, gap: 0 }

fn view_of(store: WidgetStore, state: UiState) -> OverlayView =
  OverlayView { store: store, state: state }

fn list_texts_of(kind: WidgetKind) -> [string] =
  match kind
    | KindListView(data) => data.texts
    | KindBox(_) => []
    | KindLabel(_) => []
    | KindIcon(_) => []
    | KindButton(_) => []
    | KindCheckbox(_) => []
    | KindScrollView => []
    | KindSplitter(_) => []
    | KindTextField(_) => []

fn list_row_text(kind: WidgetKind, row: i32) -> string = do
  const texts = list_texts_of(kind)
  if row < 0 || row >= texts.length() then
    return ""
  end
  return texts[row]
end

fn file_row(text: string) -> bool = do
  if text == ".." || text.byte_size() == 0 then
    return false
  end
  return text.byte_at(text.byte_size() - 1) != "/"
end

export fn menu_list_id(store: WidgetStore) -> WidgetId = do
  if widget_id_is_none(store.menu) then
    return widget_id_none()
  end
  const children = store.nodes[store.menu.index].children
  if children.length() == 0 then
    return widget_id_none()
  end
  return children[0]
end

export fn attach_file_menu(store: WidgetStore) -> WidgetStore = do
  let mut next = widget_store_add_box(
    store, widget_id_none(), layer_box(), OverflowHidden, 0, false
  )
  const layer = next.nodes[next.nodes.length() - 1].id
  next = widget_store_with_menu(next, layer)
  let mut rows: [string] = []
  rows.push("Open")
  rows.push("Rename")
  rows.push("Delete")
  return widget_store_add_list_view(next, layer, ListData { texts: rows }, 0, true)
end

export fn menu_open(store: WidgetStore, state: UiState, x: i32, y: i32) -> OverlayView = do
  if widget_id_is_none(store.menu) then
    return view_of(store, state)
  end
  let mut next = store
  if widget_id_is_none(store.about) == false then
    next = widget_store_set_visible(next, store.about, false)
  end
  if widget_id_is_none(store.dialog) == false then
    next = widget_store_set_visible(next, store.dialog, false)
  end
  next = widget_store_with_overlay(next, store.menu)
  next = widget_store_with_place(next, x, y, true)
  next = widget_store_set_visible(next, store.menu, true)
  const list_id = menu_list_id(next)
  return view_of(
    next,
    ui_state_with_list_selected(
      ui_state_with_overlay_revision(
        ui_state_with_overlay_open(state, true),
        state.overlay_revision + 1
      ),
      list_selected_put(state.list_selected, list_id.index, 0)
    )
  )
end

fn no_menu_events() -> [UiEvent] = do
  let mut events: [UiEvent] = []
  return events
end

fn pointer_is_click(pointer: PointerSession) -> bool =
  match pointer
    | PointerClickSession(_) => true
    | PointerIdle => false
    | PointerText(_) => false
    | PointerScrollSession(_) => false
    | PointerListSession(_) => false
    | PointerSplitSession(_) => false

fn menu_events(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  input: UiInput
) -> [UiEvent] = do
  let mut events: [UiEvent] = []
  const list_id = menu_list_id(store)
  const hit = hit_test(store, layout, theme, input.mouse_x, input.mouse_y)
  if widget_id_equals(hit, list_id) then
    const row = list_index_at(
      layout.rects[list_id.index],
      theme,
      list_texts_of(store.nodes[list_id.index].kind).length(),
      input.mouse_y
    )
    if row >= 0 then
      events.push(ui_event_row_activated(list_id))
      return events
    end
  end
  events.push(ui_event_button_clicked(store.overlay))
  return events
end

fn menu_row_state(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> UiState = do
  const list_id = menu_list_id(store)
  const hit = hit_test(store, layout, theme, input.mouse_x, input.mouse_y)
  if widget_id_equals(hit, list_id) == false then
    return state
  end
  const row = list_index_at(
    layout.rects[list_id.index],
    theme,
    list_texts_of(store.nodes[list_id.index].kind).length(),
    input.mouse_y
  )
  if row < 0 then
    return state
  end
  return ui_state_with_list_selected(
    state,
    list_selected_put(state.list_selected, list_id.index, row)
  )
end

export fn menu_follow_hover(
  store: WidgetStore,
  state: UiState,
  previous_hover: WidgetId,
  previous_row: i32
) -> UiState = do
  if store.placed == false then
    return state
  end
  if state.overlay_open == false then
    return state
  end
  const list_id = menu_list_id(store)
  if widget_id_equals(state.hover, list_id) == false then
    return state
  end
  if state.list_hover_row < 0 then
    return state
  end
  if widget_id_equals(state.hover, previous_hover) then
    if state.list_hover_row == previous_row then
      return state
    end
  end
  return ui_state_with_list_selected(
    state,
    list_selected_put(state.list_selected, list_id.index, state.list_hover_row)
  )
end

export fn menu_release(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> MenuRelease = do
  if pointer_is_click(state.pointer) == false then
    return MenuRelease { state: state, events: no_menu_events() }
  end
  return MenuRelease {
    state: menu_row_state(store, layout, theme, state, input),
    events: menu_events(store, layout, theme, input)
  }
end

fn menu_row_count(store: WidgetStore) -> i32 = do
  const list_id = menu_list_id(store)
  if widget_id_is_none(list_id) then
    return 0
  end
  return list_texts_of(store.nodes[list_id.index].kind).length()
end

fn stepped_row(row: i32, count: i32, delta: i32) -> i32 = do
  let mut index = row
  if index < 0 && delta > 0 then
    index = 0 - 1
  end
  if index < 0 && delta < 0 then
    index = count
  end
  index = index + delta
  if index < 0 then
    index = 0
  end
  if index >= count then
    index = count - 1
  end
  return index
end

fn put_menu_row(state: UiState, list_id: WidgetId, row: i32) -> UiState =
  ui_state_with_list_selected(state, list_selected_put(state.list_selected, list_id.index, row))

export fn menu_keys(store: WidgetStore, state: UiState, input: UiInput) -> MenuRelease = do
  const list_id = menu_list_id(store)
  const count = menu_row_count(store)
  if count <= 0 then
    return MenuRelease { state: state, events: no_menu_events() }
  end
  let mut row = list_selected_at(state.list_selected, list_id.index)
  let mut moved = false
  if input.binding_key == "down" then
    row = stepped_row(row, count, 1)
    moved = true
  end
  if input.binding_key == "up" then
    row = stepped_row(row, count, 0 - 1)
    moved = true
  end
  if input.binding_key == "home" then
    row = 0
    moved = true
  end
  if input.binding_key == "end" then
    row = count - 1
    moved = true
  end
  let mut next = state
  if moved then
    next = put_menu_row(state, list_id, row)
  end
  if input.enter_pressed && row >= 0 then
    let mut events: [UiEvent] = []
    events.push(ui_event_row_activated(list_id))
    return MenuRelease { state: put_menu_row(next, list_id, row), events: events }
  end
  return MenuRelease { state: next, events: no_menu_events() }
end

export fn menu_apply(store: WidgetStore, state: UiState, events: [UiEvent]) -> OverlayView = do
  let mut view = view_of(store, state)
  let mut index = 0
  while index < events.length() do
    const event = events[index]
    if event.activated && widget_id_equals(event.widget, menu_list_id(view.store)) then
      view = overlay_dismiss(view.store, view.state)
    end
    index = index + 1
  end
  return view
end

fn host_unchanged(
  store: WidgetStore,
  state: UiState,
  right_down: bool,
  target_list: i32,
  target_row: i32
) -> MenuHost =
  MenuHost {
    store: store,
    state: state,
    right_down: right_down,
    target_list: target_list,
    target_row: target_row
  }

export fn menu_host_step(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  right_down: bool,
  right_was_down: bool,
  x: i32,
  y: i32,
  target_list: i32,
  target_row: i32
) -> MenuHost = do
  const pressed = right_down && right_was_down == false
  if pressed == false then
    return host_unchanged(store, state, right_down, target_list, target_row)
  end
  if state.overlay_open && store.placed then
    const closed = overlay_dismiss(store, state)
    return host_unchanged(closed.store, closed.state, right_down, target_list, target_row)
  end
  if state.overlay_open then
    return host_unchanged(store, state, right_down, target_list, target_row)
  end
  const hit = hit_test(store, layout, theme, x, y)
  if widget_id_is_none(hit) then
    return host_unchanged(store, state, right_down, target_list, target_row)
  end
  if kind_is_list_view(store.nodes[hit.index].kind) == false then
    return host_unchanged(store, state, right_down, target_list, target_row)
  end
  const row = list_index_at(
    layout.rects[hit.index],
    theme,
    list_texts_of(store.nodes[hit.index].kind).length(),
    y
  )
  if file_row(list_row_text(store.nodes[hit.index].kind, row)) == false then
    return host_unchanged(store, state, right_down, target_list, target_row)
  end
  const opened = menu_open(store, state, x, y)
  return MenuHost {
    store: opened.store,
    state: opened.state,
    right_down: right_down,
    target_list: hit.index,
    target_row: row
  }
end
