import { TextLayout } from './text_layout'
import {
  text_layout_line_at_y,
  text_layout_line_end_target,
  text_layout_line_of_byte
} from './text_layout_lines'

export type SelectionBox = {
  x: i32,
  y: i32,
  width: i32,
  height: i32
}

export type ByteRange = {
  start: i32,
  finish: i32
}

fn clamp_byte(layout: TextLayout, index: i32) -> i32 = do
  if index < 0 then
    return 0
  end
  const limit = layout.text.byte_size()
  if index > limit then
    return limit
  end
  index
end

fn ordered_range(first: i32, second: i32) -> ByteRange = do
  if first <= second then
    return ByteRange { start: first, finish: second }
  end
  ByteRange { start: second, finish: first }
end

export fn text_layout_caret_x(layout: TextLayout, byte_index: i32) -> i32 = do
  const index = clamp_byte(layout, byte_index)
  if layout.lines.length() == 0 then
    return layout.pixel_width
  end
  const line_index = text_layout_line_of_byte(layout, index)
  const line = layout.lines[line_index]
  let mut cluster_index = 0
  while cluster_index < layout.clusters.length() do
    const cluster = layout.clusters[cluster_index]
    if cluster.line_index == line_index && cluster.byte_offset >= index then
      return cluster.x
    end
    cluster_index = cluster_index + 1
  end
  line.width
end

export type CaretPoint = {
  x: i32,
  y: i32,
  height: i32
}

export fn text_layout_caret_point(layout: TextLayout, byte_index: i32) -> CaretPoint = do
  const index = clamp_byte(layout, byte_index)
  const caret_x = text_layout_caret_x(layout, index)
  if layout.lines.length() == 0 then
    return CaretPoint { x: caret_x, y: 0, height: layout.pixel_height }
  end
  const line = layout.lines[text_layout_line_of_byte(layout, index)]
  CaretPoint { x: caret_x, y: line.top, height: line.height }
end

export fn text_layout_index_at(layout: TextLayout, x: i32, y: i32) -> i32 = do
  if layout.lines.length() == 0 then
    return 0
  end
  const line_index = text_layout_line_at_y(layout, y)
  const line = layout.lines[line_index]
  if x <= 0 then
    return line.byte_start
  end
  let mut cluster_index = 0
  while cluster_index < layout.clusters.length() do
    const cluster = layout.clusters[cluster_index]
    if cluster.line_index == line_index then
      const midpoint = cluster.x + cluster.width / 2
      if x < midpoint then
        return cluster.byte_offset
      end
    end
    cluster_index = cluster_index + 1
  end
  text_layout_line_end_target(layout, line_index)
end

export fn text_layout_slice(layout: TextLayout, start_index: i32, end_index: i32) -> string = do
  const range = ordered_range(clamp_byte(layout, start_index), clamp_byte(layout, end_index))
  if range.finish <= range.start then
    return ""
  end
  layout.text.byte_substring(range.start, range.finish - range.start)
end

export fn text_layout_selection_rects(
  layout: TextLayout,
  start_index: i32,
  end_index: i32
) -> [SelectionBox] = do
  let mut rects: [SelectionBox] = []
  const range = ordered_range(clamp_byte(layout, start_index), clamp_byte(layout, end_index))
  if range.finish <= range.start then
    return rects
  end
  if layout.lines.length() == 0 then
    return rects
  end
  const start_line = text_layout_line_of_byte(layout, range.start)
  const finish_line = text_layout_line_of_byte(layout, range.finish)
  let mut line_index = start_line
  while line_index <= finish_line do
    const line = layout.lines[line_index]
    let mut box_x = 0
    if line_index == start_line then
      box_x = text_layout_caret_x(layout, range.start)
    end
    let mut box_width = line.width - box_x
    if line_index == finish_line then
      box_width = text_layout_caret_x(layout, range.finish) - box_x
    end
    if box_width <= 0 && line_index != start_line && line_index != finish_line then
      box_width = layout.pixel_size / 4
    end
    if box_width > 0 then
      rects.push(SelectionBox {
        x: box_x,
        y: line.top,
        width: box_width,
        height: line.height
      })
    end
    line_index = line_index + 1
  end
  rects
end

fn byte_is_word(text: string, index: i32) -> bool = do
  if index < 0 || index >= text.byte_size() then
    return false
  end
  return word_character_set().contains(text.byte_at(index))
end

export fn text_word_before(text: string, index: i32) -> i32 = do
  let mut cursor = index
  if cursor > text.byte_size() then
    cursor = text.byte_size()
  end
  if cursor <= 0 then
    return 0
  end
  cursor = cursor - 1
  while cursor > 0 && byte_is_word(text, cursor) == false do
    cursor = cursor - 1
  end
  while cursor > 0 && byte_is_word(text, cursor - 1) do
    cursor = cursor - 1
  end
  return cursor
end

export fn text_word_after(text: string, index: i32) -> i32 = do
  let mut cursor = index
  const limit = text.byte_size()
  if cursor < 0 then
    cursor = 0
  end
  if cursor >= limit then
    return limit
  end
  while cursor < limit && byte_is_word(text, cursor) == false do
    cursor = cursor + 1
  end
  while cursor < limit && byte_is_word(text, cursor) do
    cursor = cursor + 1
  end
  return cursor
end

fn word_character_set() -> string =
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn is_word_byte(layout: TextLayout, byte_index: i32) -> bool = do
  if byte_index < 0 then
    return false
  end
  if byte_index >= layout.text.byte_size() then
    return false
  end
  word_character_set().contains(layout.text.byte_at(byte_index))
end

export fn text_layout_word_range(layout: TextLayout, byte_index: i32) -> ByteRange = do
  const limit = layout.text.byte_size()
  if limit == 0 then
    return ByteRange { start: 0, finish: 0 }
  end
  let mut index = clamp_byte(layout, byte_index)
  if index >= limit then
    index = limit - 1
  end
  const kind = is_word_byte(layout, index)
  let mut start = index
  while start > 0 && is_word_byte(layout, start - 1) == kind do
    start = start - 1
  end
  let mut finish = index + 1
  while finish < limit && is_word_byte(layout, finish) == kind do
    finish = finish + 1
  end
  ByteRange { start: start, finish: finish }
end

export fn text_layout_boundary_before(layout: TextLayout, index: i32) -> i32 = do
  let mut boundary = 0
  let mut cluster_index = 0
  while cluster_index < layout.clusters.length() do
    const offset = layout.clusters[cluster_index].byte_offset
    if offset < index && offset >= boundary then
      boundary = offset
    end
    cluster_index = cluster_index + 1
  end
  return boundary
end

export fn text_layout_boundary_after(layout: TextLayout, index: i32) -> i32 = do
  let mut boundary = layout.text.byte_size()
  let mut cluster_index = 0
  while cluster_index < layout.clusters.length() do
    const offset = layout.clusters[cluster_index].byte_offset
    if offset > index && offset < boundary then
      boundary = offset
    end
    cluster_index = cluster_index + 1
  end
  return boundary
end
