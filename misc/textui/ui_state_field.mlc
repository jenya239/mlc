import { UiState } from './ui_state'

export fn ui_state_with_field_revision(state: UiState, field_revision: i32) -> UiState =
  UiState {
    selection: state.selection,
    grab: state.grab,
    pointer: state.pointer,
    last_press: state.last_press,
    clipboard: state.clipboard,
    hover: state.hover,
    scroll_offsets: state.scroll_offsets,
    pick_enabled: state.pick_enabled,
    inspected: state.inspected,
    list_selected: state.list_selected,
    list_marks: state.list_marks,
    list_hover_row: state.list_hover_row,
    splitter_ratios: state.splitter_ratios,
    focus: state.focus,
    field_caret: state.field_caret,
    field_scroll_x: state.field_scroll_x,
    field_revision: field_revision,
    listing_revision: state.listing_revision,
    overlay_open: state.overlay_open,
    overlay_revision: state.overlay_revision
  }
