extern fn i32_to_f64(value: i32) -> f64 = "mlc::math::i32_to_f64" from "mlc/math/math.hpp"

import { guest_timer_remaining } from '../../script_vm/guest_timer'
import { host_import_label_set_text } from '../../script_vm/host_imports'
import { host_call_import_index } from '../../script_vm/lower/lower_host_call'
import { value_int32 } from '../../script_vm/value'
import { button_caption } from './app_input'
import { FrameSignature, frame_signature_with_script_damage } from './frame_request'
import {
  GalleryGuest,
  gallery_guest_accept_control,
  gallery_guest_clear_requests,
  gallery_guest_ping,
  gallery_guest_tick
} from './gallery_guest'
import { apply_host_queue } from './host_command'
import { script_frame_pump_drain, script_frame_pump_name, script_frame_pump_new } from './script_events'
import { UiState } from './ui_state'
import { UiEvent } from './ui_event'
import { frame_wait_seconds } from './visual_effect'
import { WidgetStore } from './store'

fn drain_frame_pump() -> string = do
  let drained = script_frame_pump_drain(script_frame_pump_new())
  drained.last_drain
end

fn caption_is_ping(store: WidgetStore, event: UiEvent) -> bool = do
  if event.widget.index < 0 || event.widget.index >= store.nodes.length() then
    return false
  end
  button_caption(store, event.widget) == "Ping"
end

fn events_request_ping(store: WidgetStore, events: [UiEvent]) -> bool = do
  let mut index = 0
  let mut requested = false
  while index < events.length() && requested == false do
    if caption_is_ping(store, events[index]) then
      requested = true
    end
    index = index + 1
  end
  requested
end

fn label_set_text_index() -> i32 =
  host_call_import_index(host_import_label_set_text().operation_id)

fn waiting_for_label(guest: GalleryGuest) -> bool =
  guest.halt.outcome == "waiting" && guest.halt.state.host_import_index == label_set_text_index()

fn guest_with_store(guest: GalleryGuest, store: WidgetStore) -> GalleryGuest =
  GalleryGuest {
    store: store,
    halt: guest.halt,
    prototypes: guest.prototypes,
    widget: guest.widget,
    revision: guest.revision,
    timer_origin_milliseconds: guest.timer_origin_milliseconds,
    timer_armed: guest.timer_armed,
    guest_released: guest.guest_released,
    effect_requested: guest.effect_requested,
    effect_mode: guest.effect_mode,
    reload_requested: guest.reload_requested
  }

export fn gallery_frame_advance(
  guest: GalleryGuest,
  store: WidgetStore,
  events: [UiEvent],
  now_milliseconds: i32
) -> GalleryGuest = do
  let drained = drain_frame_pump()
  if drained != script_frame_pump_name() then
    return guest_with_store(guest, store)
  end
  let cleared = gallery_guest_clear_requests(guest_with_store(guest, store))
  let queued = apply_host_queue(cleared)
  let ticked = gallery_guest_tick(queued, now_milliseconds)
  let controlled = gallery_guest_accept_control(ticked)
  let follow_label = events_request_ping(controlled.store, events) || (controlled.guest_released && waiting_for_label(controlled))
  let stepped = if follow_label then gallery_guest_ping(controlled, controlled.store) else controlled
  if stepped.revision != ticked.revision then
    println("[textui] vm label step")
  end
  gallery_guest_tick(stepped, now_milliseconds)
end

export fn gallery_frame_signature(
  guest: GalleryGuest,
  state: UiState,
  viewport_width: i32,
  viewport_height: i32
) -> FrameSignature =
  frame_signature_with_script_damage(state, viewport_width, viewport_height, guest.revision)

export fn gallery_frame_wait_seconds(
  guest: GalleryGuest,
  effect_mode: i32,
  preview_playing: i32,
  music_running: i32,
  now_milliseconds: i32
) -> f64 = do
  if guest.halt.outcome == "yielded" then
    return 0.0
  end
  if guest.timer_armed && guest.halt.outcome == "waiting" then
    let remaining = guest_timer_remaining(
      guest.timer_origin_milliseconds,
      value_int32(guest.halt.argument),
      now_milliseconds
    )
    if remaining <= 0 then
      return 0.0
    end
    return i32_to_f64(remaining) / 1000.0
  end
  let base = frame_wait_seconds(effect_mode, preview_playing, music_running)
  if base < 0.0 || base > 0.25 then
    return 0.25
  end
  base
end
