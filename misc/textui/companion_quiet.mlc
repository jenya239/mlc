import { json_escape } from './chat_json'

export type CompanionMemory = {
  path: string,
  byte_size: i32,
  modified_seconds: i32,
  remark: string
}

export type CompanionMemoryHit = {
  found: bool,
  remark: string
}

export type CompanionQuiet = {
  digest: string,
  stable_since_milliseconds: i32,
  sent_digest: string,
  remark: string,
  attempt_milliseconds: i32,
  attempted: i32,
  waiting: i32,
  history: [string],
  sent_label: string,
  sent_path: string,
  sent_byte_size: i32,
  sent_modified_seconds: i32,
  sent_excerpt: i32,
  memory: [CompanionMemory]
}

fn unknown_measure() -> i32 = 0 - 1

fn memory_empty() -> [CompanionMemory] = do
  let mut memory: [CompanionMemory] = []
  memory
end

export fn companion_quiet_empty() -> CompanionQuiet =
  CompanionQuiet {
    digest: "",
    stable_since_milliseconds: 0,
    sent_digest: "",
    remark: "",
    attempt_milliseconds: 0,
    attempted: 0,
    waiting: 0,
    history: [],
    sent_label: "",
    sent_path: "",
    sent_byte_size: unknown_measure(),
    sent_modified_seconds: unknown_measure(),
    sent_excerpt: 0,
    memory: memory_empty()
  }

export fn companion_empty_digest() -> string =
  "Действия\nпока пусто\n\nКонтекст для модели\nпока пусто"

export fn companion_settle_milliseconds() -> i32 = 2000

export fn companion_cooldown_milliseconds() -> i32 = 15000

fn elapsed_milliseconds(now_milliseconds: i32, start_milliseconds: i32) -> i32 = do
  if now_milliseconds < start_milliseconds then
    return 0
  end
  now_milliseconds - start_milliseconds
end

fn companion_with_digest(quiet: CompanionQuiet, digest: string, now_milliseconds: i32) -> CompanionQuiet =
  CompanionQuiet {
    digest: digest,
    stable_since_milliseconds: now_milliseconds,
    sent_digest: quiet.sent_digest,
    remark: quiet.remark,
    attempt_milliseconds: quiet.attempt_milliseconds,
    attempted: quiet.attempted,
    waiting: quiet.waiting,
    history: quiet.history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: quiet.memory
  }

export fn companion_quiet_advance(quiet: CompanionQuiet, digest: string, now_milliseconds: i32) -> CompanionQuiet = do
  if digest == quiet.digest then
    return quiet
  end
  companion_with_digest(quiet, digest, now_milliseconds)
end

export fn companion_quiet_due(quiet: CompanionQuiet, now_milliseconds: i32) -> bool = do
  if quiet.waiting != 0 then
    return false
  end
  if quiet.digest == "" || quiet.digest == companion_empty_digest() then
    return false
  end
  if quiet.digest == quiet.sent_digest then
    return false
  end
  if elapsed_milliseconds(now_milliseconds, quiet.stable_since_milliseconds) < companion_settle_milliseconds() then
    return false
  end
  if quiet.attempted != 0 && elapsed_milliseconds(now_milliseconds, quiet.attempt_milliseconds) < companion_cooldown_milliseconds() then
    return false
  end
  true
end

fn companion_marked(quiet: CompanionQuiet, now_milliseconds: i32, waiting: i32) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.digest,
    remark: quiet.remark,
    attempt_milliseconds: now_milliseconds,
    attempted: 1,
    waiting: waiting,
    history: quiet.history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: quiet.memory
  }

export fn companion_quiet_commit(
  quiet: CompanionQuiet,
  now_milliseconds: i32,
  waiting: i32,
  label: string,
  path: string,
  byte_size: i32,
  modified_seconds: i32,
  excerpt_included: i32
) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.digest,
    sent_label: label,
    sent_path: path,
    sent_byte_size: byte_size,
    sent_modified_seconds: modified_seconds,
    sent_excerpt: excerpt_included,
    remark: quiet.remark,
    attempt_milliseconds: now_milliseconds,
    attempted: 1,
    waiting: waiting,
    history: quiet.history,
    memory: quiet.memory
  }

export fn companion_quiet_mark_sent(quiet: CompanionQuiet, now_milliseconds: i32) -> CompanionQuiet =
  companion_marked(quiet, now_milliseconds, 0)

export fn companion_quiet_begin_wait(quiet: CompanionQuiet, now_milliseconds: i32) -> CompanionQuiet =
  companion_marked(quiet, now_milliseconds, 1)

export fn companion_quiet_with_remark(quiet: CompanionQuiet, remark: string) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.sent_digest,
    remark: remark,
    attempt_milliseconds: quiet.attempt_milliseconds,
    attempted: quiet.attempted,
    waiting: quiet.waiting,
    history: quiet.history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: quiet.memory
  }

export fn companion_quiet_with_history(quiet: CompanionQuiet, history: [string]) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.sent_digest,
    remark: quiet.remark,
    attempt_milliseconds: quiet.attempt_milliseconds,
    attempted: quiet.attempted,
    waiting: quiet.waiting,
    history: history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: quiet.memory
  }

export fn companion_quiet_with_memory(quiet: CompanionQuiet, memory: [CompanionMemory]) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.sent_digest,
    remark: quiet.remark,
    attempt_milliseconds: quiet.attempt_milliseconds,
    attempted: quiet.attempted,
    waiting: quiet.waiting,
    history: quiet.history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: memory
  }

export fn companion_quiet_finish(quiet: CompanionQuiet, remark: string) -> CompanionQuiet =
  CompanionQuiet {
    digest: quiet.digest,
    stable_since_milliseconds: quiet.stable_since_milliseconds,
    sent_digest: quiet.sent_digest,
    remark: remark,
    attempt_milliseconds: quiet.attempt_milliseconds,
    attempted: quiet.attempted,
    waiting: 0,
    history: quiet.history,
    sent_label: quiet.sent_label,
    sent_path: quiet.sent_path,
    sent_byte_size: quiet.sent_byte_size,
    sent_modified_seconds: quiet.sent_modified_seconds,
    sent_excerpt: quiet.sent_excerpt,
    memory: quiet.memory
  }

fn first_line(text: string) -> string = do
  let mut index = 0
  while index < text.byte_size() && text.byte_at(index) != "\n" do
    index = index + 1
  end
  text.byte_substring(0, index).trim()
end

fn silence_line(line: string) -> bool = do
  if line == "" || line == "тишина" || line == "Тишина" || line == "silence" || line == "Silence" then
    return true
  end
  if line.byte_size() <= 16 && line.index_of("тишина") == 0 then
    return true
  end
  if line.byte_size() <= 16 && line.index_of("silence") == 0 then
    return true
  end
  false
end

export fn companion_remark_from_reply(text: string) -> string = do
  const line = first_line(text)
  if silence_line(line) then
    return ""
  end
  if line.length() > 160 then
    return line.substring(0, 160)
  end
  line
end

export fn companion_mind(occupation: string, quiet: CompanionQuiet) -> string = do
  if occupation == "пока пусто" && quiet.waiting == 0 && quiet.remark == "" then
    return "молчит"
  end
  if quiet.waiting != 0 then
    return "сейчас"
  end
  if quiet.digest != quiet.sent_digest then
    return "присматривается"
  end
  if quiet.remark != "" then
    return quiet.remark
  end
  if quiet.attempted != 0 then
    return "тишина"
  end
  "присматривается"
end

export fn companion_status(occupation: string, quiet: CompanionQuiet) -> string =
  "занят: " + occupation + "\nдумает: " + companion_mind(occupation, quiet)

export fn companion_state_marker() -> string =
  "\n\nСостояние компаньона\n"

export fn companion_journal_shown(digest: string, detail: string) -> string = do
  if detail == "" then
    return digest
  end
  digest + companion_state_marker() + detail
end

fn clipped_digest(digest: string) -> string = do
  if digest.byte_size() <= 4000 then
    return digest
  end
  let mut drop = 0
  while drop < digest.length() && digest.substring(drop).byte_size() > 4000 do
    drop = drop + 64
  end
  while drop > 0 && digest.substring(drop - 1).byte_size() <= 4000 do
    drop = drop - 1
  end
  digest.substring(drop)
end

fn companion_instruction() -> string =
  "Тебе передали один эпизод и имена с экрана, если они есть. Если передано начало файла, это первые символы одного текстового файла, не весь файл. Ответь одной короткой русской фразой о том, что перед человеком. Без совета и без вопроса. Если нет ни имён, ни начала файла, ответь ровно: тишина"

fn memory_limit() -> i32 = 16

fn memory_same(item: CompanionMemory, path: string, byte_size: i32, modified_seconds: i32) -> bool =
  item.path == path && item.byte_size == byte_size && item.modified_seconds == modified_seconds

export fn companion_memory_find(
  quiet: CompanionQuiet,
  path: string,
  byte_size: i32,
  modified_seconds: i32
) -> CompanionMemoryHit = do
  if path == "" || modified_seconds < 0 then
    return CompanionMemoryHit { found: false, remark: "" }
  end
  let mut index = quiet.memory.length() - 1
  while index >= 0 do
    if memory_same(quiet.memory[index], path, byte_size, modified_seconds) then
      return CompanionMemoryHit { found: true, remark: quiet.memory[index].remark }
    end
    index = index - 1
  end
  CompanionMemoryHit { found: false, remark: "" }
end

export fn companion_memory_remember(
  quiet: CompanionQuiet,
  path: string,
  byte_size: i32,
  modified_seconds: i32,
  remark: string
) -> CompanionQuiet = do
  if path == "" || modified_seconds < 0 || remark == "модель недоступна" then
    return quiet
  end
  let mut kept: [CompanionMemory] = []
  let mut index = 0
  while index < quiet.memory.length() do
    if memory_same(quiet.memory[index], path, byte_size, modified_seconds) == false then
      kept.push(quiet.memory[index])
    end
    index = index + 1
  end
  kept.push(CompanionMemory {
    path: path,
    byte_size: byte_size,
    modified_seconds: modified_seconds,
    remark: remark
  })
  if kept.length() > memory_limit() then
    let mut trimmed: [CompanionMemory] = []
    let mut start = kept.length() - memory_limit()
    while start < kept.length() do
      trimmed.push(kept[start])
      start = start + 1
    end
    kept = trimmed
  end
  companion_quiet_with_memory(quiet, kept)
end

export fn companion_request_body(model: string, digest: string) -> string =
  "{\"model\":\"" + json_escape(model) + "\",\"max_tokens\":60,\"messages\":[{\"role\":\"system\",\"content\":\"" + json_escape(companion_instruction()) + "\"},{\"role\":\"user\",\"content\":\"" + json_escape(clipped_digest(digest)) + "\"}]}"

export fn companion_responses_body(model: string, digest: string) -> string = do
  const instruction = "{\"role\":\"system\",\"content\":[{\"type\":\"input_text\",\"text\":\"" + json_escape(companion_instruction()) + "\"}]}"
  const user = "{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"" + json_escape(clipped_digest(digest)) + "\"}]}"
  "{\"model\":\"" + json_escape(model) + "\",\"stream\":false,\"reasoning\":{\"effort\":\"low\"},\"input\":[" + instruction + "," + user + "]}"
end
