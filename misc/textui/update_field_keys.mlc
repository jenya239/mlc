import { Theme } from './theme'
import {
  WidgetStore,
  WidgetKind,
  widget_id_is_none,
  kind_is_text_field
} from './store'
import { LayoutResult } from './layout_result'
import { field_caption } from './widget_field'
import { text_word_before, text_word_after } from './text_layout_hit'
import { UiState } from './ui_state'
import { UiInput } from './ui_input'
import { FieldKeyResult, field_undo, field_redo } from './field_history'
import {
  field_key_keep,
  clamp_index,
  apply_insertion,
  field_replace_bounds,
  delete_span,
  backspace_span,
  delete_forward_span,
  move_caret,
  horizontal_destination,
  cut_range,
  select_all
} from './field_key_edit'
import { multiline_move_target, paste_text_for_field } from './field_multiline_keys'

fn first_line(text: string) -> string = do
  let mut index = 0
  const size = text.byte_size()
  while index < size do
    const byte = text.byte_at(index)
    if byte == "\n" || byte == "\r" then
      return text.byte_substring(0, index)
    end
    index = index + 1
  end
  return text
end

fn field_is_multiline(kind: WidgetKind) -> bool =
  match kind
    | KindTextField(data) => data.max_lines > 1
    | KindBox(_) => false
    | KindLabel(_) => false
    | KindButton(_) => false
    | KindCheckbox(_) => false
    | KindScrollView => false
    | KindListView(_) => false
    | KindSplitter(_) => false
    | KindIcon(_) => false

fn moved(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  caret: i32,
  extend_selection: bool
) -> FieldKeyResult =
  FieldKeyResult {
    store: store,
    state: move_caret(layout, theme, state, state.focus, caret, extend_selection),
    submitted: false
  }

export fn update_field_keys(
  store: WidgetStore,
  layout: LayoutResult,
  theme: Theme,
  state: UiState,
  input: UiInput
) -> FieldKeyResult = do
  if widget_id_is_none(state.focus) then
    return field_key_keep(store, state)
  end
  if state.focus.index < 0 || state.focus.index >= store.nodes.length() then
    return field_key_keep(store, state)
  end
  if kind_is_text_field(store.nodes[state.focus.index].kind) == false then
    return field_key_keep(store, state)
  end
  const field = state.focus
  const current = field_caption(store.nodes[field.index].kind)
  const limit = current.byte_size()
  const multiline = field_is_multiline(store.nodes[field.index].kind)
  if input.control_down && input.binding_key == "z" && input.shift_down then
    return field_redo(store, layout, theme, state, field)
  end
  if input.control_down && input.binding_key == "y" then
    return field_redo(store, layout, theme, state, field)
  end
  if input.control_down && input.binding_key == "z" then
    return field_undo(store, layout, theme, state, field)
  end
  if input.control_down == false && input.text.byte_size() > 0 then
    const bounds = field_replace_bounds(state, field, limit)
    return apply_insertion(
      store, layout, theme, state, field, current, first_line(input.text), bounds.anchor, bounds.focus
    )
  end
  if input.control_down && input.binding_key == "v" then
    const bounds = field_replace_bounds(state, field, limit)
    return apply_insertion(
      store,
      layout,
      theme,
      state,
      field,
      current,
      paste_text_for_field(multiline, input.paste_text),
      bounds.anchor,
      bounds.focus
    )
  end
  if input.backspace_pressed && input.control_down then
    const caret = clamp_index(state.field_caret, limit)
    const bounds = field_replace_bounds(state, field, limit)
    if bounds.anchor == bounds.focus then
      return delete_span(
        store, layout, theme, state, field, current, text_word_before(current, caret), caret
      )
    end
  end
  if input.backspace_pressed then
    const span = backspace_span(state, field, layout, limit)
    return delete_span(store, layout, theme, state, field, current, span.anchor, span.focus)
  end
  if input.binding_key == "delete" && input.shift_down then
    return cut_range(store, layout, theme, state, field, current)
  end
  if input.binding_key == "delete" && input.control_down then
    const caret = clamp_index(state.field_caret, limit)
    const bounds = field_replace_bounds(state, field, limit)
    if bounds.anchor == bounds.focus then
      return delete_span(
        store, layout, theme, state, field, current, caret, text_word_after(current, caret)
      )
    end
  end
  if input.binding_key == "delete" then
    const span = delete_forward_span(state, field, layout, limit)
    return delete_span(store, layout, theme, state, field, current, span.anchor, span.focus)
  end
  if input.control_down && input.binding_key == "x" then
    return cut_range(store, layout, theme, state, field, current)
  end
  if input.control_down && input.binding_key == "a" then
    return select_all(store, layout, theme, state, field, current)
  end
  if multiline then
    const target = multiline_move_target(
      layout.text_layouts[field.index],
      clamp_index(state.field_caret, limit),
      input.binding_key,
      input.control_down
    )
    if target >= 0 then
      return moved(store, layout, theme, state, target, input.shift_down)
    end
  end
  if input.binding_key == "left" || input.binding_key == "right" then
    const toward_end = input.binding_key == "right"
    let mut caret = 0
    if input.control_down then
      const origin = clamp_index(state.field_caret, limit)
      if toward_end then
        caret = text_word_after(current, origin)
      else
        caret = text_word_before(current, origin)
      end
    else
      caret = horizontal_destination(state, field, layout, toward_end, input.shift_down)
    end
    return moved(store, layout, theme, state, caret, input.shift_down)
  end
  if input.binding_key == "home" || input.binding_key == "end" then
    let mut caret = 0
    if input.binding_key == "end" then
      caret = limit
    end
    return moved(store, layout, theme, state, caret, input.shift_down)
  end
  if multiline && input.enter_pressed && input.shift_down then
    const bounds = field_replace_bounds(state, field, limit)
    return apply_insertion(
      store, layout, theme, state, field, current, "\n", bounds.anchor, bounds.focus
    )
  end
  if input.enter_pressed && input.control_down == false then
    return FieldKeyResult { store: store, state: state, submitted: true }
  end
  return field_key_keep(store, state)
end
