import { ColorRgba, Theme, theme_with_font_size } from './theme'
import { transcript_route_caption, transcript_route_font_size } from './chat_transcript_route'
import { ChatMessage, ChatModel, ChatRole } from './chat_model'
import { block_index_end_visible, block_index_first_visible, block_scroll_bottom, block_scroll_clamp } from './block_index'
import { TextShapingState } from '../gui/text_shaping'
import { TextLayout, TextLayoutCache, text_layout_build, wrap_width_none, wrap_width_pixels } from './text_layout'
import { text_layout_text_ops } from './text_layout_paint'
import { text_layout_selection_rects } from './text_layout_hit'
import { TranscriptSelection } from './chat_transcript_input'
import { TranscriptCaret, transcript_block_slice } from './chat_transcript_caret'
import { DrawOp, FillRectOp } from './draw_op'
import { Rect, rect_contains, rect_intersect, rect_is_empty, rect_new } from './geometry'
import { scroll_bar_rect, scroll_thumb_rect } from './widget_scroll'
import {
  TranscriptView,
  transcript_content_limit,
  transcript_empty_text,
  transcript_labeled_height,
  transcript_pending_text,
  transcript_role_label
} from './chat_transcript_layout'
import { chat_fence_body, chat_highlight_fills, chat_highlight_text } from './chat_highlight'

fn visible_scroll(view: TranscriptView, view_height: i32) -> i32 = do
  if view.stick_to_bottom != 0 then
    return block_scroll_bottom(view.index.total, view_height)
  end
  block_scroll_clamp(view.index.total, view_height, view.scroll_y)
end

fn bubble_color(theme: Theme, role: ChatRole) -> ColorRgba = do
  const color = match role
    | RoleUser => theme.list_selected
    | RoleAssistant => theme.button_background
  color
end

fn body_color(theme: Theme, failed: bool) -> ColorRgba = do
  if failed then
    return theme.inspect_stroke
  end
  theme.foreground
end

fn push_layout_text(
  operations: [DrawOp],
  layout: TextLayout,
  origin_x: i32,
  origin_y: i32,
  color: ColorRgba,
  bounds: Rect
) -> [DrawOp] = do
  let mut next = operations
  const pieces = text_layout_text_ops(layout, origin_x, origin_y, color)
  let mut index = 0
  while index < pieces.length() do
    const piece = pieces[index]
    if rect_contains(bounds, piece.origin_x, piece.origin_y) then
      next.push(OpText(piece))
    end
    index = index + 1
  end
  next
end

fn push_bubble(
  operations: [DrawOp],
  bounds: Rect,
  screen_y: i32,
  height: i32,
  color: ColorRgba
) -> [DrawOp] = do
  let mut next = operations
  const visible = rect_intersect(bounds, rect_new(bounds.x, screen_y, bounds.width, height))
  if rect_is_empty(visible) then
    return next
  end
  next.push(OpFillRect(FillRectOp { rect: visible, color: color }))
  next
end

fn paint_selection(
  operations: [DrawOp],
  theme: Theme,
  layout: TextLayout,
  origin_x: i32,
  origin_y: i32,
  anchor: i32,
  focus: i32
) -> [DrawOp] = do
  if anchor == focus then
    return operations
  end
  const boxes = text_layout_selection_rects(layout, anchor, focus)
  let mut next = operations
  let mut index = 0
  while index < boxes.length() do
    const box = boxes[index]
    if box.width > 0 && box.height > 0 then
      next.push(OpFillRect(FillRectOp {
        rect: rect_new(origin_x + box.x, origin_y + box.y, box.width, box.height),
        color: theme.selection_background
      }))
    end
    index = index + 1
  end
  next
end

fn paint_message(
  operations: [DrawOp],
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  message: ChatMessage,
  bounds: Rect,
  screen_y: i32,
  highlight: bool,
  block_index: i32,
  message_count: i32,
  selection: TranscriptSelection
) -> [DrawOp] = do
  let mut body_text = message.text
  let mut code_ranges: [i32] = []
  if highlight then
    const visible = chat_fence_body(message.text)
    body_text = visible.text
    code_ranges = visible.ranges
  end
  const role_built = text_layout_build(
    shaping, cache, theme, transcript_role_label(message.role), wrap_width_none()
  )
  const body_built = text_layout_build(
    role_built.shaping,
    role_built.cache,
    theme,
    body_text,
    wrap_width_pixels(transcript_content_limit(theme, bounds.width))
  )
  const caption = transcript_route_caption(message)
  let mut caption_layout = body_built.layout
  let mut caption_height = 0
  if caption.byte_size() > 0 then
    const caption_built = text_layout_build(
      body_built.shaping,
      body_built.cache,
      theme_with_font_size(theme, transcript_route_font_size()),
      caption,
      wrap_width_pixels(transcript_content_limit(theme, bounds.width))
    )
    caption_layout = caption_built.layout
    caption_height = caption_built.layout.pixel_height
  end
  let mut next = push_bubble(
    operations,
    bounds,
    screen_y,
    transcript_labeled_height(
      theme.padding,
      role_built.layout.pixel_height,
      body_built.layout.pixel_height,
      caption_height
    ),
    bubble_color(theme, message.role)
  )
  const text_x = bounds.x + theme.padding
  next = push_layout_text(
    next,
    role_built.layout,
    text_x,
    screen_y + theme.padding,
    theme.muted,
    bounds
  )
  const body_y = screen_y + theme.padding + role_built.layout.pixel_height
  if highlight then
    next = chat_highlight_fills(
      next,
      theme,
      body_built.layout,
      text_x,
      body_y,
      transcript_content_limit(theme, bounds.width),
      code_ranges
    )
  end
  const slice = transcript_block_slice(
    block_index,
    body_text.byte_size(),
    message_count,
    TranscriptCaret { block: selection.anchor_block, byte_index: selection.anchor_byte },
    TranscriptCaret { block: selection.focus_block, byte_index: selection.focus_byte }
  )
  if slice.covered then
    next = paint_selection(next, theme, body_built.layout, text_x, body_y, slice.start, slice.finish)
  end
  if highlight then
    next = chat_highlight_text(
      next,
      theme,
      body_built.layout,
      text_x,
      body_y,
      body_color(theme, message.failed),
      transcript_content_limit(theme, bounds.width),
      code_ranges
    )
  else
    next = push_layout_text(
      next,
      body_built.layout,
      text_x,
      body_y,
      body_color(theme, message.failed),
      bounds
    )
  end
  if caption_height > 0 then
    next = push_layout_text(
      next,
      caption_layout,
      text_x,
      body_y + body_built.layout.pixel_height,
      theme.muted,
      bounds
    )
  end
  next
end

fn paint_plain(
  operations: [DrawOp],
  theme: Theme,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  text: string,
  bounds: Rect,
  screen_y: i32
) -> [DrawOp] = do
  const built = text_layout_build(shaping, cache, theme, text, wrap_width_none())
  push_layout_text(
    operations,
    built.layout,
    bounds.x + theme.padding,
    screen_y + theme.padding,
    theme.muted,
    bounds
  )
end

fn paint_block(
  operations: [DrawOp],
  theme: Theme,
  model: ChatModel,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  bounds: Rect,
  block_index: i32,
  screen_y: i32,
  highlight: bool,
  selection: TranscriptSelection
) -> [DrawOp] = do
  if block_index >= model.messages.length() then
    return paint_plain(
      operations, theme, shaping, cache, transcript_pending_text(), bounds, screen_y
    )
  end
  paint_message(
    operations,
    theme,
    shaping,
    cache,
    model.messages[block_index],
    bounds,
    screen_y,
    highlight,
    block_index,
    model.messages.length(),
    selection
  )
end

export fn paint_transcript_styled(
  theme: Theme,
  model: ChatModel,
  view: TranscriptView,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  rect: Rect,
  highlight: bool,
  selection: TranscriptSelection
) -> [DrawOp] = do
  let mut operations: [DrawOp] = []
  operations.push(OpPushClip(rect))
  const scroll = visible_scroll(view, rect.height)
  const first = block_index_first_visible(view.index, scroll)
  const finish = block_index_end_visible(view.index, scroll, rect.height)
  let mut block_index = first
  while block_index < finish do
    const screen_y = rect.y + view.index.tops[block_index] - scroll
    operations = paint_block(
      operations, theme, model, shaping, cache, rect, block_index, screen_y, highlight, selection
    )
    block_index = block_index + 1
  end
  if model.messages.length() == 0 && model.pending == false then
    operations = paint_plain(
      operations, theme, shaping, cache, transcript_empty_text(), rect, rect.y
    )
  end
  if view.index.total > rect.height then
    operations.push(OpFillRect(FillRectOp {
      rect: scroll_bar_rect(theme, rect),
      color: theme.scrollbar_track
    }))
    operations.push(OpFillRect(FillRectOp {
      rect: scroll_thumb_rect(theme, rect, scroll, view.index.total),
      color: theme.scrollbar_thumb
    }))
  end
  operations.push(OpPopClip)
  operations
end

export fn paint_transcript(
  theme: Theme,
  model: ChatModel,
  view: TranscriptView,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  rect: Rect
) -> [DrawOp] =
  paint_transcript_styled(
    theme, model, view, shaping, cache, rect, false, transcript_selection_new()
  )
