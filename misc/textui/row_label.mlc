import { WidgetId, WidgetKind, WidgetStore } from './store'
import { UiEvent } from './ui_event'
import { UiState } from './ui_state'
import { list_selected_at } from './widget_list'

fn list_text_at(texts: [string], selected: i32) -> string = do
  if selected < 0 || selected >= texts.length() then
    return ""
  end
  return texts[selected]
end

export fn activated_row_text(store: WidgetStore, state: UiState, owner: WidgetId) -> string =
  match store.nodes[owner.index].kind
    | KindListView(data) => list_text_at(data.texts, list_selected_at(state.list_selected, owner.index))
    | KindLabel(_) => ""
    | KindIcon(_) => ""
    | KindTextView => ""
    | KindButton(_) => ""
    | KindCheckbox(_) => ""
    | KindBox(_) => ""
    | KindScrollView => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""

export fn log_activated_rows(store: WidgetStore, state: UiState, events: [UiEvent]) -> unit = do
  let mut index = 0
  while index < events.length() do
    if events[index].activated then
      println("[textui] activate " + activated_row_text(store, state, events[index].widget))
    end
    index = index + 1
  end
end
