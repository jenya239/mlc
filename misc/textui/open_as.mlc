import { WidgetKind, WidgetStore, widget_id_is_none, widget_store_set_list_texts } from './store'
import { UiEvent, ui_event_is_activate_on } from './ui_event'
import { UiState, ui_state_with, ui_state_with_list_selected } from './ui_state'
import { list_selected_at, list_selected_put } from './widget_list'
import { OverlayView, ui_state_with_overlay_revision } from './overlay'
import { menu_list_id } from './menu'
import { DialogTarget, dialog_present } from './dialog'
import { jailed_file_text } from './directory_mutate'
import { open_directory_jailed } from './directory_browse'
import { directory_target, join_path, strip_trailing_slash } from './directory_rows'
import { path_inside_jail } from './directory_jail'
import { path_bar_current } from './path_bar'
import { clipboard_set_primary } from './clipboard'
import { open_as_image_mark, open_as_image_name } from './open_as_pin'

extern fn image_preview_load(path: string) -> i32
  = "mlc::image_preview::load_value" from "mlc/gl/image_preview.hpp" blocking

fn view_of(store: WidgetStore, state: UiState) -> OverlayView =
  OverlayView { store: store, state: state }

fn list_names(kind: WidgetKind) -> [string] =
  match kind
    | KindListView(data) => data.texts
    | KindBox(_) => []
    | KindLabel(_) => []
    | KindIcon(_) => []
    | KindButton(_) => []
    | KindCheckbox(_) => []
    | KindScrollView => []
    | KindSplitter(_) => []
    | KindTextField(_) => []

fn ends_with_slash(text: string) -> bool = do
  if text.byte_size() == 0 then
    return false
  end
  return text.byte_at(text.byte_size() - 1) == "/"
end

fn menu_choice(store: WidgetStore, state: UiState) -> string = do
  const list_id = menu_list_id(store)
  if widget_id_is_none(list_id) then
    return ""
  end
  const texts = list_names(store.nodes[list_id.index].kind)
  const row = list_selected_at(state.list_selected, list_id.index)
  if row < 0 || row >= texts.length() then
    return ""
  end
  return texts[row]
end

fn target_entry(store: WidgetStore, target: DialogTarget) -> string = do
  if target.list_index < 0 || target.list_index >= store.nodes.length() then
    return ""
  end
  const texts = list_names(store.nodes[target.list_index].kind)
  if target.row < 0 || target.row >= texts.length() then
    return ""
  end
  return texts[target.row]
end

fn show_modes(store: WidgetStore, state: UiState) -> OverlayView = do
  const list_id = menu_list_id(store)
  if widget_id_is_none(list_id) then
    return view_of(store, state)
  end
  let mut rows: [string] = []
  rows.push("Text")
  rows.push("Image")
  const listed = widget_store_set_list_texts(store, list_id, rows)
  const chosen = ui_state_with_list_selected(
    state,
    list_selected_put(state.list_selected, list_id.index, 0)
  )
  return view_of(
    listed,
    ui_state_with_overlay_revision(chosen, state.overlay_revision + 1)
  )
end

fn open_text(store: WidgetStore, state: UiState, target: DialogTarget, root: string) -> OverlayView = do
  const entry = target_entry(store, target)
  if entry == "" || root == "" then
    return view_of(store, state)
  end
  const current = path_bar_current(store)
  if entry == ".." || ends_with_slash(entry) then
    const opened = open_directory_jailed(store, state, directory_target(current, entry), root)
    return view_of(opened.store, opened.state)
  end
  return dialog_present(store, state, "Open as", jailed_file_text(root, current, entry), false)
end

fn open_image(store: WidgetStore, state: UiState, target: DialogTarget, root: string) -> OverlayView = do
  const entry = target_entry(store, target)
  if entry == "" || root == "" || ends_with_slash(entry) || open_as_image_name(entry) == false then
    return view_of(store, state)
  end
  const path = join_path(strip_trailing_slash(path_bar_current(store)), entry)
  if path_inside_jail(root, path) == false then
    return view_of(store, state)
  end
  image_preview_load(path)
  return view_of(
    store,
    ui_state_with(
      state,
      state.selection,
      state.grab,
      state.pointer,
      state.last_press,
      clipboard_set_primary(state.clipboard, open_as_image_mark(path)),
      state.hover
    )
  )
end

export fn open_as_host(
  store: WidgetStore,
  state: UiState,
  events: [UiEvent],
  target: DialogTarget,
  root: string
) -> OverlayView = do
  let mut view = view_of(store, state)
  let mut index = 0
  while index < events.length() do
    const event = events[index]
    if ui_event_is_activate_on(event, menu_list_id(view.store)) then
      const choice = menu_choice(view.store, view.state)
      if choice == "Open as" then
        view = show_modes(view.store, view.state)
      end
      if choice == "Text" then
        view = open_text(view.store, view.state, target, root)
      end
      if choice == "Image" then
        view = open_image(view.store, view.state, target, root)
      end
    end
    index = index + 1
  end
  return view
end
