import { has } from 'Env'
import {
  glfw_gl_context_begin,
  glfw_gl_swap_interval,
  glfw_gl_context_should_close,
  glfw_gl_context_swap_poll,
  glfw_gl_context_end,
  glfw_gl_window_width,
  glfw_gl_window_height,
  glfw_gl_window_request_position,
  glfw_gl_key_escape_down,
  glfw_gl_mouse_right_down
} from '../../lib/mlc/common/stdlib/gl/gl_window.mlc'
import { theme_default } from './theme'
import { open_scripted_gallery } from './gallery_script'
import { gallery_frame_signature, gallery_frame_wait_seconds } from './gallery_frame'
import { GalleryTurn, gallery_turn, gallery_turn_after_paint, gallery_turn_settle } from './gallery_turn'
import { text_shaping_new } from '../gui/text_shaping'
import { text_layout_cache_new } from './text_layout'
import { LayoutColumnResult, layout_ui } from './layout_pass'
import { frame_signature_hover_only } from './frame_request'
import { submit_ui_frame } from './frame_submit'
import { cursor_lens_bind, cursor_lens_create, cursor_lens_destroy } from './cursor_lens'
import { idle_scene, scene_finish } from './scene_present'
import { submit_create, submit_destroy } from './submit'
import { ui_state_new } from './ui_state'
import { host_buttons_new, host_now_ms, host_poll_input, host_wait_for_input } from './host_input'
import { remember_window } from './window_placement'
import { gallery_start, session_with_directory, window_session_load, window_session_store } from './window_session'
import { open_directory_jailed } from './directory_browse'
import { path_history_empty } from './path_history'
import { attach_about_card } from './overlay'
import { attach_file_menu } from './menu'
import { attach_dialog } from './dialog'
import { image_preview_arm, image_preview_needs_paint, image_preview_playing, image_preview_release } from './image_preview'
import { hovered_text_path } from './text_view_preview'
import { text_editor_closed } from './text_editor'
import { text_editor_prepare_input } from './text_editor_paint'
import { gallery_media_step } from './gallery_media'
import { video_session_new } from './video_session'
import { music_follow_video, music_playing, music_release } from './music_host'
import { chat_live_run } from './chat_live'
import { observation_frame_empty } from './companion_observe'
export fn application_reload_status() -> i32 = 75

fn main() -> i32 = do
  let mut open_width = 1280
  let mut open_height = 800
  const session = window_session_load()
  if has("MLC_TEXTUI_BENCH") == false && session.placement.restored then
    open_width = session.placement.width
    open_height = session.placement.height
    glfw_gl_window_request_position(session.placement.x, session.placement.y)
  end
  const begin_status = glfw_gl_context_begin(open_width, open_height)
  if begin_status != 0 then
    return begin_status
  end
  glfw_gl_swap_interval(0)
  let mut resources = submit_create()
  let mut lens = cursor_lens_create()
  if resources.error_code != 0 then
    const error_code = resources.error_code
    remember_window()
    glfw_gl_context_end()
    return error_code
  end
  const theme = theme_default()
  let mut guest = open_scripted_gallery()
  let mut store = attach_dialog(attach_file_menu(attach_about_card(guest.store)))
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()
  println("[textui] gallery — drag to select, Copy / Ctrl+C, Ping, Reload, Pick, Dense. Esc to quit")
  let mut max_frames = 0
  if has("MLC_TEXTUI_BENCH") then max_frames = 8 end
  let mut state = ui_state_new()
  const started = gallery_start(store, session)
  store = started.store
  const opened = open_directory_jailed(store, state, started.path, started.jail_root)
  store = opened.store
  state = session_with_directory(opened.state, store, session)
  let mut laid_out = layout_ui(
    store, theme, shaping, cache, glfw_gl_window_width(), glfw_gl_window_height(),
    state.scroll_offsets, state.splitter_ratios
  )
  const presented = gallery_frame_signature(guest, state, glfw_gl_window_width(), glfw_gl_window_height())
  let mut turn = GalleryTurn {
    resources: resources,
    lens: lens,
    column: laid_out,
    guest: guest,
    store: store,
    state: state,
    effect_mode: started.effect_mode,
    jail_root: started.jail_root,
    sandbox_root: started.sandbox,
    dense_enabled: session.dense,
    path_history: path_history_empty(),
    target_list: 0 - 1,
    target_row: 0 - 1,
    right_was_down: false,
    reported_inspect: 0 - 1,
    presented: presented,
    reload_requested: false,
    observation: observation_frame_empty()
  }
  let mut buttons = host_buttons_new()
  let mut frame_index = 0
  let mut close_window = false
  let mut composed = false
  let mut saved_session = ""
  let mut sample_after_present = true
  let mut escape_was_down = false
  let mut shown_text_path = ""
  let mut video_session = video_session_new()
  let mut editor = text_editor_closed(theme.font_path, theme.font_size_pixels)
  let mut music_yielded = false
  while glfw_gl_context_should_close() == 0 do
    if sample_after_present == false && max_frames == 0 then
      host_wait_for_input(gallery_frame_wait_seconds(
        turn.guest, turn.effect_mode, image_preview_playing(), music_playing(), host_now_ms()
      ))
    end
    sample_after_present = false
    const escape_down = glfw_gl_key_escape_down() != 0
    const escape_pressed = escape_down && escape_was_down == false
    if escape_pressed && turn.state.overlay_open == false then
      break
    end
    escape_was_down = escape_down
    const polled = host_poll_input(buttons, host_now_ms())
    buttons = polled.buttons
    const viewport_width = glfw_gl_window_width()
    const viewport_height = glfw_gl_window_height()
    const turn_input = text_editor_prepare_input(editor, turn.store, turn.state, turn.column.layout, polled.input)
    const stepped = gallery_turn(
      turn, turn_input, theme, viewport_width, viewport_height,
      glfw_gl_mouse_right_down() != 0, true, escape_pressed
    )
    turn = stepped.turn
    let mut paints = stepped.paint
    let mut next_signature = stepped.next_signature
    if stepped.chat_requested then
      const hosted = chat_live_run(turn, theme)
      if hosted.error_code != 0 then
        return hosted.error_code
      end
      const settled = gallery_turn_settle(
        hosted.turn, theme, glfw_gl_window_width(), glfw_gl_window_height()
      )
      turn = settled.turn
      next_signature = settled.next_signature
      paints = true
      if hosted.window_closed then
        close_window = true
      end
      escape_was_down = true
      sample_after_present = true
    end
    if frame_index == 0 then
      paints = true
    end
    const media = gallery_media_step(
      editor,
      video_session,
      turn.store,
      turn.state,
      turn.column.layout,
      theme,
      turn.jail_root,
      polled.input,
      host_now_ms()
    )
    editor = media.editor
    video_session = media.video
    const media_path = media.media_path
    const hold_still = media.hold_still
    image_preview_arm(
      turn.store, turn.state, turn.column.layout, theme, turn.jail_root, turn.effect_mode, turn.lens.framebuffer,
      media_path, hold_still
    )
    music_yielded = music_follow_video(music_yielded)
    if image_preview_needs_paint() != 0 then
      paints = true
    end
    const text_path = hovered_text_path(turn.store, turn.state, turn.jail_root)
    if text_path != shown_text_path || media.editor_changed then
      paints = true
    end
    if paints then
      const window_width = glfw_gl_window_width()
      const window_height = glfw_gl_window_height()
      let mut lens_now = cursor_lens_bind(turn.lens, window_width, window_height, turn.effect_mode)
      image_preview_arm(
        turn.store, turn.state, turn.column.layout, theme, turn.jail_root, turn.effect_mode, lens_now.framebuffer,
        media_path, hold_still
      )
      const text_changed = shown_text_path != text_path
      const submitted = submit_ui_frame(
        turn.resources, turn.column.shaping, theme, turn.store, turn.column.layout, turn.state,
        turn.presented, next_signature, window_width, window_height, composed, turn.jail_root,
        shown_text_path, text_path, editor
      )
      shown_text_path = text_path
      composed = true
      if submitted.error_code != 0 then
        submit_destroy(submitted.resources)
        cursor_lens_destroy(lens_now)
        remember_window()
        glfw_gl_context_end()
        return submitted.error_code
      end
      const clean_window = frame_index == 0 || text_changed || media.editor_changed || frame_signature_hover_only(turn.presented, next_signature) == false
      lens_now = scene_finish(
        lens_now, polled.input.mouse_x, polled.input.mouse_y, window_width, window_height, clean_window, turn.effect_mode
      )
      turn = gallery_turn_after_paint(
        turn,
        submitted.resources,
        LayoutColumnResult { shaping: submitted.shaping, cache: turn.column.cache, layout: turn.column.layout },
        lens_now,
        next_signature
      )
      glfw_gl_context_swap_poll()
      sample_after_present = true
    end
    if paints == false && composed then
      turn = gallery_turn_after_paint(
        turn, turn.resources, turn.column,
        idle_scene(
          turn.lens, polled.input.mouse_x, polled.input.mouse_y,
          glfw_gl_window_width(), glfw_gl_window_height(), turn.effect_mode, music_playing()
        ),
        turn.presented
      )
    end
    frame_index = frame_index + 1
    if max_frames > 0 && frame_index >= max_frames then
      break
    end
    if turn.reload_requested || close_window then
      break
    end
    saved_session = window_session_store(
      saved_session, turn.store, turn.effect_mode, turn.sandbox_root, turn.jail_root,
      turn.state.splitter_ratios, turn.dense_enabled
    )
  end
  saved_session = window_session_store(
    saved_session, turn.store, turn.effect_mode, turn.sandbox_root, turn.jail_root,
    turn.state.splitter_ratios, turn.dense_enabled
  )
  submit_destroy(turn.resources)
  cursor_lens_destroy(turn.lens)
  image_preview_release()
  music_release()
  glfw_gl_context_end()
  if turn.reload_requested then
    return application_reload_status()
  end
  println("[textui] closed frames=" + frame_index.to_string())
  0
end
