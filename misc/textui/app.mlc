import { has } from 'Env'
import {
  glfw_gl_context_begin,
  glfw_gl_swap_interval,
  glfw_gl_context_should_close,
  glfw_gl_context_swap_poll,
  glfw_gl_context_end,
  glfw_gl_window_width,
  glfw_gl_window_height,
  glfw_gl_window_x,
  glfw_gl_window_y,
  glfw_gl_window_request_position,
  glfw_gl_key_escape_down,
  glfw_gl_mouse_right_down,
  glfw_gl_clipboard_set
} from '../../lib/mlc/common/stdlib/gl/gl_window.mlc'
import { theme_default } from './theme'
import { WidgetId, WidgetStore, widget_id_is_none } from './store'
import { build_label_gallery } from './gallery_scene'
import { stress_listing_set, stress_pane_width } from './stress_listing'
import { text_shaping_new } from '../gui/text_shaping'
import { text_layout_cache_new } from './text_layout'
import { layout_ui } from './layout_pass'
import {
  frame_signature,
  frame_request,
  frame_request_layouts,
  frame_request_paints
} from './frame_request'
import { submit_ui_frame } from './hover_damage'
import { field_align_scroll } from './widget_field'
import { submit_create, submit_destroy } from './submit'
import { UiState, ui_state_new, ui_state_with_pick } from './ui_state'
import { list_selected_at } from './widget_list'
import { ui_update } from './ui_update'
import { clipboard_copy_selection } from './update_copy'
import { host_buttons_new, host_now_ms, host_poll_input, host_wait_for_input } from './host_input'
import { hit_test } from './hit'
import { widget_inspect_report } from './inspect'
import { UiInput } from './ui_input'
import { WindowPlacement, window_placement_load, window_placement_save } from './window_placement'
import { follow_directory, open_directory } from './directory_browse'
import { attach_about_card, overlay_apply, overlay_dismiss } from './overlay'
import { attach_file_menu, menu_apply, menu_host_step } from './menu'

fn application_reload_status() -> i32 = 75

fn remember_window() -> bool = do
  if has("MLC_TEXTUI_BENCH") then
    return false
  end
  window_placement_save(WindowPlacement {
    x: glfw_gl_window_x(),
    y: glfw_gl_window_y(),
    width: glfw_gl_window_width(),
    height: glfw_gl_window_height(),
    restored: true
  })
end

fn input_clear_buttons(input: UiInput) -> UiInput =
  UiInput {
    mouse_x: input.mouse_x,
    mouse_y: input.mouse_y,
    left_pressed: false,
    left_down: input.left_down,
    left_released: input.left_released,
    control_down: input.control_down,
    copy_pressed: input.copy_pressed,
    wheel_y: input.wheel_y,
    now_ms: input.now_ms,
    text: input.text,
    binding_key: input.binding_key,
    shift_down: input.shift_down,
    backspace_pressed: input.backspace_pressed,
    enter_pressed: input.enter_pressed,
    paste_text: input.paste_text
  }

fn button_caption(store: WidgetStore, owner: WidgetId) -> string =
  match store.nodes[owner.index].kind
    | KindButton(data) => data.text
    | KindLabel(_) => ""
    | KindBox(_) => ""
    | KindScrollView => ""
    | KindListView(_) => ""
    | KindSplitter(_) => ""
    | KindTextField(_) => ""

fn list_text_at(texts: [string], selected: i32) -> string = do
  if selected < 0 || selected >= texts.length() then
    return ""
  end
  texts[selected]
end

fn activated_row_text(store: WidgetStore, state: UiState, owner: WidgetId) -> string =
  match store.nodes[owner.index].kind
    | KindListView(data) => list_text_at(data.texts, list_selected_at(state.list_selected, owner.index))
    | KindLabel(_) => ""
    | KindButton(_) => ""
    | KindBox(_) => ""
    | KindScrollView => ""
    | KindSplitter(_) => ""
    | KindTextField(data) => data.text

fn main() -> i32 = do
  let mut open_width = 1280
  let mut open_height = 800
  if has("MLC_TEXTUI_BENCH") == false then
    const loaded = window_placement_load()
    if loaded.restored then
      open_width = loaded.width
      open_height = loaded.height
      glfw_gl_window_request_position(loaded.x, loaded.y)
    end
  end
  const begin_status = glfw_gl_context_begin(open_width, open_height)
  if begin_status != 0 then
    return begin_status
  end
  glfw_gl_swap_interval(0)
  let mut resources = submit_create()
  if resources.error_code != 0 then
    const error_code = resources.error_code
    remember_window()
    glfw_gl_context_end()
    return error_code
  end
  const theme = theme_default()
  let mut store = attach_file_menu(attach_about_card(build_label_gallery()))
  let mut shaping = text_shaping_new()
  let mut cache = text_layout_cache_new()

  println("[textui] gallery — drag to select, Copy / Ctrl+C, Ping, Reload, Pick, Dense. Esc to quit")

  let mut max_frames = 0
  if has("MLC_TEXTUI_BENCH") then
    max_frames = 8
  end

  let mut state = ui_state_new()
  const opened = open_directory(store, state, "/home/jenya/workspaces/current/mlc")
  store = opened.store
  state = opened.state
  let mut dense_enabled = false
  let mut buttons = host_buttons_new()
  let mut frame_index = 0
  let mut reported_inspect = -1
  let mut reload_requested = false
  let mut laid_out = layout_ui(
    store,
    theme,
    shaping,
    cache,
    glfw_gl_window_width(),
    glfw_gl_window_height(),
    state.scroll_offsets,
    state.splitter_ratios
  )
  shaping = laid_out.shaping
  cache = laid_out.cache
  let mut presented = frame_signature(state, glfw_gl_window_width(), glfw_gl_window_height())
  let mut sample_after_present = true
  let mut escape_was_down = false
  let mut right_was_down = false
  while glfw_gl_context_should_close() == 0 do
    if sample_after_present == false && max_frames == 0 then
      host_wait_for_input()
    end
    sample_after_present = false
    const escape_down = glfw_gl_key_escape_down() != 0
    const escape_pressed = escape_down && escape_was_down == false
    const overlay_was_open = state.overlay_open
    if escape_pressed && overlay_was_open then
      const closed = overlay_dismiss(store, state)
      store = closed.store
      state = closed.state
    end
    if escape_pressed && overlay_was_open == false then
      break
    end
    escape_was_down = escape_down
    const polled = host_poll_input(buttons, host_now_ms())
    buttons = polled.buttons
    let mut input = polled.input
    const menued = menu_host_step(store, laid_out.layout, theme, state, glfw_gl_mouse_right_down() != 0, right_was_down, input.mouse_x, input.mouse_y)
    store = menued.store
    state = menued.state
    right_was_down = menued.right_down
    if input.left_pressed then
      const hit = hit_test(store, laid_out.layout, theme, input.mouse_x, input.mouse_y)
      if widget_id_is_none(hit) == false && button_caption(store, hit) == "Pick" then
        if state.pick_enabled then
          state = ui_state_with_pick(state, false, widget_id_none())
        else
          state = ui_state_with_pick(state, true, hit)
        end
        input = input_clear_buttons(input)
      end
    end
    const clipboard_before = state.clipboard.clipboard
    const updated = ui_update(store, laid_out.layout, theme, state, input)
    state = updated.state
    store = updated.store
    const layered = overlay_apply(store, state, updated.events)
    store = layered.store
    state = layered.state
    const chosen = menu_apply(store, state, updated.events)
    store = chosen.store
    state = chosen.state
    let mut activation_index = 0
    while activation_index < updated.events.length() do
      if updated.events[activation_index].activated then
        println(
          "[textui] activate " + activated_row_text(
            store, state, updated.events[activation_index].widget
          )
        )
      end
      activation_index = activation_index + 1
    end
    const revision_before_browse = state.listing_revision
    const browsed = follow_directory(store, state, updated.events)
    store = browsed.store
    state = browsed.state
    if state.listing_revision != revision_before_browse then
      dense_enabled = false
    end
    const early_signature = frame_signature(state, glfw_gl_window_width(), glfw_gl_window_height())
    const request = frame_request(presented, early_signature)
    if frame_request_layouts(request) then
      laid_out = layout_ui(
        store,
        theme,
        shaping,
        cache,
        glfw_gl_window_width(),
        glfw_gl_window_height(),
        state.scroll_offsets,
        state.splitter_ratios
      )
      shaping = laid_out.shaping
      cache = laid_out.cache
      state = field_align_scroll(store, laid_out.layout, theme, state)
    end
    const next_signature = frame_signature(state, glfw_gl_window_width(), glfw_gl_window_height())
    if state.pick_enabled && widget_id_is_none(state.inspected) == false then
      if state.inspected.index != reported_inspect then
        println(widget_inspect_report(store, laid_out.layout, state.inspected))
        reported_inspect = state.inspected.index
      end
    end
    let mut event_index = 0
    while event_index < updated.events.length() do
      const owner = updated.events[event_index].widget
      const caption = button_caption(store, owner)
      if caption == "Copy" then
        state = clipboard_copy_selection(laid_out.layout, state)
        glfw_gl_clipboard_set(state.clipboard.clipboard)
      end
      if caption == "Ping" then
        println("[textui] ping")
      end
      if caption == "Reload" then
        reload_requested = true
      end
      if caption == "Dense" then
        const stressed = stress_listing_set(
          store,
          state,
          theme,
          stress_pane_width(laid_out.layout, store, 0),
          stress_pane_width(laid_out.layout, store, 1),
          dense_enabled == false
        )
        store = stressed.store
        state = stressed.state
        dense_enabled = stressed.enabled
      end
      event_index = event_index + 1
    end
    if polled.input.copy_pressed && polled.input.control_down then
      glfw_gl_clipboard_set(state.clipboard.clipboard)
    end
    const cut_pressed = (polled.input.binding_key == "x" && polled.input.control_down) || (polled.input.binding_key == "delete" && polled.input.shift_down)
    if cut_pressed && state.clipboard.clipboard != clipboard_before then
      glfw_gl_clipboard_set(state.clipboard.clipboard)
    end
    let mut paints = frame_request_paints(request)
    if frame_index == 0 then
      paints = true
    end
    if paints then
      const submitted = submit_ui_frame(
        resources,
        shaping,
        theme,
        store,
        laid_out.layout,
        state,
        presented,
        next_signature,
        glfw_gl_window_width(),
        glfw_gl_window_height()
      )
      if submitted.error_code != 0 then
        submit_destroy(submitted.resources)
        remember_window()
        glfw_gl_context_end()
        return submitted.error_code
      end
      resources = submitted.resources
      shaping = submitted.shaping
      presented = next_signature
      glfw_gl_context_swap_poll()
      sample_after_present = true
    end
    frame_index = frame_index + 1
    if max_frames > 0 && frame_index >= max_frames then
      break
    end
    if reload_requested then
      break
    end
  end

  submit_destroy(resources)
  remember_window()
  glfw_gl_context_end()
  if reload_requested then
    return application_reload_status()
  end
  println("[textui] closed frames=" + frame_index.to_string())
  0
end
