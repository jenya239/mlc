import { Rect, rect_new } from './geometry'
import { Theme } from './theme'
import {
  WidgetStore,
  WidgetKind,
  WidgetId
} from './store'
import {
  box_padding_of,
  box_gap_of,
  box_is_row,
  effective_gap,
  extra_for,
  visible_children,
  grow_total_of
} from './layout_metrics'
import { TextLayout } from './text_layout'
import { scroll_offset_at } from './widget_scroll'
import { splitter_placement_for } from './widget_split'
import {
  LayoutWork,
  MeasureResult,
  layout_work_with_rect,
  layout_work_with_text
} from './layout_work'
import { measure_node_at, measure_node_wide } from './layout_measure'

export fn work_with_text(work: LayoutWork, index: i32, layout: TextLayout) -> LayoutWork = do
  return layout_work_with_text(work, index, layout)
end

export fn work_with_rect(work: LayoutWork, index: i32, rect: Rect) -> LayoutWork = do
  return layout_work_with_rect(work, index, rect)
end

export fn measure_node(
  work: LayoutWork,
  store: WidgetStore,
  theme: Theme,
  id: WidgetId
) -> MeasureResult = do
  return measure_node_at(work, store, theme, id)
end

export fn layout_box_node(
  work: LayoutWork,
  store: WidgetStore,
  theme: Theme,
  id: WidgetId,
  x: i32,
  y: i32,
  width: i32,
  height: i32
) -> LayoutWork = do
  const kind = store.nodes[id.index].kind
  const padding = box_padding_of(kind)
  const children = visible_children(store, id)
  if children.length() == 0 then
    return work
  end
  const gap = effective_gap(theme, box_gap_of(kind))
  const row = box_is_row(kind)
  const inner_x = x + padding
  const inner_y = y + padding
  let mut inner_width = width - padding * 2
  let mut inner_height = height - padding * 2
  if inner_width < 0 then
    inner_width = 0
  end
  if inner_height < 0 then
    inner_height = 0
  end
  let mut current = work
  let mut preferred_main: [i32] = []
  let mut child_index = 0
  let mut packed = 0
  while child_index < children.length() do
    let mut measured = measure_node(current, store, theme, children[child_index])
    if row == false then
      measured = measure_node_wide(current, store, theme, children[child_index], inner_width)
    end
    current = measured.work
    if row then
      preferred_main.push(measured.size.width)
      packed = packed + measured.size.width
    else
      preferred_main.push(measured.size.height)
      packed = packed + measured.size.height
    end
    child_index = child_index + 1
  end
  packed = packed + gap * (children.length() - 1)
  let mut extra = inner_height - packed
  if row then
    extra = inner_width - packed
  end
  const grow_total = grow_total_of(store, children)
  let mut cursor = inner_y
  if row then
    cursor = inner_x
  end
  child_index = 0
  while child_index < children.length() do
    const child = children[child_index]
    const grow = store.nodes[child.index].grow
    const along = preferred_main[child_index] + extra_for(grow, extra, grow_total)
    if row then
      current = layout_node(
        current, store, theme, child, cursor, inner_y, along, inner_height
      )
      cursor = cursor + along + gap
    else
      current = layout_node(
        current, store, theme, child, inner_x, cursor, inner_width, along
      )
      cursor = cursor + along + gap
    end
    child_index = child_index + 1
  end
  current
end

export fn layout_scroll_node(
  work: LayoutWork,
  store: WidgetStore,
  theme: Theme,
  id: WidgetId,
  x: i32,
  y: i32,
  width: i32,
  height: i32
) -> LayoutWork = do
  let mut current = work_with_rect(work, id.index, rect_new(x, y, width, height))
  const children = visible_children(store, id)
  if children.length() == 0 then
    return current
  end
  const child = children[0]
  const measured = measure_node(current, store, theme, child)
  current = measured.work
  const offset = scroll_offset_at(current.scroll_offsets, id.index)
  layout_node(
    current,
    store,
    theme,
    child,
    x,
    y - offset,
    width,
    measured.size.height
  )
end

export fn layout_node(
  work: LayoutWork,
  store: WidgetStore,
  theme: Theme,
  id: WidgetId,
  x: i32,
  y: i32,
  width: i32,
  height: i32
) -> LayoutWork =
  match store.nodes[id.index].kind
    | KindLabel(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))
    | KindIcon(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))
    | KindButton(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))
    | KindCheckbox(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))
    | KindBox(_) => layout_box_node(
      work_with_rect(work, id.index, rect_new(x, y, width, height)),
      store,
      theme,
      id,
      x,
      y,
      width,
      height
    )
    | KindScrollView => layout_scroll_node(work, store, theme, id, x, y, width, height)
    | KindListView(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))
    | KindSplitter(_) => layout_split_node(work, store, theme, id, x, y, width, height)
    | KindTextField(_) => work_with_rect(work, id.index, rect_new(x, y, width, height))

export fn layout_split_node(
  work: LayoutWork,
  store: WidgetStore,
  theme: Theme,
  id: WidgetId,
  x: i32,
  y: i32,
  width: i32,
  height: i32
) -> LayoutWork = do
  let mut current = work_with_rect(work, id.index, rect_new(x, y, width, height))
  const children = visible_children(store, id)
  if children.length() == 0 then
    return current
  end
  const placed = splitter_placement_for(
    store, current.splitter_ratios, theme, id, x, y, width, height
  )
  current = layout_node(
    current, store, theme, children[0],
    placed.first.x, placed.first.y, placed.first.width, placed.first.height
  )
  if children.length() == 1 then
    return current
  end
  return layout_node(
    current, store, theme, children[1],
    placed.second.x, placed.second.y, placed.second.width, placed.second.height
  )
end
