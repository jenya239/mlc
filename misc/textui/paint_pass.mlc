import { Theme } from './theme'
import {
  WidgetStore,
  widget_id_is_none
} from './store'
import { LayoutResult } from './layout_result'
import { DrawOp, FillRectOp, TextOp } from './draw_op'

fn paint_node(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  node_index: i32,
  operations: [DrawOp]
) -> [DrawOp] = do
  const node = store.nodes[node_index]
  const rect = layout.rects[node_index]
  let mut current_operations = match node.kind
    | KindLabel(data) => do
      let mut updated = operations
      updated.push(OpText(TextOp {
        origin_x: rect.x,
        origin_y: rect.y,
        color: theme.foreground,
        text: data.text
      }))
      updated
    end
    | KindBox(_) => operations
  let mut child_index = 0
  while child_index < node.children.length() do
    const child_id = node.children[child_index]
    current_operations = paint_node(theme, store, layout, child_id.index, current_operations)
    child_index = child_index + 1
  end
  current_operations
end

export fn paint_frame(theme: Theme, store: WidgetStore, layout: LayoutResult) -> [DrawOp] = do
  let mut operations: [DrawOp] = []
  if widget_id_is_none(store.root) then
    return operations
  end
  const root_rect = layout.rects[store.root.index]
  operations.push(OpFillRect(FillRectOp {
    rect: root_rect,
    color: theme.background
  }))
  paint_node(theme, store, layout, store.root.index, operations)
end
