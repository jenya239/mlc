import { Theme, theme_content_inset, ColorRgba } from './theme'
import { rect_inset, rect_new } from './geometry'
import {
  WidgetStore,
  WidgetId,
  widget_id_is_none,
  widget_id_equals,
  overflow_is_hidden,
  kind_is_scroll_view,
  kind_is_splitter,
  kind_is_text_field
} from './store'
import { LayoutResult } from './layout_result'
import { DrawOp, FillRectOp, StrokeRectOp, TextOp } from './draw_op'
import { Selection, selection_is_empty, selection_none } from './selection'
import { text_layout_selection_rects } from './text_layout_hit'
import { UiState, ui_state_new, ui_state_with, pointer_click_owns } from './ui_state'
import {
  scroll_content_height,
  scroll_content_overflows,
  scroll_bar_rect,
  scroll_thumb_rect,
  scroll_offset_at
} from './widget_scroll'
import { paint_pick_overlay } from './inspect'
import { paint_focused_list_ring, paint_list_rows } from './widget_list'
import { paint_icon_widget } from './icon'
import { paint_checkbox } from './checkbox'
import { menu_list_id } from './menu'
import { paint_splitter_sash } from './widget_split'
import { field_caption, paint_text_field } from './widget_field'
import { path_bar_is_crumb } from './path_bar'

fn paint_selection(
  theme: Theme,
  layout: LayoutResult,
  selection: Selection,
  node_index: i32,
  operations: [DrawOp]
) -> [DrawOp] = do
  if selection_is_empty(selection) then
    return operations
  end
  const owner = WidgetId { index: node_index }
  if widget_id_equals(selection.owner, owner) == false then
    return operations
  end
  const rect = layout.rects[node_index]
  const inset = theme_content_inset(theme)
  const boxes = text_layout_selection_rects(
    layout.text_layouts[node_index],
    selection.anchor,
    selection.focus
  )
  let mut updated = operations
  let mut box_index = 0
  while box_index < boxes.length() do
    const box = boxes[box_index]
    updated.push(OpFillRect(FillRectOp {
      rect: rect_new(
        rect.x + inset + box.x,
        rect.y + inset + box.y,
        box.width,
        box.height
      ),
      color: theme.selection_background
    }))
    box_index = box_index + 1
  end
  updated
end

fn button_fill_color(theme: Theme, state: UiState, node_index: i32) -> ColorRgba = do
  const owner = WidgetId { index: node_index }
  if pointer_click_owns(state.pointer, owner) then
    return theme.button_pressed
  end
  if widget_id_equals(state.hover, owner) then
    return theme.button_hover
  end
  theme.button_background
end

fn path_band_color(theme: Theme, state: UiState, node_index: i32) -> ColorRgba = do
  const owner = WidgetId { index: node_index }
  if pointer_click_owns(state.pointer, owner) then
    return theme.button_pressed
  end
  if widget_id_equals(state.hover, owner) then
    return theme.button_hover
  end
  theme.background
end

export fn paint_path_crumb(
  theme: Theme,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  caption: string,
  operations: [DrawOp]
) -> [DrawOp] = do
  const rect = layout.rects[node_index]
  let mut band_height = layout.text_layouts[node_index].pixel_height
  if band_height < 1 then
    band_height = theme.font_size_pixels
  end
  let mut band_y = rect.y + (rect.height - band_height) / 2
  if band_y < rect.y then
    band_y = rect.y
  end
  let mut updated = operations
  updated.push(OpFillRect(FillRectOp {
    rect: rect_new(rect.x, band_y, rect.width, band_height),
    color: path_band_color(theme, state, node_index)
  }))
  updated.push(OpText(TextOp {
    origin_x: rect.x + 2,
    origin_y: band_y,
    color: theme.foreground,
    text: caption
  }))
  updated
end

export fn paint_button(
  theme: Theme,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  caption: string,
  operations: [DrawOp]
) -> [DrawOp] = do
  const rect = layout.rects[node_index]
  const inset = theme_content_inset(theme)
  const border = 1
  let mut updated = operations
  updated.push(OpFillRect(FillRectOp {
    rect: rect_inset(rect, border),
    color: button_fill_color(theme, state, node_index)
  }))
  updated.push(OpStrokeRect(StrokeRectOp {
    rect: rect,
    color: theme.button_stroke,
    line_width: border
  }))
  updated.push(OpText(TextOp {
    origin_x: rect.x + inset,
    origin_y: rect.y + inset,
    color: theme.foreground,
    text: caption
  }))
  updated
end

fn paint_kind_button(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  caption: string,
  operations: [DrawOp]
) -> [DrawOp] = do
  if path_bar_is_crumb(store, WidgetId { index: node_index }) then
    return paint_path_crumb(theme, layout, state, node_index, caption, operations)
  end
  return paint_button(theme, layout, state, node_index, caption, operations)
end

fn paint_node(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  node_index: i32,
  operations: [DrawOp]
) -> [DrawOp] = do
  const node = store.nodes[node_index]
  if node.visible == false then
    return operations
  end
  const rect = layout.rects[node_index]
  const inset = theme_content_inset(theme)
  let mut current_operations = match node.kind
    | KindLabel(data) => do
      let mut updated = paint_selection(theme, layout, state.selection, node_index, operations)
      updated.push(OpText(TextOp {
        origin_x: rect.x + inset,
        origin_y: rect.y + inset,
        color: theme.foreground,
        text: data.text
      }))
      updated
    end
    | KindIcon(data) => paint_icon_widget(
      operations, theme, rect.x, rect.y, rect.width, rect.height, data.name
    )
    | KindButton(data) => paint_kind_button(
      theme, store, layout, state, node_index, data.text, operations
    )
    | KindCheckbox(data) => paint_checkbox(
      theme, layout, state, node_index, data.text, data.checked, operations
    )
    | KindBox(_) => operations
    | KindScrollView => operations
    | KindListView(data) => paint_list_rows(
      theme,
      layout,
      state,
      node_index,
      data.texts,
      operations,
      menu_list_id(store).index != node_index
    )
    | KindSplitter(_) => operations
    | KindTextField(_) => operations
  end
  if overflow_is_hidden(node.overflow) then
    current_operations.push(OpPushClip(rect))
  end
  if kind_is_text_field(node.kind) then
    current_operations = paint_text_field(
      theme,
      layout,
      state,
      node_index,
      field_caption(node.kind),
      current_operations
    )
  end
  let mut child_index = 0
  while child_index < node.children.length() do
    const child_id = node.children[child_index]
    current_operations = paint_node(
      theme, store, layout, state, child_id.index, current_operations
    )
    child_index = child_index + 1
  end
  if overflow_is_hidden(node.overflow) then
    current_operations.push(OpPopClip)
  end
  if kind_is_scroll_view(node.kind) then
    const content_height = scroll_content_height(store, layout, node.id)
    if scroll_content_overflows(content_height, rect.height) then
      const bar = scroll_bar_rect(theme, rect)
      const thumb = scroll_thumb_rect(
        theme,
        rect,
        scroll_offset_at(state.scroll_offsets, node_index),
        content_height
      )
      current_operations.push(OpFillRect(FillRectOp {
        rect: bar,
        color: theme.scrollbar_track
      }))
      current_operations.push(OpFillRect(FillRectOp {
        rect: thumb,
        color: theme.scrollbar_thumb
      }))
    end
    current_operations = paint_focused_list_ring(
      theme, store, layout, state, node_index, current_operations
    )
  end
  if kind_is_splitter(node.kind) then
    current_operations = paint_splitter_sash(
      theme, store, layout, state, node_index, current_operations
    )
  end
  return current_operations
end

export fn paint_tree_frame(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState
) -> [DrawOp] = do
  let mut operations: [DrawOp] = []
  if widget_id_is_none(store.root) then
    return operations
  end
  const root_rect = layout.rects[store.root.index]
  operations.push(OpFillRect(FillRectOp {
    rect: root_rect,
    color: theme.background
  }))
  return paint_node(theme, store, layout, state, store.root.index, operations)
end

export fn paint_overlay_frame(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState
) -> [DrawOp] = do
  let mut operations: [DrawOp] = []
  return paint_pick_overlay(
    theme,
    store,
    layout,
    state,
    paint_overlay_layer(theme, store, layout, state, operations)
  )
end

export fn paint_ui_frame(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState
) -> [DrawOp] = do
  let mut operations = paint_tree_frame(theme, store, layout, state)
  const overlay = paint_overlay_frame(theme, store, layout, state)
  let mut index = 0
  while index < overlay.length() do
    operations.push(overlay[index])
    index = index + 1
  end
  return operations
end

fn paint_overlay_layer(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  state: UiState,
  operations: [DrawOp]
) -> [DrawOp] = do
  if widget_id_is_none(store.overlay) then
    return operations
  end
  if store.nodes[store.overlay.index].visible == false then
    return operations
  end
  const layer_rect = layout.rects[store.overlay.index]
  let mut next = operations
  if store.placed == false then
    next.push(OpFillRect(FillRectOp { rect: layer_rect, color: theme.overlay_scrim }))
  end
  const children = store.nodes[store.overlay.index].children
  let mut card_rect = rect_new(0, 0, 0, 0)
  let mut has_card = false
  if children.length() > 0 then
    card_rect = layout.rects[children[0].index]
    has_card = true
    next.push(OpFillRect(FillRectOp {
      rect: rect_inset(card_rect, 1),
      color: theme.overlay_background
    }))
  end
  next = paint_node(theme, store, layout, state, store.overlay.index, next)
  if has_card then
    next.push(OpStrokeRect(StrokeRectOp {
      rect: card_rect,
      color: theme.overlay_stroke,
      line_width: 1
    }))
  end
  return next
end

export fn paint_selected_frame(
  theme: Theme,
  store: WidgetStore,
  layout: LayoutResult,
  selection: Selection
) -> [DrawOp] = do
  const empty = ui_state_new()
  paint_ui_frame(
    theme,
    store,
    layout,
    ui_state_with(
      empty,
      selection,
      empty.grab,
      empty.pointer,
      empty.last_press,
      empty.clipboard,
      empty.hover
    )
  )
end

export fn paint_frame(theme: Theme, store: WidgetStore, layout: LayoutResult) -> [DrawOp] =
  paint_selected_frame(theme, store, layout, selection_none())
