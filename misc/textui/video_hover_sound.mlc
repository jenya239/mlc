import {
  music_is_paused,
  music_path,
  music_play_path,
  music_position_seconds,
  music_queue_text,
  music_release,
  music_restore,
  music_track_index
} from './music_host'

extern fn video_replay(path: string) -> unit
  = "mlc::image_preview::video_replay_value" from "mlc/gl/image_preview.hpp" blocking

export type VideoHoverSound = {
  path: string,
  started_ms: i32,
  audible_path: string,
  saved_track: string,
  saved_queue: string,
  saved_index: i32,
  saved_position: i32,
  saved_paused: bool,
  saved: bool
}

fn ends_with(text: string, suffix: string) -> bool = do
  if text.byte_size() < suffix.byte_size() then
    return false
  end
  return text.byte_substring(text.byte_size() - suffix.byte_size(), suffix.byte_size()) == suffix
end

fn video_suffix(path: string) -> bool = do
  if ends_with(path, ".mp4") || ends_with(path, ".MP4") || ends_with(path, ".m4v") || ends_with(path, ".M4V") then
    return true
  end
  if ends_with(path, ".mov") || ends_with(path, ".MOV") || ends_with(path, ".mkv") || ends_with(path, ".MKV") then
    return true
  end
  if ends_with(path, ".webm") || ends_with(path, ".WEBM") || ends_with(path, ".avi") || ends_with(path, ".AVI") then
    return true
  end
  return ends_with(path, ".ogv") || ends_with(path, ".OGV")
end

fn video_only(path: string) -> string = do
  if video_suffix(path) then
    return path
  end
  return ""
end

export fn video_hover_sound_new() -> VideoHoverSound =
  VideoHoverSound {
    path: "",
    started_ms: 0,
    audible_path: "",
    saved_track: "",
    saved_queue: "",
    saved_index: 0,
    saved_position: 0,
    saved_paused: false,
    saved: false
  }

fn sound_with_path(sound: VideoHoverSound, path: string, started_ms: i32) -> VideoHoverSound =
  VideoHoverSound {
    path: path,
    started_ms: started_ms,
    audible_path: "",
    saved_track: "",
    saved_queue: "",
    saved_index: 0,
    saved_position: 0,
    saved_paused: false,
    saved: false
  }

fn stop_audible(sound: VideoHoverSound) -> VideoHoverSound = do
  if sound.audible_path != "" then
    if sound.saved then
      music_restore(sound.saved_track, sound.saved_queue, sound.saved_index, sound.saved_position, sound.saved_paused)
    else
      music_release()
    end
  end
  return video_hover_sound_new()
end

fn begin_audible(sound: VideoHoverSound, path: string) -> VideoHoverSound = do
  let mut saved = false
  let mut saved_track = ""
  let mut saved_queue = ""
  let mut saved_index = 0
  let mut saved_position = 0
  let mut saved_paused = false
  const current = music_path()
  if current != "" && current != path then
    saved = true
    saved_track = current
    saved_queue = music_queue_text()
    saved_index = music_track_index()
    saved_position = music_position_seconds()
    saved_paused = music_is_paused()
  end
  music_play_path(path)
  video_replay(path)
  return VideoHoverSound {
    path: sound.path,
    started_ms: sound.started_ms,
    audible_path: path,
    saved_track: saved_track,
    saved_queue: saved_queue,
    saved_index: saved_index,
    saved_position: saved_position,
    saved_paused: saved_paused,
    saved: saved
  }
end

export fn video_hover_sound_tick(sound: VideoHoverSound, hovered_path: string, now_ms: i32) -> VideoHoverSound = do
  const path = video_only(hovered_path)
  if path == "" || path != sound.path then
    let mut cleared = stop_audible(sound)
    if path != "" then
      cleared = sound_with_path(cleared, path, now_ms)
    end
    return cleared
  end
  if sound.audible_path == path then
    return sound
  end
  if now_ms - sound.started_ms < 5000 then
    return sound
  end
  return begin_audible(sound, path)
end
