import { Theme } from './theme'
import { ChatModel } from './chat_model'
import {
  block_scroll_bottom,
  block_scroll_clamp,
  block_scroll_is_at_bottom
} from './block_index'
import { TextShapingState } from '../gui/text_shaping'
import { TextLayoutCache } from './text_layout'
import {
  TranscriptCaret,
  transcript_caret_missing,
  transcript_copy_carets
} from './chat_transcript_caret'
import { transcript_caret_at } from './chat_transcript_hit'
import { Rect, rect_contains } from './geometry'
import { scroll_bar_rect, scroll_offset_from_track, scroll_step } from './widget_scroll'
import { UiInput } from './ui_input'
import { TranscriptView } from './chat_transcript_layout'

export type TranscriptSelection = {
  anchor_block: i32,
  anchor_byte: i32,
  focus_block: i32,
  focus_byte: i32,
  dragging: i32
}

export type TranscriptInputResult = {
  view: TranscriptView,
  selection: TranscriptSelection,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  bar_drag: i32
}

export fn transcript_selection_new() -> TranscriptSelection =
  TranscriptSelection {
    anchor_block: 0 - 1,
    anchor_byte: 0,
    focus_block: 0 - 1,
    focus_byte: 0,
    dragging: 0
  }

fn selection_anchor(selection: TranscriptSelection) -> TranscriptCaret =
  TranscriptCaret { block: selection.anchor_block, byte_index: selection.anchor_byte }

fn selection_focus(selection: TranscriptSelection) -> TranscriptCaret =
  TranscriptCaret { block: selection.focus_block, byte_index: selection.focus_byte }

fn selection_collapsed(caret: TranscriptCaret, dragging: i32) -> TranscriptSelection =
  TranscriptSelection {
    anchor_block: caret.block,
    anchor_byte: caret.byte_index,
    focus_block: caret.block,
    focus_byte: caret.byte_index,
    dragging: dragging
  }

fn selection_moved(selection: TranscriptSelection, caret: TranscriptCaret, dragging: i32) -> TranscriptSelection =
  TranscriptSelection {
    anchor_block: selection.anchor_block,
    anchor_byte: selection.anchor_byte,
    focus_block: caret.block,
    focus_byte: caret.byte_index,
    dragging: dragging
  }

fn selection_settled(selection: TranscriptSelection) -> TranscriptSelection =
  TranscriptSelection {
    anchor_block: selection.anchor_block,
    anchor_byte: selection.anchor_byte,
    focus_block: selection.focus_block,
    focus_byte: selection.focus_byte,
    dragging: 0
  }

export fn transcript_pointer_routed(input: UiInput, rect: Rect) -> bool =
  input.left_pressed && rect_contains(rect, input.mouse_x, input.mouse_y)

export fn transcript_consume_press(input: UiInput, rect: Rect) -> UiInput = do
  if transcript_pointer_routed(input, rect) then
    return UiInput {
      mouse_x: input.mouse_x,
      mouse_y: input.mouse_y,
      left_pressed: false,
      left_down: input.left_down,
      left_released: input.left_released,
      control_down: input.control_down,
      copy_pressed: input.copy_pressed,
      wheel_y: input.wheel_y,
      now_ms: input.now_ms,
      text: input.text,
      binding_key: input.binding_key,
      shift_down: input.shift_down,
      backspace_pressed: input.backspace_pressed,
      enter_pressed: input.enter_pressed,
      paste_text: input.paste_text
    }
  end
  input
end

fn shown_scroll(view: TranscriptView, view_height: i32) -> i32 = do
  if view.stick_to_bottom != 0 then
    return block_scroll_bottom(view.index.total, view_height)
  end
  block_scroll_clamp(view.index.total, view_height, view.scroll_y)
end

fn stick_flag(total: i32, view_height: i32, y: i32) -> i32 = do
  if block_scroll_is_at_bottom(total, view_height, y) then
    return 1
  end
  0
end

fn with_scroll(view: TranscriptView, scroll_y: i32, view_height: i32) -> TranscriptView =
  TranscriptView {
    width: view.width,
    measured_count: view.measured_count,
    scroll_y: scroll_y,
    stick_to_bottom: stick_flag(view.index.total, view_height, scroll_y),
    index: view.index
  }

fn pointer_on_bar(theme: Theme, view: TranscriptView, rect: Rect, x: i32, y: i32) -> bool = do
  if view.index.total <= rect.height then
    return false
  end
  rect_contains(scroll_bar_rect(theme, rect), x, y)
end

export fn transcript_copy_text(
  model: ChatModel,
  selection: TranscriptSelection,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  width: i32
) -> string =
  transcript_copy_shown(model, selection, shaping, cache, theme, width, false)

export fn transcript_copy_shown(
  model: ChatModel,
  selection: TranscriptSelection,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  theme: Theme,
  width: i32,
  highlight: bool
) -> string =
  transcript_copy_carets(model, selection_anchor(selection), selection_focus(selection), highlight)

fn apply_scroll_keys(
  view: TranscriptView,
  input: UiInput,
  rect: Rect,
  scroll: i32
) -> i32 = do
  if input.binding_key == "page_down" then
    return scroll + rect.height
  end
  if input.binding_key == "page_up" then
    return scroll - rect.height
  end
  if input.binding_key == "end" && input.control_down then
    return block_scroll_bottom(view.index.total, rect.height)
  end
  scroll
end

export fn transcript_input(
  theme: Theme,
  view: TranscriptView,
  selection: TranscriptSelection,
  model: ChatModel,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  rect: Rect,
  input: UiInput,
  bar_drag: i32
) -> TranscriptInputResult =
  transcript_input_shown(
    theme, view, selection, model, shaping, cache, rect, input, bar_drag, false
  )

export fn transcript_input_shown(
  theme: Theme,
  view: TranscriptView,
  selection: TranscriptSelection,
  model: ChatModel,
  shaping: TextShapingState,
  cache: TextLayoutCache,
  rect: Rect,
  input: UiInput,
  bar_drag: i32,
  highlight: bool
) -> TranscriptInputResult = do
  let mut scroll = shown_scroll(view, rect.height)
  const keyed = apply_scroll_keys(view, input, rect, scroll)
  if keyed != scroll then
    scroll = block_scroll_clamp(view.index.total, rect.height, keyed)
  end
  if input.wheel_y != 0 && rect_contains(rect, input.mouse_x, input.mouse_y) then
    scroll = block_scroll_clamp(
      view.index.total,
      rect.height,
      scroll + input.wheel_y * scroll_step(theme)
    )
  end
  let mut next_bar = bar_drag
  const on_bar = pointer_on_bar(theme, view, rect, input.mouse_x, input.mouse_y)
  if input.left_pressed && on_bar then
    next_bar = 1
    scroll = block_scroll_clamp(
      view.index.total,
      rect.height,
      scroll_offset_from_track(rect, input.mouse_y, view.index.total)
    )
  end
  if input.left_pressed == false && next_bar != 0 && input.left_down then
    scroll = block_scroll_clamp(
      view.index.total,
      rect.height,
      scroll_offset_from_track(rect, input.mouse_y, view.index.total)
    )
  end
  if input.left_down == false then
    next_bar = 0
  end
  let mut next_selection = selection
  let mut selection_handled = false
  if next_bar != 0 then
    next_selection = selection_settled(selection)
    selection_handled = true
  end
  if selection_handled == false && input.left_pressed && rect_contains(rect, input.mouse_x, input.mouse_y) then
    const pressed = transcript_caret_at(
      model, view, shaping, cache, theme, rect, scroll, input.mouse_x, input.mouse_y, highlight
    )
    if transcript_caret_missing(pressed) == false then
      next_selection = selection_collapsed(pressed, 1)
    end
    selection_handled = true
  end
  if selection_handled == false && selection.dragging != 0 && input.left_down && selection.anchor_block >= 0 then
    const dragged = transcript_caret_at(
      model, view, shaping, cache, theme, rect, scroll, input.mouse_x, input.mouse_y, highlight
    )
    if transcript_caret_missing(dragged) == false then
      next_selection = selection_moved(selection, dragged, 1)
    end
    selection_handled = true
  end
  if selection_handled == false && input.left_down == false then
    next_selection = selection_settled(selection)
  end
  TranscriptInputResult {
    view: with_scroll(view, scroll, rect.height),
    selection: next_selection,
    shaping: shaping,
    cache: cache,
    bar_drag: next_bar
  }
end
