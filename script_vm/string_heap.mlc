import { Value, ValueInt32, ValueHeapRef, value_encode, value_decode } from './value'
import {
  ObjectHeader,
  HeapSlot,
  Heap,
  HeapAlloc,
  heap_type_string
} from './heap_types'
import {
  heap_alloc_array,
  heap_object_type_id,
  heap_element_count,
  heap_get_element
} from './heap'

fn reference_object_id(value: Value) -> i32 =
  match value_decode(value) {
    ValueHeapRef(object_id) => object_id,
    _ => 0 - 1
  }

fn decoded_byte(value: Value) -> i32 =
  match value_decode(value) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn stored_string_slot(slot: HeapSlot) -> HeapSlot =
  HeapSlot {
    header: ObjectHeader {
      type_id: heap_type_string(),
      gc_flags: slot.header.gc_flags,
      object_flags: slot.header.object_flags,
      shape_or_meta: slot.header.shape_or_meta
    },
    child: slot.child,
    element_start: slot.element_start,
    element_count: slot.element_count,
    size_class: slot.size_class,
    live: slot.live
  }

fn write_byte(heap: ref mut Heap, object_id: i32, index: i32, byte_value: i32) -> unit = do
  let slot = heap.slots[object_id]
  heap.element_arena.set(slot.element_start + index, value_encode(ValueInt32(byte_value)))
end

fn write_all_bytes(heap: ref mut Heap, object_id: i32, bytes: [i32]) -> unit = do
  let mut index = 0
  while index < bytes.length() do
    write_byte(heap, object_id, index, bytes[index])
    index = index + 1
  end
end

fn finish_string(allocated: HeapAlloc, bytes: [i32]) -> HeapAlloc = do
  let mut next = allocated.heap
  let object_id = reference_object_id(allocated.value)
  next.slots.set(object_id, stored_string_slot(next.slots[object_id]))
  write_all_bytes(next, object_id, bytes)
  HeapAlloc { heap: next, value: allocated.value }
end

export fn string_heap_from_bytes(heap: Heap, bytes: [i32]) -> HeapAlloc = do
  let allocated = heap_alloc_array(heap, bytes.length())
  finish_string(allocated, bytes)
end

export fn string_heap_length(heap: Heap, value: Value) -> i32 =
  if heap_object_type_id(heap, value) == heap_type_string() then
    heap_element_count(heap, value)
  else
    0
  end

export fn string_heap_byte_at(heap: Heap, value: Value, index: i32) -> i32 =
  if heap_object_type_id(heap, value) != heap_type_string() then
    0 - 1
  else if index < 0 then
    0 - 1
  else if index >= heap_element_count(heap, value) then
    0 - 1
  else
    decoded_byte(heap_get_element(heap, value, index))
  end

fn bytes_match(heap: Heap, left: Value, right: Value, length: i32) -> bool = do
  let mut index = 0
  let mut same = true
  while index < length && same do
    if string_heap_byte_at(heap, left, index) != string_heap_byte_at(heap, right, index) then
      same = false
    end
    index = index + 1
  end
  same
end

export fn string_heap_equal(heap: Heap, left: Value, right: Value) -> bool = do
  let left_length = string_heap_length(heap, left)
  let right_length = string_heap_length(heap, right)
  if left_length != right_length then
    false
  else
    bytes_match(heap, left, right, left_length)
  end
end

fn collected_bytes(heap: Heap, value: Value) -> [i32] = do
  let mut bytes: [i32] = []
  let mut index = 0
  let length = string_heap_length(heap, value)
  while index < length do
    bytes.push(string_heap_byte_at(heap, value, index))
    index = index + 1
  end
  bytes
end

fn joined_bytes(left_bytes: [i32], right_bytes: [i32]) -> [i32] = do
  let mut bytes: [i32] = []
  let mut index = 0
  while index < left_bytes.length() do
    bytes.push(left_bytes[index])
    index = index + 1
  end
  let mut right_index = 0
  while right_index < right_bytes.length() do
    bytes.push(right_bytes[right_index])
    right_index = right_index + 1
  end
  bytes
end

export fn string_heap_concatenate(heap: Heap, left: Value, right: Value) -> HeapAlloc =
  string_heap_from_bytes(heap, joined_bytes(collected_bytes(heap, left), collected_bytes(heap, right)))
