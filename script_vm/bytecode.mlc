// TRACK_MLC_SCRIPT_VM §103b — ABC instruction word + wide trailing immediate.
// Bit layout [opcode:8|A:8|B:8|C:8] in an i32 word (u32 bits; MLC/codegen has
// no usable C++ `u32` mapping). Wide form: primary with B=0,C=1 + trailing i32
// (C=1 is the wide marker — disambiguates narrow LOAD_CONST/JUMP with zero).

export type Instruction = { word: i32 }

export type DecodedAbc = {
  opcode: i32,
  a: i32,
  b: i32,
  c: i32
}

fn opcode_load_const() -> i32 = 1
fn opcode_move() -> i32 = 2
fn opcode_add() -> i32 = 3
fn opcode_sub() -> i32 = 4
fn opcode_mul() -> i32 = 5
fn opcode_div() -> i32 = 6
fn opcode_return() -> i32 = 7
fn opcode_jump() -> i32 = 8
fn opcode_jump_if_false() -> i32 = 9
fn opcode_eq() -> i32 = 10
fn opcode_ne() -> i32 = 11
fn opcode_lt() -> i32 = 12
fn opcode_le() -> i32 = 13
fn opcode_gt() -> i32 = 14
fn opcode_ge() -> i32 = 15
fn opcode_new_array() -> i32 = 16
fn opcode_get_index() -> i32 = 17
fn opcode_set_index() -> i32 = 18
fn opcode_new_record() -> i32 = 19
fn opcode_get_prop() -> i32 = 20
fn opcode_set_prop() -> i32 = 21
fn opcode_call() -> i32 = 22
fn opcode_make_closure() -> i32 = 23
fn opcode_get_upval() -> i32 = 24
fn opcode_set_upval() -> i32 = 25

export fn instruction_opcode_load_const() -> i32 = opcode_load_const()
export fn instruction_opcode_move() -> i32 = opcode_move()
export fn instruction_opcode_add() -> i32 = opcode_add()
export fn instruction_opcode_sub() -> i32 = opcode_sub()
export fn instruction_opcode_mul() -> i32 = opcode_mul()
export fn instruction_opcode_div() -> i32 = opcode_div()
export fn instruction_opcode_return() -> i32 = opcode_return()
export fn instruction_opcode_jump() -> i32 = opcode_jump()
export fn instruction_opcode_jump_if_false() -> i32 = opcode_jump_if_false()
export fn instruction_opcode_eq() -> i32 = opcode_eq()
export fn instruction_opcode_ne() -> i32 = opcode_ne()
export fn instruction_opcode_lt() -> i32 = opcode_lt()
export fn instruction_opcode_le() -> i32 = opcode_le()
export fn instruction_opcode_gt() -> i32 = opcode_gt()
export fn instruction_opcode_ge() -> i32 = opcode_ge()
export fn instruction_opcode_new_array() -> i32 = opcode_new_array()
export fn instruction_opcode_get_index() -> i32 = opcode_get_index()
export fn instruction_opcode_set_index() -> i32 = opcode_set_index()
export fn instruction_opcode_new_record() -> i32 = opcode_new_record()
export fn instruction_opcode_get_prop() -> i32 = opcode_get_prop()
export fn instruction_opcode_set_prop() -> i32 = opcode_set_prop()
export fn instruction_opcode_call() -> i32 = opcode_call()
export fn instruction_opcode_make_closure() -> i32 = opcode_make_closure()
export fn instruction_opcode_get_upval() -> i32 = opcode_get_upval()
export fn instruction_opcode_set_upval() -> i32 = opcode_set_upval()

export fn instruction_encode(opcode: i32, a: i32, b: i32, c: i32) -> Instruction =
  Instruction {
    word: (opcode & 255) | ((a & 255) << 8) | ((b & 255) << 16) | ((c & 255) << 24)
  }

export fn instruction_decode(instruction: Instruction) -> DecodedAbc =
  DecodedAbc {
    opcode: instruction.word & 255,
    a: (instruction.word >> 8) & 255,
    b: (instruction.word >> 16) & 255,
    c: (instruction.word >> 24) & 255
  }

fn fits_u8(value: i32) -> bool = value >= 0 && value <= 255

fn fits_i16(value: i32) -> bool = value >= (0 - 32768) && value <= 32767

fn pack_i16_high_low(offset: i32) -> DecodedAbc = do
  const masked = offset & 65535
  DecodedAbc {
    opcode: 0,
    a: 0,
    b: (masked >> 8) & 255,
    c: masked & 255
  }
end

fn unpack_i16_high_low(b: i32, c: i32) -> i32 = do
  const rebuilt = ((b & 255) << 8) | (c & 255)
  if (rebuilt & 32768) != 0 then
    rebuilt - 65536
  else
    rebuilt
  end
end

export fn instruction_is_wide(decoded: DecodedAbc) -> bool =
  (decoded.opcode == opcode_load_const() || decoded.opcode == opcode_jump() || decoded.opcode == opcode_jump_if_false()) && decoded.b == 0 && decoded.c == 1

export fn instruction_word_span(words: [i32], index: i32) -> i32 = do
  if index < 0 then
    0
  else if index >= words.length() then
    0
  else
    const word_value = words[index]
    const decoded = instruction_decode(Instruction { word: word_value })
    if decoded.opcode == opcode_make_closure() then
      1 + decoded.c
    else if instruction_is_wide(decoded) then
      2
    else
      1
    end
  end
end

export fn instruction_words_load_const(destination: i32, constant_index: i32) -> [i32] = do
  let mut words: [i32] = []
  if fits_u8(constant_index) then
    words.push(instruction_encode(opcode_load_const(), destination, constant_index, 0).word)
  else
    words.push(instruction_encode(opcode_load_const(), destination, 0, 1).word)
    words.push(constant_index)
  end
  words
end

export fn instruction_words_move(destination: i32, source: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_move(), destination, source, 0).word)
  words
end

export fn instruction_words_binary(opcode: i32, destination: i32, left: i32, right: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode, destination, left, right).word)
  words
end

export fn instruction_words_return(source: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_return(), source, 0, 0).word)
  words
end

export fn instruction_words_new_array(destination: i32, length_register: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_new_array(), destination, length_register, 0).word)
  words
end

export fn instruction_words_get_index(destination: i32, array_register: i32, index_register: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_get_index(), destination, array_register, index_register).word)
  words
end

export fn instruction_words_set_index(array_register: i32, index_register: i32, value_register: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_set_index(), array_register, index_register, value_register).word)
  words
end

export fn instruction_words_new_record(destination: i32, field_count: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_new_record(), destination, field_count, 0).word)
  words
end

export fn instruction_words_get_prop(destination: i32, record_register: i32, field_index: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_get_prop(), destination, record_register, field_index).word)
  words
end

export fn instruction_words_set_prop(record_register: i32, field_index: i32, value_register: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_set_prop(), record_register, field_index, value_register).word)
  words
end

export fn instruction_upvalue_source_word(is_local: i32, index: i32) -> i32 =
  ((is_local & 255) << 8) | (index & 255)

export fn instruction_upvalue_source_is_local(word: i32) -> i32 =
  (word >> 8) & 255

export fn instruction_upvalue_source_index(word: i32) -> i32 =
  word & 255

export fn instruction_words_call(destination: i32, function_register: i32, argument_count: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_call(), destination, function_register, argument_count).word)
  words
end

export fn instruction_words_make_closure(
  destination: i32,
  proto_index: i32,
  upvalue_source_words: [i32]
) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_make_closure(), destination, proto_index, upvalue_source_words.length()).word)
  let mut index = 0
  while index < upvalue_source_words.length() do
    words.push(upvalue_source_words[index])
    index = index + 1
  end
  words
end

export fn instruction_words_get_upval(destination: i32, upvalue_index: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_get_upval(), destination, upvalue_index, 0).word)
  words
end

export fn instruction_words_set_upval(upvalue_index: i32, source_register: i32) -> [i32] = do
  let mut words: [i32] = []
  words.push(instruction_encode(opcode_set_upval(), upvalue_index, source_register, 0).word)
  words
end

export fn instruction_words_jump(offset: i32) -> [i32] = do
  let mut words: [i32] = []
  if fits_i16(offset) then
    const packed = pack_i16_high_low(offset)
    if packed.b == 0 && packed.c == 1 then
      words.push(instruction_encode(opcode_jump(), 0, 0, 1).word)
      words.push(offset)
    else
      words.push(instruction_encode(opcode_jump(), 0, packed.b, packed.c).word)
    end
  else
    words.push(instruction_encode(opcode_jump(), 0, 0, 1).word)
    words.push(offset)
  end
  words
end

export fn instruction_words_jump_if_false(condition: i32, offset: i32) -> [i32] = do
  let mut words: [i32] = []
  if fits_i16(offset) then
    const packed = pack_i16_high_low(offset)
    if packed.b == 0 && packed.c == 1 then
      words.push(instruction_encode(opcode_jump_if_false(), condition, 0, 1).word)
      words.push(offset)
    else
      words.push(instruction_encode(opcode_jump_if_false(), condition, packed.b, packed.c).word)
    end
  else
    words.push(instruction_encode(opcode_jump_if_false(), condition, 0, 1).word)
    words.push(offset)
  end
  words
end

export fn instruction_word_to_le_bytes(word: i32) -> [i32] = do
  let mut bytes: [i32] = []
  bytes.push(word & 255)
  bytes.push((word >> 8) & 255)
  bytes.push((word >> 16) & 255)
  bytes.push((word >> 24) & 255)
  bytes
end

export fn instruction_word_from_le_bytes(bytes: [i32]) -> i32 =
  (bytes[0] & 255) | ((bytes[1] & 255) << 8) | ((bytes[2] & 255) << 16) | ((bytes[3] & 255) << 24)

fn register_name(register_index: i32) -> string = "r" + register_index.to_string()

fn format_signed_offset(offset: i32) -> string =
  if offset >= 0 then
    "+" + offset.to_string()
  else
    offset.to_string()
  end

export fn instruction_disassemble(words: [i32], index: i32) -> string = do
  if index < 0 || index >= words.length() then
    "<out-of-range>"
  else
    const decoded = instruction_decode(Instruction { word: words[index] })
    if decoded.opcode == opcode_load_const() then
      if instruction_is_wide(decoded) then
        if index + 1 >= words.length() then
          "<truncated-wide-LOAD_CONST>"
        else
          "LOAD_CONST " + register_name(decoded.a) + ", #" + words[index + 1].to_string()
        end
      else
        "LOAD_CONST " + register_name(decoded.a) + ", #" + decoded.b.to_string()
      end
    else if decoded.opcode == opcode_move() then
      "MOVE " + register_name(decoded.a) + ", " + register_name(decoded.b)
    else if decoded.opcode == opcode_add() then
      "ADD " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_sub() then
      "SUB " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_mul() then
      "MUL " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_div() then
      "DIV " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_return() then
      "RETURN " + register_name(decoded.a)
    else if decoded.opcode == opcode_jump() then
      if instruction_is_wide(decoded) then
        if index + 1 >= words.length() then
          "<truncated-wide-JUMP>"
        else
          "JUMP " + format_signed_offset(words[index + 1])
        end
      else
        "JUMP " + format_signed_offset(unpack_i16_high_low(decoded.b, decoded.c))
      end
    else if decoded.opcode == opcode_jump_if_false() then
      if instruction_is_wide(decoded) then
        if index + 1 >= words.length() then
          "<truncated-wide-JUMP_IF_FALSE>"
        else
          "JUMP_IF_FALSE " + register_name(decoded.a) + ", " + format_signed_offset(words[index + 1])
        end
      else
        "JUMP_IF_FALSE " + register_name(decoded.a) + ", " +
          format_signed_offset(unpack_i16_high_low(decoded.b, decoded.c))
      end
    else if decoded.opcode == opcode_eq() then
      "EQ " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_ne() then
      "NE " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_lt() then
      "LT " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_le() then
      "LE " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_gt() then
      "GT " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_ge() then
      "GE " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_new_array() then
      "NEW_ARRAY " + register_name(decoded.a) + ", " + register_name(decoded.b)
    else if decoded.opcode == opcode_get_index() then
      "GET_INDEX " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_set_index() then
      "SET_INDEX " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_new_record() then
      "NEW_RECORD " + register_name(decoded.a) + ", #" + decoded.b.to_string()
    else if decoded.opcode == opcode_get_prop() then
      "GET_PROP " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", #" + decoded.c.to_string()
    else if decoded.opcode == opcode_set_prop() then
      "SET_PROP " + register_name(decoded.a) + ", #" + decoded.b.to_string() + ", " + register_name(decoded.c)
    else if decoded.opcode == opcode_call() then
      "CALL " + register_name(decoded.a) + ", " + register_name(decoded.b) + ", #" + decoded.c.to_string()
    else if decoded.opcode == opcode_make_closure() then
      "MAKE_CLOSURE " + register_name(decoded.a) + ", #" + decoded.b.to_string() + ", #" + decoded.c.to_string()
    else if decoded.opcode == opcode_get_upval() then
      "GET_UPVAL " + register_name(decoded.a) + ", #" + decoded.b.to_string()
    else if decoded.opcode == opcode_set_upval() then
      "SET_UPVAL #" + decoded.a.to_string() + ", " + register_name(decoded.b)
    else
      "<unknown-opcode " + decoded.opcode.to_string() + ">"
    end
  end
end

export fn instruction_load_const_index(words: [i32], index: i32) -> i32 = do
  const decoded = instruction_decode(Instruction { word: words[index] })
  if instruction_is_wide(decoded) then
    words[index + 1]
  else
    decoded.b
  end
end

export fn instruction_jump_offset(words: [i32], index: i32) -> i32 = do
  const decoded = instruction_decode(Instruction { word: words[index] })
  if instruction_is_wide(decoded) then
    words[index + 1]
  else
    unpack_i16_high_low(decoded.b, decoded.c)
  end
end
