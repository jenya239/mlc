// TRACK_MLC_SCRIPT_VM §103d — arithmetic interpreter (verify-first, no control flow).
import { Value } from './value'
import { Heap, heap_new } from './heap'
import {
  RunResult,
  RunOk,
  RunErr,
  RunHeapResult,
  FunctionProto,
  run_err_verify,
  run_err_type,
  run_err_overflow,
  run_err_div_zero,
  run_err_no_return,
  run_err_unsupported_opcode,
  run_err_bounds,
  run_err_stack
} from './run_result'
import { run_state_single_function, run_state_program } from './executor'

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

export fn run_with_heap(
  heap: Heap,
  words: [i32],
  constants: [Value],
  register_count: i32
) -> RunHeapResult =
  run_state_single_function(heap, words, constants, register_count)

export fn run_arithmetic(words: [i32], constants: [Value], register_count: i32) -> RunResult =
  run_with_heap(heap_new(), words, constants, register_count).result

export fn run_program(heap: Heap, protos: [FunctionProto], entry_proto_index: i32) -> RunHeapResult =
  run_state_program(heap, protos, entry_proto_index, empty_arguments())

export fn run_program_with_args(
  heap: Heap,
  protos: [FunctionProto],
  entry_proto_index: i32,
  args: [Value]
) -> RunHeapResult =
  run_state_program(heap, protos, entry_proto_index, args)
