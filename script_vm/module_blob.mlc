import { Value, ValueInt32, ValueHeapRef, value_encode, value_decode } from './value'
import { FunctionProto } from './interpreter'
import {
  instruction_words_load_const,
  instruction_words_binary,
  instruction_words_return,
  instruction_opcode_add
} from './bytecode'
import {
  emb_ok,
  emb_unsupported,
  emb_format
} from './embedding_codes'
import {
  ModuleLimits,
  default_module_limits,
  module_blob_exceeds_limit,
  cursor_count_fits
} from './module_limits'

extern fn embedding_u8_at(data_pointer: i64, index: i32) -> i32 =
  "mlc::script_vm::embedding_u8_at" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_i64_byte(value: i64, byte_index: i32) -> i32 =
  "mlc::script_vm::embedding_i64_byte" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_u8_to_i64(byte_value: i32) -> i64 =
  "mlc::script_vm::embedding_u8_to_i64" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_string_from_byte(value: i32) -> string =
  "mlc::script_vm::embedding_string_from_byte" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_string_byte(text: string, index: i32) -> i32 =
  "mlc::script_vm::embedding_string_byte" from "mlc/script_vm/embedding_helpers.hpp" thread_safe

export type ModuleExport = { name: string, proto_index: i32 }
export type DecodedModule = {
  exports: [ModuleExport],
  protos: [FunctionProto]
}
export type DecodeResult = { code: i32, decoded_module: DecodedModule }

fn magic_mlsc() -> i32 = 1129531469

fn append_u32_le(bytes: [i32], value: i32) -> [i32] = do
  bytes.push(value & 255)
  bytes.push((value >> 8) & 255)
  bytes.push((value >> 16) & 255)
  bytes.push((value >> 24) & 255)
  bytes
end

fn append_i64_le(bytes: [i32], value: i64) -> [i32] = do
  let mut byte_index = 0
  while byte_index < 8 do
    bytes.push(embedding_i64_byte(value, byte_index))
    byte_index = byte_index + 1
  end
  bytes
end

fn read_u32_le(bytes: [i32], offset: i32) -> i32 =
  (bytes[offset] & 255) |
  ((bytes[offset + 1] & 255) << 8) |
  ((bytes[offset + 2] & 255) << 16) |
  ((bytes[offset + 3] & 255) << 24)

fn read_i64_le(bytes: [i32], offset: i32) -> i64 = do
  let mut value = embedding_u8_to_i64(0)
  let mut index = 0
  while index < 8 do
    const part = embedding_u8_to_i64(bytes[offset + index] & 255)
    const shift = embedding_u8_to_i64(index * 8)
    value = value | (part << shift)
    index = index + 1
  end
  value
end

export fn bytes_from_pointer(data_pointer: i64, size: i32) -> [i32] = do
  let mut bytes: [i32] = []
  let mut index = 0
  while index < size do
    bytes.push(embedding_u8_at(data_pointer, index))
    index = index + 1
  end
  bytes
end

fn name_from_bytes(bytes: [i32], offset: i32, length: i32) -> string = do
  let mut name = ""
  let mut index = 0
  while index < length do
    name = name + embedding_string_from_byte(bytes[offset + index] & 255)
    index = index + 1
  end
  name
end

fn append_words(destination: [i32], source: [i32]) -> [i32] = do
  let mut index = 0
  while index < source.length() do
    destination.push(source[index])
    index = index + 1
  end
  destination
end

fn append_name_bytes(bytes: [i32], name: string) -> [i32] = do
  let mut index = 0
  while index < name.byte_size() do
    bytes.push(embedding_string_byte(name, index) & 255)
    index = index + 1
  end
  bytes
end

fn append_export(bytes: [i32], export_entry: ModuleExport) -> [i32] = do
  let mut encoded = append_u32_le(bytes, export_entry.name.byte_size())
  encoded = append_name_bytes(encoded, export_entry.name)
  append_u32_le(encoded, export_entry.proto_index)
end

fn append_exports(bytes: [i32], exports: [ModuleExport]) -> [i32] = do
  let mut encoded = bytes
  let mut index = 0
  while index < exports.length() do
    encoded = append_export(encoded, exports[index])
    index = index + 1
  end
  encoded
end

fn append_proto_words(bytes: [i32], words: [i32]) -> [i32] = do
  let mut encoded = bytes
  let mut index = 0
  while index < words.length() do
    encoded = append_u32_le(encoded, words[index])
    index = index + 1
  end
  encoded
end

fn append_proto_constants(bytes: [i32], constants: [Value]) -> [i32] = do
  let mut encoded = bytes
  let mut index = 0
  while index < constants.length() do
    encoded = append_i64_le(encoded, constants[index].raw)
    index = index + 1
  end
  encoded
end

fn append_proto(bytes: [i32], proto: FunctionProto) -> [i32] = do
  let mut encoded = append_u32_le(bytes, proto.register_count)
  encoded = append_u32_le(encoded, proto.words.length())
  encoded = append_proto_words(encoded, proto.words)
  encoded = append_u32_le(encoded, proto.constants.length())
  append_proto_constants(encoded, proto.constants)
end

fn append_protos(bytes: [i32], protos: [FunctionProto]) -> [i32] = do
  let mut encoded = bytes
  let mut index = 0
  while index < protos.length() do
    encoded = append_proto(encoded, protos[index])
    index = index + 1
  end
  encoded
end

export fn module_encode(exports: [ModuleExport], protos: [FunctionProto]) -> [i32] = do
  let mut bytes: [i32] = []
  bytes = append_u32_le(bytes, magic_mlsc())
  bytes = append_u32_le(bytes, 1)
  bytes = append_u32_le(bytes, exports.length())
  bytes = append_exports(bytes, exports)
  bytes = append_u32_le(bytes, protos.length())
  append_protos(bytes, protos)
end

export fn emb_encode_add1_module() -> [i32] = do
  let mut words: [i32] = []
  words = append_words(words, instruction_words_load_const(1, 0))
  words = append_words(words, instruction_words_binary(instruction_opcode_add(), 0, 0, 1))
  words = append_words(words, instruction_words_return(0))
  let mut constants: [Value] = []
  constants.push(value_encode(ValueInt32(1)))
  let mut exports: [ModuleExport] = []
  exports.push(ModuleExport { name: "add1", proto_index: 0 })
  let mut protos: [FunctionProto] = []
  protos.push(FunctionProto { words: words, constants: constants, register_count: 2 })
  module_encode(exports, protos)
end

fn maximum_register_count() -> i32 = 256

fn export_proto_in_range(exports: [ModuleExport], proto_count: i32) -> bool = do
  let mut index = 0
  let mut accepted = true
  while index < exports.length() && accepted do
    const proto_index = exports[index].proto_index
    accepted = proto_index >= 0 && proto_index < proto_count
    index = index + 1
  end
  accepted
end

fn export_names_unique(exports: [ModuleExport]) -> bool = do
  let mut index = 0
  let mut unique = true
  while index < exports.length() && unique do
    let mut earlier = 0
    while earlier < index && unique do
      if exports[earlier].name == exports[index].name then
        unique = false
      end
      earlier = earlier + 1
    end
    index = index + 1
  end
  unique
end

fn register_count_in_range(register_count: i32) -> bool =
  register_count >= 0 && register_count <= maximum_register_count()

fn proto_registers_in_range(protos: [FunctionProto]) -> bool = do
  let mut index = 0
  let mut accepted = true
  while index < protos.length() && accepted do
    accepted = register_count_in_range(protos[index].register_count)
    index = index + 1
  end
  accepted
end

fn limit_code(exports: [ModuleExport], protos: [FunctionProto]) -> i32 =
  if !export_proto_in_range(exports, protos.length()) then
    emb_format()
  else if !export_names_unique(exports) then
    emb_format()
  else if !proto_registers_in_range(protos) then
    emb_format()
  else
    emb_ok()
  end

fn constant_is_canonical_scalar(raw: i64) -> bool =
  match value_decode(Value { raw: raw }) {
    ValueHeapRef(_) => false,
    _ => true
  }

fn accept_decoded(exports: [ModuleExport], protos: [FunctionProto], empty: DecodedModule) -> DecodeResult = do
  const code = limit_code(exports, protos)
  if code != emb_ok() then
    DecodeResult { code: code, decoded_module: empty }
  else
    DecodeResult { code: code, decoded_module: DecodedModule { exports: exports, protos: protos } }
  end
end

export fn decode_module_with_limits(bytes: [i32], limits: ModuleLimits) -> DecodeResult = do
  let mut empty_exports: [ModuleExport] = []
  let mut empty_protos: [FunctionProto] = []
  const empty = DecodedModule { exports: empty_exports, protos: empty_protos }
  if module_blob_exceeds_limit(bytes.length(), limits) then
    DecodeResult { code: emb_format(), decoded_module: empty }
  else if bytes.length() < 8 then
    DecodeResult { code: emb_format(), decoded_module: empty }
  else if read_u32_le(bytes, 0) != magic_mlsc() then
    DecodeResult { code: emb_unsupported(), decoded_module: empty }
  else if read_u32_le(bytes, 4) != 1 then
    DecodeResult { code: emb_format(), decoded_module: empty }
  else
    let mut offset = 8
    if offset + 4 > bytes.length() then
      DecodeResult { code: emb_format(), decoded_module: empty }
    else
      const export_count = read_u32_le(bytes, offset)
      offset = offset + 4
      let mut exports: [ModuleExport] = []
      let mut export_index = 0
      let mut decode_failed = false
      let mut fail_code = emb_ok()
      if export_count < 0 then
        decode_failed = true
        fail_code = emb_format()
      end
      while export_index < export_count && !decode_failed do
        if offset + 4 > bytes.length() then
          decode_failed = true
          fail_code = emb_format()
        else
          const name_length = read_u32_le(bytes, offset)
          offset = offset + 4
          if !cursor_count_fits(offset, name_length, 1, 4, bytes.length()) then
            decode_failed = true
            fail_code = emb_format()
          else if name_length > limits.maximum_name_bytes then
            decode_failed = true
            fail_code = emb_format()
          else
            const name = name_from_bytes(bytes, offset, name_length)
            offset = offset + name_length
            const proto_index = read_u32_le(bytes, offset)
            offset = offset + 4
            exports.push(ModuleExport { name: name, proto_index: proto_index })
            export_index = export_index + 1
          end
        end
      end
      if decode_failed then
        DecodeResult { code: fail_code, decoded_module: empty }
      else if offset + 4 > bytes.length() then
        DecodeResult { code: emb_format(), decoded_module: empty }
      else
        const proto_count = read_u32_le(bytes, offset)
        offset = offset + 4
        if proto_count < 0 then
          decode_failed = true
          fail_code = emb_format()
        end
        let mut protos: [FunctionProto] = []
        let mut proto_index = 0
        while proto_index < proto_count && !decode_failed do
          if offset + 8 > bytes.length() then
            decode_failed = true
            fail_code = emb_format()
          else
            const register_count = read_u32_le(bytes, offset)
            offset = offset + 4
            const word_count = read_u32_le(bytes, offset)
            offset = offset + 4
            if !cursor_count_fits(offset, word_count, 4, 4, bytes.length()) then
              decode_failed = true
              fail_code = emb_format()
            else
              let mut words: [i32] = []
              let mut word_index = 0
              while word_index < word_count do
                words.push(read_u32_le(bytes, offset))
                offset = offset + 4
                word_index = word_index + 1
              end
              const constant_count = read_u32_le(bytes, offset)
              offset = offset + 4
              if !cursor_count_fits(offset, constant_count, 8, 0, bytes.length()) then
                decode_failed = true
                fail_code = emb_format()
              else
                let mut constants: [Value] = []
                let mut constant_index = 0
                while constant_index < constant_count && !decode_failed do
                  const raw = read_i64_le(bytes, offset)
                  offset = offset + 8
                  if constant_is_canonical_scalar(raw) then
                    constants.push(Value { raw: raw })
                    constant_index = constant_index + 1
                  else
                    decode_failed = true
                    fail_code = emb_format()
                  end
                end
                if !decode_failed then
                  protos.push(FunctionProto {
                    words: words,
                    constants: constants,
                    register_count: register_count
                  })
                  proto_index = proto_index + 1
                end
              end
            end
          end
        end
        if decode_failed then
          DecodeResult { code: fail_code, decoded_module: empty }
        else if offset != bytes.length() then
          DecodeResult { code: emb_format(), decoded_module: empty }
        else
          accept_decoded(exports, protos, empty)
        end
      end
    end
  end
end

export fn decode_module(bytes: [i32]) -> DecodeResult =
  decode_module_with_limits(bytes, default_module_limits())
