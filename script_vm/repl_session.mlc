import {
  ReplAnswer,
  ReplIncomplete,
  ReplAccepted,
  ReplValueInt32,
  ReplValueString,
  ReplDiagnostic
} from './repl_answer'
import { repl_balance_incomplete } from './repl_balance'
import { lower_source } from './lower/lower_module'
import { emb_call_export_bytes, emb_ok } from './embedding'
import { Value, ValueInt32, value_decode } from './value'

export type ReplSession = {
  accepted_source: string,
  pending: string
}

fn character_is_blank(character: string) -> bool =
  character == " " || character == "\n" || character == "\t" || character == "\r"

fn chunk_is_blank(chunk: string) -> bool = do
  let mut index = 0
  let mut blank = true
  while index < chunk.length() && blank do
    if !character_is_blank(chunk.substring(index, 1)) then
      blank = false
    end
    index = index + 1
  end
  blank
end

fn first_word(text: string) -> string = do
  let mut index = 0
  while index < text.length() && character_is_blank(text.substring(index, 1)) do
    index = index + 1
  end
  let mut end_index = index
  while end_index < text.length() && !character_is_blank(text.substring(end_index, 1)) do
    end_index = end_index + 1
  end
  text.substring(index, end_index - index)
end

fn text_is_declaration(text: string) -> bool = do
  let word = first_word(text)
  word == "fn" || word == "export" || word == "type"
end

fn joined_source(existing: string, addition: string) -> string =
  if existing.length() == 0 then
    addition
  else
    existing + "\n" + addition
  end

fn empty_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn integer_answer(raw: i64) -> ReplAnswer =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => ReplValueInt32(number),
    _ => ReplDiagnostic("repl_result_not_integer", 1, 1)
  }

fn expression_program(accepted_source: string, expression: string) -> string =
  joined_source(accepted_source, "export fn repl_entry() -> i32 = do " + expression + " end")

fn evaluate_expression(session: ref mut ReplSession, text: string) -> ReplAnswer = do
  let lowered = lower_source(expression_program(session.accepted_source, text))
  if lowered.diagnostics.length() != 0 then
    session.pending = ""
    let diagnostic = lowered.diagnostics[0]
    ReplDiagnostic(diagnostic.code, diagnostic.line, diagnostic.column)
  else
    let called = emb_call_export_bytes(lowered.bytes, "repl_entry", empty_arguments())
    session.pending = ""
    if called.code == emb_ok() then
      integer_answer(called.raw)
    else
      ReplDiagnostic("repl_result_not_integer", 1, 1)
    end
  end
end

fn accept_declaration(session: ref mut ReplSession, text: string) -> ReplAnswer = do
  let candidate = joined_source(session.accepted_source, text)
  let lowered = lower_source(candidate)
  if lowered.diagnostics.length() == 0 then
    session.accepted_source = candidate
    session.pending = ""
    ReplAccepted
  else
    session.pending = ""
    let diagnostic = lowered.diagnostics[0]
    ReplDiagnostic(diagnostic.code, diagnostic.line, diagnostic.column)
  end
end

fn append_pending(pending: string, chunk: string) -> string =
  if pending.length() == 0 then
    chunk
  else
    pending + "\n" + chunk
  end

export fn repl_session_new() -> ReplSession =
  ReplSession { accepted_source: "", pending: "" }

export fn repl_session_submit(session: ref mut ReplSession, chunk: string) -> ReplAnswer = do
  let combined = append_pending(session.pending, chunk)
  if chunk_is_blank(chunk) || repl_balance_incomplete(combined) then
    session.pending = combined
    ReplIncomplete
  else if text_is_declaration(combined) then
    accept_declaration(session, combined)
  else
    evaluate_expression(session, combined)
  end
end
