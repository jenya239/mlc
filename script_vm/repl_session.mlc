import {
  ReplAnswer,
  ReplIncomplete,
  ReplAccepted,
  ReplValueInt32,
  ReplValueString,
  ReplDiagnostic
} from './repl_answer'
import { repl_balance_incomplete } from './repl_balance'
import { emb_ok } from './embedding_codes'
import {
  BindingSplit,
  ReplBinding,
  binding_raws,
  empty_repl_bindings,
  mentioned_bindings,
  parameter_text,
  raw_is_heap_ref,
  remember_binding,
  split_mutable_array_let
} from './repl_bindings'
import { heap_root_push } from './heap_collect'
import { Heap, heap_type_array } from './heap_types'
import { instance_call_export, instance_load_module, script_instance_new, ScriptInstance } from './instance'
import { lower_source } from './lower/lower_module'
import { Value, ValueHeapRef, ValueInt32, value_decode, value_encode } from './value'

// accepted_source is declaration text. Heap and rooted values live on ScriptInstance.
// Those bindings are not actor durable state (§15.2).

export type ReplSession = {
  accepted_source: string,
  pending: string,
  instance: ScriptInstance,
  bindings: [ReplBinding]
}

type EntryRaw = {
  code: i32,
  raw: i64,
  lower_failed: bool,
  diagnostic_code: string,
  line: i32,
  column: i32
}

fn character_is_blank(character: string) -> bool =
  character == " " || character == "\n" || character == "\t" || character == "\r"

fn chunk_is_blank(chunk: string) -> bool = do
  let mut index = 0
  let mut blank = true
  while index < chunk.length() && blank do
    if !character_is_blank(chunk.substring(index, 1)) then
      blank = false
    end
    index = index + 1
  end
  blank
end

fn first_word(text: string) -> string = do
  let mut index = 0
  while index < text.length() && character_is_blank(text.substring(index, 1)) do
    index = index + 1
  end
  let mut end_index = index
  while end_index < text.length() && !character_is_blank(text.substring(end_index, 1)) do
    end_index = end_index + 1
  end
  text.substring(index, end_index - index)
end

fn text_is_declaration(text: string) -> bool = do
  let word = first_word(text)
  word == "fn" || word == "export" || word == "type"
end

fn joined_source(existing: string, addition: string) -> string =
  if existing.length() == 0 then
    addition
  else
    existing + "\n" + addition
  end

fn empty_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn integer_answer(raw: i64) -> ReplAnswer =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => ReplValueInt32(number),
    _ => ReplDiagnostic("repl_result_not_integer", 1, 1)
  }

fn skip_blanks(text: string, start: i32) -> i32 = do
  let mut index = start
  while index < text.length() && character_is_blank(text.substring(index, 1)) do
    index = index + 1
  end
  index
end

fn last_nonblank(text: string) -> i32 = do
  let mut end_index = text.length()
  while end_index > 0 && character_is_blank(text.substring(end_index - 1, 1)) do
    end_index = end_index - 1
  end
  end_index
end

fn measure_quoted_body(text: string, cursor_start: i32, end_index: i32, quote: string) -> i32 = do
  let mut cursor = cursor_start
  let mut length = 0
  let mut closed = false
  while cursor < end_index && !closed do
    let character = text.substring(cursor, 1)
    if character == "\\" && cursor + 1 < end_index then
      length = length + 1
      cursor = cursor + 2
    else if character == quote then
      closed = true
      cursor = cursor + 1
    else
      length = length + 1
      cursor = cursor + 1
    end
  end
  if closed && cursor == end_index then
    length
  else
    0 - 1
  end
end

fn quote_at(text: string, start: i32, end_index: i32) -> string =
  if start >= end_index then
    ""
  else
    text.substring(start, 1)
  end

fn quoted_literal_length(text: string) -> i32 = do
  let start = skip_blanks(text, 0)
  let end_index = last_nonblank(text)
  let quote = quote_at(text, start, end_index)
  if quote != "'" && quote != "\"" then
    0 - 1
  else
    measure_quoted_body(text, start + 1, end_index, quote)
  end
end

fn finish_string_literal(session: ref mut ReplSession, literal_length: i32) -> ReplAnswer = do
  session.pending = ""
  ReplValueString(literal_length)
end

fn expression_program(accepted_source: string, expression: string) -> string =
  joined_source(accepted_source, "export fn repl_entry() -> i32 = do " + expression + " end")

fn entry_failed(code: string, line: i32, column: i32) -> EntryRaw =
  EntryRaw { code: 0, raw: 0, lower_failed: true, diagnostic_code: code, line: line, column: column }

fn entry_ran(code: i32, raw: i64) -> EntryRaw =
  EntryRaw { code: code, raw: raw, lower_failed: false, diagnostic_code: "", line: 0, column: 0 }

fn expression_source(session: ref mut ReplSession, text: string) -> string = do
  let mentioned = mentioned_bindings(session.bindings, text)
  if mentioned.length() == 0 then
    expression_program(session.accepted_source, text)
  else
    joined_source(
      session.accepted_source,
      "export fn repl_entry(" + parameter_text(mentioned) + ") -> i32 = do " + text + " end"
    )
  end
end

fn run_entry_raw(session: ref mut ReplSession, source: string, argument_raws: [i64]) -> EntryRaw = do
  let lowered = lower_source(source)
  if lowered.diagnostics.length() != 0 then
    let diagnostic = lowered.diagnostics[0]
    session.pending = ""
    entry_failed(diagnostic.code, diagnostic.line, diagnostic.column)
  else
    let loaded = instance_load_module(session.instance, lowered.bytes)
    session.instance = loaded.instance
    session.pending = ""
    if loaded.code != emb_ok() then
      entry_ran(loaded.code, 0)
    else
      let module_index = loaded.instance.loaded_modules.length() - 1
      let called = instance_call_export(loaded.instance, module_index, "repl_entry", argument_raws)
      session.instance = called.instance
      entry_ran(called.code, called.raw)
    end
  end
end

fn evaluate_lowered_expression(session: ref mut ReplSession, text: string) -> ReplAnswer = do
  let mentioned = mentioned_bindings(session.bindings, text)
  let ran = run_entry_raw(session, expression_source(session, text), binding_raws(mentioned))
  if ran.lower_failed then
    ReplDiagnostic(ran.diagnostic_code, ran.line, ran.column)
  else if ran.code != emb_ok() then
    ReplDiagnostic("repl_result_not_integer", 1, 1)
  else
    integer_answer(ran.raw)
  end
end

fn newest_array_raw(heap: Heap, slots_before: i32) -> i64 = do
  let mut index = heap.slots.length() - 1
  let mut found = 0 - 1
  while index >= slots_before && found < 0 do
    if heap.slots[index].live && heap.slots[index].header.type_id == heap_type_array() then
      found = index
    end
    index = index - 1
  end
  if found < 0 then
    0
  else
    value_encode(ValueHeapRef(found)).raw
  end
end

fn root_instance_raw(instance: ScriptInstance, raw: i64) -> ScriptInstance = do
  let value = Value { raw: raw }
  let mut rooted_values = instance.rooted_values
  rooted_values.push(value)
  ScriptInstance {
    identity: instance.identity,
    incarnation: instance.incarnation,
    loaded_modules: instance.loaded_modules,
    heap: heap_root_push(instance.heap, value),
    rooted_values: rooted_values
  }
end

fn bind_mutable_array(session: ref mut ReplSession, text: string, split: BindingSplit) -> ReplAnswer = do
  let slots_before = session.instance.heap.slots.length()
  let answer = evaluate_lowered_expression(session, text)
  let array_raw = newest_array_raw(session.instance.heap, slots_before)
  if !raw_is_heap_ref(array_raw) then
    answer
  else
    session.instance = root_instance_raw(session.instance, array_raw)
    session.bindings = remember_binding(session.bindings, split.name, array_raw)
    answer
  end
end

fn evaluate_expression(session: ref mut ReplSession, text: string) -> ReplAnswer = do
  let literal_length = quoted_literal_length(text)
  let split = split_mutable_array_let(text)
  if literal_length >= 0 then
    finish_string_literal(session, literal_length)
  else if split.matched then
    bind_mutable_array(session, text, split)
  else
    evaluate_lowered_expression(session, text)
  end
end

fn accept_declaration(session: ref mut ReplSession, text: string) -> ReplAnswer = do
  let candidate = joined_source(session.accepted_source, text)
  let lowered = lower_source(candidate)
  if lowered.diagnostics.length() == 0 then
    session.accepted_source = candidate
    session.pending = ""
    ReplAccepted
  else
    session.pending = ""
    let diagnostic = lowered.diagnostics[0]
    ReplDiagnostic(diagnostic.code, diagnostic.line, diagnostic.column)
  end
end

fn append_pending(pending: string, chunk: string) -> string =
  if pending.length() == 0 then
    chunk
  else
    pending + "\n" + chunk
  end

export fn repl_session_new() -> ReplSession =
  ReplSession {
    accepted_source: "",
    pending: "",
    instance: script_instance_new(),
    bindings: empty_repl_bindings()
  }

export fn repl_session_submit(session: ref mut ReplSession, chunk: string) -> ReplAnswer = do
  let combined = append_pending(session.pending, chunk)
  if chunk_is_blank(chunk) || repl_balance_incomplete(combined) then
    session.pending = combined
    ReplIncomplete
  else if text_is_declaration(combined) then
    accept_declaration(session, combined)
  else
    evaluate_expression(session, combined)
  end
end
