import { Value, ValueNil, value_encode } from './value'
import {
  Instruction,
  DecodedAbc,
  instruction_decode,
  instruction_word_span,
  instruction_load_const_index,
  instruction_jump_offset,
  instruction_opcode_load_const,
  instruction_opcode_move,
  instruction_opcode_add,
  instruction_opcode_sub,
  instruction_opcode_mul,
  instruction_opcode_div,
  instruction_opcode_return,
  instruction_opcode_jump,
  instruction_opcode_jump_if_false,
  instruction_opcode_eq,
  instruction_opcode_ne,
  instruction_opcode_lt,
  instruction_opcode_le,
  instruction_opcode_gt,
  instruction_opcode_ge,
  instruction_opcode_call,
  instruction_opcode_make_closure,
  instruction_opcode_get_upval,
  instruction_opcode_set_upval,
  instruction_opcode_new_array,
  instruction_opcode_get_index,
  instruction_opcode_set_index,
  instruction_opcode_new_record,
  instruction_opcode_get_prop,
  instruction_opcode_set_prop
} from './bytecode'
import { VerifyOk, VerifyErr, verify_function } from './verifier'
import { Heap } from './heap'
import {
  FunctionProto,
  RunHeapResult,
  RunOk,
  RunErr,
  run_err_verify,
  run_err_type,
  run_err_no_return,
  run_err_unsupported_opcode
} from './run_result'
import {
  VmState,
  vm_state_new,
  vm_state_push_frame,
  vm_state_pop_frame,
  vm_state_frame_depth,
  vm_state_register,
  vm_state_set_register,
  vm_state_program_counter,
  vm_state_set_program_counter,
  vm_state_frame_proto,
  vm_state_frame_return_register
} from './vm_state'
import { apply_binary, apply_compare, value_is_falsy } from './arith'
import {
  executor_step_continue,
  executor_step_returned,
  executor_fail
} from './executor_step'
import {
  executor_exec_call,
  executor_exec_make_closure,
  executor_exec_get_upval,
  executor_exec_set_upval
} from './executor_calls'
import {
  executor_exec_new_array,
  executor_exec_get_index,
  executor_exec_set_index,
  executor_exec_new_record,
  executor_exec_get_prop,
  executor_exec_set_prop
} from './executor_heap'

type VerifyScan = { failed: bool, at: i32 }

fn nil_value() -> Value = value_encode(ValueNil)

fn verify_protos(protos: [FunctionProto]) -> VerifyScan = do
  let mut proto_index = 0
  let mut failed = false
  let mut at = 0
  while proto_index < protos.length() && !failed do
    let proto = protos[proto_index]
    let verified = verify_function(proto.words, proto.register_count, proto.constants.length())
    match verified {
      VerifyErr(_code, word_index) => do
        failed = true
        at = word_index
      end,
      VerifyOk => do end
    }
    proto_index = proto_index + 1
  end
  VerifyScan { failed: failed, at: at }
end

fn place_arguments(state: ref mut VmState, register_count: i32, args: [Value]) -> unit = do
  let mut arg_index = 0
  while arg_index < args.length() && arg_index < register_count do
    vm_state_set_register(state, arg_index, args[arg_index])
    arg_index = arg_index + 1
  end
end

fn copy_frame_registers(state: ref mut VmState, register_count: i32) -> [Value] = do
  let mut registers: [Value] = []
  let mut index = 0
  while index < register_count do
    registers.push(vm_state_register(state, index))
    index = index + 1
  end
  registers
end

fn write_frame_registers(state: ref mut VmState, registers: [Value]) -> unit = do
  let mut index = 0
  while index < registers.length() do
    vm_state_set_register(state, index, registers[index])
    index = index + 1
  end
end

fn frame_step_leave() -> i32 = 3

fn dispatch_instruction(
  heap: ref mut Heap,
  state: ref mut VmState,
  protos: [FunctionProto],
  proto: FunctionProto,
  words: [i32],
  program_counter: i32
) -> i32 = do
  let primary = program_counter
  let decoded = instruction_decode(Instruction { word: words[primary] })
  let span = instruction_word_span(words, primary)
  if decoded.opcode == instruction_opcode_new_array() then
    executor_exec_new_array(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_get_index() then
    executor_exec_get_index(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_set_index() then
    executor_exec_set_index(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_new_record() then
    executor_exec_new_record(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_get_prop() then
    executor_exec_get_prop(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_set_prop() then
    executor_exec_set_prop(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_call() then
    executor_exec_call(heap, state, protos, proto, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_make_closure() then
    executor_exec_make_closure(heap, state, protos, proto, decoded, words, primary, span)
  else if decoded.opcode == instruction_opcode_get_upval() then
    executor_exec_get_upval(heap, state, decoded, primary, span)
  else if decoded.opcode == instruction_opcode_set_upval() then
    executor_exec_set_upval(heap, state, decoded, primary, span)
  else
    executor_fail(state, run_err_unsupported_opcode(), primary)
  end
end

fn execute_current_frame(heap: ref mut Heap, state: ref mut VmState, protos: [FunctionProto]) -> i32 = do
  let proto = protos[vm_state_frame_proto(state)]
  let words = proto.words
  let frame_depth = vm_state_frame_depth(state)
  let continue_step = executor_step_continue()
  let mut registers = copy_frame_registers(state, proto.register_count)
  let mut program_counter = vm_state_program_counter(state)
  let mut step = continue_step
  while step == continue_step && state.error_code == "" do
    if program_counter >= words.length() then
      step = executor_fail(state, run_err_no_return(), words.length())
    else
      let primary = program_counter
      let decoded = instruction_decode(Instruction { word: words[primary] })
      let span = instruction_word_span(words, primary)
      if decoded.opcode == instruction_opcode_add() || decoded.opcode == instruction_opcode_sub() || decoded.opcode == instruction_opcode_mul() || decoded.opcode == instruction_opcode_div() then
        let outcome = apply_binary(decoded.opcode, registers[decoded.b], registers[decoded.c])
        if outcome.err_code != "" then
          step = executor_fail(state, outcome.err_code, primary)
        else
          registers.set(decoded.a, outcome.value)
          program_counter = primary + span
        end
      else if decoded.opcode == instruction_opcode_le() || decoded.opcode == instruction_opcode_eq() || decoded.opcode == instruction_opcode_ne() || decoded.opcode == instruction_opcode_lt() || decoded.opcode == instruction_opcode_gt() || decoded.opcode == instruction_opcode_ge() then
        let outcome = apply_compare(decoded.opcode, registers[decoded.b], registers[decoded.c])
        if outcome.err_code != "" then
          step = executor_fail(state, outcome.err_code, primary)
        else
          registers.set(decoded.a, outcome.value)
          program_counter = primary + span
        end
      else if decoded.opcode == instruction_opcode_jump_if_false() then
        if value_is_falsy(registers[decoded.a]) then
          program_counter = primary + span + instruction_jump_offset(words, primary)
        else
          program_counter = primary + span
        end
      else if decoded.opcode == instruction_opcode_jump() then
        program_counter = primary + span + instruction_jump_offset(words, primary)
      else if decoded.opcode == instruction_opcode_load_const() then
        registers.set(decoded.a, proto.constants[instruction_load_const_index(words, primary)])
        program_counter = primary + span
      else if decoded.opcode == instruction_opcode_move() then
        registers.set(decoded.a, registers[decoded.b])
        program_counter = primary + span
      else if decoded.opcode == instruction_opcode_return() then
        let value = registers[decoded.a]
        if vm_state_frame_depth(state) == 1 then
          state.return_value = value
          step = executor_step_returned()
        else
          let return_register = vm_state_frame_return_register(state)
          vm_state_pop_frame(state)
          vm_state_set_register(state, return_register, value)
          step = frame_step_leave()
        end
      else
        write_frame_registers(state, registers)
        vm_state_set_program_counter(state, primary)
        let outcome = dispatch_instruction(heap, state, protos, proto, words, primary)
        if outcome != continue_step || state.error_code != "" then
          step = outcome
        else if vm_state_frame_depth(state) != frame_depth then
          step = frame_step_leave()
        else
          registers = copy_frame_registers(state, proto.register_count)
          program_counter = vm_state_program_counter(state)
        end
      end
    end
  end
  if step == frame_step_leave() then
    continue_step
  else
    step
  end
end

fn execute_state(heap: ref mut Heap, protos: [FunctionProto], entry_proto_index: i32, args: [Value]) -> RunHeapResult = do
  let mut state = vm_state_new()
  let entry = protos[entry_proto_index]
  vm_state_push_frame(state, entry_proto_index, entry.register_count, nil_value(), 0)
  place_arguments(state, entry.register_count, args)
  let mut finished = false
  while vm_state_frame_depth(state) > 0 && state.error_code == "" && !finished do
    let outcome = execute_current_frame(heap, state, protos)
    if outcome == executor_step_returned() then
      finished = true
    end
  end
  if state.error_code != "" then
    RunHeapResult { heap: heap, result: RunErr(state.error_code, state.error_at) }
  else
    RunHeapResult { heap: heap, result: RunOk(state.return_value) }
  end
end

export fn run_state_program(
  heap: Heap,
  protos: [FunctionProto],
  entry_proto_index: i32,
  args: [Value]
) -> RunHeapResult = do
  let mut heap_state = heap
  let verification = verify_protos(protos)
  if verification.failed then
    RunHeapResult { heap: heap_state, result: RunErr(run_err_verify(), verification.at) }
  else if entry_proto_index < 0 || entry_proto_index >= protos.length() then
    RunHeapResult { heap: heap_state, result: RunErr(run_err_type(), 0) }
  else
    execute_state(heap_state, protos, entry_proto_index, args)
  end
end

export fn run_state_single_function(
  heap: Heap,
  words: [i32],
  constants: [Value],
  register_count: i32
) -> RunHeapResult = do
  let mut protos: [FunctionProto] = []
  protos.push(FunctionProto { words: words, constants: constants, register_count: register_count })
  let mut args: [Value] = []
  run_state_program(heap, protos, 0, args)
end
