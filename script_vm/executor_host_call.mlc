import { DecodedAbc } from './bytecode'
import { Execution, execution_waiting } from './execution'
import { executor_fail, executor_step_waiting } from './executor_step'
import { Heap } from './heap'
import { host_import_manifest, host_import_timer_after } from './host_imports'
import { HostRequest, host_request_copy_arguments, host_request_new, host_request_release } from './host_request'
import { host_call_import_index } from './lower/lower_host_call'
import { run_err_unsupported_opcode } from './run_result'
import { Value } from './value'
import { VmState, vm_state_register, vm_state_set_program_counter } from './vm_state'

export type HostCallWait = {
  execution: Execution,
  request: HostRequest,
  destination_register: i32,
  resume_pc: i32,
  resumed: bool
}

export type HostCallResume = {
  wait: HostCallWait,
  outcome: string,
  continuation_ran: bool
}

export fn executor_host_call_suspend(
  heap: Heap,
  destination_register: i32,
  resume_pc: i32,
  operation_id: string,
  arguments: [Value]
) -> HostCallWait = do
  let owned_arguments = host_request_copy_arguments(arguments)
  let request = host_request_new(operation_id, owned_arguments)
  HostCallWait {
    execution: execution_waiting(heap),
    request: request,
    destination_register: destination_register,
    resume_pc: resume_pc,
    resumed: false
  }
end

fn host_call_wait_with_request(wait: HostCallWait, request: HostRequest, resumed: bool) -> HostCallWait =
  HostCallWait {
    execution: wait.execution,
    request: request,
    destination_register: wait.destination_register,
    resume_pc: wait.resume_pc,
    resumed: resumed
  }

fn epochs_match(request: HostRequest, session_epoch: i32, incarnation: i32, code_epoch: i32) -> bool =
  request.session_epoch == session_epoch
    && request.incarnation == incarnation
    && request.code_epoch == code_epoch

fn host_call_resume_rejected(wait: HostCallWait) -> HostCallResume =
  HostCallResume {
    wait: host_call_wait_with_request(wait, host_request_release(wait.request), true),
    outcome: "rejected",
    continuation_ran: false
  }

export fn executor_host_call_resume(
  wait: HostCallWait,
  session_epoch: i32,
  incarnation: i32,
  code_epoch: i32
) -> HostCallResume = do
  if wait.resumed then
    host_call_resume_rejected(wait)
  else if !epochs_match(wait.request, session_epoch, incarnation, code_epoch) then
    host_call_resume_rejected(wait)
  else
    HostCallResume {
      wait: host_call_wait_with_request(wait, wait.request, true),
      outcome: "accepted",
      continuation_ran: true
    }
  end
end

export fn executor_exec_host_call(
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> i32 = do
  if decoded.c < 0 || decoded.c >= host_import_manifest().length() then
    executor_fail(state, run_err_unsupported_opcode(), primary)
  else
    state.host_waiting = true
    state.host_destination_register = decoded.a
    state.host_import_index = decoded.c
    state.host_argument = vm_state_register(state, decoded.b)
    vm_state_set_program_counter(state, primary + span)
    executor_step_waiting()
  end
end

export fn executor_host_call_timer_after(
  heap: Heap,
  destination_register: i32,
  resume_pc: i32,
  arguments: [Value]
) -> HostCallWait =
  executor_host_call_suspend(
    heap,
    destination_register,
    resume_pc,
    host_import_timer_after().operation_id,
    arguments
  )
