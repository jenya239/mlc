export type ModuleLimits = {
  maximum_blob_bytes: i32,
  maximum_exports: i32,
  maximum_protos: i32,
  maximum_words: i32,
  maximum_constants: i32,
  maximum_name_bytes: i32,
  maximum_verification_work: i32
}

export fn default_module_limits() -> ModuleLimits =
  ModuleLimits {
    maximum_blob_bytes: 1048576,
    maximum_exports: 1024,
    maximum_protos: 1024,
    maximum_words: 65536,
    maximum_constants: 65536,
    maximum_name_bytes: 4096,
    maximum_verification_work: 1048576
  }

export fn module_blob_exceeds_limit(byte_count: i32, limits: ModuleLimits) -> bool =
  byte_count > limits.maximum_blob_bytes

export fn cursor_count_fits(offset: i32, count: i32, width: i32, extra: i32, length: i32) -> bool = do
  if count < 0 || width <= 0 || extra < 0 || offset < 0 || offset > length then
    false
  else
    const remaining = length - offset
    if extra > remaining then
      false
    else
      count <= (remaining - extra) / width
    end
  end
end
