import {
  Decl,
  DeclExported,
  DeclExtend,
  DeclFn,
  Expr,
  ExprIdent,
  ExprInt,
  ExprMethod,
  Param,
  Span,
  TypeExpr
} from '../../compiler/frontend/ast'
import {
  ProtoBuilder,
  proto_builder_load_constant,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import {
  call_argument_register,
  call_parameter_count,
  call_parameter_type_at,
  call_signature_proto_index,
  call_signature_result_type,
  finish_call_instruction,
  lower_type_of,
  prepare_call_block
} from './lower_call'
import { diagnostic_at, move_to_target, types_agree } from './lower_control'
import { LowerScope, lower_scope_define, lower_scope_fail, lower_scope_lookup } from './lower_scope'
import { LowerCallSignature, LowerInt, LowerRecord, LowerType } from './lower_types'
import { ValueInt32, value_encode } from '../value'
// Invariants:
// - a method is a top-level function whose first parameter is self
// - the call passes the receiver as the first CALL argument
// - explicit arguments follow self in the CALL window, in source order
// - a method binding exists only after the record layout pass
// - self is a ref mut receiver: field stores use the mutable binding path, replacing the binding is rejected
// - a method missing on the receiver record is unknown_method at the call span
export type MethodAttempt =
  | MethodHandled(LowerType)
  | MethodIgnored
fn empty_declarations() -> [Shared<Decl>] = do
  let mut declarations: [Shared<Decl>] = []
  declarations
end
fn empty_signatures() -> [LowerCallSignature] = do
  let mut signatures: [LowerCallSignature] = []
  signatures
end
fn parameter_types(parameters: [Shared<Param>]) -> [LowerType] = do
  let mut collected: [LowerType] = []
  let mut index = 0
  while index < parameters.length() do
    collected.push(lower_type_of(parameters[index].type_value))
    index = index + 1
  end
  collected
end
fn append_function_signature(signatures: [LowerCallSignature], name: string, parameters: [Shared<Param>], result_type: Shared<TypeExpr>) -> [LowerCallSignature] = do
  let mut copied = signatures
  copied.push(LowerCallSignature {
    name: name,
    proto_index: signatures.length(),
    parameter_types: parameter_types(parameters),
    result_type: lower_type_of(result_type)
  })
  copied
end
fn append_method_signatures(signatures: [LowerCallSignature], methods: [Shared<Decl>]) -> [LowerCallSignature] = do
  let mut collected = signatures
  let mut index = 0
  while index < methods.length() do
    collected = append_one_signature(collected, methods[index])
    index = index + 1
  end
  collected
end
fn append_one_signature(signatures: [LowerCallSignature], declaration: Shared<Decl>) -> [LowerCallSignature] =
  match declaration {
    DeclExported(inner) => append_one_signature(signatures, inner),
    DeclFn(name, _, _, parameters, result_type, _, _) =>
      append_function_signature(signatures, name, parameters, result_type),
    DeclExtend(_, _, methods, _) => append_method_signatures(signatures, methods),
    _ => signatures
  }
export fn collect_program_signatures(declarations: [Shared<Decl>]) -> [LowerCallSignature] = do
  let mut signatures = empty_signatures()
  let mut index = 0
  while index < declarations.length() do
    signatures = append_one_signature(signatures, declarations[index])
    index = index + 1
  end
  signatures
end
fn receiver_parameter(parameter: Shared<Param>) -> Shared<Param> =
  if parameter.name == "self" then
    Shared.new(Param {
      name: parameter.name,
      is_mut: true,
      type_value: parameter.type_value,
      has_default: parameter.has_default,
      default: parameter.default,
      param_pattern: parameter.param_pattern
    })
  else
    parameter
  end
fn receiver_parameters(parameters: [Shared<Param>]) -> [Shared<Param>] = do
  let mut copied: [Shared<Param>] = []
  let mut index = 0
  while index < parameters.length() do
    copied.push(receiver_parameter(parameters[index]))
    index = index + 1
  end
  copied
end
fn receiver_method(declaration: Shared<Decl>) -> Shared<Decl> =
  match declaration {
    DeclFn(name, type_parameters, bounds, parameters, result_type, body, where_bounds) =>
      Shared.new(DeclFn(name, type_parameters, bounds, receiver_parameters(parameters), result_type, body, where_bounds)),
    _ => declaration
  }
fn receiver_methods(methods: [Shared<Decl>]) -> [Shared<Decl>] = do
  let mut copied: [Shared<Decl>] = []
  let mut index = 0
  while index < methods.length() do
    copied.push(receiver_method(methods[index]))
    index = index + 1
  end
  copied
end
export fn extend_methods(declaration: Shared<Decl>) -> [Shared<Decl>] =
  match declaration {
    DeclExtend(_, _, methods, _) => receiver_methods(methods),
    _ => empty_declarations()
  }
export fn reference_whole_assignment_rejected(name: string, is_mutable: bool) -> bool =
  if name == "self" then
    true
  else
    !is_mutable
  end
fn call_prefix(type_name: string) -> string = "*call*" + type_name + "_"
fn name_starts_with(name: string, prefix: string) -> bool =
  name.length() >= prefix.length() && name.substring(0, prefix.length()) == prefix
fn contains_hash(text: string) -> bool = do
  let mut index = 0
  let mut found = false
  while index < text.length() && !found do
    if text.substring(index, 1) == "#" then
      found = true
    end
    index = index + 1
  end
  found
end
fn bind_one_method(scope: ref mut LowerScope, type_name: string, binding_name: string, encoded_slot: i32) -> unit = do
  let prefix = call_prefix(type_name)
  if name_starts_with(binding_name, prefix) then
    let suffix = binding_name.substring(prefix.length(), binding_name.length() - prefix.length())
    if suffix.length() > 0 && !contains_hash(suffix) then
      lower_scope_define(scope, "*method*" + type_name + "#" + suffix, scope.names[encoded_slot].register_index, scope.names[encoded_slot].value_type, false)
    end
  end
end
export fn bind_record_methods(scope: ref mut LowerScope, type_name: string) -> unit = do
  let mut index = 0
  let limit = scope.names.length()
  while index < limit do
    bind_one_method(scope, type_name, scope.names[index].name, index)
    index = index + 1
  end
end
fn receiver_register(scope: ref mut LowerScope, receiver_name: string) -> i32 = do
  let slot = lower_scope_lookup(scope, receiver_name)
  if slot < 0 then
    0 - 1
  else
    scope.names[slot].register_index
  end
end
fn local_record_name(scope: ref mut LowerScope, receiver_name: string) -> string = do
  let slot = lower_scope_lookup(scope, receiver_name)
  if slot < 0 then
    ""
  else if scope.names[slot].register_index < 0 then
    ""
  else
    match scope.names[slot].value_type {
      LowerRecord(type_name) => type_name,
      _ => ""
    }
  end
end
fn argument_is_matching_integer(scope: ref mut LowerScope, function_name: string, argument: Shared<Expr>, parameter_index: i32) -> bool =
  match argument {
    ExprInt(_, _) => types_agree(LowerInt, call_parameter_type_at(scope, function_name, parameter_index)),
    _ => false
  }
fn explicit_arguments_fit(scope: ref mut LowerScope, function_name: string, arguments: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut fits = true
  while index < arguments.length() && fits do
    fits = argument_is_matching_integer(scope, function_name, arguments[index], index + 1)
    index = index + 1
  end
  fits
end
fn place_integer_argument(builder: ref mut ProtoBuilder, base: i32, argument_index: i32, number: i32) -> unit =
  proto_builder_load_constant(builder, call_argument_register(base, argument_index + 1), value_encode(ValueInt32(number)))
fn place_explicit_arguments(builder: ref mut ProtoBuilder, base: i32, arguments: [Shared<Expr>]) -> unit = do
  let mut index = 0
  while index < arguments.length() do
    match arguments[index] {
      ExprInt(number, _) => place_integer_argument(builder, base, index, number),
      _ => do end
    }
    index = index + 1
  end
end
fn emit_method_call(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, function_name: string, source_register: i32, arguments: [Shared<Expr>], target: i32) -> LowerType = do
  let parameter_count = arguments.length() + 1
  let mark = proto_builder_register_mark(builder)
  let base = prepare_call_block(builder, call_signature_proto_index(scope, function_name), parameter_count)
  move_to_target(builder, call_argument_register(base, 0), source_register)
  place_explicit_arguments(builder, base, arguments)
  finish_call_instruction(builder, target, base, parameter_count)
  proto_builder_register_release_to(builder, mark)
  call_signature_result_type(scope, function_name)
end
fn reject_unknown_method(scope: ref mut LowerScope, source_span: Span) -> MethodAttempt = do
  lower_scope_fail(scope, diagnostic_at("unknown_method", source_span))
  MethodHandled(LowerInt)
end
fn lower_bound_method(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, receiver_name: string, method_name: string, arguments: [Shared<Expr>], target: i32, source_span: Span) -> MethodAttempt = do
  let type_name = local_record_name(scope, receiver_name)
  let function_name = type_name + "_" + method_name
  if type_name == "" then
    MethodIgnored
  else if lower_scope_lookup(scope, "*method*" + type_name + "#" + method_name) < 0 then
    reject_unknown_method(scope, source_span)
  else if call_parameter_count(scope, function_name) != arguments.length() + 1 then
    MethodIgnored
  else if !explicit_arguments_fit(scope, function_name, arguments) then
    MethodIgnored
  else
    MethodHandled(emit_method_call(scope, builder, function_name, receiver_register(scope, receiver_name), arguments, target))
  end
end
fn lower_method_expression(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, receiver: Shared<Expr>, method_name: string, arguments: [Shared<Expr>], target: i32, source_span: Span) -> MethodAttempt =
  match receiver {
    ExprIdent(receiver_name, _) => lower_bound_method(scope, builder, receiver_name, method_name, arguments, target, source_span),
    _ => MethodIgnored
  }
export fn lower_method_try(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> MethodAttempt =
  match expression {
    ExprMethod(receiver, method_name, arguments, source_span) =>
      lower_method_expression(scope, builder, receiver, method_name, arguments, target, source_span),
    _ => MethodIgnored
  }
