import { tokenize } from '../../compiler/frontend/lexer'
import { parse_program_with_errors } from '../../compiler/frontend/parser/decls'
import {
  Decl,
  DeclFn,
  DeclType,
  DeclTypeAlias,
  DeclTrait,
  DeclExtend,
  DeclImport,
  DeclExternLib,
  DeclExternType,
  DeclExported,
  DeclAssocType,
  DeclAssocBind,
  Expr,
  ExprBlock,
  Param,
  Span,
  TypeExpr,
  TyBool,
  TyI32,
  expr_span
} from '../../compiler/frontend/ast'
import { instruction_words_return } from '../bytecode'
import { FunctionProto } from '../run_result'
import { ModuleExport, module_encode } from '../module_blob'
import {
  ProtoBuilder,
  proto_builder_emit,
  proto_builder_finish,
  proto_builder_new,
  proto_builder_register_allocate
} from './lower_builder'
import {
  collect_call_signatures,
  install_call_signatures,
  lower_type_of
} from './lower_call'
import { diagnostic_at } from './lower_control'
import {
  LowerDiagnosticSink,
  lower_diagnostic_add,
  lower_diagnostic_sink_new,
  lower_diagnostics_merged
} from './lower_diagnostics'
import { lower_expression } from './lower_expression'
import {
  classify_type_declaration,
  collect_record_layouts,
  install_record_layouts
} from './lower_records'
import { FunctionLowered, FunctionLowering, FunctionRejected } from './lower_function'
import { LowerScope, lower_scope_bind, lower_scope_new } from './lower_scope'
import { lower_block } from './lower_statement'
import { LowerCallSignature, LowerDiagnostic, LowerRecordLayout, LowerResult, LowerType } from './lower_types'

type LowerWalk = {
  diagnostics: [LowerDiagnostic],
  protos: [FunctionProto],
  exports: [ModuleExport]
}

fn empty_walk() -> LowerWalk = do
  let mut diagnostics: [LowerDiagnostic] = []
  let mut protos: [FunctionProto] = []
  let mut exports: [ModuleExport] = []
  LowerWalk { diagnostics: diagnostics, protos: protos, exports: exports }
end

fn plain_function_is_exported() -> bool = false

fn syntax_result(messages: [string]) -> LowerResult = do
  let mut diagnostics: [LowerDiagnostic] = []
  let mut index = 0
  while index < messages.length() do
    diagnostics.push(LowerDiagnostic {
      code: "syntax_error",
      message: messages[index],
      line: 0,
      column: 0
    })
    index = index + 1
  end
  let mut bytes: [i32] = []
  LowerResult { diagnostics: diagnostics, bytes: bytes }
end

fn declaration_code(declaration: Shared<Decl>) -> string =
  match declaration {
    DeclFn(_, _, _, _, _, _, _) => "unsupported_function",
    DeclType(_, _, _, _, _) => "unsupported_type",
    DeclTypeAlias(_, _, _, _) => "unsupported_type_alias",
    DeclTrait(_, _, _, _) => "unsupported_trait",
    DeclExtend(_, _, _, _) => "unsupported_extend",
    DeclImport(_, _) => "unsupported_import",
    DeclExternLib(_, _) => "unsupported_extern_lib",
    DeclExternType(_, _, _, _, _, _) => "unsupported_extern_type",
    DeclAssocType(_, _) => "unsupported_assoc_type",
    DeclAssocBind(_, _, _) => "unsupported_assoc_bind",
    DeclExported(inner) => declaration_code(inner)
  }

fn push_diagnostic(walk: LowerWalk, diagnostic: LowerDiagnostic) -> LowerWalk = do
  let mut diagnostics = walk.diagnostics
  diagnostics.push(diagnostic)
  LowerWalk { diagnostics: diagnostics, protos: walk.protos, exports: walk.exports }
end

fn append_proto(walk: LowerWalk, name: string, proto: FunctionProto, exported: bool) -> LowerWalk = do
  let proto_index = walk.protos.length()
  let mut protos = walk.protos
  protos.push(proto)
  if exported then
    let mut exports = walk.exports
    exports.push(ModuleExport { name: name, proto_index: proto_index })
    LowerWalk { diagnostics: walk.diagnostics, protos: protos, exports: exports }
  else
    LowerWalk { diagnostics: walk.diagnostics, protos: protos, exports: walk.exports }
  end
end

fn bind_call_parameters(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  parameters: [Shared<Param>]
) -> unit = do
  let mut index = 0
  while index < parameters.length() do
    let parameter = parameters[index]
    lower_scope_bind(
      scope,
      builder,
      parameter.name,
      lower_type_of(parameter.type_value),
      parameter.is_mut
    )
    index = index + 1
  end
end

fn lower_prepared_body(
  scope: ref mut LowerScope,
  sink: ref mut LowerDiagnosticSink,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  target: i32
) -> LowerType =
  match expression {
    ExprBlock(statements, final_expression, _) =>
      lower_block(scope, sink, builder, statements, final_expression, target),
    _ => lower_expression(scope, sink, builder, expression, target)
  }

fn finish_prepared_return(builder: ref mut ProtoBuilder, source: i32) -> FunctionLowering = do
  let emitted_index = proto_builder_emit(builder, instruction_words_return(source))
  if emitted_index < 0 then
    FunctionLowered(proto_builder_finish(builder))
  else
    FunctionLowered(proto_builder_finish(builder))
  end
end

fn finish_prepared_function(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  destination: i32,
  body_type: LowerType
) -> FunctionLowering =
  if scope.has_diagnostic then
    FunctionRejected(scope.diagnostic)
  else
    match body_type {
      _ => finish_prepared_return(builder, destination)
    }
  end

fn type_is_exportable(type_expression: Shared<TypeExpr>) -> bool =
  match type_expression {
    TyI32 => true,
    TyBool => true,
    _ => false
  }

fn next_exportable_parameter(parameters: [Shared<Param>], index: i32) -> i32 =
  if type_is_exportable(parameters[index].type_value) then
    index + 1
  else
    0 - 1
  end

fn parameters_are_exportable(parameters: [Shared<Param>]) -> bool = do
  let mut index = 0
  while index >= 0 && index < parameters.length() do
    index = next_exportable_parameter(parameters, index)
  end
  index >= 0
end

fn export_signature_allowed(parameters: [Shared<Param>], result_type: Shared<TypeExpr>) -> bool =
  parameters_are_exportable(parameters) && type_is_exportable(result_type)

fn export_signature_code(exported: bool, parameters: [Shared<Param>], result_type: Shared<TypeExpr>) -> string =
  if exported && !export_signature_allowed(parameters, result_type) then
    "export_signature"
  else
    ""
  end

fn note_generic_function(sink: ref mut LowerDiagnosticSink, type_parameters: [string], body: Shared<Expr>) -> unit =
  if type_parameters.length() > 0 then
    lower_diagnostic_add(sink, "unsupported_generic", "unsupported_generic", expr_span(body))
  end

fn note_export_signature(sink: ref mut LowerDiagnosticSink, signature_code: string, body: Shared<Expr>) -> unit =
  if signature_code != "" then
    lower_diagnostic_add(sink, signature_code, signature_code, expr_span(body))
  end

fn note_function_limits(sink: ref mut LowerDiagnosticSink, exported: bool, type_parameters: [string], parameters: [Shared<Param>], result_type: Shared<TypeExpr>, body: Shared<Expr>) -> unit = do
  note_generic_function(sink, type_parameters, body)
  note_export_signature(sink, export_signature_code(exported, parameters, result_type), body)
end

fn lower_function_with_signatures(
  sink: ref mut LowerDiagnosticSink,
  signatures: [LowerCallSignature],
  layouts: [LowerRecordLayout],
  parameters: [Shared<Param>],
  expression: Shared<Expr>
) -> FunctionLowering = do
  let mut builder = proto_builder_new(0)
  let mut scope = lower_scope_new()
  install_call_signatures(scope, signatures)
  install_record_layouts(scope, layouts)
  bind_call_parameters(scope, builder, parameters)
  let destination = proto_builder_register_allocate(builder)
  let body_type = lower_prepared_body(scope, sink, builder, expression, destination)
  finish_prepared_function(scope, builder, destination, body_type)
end

fn consider_function(
  walk: LowerWalk,
  sink: ref mut LowerDiagnosticSink,
  signatures: [LowerCallSignature],
  layouts: [LowerRecordLayout],
  name: string,
  type_parameters: [string],
  parameters: [Shared<Param>],
  result_type: Shared<TypeExpr>,
  body: Shared<Expr>,
  exported: bool
) -> LowerWalk = do
  note_function_limits(sink, exported, type_parameters, parameters, result_type, body)
  match lower_function_with_signatures(sink, signatures, layouts, parameters, body) {
    FunctionLowered(proto) => append_proto(walk, name, proto, exported),
    FunctionRejected(diagnostic) => push_diagnostic(walk, diagnostic)
  }
end

fn consider_unsupported(walk: LowerWalk, declaration: Shared<Decl>) -> LowerWalk =
  push_diagnostic(walk, LowerDiagnostic {
    code: declaration_code(declaration),
    message: declaration_code(declaration),
    line: 0,
    column: 0
  })

fn consider_classified(walk: LowerWalk, code: string, source_span: Span) -> LowerWalk =
  if code == "" then
    walk
  else
    push_diagnostic(walk, diagnostic_at(code, source_span))
  end

fn consider_inner(
  walk: LowerWalk,
  sink: ref mut LowerDiagnosticSink,
  signatures: [LowerCallSignature],
  layouts: [LowerRecordLayout],
  inner: Shared<Decl>,
  exported: bool
) -> LowerWalk =
  match inner {
    DeclFn(name, type_parameters, _, parameters, result_type, body, _) =>
      consider_function(walk, sink, signatures, layouts, name, type_parameters, parameters, result_type, body, exported),
    _ => consider_unsupported(walk, inner)
  }

fn consider_declaration(
  walk: LowerWalk,
  sink: ref mut LowerDiagnosticSink,
  signatures: [LowerCallSignature],
  layouts: [LowerRecordLayout],
  declaration: Shared<Decl>
) -> LowerWalk =
  match declaration {
    DeclExported(inner) => consider_inner(walk, sink, signatures, layouts, inner, true),
    DeclFn(name, type_parameters, _, parameters, result_type, body, _) =>
      consider_function(walk, sink, signatures, layouts, name, type_parameters, parameters, result_type, body, plain_function_is_exported()),
    DeclType(_, _, _, _, source_span) =>
      consider_classified(walk, classify_type_declaration(declaration), source_span),
    DeclTrait(_, _, _, source_span) =>
      consider_classified(walk, "unsupported_trait", source_span),
    _ => consider_unsupported(walk, declaration)
  }

fn empty_bytes() -> [i32] = do
  let mut bytes: [i32] = []
  bytes
end

fn result_bytes(diagnostics: [LowerDiagnostic], walk: LowerWalk) -> [i32] =
  if diagnostics.length() > 0 then
    empty_bytes()
  else
    module_encode(walk.exports, walk.protos)
  end

fn lower_declarations(declarations: [Shared<Decl>]) -> LowerResult = do
  let signatures = collect_call_signatures(declarations)
  let layouts = collect_record_layouts(declarations)
  let mut sink = lower_diagnostic_sink_new()
  let mut walk = empty_walk()
  let mut index = 0
  while index < declarations.length() do
    walk = consider_declaration(walk, sink, signatures, layouts, declarations[index])
    index = index + 1
  end
  let diagnostics = lower_diagnostics_merged(walk.diagnostics, sink)
  LowerResult { diagnostics: diagnostics, bytes: result_bytes(diagnostics, walk) }
end

export fn lower_source(source: string) -> LowerResult = do
  const lexer_output = tokenize(source)
  if lexer_output.errors.length() > 0 then
    return syntax_result(lexer_output.errors)
  end
  const parse_value = parse_program_with_errors(lexer_output.tokens, "lower_source.mlc")
  if parse_value.errors.length() > 0 then
    return syntax_result(parse_value.errors)
  end
  lower_declarations(parse_value.program.decls)
end
