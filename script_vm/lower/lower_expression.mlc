import { Expr, Span, expr_span } from '../../compiler/frontend/ast'
import { Value, ValueBool, ValueInt32, value_encode } from '../value'
import { instruction_words_binary } from '../bytecode'
import {
  ProtoBuilder,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to,
  proto_builder_load_constant,
  proto_builder_emit_jump,
  proto_builder_emit_jump_if_false,
  proto_builder_patch_to_here
} from './lower_builder'
import { LowerType, LowerInt, LowerBool } from './lower_types'
import { LowerScope, lower_scope_fail } from './lower_scope'
import {
  binary_opcode,
  branch_expression,
  comparison_opcode,
  accepted_bool,
  diagnostic_at,
  emit_binary,
  emit_instruction,
  finish_if_type,
  finish_logic_not,
  identifier_operand,
  is_bool_equality_operator,
  is_comparison_operator,
  is_lower_bool,
  is_lower_int,
  move_to_target,
  operand_type,
  subtraction_opcode
} from './lower_control'

fn temporary_operand(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> i32 = do
  let temporary = proto_builder_register_allocate(builder)
  lower_expression(scope, builder, expression, temporary)
  temporary
end

fn use_operand(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> i32 =
  match expression {
    ExprIdent(name, source_span) => identifier_operand(scope, name, source_span),
    _ => temporary_operand(scope, builder, expression)
  }

fn lower_binary(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  operator: string,
  left: Shared<Expr>,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let left_register = use_operand(scope, builder, left)
  let right_register = use_operand(scope, builder, right)
  let left_type = operand_type(scope, left, left_register)
  let right_type = operand_type(scope, right, right_register)
  let opcode = binary_opcode(operator)
  if scope.has_diagnostic then
    do
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  else if !is_lower_int(left_type) || !is_lower_int(right_type) || opcode == 0 then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  else
    do
      emit_binary(builder, opcode, target, left_register, right_register)
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  end
end

fn lower_comparison(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  operator: string,
  left: Shared<Expr>,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let left_register = use_operand(scope, builder, left)
  let right_register = use_operand(scope, builder, right)
  let left_type = operand_type(scope, left, left_register)
  let right_type = operand_type(scope, right, right_register)
  let opcode = comparison_opcode(operator)
  if scope.has_diagnostic then
    do
      proto_builder_register_release_to(builder, mark)
      LowerBool
    end
  else if is_lower_bool(left_type) && is_lower_bool(right_type) && is_bool_equality_operator(operator) then
    do
      lower_scope_fail(scope, diagnostic_at("bool_equality_unsupported", source_span))
      proto_builder_register_release_to(builder, mark)
      LowerBool
    end
  else if !is_lower_int(left_type) || !is_lower_int(right_type) || opcode == 0 then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      proto_builder_register_release_to(builder, mark)
      LowerBool
    end
  else
    do
      emit_binary(builder, opcode, target, left_register, right_register)
      proto_builder_register_release_to(builder, mark)
      LowerBool
    end
  end
end

fn lower_negate(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  inner: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let zero_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, zero_register, value_encode(ValueInt32(0)))
  let inner_register = use_operand(scope, builder, inner)
  let inner_type = operand_type(scope, inner, inner_register)
  if scope.has_diagnostic then
    do
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  else if !is_lower_int(inner_type) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  else
    do
      emit_instruction(
        builder,
        instruction_words_binary(subtraction_opcode(), target, zero_register, inner_register)
      )
      proto_builder_register_release_to(builder, mark)
      LowerInt
    end
  end
end

fn lower_if_branch(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  target: i32
) -> LowerType = do
  let branch_mark = proto_builder_register_mark(builder)
  let branch_type = lower_expression(scope, builder, branch_expression(expression), target)
  proto_builder_register_release_to(builder, branch_mark)
  branch_type
end

fn lower_if_branches(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition_register: i32,
  then_expression: Shared<Expr>,
  else_expression: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let else_site = proto_builder_emit_jump_if_false(builder, condition_register)
  let then_type = lower_if_branch(scope, builder, then_expression, target)
  let end_site = proto_builder_emit_jump(builder)
  proto_builder_patch_to_here(builder, else_site)
  let else_type = lower_if_branch(scope, builder, else_expression, target)
  proto_builder_patch_to_here(builder, end_site)
  finish_if_type(scope, then_type, else_type, source_span)
end

fn lower_if(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition: Shared<Expr>,
  then_expression: Shared<Expr>,
  else_expression: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let condition_register = proto_builder_register_allocate(builder)
  let condition_type = lower_expression(scope, builder, condition, condition_register)
  let result_type = if scope.has_diagnostic then
    LowerInt
  else if !is_lower_bool(condition_type) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerInt
    end
  else
    lower_if_branches(
      scope,
      builder,
      condition_register,
      then_expression,
      else_expression,
      source_span,
      target
    )
  end
  proto_builder_register_release_to(builder, mark)
  result_type
end

fn finish_logic_and(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let end_site = proto_builder_emit_jump_if_false(builder, target)
  let right_type = lower_expression(scope, builder, right, target)
  proto_builder_patch_to_here(builder, end_site)
  accepted_bool(scope, right_type, source_span)
end

fn lower_logic_and(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  left: Shared<Expr>,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let left_type = lower_expression(scope, builder, left, target)
  if scope.has_diagnostic then
    LowerBool
  else if !is_lower_bool(left_type) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerBool
    end
  else
    finish_logic_and(scope, builder, right, source_span, target)
  end
end

fn finish_logic_or(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let right_site = proto_builder_emit_jump_if_false(builder, target)
  let end_site = proto_builder_emit_jump(builder)
  proto_builder_patch_to_here(builder, right_site)
  let right_type = lower_expression(scope, builder, right, target)
  proto_builder_patch_to_here(builder, end_site)
  accepted_bool(scope, right_type, source_span)
end

fn lower_logic_or(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  left: Shared<Expr>,
  right: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let left_type = lower_expression(scope, builder, left, target)
  if scope.has_diagnostic then
    LowerBool
  else if !is_lower_bool(left_type) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerBool
    end
  else
    finish_logic_or(scope, builder, right, source_span, target)
  end
end

fn lower_logic_not(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  inner: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let temporary = proto_builder_register_allocate(builder)
  let value_type = lower_expression(scope, builder, inner, temporary)
  let result_type = if scope.has_diagnostic then
    LowerBool
  else if !is_lower_bool(value_type) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerBool
    end
  else
    finish_logic_not(builder, temporary, target)
  end
  proto_builder_register_release_to(builder, mark)
  result_type
end

fn lower_expression_checked(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  target: i32
) -> LowerType =
  match expression {
    ExprInt(number, _) => do
      proto_builder_load_constant(builder, target, value_encode(ValueInt32(number)))
      LowerInt
    end,
    ExprBool(flag, _) => do
      proto_builder_load_constant(builder, target, value_encode(ValueBool(flag)))
      LowerBool
    end,
    ExprIdent(name, source_span) => do
      let source = identifier_operand(scope, name, source_span)
      let value_type = operand_type(scope, expression, source)
      move_to_target(builder, target, source)
      value_type
    end,
    ExprBin(operator, left, right, source_span) =>
      if operator == "&&" then
        lower_logic_and(scope, builder, left, right, source_span, target)
      else if operator == "||" then
        lower_logic_or(scope, builder, left, right, source_span, target)
      else if is_comparison_operator(operator) then
        lower_comparison(scope, builder, operator, left, right, source_span, target)
      else
        lower_binary(scope, builder, operator, left, right, source_span, target)
      end,
    ExprUn(operator, inner, source_span) =>
      if operator == "-" then
        lower_negate(scope, builder, inner, source_span, target)
      else if operator == "!" then
        lower_logic_not(scope, builder, inner, source_span, target)
      else
        do
          lower_scope_fail(scope, diagnostic_at("unsupported_expression", source_span))
          LowerInt
        end
      end,
    ExprIf(condition, then_expression, else_expression, source_span) =>
      lower_if(scope, builder, condition, then_expression, else_expression, source_span, target),
    ExprBlock(_, _, source_span) => do
      lower_scope_fail(scope, diagnostic_at("unsupported_expression_block", source_span))
      LowerInt
    end,
    _ => do
      lower_scope_fail(scope, diagnostic_at("unsupported_expression", expr_span(expression)))
      LowerInt
    end
  }

export fn lower_expression(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  target: i32
) -> LowerType =
  if scope.has_diagnostic then
    LowerInt
  else
    lower_expression_checked(scope, builder, expression, target)
  end
