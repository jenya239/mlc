import { Expr, ExprUnit, Span } from '../../compiler/frontend/ast'
import { instruction_opcode_add, instruction_opcode_lt, instruction_words_binary, instruction_words_get_index, instruction_words_return } from '../bytecode'
import { instruction_opcode_length } from '../bytecode_text'
import { Value, ValueInt32, value_encode } from '../value'
import {
  ProtoBuilder,
  proto_builder_emit,
  proto_builder_emit_jump,
  proto_builder_emit_jump_back,
  proto_builder_load_constant,
  proto_builder_patch_to_here,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import { LowerDiagnosticSink, lower_diagnostic_add } from './lower_diagnostics'
import { LowerName, LowerScope, lower_scope_define, lower_scope_lookup } from './lower_scope'
import { LowerInt, LowerType } from './lower_types'

fn while_frame_name() -> string = "*while_frame*"

fn break_site_name() -> string = "*break_site*"

fn break_site_binding(site: i32) -> LowerName =
  LowerName {
    name: break_site_name(),
    register_index: site,
    value_type: LowerInt,
    is_mutable: false
  }

fn latest_while_marker(scope: ref mut LowerScope) -> i32 = do
  let mut index = scope.names.length() - 1
  let mut found = 0 - 1
  while index >= 0 && found < 0 do
    if scope.names[index].name == while_frame_name() then
      found = index
    end
    index = index - 1
  end
  found
end

fn names_with_break_site(names: [LowerName], insert_at: i32, site: i32) -> [LowerName] = do
  let mut copied: [LowerName] = []
  let mut index = 0
  while index < names.length() do
    if index == insert_at then
      copied.push(break_site_binding(site))
    end
    copied.push(names[index])
    index = index + 1
  end
  if insert_at == names.length() then
    copied.push(break_site_binding(site))
    copied
  else
    copied
  end
end

fn bumped_frame_counts(counts: [i32], threshold: i32) -> [i32] = do
  let mut copied: [i32] = []
  let mut index = 0
  while index < counts.length() do
    let count = counts[index]
    if count >= threshold then
      copied.push(count + 1)
    else
      copied.push(count)
    end
    index = index + 1
  end
  copied
end

fn record_break_site(scope: ref mut LowerScope, site: i32) -> unit = do
  let insert_at = latest_while_marker(scope) + 1
  scope.names = names_with_break_site(scope.names, insert_at, site)
  scope.frame_name_counts = bumped_frame_counts(scope.frame_name_counts, insert_at)
end

fn names_before_marker(names: [LowerName], marker: i32) -> [LowerName] = do
  let mut copied: [LowerName] = []
  let mut index = 0
  while index < marker do
    copied.push(names[index])
    index = index + 1
  end
  copied
end

fn patch_break_sites(builder: ref mut ProtoBuilder, names: [LowerName], marker: i32) -> unit = do
  let mut index = marker + 1
  while index < names.length() do
    if names[index].name == break_site_name() then
      proto_builder_patch_to_here(builder, names[index].register_index)
    end
    index = index + 1
  end
end

export fn begin_while_frame(scope: ref mut LowerScope, loop_head: i32) -> unit =
  lower_scope_define(scope, while_frame_name(), loop_head, LowerInt, false)

export fn finish_while_frame(scope: ref mut LowerScope, builder: ref mut ProtoBuilder) -> unit = do
  let marker = latest_while_marker(scope)
  if marker >= 0 then
    patch_break_sites(builder, scope.names, marker)
    scope.names = names_before_marker(scope.names, marker)
  end
end

export fn lower_continue(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, source_span: Span) -> unit = do
  let marker = latest_while_marker(scope)
  if marker < 0 then
    lower_diagnostic_add(sink, "continue_outside_loop", "continue_outside_loop", source_span)
  else
    proto_builder_emit_jump_back(builder, scope.names[marker].register_index)
  end
end

export fn lower_break(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, source_span: Span) -> unit = do
  let marker = latest_while_marker(scope)
  if marker < 0 then
    lower_diagnostic_add(sink, "break_outside_loop", "break_outside_loop", source_span)
  else
    let site = proto_builder_emit_jump(builder)
    record_break_site(scope, site)
  end
end

export fn keep_unit() -> unit = do
  let mut once = 0
  while once < 0 do
    once = 1
  end
end

export fn assignment_target(builder: ref mut ProtoBuilder, local_register: i32) -> i32 = do
  let mark = proto_builder_register_mark(builder)
  proto_builder_register_release_to(builder, mark)
  local_register
end

export fn expression_is_unit(expression: Shared<Expr>) -> bool =
  match expression {
    ExprUnit(_) => true,
    _ => false
  }

fn return_source_register(temporary: i32) -> i32 = temporary

export fn emit_value_return(builder: ref mut ProtoBuilder, temporary: i32) -> unit = do
  let emitted_index = proto_builder_emit(builder, instruction_words_return(return_source_register(temporary)))
  if emitted_index < 0 then keep_unit() else keep_unit() end
end

export fn accept_discarded_type(value_type: LowerType) -> unit =
  match value_type {
    LowerInt => keep_unit(),
    _ => keep_unit()
  }

fn emit_cursor_words(builder: ref mut ProtoBuilder, words: [i32]) -> unit = do
  let emitted_index = proto_builder_emit(builder, words)
  if emitted_index < 0 then keep_unit() else keep_unit() end
end

export type ForCursor = {
  array_register: i32,
  index_register: i32,
  length_register: i32,
  step_register: i32
}

export fn prepare_for_cursor(builder: ref mut ProtoBuilder, array_register: i32) -> ForCursor = do
  let index_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, index_register, value_encode(ValueInt32(0)))
  let length_register = proto_builder_register_allocate(builder)
  emit_cursor_words(builder, instruction_words_binary(instruction_opcode_length(), length_register, array_register, 0))
  let step_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, step_register, value_encode(ValueInt32(1)))
  ForCursor {
    array_register: array_register,
    index_register: index_register,
    length_register: length_register,
    step_register: step_register
  }
end

export fn advance_for_index(builder: ref mut ProtoBuilder, cursor: ForCursor) -> unit =
  emit_cursor_words(builder, instruction_words_binary(instruction_opcode_add(), cursor.index_register, cursor.index_register, cursor.step_register))

export fn emit_for_condition(builder: ref mut ProtoBuilder, cursor: ForCursor, condition_register: i32) -> unit =
  emit_cursor_words(builder, instruction_words_binary(instruction_opcode_lt(), condition_register, cursor.index_register, cursor.length_register))

fn for_element_type(scope: ref mut LowerScope) -> LowerType = do
  let found = lower_scope_lookup(scope, "*array_element*")
  if found < 0 then
    LowerInt
  else
    scope.names[found].value_type
  end
end

export fn define_for_element(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, cursor: ForCursor, name: string) -> unit = do
  let element_register = proto_builder_register_allocate(builder)
  emit_cursor_words(builder, instruction_words_get_index(element_register, cursor.array_register, cursor.index_register))
  lower_scope_define(scope, name, element_register, for_element_type(scope), true)
end
