import { Expr } from '../../compiler/frontend/ast'
import { Value, ValueFloat64, value_encode } from '../value'
import {
  float_add_opcode,
  float_subtract_opcode,
  float_multiply_opcode,
  float_divide_opcode
} from '../exec_float'
import { LowerType, LowerInt } from './lower_types'
import { ProtoBuilder, proto_builder_load_constant } from './lower_builder'
import { binary_opcode } from './lower_control'

extern fn integer_to_float64(value: i32) -> f64 =
  "mlc::math::i32_to_f64" from "mlc/math/math.hpp" thread_safe

fn digit_number(character: string) -> i32 =
  if character == "0" then 0
  else if character == "1" then 1
  else if character == "2" then 2
  else if character == "3" then 3
  else if character == "4" then 4
  else if character == "5" then 5
  else if character == "6" then 6
  else if character == "7" then 7
  else if character == "8" then 8
  else if character == "9" then 9
  else 0
  end

fn decimal_from_text(text: string) -> f64 = do
  let mut index = 0
  let mut combined = 0
  let mut divisor = 1
  while index < text.length() && text.substring(index, 1) != "." do
    combined = combined * 10 + digit_number(text.substring(index, 1))
    index = index + 1
  end
  if index < text.length() && text.substring(index, 1) == "." then
    index = index + 1
    while index < text.length() do
      combined = combined * 10 + digit_number(text.substring(index, 1))
      divisor = divisor * 10
      index = index + 1
    end
  end
  integer_to_float64(combined) / integer_to_float64(divisor)
end

export fn lower_float_literal(builder: ref mut ProtoBuilder, target: i32, text: string) -> LowerType = do
  proto_builder_load_constant(builder, target, value_encode(ValueFloat64(decimal_from_text(text))))
  LowerInt
end

fn float_operator(operator: string) -> bool =
  if operator == "+" then
    true
  else if operator == "-" then
    true
  else if operator == "*" then
    true
  else if operator == "/" then
    true
  else
    false
  end

fn float_expression(expression: Shared<Expr>) -> bool =
  match expression {
    ExprFloat(_, _) => true,
    ExprBin(operator, left, right, _) =>
      if float_operator(operator) then
        float_expression(left) && float_expression(right)
      else
        false
      end,
    _ => false
  }

fn float_arithmetic_opcode(operator: string) -> i32 =
  if operator == "+" then
    float_add_opcode()
  else if operator == "-" then
    float_subtract_opcode()
  else if operator == "*" then
    float_multiply_opcode()
  else if operator == "/" then
    float_divide_opcode()
  else
    0
  end

export fn binary_opcode_for(operator: string, left: Shared<Expr>, right: Shared<Expr>) -> i32 =
  if float_expression(left) && float_expression(right) then
    float_arithmetic_opcode(operator)
  else
    binary_opcode(operator)
  end
