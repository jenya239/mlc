export type LowerType =
  | LowerInt
  | LowerBool
  | LowerRecord(string)

export type LowerCallSignature = {
  name: string,
  proto_index: i32,
  parameter_types: [LowerType],
  result_type: LowerType
}

export type LowerDiagnostic = {
  code: string,
  message: string,
  line: i32,
  column: i32
}

export type LowerResult = {
  diagnostics: [LowerDiagnostic],
  bytes: [i32]
}
