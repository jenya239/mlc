import { Expr, Span } from '../../compiler/frontend/ast'
import { ValueBool, ValueInt32, value_encode } from '../value'
import {
  instruction_words_binary,
  instruction_words_get_index,
  instruction_words_new_array,
  instruction_words_set_index
} from '../bytecode'
import { instruction_opcode_length } from '../bytecode_text'
import {
  ProtoBuilder,
  proto_builder_load_constant,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import { diagnostic_at, emit_instruction, is_lower_int, move_to_target } from './lower_control'
import { LowerScope, lower_scope_define, lower_scope_fail, lower_scope_lookup } from './lower_scope'
import { LowerType, LowerBool, LowerInt } from './lower_types'
import {
  lower_text_concatenate,
  lower_text_handles_plus,
  lower_text_named
} from './lower_text'
import { lower_float_array_length_or_text, place_other_array_literal } from './lower_array_float'

fn integer_element(expression: Shared<Expr>) -> bool =
  match expression {
    ExprInt(_, _) => true,
    _ => false
  }

fn elements_are_integers(elements: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut accepted = true
  while index < elements.length() && accepted do
    accepted = integer_element(elements[index])
    index = index + 1
  end
  accepted
end

fn bool_element(expression: Shared<Expr>) -> bool =
  match expression {
    ExprBool(_, _) => true,
    _ => false
  }

fn elements_are_bools(elements: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut accepted = elements.length() > 0
  while index < elements.length() && accepted do
    accepted = bool_element(elements[index])
    index = index + 1
  end
  accepted
end

fn scalar_element(expression: Shared<Expr>) -> bool =
  integer_element(expression) || bool_element(expression)

fn elements_are_scalars(elements: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut accepted = true
  while index < elements.length() && accepted do
    accepted = scalar_element(elements[index])
    index = index + 1
  end
  accepted
end

fn mixed_scalar_elements(elements: [Shared<Expr>]) -> bool =
  elements.length() > 0 && elements_are_scalars(elements) && !elements_are_integers(elements) && !elements_are_bools(elements)

fn integer_array_expression(expression: Shared<Expr>) -> bool =
  match expression {
    ExprArray(elements, _) => elements_are_integers(elements),
    _ => false
  }

fn mixed_scalar_array(expression: Shared<Expr>) -> bool =
  match expression {
    ExprArray(elements, _) => mixed_scalar_elements(elements),
    _ => false
  }

fn element_number(expression: Shared<Expr>) -> i32 =
  match expression {
    ExprInt(number, _) => number,
    _ => 0
  }

fn store_one_integer(
  builder: ref mut ProtoBuilder,
  array_register: i32,
  index_register: i32,
  value_register: i32,
  index: i32,
  number: i32
) -> unit = do
  proto_builder_load_constant(builder, index_register, value_encode(ValueInt32(index)))
  proto_builder_load_constant(builder, value_register, value_encode(ValueInt32(number)))
  emit_instruction(builder, instruction_words_set_index(array_register, index_register, value_register))
end

fn store_integer_elements(
  builder: ref mut ProtoBuilder,
  elements: [Shared<Expr>],
  array_register: i32,
  index_register: i32,
  value_register: i32
) -> unit = do
  let mut index = 0
  while index < elements.length() do
    store_one_integer(
      builder,
      array_register,
      index_register,
      value_register,
      index,
      element_number(elements[index])
    )
    index = index + 1
  end
end

fn emit_integer_array(builder: ref mut ProtoBuilder, elements: [Shared<Expr>], array_register: i32) -> unit = do
  let length_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, length_register, value_encode(ValueInt32(elements.length())))
  emit_instruction(builder, instruction_words_new_array(array_register, length_register))
  let index_register = proto_builder_register_allocate(builder)
  let value_register = proto_builder_register_allocate(builder)
  store_integer_elements(builder, elements, array_register, index_register, value_register)
end

fn emit_length_of_elements(builder: ref mut ProtoBuilder, elements: [Shared<Expr>], target: i32) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let array_register = proto_builder_register_allocate(builder)
  emit_integer_array(builder, elements, array_register)
  emit_instruction(
    builder,
    instruction_words_binary(instruction_opcode_length(), target, array_register, 0)
  )
  proto_builder_register_release_to(builder, mark)
  LowerInt
end

fn contains_nested_array(elements: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut found = false
  while index < elements.length() && !found do
    found = match elements[index] {
      ExprArray(_, _) => true,
      _ => false
    }
    index = index + 1
  end
  found
end

fn nested_array_expression(expression: Shared<Expr>) -> bool =
  match expression {
    ExprArray(elements, _) => contains_nested_array(elements),
    _ => false
  }

fn lower_length_of_integer_array(builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> LowerType =
  match expression {
    ExprArray(elements, _) => emit_length_of_elements(builder, elements, target),
    _ => LowerInt
  }

fn lower_length_or_text(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  arguments: [Shared<Expr>],
  source_span: Span,
  target: i32
) -> LowerType =
  if integer_array_expression(arguments[0]) then
    lower_length_of_integer_array(builder, arguments[0], target)
  else if nested_array_expression(arguments[0]) then
    do
      lower_scope_fail(scope, diagnostic_at("unsupported_nested_array", source_span))
      LowerInt
    end
  else if mixed_scalar_array(arguments[0]) then
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerInt
    end
  else
    lower_float_array_length_or_text(scope, builder, arguments, source_span, target)
  end

fn element_flag(expression: Shared<Expr>) -> bool =
  match expression {
    ExprBool(flag, _) => flag,
    _ => false
  }

fn store_one_bool(
  builder: ref mut ProtoBuilder,
  array_register: i32,
  index_register: i32,
  value_register: i32,
  index: i32,
  flag: bool
) -> unit = do
  proto_builder_load_constant(builder, index_register, value_encode(ValueInt32(index)))
  proto_builder_load_constant(builder, value_register, value_encode(ValueBool(flag)))
  emit_instruction(builder, instruction_words_set_index(array_register, index_register, value_register))
end

fn store_bool_elements(
  builder: ref mut ProtoBuilder,
  elements: [Shared<Expr>],
  array_register: i32,
  index_register: i32,
  value_register: i32
) -> unit = do
  let mut index = 0
  while index < elements.length() do
    store_one_bool(
      builder,
      array_register,
      index_register,
      value_register,
      index,
      element_flag(elements[index])
    )
    index = index + 1
  end
end

fn emit_bool_array(builder: ref mut ProtoBuilder, elements: [Shared<Expr>], array_register: i32) -> unit = do
  let length_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, length_register, value_encode(ValueInt32(elements.length())))
  emit_instruction(builder, instruction_words_new_array(array_register, length_register))
  let index_register = proto_builder_register_allocate(builder)
  let value_register = proto_builder_register_allocate(builder)
  store_bool_elements(builder, elements, array_register, index_register, value_register)
end

fn place_bool_elements(builder: ref mut ProtoBuilder, elements: [Shared<Expr>], array_register: i32) -> unit = do
  let mark = proto_builder_register_mark(builder)
  emit_bool_array(builder, elements, array_register)
  proto_builder_register_release_to(builder, mark)
end

fn remember_element_type(scope: ref mut LowerScope, value_type: LowerType) -> unit =
  lower_scope_define(scope, "*array_element*", 0, value_type, false)

fn remembered_element_type(scope: ref mut LowerScope) -> LowerType = do
  let found = lower_scope_lookup(scope, "*array_element*")
  if found < 0 then LowerInt else scope.names[found].value_type end
end

fn place_elements(builder: ref mut ProtoBuilder, elements: [Shared<Expr>], array_register: i32) -> unit = do
  let mark = proto_builder_register_mark(builder)
  emit_integer_array(builder, elements, array_register)
  proto_builder_register_release_to(builder, mark)
end

fn place_array_literal(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  elements: [Shared<Expr>],
  source_span: Span,
  array_register: i32
) -> unit =
  if elements_are_integers(elements) then
    do
      place_elements(builder, elements, array_register)
      remember_element_type(scope, LowerInt)
    end
  else if elements_are_bools(elements) then
    do
      place_bool_elements(builder, elements, array_register)
      remember_element_type(scope, LowerBool)
    end
  else if mixed_scalar_elements(elements) then
    lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
  else if contains_nested_array(elements) then
    lower_scope_fail(scope, diagnostic_at("unsupported_nested_array", source_span))
  else
    place_other_array_literal(scope, builder, elements, source_span, array_register)
  end

fn move_named_array(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  name: string,
  name_span: Span,
  array_register: i32
) -> unit = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    lower_scope_fail(scope, diagnostic_at("unknown_identifier", name_span))
  else
    move_to_target(builder, array_register, scope.names[found].register_index)
  end
end

export fn place_integer_array(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  source_span: Span,
  array_register: i32
) -> unit =
  match expression {
    ExprArray(elements, _) =>
      place_array_literal(scope, builder, elements, source_span, array_register),
    ExprIdent(name, name_span) =>
      move_named_array(scope, builder, name, name_span, array_register),
    _ => lower_scope_fail(scope, diagnostic_at("unsupported_expression", source_span))
  }

export fn finish_array_index(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  index_type: LowerType,
  array_register: i32,
  index_register: i32,
  target: i32,
  source_span: Span
) -> LowerType =
  if scope.has_diagnostic then
    LowerInt
  else if is_lower_int(index_type) then
    do
      emit_instruction(builder, instruction_words_get_index(target, array_register, index_register))
      remembered_element_type(scope)
    end
  else
    do
      lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
      LowerInt
    end
  end

fn rejected_store(scope: ref mut LowerScope, code: string, source_span: Span) -> i32 = do
  lower_scope_fail(scope, diagnostic_at(code, source_span))
  0 - 1
end

fn named_array_register(scope: ref mut LowerScope, name: string, name_span: Span, source_span: Span) -> i32 = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    rejected_store(scope, "unknown_identifier", name_span)
  else if !scope.names[found].is_mutable then
    rejected_store(scope, "assign_immutable", source_span)
  else
    scope.names[found].register_index
  end
end

export fn array_store_register(scope: ref mut LowerScope, base: Shared<Expr>, source_span: Span) -> i32 =
  match base {
    ExprIdent(name, name_span) => named_array_register(scope, name, name_span, source_span),
    _ => rejected_store(scope, "unsupported_statement", source_span)
  }

fn skip_array_store() -> unit = do
  let mut skipped = 0
  skipped = skipped
end

export fn emit_array_element_store(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  index_type: LowerType,
  value_type: LowerType,
  array_register: i32,
  index_register: i32,
  value_register: i32,
  source_span: Span
) -> unit =
  if scope.has_diagnostic then
    skip_array_store()
  else if !is_lower_int(index_type) || !is_lower_int(value_type) then
    lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
  else
    emit_instruction(builder, instruction_words_set_index(array_register, index_register, value_register))
  end

export fn lower_array_named(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  name: string,
  arguments: [Shared<Expr>],
  source_span: Span,
  target: i32
) -> LowerType =
  if name == "len" && arguments.length() == 1 then
    lower_length_or_text(scope, builder, arguments, source_span, target)
  else
    lower_text_named(scope, builder, name, arguments, source_span, target)
  end
