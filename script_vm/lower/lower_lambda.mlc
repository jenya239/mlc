import { Expr, Span, expr_span } from '../../compiler/frontend/ast'
import {
  instruction_opcode_add,
  instruction_opcode_div,
  instruction_opcode_mul,
  instruction_opcode_sub,
  instruction_upvalue_source_word,
  instruction_words_call,
  instruction_words_get_upval,
  instruction_words_make_closure,
  instruction_words_return
} from '../bytecode'
import { ValueInt32, value_encode } from '../value'
import { FunctionProto } from '../run_result'
import {
  ProtoBuilder,
  proto_builder_emit,
  proto_builder_load_constant,
  proto_builder_finish,
  proto_builder_new,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import {
  call_argument_register,
  call_parameter_count,
  call_signature_found,
  call_signature_proto_index,
  call_signature_result_type,
  finish_call_instruction,
  prepare_call_block
} from './lower_call'
import { diagnostic_at, emit_binary, move_to_target } from './lower_control'
import { LowerDiagnosticSink } from './lower_diagnostics'
import {
  LowerScope,
  lower_scope_allocate_closure_index,
  lower_scope_define,
  lower_scope_fail,
  lower_scope_lookup,
  lower_scope_new,
  lower_scope_push_closure_prototype
} from './lower_scope'
import { LowerInt, LowerRecord, LowerType } from './lower_types'

// Invariants:
// - a lambda without free names is a prototype placed after every top-level prototype
// - a free local is copied into a new upvalue cell when MAKE_CLOSURE runs
// - a later write of that local register does not change the cell
// - the lambda reads the cell with GET_UPVAL
// - a later call through the bound name loads that closure value and uses CALL
// - a top-level function name used as a value is MAKE_CLOSURE of that prototype with no upvalues
// - a parameter whose value is a closure is called with that same CALL
// - a direct call may pass that closure in an argument register
// - a free name bound by an enclosing lambda is an upvalue of the inner prototype
type LambdaCaptures = {
  names: [string],
  sources: [i32]
}
type LambdaBuilt = {
  prototype: FunctionProto,
  sources: [i32]
}
export type LambdaAttempt =
  | LambdaHandled(LowerType)
  | LambdaIgnored
fn closure_type_name(parameter_count: i32) -> string = "*closure*" + parameter_count.to_string()
fn integer_opcode(operator: string) -> i32 =
  if operator == "+" then
    instruction_opcode_add()
  else if operator == "-" then
    instruction_opcode_sub()
  else if operator == "*" then
    instruction_opcode_mul()
  else if operator == "/" then
    instruction_opcode_div()
  else
    0
  end
fn fail_lambda(scope: ref mut LowerScope, source_span: Span, code: string) -> unit =
  lower_scope_fail(scope, diagnostic_at(code, source_span))
fn bind_lambda_parameters(lambda_scope: ref mut LowerScope, parameters: [string]) -> unit = do
  let mut index = 0
  while index < parameters.length() do
    lower_scope_define(lambda_scope, parameters[index], index, LowerInt, false)
    index = index + 1
  end
end
fn empty_captures() -> LambdaCaptures = do
  let mut names: [string] = []
  let mut sources: [i32] = []
  LambdaCaptures { names: names, sources: sources }
end
fn find_capture(captures: ref mut LambdaCaptures, name: string) -> i32 = do
  let mut index = 0
  let mut found = 0 - 1
  while index < captures.names.length() && found < 0 do
    if captures.names[index] == name then
      found = index
    end
    index = index + 1
  end
  found
end
fn usable_parent_register(register_index: i32) -> i32 =
  if register_index < 0 then
    0 - 1
  else
    register_index
  end
fn parent_local_register(scope: ref mut LowerScope, name: string) -> i32 = do
  let slot = lower_scope_lookup(scope, name)
  if slot < 0 then
    0 - 1
  else
    usable_parent_register(scope.names[slot].register_index)
  end
end
fn remember_source(captures: ref mut LambdaCaptures, name: string, source_word: i32) -> i32 = do
  let found = find_capture(captures, name)
  if found >= 0 then
    found
  else
    do
      let upvalue_index = captures.names.length()
      captures.names.push(name)
      captures.sources.push(source_word)
      upvalue_index
    end
  end
end
fn capture_transitive(enclosing_scope: ref mut LowerScope, enclosing_captures: ref mut LambdaCaptures, name: string) -> i32 = do
  let local_register = parent_local_register(enclosing_scope, name)
  let found = find_capture(enclosing_captures, name)
  if local_register >= 0 then
    instruction_upvalue_source_word(1, local_register)
  else if found >= 0 then
    instruction_upvalue_source_word(0, found)
  else
    0 - 1
  end
end
fn load_free_name(scope: ref mut LowerScope, enclosing_scope: ref mut LowerScope, enclosing_captures: ref mut LambdaCaptures, captures: ref mut LambdaCaptures, builder: ref mut ProtoBuilder, name: string, source_span: Span, target: i32) -> unit = do
  let transitive = capture_transitive(enclosing_scope, enclosing_captures, name)
  let parent_register = parent_local_register(scope, name)
  let source_word = if transitive >= 0 then
    transitive
  else if parent_register >= 0 then
    instruction_upvalue_source_word(1, parent_register)
  else
    0 - 1
  end
  if source_word < 0 then
    fail_lambda(scope, source_span, "unknown_identifier")
  else
    do
      let upvalue_index = remember_source(captures, name, source_word)
      let emitted = proto_builder_emit(builder, instruction_words_get_upval(target, upvalue_index))
      if emitted < 0 then
        fail_lambda(scope, source_span, "unsupported_expression")
      end
    end
  end
end

fn lower_lambda_into(scope: ref mut LowerScope, enclosing_scope: ref mut LowerScope, enclosing_captures: ref mut LambdaCaptures, captures: ref mut LambdaCaptures, lambda_scope: ref mut LowerScope, builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> unit =
  match expression {
    ExprInt(number, _) =>
      proto_builder_load_constant(builder, target, value_encode(ValueInt32(number))),
    ExprIdent(name, source_span) => do
      let slot = lower_scope_lookup(lambda_scope, name)
      if slot < 0 then
        load_free_name(scope, enclosing_scope, enclosing_captures, captures, builder, name, source_span, target)
      else
        move_to_target(builder, target, lambda_scope.names[slot].register_index)
      end
    end,
    ExprBin(operator, left, right, source_span) => do
      let opcode = integer_opcode(operator)
      if opcode == 0 then
        fail_lambda(scope, source_span, "unsupported_expression")
      else
        let left_register = proto_builder_register_allocate(builder)
        let right_register = proto_builder_register_allocate(builder)
        lower_lambda_into(scope, enclosing_scope, enclosing_captures, captures, lambda_scope, builder, left, left_register)
        lower_lambda_into(scope, enclosing_scope, enclosing_captures, captures, lambda_scope, builder, right, right_register)
        if !scope.has_diagnostic then
          emit_binary(builder, opcode, target, left_register, right_register)
        end
      end
    end,
    ExprLambda(parameters, body, _) =>
      emit_lambda_at(scope, lambda_scope, captures, builder, parameters, body, target),
    _ => fail_lambda(scope, expr_span(expression), "unsupported_expression")
  }

fn build_lambda_prototype(scope: ref mut LowerScope, enclosing_scope: ref mut LowerScope, enclosing_captures: ref mut LambdaCaptures, parameters: [string], body: Shared<Expr>) -> LambdaBuilt = do
  let mut builder = proto_builder_new(parameters.length())
  let mut lambda_scope = lower_scope_new()
  let mut captures = empty_captures()
  bind_lambda_parameters(lambda_scope, parameters)
  let destination = proto_builder_register_allocate(builder)
  lower_lambda_into(scope, enclosing_scope, enclosing_captures, captures, lambda_scope, builder, body, destination)
  if !scope.has_diagnostic then
    proto_builder_emit(builder, instruction_words_return(destination))
  end
  LambdaBuilt { prototype: proto_builder_finish(builder), sources: captures.sources }
end
fn emit_closure_value(builder: ref mut ProtoBuilder, target: i32, prototype_index: i32, sources: [i32]) -> i32 =
  proto_builder_emit(builder, instruction_words_make_closure(target, prototype_index, sources))
fn emit_lambda_at(scope: ref mut LowerScope, enclosing_scope: ref mut LowerScope, enclosing_captures: ref mut LambdaCaptures, builder: ref mut ProtoBuilder, parameters: [string], body: Shared<Expr>, target: i32) -> unit = do
  let built = build_lambda_prototype(scope, enclosing_scope, enclosing_captures, parameters, body)
  if !scope.has_diagnostic then
    let prototype_index = lower_scope_allocate_closure_index(scope)
    lower_scope_push_closure_prototype(scope, built.prototype)
    emit_closure_value(builder, target, prototype_index, built.sources)
  end
end
fn lower_lambda_expression(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, parameters: [string], body: Shared<Expr>, target: i32) -> LowerType = do
  let mut enclosing_scope = lower_scope_new()
  let mut enclosing_captures = empty_captures()
  emit_lambda_at(scope, enclosing_scope, enclosing_captures, builder, parameters, body, target)
  if scope.has_diagnostic then
    LowerInt
  else
    LowerRecord(closure_type_name(parameters.length()))
  end
end
fn closure_register(scope: ref mut LowerScope, name: string, argument_count: i32) -> i32 = do
  let slot = lower_scope_lookup(scope, name)
  if slot < 0 then
    0 - 1
  else
    closure_register_at(scope, slot, argument_count)
  end
end
fn closure_register_at(scope: ref mut LowerScope, slot: i32, argument_count: i32) -> i32 =
  match scope.names[slot].value_type {
    LowerRecord(record_name) =>
      if record_name == closure_type_name(argument_count) then
        scope.names[slot].register_index
      else
        0 - 1
      end,
    _ => 0 - 1
  }
fn local_operand(scope: ref mut LowerScope, name: string) -> i32 = do
  let slot = lower_scope_lookup(scope, name)
  if slot < 0 then
    0 - 1
  else
    usable_parent_register(scope.names[slot].register_index)
  end
end
fn local_integer_register(scope: ref mut LowerScope, name: string) -> i32 = do
  let slot = lower_scope_lookup(scope, name)
  if slot < 0 then
    0 - 1
  else
    match scope.names[slot].value_type {
      LowerInt => usable_parent_register(scope.names[slot].register_index),
      _ => 0 - 1
    }
  end
end
fn record_is_closure(record_name: string) -> bool =
  record_name.length() >= 9 && record_name.substring(0, 9) == "*closure*"

fn argument_carries_closure(scope: ref mut LowerScope, argument: Shared<Expr>) -> bool =
  match argument {
    ExprLambda(_, _, _) => true,
    ExprIdent(name, _) => do
      let slot = lower_scope_lookup(scope, name)
      if slot < 0 then
        false
      else
        match scope.names[slot].value_type {
          LowerRecord(record_name) => record_is_closure(record_name),
          _ => false
        }
      end
    end,
    _ => false
  }

fn arguments_carry_closure(scope: ref mut LowerScope, arguments: [Shared<Expr>]) -> bool = do
  let mut index = 0
  let mut found = false
  while index < arguments.length() && !found do
    found = argument_carries_closure(scope, arguments[index])
    index = index + 1
  end
  found
end

fn store_call_argument(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, argument: Shared<Expr>, argument_register: i32) -> bool =
  match argument {
    ExprInt(number, _) => do
      proto_builder_load_constant(builder, argument_register, value_encode(ValueInt32(number)))
      true
    end,
    ExprIdent(name, _) => do
      let source = local_operand(scope, name)
      if source < 0 then
        false
      else
        do
          move_to_target(builder, argument_register, source)
          true
        end
      end
    end,
    ExprLambda(parameters, body, _) => do
      lower_lambda_expression(scope, builder, parameters, body, argument_register)
      !scope.has_diagnostic
    end,
    _ => false
  }

fn emit_closure_call(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, closure_register_index: i32, arguments: [Shared<Expr>], source_span: Span, target: i32) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let base = proto_builder_register_allocate(builder)
  move_to_target(builder, base, closure_register_index)
  let mut index = 0
  while index < arguments.length() && !scope.has_diagnostic do
    let argument_register = proto_builder_register_allocate(builder)
    if !store_call_argument(scope, builder, arguments[index], argument_register) then
      fail_lambda(scope, source_span, "unsupported_expression")
    end
    index = index + 1
  end
  if !scope.has_diagnostic then
    proto_builder_emit(builder, instruction_words_call(target, base, arguments.length()))
  end
  proto_builder_register_release_to(builder, mark)
  LowerInt
end

fn emit_direct_call(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, proto_index: i32, arguments: [Shared<Expr>], source_span: Span, target: i32, result_type: LowerType) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let base = prepare_call_block(builder, proto_index, arguments.length())
  let mut index = 0
  while index < arguments.length() && !scope.has_diagnostic do
    if !store_call_argument(scope, builder, arguments[index], call_argument_register(base, index)) then
      fail_lambda(scope, source_span, "unsupported_expression")
    end
    index = index + 1
  end
  if !scope.has_diagnostic then
    finish_call_instruction(builder, target, base, arguments.length())
  end
  proto_builder_register_release_to(builder, mark)
  result_type
end

fn direct_closure_call_ready(scope: ref mut LowerScope, name: string, arguments: [Shared<Expr>]) -> bool =
  call_signature_found(scope, name) && arguments.length() == call_parameter_count(scope, name) && arguments_carry_closure(scope, arguments)

fn named_call_attempt(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, name: string, arguments: [Shared<Expr>], source_span: Span, target: i32) -> LambdaAttempt =
  if closure_register(scope, name, arguments.length()) >= 0 then
    LambdaHandled(emit_closure_call(scope, builder, closure_register(scope, name, arguments.length()), arguments, source_span, target))
  else if local_integer_register(scope, name) >= 0 then
    LambdaHandled(emit_closure_call(scope, builder, local_integer_register(scope, name), arguments, source_span, target))
  else if direct_closure_call_ready(scope, name, arguments) then
    LambdaHandled(emit_direct_call(scope, builder, call_signature_proto_index(scope, name), arguments, source_span, target, call_signature_result_type(scope, name)))
  else
    LambdaIgnored
  end

fn call_attempt(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, callee: Shared<Expr>, arguments: [Shared<Expr>], source_span: Span, target: i32) -> LambdaAttempt =
  match callee {
    ExprIdent(name, _) => named_call_attempt(scope, builder, name, arguments, source_span, target),
    _ => LambdaIgnored
  }

fn emit_function_value(builder: ref mut ProtoBuilder, proto_index: i32, parameter_count: i32, target: i32) -> LowerType = do
  let mut sources: [i32] = []
  proto_builder_emit(builder, instruction_words_make_closure(target, proto_index, sources))
  LowerRecord(closure_type_name(parameter_count))
end

fn ident_attempt(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, name: string, target: i32) -> LambdaAttempt =
  if local_operand(scope, name) >= 0 then
    LambdaIgnored
  else if call_signature_found(scope, name) then
    LambdaHandled(emit_function_value(builder, call_signature_proto_index(scope, name), call_parameter_count(scope, name), target))
  else
    LambdaIgnored
  end

export fn lower_lambda_try(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> LambdaAttempt =
  match expression {
    ExprLambda(parameters, body, _) =>
      LambdaHandled(lower_lambda_expression(scope, builder, parameters, body, target)),
    ExprCall(callee, arguments, source_span) =>
      call_attempt(scope, builder, callee, arguments, source_span, target),
    ExprIdent(name, _) => ident_attempt(scope, builder, name, target),
    _ => LambdaIgnored
  }
