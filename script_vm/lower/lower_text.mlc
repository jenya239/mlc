import { Expr, Span } from '../../compiler/frontend/ast'
import { ValueInt32, value_encode } from '../value'
import {
  instruction_opcode_add,
  instruction_words_binary,
  instruction_words_new_array,
  instruction_words_set_index
} from '../bytecode'
import { instruction_opcode_length, instruction_opcode_make_string } from '../bytecode_text'
import {
  ProtoBuilder,
  proto_builder_load_constant,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import { diagnostic_at, emit_instruction, is_lower_int } from './lower_control'
import { LowerScope, lower_scope_fail, lower_scope_lookup } from './lower_scope'
import { LowerType, LowerInt } from './lower_types'

extern fn source_byte(text: string, index: i32) -> i32 =
  "mlc::net::string_byte_u8" from "mlc/net/websocket_abi.hpp"

fn store_source_byte(
  builder: ref mut ProtoBuilder,
  array_register: i32,
  index_register: i32,
  byte_register: i32,
  index: i32,
  byte_value: i32
) -> unit = do
  proto_builder_load_constant(builder, index_register, value_encode(ValueInt32(index)))
  proto_builder_load_constant(builder, byte_register, value_encode(ValueInt32(byte_value)))
  emit_instruction(builder, instruction_words_set_index(array_register, index_register, byte_register))
end

fn store_source_bytes(
  builder: ref mut ProtoBuilder,
  text: string,
  array_register: i32,
  index_register: i32,
  byte_register: i32
) -> unit = do
  let mut index = 0
  while index < text.length() do
    store_source_byte(builder, array_register, index_register, byte_register, index, source_byte(text, index))
    index = index + 1
  end
end

fn lower_text_literal(builder: ref mut ProtoBuilder, text: string, target: i32) -> unit = do
  let mark = proto_builder_register_mark(builder)
  let length_register = proto_builder_register_allocate(builder)
  proto_builder_load_constant(builder, length_register, value_encode(ValueInt32(text.length())))
  let array_register = proto_builder_register_allocate(builder)
  emit_instruction(builder, instruction_words_new_array(array_register, length_register))
  let index_register = proto_builder_register_allocate(builder)
  let byte_register = proto_builder_register_allocate(builder)
  store_source_bytes(builder, text, array_register, index_register, byte_register)
  emit_instruction(
    builder,
    instruction_words_binary(instruction_opcode_make_string(), target, array_register, 0)
  )
  proto_builder_register_release_to(builder, mark)
end

fn text_expression(expression: Shared<Expr>) -> bool =
  match expression {
    ExprStr(_, _) => true,
    ExprChar(_, _) => true,
    ExprBin(operator, left, right, _) =>
      if operator == "+" then
        text_expression(left) && text_expression(right)
      else
        false
      end,
    _ => false
  }

fn lower_text_skip() -> unit = do
  let mut skipped = 0
  skipped = skipped
end

fn lower_text_addition(
  builder: ref mut ProtoBuilder,
  left: Shared<Expr>,
  right: Shared<Expr>,
  target: i32
) -> unit = do
  let mark = proto_builder_register_mark(builder)
  let left_register = proto_builder_register_allocate(builder)
  let right_register = proto_builder_register_allocate(builder)
  lower_text_into(builder, left, left_register)
  lower_text_into(builder, right, right_register)
  emit_instruction(
    builder,
    instruction_words_binary(instruction_opcode_add(), target, left_register, right_register)
  )
  proto_builder_register_release_to(builder, mark)
end

fn lower_text_into(builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> unit =
  match expression {
    ExprStr(text, _) => lower_text_literal(builder, text, target),
    ExprChar(text, _) => lower_text_literal(builder, text, target),
    ExprBin(operator, left, right, _) =>
      if operator == "+" then
        lower_text_addition(builder, left, right, target)
      else
        lower_text_skip()
      end,
    _ => lower_text_skip()
  }

fn integer_name(scope: ref mut LowerScope, name: string) -> bool = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    false
  else
    is_lower_int(scope.names[found].value_type)
  end
end

fn integer_expression(scope: ref mut LowerScope, expression: Shared<Expr>) -> bool =
  match expression {
    ExprInt(_, _) => true,
    ExprIdent(name, _) => integer_name(scope, name),
    ExprUn(operator, inner, _) =>
      if operator == "-" then
        integer_expression(scope, inner)
      else
        false
      end,
    ExprBin(operator, left, right, _) =>
      if operator == "+" || operator == "-" || operator == "*" || operator == "/" then
        integer_expression(scope, left) && integer_expression(scope, right)
      else
        false
      end,
    _ => false
  }

fn reject_integer_length(scope: ref mut LowerScope, source_span: Span) -> LowerType = do
  lower_scope_fail(scope, diagnostic_at("type_mismatch", source_span))
  LowerInt
end

fn lower_length_of_expression(builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> LowerType = do
  let mark = proto_builder_register_mark(builder)
  let string_register = proto_builder_register_allocate(builder)
  lower_text_into(builder, expression, string_register)
  emit_instruction(
    builder,
    instruction_words_binary(instruction_opcode_length(), target, string_register, 0)
  )
  proto_builder_register_release_to(builder, mark)
  LowerInt
end

fn unknown_name(scope: ref mut LowerScope, source_span: Span) -> LowerType = do
  lower_scope_fail(scope, diagnostic_at("unknown_function", source_span))
  LowerInt
end

fn lower_length_argument(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  argument: Shared<Expr>,
  source_span: Span,
  target: i32
) -> LowerType =
  if text_expression(argument) then
    lower_length_of_expression(builder, argument, target)
  else if integer_expression(scope, argument) then
    reject_integer_length(scope, source_span)
  else
    unknown_name(scope, source_span)
  end

export fn lower_text_handles_plus(operator: string, left: Shared<Expr>, right: Shared<Expr>) -> bool =
  operator == "+" && text_expression(left) && text_expression(right)

export fn lower_text_concatenate(
  builder: ref mut ProtoBuilder,
  left: Shared<Expr>,
  right: Shared<Expr>,
  target: i32
) -> LowerType = do
  lower_text_addition(builder, left, right, target)
  LowerInt
end

export fn lower_text_named(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  name: string,
  arguments: [Shared<Expr>],
  source_span: Span,
  target: i32
) -> LowerType =
  if name == "len" && arguments.length() == 1 then
    lower_length_argument(scope, builder, arguments[0], source_span, target)
  else
    unknown_name(scope, source_span)
  end
