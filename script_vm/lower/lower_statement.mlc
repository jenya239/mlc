import {
  Expr,
  ExprArray,
  ExprBin,
  ExprField,
  ExprBlock,
  ExprBool,
  ExprFor,
  ExprIdent,
  ExprIf,
  ExprIndex,
  ExprUnit,
  ExprWhile,
  Span,
  Stmt,
  StmtBreak,
  StmtContinue,
  StmtExpr,
  StmtLet,
  StmtLetConst,
  StmtReturn,
  stmt_span
} from '../../compiler/frontend/ast'
import {
  ProtoBuilder,
  proto_builder_emit_jump,
  proto_builder_emit_jump_back,
  proto_builder_emit_jump_if_false,
  proto_builder_here,
  proto_builder_patch_to_here,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import { diagnostic_at, is_lower_bool, types_agree } from './lower_control'
import { LowerDiagnosticSink, lower_diagnostic_add } from './lower_diagnostics'
import { LowerType, LowerBool, LowerInt } from './lower_types'
import {
  LowerScope,
  lower_scope_define,
  lower_scope_fail,
  lower_scope_lookup,
  lower_scope_pop,
  lower_scope_push
} from './lower_scope'
import { lower_expression } from './lower_expression'
import { array_store_register, emit_array_element_store, place_integer_array } from './lower_array'
import { finish_field_assignment } from './lower_records'
import { accept_discarded_type, advance_for_index, assignment_target, begin_while_frame, define_for_element, emit_for_condition, emit_value_return, expression_is_unit, finish_while_frame, keep_unit, lower_break, lower_continue, prepare_for_cursor } from './lower_iteration'

export type LowerFunctionSignature = { result_type: LowerType }

export fn lower_block(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statements: [Shared<Stmt>], final_expression: Shared<Expr>, target: i32) -> LowerType = do
  lower_scope_push(scope, builder)
  let result_type = block_result(scope, sink, builder, statements, final_expression, target)
  lower_scope_pop(scope, builder)
  result_type
end

fn named_result_type(scope: ref mut LowerScope, name: string) -> LowerType = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then LowerInt else scope.names[found].value_type end
end

fn final_result_type(scope: ref mut LowerScope, expression: Shared<Expr>) -> LowerType =
  match expression {
    ExprBool(_, _) => LowerBool,
    ExprIdent(name, _) => named_result_type(scope, name),
    _ => LowerInt
  }

fn remember_result_type(scope: ref mut LowerScope, expression: Shared<Expr>) -> unit = do
  let result_type = final_result_type(scope, expression)
  let signature = LowerFunctionSignature { result_type: result_type }
  lower_scope_define(scope, "*result_type*", 0, signature.result_type, false)
end

fn stored_result_type(scope: ref mut LowerScope) -> LowerType = do
  let found = lower_scope_lookup(scope, "*result_type*")
  if found < 0 then LowerInt else scope.names[found].value_type end
end

fn lower_return_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>, source_span: Span) -> unit = do
  let signature = LowerFunctionSignature { result_type: stored_result_type(scope) }
  let temporary = proto_builder_register_allocate(builder)
  let value_type = lower_expression(scope, sink, builder, expression, temporary)
  if !scope.has_diagnostic && !types_agree(value_type, signature.result_type) then
    fail_at(scope, "type_mismatch", source_span)
  else if !scope.has_diagnostic then
    emit_value_return(builder, temporary)
  end
end

fn reject_while_result(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, condition: Shared<Expr>, statements: [Shared<Stmt>], source_span: Span) -> LowerType = do
  lower_while_statement(scope, sink, builder, condition, statements, source_span)
  if !scope.has_diagnostic then
    fail_at(scope, "type_mismatch", source_span)
  end
  LowerInt
end

fn finish_block_value(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> LowerType =
  match expression {
    ExprWhile(condition, statements, source_span) =>
      reject_while_result(scope, sink, builder, condition, statements, source_span),
    _ => lower_expression(scope, sink, builder, expression, target)
  }

fn block_result(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statements: [Shared<Stmt>], final_expression: Shared<Expr>, target: i32) -> LowerType = do
  remember_result_type(scope, final_expression)
  lower_statements(scope, sink, builder, statements)
  if scope.has_diagnostic then
    LowerInt
  else
    finish_block_value(scope, sink, builder, final_expression, target)
  end
end

fn lower_initializer(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>, target: i32) -> LowerType =
  match expression {
    ExprBlock(statements, final_expression, _) =>
      lower_block(scope, sink, builder, statements, final_expression, target),
    ExprArray(_, source_span) => do
      place_integer_array(scope, builder, expression, source_span, target)
      LowerInt
    end,
    _ => lower_expression(scope, sink, builder, expression, target)
  }

fn reject_register_limit(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, source_span: Span) -> unit = do
  lower_diagnostic_add(sink, "too_many_registers", "too_many_registers", source_span)
  fail_at(scope, "too_many_registers", source_span)
end

fn note_register_limit(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, allocated_register: i32, source_span: Span) -> unit =
  if allocated_register >= 256 then
    reject_register_limit(scope, sink, source_span)
  end

fn lower_initialized_name(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, name: string, is_mutable: bool, expression: Shared<Expr>, source_span: Span) -> unit = do
  let destination = proto_builder_register_allocate(builder)
  note_register_limit(scope, sink, destination, source_span)
  if !scope.has_diagnostic then
    define_initialized_name(scope, sink, builder, name, is_mutable, expression, destination)
  end
end

fn define_initialized_name(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, name: string, is_mutable: bool, expression: Shared<Expr>, destination: i32) -> unit = do
  let value_type = lower_initializer(scope, sink, builder, expression, destination)
  lower_scope_define(scope, name, destination, value_type, is_mutable)
end

fn lower_discarded_expression(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>) -> unit = do
  let mark = proto_builder_register_mark(builder)
  let temporary = proto_builder_register_allocate(builder)
  let value_type = lower_expression(scope, sink, builder, expression, temporary)
  accept_discarded_type(value_type)
  proto_builder_register_release_to(builder, mark)
end

fn fail_at(scope: ref mut LowerScope, code: string, source_span: Span) -> unit =
  lower_scope_fail(scope, diagnostic_at(code, source_span))

fn assign_mutable(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, local_register: i32, expected_type: LowerType, right: Shared<Expr>, source_span: Span) -> unit = do
  let destination = assignment_target(builder, local_register)
  let value_type = lower_expression(scope, sink, builder, right, destination)
  if !scope.has_diagnostic && !types_agree(expected_type, value_type) then
    fail_at(scope, "type_mismatch", source_span)
  end
end

fn assign_name(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, name: string, name_span: Span, right: Shared<Expr>, source_span: Span) -> unit = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    fail_at(scope, "unknown_identifier", name_span)
  else if !scope.names[found].is_mutable then
    fail_at(scope, "assign_immutable", source_span)
  else
    assign_mutable(scope, sink, builder, scope.names[found].register_index, scope.names[found].value_type, right, source_span)
  end
end

fn write_mutable_field(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, record_register: i32, record_type: LowerType, field_name: string, right: Shared<Expr>, source_span: Span) -> unit = do
  let mark = proto_builder_register_mark(builder)
  let value_register = proto_builder_register_allocate(builder)
  let value_type = lower_expression(scope, sink, builder, right, value_register)
  finish_field_assignment(scope, builder, record_type, field_name, record_register, value_type, value_register, mark, source_span)
end

fn assign_named_field(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, name: string, name_span: Span, field_name: string, right: Shared<Expr>, source_span: Span) -> unit = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    fail_at(scope, "unknown_identifier", name_span)
  else if !scope.names[found].is_mutable then
    fail_at(scope, "assign_immutable", source_span)
  else
    write_mutable_field(scope, sink, builder, scope.names[found].register_index, scope.names[found].value_type, field_name, right, source_span)
  end
end

fn assign_field(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, base: Shared<Expr>, field_name: string, right: Shared<Expr>, source_span: Span) -> unit =
  match base {
    ExprIdent(name, name_span) =>
      assign_named_field(scope, sink, builder, name, name_span, field_name, right, source_span),
    _ => fail_at(scope, "unsupported_statement", source_span)
  }

fn assign_array_index(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, base: Shared<Expr>, index: Shared<Expr>, right: Shared<Expr>, source_span: Span) -> unit = do
  let array_register = array_store_register(scope, base, source_span)
  if !scope.has_diagnostic then
    do
      let mark = proto_builder_register_mark(builder)
      let index_register = proto_builder_register_allocate(builder)
      let index_type = lower_expression(scope, sink, builder, index, index_register)
      let value_register = proto_builder_register_allocate(builder)
      let value_type = lower_expression(scope, sink, builder, right, value_register)
      emit_array_element_store(scope, builder, index_type, value_type, array_register, index_register, value_register, source_span)
      proto_builder_register_release_to(builder, mark)
    end
  end
end

fn lower_assignment(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, left: Shared<Expr>, right: Shared<Expr>, source_span: Span) -> unit =
  match left {
    ExprIdent(name, name_span) =>
      assign_name(scope, sink, builder, name, name_span, right, source_span),
    ExprField(base, field_name, _) =>
      assign_field(scope, sink, builder, base, field_name, right, source_span),
    ExprIndex(base, index, _) =>
      assign_array_index(scope, sink, builder, base, index, right, source_span),
    _ => fail_at(scope, "unsupported_statement", source_span)
  }

fn release_condition(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, mark: i32, source_span: Span) -> unit = do
  if !scope.has_diagnostic then
    fail_at(scope, "type_mismatch", source_span)
  end
  proto_builder_register_release_to(builder, mark)
end

fn lower_while_body(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, condition_register: i32, condition_mark: i32, statements: [Shared<Stmt>], top: i32) -> unit = do
  begin_while_frame(scope, top)
  let end_site = proto_builder_emit_jump_if_false(builder, condition_register)
  proto_builder_register_release_to(builder, condition_mark)
  lower_scope_push(scope, builder)
  lower_statements(scope, sink, builder, statements)
  lower_scope_pop(scope, builder)
  proto_builder_emit_jump_back(builder, top)
  proto_builder_patch_to_here(builder, end_site)
  finish_while_frame(scope, builder)
end

fn lower_while_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, condition: Shared<Expr>, statements: [Shared<Stmt>], source_span: Span) -> unit = do
  let top = proto_builder_here(builder)
  let condition_mark = proto_builder_register_mark(builder)
  let condition_register = proto_builder_register_allocate(builder)
  let condition_type = lower_expression(scope, sink, builder, condition, condition_register)
  if scope.has_diagnostic || !is_lower_bool(condition_type) then
    release_condition(scope, sink, builder, condition_mark, source_span)
  else
    lower_while_body(scope, sink, builder, condition_register, condition_mark, statements, top)
  end
end

fn lower_branch_final(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>) -> unit = do
  if !scope.has_diagnostic && !expression_is_unit(expression) then
    lower_discarded_expression(scope, sink, builder, expression)
  end
end

fn lower_block_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statements: [Shared<Stmt>], final_expression: Shared<Expr>) -> unit = do
  lower_scope_push(scope, builder)
  lower_statements(scope, sink, builder, statements)
  lower_branch_final(scope, sink, builder, final_expression)
  lower_scope_pop(scope, builder)
end

fn lower_statement_branch(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>) -> unit =
  match expression {
    ExprUnit(_) => keep_unit(),
    ExprBlock(statements, final_expression, _) =>
      lower_block_statement(scope, sink, builder, statements, final_expression),
    _ => lower_discarded_expression(scope, sink, builder, expression)
  }

fn lower_if_statement_else(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, else_expression: Shared<Expr>, else_site: i32) -> unit = do
  let end_site = proto_builder_emit_jump(builder)
  proto_builder_patch_to_here(builder, else_site)
  lower_statement_branch(scope, sink, builder, else_expression)
  proto_builder_patch_to_here(builder, end_site)
end

fn finish_if_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, else_expression: Shared<Expr>, else_site: i32) -> unit =
  if expression_is_unit(else_expression) then
    proto_builder_patch_to_here(builder, else_site)
  else
    lower_if_statement_else(scope, sink, builder, else_expression, else_site)
  end

fn lower_if_statement_branches(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, condition_register: i32, condition_mark: i32, then_expression: Shared<Expr>, else_expression: Shared<Expr>) -> unit = do
  let else_site = proto_builder_emit_jump_if_false(builder, condition_register)
  proto_builder_register_release_to(builder, condition_mark)
  lower_statement_branch(scope, sink, builder, then_expression)
  finish_if_statement(scope, sink, builder, else_expression, else_site)
end

fn lower_if_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, condition: Shared<Expr>, then_expression: Shared<Expr>, else_expression: Shared<Expr>, source_span: Span) -> unit = do
  let condition_mark = proto_builder_register_mark(builder)
  let condition_register = proto_builder_register_allocate(builder)
  let condition_type = lower_expression(scope, sink, builder, condition, condition_register)
  if scope.has_diagnostic || !is_lower_bool(condition_type) then
    release_condition(scope, sink, builder, condition_mark, source_span)
  else
    lower_if_statement_branches(scope, sink, builder, condition_register, condition_mark, then_expression, else_expression)
  end
end

fn lower_for_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, name: string, collection: Shared<Expr>, statements: [Shared<Stmt>], source_span: Span) -> unit = do
  let array_register = proto_builder_register_allocate(builder)
  place_integer_array(scope, builder, collection, source_span, array_register)
  if scope.has_diagnostic then
    keep_unit()
  else
    do
      let cursor = prepare_for_cursor(builder, array_register)
      let entry_site = proto_builder_emit_jump(builder)
      let head = proto_builder_here(builder)
      advance_for_index(builder, cursor)
      proto_builder_patch_to_here(builder, entry_site)
      begin_while_frame(scope, head)
      let condition_mark = proto_builder_register_mark(builder)
      let condition_register = proto_builder_register_allocate(builder)
      emit_for_condition(builder, cursor, condition_register)
      let end_site = proto_builder_emit_jump_if_false(builder, condition_register)
      proto_builder_register_release_to(builder, condition_mark)
      lower_scope_push(scope, builder)
      define_for_element(scope, builder, cursor, name)
      lower_statements(scope, sink, builder, statements)
      lower_scope_pop(scope, builder)
      proto_builder_emit_jump_back(builder, head)
      proto_builder_patch_to_here(builder, end_site)
      finish_while_frame(scope, builder)
    end
  end
end

fn lower_expression_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, expression: Shared<Expr>) -> unit =
  match expression {
    ExprBin(operator, left, right, source_span) =>
      if operator == "=" then
        lower_assignment(scope, sink, builder, left, right, source_span)
      else
        lower_discarded_expression(scope, sink, builder, expression)
      end,
    ExprWhile(condition, statements, source_span) =>
      lower_while_statement(scope, sink, builder, condition, statements, source_span),
    ExprFor(name, collection, statements, source_span) =>
      lower_for_statement(scope, sink, builder, name, collection, statements, source_span),
    ExprIf(condition, then_expression, else_expression, source_span) =>
      lower_if_statement(scope, sink, builder, condition, then_expression, else_expression, source_span),
    _ => lower_discarded_expression(scope, sink, builder, expression)
  }

export fn lower_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statement: Shared<Stmt>) -> unit = do
  if !scope.has_diagnostic then
    apply_statement(scope, sink, builder, statement)
  end
end

fn apply_statement(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statement: Shared<Stmt>) -> unit =
  match statement {
    StmtLetConst(name, _, expression, source_span) =>
      lower_initialized_name(scope, sink, builder, name, false, expression, source_span),
    StmtLet(name, is_mutable, _, expression, source_span) =>
      lower_initialized_name(scope, sink, builder, name, is_mutable, expression, source_span),
    StmtExpr(expression, _) =>
      lower_expression_statement(scope, sink, builder, expression),
    StmtReturn(expression, source_span) =>
      lower_return_statement(scope, sink, builder, expression, source_span),
    StmtBreak(source_span) =>
      lower_break(scope, sink, builder, source_span),
    StmtContinue(source_span) =>
      lower_continue(scope, sink, builder, source_span),
    _ => fail_at(scope, "unsupported_statement", stmt_span(statement))
  }

export fn lower_statements(scope: ref mut LowerScope, sink: ref mut LowerDiagnosticSink, builder: ref mut ProtoBuilder, statements: [Shared<Stmt>]) -> unit = do
  let mut index = 0
  while index < statements.length() && !scope.has_diagnostic do
    lower_statement(scope, sink, builder, statements[index])
    index = index + 1
  end
end
