import {
  Expr,
  ExprBin,
  ExprBlock,
  ExprIdent,
  ExprIf,
  ExprUnit,
  ExprWhile,
  Span,
  Stmt,
  StmtExpr,
  StmtLet,
  StmtLetConst,
  stmt_span
} from '../../compiler/frontend/ast'
import {
  ProtoBuilder,
  proto_builder_emit_jump,
  proto_builder_emit_jump_back,
  proto_builder_emit_jump_if_false,
  proto_builder_here,
  proto_builder_patch_to_here,
  proto_builder_register_allocate,
  proto_builder_register_mark,
  proto_builder_register_release_to
} from './lower_builder'
import { diagnostic_at, is_lower_bool, types_agree } from './lower_control'
import { LowerDiagnostic, LowerType, LowerInt } from './lower_types'
import {
  LowerScope,
  lower_scope_define,
  lower_scope_fail,
  lower_scope_lookup,
  lower_scope_pop,
  lower_scope_push
} from './lower_scope'
import { lower_expression } from './lower_expression'

export fn lower_block(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statements: [Shared<Stmt>],
  final_expression: Shared<Expr>,
  target: i32
) -> LowerType = do
  lower_scope_push(scope, builder)
  let result_type = block_result(scope, builder, statements, final_expression, target)
  lower_scope_pop(scope, builder)
  result_type
end

fn block_result(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statements: [Shared<Stmt>],
  final_expression: Shared<Expr>,
  target: i32
) -> LowerType = do
  lower_statements(scope, builder, statements)
  if scope.has_diagnostic then
    LowerInt
  else
    lower_expression(scope, builder, final_expression, target)
  end
end

fn lower_initializer(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>,
  target: i32
) -> LowerType =
  match expression {
    ExprBlock(statements, final_expression, _) =>
      lower_block(scope, builder, statements, final_expression, target),
    _ => lower_expression(scope, builder, expression, target)
  }

fn lower_initialized_name(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  name: string,
  is_mutable: bool,
  expression: Shared<Expr>
) -> unit = do
  let destination = proto_builder_register_allocate(builder)
  let value_type = lower_initializer(scope, builder, expression, destination)
  lower_scope_define(scope, name, destination, value_type, is_mutable)
end

fn assignment_target(builder: ref mut ProtoBuilder, local_register: i32) -> i32 = do
  let mark = proto_builder_register_mark(builder)
  proto_builder_register_release_to(builder, mark)
  local_register
end

fn expression_is_unit(expression: Shared<Expr>) -> bool =
  match expression {
    ExprUnit(_) => true,
    _ => false
  }

fn keep_unit() -> unit = do
  let mut once = 0
  while once < 0 do
    once = 1
  end
end

fn accept_discarded_type(value_type: LowerType) -> unit =
  match value_type {
    LowerInt => keep_unit(),
    _ => keep_unit()
  }

fn lower_discarded_expression(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> unit = do
  let mark = proto_builder_register_mark(builder)
  let temporary = proto_builder_register_allocate(builder)
  let value_type = lower_expression(scope, builder, expression, temporary)
  accept_discarded_type(value_type)
  proto_builder_register_release_to(builder, mark)
end

fn fail_at(scope: ref mut LowerScope, code: string, source_span: Span) -> unit =
  lower_scope_fail(scope, diagnostic_at(code, source_span))

fn assign_mutable(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  local_register: i32,
  expected_type: LowerType,
  right: Shared<Expr>,
  source_span: Span
) -> unit = do
  let destination = assignment_target(builder, local_register)
  let value_type = lower_expression(scope, builder, right, destination)
  if !scope.has_diagnostic && !types_agree(expected_type, value_type) then
    fail_at(scope, "type_mismatch", source_span)
  end
end

fn assign_name(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  name: string,
  name_span: Span,
  right: Shared<Expr>,
  source_span: Span
) -> unit = do
  let found = lower_scope_lookup(scope, name)
  if found < 0 then
    fail_at(scope, "unknown_identifier", name_span)
  else if !scope.names[found].is_mutable then
    fail_at(scope, "assign_immutable", source_span)
  else
    assign_mutable(
      scope,
      builder,
      scope.names[found].register_index,
      scope.names[found].value_type,
      right,
      source_span
    )
  end
end

fn lower_assignment(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  left: Shared<Expr>,
  right: Shared<Expr>,
  source_span: Span
) -> unit =
  match left {
    ExprIdent(name, name_span) =>
      assign_name(scope, builder, name, name_span, right, source_span),
    _ => fail_at(scope, "unsupported_statement", source_span)
  }

fn release_condition(scope: ref mut LowerScope, builder: ref mut ProtoBuilder, mark: i32, source_span: Span) -> unit = do
  if !scope.has_diagnostic then
    fail_at(scope, "type_mismatch", source_span)
  end
  proto_builder_register_release_to(builder, mark)
end

fn lower_while_body(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition_register: i32,
  condition_mark: i32,
  statements: [Shared<Stmt>],
  top: i32
) -> unit = do
  let end_site = proto_builder_emit_jump_if_false(builder, condition_register)
  proto_builder_register_release_to(builder, condition_mark)
  lower_scope_push(scope, builder)
  lower_statements(scope, builder, statements)
  lower_scope_pop(scope, builder)
  proto_builder_emit_jump_back(builder, top)
  proto_builder_patch_to_here(builder, end_site)
end

fn lower_while_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition: Shared<Expr>,
  statements: [Shared<Stmt>],
  source_span: Span
) -> unit = do
  let top = proto_builder_here(builder)
  let condition_mark = proto_builder_register_mark(builder)
  let condition_register = proto_builder_register_allocate(builder)
  let condition_type = lower_expression(scope, builder, condition, condition_register)
  if scope.has_diagnostic || !is_lower_bool(condition_type) then
    release_condition(scope, builder, condition_mark, source_span)
  else
    lower_while_body(scope, builder, condition_register, condition_mark, statements, top)
  end
end

fn lower_branch_final(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> unit = do
  if !scope.has_diagnostic && !expression_is_unit(expression) then
    lower_discarded_expression(scope, builder, expression)
  end
end

fn lower_block_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statements: [Shared<Stmt>],
  final_expression: Shared<Expr>
) -> unit = do
  lower_scope_push(scope, builder)
  lower_statements(scope, builder, statements)
  lower_branch_final(scope, builder, final_expression)
  lower_scope_pop(scope, builder)
end

fn lower_statement_branch(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> unit =
  match expression {
    ExprUnit(_) => keep_unit(),
    ExprBlock(statements, final_expression, _) =>
      lower_block_statement(scope, builder, statements, final_expression),
    _ => lower_discarded_expression(scope, builder, expression)
  }

fn lower_if_statement_else(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  else_expression: Shared<Expr>,
  else_site: i32
) -> unit = do
  let end_site = proto_builder_emit_jump(builder)
  proto_builder_patch_to_here(builder, else_site)
  lower_statement_branch(scope, builder, else_expression)
  proto_builder_patch_to_here(builder, end_site)
end

fn finish_if_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  else_expression: Shared<Expr>,
  else_site: i32
) -> unit =
  if expression_is_unit(else_expression) then
    proto_builder_patch_to_here(builder, else_site)
  else
    lower_if_statement_else(scope, builder, else_expression, else_site)
  end

fn lower_if_statement_branches(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition_register: i32,
  condition_mark: i32,
  then_expression: Shared<Expr>,
  else_expression: Shared<Expr>
) -> unit = do
  let else_site = proto_builder_emit_jump_if_false(builder, condition_register)
  proto_builder_register_release_to(builder, condition_mark)
  lower_statement_branch(scope, builder, then_expression)
  finish_if_statement(scope, builder, else_expression, else_site)
end

fn lower_if_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  condition: Shared<Expr>,
  then_expression: Shared<Expr>,
  else_expression: Shared<Expr>,
  source_span: Span
) -> unit = do
  let condition_mark = proto_builder_register_mark(builder)
  let condition_register = proto_builder_register_allocate(builder)
  let condition_type = lower_expression(scope, builder, condition, condition_register)
  if scope.has_diagnostic || !is_lower_bool(condition_type) then
    release_condition(scope, builder, condition_mark, source_span)
  else
    lower_if_statement_branches(
      scope,
      builder,
      condition_register,
      condition_mark,
      then_expression,
      else_expression
    )
  end
end

fn lower_expression_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  expression: Shared<Expr>
) -> unit =
  match expression {
    ExprBin(operator, left, right, source_span) =>
      if operator == "=" then
        lower_assignment(scope, builder, left, right, source_span)
      else
        lower_discarded_expression(scope, builder, expression)
      end,
    ExprWhile(condition, statements, source_span) =>
      lower_while_statement(scope, builder, condition, statements, source_span),
    ExprIf(condition, then_expression, else_expression, source_span) =>
      lower_if_statement(
        scope,
        builder,
        condition,
        then_expression,
        else_expression,
        source_span
      ),
    _ => lower_discarded_expression(scope, builder, expression)
  }

export fn lower_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statement: Shared<Stmt>
) -> unit = do
  if !scope.has_diagnostic then
    apply_statement(scope, builder, statement)
  end
end

fn apply_statement(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statement: Shared<Stmt>
) -> unit =
  match statement {
    StmtLetConst(name, _, expression, _) =>
      lower_initialized_name(scope, builder, name, false, expression),
    StmtLet(name, is_mutable, _, expression, _) =>
      lower_initialized_name(scope, builder, name, is_mutable, expression),
    StmtExpr(expression, _) =>
      lower_expression_statement(scope, builder, expression),
    _ => lower_scope_fail(scope, diagnostic_code_at_statement(statement))
  }

fn diagnostic_code_at_statement(statement: Shared<Stmt>) -> LowerDiagnostic = do
  let source_span = stmt_span(statement)
  LowerDiagnostic {
    code: "unsupported_statement",
    message: "unsupported_statement",
    line: source_span.line,
    column: source_span.column
  }
end

export fn lower_statements(
  scope: ref mut LowerScope,
  builder: ref mut ProtoBuilder,
  statements: [Shared<Stmt>]
) -> unit = do
  let mut index = 0
  while index < statements.length() && !scope.has_diagnostic do
    lower_statement(scope, builder, statements[index])
    index = index + 1
  end
end
