// TRACK_MLC_SCRIPT_VM §103f/§103g — non-moving mark-sweep heap.
// Cell type_id=1 (child); Array=2 / Record=3 (elements[]). Size classes 0..3.
// GC mark flag bit = 1. Freelist pop-reuse deferred (mlcc residual).

import {
  Value,
  ValueNil,
  ValueHeapRef,
  value_encode,
  value_decode
} from './value'
import {
  ObjectHeader,
  HeapSlot,
  Heap,
  HeapAlloc,
  heap_type_cell,
  heap_type_array,
  heap_type_record,
  heap_type_closure,
  heap_new,
  heap_live_object_count,
  heap_write_barrier_hits,
  heap_size_class_bytes,
  slots_with,
  elements_with,
  make_nil_elements
} from './heap_types'
import {
  heap_alloc_cell,
  heap_alloc_array,
  heap_alloc_record,
  heap_alloc_closure,
  heap_in_place_alloc_cell,
  heap_in_place_alloc_array,
  heap_in_place_alloc_record,
  heap_in_place_alloc_closure
} from './heap_alloc'
import {
  heap_in_place_write,
  heap_in_place_read,
  heap_in_place_type_id,
  heap_in_place_element_count,
  heap_in_place_closure_proto_index,
  heap_in_place_cell_child,
  heap_in_place_root_push,
  heap_in_place_root_clear,
  heap_slot_count
} from './heap_access'
import {
  heap_root_push,
  heap_root_clear,
  heap_collect
} from './heap_collect'
export fn heap_closure_proto_index(heap: Heap, closure: Value) -> i32 = do
  let mut next = heap
  heap_in_place_closure_proto_index(next, closure)
end

export fn heap_cell_child(heap: Heap, cell: Value) -> Value = do
  let mut next = heap
  heap_in_place_cell_child(next, cell)
end

export fn heap_object_type_id(heap: Heap, value: Value) -> i32 = do
  let mut next = heap
  heap_in_place_type_id(next, value)
end

export fn heap_get_element(heap: Heap, parent: Value, index: i32) -> Value = do
  let mut next = heap
  heap_in_place_read(next, parent, index)
end

export fn heap_element_count(heap: Heap, parent: Value) -> i32 = do
  let mut next = heap
  heap_in_place_element_count(next, parent)
end

export fn heap_write_barrier(
  heap: Heap,
  parent: Value,
  slot_index: i32,
  new_child: Value
) -> Heap = do
  let mut next = heap
  heap_in_place_write(next, parent, slot_index, new_child)
  next
end
