import { Value, ValueNil, ValueHeapRef, value_encode, value_decode } from './value'
import { ObjectHeader, HeapSlot, Heap, slots_with } from './heap_types'

export fn heap_root_push(heap: Heap, value: Value) -> Heap = do
  let mut roots = heap.roots
  roots.push(value)
  Heap {
    slots: heap.slots,
    element_arena: heap.element_arena,
    free_object_ids: heap.free_object_ids,
    free_object_count: heap.free_object_count,
    roots: roots,
    live_count: heap.live_count,
    write_barrier_hits: heap.write_barrier_hits
  }
end

export fn heap_root_clear(heap: Heap) -> Heap =
  Heap {
    slots: heap.slots,
    element_arena: heap.element_arena,
    free_object_ids: heap.free_object_ids,
    free_object_count: heap.free_object_count,
    roots: [],
    live_count: heap.live_count,
    write_barrier_hits: heap.write_barrier_hits
  }

fn mark_value(heap: Heap, value: Value) -> Heap =
  match value_decode(value) {
    ValueHeapRef(object_id) => mark_object(heap, object_id),
    _ => heap
  }

fn mark_arena_span(heap: Heap, element_start: i32, element_count: i32) -> Heap = do
  let mut next = heap
  let mut index = 0
  while index < element_count do
    next = mark_value(next, next.element_arena[element_start + index])
    index = index + 1
  end
  next
end

fn mark_object(heap: Heap, object_id: i32) -> Heap = do
  if object_id < 0 then
    return heap
  end
  if object_id >= heap.slots.length() then
    return heap
  end
  const slot = heap.slots[object_id]
  if !slot.live then
    return heap
  end
  if (slot.header.gc_flags & 1) != 0 then
    return heap
  end
  const marked_header = ObjectHeader {
    type_id: slot.header.type_id,
    gc_flags: slot.header.gc_flags | 1,
    object_flags: slot.header.object_flags,
    shape_or_meta: slot.header.shape_or_meta
  }
  const marked_slot = HeapSlot {
    header: marked_header,
    child: slot.child,
    element_start: slot.element_start,
    element_count: slot.element_count,
    size_class: slot.size_class,
    live: true
  }
  let mut next = Heap {
    slots: slots_with(heap.slots, object_id, marked_slot),
    element_arena: heap.element_arena,
    free_object_ids: heap.free_object_ids,
    free_object_count: heap.free_object_count,
    roots: heap.roots,
    live_count: heap.live_count,
    write_barrier_hits: heap.write_barrier_hits
  }
  next = mark_value(next, slot.child)
  mark_arena_span(next, slot.element_start, slot.element_count)
end

fn stored_free_object_id(free_object_ids: ref mut [i32], free_object_count: i32, object_id: i32) -> i32 = do
  if free_object_count < free_object_ids.length() then
    free_object_ids.set(free_object_count, object_id)
    return free_object_count + 1
  end
  free_object_ids.push(object_id)
  free_object_count + 1
end

export fn heap_collect(heap: Heap) -> Heap = do
  let mut next = heap
  let mut root_index = 0
  while root_index < next.roots.length() do
    next = mark_value(next, next.roots[root_index])
    root_index = root_index + 1
  end
  let mut slots = next.slots
  let mut free_object_ids = next.free_object_ids
  let mut free_object_count = next.free_object_count
  let mut live_count = 0
  let mut object_id = 0
  while object_id < slots.length() do
    const slot = slots[object_id]
    if slot.live then
      if (slot.header.gc_flags & 1) != 0 then
        const cleared = ObjectHeader {
          type_id: slot.header.type_id,
          gc_flags: slot.header.gc_flags - 1,
          object_flags: slot.header.object_flags,
          shape_or_meta: slot.header.shape_or_meta
        }
        slots = slots_with(slots, object_id, HeapSlot {
          header: cleared,
          child: slot.child,
          element_start: slot.element_start,
          element_count: slot.element_count,
          size_class: slot.size_class,
          live: true
        })
        live_count = live_count + 1
      else
        slots = slots_with(slots, object_id, HeapSlot {
          header: ObjectHeader {
            type_id: 0,
            gc_flags: 0,
            object_flags: 0,
            shape_or_meta: 0
          },
          child: value_encode(ValueNil),
          element_start: slot.element_start,
          element_count: slot.element_count,
          size_class: slot.size_class,
          live: false
        })
        free_object_count = stored_free_object_id(free_object_ids, free_object_count, object_id)
      end
    end
    object_id = object_id + 1
  end
  Heap {
    slots: slots,
    element_arena: next.element_arena,
    free_object_ids: free_object_ids,
    free_object_count: free_object_count,
    roots: next.roots,
    live_count: live_count,
    write_barrier_hits: next.write_barrier_hits
  }
end
