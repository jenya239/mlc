import { Completed, PollFailed, PollResult, PollWaiting, PollYielded, PollCancelled, poll_execution } from '../execution_result'
import { executor_host_call_timer_after } from '../executor_host_call'
import { heap_new } from '../heap_types'
import { host_import_timer_after } from '../host_imports'
import { HostRequest } from '../host_request'
import { Value, ValueInt32, value_encode } from '../value'

fn fail(message: string) -> i32 = do
  println("[script_vm host_wait_unit] FAIL: " + message)
  1
end

fn timer_after_operation_id() -> string = host_import_timer_after().operation_id

fn delay_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments.push(value_encode(ValueInt32(100)))
  arguments
end

fn poll_kind(result: PollResult) -> string =
  match result {
    Completed(_) => "Completed",
    PollYielded => "Yielded",
    PollWaiting => "Waiting",
    PollCancelled => "Cancelled",
    PollFailed(code, at) => "Failed:" + code + "@" + at.to_string()
  }

fn host_call_resume_outcome(
  request: HostRequest,
  incarnation: i32,
  code_epoch: i32,
  already_resumed: bool
) -> string = do
  let mut unused = request.request_id + incarnation + code_epoch
  if already_resumed then
    unused = unused + 0
  end
  "accepted"
end

fn main() -> i32 = do
  const waited = executor_host_call_timer_after(heap_new(), 0, 2, delay_arguments())
  const polled = poll_execution(waited.execution)
  const request_operation = waited.request.operation_id
  if poll_kind(polled) != "Waiting" || request_operation != timer_after_operation_id() then
    return fail(
      "HostCall did not wait operation_id=" + timer_after_operation_id()
        + " poll=" + poll_kind(polled)
        + " request=" + request_operation
    )
  end
  if waited.destination_register != 0 || waited.resume_pc != 2 then
    return fail(
      "HostCall wait frame destination=" + waited.destination_register.to_string()
        + " resume_pc=" + waited.resume_pc.to_string()
    )
  end
  if waited.request.owned_arguments.length() != 1 then
    return fail(
      "HostCall arguments were not copied count=" + waited.request.owned_arguments.length().to_string()
    )
  end
  const duplicate = host_call_resume_outcome(
    waited.request,
    waited.request.incarnation,
    waited.request.code_epoch,
    true
  )
  if duplicate == "accepted" then
    return fail("duplicate resume accepted request_id=" + waited.request.request_id.to_string())
  end
  const stale_epoch = 0
  const late = host_call_resume_outcome(
    waited.request,
    waited.request.incarnation,
    stale_epoch,
    false
  )
  if late == "accepted" then
    return fail(
      "late resume epoch mismatch accepted incarnation=" + waited.request.incarnation.to_string()
        + " code_epoch=" + waited.request.code_epoch.to_string()
        + " shown_epoch=" + stale_epoch.to_string()
    )
  end
  println("[script_vm] host_wait_unit ok")
  0
end

