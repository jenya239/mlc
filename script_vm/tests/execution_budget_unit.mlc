import {
  execution_budget_at,
  execution_budget_cancel,
  execution_budget_charge,
  execution_budget_new,
  execution_budget_poll
} from '../execution_budget'
import { run_err_instruction_limit } from '../run_result'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_budget_unit] FAIL: " + label)
  1
end

fn i32_maximum() -> i32 = 2147483647

fn i64_from_i32(value: i32) -> i64 = value

fn limit_past_i32_maximum() -> i64 = i64_from_i32(i32_maximum()) + i64_from_i32(1)

fn million_yields() -> i32 = 1000000

fn small_total() -> i64 = i64_from_i32(100)

fn one_cost() -> i64 = i64_from_i32(1)

fn check_overflow() -> i32 = do
  let budget = execution_budget_at(limit_past_i32_maximum(), one_cost(), i64_from_i32(i32_maximum()))
  let charged = execution_budget_charge(budget, one_cost())
  if charged.limited || charged.budget.consumed != limit_past_i32_maximum() then
    return fail(
      "overflow charge consumed=" + charged.budget.consumed.to_string()
        + " limited=" + charged.error_code
    )
  end
  let blocked = execution_budget_charge(charged.budget, one_cost())
  if !blocked.limited || blocked.error_code != run_err_instruction_limit() || blocked.budget.consumed != limit_past_i32_maximum() then
    return fail(
      "overflow second charge consumed=" + blocked.budget.consumed.to_string()
        + " code=" + blocked.error_code
    )
  end
  0
end

fn check_poll_keeps_task_fuel() -> i32 = do
  let budget = execution_budget_new(i64_from_i32(5), i64_from_i32(2))
  let charged = execution_budget_charge(budget, one_cost())
  let polled = execution_budget_poll(charged.budget)
  if polled.quantum_fuel != i64_from_i32(2) || polled.task_fuel_remaining != i64_from_i32(4) || polled.consumed != one_cost() then
    return fail(
      "poll restored task fuel quantum=" + polled.quantum_fuel.to_string()
        + " task=" + polled.task_fuel_remaining.to_string()
        + " consumed=" + polled.consumed.to_string()
    )
  end
  0
end

fn check_million_yields() -> i32 = do
  let mut budget = execution_budget_new(small_total(), one_cost())
  let mut index = 0
  while index < million_yields() do
    budget = execution_budget_poll(budget)
    let charged = execution_budget_charge(budget, one_cost())
    budget = charged.budget
    index = index + 1
  end
  if budget.consumed != small_total() || budget.task_fuel_remaining != i64_from_i32(0) then
    return fail(
      "million yields bypassed total consumed=" + budget.consumed.to_string()
        + " task=" + budget.task_fuel_remaining.to_string()
    )
  end
  0
end

fn check_cancel_token() -> i32 = do
  let budget = execution_budget_cancel(execution_budget_new(small_total(), one_cost()))
  let charged = execution_budget_charge(budget, one_cost())
  if !charged.limited || charged.budget.consumed != i64_from_i32(0) || !charged.budget.cancel_requested then
    return fail(
      "cancel token consumed=" + charged.budget.consumed.to_string()
        + " code=" + charged.error_code
    )
  end
  0
end

fn main() -> i32 = do
  let mut status = check_overflow()
  if status == 0 then
    status = check_poll_keeps_task_fuel()
  end
  if status == 0 then
    status = check_million_yields()
  end
  if status == 0 then
    status = check_cancel_token()
  end
  if status != 0 then
    return status
  end
  println("[script_vm] execution_budget_unit ok")
  0
end
