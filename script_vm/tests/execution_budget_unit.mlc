import { emb_ok } from '../embedding_codes'
import { Cancelled, Finished, Yielded } from '../execution'
import {
  execution_budget_at,
  execution_budget_cancel,
  execution_budget_charge,
  execution_budget_new,
  execution_budget_poll
} from '../execution_budget'
import { SliceSession, run_slice, slice_session_new } from '../executor_slice'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { run_err_instruction_limit, run_limits_new } from '../run_result'
import { Value } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_budget_unit] FAIL: " + label)
  1
end

fn i32_maximum() -> i32 = 2147483647

fn i64_from_i32(value: i32) -> i64 = value

fn limit_past_i32_maximum() -> i64 = i64_from_i32(i32_maximum()) + i64_from_i32(1)

fn million_yields() -> i32 = 1000000

fn small_total() -> i64 = i64_from_i32(100)

fn one_cost() -> i64 = i64_from_i32(1)

fn cancel_window() -> i32 = 10

fn unlimited_limits() -> i64 = 0

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn loop_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 0\nwhile index < 1000 do\ntotal = total + 1\nindex = index + 1\nend\ntotal\nend\n"

fn slice_status_name(session: SliceSession) -> string =
  match session.execution.status {
    Cancelled => "Cancelled",
    Yielded => "Yielded",
    Finished => "Finished",
    _ => "other"
  }

fn check_cancel_during_slice() -> i32 = do
  const lowered = lower_source(loop_source())
  if lowered.diagnostics.length() != 0 then
    return fail("cancel lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() then
    return fail("cancel decode code=" + decoded.code.to_string())
  end
  let mut session = slice_session_new(
    heap_new(),
    decoded.decoded_module.protos,
    decoded.decoded_module.exports[0].proto_index,
    empty_arguments(),
    run_limits_new(unlimited_limits(), 0)
  )
  session = run_slice(session, cancel_window())
  let budget = execution_budget_cancel(execution_budget_new(small_total(), i64_from_i32(cancel_window())))
  if !budget.cancel_requested then
    return fail("cancel token was not set")
  end
  let instructions_at_cancel = session.state.instruction_count
  session = run_slice(session, cancel_window())
  let instructions_after_cancel = session.state.instruction_count - instructions_at_cancel
  match session.execution.status {
    Cancelled =>
      if instructions_after_cancel <= cancel_window() then
        0
      else
        fail(
          "cancel late instructions_after_cancel=" + instructions_after_cancel.to_string()
            + " window=" + cancel_window().to_string()
        )
      end,
    _ => fail(
      "cancel ignored inside slice status=" + slice_status_name(session)
        + " instructions_after_cancel=" + instructions_after_cancel.to_string()
        + " window=" + cancel_window().to_string()
        + " count=" + session.state.instruction_count.to_string()
    )
  }
end

fn check_overflow() -> i32 = do
  let budget = execution_budget_at(limit_past_i32_maximum(), one_cost(), i64_from_i32(i32_maximum()))
  let charged = execution_budget_charge(budget, one_cost())
  if charged.limited || charged.budget.consumed != limit_past_i32_maximum() then
    return fail(
      "overflow charge consumed=" + charged.budget.consumed.to_string()
        + " limited=" + charged.error_code
    )
  end
  let blocked = execution_budget_charge(charged.budget, one_cost())
  if !blocked.limited || blocked.error_code != run_err_instruction_limit() || blocked.budget.consumed != limit_past_i32_maximum() then
    return fail(
      "overflow second charge consumed=" + blocked.budget.consumed.to_string()
        + " code=" + blocked.error_code
    )
  end
  0
end

fn check_poll_keeps_task_fuel() -> i32 = do
  let budget = execution_budget_new(i64_from_i32(5), i64_from_i32(2))
  let charged = execution_budget_charge(budget, one_cost())
  let polled = execution_budget_poll(charged.budget)
  if polled.quantum_fuel != i64_from_i32(2) || polled.task_fuel_remaining != i64_from_i32(4) || polled.consumed != one_cost() then
    return fail(
      "poll restored task fuel quantum=" + polled.quantum_fuel.to_string()
        + " task=" + polled.task_fuel_remaining.to_string()
        + " consumed=" + polled.consumed.to_string()
    )
  end
  0
end

fn check_million_yields() -> i32 = do
  let mut budget = execution_budget_new(small_total(), one_cost())
  let mut index = 0
  while index < million_yields() do
    budget = execution_budget_poll(budget)
    let charged = execution_budget_charge(budget, one_cost())
    budget = charged.budget
    index = index + 1
  end
  if budget.consumed != small_total() || budget.task_fuel_remaining != i64_from_i32(0) then
    return fail(
      "million yields bypassed total consumed=" + budget.consumed.to_string()
        + " task=" + budget.task_fuel_remaining.to_string()
    )
  end
  0
end

fn check_cancel_token() -> i32 = do
  let budget = execution_budget_cancel(execution_budget_new(small_total(), one_cost()))
  let charged = execution_budget_charge(budget, one_cost())
  if !charged.limited || charged.budget.consumed != i64_from_i32(0) || !charged.budget.cancel_requested then
    return fail(
      "cancel token consumed=" + charged.budget.consumed.to_string()
        + " code=" + charged.error_code
    )
  end
  0
end

fn main() -> i32 = do
  let mut status = check_overflow()
  if status == 0 then
    status = check_poll_keeps_task_fuel()
  end
  if status == 0 then
    status = check_million_yields()
  end
  if status == 0 then
    status = check_cancel_token()
  end
  if status == 0 then
    status = check_cancel_during_slice()
  end
  if status != 0 then
    return status
  end
  println("[script_vm] execution_budget_unit ok")
  0
end
