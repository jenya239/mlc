import { emb_ok } from '../embedding_codes'
import { Failed, Finished, Yielded } from '../execution'
import { SliceSession, run_slice, slice_session_new } from '../executor_slice'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { run_err_instruction_limit, run_limits_new } from '../run_result'
import { Value } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_budget_unit] FAIL: " + label)
  1
end

fn i32_maximum() -> i32 = 2147483647

fn i64_from_i32(value: i32) -> i64 = value

fn limit_past_i32_maximum() -> i64 = i64_from_i32(i32_maximum()) + i64_from_i32(1)

fn slice_quantum() -> i32 = 1

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn program_source() -> string = "export fn run() -> i32 = 1\n"

fn status_text(session: SliceSession) -> string =
  match session.execution.status {
    Yielded => "Yielded",
    Finished => "Finished",
    Failed => "Failed",
    _ => "other"
  }

fn count_is_checked(session: SliceSession) -> bool = do
  let count = session.state.instruction_count
  if count < 0 || count > i32_maximum() then
    false
  else if session.execution.error_code == run_err_instruction_limit() then
    true
  else
    count == i32_maximum()
  end
end

fn main() -> i32 = do
  const lowered = lower_source(program_source())
  if lowered.diagnostics.length() != 0 then
    return fail("lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() then
    return fail("decode code=" + decoded.code.to_string())
  end
  let mut session = slice_session_new(
    heap_new(),
    decoded.decoded_module.protos,
    decoded.decoded_module.exports[0].proto_index,
    empty_arguments(),
    run_limits_new(limit_past_i32_maximum(), 0)
  )
  let mut state = session.state
  state.instruction_count = i32_maximum()
  session.state = state
  if session.state.instruction_limit <= i64_from_i32(i32_maximum()) then
    return fail("limit was not past i32 maximum limit=" + session.state.instruction_limit.to_string())
  end
  println("limit=" + session.state.instruction_limit.to_string())
  println("before_slice count=" + session.state.instruction_count.to_string())
  session = run_slice(session, slice_quantum())
  println("after_slice count=" + session.state.instruction_count.to_string())
  if count_is_checked(session) then
    println("[script_vm] execution_budget_unit ok")
    0
  else
    fail(
      "instruction_count overflowed count=" + session.state.instruction_count.to_string()
        + " status=" + status_text(session)
        + " code=" + session.execution.error_code
        + " limit=" + session.state.instruction_limit.to_string()
    )
  end
end
