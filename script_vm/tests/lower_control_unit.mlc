import { lower_source } from '../lower/lower_module'
import { LowerDiagnostic } from '../lower/lower_types'
import { Value, ValueBool, ValueInt32, value_decode, value_encode } from '../value'
import { emb_ok, emb_call_export_bytes } from '../embedding'

fn fail(label: string) -> i32 = do
  println("[script_vm lower_control_unit] FAIL: " + label)
  1
end

fn integer_raw(number: i32) -> i64 = value_encode(ValueInt32(number)).raw

fn bool_raw(flag: bool) -> i64 = value_encode(ValueBool(flag)).raw

fn two_arguments(left: i32, right: i32) -> [i64] = do
  let mut arguments: [i64] = []
  arguments.push(integer_raw(left))
  arguments.push(integer_raw(right))
  arguments
end

fn three_arguments(first: i32, second: i32, third: i32) -> [i64] = do
  let mut arguments: [i64] = []
  arguments.push(integer_raw(first))
  arguments.push(integer_raw(second))
  arguments.push(integer_raw(third))
  arguments
end

fn one_integer(number: i32) -> [i64] = do
  let mut arguments: [i64] = []
  arguments.push(integer_raw(number))
  arguments
end

fn one_bool(flag: bool) -> [i64] = do
  let mut arguments: [i64] = []
  arguments.push(bool_raw(flag))
  arguments
end

fn matches_bool(raw: i64, expected: bool) -> bool =
  match value_decode(Value { raw: raw }) {
    ValueBool(flag) => flag == expected,
    _ => false
  }

fn expect_bool(
  source: string,
  export_name: string,
  arguments: [i64],
  expected: bool,
  label: string
) -> i32 = do
  const lowered = lower_source(source)
  if lowered.diagnostics.length() != 0 then
    return fail(label)
  end
  const called = emb_call_export_bytes(lowered.bytes, export_name, arguments)
  if called.code != emb_ok() then
    return fail(label + " code=" + called.code.to_string())
  end
  if !matches_bool(called.raw, expected) then
    return fail(label + " value")
  end
  println(label)
  0
end

fn decoded_int(raw: i64) -> i32 =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn expect_int(
  source: string,
  export_name: string,
  arguments: [i64],
  expected: i32,
  label: string
) -> i32 = do
  const lowered = lower_source(source)
  if lowered.diagnostics.length() != 0 then
    return fail(label)
  end
  const called = emb_call_export_bytes(lowered.bytes, export_name, arguments)
  if called.code != emb_ok() then
    return fail(label + " code=" + called.code.to_string())
  end
  if decoded_int(called.raw) != expected then
    return fail(label + " value=" + decoded_int(called.raw).to_string())
  end
  println(label)
  0
end

fn has_positioned_code(diagnostics: [LowerDiagnostic], code: string) -> bool = do
  let mut index = 0
  let mut found = false
  while index < diagnostics.length() && !found do
    const diagnostic = diagnostics[index]
    if diagnostic.code == code && diagnostic.line > 0 && diagnostic.column > 0 then
      found = true
    end
    index = index + 1
  end
  found
end

fn has_code(diagnostics: [LowerDiagnostic], code: string) -> bool = do
  let mut index = 0
  let mut found = false
  while index < diagnostics.length() && !found do
    if diagnostics[index].code == code then
      found = true
    end
    index = index + 1
  end
  found
end

fn expect_diagnostic(source: string, code: string, require_position: bool, label: string) -> i32 = do
  const lowered = lower_source(source)
  const found = if require_position then
    has_positioned_code(lowered.diagnostics, code)
  else
    has_code(lowered.diagnostics, code)
  end
  if !found then
    return fail(label)
  end
  println(label)
  0
end

fn expect_compare(operator: string, left: i32, right: i32, expected: bool, label: string) -> i32 =
  expect_bool(
    "export fn compare(a: i32, b: i32) -> bool = a " + operator + " b",
    "compare",
    two_arguments(left, right),
    expected,
    label
  )

fn maximum_int() -> i32 = 2147483647

fn check_less() -> i32 = do
  let mut status = expect_compare("<", 0 - 1, 0, true, "less_negative_zero")
  if status == 0 then
    status = expect_compare("<", 0, 0, false, "less_zero_zero")
  end
  if status == 0 then
    status = expect_compare("<", 1, maximum_int(), true, "less_one_maximum")
  end
  if status == 0 then
    status = expect_compare("<", maximum_int(), 1, false, "less_maximum_one")
  end
  status
end

fn check_less_equal() -> i32 = do
  let mut status = expect_compare("<=", 0, 0, true, "less_equal_zero_zero")
  if status == 0 then
    status = expect_compare("<=", 0 - 1, 0, true, "less_equal_negative_zero")
  end
  if status == 0 then
    status = expect_compare("<=", 1, maximum_int(), true, "less_equal_one_maximum")
  end
  if status == 0 then
    status = expect_compare("<=", maximum_int(), 0, false, "less_equal_maximum_zero")
  end
  status
end

fn check_greater() -> i32 = do
  let mut status = expect_compare(">", 0, 0 - 1, true, "greater_zero_negative")
  if status == 0 then
    status = expect_compare(">", 0, 0, false, "greater_zero_zero")
  end
  if status == 0 then
    status = expect_compare(">", maximum_int(), 1, true, "greater_maximum_one")
  end
  if status == 0 then
    status = expect_compare(">", 1, maximum_int(), false, "greater_one_maximum")
  end
  status
end

fn check_greater_equal() -> i32 = do
  let mut status = expect_compare(">=", 0, 0, true, "greater_equal_zero_zero")
  if status == 0 then
    status = expect_compare(">=", 0 - 1, 0, false, "greater_equal_negative_zero")
  end
  if status == 0 then
    status = expect_compare(">=", maximum_int(), maximum_int(), true, "greater_equal_maximum_maximum")
  end
  if status == 0 then
    status = expect_compare(">=", 1, maximum_int(), false, "greater_equal_one_maximum")
  end
  status
end

fn check_equal() -> i32 = do
  let mut status = expect_compare("==", 0, 0, true, "equal_zero_zero")
  if status == 0 then
    status = expect_compare("==", 0 - 1, 0 - 1, true, "equal_negative_negative")
  end
  if status == 0 then
    status = expect_compare("==", 1, maximum_int(), false, "equal_one_maximum")
  end
  if status == 0 then
    status = expect_compare("==", maximum_int(), maximum_int(), true, "equal_maximum_maximum")
  end
  status
end

fn check_not_equal() -> i32 = do
  let mut status = expect_compare("!=", 0, 0, false, "not_equal_zero_zero")
  if status == 0 then
    status = expect_compare("!=", 0 - 1, 0, true, "not_equal_negative_zero")
  end
  if status == 0 then
    status = expect_compare("!=", maximum_int(), maximum_int(), false, "not_equal_maximum_maximum")
  end
  if status == 0 then
    status = expect_compare("!=", 1, maximum_int(), true, "not_equal_one_maximum")
  end
  status
end

fn maximum_source() -> string =
  "export fn maximum(left: i32, right: i32) -> i32 = if left > right then left else right end"

fn expect_maximum(left: i32, right: i32, expected: i32, label: string) -> i32 =
  expect_int(maximum_source(), "maximum", two_arguments(left, right), expected, label)

fn check_maximum() -> i32 = do
  let mut status = expect_maximum(1, 0, 1, "maximum_one_zero")
  if status == 0 then
    status = expect_maximum(0 - 1, maximum_int(), maximum_int(), "maximum_negative_maximum")
  end
  if status == 0 then
    status = expect_maximum(maximum_int(), 0, maximum_int(), "maximum_maximum_zero")
  end
  if status == 0 then
    status = expect_maximum(0, 0, 0, "maximum_zero_zero")
  end
  status
end

fn clamp_source() -> string =
  "export fn clamp(value: i32, low: i32, high: i32) -> i32 = if value < low then low else if value > high then high else value end"

fn expect_clamp(value: i32, low: i32, high: i32, expected: i32, label: string) -> i32 =
  expect_int(clamp_source(), "clamp", three_arguments(value, low, high), expected, label)

fn check_clamp() -> i32 = do
  let mut status = expect_clamp(1, 0, maximum_int(), 1, "clamp_inside")
  if status == 0 then
    status = expect_clamp(0 - 1, 0, 1, 0, "clamp_below")
  end
  if status == 0 then
    status = expect_clamp(maximum_int(), 0, 1, 1, "clamp_above")
  end
  if status == 0 then
    status = expect_clamp(0, 0 - 1, 0, 0, "clamp_high_zero")
  end
  status
end

fn offset_source() -> string =
  "export fn offset(value: i32) -> i32 = 1 + if value > 0 then 2 else 3 end"

fn check_if_operand() -> i32 = do
  let mut status = expect_int(offset_source(), "offset", one_integer(1), 3, "if_operand_positive")
  if status == 0 then
    status = expect_int(offset_source(), "offset", one_integer(0), 4, "if_operand_zero")
  end
  if status == 0 then
    status = expect_int(offset_source(), "offset", one_integer(0 - 1), 4, "if_operand_negative")
  end
  status
end

fn chosen_source() -> string =
  "export fn chosen(value: i32) -> i32 = do const chosen = if value > 0 then value else 0 end chosen end"

fn check_if_const() -> i32 = do
  let mut status = expect_int(chosen_source(), "chosen", one_integer(1), 1, "if_const_positive")
  if status == 0 then
    status = expect_int(chosen_source(), "chosen", one_integer(0), 0, "if_const_zero")
  end
  if status == 0 then
    status = expect_int(chosen_source(), "chosen", one_integer(maximum_int()), maximum_int(), "if_const_maximum")
  end
  status
end

fn check_diagnostics() -> i32 = do
  let mut status = expect_diagnostic(
    "export fn same(left: bool, right: bool) -> bool = left == right",
    "bool_equality_unsupported",
    false,
    "bool_equality_unsupported"
  )
  if status == 0 then
    status = expect_diagnostic(
      "export fn from_int(value: i32) -> i32 = if value then 1 else 0 end",
      "type_mismatch",
      true,
      "condition_type_mismatch"
    )
  end
  if status == 0 then
    status = expect_diagnostic(
      "export fn mixed(flag: bool) -> i32 = if flag then 1 else false end",
      "type_mismatch",
      true,
      "branch_type_mismatch"
    )
  end
  status
end

fn choose_source() -> string =
  "export fn choose(flag: bool) -> bool = if flag then true else false end"

fn check_bool_branches() -> i32 = do
  let mut status = expect_bool(choose_source(), "choose", one_bool(true), true, "bool_branch_true")
  if status == 0 then
    status = expect_bool(choose_source(), "choose", one_bool(false), false, "bool_branch_false")
  end
  status
end

fn main() -> i32 = do
  let mut status = check_less()
  if status == 0 then
    status = check_less_equal()
  end
  if status == 0 then
    status = check_greater()
  end
  if status == 0 then
    status = check_greater_equal()
  end
  if status == 0 then
    status = check_equal()
  end
  if status == 0 then
    status = check_not_equal()
  end
  if status == 0 then
    status = check_maximum()
  end
  if status == 0 then
    status = check_clamp()
  end
  if status == 0 then
    status = check_if_operand()
  end
  if status == 0 then
    status = check_if_const()
  end
  if status == 0 then
    status = check_diagnostics()
  end
  if status == 0 then
    status = check_bool_branches()
  end
  if status != 0 then
    return status
  end
  println("lower_control checks=43")
  println("[script_vm] lower_control_unit ok")
  0
end
