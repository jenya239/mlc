import { lower_source } from '../lower/lower_module'
import { LowerDiagnostic } from '../lower/lower_types'
import { emb_call_export_bytes } from '../embedding'

fn report_failure(label: string) -> i32 = do
  println("[script_vm lower_method_unknown_reject_unit] FAIL: " + label)
  1
end

fn diagnostic_text(diagnostic: LowerDiagnostic) -> string =
  "code=" + diagnostic.code + " line=" + diagnostic.line.to_string() + " column=" + diagnostic.column.to_string()

fn diagnostic_codes(diagnostics: [LowerDiagnostic]) -> string = do
  let mut text = ""
  let mut index = 0
  while index < diagnostics.length() do
    if index > 0 then
      text = text + ","
    end
    text = text + diagnostic_text(diagnostics[index])
    index = index + 1
  end
  text
end

fn empty_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn method_source() -> string =
  "type Point = { x: i32 }\nextend Point {\nfn get_x(self) -> i32 = self.x\n}\nexport fn main() -> i32 = do\nlet point = Point { x: 1 }\npoint.unknown_method()\nend"

fn expect_unknown_method() -> i32 = do
  const lowered = lower_source(method_source())
  if lowered.diagnostics.length() == 0 then
    const called = emb_call_export_bytes(lowered.bytes, "main", empty_arguments())
    return report_failure("no_diagnostic code=" + called.code.to_string() + " bytes=" + lowered.bytes.length().to_string())
  end
  const diagnostic = lowered.diagnostics[0]
  if diagnostic.code != "unknown_method" then
    return report_failure(diagnostic_text(diagnostic) + " bytes=" + lowered.bytes.length().to_string())
  end
  if diagnostic.line <= 0 || diagnostic.column <= 0 then
    return report_failure(diagnostic_text(diagnostic))
  end
  if lowered.bytes.length() != 0 then
    return report_failure("bytes=" + lowered.bytes.length().to_string() + " " + diagnostic_codes(lowered.diagnostics))
  end
  println(diagnostic_text(diagnostic))
  println("method_unknown_reject")
  0
end

fn main() -> i32 = do
  if expect_unknown_method() != 0 then
    return 1
  end
  println("[script_vm] lower_method_unknown_reject_unit ok")
  0
end
