import { lower_source } from '../lower/lower_module'
import { LowerDiagnostic } from '../lower/lower_types'
import { Value, ValueInt32, value_decode } from '../value'
import { emb_ok, emb_call_export_bytes } from '../embedding'

fn report_failure(label: string) -> i32 = do
  println("[script_vm lower_match_in_loop_unit] FAIL: " + label)
  1
end

fn no_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn decoded_integer(raw: i64) -> i32 =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn diagnostic_codes(diagnostics: [LowerDiagnostic]) -> string = do
  let mut text = ""
  let mut index = 0
  while index < diagnostics.length() do
    if index > 0 then
      text = text + ","
    end
    text = text + diagnostics[index].code + "@" + diagnostics[index].line.to_string() + ":" + diagnostics[index].column.to_string()
    index = index + 1
  end
  text
end

fn break_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 1\nwhile index <= 10 do\nmatch index do\n3 -> do break end\n_ -> 0\nend\ntotal = total + index\nindex = index + 1\nend\ntotal\nend"

fn continue_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 0\nwhile index < 4 do\nindex = index + 1\nmatch index do\n2 -> do continue end\n4 -> do continue end\n_ -> 0\nend\ntotal = total + index\nend\ntotal\nend"

fn expect_loop(source: string, expected: i32, label: string) -> i32 = do
  const lowered = lower_source(source)
  if lowered.diagnostics.length() != 0 then
    return report_failure(label + " diagnostics=" + diagnostic_codes(lowered.diagnostics))
  end
  const called = emb_call_export_bytes(lowered.bytes, "run", no_arguments())
  if called.code != emb_ok() then
    return report_failure(label + " code=" + called.code.to_string())
  end
  if decoded_integer(called.raw) != expected then
    return report_failure(label + " value=" + decoded_integer(called.raw).to_string())
  end
  println(label)
  0
end

fn main() -> i32 = do
  let mut failure_count = 0
  failure_count = failure_count + expect_loop(break_source(), 3, "match_break_in_while")
  failure_count = failure_count + expect_loop(continue_source(), 4, "match_continue_in_while")
  if failure_count != 0 then
    return 1
  end
  println("[script_vm] lower_match_in_loop_unit ok")
  0
end
