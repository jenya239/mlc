import { Value } from '../value'
import {
  heap_new,
  heap_live_object_count,
  heap_in_place_alloc_cell,
  heap_in_place_root_push,
  heap_in_place_collect
} from '../heap'

fn fail(message: string) -> i32 = do
  println("[script_vm gc_slice_unit] FAIL: " + message)
  1
end

fn empty_values() -> [Value] = do
  let mut values: [Value] = []
  values
end

fn object_count() -> i32 = 32

fn rooted_count() -> i32 = 1

fn requested_work_budget() -> i32 = 1

fn main() -> i32 = do
  let mut heap = heap_new()
  let mut index = 0
  while index < object_count() do
    let cell = heap_in_place_alloc_cell(heap)
    if index == 0 then
      heap_in_place_root_push(heap, cell)
    end
    index = index + 1
  end
  let live_before = heap_live_object_count(heap)
  heap_in_place_collect(heap, empty_values())
  let live_after = heap_live_object_count(heap)
  if live_before == object_count() && live_after == rooted_count() then
    return fail(
      "full collect finished without Partial live_before=" + live_before.to_string()
        + " live_after=" + live_after.to_string()
        + " rooted=" + rooted_count().to_string()
        + " work_budget=" + requested_work_budget().to_string()
    )
  end
  println("[script_vm] gc_slice_unit ok")
  0
end
