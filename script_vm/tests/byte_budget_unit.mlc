import { Value, ValueHeapRef, value_byte_size, value_decode } from '../value'
import { heap_alloc_array_within_byte_limit } from '../heap_alloc'
import { Heap, heap_arena_cell_count, heap_element_count, heap_live_object_count, heap_new } from '../heap'

fn fail(label: string) -> i32 = do
  println("[script_vm byte_budget_unit] FAIL: " + label)
  1
end

fn million_elements() -> i32 = 1000000

fn small_byte_limit() -> i32 = 64

fn one_element() -> i32 = 1

fn is_heap_ref(value: Value) -> bool =
  match value_decode(value) {
    ValueHeapRef(_object_id) => true,
    _ => false
  }

fn reserved_length(heap: Heap, heap_value: Value) -> i32 = do
  if is_heap_ref(heap_value) then
    heap_element_count(heap, heap_value)
  else
    0
  end
end

fn check_million_array() -> i32 = do
  const allocated = heap_alloc_array_within_byte_limit(heap_new(), million_elements(), small_byte_limit())
  let byte_cost = million_elements() * value_byte_size()
  if !is_heap_ref(allocated.value) && heap_live_object_count(allocated.heap) == 0 && heap_arena_cell_count(allocated.heap) == 0 && byte_cost > small_byte_limit() then
    0
  else
    fail(
      "million array bypassed byte limit length=" + reserved_length(allocated.heap, allocated.value).to_string()
        + " live=" + heap_live_object_count(allocated.heap).to_string()
        + " arena=" + heap_arena_cell_count(allocated.heap).to_string()
        + " bytes=" + byte_cost.to_string()
        + " limit=" + small_byte_limit().to_string()
    )
  end
end

fn check_small_array_fits() -> i32 = do
  const allocated = heap_alloc_array_within_byte_limit(heap_new(), one_element(), small_byte_limit())
  if is_heap_ref(allocated.value) && heap_element_count(allocated.heap, allocated.value) == one_element() then
    0
  else
    fail(
      "small array refused live=" + heap_live_object_count(allocated.heap).to_string()
        + " bytes=" + value_byte_size().to_string()
        + " limit=" + small_byte_limit().to_string()
    )
  end
end

fn main() -> i32 = do
  let mut status = check_million_array()
  if status == 0 then
    status = check_small_array_fits()
  end
  if status != 0 then
    return status
  end
  println("[script_vm] byte_budget_unit ok")
  0
end
