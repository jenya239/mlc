import { lower_source } from '../lower/lower_module'
import { LowerDiagnostic } from '../lower/lower_types'
import { Value, ValueInt32, value_decode } from '../value'
import { emb_ok, emb_call_export_bytes } from '../embedding'

fn report_failure(label: string) -> i32 = do
  println("[script_vm lower_lambda_critic_unit] FAIL: " + label)
  1
end

fn diagnostic_codes(diagnostics: [LowerDiagnostic]) -> string = do
  let mut text = ""
  let mut index = 0
  while index < diagnostics.length() do
    if index > 0 then
      text = text + ","
    end
    text = text + diagnostics[index].code + "@" + diagnostics[index].line.to_string() + ":" + diagnostics[index].column.to_string()
    index = index + 1
  end
  text
end

fn decoded_integer(raw: i64) -> i32 =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn empty_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn repeat_source() -> string =
  "export fn main() -> i32 = do\nlet add_one = (value: i32) => value + 1\nlet first = add_one(1)\nlet second = add_one(2)\nlet third = add_one(3)\nfirst + second + third\nend"

fn match_arm_source() -> string =
  "export fn main() -> i32 = do\nlet scrutinee = 1\nlet chosen = match scrutinee do\n1 -> (value: i32) => value + 4\n_ -> (value: i32) => 0\nend\nchosen(3)\nend"

fn field_source() -> string =
  "type Box = { action: i32 }\nexport fn main() -> i32 = do\nlet box = Box { action: ((value: i32) => value + 1)(4) }\nbox.action\nend"

fn refusal_matches(diagnostics: [LowerDiagnostic], expected_code: string) -> bool =
  diagnostics.length() > 0 && diagnostics[0].code == expected_code

fn expect_refusal(source: string, expected_code: string, label: string) -> i32 = do
  const lowered = lower_source(source)
  if refusal_matches(lowered.diagnostics, expected_code) then
    do
      println(label)
      0
    end
  else if lowered.diagnostics.length() != 0 then
    report_failure(label + " diagnostics=" + diagnostic_codes(lowered.diagnostics))
  else
    report_failure(label + " executed bytes=" + lowered.bytes.length().to_string())
  end
end

fn expect_result(source: string, expected: i32, label: string) -> i32 = do
  const lowered = lower_source(source)
  if lowered.diagnostics.length() != 0 then
    return report_failure(label + " diagnostics=" + diagnostic_codes(lowered.diagnostics) + " bytes=" + lowered.bytes.length().to_string())
  end
  const called = emb_call_export_bytes(lowered.bytes, "main", empty_arguments())
  if called.code != emb_ok() then
    return report_failure(label + " code=" + called.code.to_string())
  end
  if decoded_integer(called.raw) != expected then
    return report_failure(label + " value=" + decoded_integer(called.raw).to_string())
  end
  println(label)
  0
end

fn main() -> i32 = do
  let mut failure_count = 0
  failure_count = failure_count + expect_result(repeat_source(), 9, "lambda_repeat_call")
  failure_count = failure_count + expect_refusal(match_arm_source(), "unsupported_expression", "lambda_match_arm")
  failure_count = failure_count + expect_result(field_source(), 5, "lambda_record_field")
  if failure_count != 0 then
    return 1
  end
  println("[script_vm] lower_lambda_critic_unit ok")
  0
end
