import {
  ModuleExport,
  decode_module,
  module_encode
} from '../module_blob'
import { FunctionProto } from '../run_result'
import { emb_ok } from '../embedding_codes'
import { VerifyOk, VerifyErr, VerifyResult } from '../verifier'
import { verify_module, verify_module_imports, verify_err_import } from '../module_verify'
import {
  ImportDeclaration,
  ImportEffectAsyncRead,
  host_import_timer_after
} from '../host_imports'

fn fail(message: string) -> i32 = do
  println("[script_vm module_import_unit] FAIL: " + message)
  1
end

fn timer_after_operation_id() -> string = "timer.after"

fn empty_module_bytes() -> [i32] = do
  let mut exports: [ModuleExport] = []
  let mut prototypes: [FunctionProto] = []
  module_encode(exports, prototypes)
end

fn one_import(declaration: ImportDeclaration) -> [ImportDeclaration] = do
  let mut imports: [ImportDeclaration] = []
  imports.push(declaration)
  imports
end

fn verify_error_code(result: VerifyResult) -> string =
  match result {
    VerifyErr(code, _word_index) => code,
    VerifyOk => ""
  }

fn unknown_import() -> ImportDeclaration =
  ImportDeclaration {
    operation_id: "call_native",
    major_version: 1,
    argument_schema: "i32",
    result_schema: "unit",
    effect_class: ImportEffectAsyncRead
  }

fn version_mismatch_import() -> ImportDeclaration =
  ImportDeclaration {
    operation_id: timer_after_operation_id(),
    major_version: 2,
    argument_schema: "i32",
    result_schema: "unit",
    effect_class: ImportEffectAsyncRead
  }

fn main() -> i32 = do
  const decoded = decode_module(empty_module_bytes())
  const accepted = host_import_timer_after()
  const import_verified = verify_module_imports(one_import(accepted))
  let mut import_count = 0
  if verify_error_code(import_verified) == "" then
    import_count = 1
  end
  if decoded.code != emb_ok() || import_count != 1 then
    return fail(
      "import declaration missing operation_id=" + timer_after_operation_id()
        + " decode_code=" + decoded.code.to_string()
        + " import_count=" + import_count.to_string()
    )
  end
  const module_verified = verify_module(decoded.decoded_module.protos)
  if verify_error_code(module_verified) != "" then
    return fail(
      "verify rejected import operation_id=" + timer_after_operation_id()
        + " code=" + verify_error_code(module_verified)
    )
  end
  const unknown_verified = verify_module_imports(one_import(unknown_import()))
  if verify_error_code(unknown_verified) != verify_err_import() then
    return fail(
      "unknown operation_id accepted code=" + verify_error_code(unknown_verified)
    )
  end
  const mismatch_verified = verify_module_imports(one_import(version_mismatch_import()))
  if verify_error_code(mismatch_verified) != verify_err_import() then
    return fail(
      "version mismatch accepted operation_id=" + timer_after_operation_id()
        + " code=" + verify_error_code(mismatch_verified)
    )
  end
  println("[script_vm] module_import_unit ok")
  0
end
