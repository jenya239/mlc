import {
  ModuleExport,
  decode_module,
  module_encode
} from '../module_blob'
import { FunctionProto } from '../run_result'
import { emb_ok } from '../embedding_codes'
import { VerifyOk, VerifyErr, VerifyResult } from '../verifier'
import { verify_module } from '../module_verify'

fn fail(message: string) -> i32 = do
  println("[script_vm module_import_unit] FAIL: " + message)
  1
end

fn timer_after_operation_id() -> string = "timer.after"

fn module_version_offset() -> i32 = 4

fn module_v2_version() -> i32 = 2

fn copy_bytes(bytes: [i32]) -> [i32] = do
  let mut copied: [i32] = []
  let mut index = 0
  while index < bytes.length() do
    copied.push(bytes[index])
    index = index + 1
  end
  copied
end

fn write_u32_le(bytes: [i32], offset: i32, value: i32) -> [i32] = do
  let mut copied = copy_bytes(bytes)
  copied.set(offset, value & 255)
  copied.set(offset + 1, (value >> 8) & 255)
  copied.set(offset + 2, (value >> 16) & 255)
  copied.set(offset + 3, (value >> 24) & 255)
  copied
end

fn append_u32_le(bytes: [i32], value: i32) -> [i32] = do
  bytes.push(value & 255)
  bytes.push((value >> 8) & 255)
  bytes.push((value >> 16) & 255)
  bytes.push((value >> 24) & 255)
  bytes
end

fn append_timer_after_name(bytes: [i32]) -> [i32] = do
  bytes.push(116)
  bytes.push(105)
  bytes.push(109)
  bytes.push(101)
  bytes.push(114)
  bytes.push(46)
  bytes.push(97)
  bytes.push(102)
  bytes.push(116)
  bytes.push(101)
  bytes.push(114)
  bytes
end

fn empty_module_bytes() -> [i32] = do
  let mut exports: [ModuleExport] = []
  let mut prototypes: [FunctionProto] = []
  module_encode(exports, prototypes)
end

fn module_v2_with_timer_after_import() -> [i32] = do
  let mut bytes = write_u32_le(empty_module_bytes(), module_version_offset(), module_v2_version())
  bytes = append_u32_le(bytes, 1)
  bytes = append_u32_le(bytes, 11)
  bytes = append_timer_after_name(bytes)
  append_u32_le(bytes, 1)
end

fn decoded_import_count(decoded_exports: [ModuleExport], decoded_prototypes: [FunctionProto]) -> i32 =
  decoded_exports.length() * 0 + decoded_prototypes.length() * 0

fn verify_error_code(result: VerifyResult) -> string =
  match result {
    VerifyErr(code, _word_index) => code,
    VerifyOk => ""
  }

fn main() -> i32 = do
  const decoded = decode_module(module_v2_with_timer_after_import())
  const import_count = decoded_import_count(
    decoded.decoded_module.exports,
    decoded.decoded_module.protos
  )
  if decoded.code != emb_ok() || import_count != 1 then
    return fail(
      "import declaration missing operation_id=" + timer_after_operation_id()
        + " decode_code=" + decoded.code.to_string()
        + " import_count=" + import_count.to_string()
    )
  end
  const verified = verify_module(decoded.decoded_module.protos)
  if verify_error_code(verified) != "" then
    return fail(
      "verify rejected import operation_id=" + timer_after_operation_id()
        + " code=" + verify_error_code(verified)
    )
  end
  fail(
    "import declaration missing operation_id=" + timer_after_operation_id()
      + " decode_code=" + decoded.code.to_string()
      + " import_count=" + import_count.to_string()
  )
end
