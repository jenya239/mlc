import { ModuleExport, decode_module, decode_module_with_limits, module_encode } from '../module_blob'
import { FunctionProto } from '../run_result'
import { emb_format, emb_ok } from '../embedding_codes'
import { ModuleLimits, default_module_limits } from '../module_limits'
import { Value } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm module_budget_unit] FAIL: " + label)
  1
end

fn copy_bytes(bytes: [i32]) -> [i32] = do
  let mut copied: [i32] = []
  let mut index = 0
  while index < bytes.length() do
    copied.push(bytes[index])
    index = index + 1
  end
  copied
end

fn append_u32_le(bytes: [i32], value: i32) -> [i32] = do
  bytes.push(value & 255)
  bytes.push((value >> 8) & 255)
  bytes.push((value >> 16) & 255)
  bytes.push((value >> 24) & 255)
  bytes
end

fn write_u32_le(bytes: [i32], offset: i32, value: i32) -> [i32] = do
  let mut copied = copy_bytes(bytes)
  copied.set(offset, value & 255)
  copied.set(offset + 1, (value >> 8) & 255)
  copied.set(offset + 2, (value >> 16) & 255)
  copied.set(offset + 3, (value >> 24) & 255)
  copied
end

fn empty_module_bytes() -> [i32] = do
  let mut exports: [ModuleExport] = []
  let mut protos: [FunctionProto] = []
  module_encode(exports, protos)
end

fn negative_export_count_bytes() -> [i32] =
  write_u32_le(empty_module_bytes(), 8, 0 - 1)

fn overflowing_word_count() -> i32 = 536870912

fn overflowing_word_count_bytes() -> [i32] = do
  let mut bytes = write_u32_le(empty_module_bytes(), 12, 1)
  bytes = append_u32_le(bytes, 0)
  append_u32_le(bytes, overflowing_word_count())
end

fn limits_with_blob_bytes(byte_limit: i32) -> ModuleLimits = do
  const limits = default_module_limits()
  ModuleLimits {
    maximum_blob_bytes: byte_limit,
    maximum_exports: limits.maximum_exports,
    maximum_protos: limits.maximum_protos,
    maximum_words: limits.maximum_words,
    maximum_constants: limits.maximum_constants,
    maximum_name_bytes: limits.maximum_name_bytes,
    maximum_verification_work: limits.maximum_verification_work
  }
end

fn drop_last_byte(bytes: [i32]) -> [i32] = do
  let mut copied: [i32] = []
  let mut index = 0
  while index < bytes.length() - 1 do
    copied.push(bytes[index])
    index = index + 1
  end
  copied
end

fn repeated_name(length: i32) -> string = do
  let mut name = ""
  let mut index = 0
  while index < length do
    name = name + "a"
    index = index + 1
  end
  name
end

fn one_export_bytes(name: string) -> [i32] = do
  let mut words: [i32] = []
  let mut constants: [Value] = []
  let mut protos: [FunctionProto] = []
  protos.push(FunctionProto { words: words, constants: constants, register_count: 0 })
  let mut exports: [ModuleExport] = []
  exports.push(ModuleExport { name: name, proto_index: 0 })
  module_encode(exports, protos)
end

fn truncated_module_bytes() -> [i32] = drop_last_byte(one_export_bytes("run"))

fn huge_name_bytes() -> [i32] =
  one_export_bytes(repeated_name(default_module_limits().maximum_name_bytes + 1))

fn duplicate_export_bytes() -> [i32] = do
  let mut words: [i32] = []
  let mut constants: [Value] = []
  let mut protos: [FunctionProto] = []
  protos.push(FunctionProto { words: words, constants: constants, register_count: 0 })
  let mut exports: [ModuleExport] = []
  exports.push(ModuleExport { name: "same", proto_index: 0 })
  exports.push(ModuleExport { name: "same", proto_index: 0 })
  module_encode(exports, protos)
end

fn main() -> i32 = do
  let mut failed = false
  const negative = decode_module(negative_export_count_bytes())
  if negative.code == emb_format() then
    println("negative_export_count")
  else
    println("[script_vm module_budget_unit] FAIL: negative_export_count code=" + negative.code.to_string() + " exports=" + negative.decoded_module.exports.length().to_string())
    failed = true
  end
  println("word_count_overflow probe word_count=" + overflowing_word_count().to_string())
  const overflow = decode_module(overflowing_word_count_bytes())
  if overflow.code == emb_format() then
    println("word_count_overflow")
  else
    println("[script_vm module_budget_unit] FAIL: word_count_overflow code=" + overflow.code.to_string())
    failed = true
  end
  const empty_bytes = empty_module_bytes()
  const within_default = decode_module_with_limits(empty_bytes, default_module_limits())
  if within_default.code == emb_ok() then
    println("blob_within_default_limit")
  else
    println("[script_vm module_budget_unit] FAIL: blob_within_default_limit code=" + within_default.code.to_string())
    failed = true
  end
  const exact = decode_module_with_limits(empty_bytes, limits_with_blob_bytes(empty_bytes.length()))
  if exact.code == emb_ok() then
    println("blob_at_maximum_blob_bytes")
  else
    println("[script_vm module_budget_unit] FAIL: blob_at_maximum_blob_bytes code=" + exact.code.to_string())
    failed = true
  end
  const over_limit = decode_module_with_limits(empty_bytes, limits_with_blob_bytes(empty_bytes.length() - 1))
  if over_limit.code == emb_format() then
    println("blob_over_maximum_blob_bytes")
  else
    println("[script_vm module_budget_unit] FAIL: blob_over_maximum_blob_bytes code=" + over_limit.code.to_string())
    failed = true
  end
  const duplicate = decode_module(duplicate_export_bytes())
  if duplicate.code == emb_format() then
    println("duplicate_export")
  else
    println("[script_vm module_budget_unit] FAIL: duplicate export accepted code=" + duplicate.code.to_string() + " count=" + duplicate.decoded_module.exports.length().to_string() + " name=" + duplicate.decoded_module.exports[0].name)
    failed = true
  end
  const truncated = decode_module(truncated_module_bytes())
  if truncated.code == emb_format() then
    println("truncated_blob")
  else
    println("[script_vm module_budget_unit] FAIL: truncated blob accepted code=" + truncated.code.to_string() + " bytes=" + truncated_module_bytes().length().to_string())
    failed = true
  end
  const name_limit = default_module_limits().maximum_name_bytes
  const huge = decode_module(huge_name_bytes())
  if huge.code == emb_format() then
    println("huge_name")
  else
    println("[script_vm module_budget_unit] FAIL: huge name accepted code=" + huge.code.to_string() + " name_bytes=" + huge.decoded_module.exports[0].name.byte_size().to_string() + " limit=" + name_limit.to_string())
    failed = true
  end
  if failed then
    1
  else
    println("[script_vm] module_budget_unit ok")
    0
  end
end
