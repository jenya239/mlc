import { Instruction, instruction_decode, instruction_opcode_call, instruction_word_span } from '../bytecode'
import { float_add_opcode } from '../exec_float'
import { LowerDiagnostic } from '../lower/lower_types'
import { lower_source } from '../lower/lower_module'
import { DecodedModule, decode_module } from '../module_blob'
import { emb_ok } from '../embedding_codes'

fn fail(message: string) -> i32 = do
  println("[script_vm host_call_opcode_unit] FAIL: " + message)
  1
end

fn timer_after_operation_id() -> string = "timer.after"

fn instruction_opcode_host_call() -> i32 = 38

fn timer_after_source() -> string =
  "export fn run() -> i32 = timer_after(100)\n"

fn diagnostic_codes(diagnostics: [LowerDiagnostic]) -> string = do
  let mut text = ""
  let mut index = 0
  while index < diagnostics.length() do
    if index > 0 then
      text = text + ","
    end
    text = text + diagnostics[index].code
    index = index + 1
  end
  text
end

fn words_host_call_count(words: [i32], opcode: i32) -> i32 = do
  let mut index = 0
  let mut count = 0
  while index < words.length() do
    let decoded = instruction_decode(Instruction { word: words[index] })
    let span = instruction_word_span(words, index)
    if decoded.opcode == opcode then
      count = count + 1
    end
    if span > 0 then
      index = index + span
    else
      index = index + 1
    end
  end
  count
end

fn module_host_call_count(decoded_module: DecodedModule, opcode: i32) -> i32 = do
  let mut proto_index = 0
  let mut count = 0
  while proto_index < decoded_module.protos.length() do
    count = count + words_host_call_count(decoded_module.protos[proto_index].words, opcode)
    proto_index = proto_index + 1
  end
  count
end

fn main() -> i32 = do
  if instruction_opcode_host_call() == instruction_opcode_call() then
    return fail(
      "HostCall reused opcode=" + instruction_opcode_host_call().to_string()
        + " call=" + instruction_opcode_call().to_string()
    )
  end
  if instruction_opcode_host_call() == float_add_opcode() then
    return fail(
      "HostCall reused opcode=" + instruction_opcode_host_call().to_string()
        + " float_add=" + float_add_opcode().to_string()
    )
  end
  const lowered = lower_source(timer_after_source())
  let mut host_call_count = 0
  if lowered.diagnostics.length() == 0 && lowered.bytes.length() != 0 then
    const decoded = decode_module(lowered.bytes)
    if decoded.code == emb_ok() then
      host_call_count = module_host_call_count(decoded.decoded_module, instruction_opcode_host_call())
    end
  end
  if host_call_count != 1 then
    return fail(
      "HostCall missing operation_id=" + timer_after_operation_id()
        + " diagnostics=" + diagnostic_codes(lowered.diagnostics)
        + " host_call_count=" + host_call_count.to_string()
    )
  end
  println("[script_vm] host_call_opcode_unit ok")
  0
end
