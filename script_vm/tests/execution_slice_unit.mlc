import { emb_ok } from '../embedding_codes'
import { Finished, Yielded } from '../execution'
import { run_execution } from '../executor'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { run_limits_new } from '../run_result'
import { Value, ValueInt32, value_decode } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_slice_unit] FAIL: " + label)
  1
end

fn slice_quantum() -> i32 = 10

fn loop_iterations() -> i32 = 1000

fn unlimited_limits() -> i64 = 0

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn integer_result(value: Value) -> i32 =
  match value_decode(value) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn program_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 0\nwhile index < 1000 do\ntotal = total + 1\nindex = index + 1\nend\ntotal\nend\n"

fn main() -> i32 = do
  const lowered = lower_source(program_source())
  if lowered.diagnostics.length() != 0 then
    return fail("lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() then
    return fail("decode code=" + decoded.code.to_string())
  end
  const execution = run_execution(
    heap_new(),
    decoded.decoded_module.protos,
    decoded.decoded_module.exports[0].proto_index,
    empty_arguments(),
    run_limits_new(unlimited_limits(), 0)
  )
  const observed = integer_result(execution.value)
  match execution.status {
    Yielded => fail(
      "yielded before resume quantum=" + slice_quantum().to_string()
        + " iterations=" + loop_iterations().to_string()
        + " value=" + observed.to_string()
    ),
    Finished => fail(
      "first slice was not Yielded quantum=" + slice_quantum().to_string()
        + " status=Finished value=" + observed.to_string()
    ),
    _ => fail(
      "first slice was not Yielded quantum=" + slice_quantum().to_string()
        + " value=" + observed.to_string()
    )
  }
end
