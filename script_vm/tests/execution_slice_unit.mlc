import { emb_ok } from '../embedding_codes'
import { Finished, Yielded } from '../execution'
import { run_execution } from '../executor'
import { SliceSession, run_slice, slice_session_new } from '../executor_slice'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { run_limits_new } from '../run_result'
import { Value, ValueInt32, value_decode } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_slice_unit] FAIL: " + label)
  1
end

fn slice_quantum() -> i32 = 10

fn loop_iterations() -> i32 = 1000

fn resume_limit() -> i32 = 100000

fn unlimited_limits() -> i64 = 0

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn integer_result(value: Value) -> i32 =
  match value_decode(value) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn program_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 0\nwhile index < 1000 do\ntotal = total + 1\nindex = index + 1\nend\ntotal\nend\n"

fn is_yielded(session: SliceSession) -> bool =
  match session.execution.status {
    Yielded => true,
    _ => false
  }

fn main() -> i32 = do
  const lowered = lower_source(program_source())
  if lowered.diagnostics.length() != 0 then
    return fail("lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() then
    return fail("decode code=" + decoded.code.to_string())
  end
  const prototypes = decoded.decoded_module.protos
  const entry_index = decoded.decoded_module.exports[0].proto_index
  const limits = run_limits_new(unlimited_limits(), 0)
  const uninterrupted = run_execution(heap_new(), prototypes, entry_index, empty_arguments(), limits)
  match uninterrupted.status {
    Finished => do
      let mut session = slice_session_new(heap_new(), prototypes, entry_index, empty_arguments(), limits)
      session = run_slice(session, slice_quantum())
      if !is_yielded(session) then
        return fail(
          "first slice was not Yielded quantum=" + slice_quantum().to_string()
            + " code=" + session.execution.error_code
            + " at=" + session.execution.error_at.to_string()
            + " instructions=" + session.state.instruction_count.to_string()
            + " value=" + integer_result(session.execution.value).to_string()
        )
      end
      if session.state.instruction_count != slice_quantum() then
        return fail(
          "first slice instruction_count=" + session.state.instruction_count.to_string()
            + " quantum=" + slice_quantum().to_string()
        )
      end
      let mut slices = 0
      while is_yielded(session) && slices < resume_limit() do
        session = run_slice(session, slice_quantum())
        slices = slices + 1
      end
      match session.execution.status {
        Finished => do
          const sliced_value = integer_result(session.execution.value)
          const uninterrupted_value = integer_result(uninterrupted.value)
          if sliced_value == loop_iterations() && sliced_value == uninterrupted_value && slices > 1 && session.state.instruction_count > slice_quantum() then
            println("slice_resumed")
            println("[script_vm] execution_slice_unit ok")
            0
          else
            fail(
              "final value=" + sliced_value.to_string()
                + " uninterrupted=" + uninterrupted_value.to_string()
                + " slices=" + slices.to_string()
                + " instructions=" + session.state.instruction_count.to_string()
            )
          end
        end,
        _ => fail(
          "resume status was not Finished slices=" + slices.to_string()
            + " code=" + session.execution.error_code
            + " at=" + session.execution.error_at.to_string()
            + " instructions=" + session.state.instruction_count.to_string()
        )
      }
    end,
    _ => fail("uninterrupted status was not Finished code=" + uninterrupted.error_code)
  }
end
