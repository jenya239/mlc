import { lower_source } from '../lower/lower_module'
import { LowerDiagnostic } from '../lower/lower_types'
import { Value, ValueInt32, value_decode } from '../value'
import { emb_ok, emb_call_export_bytes } from '../embedding'

fn report_failure(label: string) -> i32 = do
  println("[script_vm lower_method_mut_self_unit] FAIL: " + label)
  1
end

fn diagnostic_codes(diagnostics: [LowerDiagnostic]) -> string = do
  let mut text = ""
  let mut index = 0
  while index < diagnostics.length() do
    if index > 0 then
      text = text + ","
    end
    text = text + diagnostics[index].code + "@" + diagnostics[index].line.to_string() + ":" + diagnostics[index].column.to_string()
    index = index + 1
  end
  text
end

fn decoded_integer(raw: i64) -> i32 =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn empty_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn method_source() -> string =
  "type Point = { x: i32 }\nextend Point {\nfn set_x(self: ref mut Point, v: i32) -> i32 = do self.x = v self.x end\n}\nexport fn main() -> i32 = do\nlet mut point = Point { x: 1 }\npoint.set_x(10)\npoint.x\nend"

fn whole_assignment_source() -> string =
  "type Point = { x: i32 }\nextend Point {\nfn replace(self: ref mut Point) -> i32 = do self = Point { x: 9 } self.x end\n}\nexport fn main() -> i32 = 0"

fn expect_outer_field() -> i32 = do
  const lowered = lower_source(method_source())
  if lowered.diagnostics.length() != 0 then
    return report_failure("diagnostics=" + diagnostic_codes(lowered.diagnostics) + " bytes=" + lowered.bytes.length().to_string())
  end
  const called = emb_call_export_bytes(lowered.bytes, "main", empty_arguments())
  if called.code != emb_ok() then
    return report_failure("code=" + called.code.to_string())
  end
  if decoded_integer(called.raw) != 10 then
    return report_failure("value=" + decoded_integer(called.raw).to_string())
  end
  println("method_mut_self_outer")
  0
end

fn expect_whole_assignment_rejected() -> i32 = do
  const lowered = lower_source(whole_assignment_source())
  if lowered.diagnostics.length() == 0 then
    return report_failure("whole_assignment accepted")
  end
  if lowered.diagnostics[0].code != "assign_immutable" then
    return report_failure("whole_assignment=" + diagnostic_codes(lowered.diagnostics))
  end
  println("method_mut_self_whole")
  0
end

fn main() -> i32 = do
  if expect_outer_field() != 0 then
    return 1
  end
  if expect_whole_assignment_rejected() != 0 then
    return 1
  end
  println("[script_vm] lower_method_mut_self_unit ok")
  0
end
