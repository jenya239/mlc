import { emb_ok } from '../embedding_codes'
import { continue_halt } from '../executor'
import { run_guest_halt } from '../executor_guest'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { run_limits_new, run_limits_quantum } from '../run_result'
import { Value, ValueInt32, value_decode } from '../value'

fn fail(message: string) -> i32 = do
  println("[script_vm guest_quantum_unit] FAIL: " + message)
  1
end

fn loop_iterations() -> i32 = 20

fn slice_quantum() -> i32 = 32

fn instruction_limit() -> i64 = 100000

fn resume_limit() -> i32 = 1000

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn integer_result(value: Value) -> i32 =
  match value_decode(value) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn program_source() -> string =
  "export fn run() -> i32 = do\nlet mut total = 0\nlet mut index = 0\nwhile index < 20 do\ntotal = total + 1\nindex = index + 1\nend\ntotal\nend\n"

fn main() -> i32 = do
  const lowered = lower_source(program_source())
  if lowered.diagnostics.length() != 0 then
    return fail("lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() || decoded.decoded_module.exports.length() != 1 then
    return fail("decode code=" + decoded.code.to_string())
  end
  const prototypes = decoded.decoded_module.protos
  const entry_index = decoded.decoded_module.exports[0].proto_index
  let uninterrupted = run_guest_halt(
    heap_new(),
    prototypes,
    entry_index,
    empty_arguments(),
    run_limits_new(instruction_limit(), 0)
  )
  if uninterrupted.outcome != "finished" || integer_result(uninterrupted.state.return_value) != loop_iterations() then
    return fail(
      "uninterrupted outcome=" + uninterrupted.outcome
        + " value=" + integer_result(uninterrupted.state.return_value).to_string()
        + " error=" + uninterrupted.state.error_code
    )
  end
  let mut halted = run_guest_halt(
    heap_new(),
    prototypes,
    entry_index,
    empty_arguments(),
    run_limits_quantum(instruction_limit(), 0, slice_quantum())
  )
  if halted.outcome != "yielded" || halted.state.error_code != "" then
    return fail(
      "first quantum outcome=" + halted.outcome
        + " error=" + halted.state.error_code
        + " instructions=" + halted.state.instruction_count.to_string()
    )
  end
  if halted.state.instruction_count != slice_quantum() then
    return fail("first quantum instructions=" + halted.state.instruction_count.to_string())
  end
  let mut slices = 1
  while halted.outcome == "yielded" && slices < resume_limit() do
    let mut heap = halted.heap
    let mut state = halted.state
    halted = continue_halt(heap, state, prototypes)
    slices = slices + 1
  end
  if halted.outcome != "finished" || integer_result(halted.state.return_value) != loop_iterations() || slices < 2 then
    return fail(
      "resumed outcome=" + halted.outcome
        + " value=" + integer_result(halted.state.return_value).to_string()
        + " slices=" + slices.to_string()
        + " error=" + halted.state.error_code
    )
  end
  println("guest_quantum_value=20")
  println("[script_vm] guest_quantum_unit ok")
  0
end
