import { repl_balance_incomplete } from '../repl_balance'

fn fail_check(check_name: string) -> i32 = do
  println("[script_vm repl_balance_unit] FAIL " + check_name)
  1
end

fn expect_incomplete(text: string, expected_incomplete: bool, check_name: string) -> i32 = do
  let actual_incomplete = repl_balance_incomplete(text)
  if expected_incomplete then
    if actual_incomplete then 0 else fail_check(check_name)
  else
    if actual_incomplete then fail_check(check_name) else 0
  end
end

fn main() -> i32 = do
  let mut status = expect_incomplete("fn value() -> i32 = do", true, "open_do")
  if status == 0 then
    status = expect_incomplete("fn value() -> i32 = do 1 end", false, "closed_do")
  end
  if status == 0 then
    status = expect_incomplete("'do'", false, "quoted_do")
  end
  if status == 0 then
    status = expect_incomplete("// do", false, "comment_do")
  end
  if status == 0 then
    status = expect_incomplete("fn value() -> i32 = do // end", true, "comment_hides_end")
  end
  if status == 0 then
    status = expect_incomplete("'hello", true, "unclosed_quote")
  end
  if status == 0 then
    status = expect_incomplete("/*", true, "unclosed_block_comment")
  end
  if status == 0 then
    status = expect_incomplete("/* do */", false, "block_comment_do")
  end
  if status == 0 then
    status = expect_incomplete("doing", false, "word_doing")
  end
  if status == 0 then
    status = expect_incomplete("{", true, "unclosed_brace")
  end
  if status == 0 then
    status = expect_incomplete("do 1 end (", false, "unclosed_parenthesis")
  end
  if status == 0 then
    println("[script_vm] repl_balance_unit ok")
  end
  status
end
