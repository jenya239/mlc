import { lower_source } from '../lower/lower_module'
import { emb_ok, emb_call_export_bytes } from '../embedding'
import { Value, ValueInt32, value_decode } from '../value'

fn break_sum_source() -> string =
  "export fn run() -> i32 = do let mut total = 0 let mut index = 1 while index <= 10 do if total > 2 then break end total = total + index index = index + 1 end total end"

fn continue_sum_source() -> string =
  "export fn run() -> i32 = do let mut total = 0 let mut index = 1 while index <= 4 do if index / 2 * 2 == index then index = index + 1 continue end total = total + index index = index + 1 end total end"

fn no_arguments() -> [i64] = do
  let mut arguments: [i64] = []
  arguments
end

fn decoded_int(raw: i64) -> i32 =
  match value_decode(Value { raw: raw }) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn expect_break_sum() -> i32 = do
  let lowered = lower_source(break_sum_source())
  if lowered.diagnostics.length() != 0 then
    println("iteration diagnostic=" + lowered.diagnostics[0].code)
    1
  else
    let called = emb_call_export_bytes(lowered.bytes, "run", no_arguments())
    if called.code != emb_ok() then
      println("iteration call code=" + called.code.to_string())
      1
    else if decoded_int(called.raw) == 3 then
      println("iteration value=3")
      0
    else
      println("iteration value=" + decoded_int(called.raw).to_string())
      1
    end
  end
end

fn expect_continue_sum() -> i32 = do
  let lowered = lower_source(continue_sum_source())
  if lowered.diagnostics.length() != 0 then
    println("iteration diagnostic=" + lowered.diagnostics[0].code)
    1
  else
    let called = emb_call_export_bytes(lowered.bytes, "run", no_arguments())
    if called.code != emb_ok() then
      println("iteration call code=" + called.code.to_string())
      1
    else if decoded_int(called.raw) == 4 then
      println("iteration value=4")
      0
    else
      println("iteration value=" + decoded_int(called.raw).to_string())
      1
    end
  end
end

fn outside_break_source() -> string = "export fn run() -> i32 = do break 0 end"

fn outside_continue_source() -> string = "export fn run() -> i32 = do continue 0 end"

fn expect_outside_code(source: string, expected_code: string) -> i32 = do
  let lowered = lower_source(source)
  if lowered.diagnostics.length() == 0 then
    println("iteration outside executed")
    1
  else if lowered.diagnostics[0].code == expected_code then
    println("iteration diagnostic=" + expected_code)
    0
  else
    println("iteration diagnostic=" + lowered.diagnostics[0].code)
    1
  end
end

fn expect_outside_loop() -> i32 = do
  let break_status = expect_outside_code(outside_break_source(), "break_outside_loop")
  if break_status != 0 then
    break_status
  else
    expect_outside_code(outside_continue_source(), "continue_outside_loop")
  end
end

fn main() -> i32 = do
  let break_status = expect_break_sum()
  if break_status != 0 then
    break_status
  else
    let continue_status = expect_continue_sum()
    if continue_status != 0 then
      continue_status
    else
      let outside_status = expect_outside_loop()
      if outside_status != 0 then
        outside_status
      else
        println("[script_vm] lower_iteration_unit ok")
        0
      end
    end
  end
end
