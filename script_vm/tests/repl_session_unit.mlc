import {
  repl_session_new,
  repl_session_submit,
  ReplAnswer,
  ReplIncomplete,
  ReplAccepted,
  ReplValueInt32,
  ReplValueString,
  ReplDiagnostic
} from '../repl_session'

fn answer_line(answer: ReplAnswer) -> string =
  match answer {
    ReplIncomplete => "repl answer=incomplete",
    ReplAccepted => "repl answer=accepted",
    ReplValueInt32(number) => "repl answer=value kind=int32 number=" + number.to_string(),
    ReplValueString(string_length) => "repl answer=value kind=string length=" + string_length.to_string(),
    ReplDiagnostic(code, line, column) => "repl answer=diagnostic code=" + code + " line=" + line.to_string() + " column=" + column.to_string()
  }

fn expect_answer(answer: ReplAnswer, expected_line: string) -> i32 = do
  let line = answer_line(answer)
  println(line)
  if line == expected_line then
    0
  else
    1
  end
end

fn expect_diagnostic(answer: ReplAnswer) -> i32 = do
  let line = answer_line(answer)
  println(line)
  match answer {
    ReplDiagnostic(_code, _line, _column) => 0,
    _ => 1
  }
end

fn diagnostic_is_positioned_unknown(answer: ReplAnswer) -> bool =
  match answer {
    ReplDiagnostic(code, line_number, column) =>
      code == "unknown_identifier" && line_number > 0 && column > 0,
    _ => false
  }

fn expect_unknown_identifier(answer: ReplAnswer) -> i32 = do
  let printed = answer_line(answer)
  println(printed)
  if diagnostic_is_positioned_unknown(answer) then
    0
  else
    1
  end
end

fn main() -> i32 = do
  let mut session = repl_session_new()
  let mut status = expect_answer(repl_session_submit(session, ""), "repl answer=incomplete")
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "export fn identity(number: i32) -> i32 = number"),
      "repl answer=accepted"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "identity(4)"),
      "repl answer=value kind=int32 number=4"
    )
  end
  if status == 0 then
    status = expect_diagnostic(repl_session_submit(session, "export fn broken( -> i32 = 1"))
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "export fn spare() -> i32 = 1"),
      "repl answer=accepted"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "identity(4)"),
      "repl answer=value kind=int32 number=4"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "1 + 2"),
      "repl answer=value kind=int32 number=3"
    )
  end
  if status == 0 then
    status = expect_diagnostic(repl_session_submit(session, "true"))
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "1"),
      "repl answer=value kind=int32 number=1"
    )
  end
  if status == 0 then
    status = expect_unknown_identifier(repl_session_submit(session, "missing_name"))
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "len('hi')"),
      "repl answer=value kind=int32 number=2"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "'hi'"),
      "repl answer=value kind=string length=2"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "len([1, 2, 3])"),
      "repl answer=value kind=int32 number=3"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(
        session,
        "export fn run() -> i32 = do let mut total = 0 let mut index = 1 while index <= 10 do if total > 2 then break end total = total + index index = index + 1 end total end"
      ),
      "repl answer=accepted"
    )
  end
  if status == 0 then
    status = expect_answer(
      repl_session_submit(session, "run()"),
      "repl answer=value kind=int32 number=3"
    )
  end
  if status == 0 then
    println("[script_vm] repl_session_unit ok")
  end
  status
end
