import { emb_ok } from '../embedding_codes'
import { Finished } from '../execution'
import { Completed, poll_execution } from '../execution_result'
import { run_execution, run_state_program_limited } from '../executor'
import { heap_new } from '../heap_types'
import { lower_source } from '../lower/lower_module'
import { decode_module } from '../module_blob'
import { RunOk, RunErr, run_limits_new } from '../run_result'
import { Value, ValueInt32, value_decode } from '../value'

fn fail(label: string) -> i32 = do
  println("[script_vm execution_split_unit] FAIL: " + label)
  1
end

fn unlimited_limits() -> i64 = 0

fn empty_arguments() -> [Value] = do
  let mut arguments: [Value] = []
  arguments
end

fn integer_result(value: Value) -> i32 =
  match value_decode(value) {
    ValueInt32(number) => number,
    _ => 0 - 1
  }

fn program_source() -> string =
  "export fn run() -> i32 = 1\n"

fn main() -> i32 = do
  const lowered = lower_source(program_source())
  if lowered.diagnostics.length() != 0 then
    return fail("lower code=" + lowered.diagnostics[0].code)
  end
  const decoded = decode_module(lowered.bytes)
  if decoded.code != emb_ok() then
    return fail("decode code=" + decoded.code.to_string())
  end
  const prototypes = decoded.decoded_module.protos
  const entry_index = decoded.decoded_module.exports[0].proto_index
  const limits = run_limits_new(unlimited_limits(), 0)
  const legacy = run_state_program_limited(heap_new(), prototypes, entry_index, empty_arguments(), limits)
  const execution = run_execution(heap_new(), prototypes, entry_index, empty_arguments(), limits)
  const polled = poll_execution(execution)
  match execution.status {
    Finished =>
      match legacy.result {
        RunOk(legacy_value) =>
          match polled {
            Completed(polled_value) => do
              const legacy_number = integer_result(legacy_value)
              const execution_number = integer_result(execution.value)
              const polled_number = integer_result(polled_value)
              if legacy_number == 1 && execution_number == legacy_number && polled_number == legacy_number then
                println("execution_finished")
                println("[script_vm] execution_split_unit ok")
                0
              else
                fail(
                  "value mismatch legacy=" + legacy_number.to_string()
                    + " execution=" + execution_number.to_string()
                    + " poll=" + polled_number.to_string()
                )
              end
            end,
            _ => fail("poll was not Completed")
          },
        RunErr(code, _at) => fail("legacy RunErr code=" + code)
      },
    _ => fail("execution status was not Finished")
  }
end
