import { Value, ValueInt32, ValueBool, ValueNil, ValueHeapRef, value_encode, value_decode } from './value'
import { DecodedAbc } from './bytecode'
import {
  Heap,
  heap_in_place_type_id,
  heap_in_place_element_count,
  heap_in_place_read,
  heap_in_place_alloc_array,
  heap_type_array
} from './heap'
import { HeapSlot, ObjectHeader, heap_type_string } from './heap_types'
import { run_err_type, run_err_bounds } from './run_result'
import {
  VmState,
  vm_state_register,
  vm_state_set_register,
  vm_state_set_program_counter
} from './vm_state'
import { executor_step_continue, executor_fail } from './executor_step'
import { executor_collect_if_needed } from './executor_gc'

fn store_length(state: ref mut VmState, register_index: i32, length: i32, primary: i32, span: i32) -> i32 = do
  vm_state_set_register(state, register_index, value_encode(ValueInt32(length)))
  vm_state_set_program_counter(state, primary + span)
  executor_step_continue()
end

fn length_of_value(heap: ref mut Heap, value: Value) -> i32 = do
  let type_id = heap_in_place_type_id(heap, value)
  if type_id == heap_type_array() then
    heap_in_place_element_count(heap, value)
  else if type_id == heap_type_string() then
    heap_in_place_element_count(heap, value)
  else
    0 - 1
  end
end

export fn executor_exec_length(
  heap: ref mut Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> i32 = do
  let length = length_of_value(heap, vm_state_register(state, decoded.b))
  if length < 0 then
    executor_fail(state, run_err_type(), primary)
  else
    store_length(state, decoded.a, length, primary, span)
  end
end

fn object_id_of(value: Value) -> i32 =
  match value_decode(value) {
    ValueHeapRef(object_id) => object_id,
    _ => 0 - 1
  }

fn byte_problem_code(number: i32) -> i32 =
  if number < 0 || number > 255 then
    1
  else
    0
  end

fn element_status(heap: ref mut Heap, array_value: Value, index: i32) -> i32 =
  match value_decode(heap_in_place_read(heap, array_value, index)) {
    ValueInt32(number) => byte_problem_code(number),
    _ => 2
  }

fn array_byte_problem(heap: ref mut Heap, array_value: Value, count: i32) -> i32 = do
  let mut index = 0
  let mut problem = 0
  while index < count && problem == 0 do
    problem = element_status(heap, array_value, index)
    index = index + 1
  end
  problem
end

fn read_byte(heap: ref mut Heap, array_value: Value, index: i32) -> i32 =
  match value_decode(heap_in_place_read(heap, array_value, index)) {
    ValueInt32(number) => number,
    _ => 0
  }

fn write_string_byte(heap: ref mut Heap, object_id: i32, index: i32, byte_value: i32) -> unit = do
  let slot = heap.slots[object_id]
  heap.element_arena.set(slot.element_start + index, value_encode(ValueInt32(byte_value)))
end

fn write_string_bytes(heap: ref mut Heap, object_id: i32, array_value: Value, count: i32) -> unit = do
  let mut index = 0
  while index < count do
    write_string_byte(heap, object_id, index, read_byte(heap, array_value, index))
    index = index + 1
  end
end

fn string_slot_from(slot: HeapSlot) -> HeapSlot =
  HeapSlot {
    header: ObjectHeader {
      type_id: heap_type_string(),
      gc_flags: slot.header.gc_flags,
      object_flags: slot.header.object_flags,
      shape_or_meta: slot.header.shape_or_meta
    },
    child: slot.child,
    element_start: slot.element_start,
    element_count: slot.element_count,
    size_class: slot.size_class,
    live: slot.live
  }

fn install_string(heap: ref mut Heap, array_value: Value, count: i32) -> Value = do
  let allocated = heap_in_place_alloc_array(heap, count)
  let object_id = object_id_of(allocated)
  heap.slots.set(object_id, string_slot_from(heap.slots[object_id]))
  write_string_bytes(heap, object_id, array_value, count)
  allocated
end

fn store_value(state: ref mut VmState, register_index: i32, value: Value, primary: i32, span: i32) -> i32 = do
  vm_state_set_register(state, register_index, value)
  vm_state_set_program_counter(state, primary + span)
  executor_step_continue()
end

fn fail_problem(state: ref mut VmState, problem: i32, primary: i32) -> i32 =
  if problem == 1 then
    executor_fail(state, run_err_bounds(), primary)
  else
    executor_fail(state, run_err_type(), primary)
  end

fn finish_make_string(
  heap: ref mut Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32,
  array_value: Value
) -> i32 = do
  let count = heap_in_place_element_count(heap, array_value)
  let problem = array_byte_problem(heap, array_value, count)
  if problem != 0 then
    fail_problem(state, problem, primary)
  else
    store_value(state, decoded.a, install_string(heap, array_value, count), primary, span)
  end
end

fn make_string_after_collect(
  heap: ref mut Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> i32 = do
  let array_value = vm_state_register(state, decoded.b)
  if heap_in_place_type_id(heap, array_value) != heap_type_array() then
    executor_fail(state, run_err_type(), primary)
  else
    finish_make_string(heap, state, decoded, primary, span, array_value)
  end
end

export fn executor_exec_make_string(
  heap: ref mut Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> i32 = do
  let collected = executor_collect_if_needed(state, heap, primary)
  if collected != executor_step_continue() then
    collected
  else
    make_string_after_collect(heap, state, decoded, primary, span)
  end
end

export type TextBinary = { step: i32, value: Value }

fn value_is_string(heap: ref mut Heap, value: Value) -> bool =
  heap_in_place_type_id(heap, value) == heap_type_string()

export fn executor_both_strings(heap: ref mut Heap, left: Value, right: Value) -> bool =
  value_is_string(heap, left) && value_is_string(heap, right)

fn empty_bytes() -> [i32] = do
  let mut bytes: [i32] = []
  bytes
end

fn append_string_bytes(heap: ref mut Heap, bytes: [i32], value: Value) -> [i32] = do
  let mut next = bytes
  let mut index = 0
  let count = heap_in_place_element_count(heap, value)
  while index < count do
    next.push(read_byte(heap, value, index))
    index = index + 1
  end
  next
end

fn write_listed_bytes(heap: ref mut Heap, object_id: i32, bytes: [i32]) -> unit = do
  let mut index = 0
  while index < bytes.length() do
    write_string_byte(heap, object_id, index, bytes[index])
    index = index + 1
  end
end

fn install_listed_string(heap: ref mut Heap, bytes: [i32]) -> Value = do
  let allocated = heap_in_place_alloc_array(heap, bytes.length())
  let object_id = object_id_of(allocated)
  heap.slots.set(object_id, string_slot_from(heap.slots[object_id]))
  write_listed_bytes(heap, object_id, bytes)
  allocated
end

fn nil_text(step: i32) -> TextBinary =
  TextBinary { step: step, value: value_encode(ValueNil) }

export fn executor_text_add(
  heap: ref mut Heap,
  state: ref mut VmState,
  left: Value,
  right: Value,
  primary: i32
) -> TextBinary = do
  let copied = append_string_bytes(heap, append_string_bytes(heap, empty_bytes(), left), right)
  let collected = executor_collect_if_needed(state, heap, primary)
  if collected != executor_step_continue() then
    nil_text(collected)
  else
    TextBinary { step: executor_step_continue(), value: install_listed_string(heap, copied) }
  end
end

fn bytes_differ_at(heap: ref mut Heap, left: Value, right: Value, index: i32) -> bool =
  read_byte(heap, left, index) != read_byte(heap, right, index)

fn string_bytes_equal(heap: ref mut Heap, left: Value, right: Value, count: i32) -> bool = do
  let mut index = 0
  let mut same = true
  while index < count && same do
    same = !bytes_differ_at(heap, left, right, index)
    index = index + 1
  end
  same
end

fn strings_equal(heap: ref mut Heap, left: Value, right: Value) -> bool = do
  let count = heap_in_place_element_count(heap, left)
  if count != heap_in_place_element_count(heap, right) then
    false
  else
    string_bytes_equal(heap, left, right, count)
  end
end

export fn executor_text_equal(heap: ref mut Heap, left: Value, right: Value) -> Value =
  value_encode(ValueBool(strings_equal(heap, left, right)))

