import { Value } from './value'
import { Heap } from './heap'

export type RunResult =
  | RunOk(Value)
  | RunErr(string, i32)

export type RunHeapResult = { heap: Heap, result: RunResult }

export type FunctionProto = {
  words: [i32],
  constants: [Value],
  register_count: i32
}

export fn run_err_verify() -> string = "verify"
export fn run_err_type() -> string = "type"
export fn run_err_overflow() -> string = "overflow"
export fn run_err_div_zero() -> string = "div_zero"
export fn run_err_no_return() -> string = "no_return"
export fn run_err_unsupported_opcode() -> string = "unsupported_opcode"
export fn run_err_bounds() -> string = "bounds"
export fn run_err_stack() -> string = "stack"
export fn run_err_instruction_limit() -> string = "instruction_limit"
export fn run_err_heap_limit() -> string = "heap_limit"

export type RunLimits = {
  instruction_limit: i64,
  heap_limit_objects: i32,
  quantum_limit: i32
}

fn instruction_limit_from_i32(number: i32) -> i64 = number

export fn run_limits_unlimited() -> RunLimits =
  RunLimits {
    instruction_limit: instruction_limit_from_i32(0),
    heap_limit_objects: 0,
    quantum_limit: 0
  }

export fn run_limits_new(instruction_limit: i64, heap_limit_objects: i32) -> RunLimits =
  RunLimits {
    instruction_limit: instruction_limit,
    heap_limit_objects: heap_limit_objects,
    quantum_limit: 0
  }

export fn run_limits_quantum(
  instruction_limit: i64,
  heap_limit_objects: i32,
  quantum_limit: i32
) -> RunLimits =
  RunLimits {
    instruction_limit: instruction_limit,
    heap_limit_objects: heap_limit_objects,
    quantum_limit: quantum_limit
  }
