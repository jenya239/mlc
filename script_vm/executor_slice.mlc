import { Value, ValueNil, value_encode } from './value'
import { continue_halt, verify_protos } from './executor'
import { guest_halt_execution } from './executor_halt'
import { Cancelled, Execution, Failed, Finished, Ready, execution_failed } from './execution'
import { Heap } from './heap'
import { FunctionProto, RunLimits, run_err_type, run_err_verify } from './run_result'
import { VmState, vm_state_new, vm_state_push_frame, vm_state_set_register } from './vm_state'

export type SliceSession = {
  heap: Heap,
  state: VmState,
  protos: [FunctionProto],
  execution: Execution,
  cancel_requested: bool
}

fn nil_value() -> Value = value_encode(ValueNil)

fn place_arguments(state: ref mut VmState, register_count: i32, arguments: [Value]) -> unit = do
  let mut argument_index = 0
  while argument_index < arguments.length() && argument_index < register_count do
    vm_state_set_register(state, argument_index, arguments[argument_index])
    argument_index = argument_index + 1
  end
end

fn execution_ready(heap: Heap) -> Execution =
  Execution { status: Ready, heap: heap, value: nil_value(), error_code: "", error_at: 0 }

fn execution_cancelled(heap: Heap) -> Execution =
  Execution { status: Cancelled, heap: heap, value: nil_value(), error_code: "", error_at: 0 }

fn execution_is_terminal(execution: Execution) -> bool =
  match execution.status {
    Finished => true,
    Failed => true,
    Cancelled => true,
    _ => false
  }

fn session_with(session: SliceSession, heap: Heap, state: VmState, execution: Execution) -> SliceSession =
  SliceSession {
    heap: heap,
    state: state,
    protos: session.protos,
    execution: execution,
    cancel_requested: session.cancel_requested
  }

fn failed_session(heap: Heap, state: VmState, protos: [FunctionProto], code: string, at: i32) -> SliceSession =
  SliceSession {
    heap: heap,
    state: state,
    protos: protos,
    execution: execution_failed(heap, code, at),
    cancel_requested: false
  }

export fn slice_session_new(
  heap: Heap,
  protos: [FunctionProto],
  entry_proto_index: i32,
  arguments: [Value],
  limits: RunLimits
) -> SliceSession = do
  let mut state = vm_state_new()
  state.instruction_limit = limits.instruction_limit
  state.heap_limit_objects = limits.heap_limit_objects
  state.quantum_limit = limits.quantum_limit
  let verification = verify_protos(protos)
  if verification.failed then
    failed_session(heap, state, protos, run_err_verify(), verification.at)
  else if entry_proto_index < 0 || entry_proto_index >= protos.length() then
    failed_session(heap, state, protos, run_err_type(), 0)
  else
    let entry = protos[entry_proto_index]
    vm_state_push_frame(state, entry_proto_index, entry.register_count, nil_value(), 0)
    place_arguments(state, entry.register_count, arguments)
    SliceSession {
      heap: heap,
      state: state,
      protos: protos,
      execution: execution_ready(heap),
      cancel_requested: false
    }
  end
end

export fn slice_session_set_cancel(session: SliceSession, cancel_requested: bool) -> SliceSession =
  SliceSession {
    heap: session.heap,
    state: session.state,
    protos: session.protos,
    execution: session.execution,
    cancel_requested: cancel_requested
  }

export fn run_slice(session: SliceSession, quantum: i32) -> SliceSession = do
  if execution_is_terminal(session.execution) then
    return session
  end
  if session.cancel_requested then
    return session_with(session, session.heap, session.state, execution_cancelled(session.heap))
  end
  let mut state = session.state
  let mut heap = session.heap
  state.quantum_limit = quantum
  let halt = continue_halt(heap, state, session.protos)
  session_with(session, halt.heap, halt.state, guest_halt_execution(halt))
end
