import { Value, ValueInt32, value_decode } from './value'
import { DecodedAbc } from './bytecode'
import {
  Heap,
  HeapAlloc,
  heap_alloc_array,
  heap_alloc_record,
  heap_write_barrier,
  heap_get_element,
  heap_element_count,
  heap_object_type_id,
  heap_type_array,
  heap_type_record
} from './heap'
import { run_err_type, run_err_bounds } from './run_result'
import {
  VmState,
  vm_state_register,
  vm_state_set_register,
  vm_state_set_program_counter
} from './vm_state'
import { executor_step_continue, executor_fail } from './executor_step'
import { ExecutorHeapStep, executor_heap_step } from './executor_calls'

fn executor_store_alloc(
  alloc: HeapAlloc,
  state: ref mut VmState,
  register_index: i32,
  primary: i32,
  span: i32
) -> ExecutorHeapStep = do
  vm_state_set_register(state, register_index, alloc.value)
  vm_state_set_program_counter(state, primary + span)
  executor_heap_step(alloc.heap, executor_step_continue())
end

fn executor_store_register(
  heap: Heap,
  state: ref mut VmState,
  register_index: i32,
  value: Value,
  primary: i32,
  span: i32
) -> ExecutorHeapStep = do
  vm_state_set_register(state, register_index, value)
  vm_state_set_program_counter(state, primary + span)
  executor_heap_step(heap, executor_step_continue())
end

fn executor_new_array_length(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32,
  length: i32
) -> ExecutorHeapStep =
  if length < 0 then
    executor_heap_step(heap, executor_fail(state, run_err_bounds(), primary))
  else
    executor_store_alloc(heap_alloc_array(heap, length), state, decoded.a, primary, span)
  end

export fn executor_exec_new_array(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  match value_decode(vm_state_register(state, decoded.b)) {
    ValueInt32(length) => executor_new_array_length(heap, state, decoded, primary, span, length),
    _ => executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  }

fn executor_read_array_element(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32,
  index: i32
) -> ExecutorHeapStep =
  if index < 0 || index >= heap_element_count(heap, vm_state_register(state, decoded.b)) then
    executor_heap_step(heap, executor_fail(state, run_err_bounds(), primary))
  else
    executor_store_register(
      heap,
      state,
      decoded.a,
      heap_get_element(heap, vm_state_register(state, decoded.b), index),
      primary,
      span
    )
  end

fn executor_read_array_index(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  match value_decode(vm_state_register(state, decoded.c)) {
    ValueInt32(index) => executor_read_array_element(heap, state, decoded, primary, span, index),
    _ => executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  }

export fn executor_exec_get_index(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if heap_object_type_id(heap, vm_state_register(state, decoded.b)) != heap_type_array() then
    executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  else
    executor_read_array_index(heap, state, decoded, primary, span)
  end

fn executor_write_array_element(
  heap: Heap,
  state: ref mut VmState,
  array_value: Value,
  index: i32,
  stored: Value,
  primary: i32,
  span: i32
) -> ExecutorHeapStep = do
  let written = heap_write_barrier(heap, array_value, index, stored)
  vm_state_set_program_counter(state, primary + span)
  executor_heap_step(written, executor_step_continue())
end

fn executor_check_array_index(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32,
  index: i32
) -> ExecutorHeapStep =
  if index < 0 || index >= heap_element_count(heap, vm_state_register(state, decoded.a)) then
    executor_heap_step(heap, executor_fail(state, run_err_bounds(), primary))
  else
    executor_write_array_element(
      heap,
      state,
      vm_state_register(state, decoded.a),
      index,
      vm_state_register(state, decoded.c),
      primary,
      span
    )
  end

fn executor_decode_array_index(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  match value_decode(vm_state_register(state, decoded.b)) {
    ValueInt32(index) => executor_check_array_index(heap, state, decoded, primary, span, index),
    _ => executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  }

export fn executor_exec_set_index(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if heap_object_type_id(heap, vm_state_register(state, decoded.a)) != heap_type_array() then
    executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  else
    executor_decode_array_index(heap, state, decoded, primary, span)
  end

export fn executor_exec_new_record(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  executor_store_alloc(heap_alloc_record(heap, decoded.b), state, decoded.a, primary, span)

fn executor_read_record_field(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if decoded.c < 0 || decoded.c >= heap_element_count(heap, vm_state_register(state, decoded.b)) then
    executor_heap_step(heap, executor_fail(state, run_err_bounds(), primary))
  else
    executor_store_register(
      heap,
      state,
      decoded.a,
      heap_get_element(heap, vm_state_register(state, decoded.b), decoded.c),
      primary,
      span
    )
  end

export fn executor_exec_get_prop(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if heap_object_type_id(heap, vm_state_register(state, decoded.b)) != heap_type_record() then
    executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  else
    executor_read_record_field(heap, state, decoded, primary, span)
  end

fn executor_write_record_field(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep = do
  let written = heap_write_barrier(
    heap,
    vm_state_register(state, decoded.a),
    decoded.b,
    vm_state_register(state, decoded.c)
  )
  vm_state_set_program_counter(state, primary + span)
  executor_heap_step(written, executor_step_continue())
end

fn executor_check_record_field(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if decoded.b < 0 || decoded.b >= heap_element_count(heap, vm_state_register(state, decoded.a)) then
    executor_heap_step(heap, executor_fail(state, run_err_bounds(), primary))
  else
    executor_write_record_field(heap, state, decoded, primary, span)
  end

export fn executor_exec_set_prop(
  heap: Heap,
  state: ref mut VmState,
  decoded: DecodedAbc,
  primary: i32,
  span: i32
) -> ExecutorHeapStep =
  if heap_object_type_id(heap, vm_state_register(state, decoded.a)) != heap_type_record() then
    executor_heap_step(heap, executor_fail(state, run_err_type(), primary))
  else
    executor_check_record_field(heap, state, decoded, primary, span)
  end
