// TRACK_MLC_SCRIPT_VM §103i — embedding module blob + call (authoritative semantics).
import { Value } from './value'
import {
  verify_function,
  VerifyOk,
  VerifyErr
} from './verifier'
import {
  RunOk,
  RunErr,
  run_program_with_args_limited,
  run_err_verify,
  run_err_type,
  run_err_bounds,
  run_err_stack
} from './interpreter'
import { heap_new } from './heap'
import {
  run_limits_new,
  run_err_instruction_limit,
  run_err_heap_limit,
  run_err_overflow,
  run_err_div_zero
} from './run_result'
import {
  emb_ok,
  emb_unsupported,
  emb_verify,
  emb_type,
  emb_bounds,
  emb_stack,
  emb_format,
  emb_not_found,
  emb_bad_handle,
  emb_instruction_limit,
  emb_heap_limit,
  emb_overflow,
  emb_div_zero
} from './embedding_codes'
import {
  DecodedModule,
  decode_module,
  bytes_from_pointer,
  emb_encode_add1_module
} from './module_blob'

extern fn embedding_u8_to_i64(byte_value: i32) -> i64 =
  "mlc::script_vm::embedding_u8_to_i64" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_i64_at(data_pointer: i64, index: i32) -> i64 =
  "mlc::script_vm::embedding_i64_at" from "mlc/script_vm/embedding_helpers.hpp" thread_safe
extern fn embedding_i64_store(data_pointer: i64, value: i64) -> i32 =
  "mlc::script_vm::embedding_i64_store" from "mlc/script_vm/embedding_helpers.hpp" thread_safe

export type EmbCallResult = { code: i32, raw: i64 }

fn verify_decoded(module: DecodedModule) -> i32 = do
  let mut proto_index = 0
  let mut failed = false
  while proto_index < module.protos.length() && !failed do
    const proto = module.protos[proto_index]
    const verified = verify_function(proto.words, proto.register_count, proto.constants.length())
    const is_err = match verified {
      VerifyErr(_code, _at) => true,
      VerifyOk => false
    }
    if is_err then
      failed = true
    end
    proto_index = proto_index + 1
  end
  if failed then
    emb_verify()
  else
    emb_ok()
  end
end

fn find_export_proto(module: DecodedModule, export_name: string) -> i32 = do
  let mut index = 0
  while index < module.exports.length() do
    if module.exports[index].name == export_name then
      return module.exports[index].proto_index
    end
    index = index + 1
  end
  0 - 1
end

fn run_err_to_code(code: string) -> i32 = do
  if code == run_err_verify() then
    emb_verify()
  else if code == run_err_type() then
    emb_type()
  else if code == run_err_bounds() then
    emb_bounds()
  else if code == run_err_stack() then
    emb_stack()
  else if code == run_err_instruction_limit() then
    emb_instruction_limit()
  else if code == run_err_heap_limit() then
    emb_heap_limit()
  else if code == run_err_overflow() then
    emb_overflow()
  else if code == run_err_div_zero() then
    emb_div_zero()
  else
    emb_type()
  end
end

fn zero_instruction_limit() -> i64 = 0

export fn emb_verify_module_bytes(bytes: [i32]) -> i32 = do
  const decoded = decode_module(bytes)
  if decoded.code != emb_ok() then
    decoded.code
  else
    verify_decoded(decoded.module)
  end
end

export fn emb_call_export_bytes_limited(
  bytes: [i32],
  export_name: string,
  arg_raws: [i64],
  instruction_limit: i64,
  heap_limit_objects: i32
) -> EmbCallResult = do
  const decoded = decode_module(bytes)
  if decoded.code != emb_ok() then
    EmbCallResult { code: decoded.code, raw: embedding_u8_to_i64(0) }
  else
    const verify_code = verify_decoded(decoded.module)
    if verify_code != emb_ok() then
      EmbCallResult { code: verify_code, raw: embedding_u8_to_i64(0) }
    else
      const proto_index = find_export_proto(decoded.module, export_name)
      if proto_index < 0 then
        EmbCallResult { code: emb_not_found(), raw: embedding_u8_to_i64(0) }
      else
        let mut args: [Value] = []
        let mut arg_index = 0
        while arg_index < arg_raws.length() do
          args.push(Value { raw: arg_raws[arg_index] })
          arg_index = arg_index + 1
        end
        const ran = run_program_with_args_limited(
          heap_new(),
          decoded.module.protos,
          proto_index,
          args,
          run_limits_new(instruction_limit, heap_limit_objects)
        )
        match ran.result {
          RunOk(value) => EmbCallResult { code: emb_ok(), raw: value.raw },
          RunErr(code, _at) => EmbCallResult { code: run_err_to_code(code), raw: embedding_u8_to_i64(0) }
        }
      end
    end
  end
end

export fn emb_call_export_bytes(bytes: [i32], export_name: string, arg_raws: [i64]) -> EmbCallResult =
  emb_call_export_bytes_limited(bytes, export_name, arg_raws, zero_instruction_limit(), 0)

export fn emb_verify_module_ptr(data_pointer: i64, size: i32) -> i32 =
  emb_verify_module_bytes(bytes_from_pointer(data_pointer, size))

export fn emb_has_export_ptr(data_pointer: i64, size: i32, export_name: string) -> i32 = do
  const decoded = decode_module(bytes_from_pointer(data_pointer, size))
  if decoded.code != emb_ok() then
    0
  else
    const proto_index = find_export_proto(decoded.module, export_name)
    if proto_index < 0 then 0 else 1 end
  end
end

export fn emb_call_export_ptr_limited(
  data_pointer: i64,
  size: i32,
  export_name: string,
  args_pointer: i64,
  argc: i32,
  result_out_pointer: i64,
  instruction_limit: i64,
  heap_limit_objects: i32
) -> i32 = do
  let mut arg_raws: [i64] = []
  let mut arg_index = 0
  while arg_index < argc do
    arg_raws.push(embedding_i64_at(args_pointer, arg_index))
    arg_index = arg_index + 1
  end
  const result = emb_call_export_bytes_limited(
    bytes_from_pointer(data_pointer, size),
    export_name,
    arg_raws,
    instruction_limit,
    heap_limit_objects
  )
  if result.code == emb_ok() then
    const _stored = embedding_i64_store(result_out_pointer, result.raw)
  end
  result.code
end

export fn emb_call_export_ptr(
  data_pointer: i64,
  size: i32,
  export_name: string,
  args_pointer: i64,
  argc: i32,
  result_out_pointer: i64
) -> i32 =
  emb_call_export_ptr_limited(data_pointer, size, export_name, args_pointer, argc, result_out_pointer, zero_instruction_limit(), 0)

export fn emb_add1_fixture_byte_at(index: i32) -> i32 = do
  const bytes = emb_encode_add1_module()
  if index < 0 || index >= bytes.length() then
    0 - 1
  else
    bytes[index] & 255
  end
end

export fn emb_add1_fixture_size() -> i32 = emb_encode_add1_module().length()
