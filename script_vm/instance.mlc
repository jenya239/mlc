import {
  emb_ok,
  emb_verify,
  emb_type,
  emb_bounds,
  emb_stack,
  emb_not_found,
  emb_bad_handle,
  emb_instruction_limit,
  emb_heap_limit,
  emb_overflow,
  emb_div_zero
} from './embedding_codes'
import {
  execution_root_set_new,
  execution_root_set_with_executions,
  execution_root_set_with_host_results,
  execution_root_set_with_import_arguments,
  execution_root_set_with_persistent,
  execution_root_values
} from './execution_roots'
import { heap_root_push } from './heap_collect'
import { Heap, heap_new } from './heap_types'
import { RunOk, RunErr, run_program_with_args_limited } from './interpreter'
import { LoadedModule, load_module_bytes } from './loaded_module'
import {
  run_limits_new,
  run_err_verify,
  run_err_type,
  run_err_bounds,
  run_err_stack,
  run_err_instruction_limit,
  run_err_heap_limit,
  run_err_overflow,
  run_err_div_zero
} from './run_result'
import { Value, ValueHeapRef, value_decode } from './value'
import { VmState } from './vm_state'

export type ExportHandle = {
  owner_identity: i64,
  module_index: i32,
  export_name: string
}

export type ValueHandle = {
  owner_identity: i64,
  generation: i32,
  raw: i64,
  rooted: bool
}

// Invariants:
// - load, call, and value release stay on the creating owner
// - the instance is not attached to another thread
export type ScriptInstance = {
  identity: i64,
  incarnation: i32,
  loaded_modules: [LoadedModule],
  heap: Heap,
  rooted_values: [Value]
}

export type InstanceLoadResult = { instance: ScriptInstance, code: i32 }

export type InstanceCallResult = {
  instance: ScriptInstance,
  code: i32,
  raw: i64,
  value_handle: ValueHandle
}

fn first_instance_identity() -> i64 = 1

fn persistent_instruction_limit() -> i64 = 1024

fn zero_raw() -> i64 = 0

fn empty_loaded_modules() -> [LoadedModule] = do
  let mut loaded_modules: [LoadedModule] = []
  loaded_modules
end

fn empty_rooted_values() -> [Value] = do
  let mut rooted_values: [Value] = []
  rooted_values
end

fn value_is_heap_ref(value: Value) -> bool =
  match value_decode(value) {
    ValueHeapRef(_object_id) => true,
    _ => false
  }

fn run_error_code(code: string) -> i32 = do
  if code == run_err_verify() then
    emb_verify()
  else if code == run_err_type() then
    emb_type()
  else if code == run_err_bounds() then
    emb_bounds()
  else if code == run_err_stack() then
    emb_stack()
  else if code == run_err_instruction_limit() then
    emb_instruction_limit()
  else if code == run_err_heap_limit() then
    emb_heap_limit()
  else if code == run_err_overflow() then
    emb_overflow()
  else if code == run_err_div_zero() then
    emb_div_zero()
  else
    emb_type()
  end
end

fn instance_with_heap(instance: ScriptInstance, heap: Heap) -> ScriptInstance =
  ScriptInstance {
    identity: instance.identity,
    incarnation: instance.incarnation,
    loaded_modules: instance.loaded_modules,
    heap: heap,
    rooted_values: instance.rooted_values
  }

fn instance_with_modules(instance: ScriptInstance, loaded_modules: [LoadedModule]) -> ScriptInstance =
  ScriptInstance {
    identity: instance.identity,
    incarnation: instance.incarnation,
    loaded_modules: loaded_modules,
    heap: instance.heap,
    rooted_values: instance.rooted_values
  }

fn remember_heap_value(instance: ScriptInstance, value: Value) -> ScriptInstance = do
  let mut rooted_values = instance.rooted_values
  rooted_values.push(value)
  ScriptInstance {
    identity: instance.identity,
    incarnation: instance.incarnation,
    loaded_modules: instance.loaded_modules,
    heap: heap_root_push(instance.heap, value),
    rooted_values: rooted_values
  }
end

fn value_handle_for(instance: ScriptInstance, raw: i64, rooted: bool) -> ValueHandle =
  ValueHandle {
    owner_identity: instance.identity,
    generation: instance.incarnation,
    raw: raw,
    rooted: rooted
  }

fn missing_call(instance: ScriptInstance) -> InstanceCallResult =
  InstanceCallResult {
    instance: instance,
    code: emb_not_found(),
    raw: zero_raw(),
    value_handle: value_handle_for(instance, zero_raw(), false)
  }

fn failed_call(instance: ScriptInstance, code: i32) -> InstanceCallResult =
  InstanceCallResult {
    instance: instance,
    code: code,
    raw: zero_raw(),
    value_handle: value_handle_for(instance, zero_raw(), false)
  }

fn successful_call(instance: ScriptInstance, value: Value) -> InstanceCallResult = do
  const rooted = value_is_heap_ref(value)
  const next = if rooted then remember_heap_value(instance, value) else instance
  InstanceCallResult {
    instance: next,
    code: emb_ok(),
    raw: value.raw,
    value_handle: value_handle_for(next, value.raw, rooted)
  }
end

fn loaded_export_prototype_index(loaded: LoadedModule, export_name: string) -> i32 = do
  let mut index = 0
  while index < loaded.exports.length() do
    if loaded.exports[index].name == export_name then
      return loaded.exports[index].proto_index
    end
    index = index + 1
  end
  0 - 1
end

fn argument_values(argument_raws: [i64]) -> [Value] = do
  let mut arguments: [Value] = []
  let mut argument_index = 0
  while argument_index < argument_raws.length() do
    arguments.push(Value { raw: argument_raws[argument_index] })
    argument_index = argument_index + 1
  end
  arguments
end

export fn script_instance_new() -> ScriptInstance =
  ScriptInstance {
    identity: first_instance_identity(),
    incarnation: 0,
    loaded_modules: empty_loaded_modules(),
    heap: heap_new(),
    rooted_values: empty_rooted_values()
  }

export fn instance_export_handle(
  instance: ScriptInstance,
  module_index: i32,
  export_name: string
) -> ExportHandle =
  ExportHandle {
    owner_identity: instance.identity,
    module_index: module_index,
    export_name: export_name
  }

export fn instance_load_module(instance: ScriptInstance, bytes: [i32]) -> InstanceLoadResult = do
  const loaded_result = load_module_bytes(bytes)
  if loaded_result.code != emb_ok() then
    InstanceLoadResult { instance: instance, code: loaded_result.code }
  else
    let mut loaded_modules = instance.loaded_modules
    loaded_modules.push(loaded_result.loaded)
    InstanceLoadResult {
      instance: instance_with_modules(instance, loaded_modules),
      code: emb_ok()
    }
  end
end

export fn instance_call_export(
  instance: ScriptInstance,
  module_index: i32,
  export_name: string,
  argument_raws: [i64]
) -> InstanceCallResult = do
  if module_index < 0 || module_index >= instance.loaded_modules.length() then
    return missing_call(instance)
  end
  const loaded = instance.loaded_modules[module_index]
  const prototype_index = loaded_export_prototype_index(loaded, export_name)
  if prototype_index < 0 || prototype_index >= loaded.protos.length() then
    return missing_call(instance)
  end
  const ran = run_program_with_args_limited(
    instance.heap,
    loaded.protos,
    prototype_index,
    argument_values(argument_raws),
    run_limits_new(persistent_instruction_limit(), 0)
  )
  const continued = instance_with_heap(instance, ran.heap)
  match ran.result {
    RunOk(value) => successful_call(continued, value),
    RunErr(code, _at) => failed_call(continued, run_error_code(code))
  }
end

fn instance_with_incarnation(instance: ScriptInstance, incarnation: i32) -> ScriptInstance =
  ScriptInstance {
    identity: instance.identity,
    incarnation: incarnation,
    loaded_modules: instance.loaded_modules,
    heap: instance.heap,
    rooted_values: instance.rooted_values
  }

fn handle_is_current(instance: ScriptInstance, handle: ValueHandle) -> bool =
  handle.owner_identity == instance.identity && handle.generation == instance.incarnation

fn handles_are_current(instance: ScriptInstance, handles: [ValueHandle]) -> bool = do
  let mut index = 0
  let mut current = true
  while index < handles.length() && current do
    if !handle_is_current(instance, handles[index]) then
      current = false
    end
    index = index + 1
  end
  current
end

fn handle_raws(handles: [ValueHandle]) -> [i64] = do
  let mut raws: [i64] = []
  let mut index = 0
  while index < handles.length() do
    raws.push(handles[index].raw)
    index = index + 1
  end
  raws
end

export type InstanceReleaseResult = { instance: ScriptInstance, code: i32 }

export fn instance_release_value(instance: ScriptInstance, handle: ValueHandle) -> InstanceReleaseResult =
  if !handle_is_current(instance, handle) then
    InstanceReleaseResult { instance: instance, code: emb_bad_handle() }
  else
    InstanceReleaseResult {
      instance: instance_with_incarnation(instance, instance.incarnation + 1),
      code: emb_ok()
    }
  end

export fn instance_execution_roots(
  instance: ScriptInstance,
  execution_states: [VmState],
  pending_import_arguments: [Value]
) -> [Value] = do
  let mut root_set = execution_root_set_new()
  root_set = execution_root_set_with_persistent(root_set, instance.rooted_values)
  root_set = execution_root_set_with_host_results(root_set, instance.rooted_values)
  root_set = execution_root_set_with_executions(root_set, execution_states)
  root_set = execution_root_set_with_import_arguments(root_set, pending_import_arguments)
  execution_root_values(root_set)
end

export fn instance_call_handles(
  instance: ScriptInstance,
  module_index: i32,
  export_name: string,
  handles: [ValueHandle]
) -> InstanceCallResult =
  if !handles_are_current(instance, handles) then
    failed_call(instance, emb_bad_handle())
  else
    instance_call_export(instance, module_index, export_name, handle_raws(handles))
  end
