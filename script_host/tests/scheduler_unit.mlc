import { ActorRecord, actor_new } from '../actor'
import {
  mailbox_message_completion,
  mailbox_message_normal
} from '../mailbox'
import {
  SchedulerAccepted,
  SchedulerAdmission,
  SchedulerBusy,
  SchedulerDeadlock,
  SchedulerDispatch,
  SchedulerDispatchCompletion,
  SchedulerDispatchControl,
  SchedulerDispatchIdle,
  SchedulerDispatchStarted,
  scheduler_enqueue,
  scheduler_fairness_new,
  scheduler_finish_turn,
  scheduler_note_waiting,
  scheduler_pick_fair,
  scheduler_queued_count,
  scheduler_try_dispatch,
  scheduler_wait_for_actor
} from '../scheduler'

fn fail(message: string) -> i32 = do
  println("[script_vm scheduler_unit] FAIL: " + message)
  1
end

fn logical_identity() -> i64 = 1

fn other_identity() -> i64 = 2

fn principal() -> i64 = 7

fn flood_principal() -> i64 = 7

fn other_principal() -> i64 = 13

fn flood_actor_count() -> i32 = 1000

fn other_actor_count() -> i32 = 1

fn fairness_fuel() -> i32 = 10

fn mailbox_capacity() -> i32 = 8

fn button_command() -> i32 = 1

fn completion_command() -> i32 = 2

fn admission_is_busy(admission: SchedulerAdmission) -> bool =
  match admission {
    SchedulerBusy => true,
    SchedulerAccepted => false,
    SchedulerDeadlock => false
  }

fn admission_is_deadlock(admission: SchedulerAdmission) -> bool =
  match admission {
    SchedulerDeadlock => true,
    SchedulerAccepted => false,
    SchedulerBusy => false
  }

fn dispatch_kind(dispatch: SchedulerDispatch) -> string =
  match dispatch {
    SchedulerDispatchIdle => "Idle",
    SchedulerDispatchStarted(_command) => "Started",
    SchedulerDispatchControl(_command) => "Control",
    SchedulerDispatchCompletion(_command) => "Completion"
  }

fn check_second_normal_waits_for_turn() -> i32 = do
  let mut actor = actor_new(logical_identity(), 0, 0, principal(), 0, mailbox_capacity(), 0)
  let first_push = scheduler_enqueue(actor, mailbox_message_normal(button_command()))
  let second_push = scheduler_enqueue(actor, mailbox_message_normal(button_command()))
  if admission_is_busy(first_push) || admission_is_busy(second_push) then
    return fail("normal messages were Busy")
  end
  let first = scheduler_try_dispatch(actor)
  if dispatch_kind(first) != "Started" || !actor.active_execution then
    return fail("first turn did not start kind=" + dispatch_kind(first))
  end
  actor = scheduler_note_waiting(actor)
  if actor.waiting_requests <= 0 then
    return fail("first turn completed before second message was considered")
  end
  let second = scheduler_try_dispatch(actor)
  if dispatch_kind(second) == "Started" then
    return fail(
      "second turn started before first completed waiting_timer="
        + actor.active_execution.to_string()
        + " counter=0 messages=2"
    )
  end
  if dispatch_kind(second) != "Idle" || scheduler_queued_count(actor) != 1 then
    return fail(
      "second normal was not held queued kind="
        + dispatch_kind(second)
        + " queued="
        + scheduler_queued_count(actor).to_string()
    )
  end
  0
end

fn check_completion_passes_during_turn() -> i32 = do
  let mut actor = actor_new(logical_identity(), 0, 0, principal(), 0, mailbox_capacity(), 0)
  let first_push = scheduler_enqueue(actor, mailbox_message_normal(button_command()))
  if admission_is_busy(first_push) then
    return fail("normal message was Busy")
  end
  let first = scheduler_try_dispatch(actor)
  if dispatch_kind(first) != "Started" then
    return fail("turn missing before completion kind=" + dispatch_kind(first))
  end
  let completion_push = scheduler_enqueue(actor, mailbox_message_completion(completion_command()))
  if admission_is_busy(completion_push) then
    return fail("completion was Busy")
  end
  let completion = scheduler_try_dispatch(actor)
  if dispatch_kind(completion) != "Completion" || !actor.active_execution then
    return fail(
      "completion did not pass during turn kind="
        + dispatch_kind(completion)
        + " active="
        + actor.active_execution.to_string()
    )
  end
  0
end

fn check_self_wait_deadlock() -> i32 = do
  let actor = actor_new(logical_identity(), 0, 0, principal(), 0, mailbox_capacity(), 0)
  let self_wait = scheduler_wait_for_actor(actor, logical_identity())
  if !admission_is_deadlock(self_wait) then
    return fail("actor wait on self was not deadlock")
  end
  let other_wait = scheduler_wait_for_actor(actor, other_identity())
  if admission_is_deadlock(other_wait) || admission_is_busy(other_wait) then
    return fail("wait on other actor was rejected")
  end
  0
end

fn identity_from_index(index: i32) -> i64 = index + 1

fn check_flood_principal_share() -> i32 = do
  let mut actors: [ActorRecord] = []
  let mut flood_index = 0
  while flood_index < flood_actor_count() do
    actors.push(
      actor_new(identity_from_index(flood_index), 0, 0, flood_principal(), flood_index, mailbox_capacity(), 0)
    )
    flood_index = flood_index + 1
  end
  let mut other_index = 0
  while other_index < other_actor_count() do
    actors.push(
      actor_new(
        identity_from_index(flood_actor_count() + other_index),
        0,
        0,
        other_principal(),
        flood_actor_count() + other_index,
        mailbox_capacity(),
        0
      )
    )
    other_index = other_index + 1
  end
  let mut fairness = scheduler_fairness_new()
  let mut flood_turns = 0
  let mut other_turns = 0
  let mut slice = 0
  while slice < fairness_fuel() do
    let picked = scheduler_pick_fair(actors, fairness)
    if !picked.found then
      return fail("fair pick missed actors slice=" + slice.to_string())
    end
    fairness = picked.fairness
    if actors[picked.actor_index].principal == flood_principal() then
      flood_turns = flood_turns + 1
    else
      other_turns = other_turns + 1
    end
    slice = slice + 1
  end
  if flood_turns == other_turns then
    return 0
  end
  fail(
    "flood principal share is actor-weighted flood_turns="
      + flood_turns.to_string()
      + " other_turns="
      + other_turns.to_string()
      + " flood_actors="
      + flood_actor_count().to_string()
      + " other_actors="
      + other_actor_count().to_string()
  )
end

fn check_second_starts_after_finish() -> i32 = do
  let mut actor = actor_new(logical_identity(), 0, 0, principal(), 0, mailbox_capacity(), 0)
  let first_push = scheduler_enqueue(actor, mailbox_message_normal(button_command()))
  let second_push = scheduler_enqueue(actor, mailbox_message_normal(button_command()))
  if admission_is_busy(first_push) || admission_is_busy(second_push) then
    return fail("normal messages were Busy before finish")
  end
  let first = scheduler_try_dispatch(actor)
  if dispatch_kind(first) != "Started" then
    return fail("first turn missing kind=" + dispatch_kind(first))
  end
  actor = scheduler_finish_turn(actor)
  let second = scheduler_try_dispatch(actor)
  if dispatch_kind(second) != "Started" then
    return fail("second turn did not start after finish kind=" + dispatch_kind(second))
  end
  0
end

fn main() -> i32 = do
  let wait_status = check_second_normal_waits_for_turn()
  if wait_status != 0 then
    return wait_status
  end
  let completion_status = check_completion_passes_during_turn()
  if completion_status != 0 then
    return completion_status
  end
  let deadlock_status = check_self_wait_deadlock()
  if deadlock_status != 0 then
    return deadlock_status
  end
  let finish_status = check_second_starts_after_finish()
  if finish_status != 0 then
    return finish_status
  end
  let flood_status = check_flood_principal_share()
  if flood_status != 0 then
    return flood_status
  end
  println("[script_vm] scheduler_unit ok")
  0
end
