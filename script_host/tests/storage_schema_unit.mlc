import {
  SqliteHandleErr,
  SqliteHandleOk,
  SqliteHandleResult,
  SqliteUnitErr,
  SqliteUnitOk,
  SqliteUnitResult,
  close_db,
  exec,
  open_memory
} from '../../lib/mlc/common/stdlib/db/sqlite.mlc'

fn fail(message: string) -> i32 = do
  println("[script_vm storage_schema_unit] FAIL: " + message)
  1
end

fn handle_of(value: SqliteHandleResult) -> i32 =
  match value {
    SqliteHandleOk(handle) => handle,
    SqliteHandleErr(_) => 0
  }

fn write_failed(value: SqliteUnitResult) -> bool =
  match value {
    SqliteUnitOk => false,
    SqliteUnitErr(_error) => true
  }

fn storage_owner_thread_present() -> i32 = 0

fn insert_actor_state_sql() -> string =
  "INSERT INTO actor_state(actor_id, schema_version, module_hash, revision, fencing_token, state_blob) VALUES ('a', 1, 'h', 1, 1, x'00')"

fn insert_actor_inbox_sql() -> string =
  "INSERT INTO actor_inbox(actor_id, message_id, payload_hash, status) VALUES ('a', 'm', 'p', 'queued')"

fn insert_effect_outbox_sql() -> string =
  "INSERT INTO effect_outbox(actor_id, effect_id, operation_kind, arguments_blob, idempotency_key, status) VALUES ('a', 'e', 'k', x'00', 'i', 'pending')"

fn check_schema() -> i32 = do
  let connection = handle_of(open_memory())
  if connection <= 0 then
    return fail("sqlite memory connection failed")
  end
  let state_write = exec(connection, insert_actor_state_sql())
  let inbox_write = exec(connection, insert_actor_inbox_sql())
  let outbox_write = exec(connection, insert_effect_outbox_sql())
  let closed_status = close_db(connection)
  if write_failed(closed_status) then
    return fail("sqlite close failed")
  end
  if !write_failed(state_write) || !write_failed(inbox_write) || !write_failed(outbox_write) then
    return fail("actor schema already present")
  end
  if storage_owner_thread_present() == 0 then
    return fail("no actor_state actor_inbox effect_outbox storage owner thread")
  end
  0
end

fn main() -> i32 = do
  let status = check_schema()
  if status != 0 then
    return status
  end
  println("[script_vm] storage_schema_unit ok")
  0
end
