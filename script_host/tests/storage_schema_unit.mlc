import {
  SqliteHandleErr,
  SqliteHandleOk,
  SqliteHandleResult,
  SqliteUnitErr,
  SqliteUnitOk,
  SqliteUnitResult,
  close_db
} from '../../lib/mlc/common/stdlib/db/sqlite.mlc'
import {
  state_store_accepts_foreign_thread_handle,
  state_store_insert_actor_inbox,
  state_store_insert_actor_state,
  state_store_insert_effect_outbox,
  state_store_open_memory,
  state_store_revision_ceiling,
  state_store_revision_rejected,
  storage_owner_thread_present
} from '../state_store'

fn fail(message: string) -> i32 = do
  println("[script_vm storage_schema_unit] FAIL: " + message)
  1
end

fn handle_of(value: SqliteHandleResult) -> i32 =
  match value {
    SqliteHandleOk(handle) => handle,
    SqliteHandleErr(_) => 0
  }

fn write_failed(value: SqliteUnitResult) -> bool =
  match value {
    SqliteUnitOk => false,
    SqliteUnitErr(_error) => true
  }

fn i64_from_i32(value: i32) -> i64 = value

fn check_schema() -> i32 = do
  if storage_owner_thread_present() == 0 then
    return fail("no actor_state actor_inbox effect_outbox storage owner thread")
  end
  if state_store_accepts_foreign_thread_handle() != 0 then
    return fail("connection handle accepted on a foreign thread")
  end
  let connection = handle_of(state_store_open_memory())
  if connection <= 0 then
    return fail("sqlite memory connection failed")
  end
  let revision = i64_from_i32(1)
  let fencing_token = i64_from_i32(1)
  let schema_version = i64_from_i32(1)
  let state_write = state_store_insert_actor_state(
    connection,
    "a",
    schema_version,
    "h",
    revision,
    fencing_token
  )
  let inbox_write = state_store_insert_actor_inbox(connection, "a", "m", "p", "queued")
  let outbox_write = state_store_insert_effect_outbox(connection, "a", "e", "k", "i", "pending")
  if write_failed(state_write) || write_failed(inbox_write) || write_failed(outbox_write) then
    let closed_status = close_db(connection)
    if write_failed(closed_status) then
      return fail("no actor_state actor_inbox effect_outbox storage owner thread")
    end
    return fail("no actor_state actor_inbox effect_outbox storage owner thread")
  end
  let negative = i64_from_i32(0) - i64_from_i32(1)
  if !state_store_revision_rejected(negative, fencing_token) then
    let closed_status = close_db(connection)
    if write_failed(closed_status) then
      return fail("negative revision accepted")
    end
    return fail("negative revision accepted")
  end
  if !state_store_revision_rejected(state_store_revision_ceiling(), fencing_token) then
    let closed_status = close_db(connection)
    if write_failed(closed_status) then
      return fail("exhausted revision wrapped")
    end
    return fail("exhausted revision wrapped")
  end
  let closed_status = close_db(connection)
  if write_failed(closed_status) then
    return fail("sqlite close failed")
  end
  0
end

fn main() -> i32 = do
  let status = check_schema()
  if status != 0 then
    return status
  end
  println("[script_vm] storage_schema_unit ok")
  0
end
