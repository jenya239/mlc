import {
  reload_does_not_interrupt_live_stack,
  reload_during_active_turn_deferred_to_idle,
  reload_migration_failure_rolls_back,
  reload_old_epoch_keeps_effect_result,
  reload_old_epoch_reply_skips_callback,
  reload_waits_for_turn_boundary
} from '../reload'

fn fail(message: string) -> i32 = do
  println("[script_vm reload_epoch_unit] FAIL: " + message)
  1
end

fn check_idle_turn_reload() -> i32 = do
  if reload_during_active_turn_deferred_to_idle() == 0 then
    return fail("reload during active turn replaced live instance without idle boundary")
  end
  if reload_does_not_interrupt_live_stack() == 0 then
    return fail("reload interrupted live stack")
  end
  if reload_waits_for_turn_boundary() == 0 then
    return fail("reload did not wait for turn boundary")
  end
  if reload_migration_failure_rolls_back() == 0 then
    return fail("migration failure did not roll back")
  end
  if reload_old_epoch_reply_skips_callback() == 0 then
    return fail("old epoch reply fired callback")
  end
  if reload_old_epoch_keeps_effect_result() == 0 then
    return fail("old epoch reply dropped durable effect result")
  end
  0
end

fn main() -> i32 = do
  let status = check_idle_turn_reload()
  if status != 0 then
    return status
  end
  println("[script_vm] reload_epoch_unit ok")
  0
end
