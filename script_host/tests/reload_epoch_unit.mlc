fn fail(message: string) -> i32 = do
  println("[script_vm reload_epoch_unit] FAIL: " + message)
  1
end

fn reload_during_active_turn_deferred_to_idle() -> i32 = 0

fn reload_does_not_interrupt_live_stack() -> i32 = 0

fn reload_waits_for_turn_boundary() -> i32 = 0

fn check_idle_turn_reload() -> i32 = do
  if reload_during_active_turn_deferred_to_idle() == 0 then
    return fail("reload during active turn replaced live instance without idle boundary")
  end
  if reload_does_not_interrupt_live_stack() == 0 then
    return fail("reload interrupted live stack")
  end
  if reload_waits_for_turn_boundary() == 0 then
    return fail("reload did not wait for turn boundary")
  end
  0
end

fn main() -> i32 = do
  let status = check_idle_turn_reload()
  if status != 0 then
    return status
  end
  println("[script_vm] reload_epoch_unit ok")
  0
end
