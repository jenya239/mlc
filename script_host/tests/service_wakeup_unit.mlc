import {
  ServiceAdmission,
  ServiceAccepted,
  ServiceBusy,
  ServicePop,
  ServicePopCommand,
  ServicePopEmpty,
  service_queue_new,
  service_queue_count,
  service_try_push,
  service_try_pop,
  service_observe_before_wait,
  service_note_wakeup_hint,
  service_arm_wait
} from '../service'

fn fail(message: string) -> i32 = do
  println("[script_vm service_wakeup_unit] FAIL: " + message)
  1
end

fn queue_capacity() -> i32 = 8

fn owner_identity() -> i64 = 1

fn completion_code() -> i32 = 41

fn admission_is_busy(admission: ServiceAdmission) -> bool =
  match admission {
    ServiceBusy => true,
    ServiceAccepted => false
  }

fn pop_command(pop: ServicePop) -> i32 =
  match pop {
    ServicePopCommand(command_code) => command_code,
    ServicePopEmpty => 0
  }

fn check_idle_wait() -> i32 = do
  let queue = service_queue_new(queue_capacity(), owner_identity())
  let observed = service_observe_before_wait(queue)
  let armed = service_arm_wait(queue, observed)
  if armed.saw_wakeup || service_queue_count(queue) != 0 then
    return fail("idle wait woke without a completion")
  end
  0
end

fn main() -> i32 = do
  let idle = check_idle_wait()
  if idle != 0 then
    return idle
  end
  let mut queue = service_queue_new(queue_capacity(), owner_identity())
  if service_queue_count(queue) != 0 then
    return fail("queue was not empty before the race")
  end
  let observed = service_observe_before_wait(queue)
  let admission = service_try_push(queue, completion_code())
  if admission_is_busy(admission) then
    return fail("completion push was Busy")
  end
  let hinted = service_note_wakeup_hint(queue, observed)
  if hinted.saw_wakeup then
    return fail("wakeup hint was treated as the completion")
  end
  let armed = service_arm_wait(queue, hinted)
  let queued = service_queue_count(queue)
  if !armed.saw_wakeup then
    return fail(
      "lost wakeup queued=" + queued.to_string()
        + " saw_wakeup=false"
        + " wait_armed=true"
    )
  end
  let popped = service_try_pop(queue)
  if pop_command(popped) != completion_code() || service_queue_count(queue) != 0 then
    return fail("queue was not authoritative after wakeup")
  end
  println("[script_vm] service_wakeup_unit ok")
  0
end
