fn fail(message: string) -> i32 = do
  println("[script_vm ipc_codec_unit] FAIL: " + message)
  1
end

fn empty_bytes() -> [i32] = do
  let mut bytes: [i32] = []
  bytes
end

fn local_encode_hello() -> [i32] = empty_bytes()

fn local_encode_load_module() -> [i32] = empty_bytes()

fn local_encode_host_request() -> [i32] = empty_bytes()

fn local_encode_host_reply() -> [i32] = empty_bytes()

fn bytes_empty(bytes: [i32]) -> bool = bytes.length() == 0

fn main() -> i32 = do
  if bytes_empty(local_encode_hello())
    || bytes_empty(local_encode_load_module())
    || bytes_empty(local_encode_host_request())
    || bytes_empty(local_encode_host_reply())
  then
    return fail(
      "no Header protocol_major protocol_minor kind payload_size session_epoch sequence request_id Hello LoadModule HostRequest HostReply"
    )
  end
  println("[script_vm] ipc_codec_unit ok")
  0
end
