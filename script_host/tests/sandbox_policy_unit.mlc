fn fail(message: string) -> i32 = do
  println("[script_vm sandbox_policy_unit] FAIL: " + message)
  1
end

fn sandbox_env_allowlist_present() -> i32 = 0

fn sandbox_no_new_privs_applied() -> i32 = 0

fn sandbox_filesystem_isolated() -> i32 = 0

fn sandbox_network_isolated() -> i32 = 0

fn sandbox_display_passed_to_child() -> i32 = 1

fn check_linux_policy() -> i32 = do
  if sandbox_env_allowlist_present() == 0 then
    return fail("no env allowlist no_new_privs filesystem network isolation")
  end
  if sandbox_no_new_privs_applied() == 0 then
    return fail("no_new_privs not applied")
  end
  if sandbox_filesystem_isolated() == 0 then
    return fail("filesystem isolation missing")
  end
  if sandbox_network_isolated() == 0 then
    return fail("network isolation missing")
  end
  if sandbox_display_passed_to_child() != 0 then
    return fail("DISPLAY passed to child")
  end
  0
end

fn main() -> i32 = do
  let status = check_linux_policy()
  if status != 0 then
    return status
  end
  println("[script_vm] sandbox_policy_unit ok")
  0
end
