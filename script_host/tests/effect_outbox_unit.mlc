fn fail(message: string) -> i32 = do
  println("[script_vm effect_outbox_unit] FAIL: " + message)
  1
end

fn effect_outbox_reconcile_after_crash() -> i32 = 0

fn effect_outbox_idempotency_key_present() -> i32 = 0

fn effect_outbox_unknown_without_status_check() -> i32 = 0

fn check_crash_between_send_and_ack() -> i32 = do
  if effect_outbox_idempotency_key_present() == 0 then
    return fail("crash between send and ack lost effect without Unknown or idempotency_key")
  end
  if effect_outbox_reconcile_after_crash() == 0 then
    return fail("unfinished effect not detected after restart")
  end
  if effect_outbox_unknown_without_status_check() == 0 then
    return fail("missing status check did not become Unknown")
  end
  0
end

fn main() -> i32 = do
  let status = check_crash_between_send_and_ack()
  if status != 0 then
    return status
  end
  println("[script_vm] effect_outbox_unit ok")
  0
end
