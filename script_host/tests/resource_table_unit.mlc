import { WidgetId, widget_id_none } from '../../misc/textui/store'

type ExternalReference = RawWidgetIndex(i32) | ResourceHandle(i32)

fn fail(message: string) -> i32 = do
  println("[script_vm resource_table_unit] FAIL: " + message)
  1
end

fn existing_widget() -> WidgetId =
  WidgetId { index: 3 }

fn external_reference(widget: WidgetId) -> ExternalReference =
  RawWidgetIndex(widget.index)

fn reference_is_handle(reference: ExternalReference) -> bool =
  match reference {
    ResourceHandle(_generation) => true,
    RawWidgetIndex(_index) => false
  }

fn reference_index(reference: ExternalReference) -> i32 =
  match reference {
    RawWidgetIndex(index) => index,
    ResourceHandle(_generation) => 0
  }

fn main() -> i32 = do
  let widget = existing_widget()
  if widget.index == widget_id_none().index then
    return fail("fixture widget is none")
  end
  let reference = external_reference(widget)
  if reference_is_handle(reference) && reference_index(reference) != widget.index then
    println("[script_vm] resource_table_unit ok")
    return 0
  end
  fail("resource handle absent widget_index=" + widget.index.to_string())
end
