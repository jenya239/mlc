import {
  Subscription,
  SubscriptionApplied,
  SubscriptionApply,
  SubscriptionDelta,
  SubscriptionRejected,
  SubscriptionResetRequired,
  subscription_apply,
  subscription_from_snapshot,
  subscription_subscribe
} from '../subscriptions'

fn fail(message: string) -> i32 = do
  println("[script_vm subscription_unit] FAIL: " + message)
  1
end

fn original_label() -> string = "base"

fn slow_worker_label() -> string = "slow"

fn fast_worker_label() -> string = "fast"

fn apply_kind(result: SubscriptionApply) -> string =
  match result {
    SubscriptionApplied(_cursor) => "Applied",
    SubscriptionResetRequired => "ResetRequired",
    SubscriptionRejected => "Rejected"
  }

fn fast_delta(subscription: Subscription) -> SubscriptionDelta =
  SubscriptionDelta {
    base_revision: subscription.revision,
    revision: subscription.revision + 1,
    sequence: subscription.sequence + 1,
    subscription_epoch: subscription.subscription_epoch,
    text: fast_worker_label()
  }

fn stale_slow_delta(base_revision: i32, epoch: i32) -> SubscriptionDelta =
  SubscriptionDelta {
    base_revision: base_revision,
    revision: base_revision + 1,
    sequence: 1,
    subscription_epoch: epoch,
    text: slow_worker_label()
  }

fn overflow_delta(subscription: Subscription) -> SubscriptionDelta =
  SubscriptionDelta {
    base_revision: subscription.revision,
    revision: subscription.revision + 1,
    sequence: subscription.sequence + 2,
    subscription_epoch: subscription.subscription_epoch,
    text: slow_worker_label()
  }

fn check_stale_worker_rejected() -> i32 = do
  let snapshot = subscription_subscribe(original_label())
  if snapshot.revision != snapshot.cursor.revision then
    return fail("subscribe snapshot revision and cursor were not atomic")
  end
  let mut subscription = subscription_from_snapshot(snapshot)
  let slow_job_base_revision = subscription.revision
  let fast = subscription_apply(subscription, fast_delta(subscription))
  if apply_kind(fast) != "Applied" || subscription.text != fast_worker_label() || subscription.revision != 1 then
    return fail(
      "out-of-order fast worker did not publish shown="
        + subscription.text
        + " revision="
        + subscription.revision.to_string()
    )
  end
  let current_revision = subscription.revision
  let slow = subscription_apply(subscription, stale_slow_delta(slow_job_base_revision, subscription.subscription_epoch))
  if apply_kind(slow) == "Applied" || subscription.text == slow_worker_label() then
    return fail(
      "stale worker result applied over newer revision shown="
        + subscription.text
        + " slow_base_revision="
        + slow_job_base_revision.to_string()
        + " current_revision="
        + current_revision.to_string()
        + " handle_slot=0"
    )
  end
  if subscription.text != fast_worker_label() then
    return fail("expected current revision label shown=" + subscription.text)
  end
  0
end

fn check_overflow_reset_required() -> i32 = do
  let mut subscription = subscription_from_snapshot(subscription_subscribe(original_label()))
  let overflow = subscription_apply(subscription, overflow_delta(subscription))
  if apply_kind(overflow) != "ResetRequired" then
    return fail("overflow delta was not ResetRequired kind=" + apply_kind(overflow))
  end
  if subscription.text != original_label() || subscription.revision != 0 then
    return fail("overflow silently mutated snapshot shown=" + subscription.text)
  end
  0
end

fn main() -> i32 = do
  let stale_status = check_stale_worker_rejected()
  if stale_status != 0 then
    return stale_status
  end
  let overflow_status = check_overflow_reset_required()
  if overflow_status != 0 then
    return overflow_status
  end
  println("[script_vm] subscription_unit ok")
  0
end
