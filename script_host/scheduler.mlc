import {
  ActorRecord,
  actor_lifecycle_idle,
  actor_lifecycle_running,
  actor_lifecycle_waiting
} from './actor'
import {
  MailboxAccepted,
  MailboxBusy,
  MailboxMessage,
  MailboxTakeEmpty,
  MailboxTakeMessage,
  mailbox_class_completion,
  mailbox_class_control,
  mailbox_class_normal,
  mailbox_count,
  mailbox_try_push,
  mailbox_try_take
} from './mailbox'

export type SchedulerAdmission = SchedulerAccepted | SchedulerBusy | SchedulerDeadlock

export type SchedulerDispatch =
  SchedulerDispatchIdle
  | SchedulerDispatchStarted(i32)
  | SchedulerDispatchControl(i32)
  | SchedulerDispatchCompletion(i32)

export fn scheduler_enqueue(actor: ref mut ActorRecord, message: MailboxMessage) -> SchedulerAdmission =
  match mailbox_try_push(actor.bounded_mailbox, message) {
    MailboxBusy => SchedulerBusy,
    MailboxAccepted => SchedulerAccepted
  }

export fn scheduler_wait_for_actor(actor: ActorRecord, waited_logical_identity: i64) -> SchedulerAdmission = do
  if waited_logical_identity == actor.logical_identity then
    SchedulerDeadlock
  else
    SchedulerAccepted
  end
end

export fn scheduler_note_waiting(actor: ActorRecord) -> ActorRecord =
  ActorRecord {
    logical_identity: actor.logical_identity,
    incarnation: actor.incarnation,
    code_epoch: actor.code_epoch,
    principal: actor.principal,
    instance: actor.instance,
    bounded_mailbox: actor.bounded_mailbox,
    active_execution: true,
    waiting_requests: actor.waiting_requests + 1,
    lifecycle: actor_lifecycle_waiting(),
    budgets: actor.budgets
  }

export fn scheduler_finish_turn(actor: ActorRecord) -> ActorRecord =
  ActorRecord {
    logical_identity: actor.logical_identity,
    incarnation: actor.incarnation,
    code_epoch: actor.code_epoch,
    principal: actor.principal,
    instance: actor.instance,
    bounded_mailbox: actor.bounded_mailbox,
    active_execution: false,
    waiting_requests: 0,
    lifecycle: actor_lifecycle_idle(),
    budgets: actor.budgets
  }

fn dispatch_from_take(actor: ref mut ActorRecord, message: MailboxMessage) -> SchedulerDispatch = do
  if message.class_code == mailbox_class_control() then
    return SchedulerDispatchControl(message.command_code)
  end
  if message.class_code == mailbox_class_completion() then
    return SchedulerDispatchCompletion(message.command_code)
  end
  actor.active_execution = true
  actor.lifecycle = actor_lifecycle_running()
  SchedulerDispatchStarted(message.command_code)
end

export fn scheduler_try_dispatch(actor: ref mut ActorRecord) -> SchedulerDispatch = do
  let allow_normal = !actor.active_execution
  match mailbox_try_take(actor.bounded_mailbox, allow_normal) {
    MailboxTakeEmpty => SchedulerDispatchIdle,
    MailboxTakeMessage(message) => dispatch_from_take(actor, message)
  }
end

export fn scheduler_queued_count(actor: ActorRecord) -> i32 = mailbox_count(actor.bounded_mailbox)

export fn scheduler_message_is_normal(message: MailboxMessage) -> bool =
  message.class_code == mailbox_class_normal()

export type SchedulerFairness = {
  next_principal_slot: i32,
  member_cursors: [i32]
}

export type SchedulerFairPick = {
  actor_index: i32,
  fairness: SchedulerFairness,
  found: bool
}

fn empty_cursors() -> [i32] = do
  let mut cursors: [i32] = []
  cursors
end

export fn scheduler_fairness_new() -> SchedulerFairness =
  SchedulerFairness { next_principal_slot: 0, member_cursors: empty_cursors() }

fn principal_listed(principals: [i64], principal: i64) -> bool = do
  let mut index = 0
  while index < principals.length() do
    if principals[index] == principal then
      return true
    end
    index = index + 1
  end
  false
end

fn collect_principals(actors: [ActorRecord]) -> [i64] = do
  let mut principals: [i64] = []
  let mut index = 0
  while index < actors.length() do
    let principal = actors[index].principal
    if !principal_listed(principals, principal) then
      principals.push(principal)
    end
    index = index + 1
  end
  principals
end

fn collect_member_indices(actors: [ActorRecord], principal: i64) -> [i32] = do
  let mut members: [i32] = []
  let mut index = 0
  while index < actors.length() do
    if actors[index].principal == principal then
      members.push(index)
    end
    index = index + 1
  end
  members
end

fn padded_cursors(cursors: [i32], principal_count: i32) -> [i32] = do
  let mut next = cursors
  while next.length() < principal_count do
    next.push(0)
  end
  next
end

export fn scheduler_pick_fair(actors: [ActorRecord], fairness: SchedulerFairness) -> SchedulerFairPick = do
  let principals = collect_principals(actors)
  if principals.length() <= 0 then
    return SchedulerFairPick { actor_index: 0, fairness: fairness, found: false }
  end
  let mut member_cursors = padded_cursors(fairness.member_cursors, principals.length())
  let mut wrapped_slot = fairness.next_principal_slot
  while wrapped_slot >= principals.length() do
    wrapped_slot = wrapped_slot - principals.length()
  end
  let members = collect_member_indices(actors, principals[wrapped_slot])
  if members.length() <= 0 then
    return SchedulerFairPick { actor_index: 0, fairness: fairness, found: false }
  end
  let mut wrapped_member = member_cursors[wrapped_slot]
  while wrapped_member >= members.length() do
    wrapped_member = wrapped_member - members.length()
  end
  member_cursors.set(wrapped_slot, wrapped_member + 1)
  let next_principal_slot = wrapped_slot + 1
  SchedulerFairPick {
    actor_index: members[wrapped_member],
    fairness: SchedulerFairness {
      next_principal_slot: next_principal_slot,
      member_cursors: member_cursors
    },
    found: true
  }
end
