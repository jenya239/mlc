export type ServiceAdmission = ServiceAccepted | ServiceBusy

export type ServicePop = ServicePopEmpty | ServicePopCommand(i32)

export type ServiceQueue = {
  commands: [i32],
  head: i32,
  count: i32,
  capacity: i32,
  owner_identity: i64,
  sequence: i32
}

export type ServiceWaiter = {
  armed: bool,
  observed_sequence: i32,
  saw_wakeup: bool
}

fn empty_commands() -> [i32] = do
  let mut commands: [i32] = []
  commands
end

fn non_negative_capacity(capacity: i32) -> i32 = do
  if capacity <= 0 then
    return 0
  end
  capacity
end

fn fill_slots(commands: ref mut [i32], capacity: i32) -> unit = do
  let mut index = 0
  while index < capacity do
    commands.push(0)
    index = index + 1
  end
end

export fn service_queue_new(capacity: i32, owner_identity: i64) -> ServiceQueue = do
  let stored_capacity = non_negative_capacity(capacity)
  let mut commands = empty_commands()
  fill_slots(commands, stored_capacity)
  ServiceQueue {
    commands: commands,
    head: 0,
    count: 0,
    capacity: stored_capacity,
    owner_identity: owner_identity,
    sequence: 0
  }
end

export fn service_queue_count(queue: ServiceQueue) -> i32 = queue.count

export fn service_queue_capacity(queue: ServiceQueue) -> i32 = queue.capacity

export fn service_queue_owner_identity(queue: ServiceQueue) -> i64 = queue.owner_identity

fn slot_index(head: i32, offset: i32, capacity: i32) -> i32 = do
  let index = head + offset
  if index >= capacity then
    index - capacity
  else
    index
  end
end

export fn service_try_push(queue: ref mut ServiceQueue, command_code: i32) -> ServiceAdmission = do
  if queue.count >= queue.capacity then
    ServiceBusy
  else
    let index = slot_index(queue.head, queue.count, queue.capacity)
    queue.commands.set(index, command_code)
    queue.count = queue.count + 1
    queue.sequence = queue.sequence + 1
    ServiceAccepted
  end
end

export fn service_try_pop(queue: ref mut ServiceQueue) -> ServicePop = do
  if queue.count <= 0 then
    ServicePopEmpty
  else
    let command_code = queue.commands[queue.head]
    queue.head = queue.head + 1
    if queue.head >= queue.capacity then
      queue.head = 0
    end
    queue.count = queue.count - 1
    queue.sequence = queue.sequence + 1
    ServicePopCommand(command_code)
  end
end

export fn service_queue_sequence(queue: ServiceQueue) -> i32 = queue.sequence

export fn service_observe_before_wait(queue: ServiceQueue) -> ServiceWaiter = do
  ServiceWaiter {
    armed: false,
    observed_sequence: queue.sequence,
    saw_wakeup: false
  }
end

fn sequence_moved(queue: ServiceQueue, waiter: ServiceWaiter) -> bool =
  queue.sequence != waiter.observed_sequence

export fn service_note_wakeup_hint(queue: ServiceQueue, waiter: ServiceWaiter) -> ServiceWaiter = do
  if !waiter.armed then
    waiter
  else
    ServiceWaiter {
      armed: waiter.armed,
      observed_sequence: waiter.observed_sequence,
      saw_wakeup: waiter.saw_wakeup || sequence_moved(queue, waiter)
    }
  end
end

export fn service_arm_wait(queue: ServiceQueue, waiter: ServiceWaiter) -> ServiceWaiter = do
  ServiceWaiter {
    armed: true,
    observed_sequence: waiter.observed_sequence,
    saw_wakeup: sequence_moved(queue, waiter)
  }
end

export type CounterActor = {
  export_name: string,
  export_count: i32,
  mapped_widget_count: i32,
  mapped_widget_index: i32,
  counter: i32,
  waiting_timer: bool,
  executor_issues_submit: bool
}

export fn counter_actor_export_name() -> string = "increment"

export fn counter_actor_button_command() -> i32 = 1

export fn service_timer_after_command() -> i32 = 2

export fn service_timer_after_delay_milliseconds() -> i32 = 100

export fn service_thread_issues_submit() -> bool = false

export fn service_timer_uses_run_until_on_ui_thread() -> bool = false

export fn service_timer_after_arm(queue: ref mut ServiceQueue, delay_milliseconds: i32) -> ServiceAdmission = do
  if service_timer_uses_run_until_on_ui_thread() || delay_milliseconds < 0 then
    ServiceBusy
  else
    service_try_push(queue, service_timer_after_command())
  end
end

export fn counter_actor_slice_quantum() -> i32 = 10

export fn counter_actor_busy_work() -> i32 = 1000

export fn counter_actor_new() -> CounterActor =
  CounterActor {
    export_name: counter_actor_export_name(),
    export_count: 1,
    mapped_widget_count: 1,
    mapped_widget_index: 0,
    counter: 0,
    waiting_timer: false,
    executor_issues_submit: service_thread_issues_submit()
  }

export fn counter_actor_label_text(actor: CounterActor) -> string =
  actor.counter.to_string()

export fn counter_actor_apply_button(actor: CounterActor) -> CounterActor =
  CounterActor {
    export_name: actor.export_name,
    export_count: actor.export_count,
    mapped_widget_count: actor.mapped_widget_count,
    mapped_widget_index: actor.mapped_widget_index,
    counter: actor.counter + 1,
    waiting_timer: false,
    executor_issues_submit: service_thread_issues_submit()
  }

fn counter_actor_begin_timer_wait(actor: CounterActor) -> CounterActor =
  CounterActor {
    export_name: actor.export_name,
    export_count: actor.export_count,
    mapped_widget_count: actor.mapped_widget_count,
    mapped_widget_index: actor.mapped_widget_index,
    counter: actor.counter,
    waiting_timer: true,
    executor_issues_submit: service_thread_issues_submit()
  }

export fn counter_actor_handle_command(actor: CounterActor, command_code: i32) -> CounterActor = do
  if command_code == counter_actor_button_command() then
    counter_actor_begin_timer_wait(actor)
  else if command_code == service_timer_after_command() && actor.waiting_timer then
    counter_actor_apply_button(actor)
  else
    actor
  end
end

export fn counter_actor_slice_remaining(remaining_work: i32, quantum: i32) -> i32 = do
  if remaining_work <= quantum then
    0
  else
    remaining_work - quantum
  end
end

export fn counter_actor_slice_yielded(remaining_work: i32, quantum: i32) -> bool =
  remaining_work > quantum
