// MIR bootstrap report: per-function MIR summary vs CppIR signature (TRACK_MIR STEP=8).
// §104-6 slice 1: surfaces lower_error_count from mir_lower_items (errors not dropped).

import { SemanticLoadItem } from '../ir/semantic_ir'
import { CppDeclaration, CppFnDef } from '../cpp_ir/cpp_ast'
import { MirProgram, MirModule, MirFunction } from './mir_types'
import { mir_lower_items } from './lower_program'
import { mir_function_is_simple, mir_function_to_cpp_declaration } from '../cpp_ir/mir_to_cpp'

export type MirBootstrapFunctionEntry = MirBootstrapFunctionEntry {
  function_name: string,
  mir_block_count: i32,
  cpp_ok: bool,
  cpp_signature: string
}

export type MirBootstrapReport = MirBootstrapReport {
  mir_function_count: i32,
  simple_function_count: i32,
  cpp_ok_count: i32,
  cpp_skip_count: i32,
  lower_error_count: i32,
  lower_errors: [string],
  entries: [MirBootstrapFunctionEntry]
}

fn mir_bootstrap_cpp_signature_from_declaration(declaration: Shared<CppDeclaration>) -> string =
  match declaration {
    CppFnDef(_, return_type, name, _, _, _) =>
      `${return_type} ${name}()`,
    _ => ""
  }

fn mir_bootstrap_block_count(function: MirFunction) -> i32 = do
  let mut block_count = 0
  let mut block_index = 0
  while block_index < function.blocks.length() do
    block_count = block_count + 1
    block_index = block_index + 1
  end
  block_count
end

fn mir_bootstrap_entry_for_complex_function(function: MirFunction) -> MirBootstrapFunctionEntry =
  MirBootstrapFunctionEntry {
    function_name: function.name,
    mir_block_count: mir_bootstrap_block_count(function),
    cpp_ok: false,
    cpp_signature: ''
  }

fn mir_bootstrap_cpp_signature_for_function(function: MirFunction) -> string =
  match mir_function_to_cpp_declaration(function) {
    Ok(declaration) => mir_bootstrap_cpp_signature_from_declaration(declaration),
    Err(_) => ''
  }

fn mir_bootstrap_entry_for_simple_function(function: MirFunction) -> MirBootstrapFunctionEntry = do
  const signature = mir_bootstrap_cpp_signature_for_function(function)
  MirBootstrapFunctionEntry {
    function_name: function.name,
    mir_block_count: mir_bootstrap_block_count(function),
    cpp_ok: signature != '',
    cpp_signature: signature
  }
end

fn mir_bootstrap_entry_for_function(function: MirFunction) -> MirBootstrapFunctionEntry =
  match mir_function_is_simple(function) {
    true => mir_bootstrap_entry_for_simple_function(function),
    false => mir_bootstrap_entry_for_complex_function(function),
  }

fn mir_bootstrap_append_function_entries(
  entries: [MirBootstrapFunctionEntry],
  functions: [MirFunction],
  index: i32
) -> [MirBootstrapFunctionEntry] = do
  if index >= functions.length() then return entries end
  let mut next_entries = entries
  next_entries.push(mir_bootstrap_entry_for_function(functions[index]))
  mir_bootstrap_append_function_entries(next_entries, functions, index + 1)
end

fn mir_bootstrap_count_cpp_ok(entries: [MirBootstrapFunctionEntry], index: i32, count: i32) -> i32 = do
  if index >= entries.length() then return count end
  const entry = entries[index]
  const next_count = if entry.cpp_ok then count + 1 else count end
  mir_bootstrap_count_cpp_ok(entries, index + 1, next_count)
end

fn mir_bootstrap_count_simple_functions(functions: [MirFunction], index: i32, count: i32) -> i32 = do
  if index >= functions.length() then return count end
  const next_count = if mir_function_is_simple(functions[index]) then count + 1 else count end
  mir_bootstrap_count_simple_functions(functions, index + 1, next_count)
end

fn mir_bootstrap_array_length_i32(items: [MirFunction]) -> i32 = do
  let mut count = 0
  let mut index = 0
  while index < items.length() do
    count = count + 1
    index = index + 1
  end
  count
end

fn mir_bootstrap_string_array_length(items: [string]) -> i32 = do
  let mut count = 0
  let mut index = 0
  while index < items.length() do
    count = count + 1
    index = index + 1
  end
  count
end

export fn build_mir_bootstrap_report_with_lower_errors(
  program: MirProgram,
  lower_errors: [string]
) -> MirBootstrapReport = do
  const functions = program.modules[0].functions
  const entries = mir_bootstrap_append_function_entries([], functions, 0)
  const cpp_ok_count = mir_bootstrap_count_cpp_ok(entries, 0, 0)
  MirBootstrapReport {
    mir_function_count: mir_bootstrap_array_length_i32(functions),
    simple_function_count: mir_bootstrap_count_simple_functions(functions, 0, 0),
    cpp_ok_count: cpp_ok_count,
    cpp_skip_count: mir_bootstrap_array_length_i32(functions) - cpp_ok_count,
    lower_error_count: mir_bootstrap_string_array_length(lower_errors),
    lower_errors: lower_errors,
    entries: entries
  }
end

export fn build_mir_bootstrap_report(program: MirProgram) -> MirBootstrapReport =
  build_mir_bootstrap_report_with_lower_errors(program, [])

export fn build_mir_bootstrap_report_from_semantic_items(items: [SemanticLoadItem]) -> MirBootstrapReport = do
  const accum = mir_lower_items(items)
  const program = MirProgram { modules: [MirModule { functions: accum.functions }] }
  build_mir_bootstrap_report_with_lower_errors(program, accum.errors)
end

fn mir_bootstrap_append_entry_lines(lines: [string], entries: [MirBootstrapFunctionEntry], index: i32) -> [string] =
  if index >= entries.length() then lines
  else do
    const entry = entries[index]
    let mut next_lines = lines
    if entry.cpp_ok then
      next_lines.push(
        `  fn ${entry.function_name} blocks=${entry.mir_block_count} cpp_ok signature=${entry.cpp_signature}`)
    else
      next_lines.push(
        `  fn ${entry.function_name} blocks=${entry.mir_block_count} cpp_skip`)
    end
    mir_bootstrap_append_entry_lines(next_lines, entries, index + 1)
  end

fn mir_bootstrap_append_lower_error_lines(
  lines: [string],
  errors: [string],
  index: i32,
  max_errors: i32
) -> [string] = do
  if index >= errors.length() then return lines end
  if index >= max_errors then return lines end
  let mut next_lines = lines
  next_lines.push(`  lower_error: ${errors[index]}`)
  mir_bootstrap_append_lower_error_lines(next_lines, errors, index + 1, max_errors)
end

type MirBootstrapHistEntry = MirBootstrapHistEntry {
  message: string,
  count: i32
}

fn mir_bootstrap_hist_find_index(
  entries: [MirBootstrapHistEntry],
  message: string,
  index: i32
) -> i32 = do
  if index >= entries.length() then return -1 end
  if entries[index].message == message then return index end
  mir_bootstrap_hist_find_index(entries, message, index + 1)
end

fn mir_bootstrap_hist_replace_at(
  entries: [MirBootstrapHistEntry],
  target_index: i32,
  replacement: MirBootstrapHistEntry,
  index: i32,
  accumulated: [MirBootstrapHistEntry]
) -> [MirBootstrapHistEntry] = do
  if index >= entries.length() then return accumulated end
  let mut next_accumulated = accumulated
  if index == target_index then
    next_accumulated.push(replacement)
  else
    next_accumulated.push(entries[index])
  end
  mir_bootstrap_hist_replace_at(entries, target_index, replacement, index + 1, next_accumulated)
end

fn mir_bootstrap_hist_push_new(
  entries: [MirBootstrapHistEntry],
  message: string
) -> [MirBootstrapHistEntry] = do
  let mut next_entries = entries
  next_entries.push(MirBootstrapHistEntry { message: message, count: 1 })
  next_entries
end

fn mir_bootstrap_hist_bump(
  entries: [MirBootstrapHistEntry],
  found: i32
) -> [MirBootstrapHistEntry] = do
  const previous = entries[found]
  mir_bootstrap_hist_replace_at(
    entries,
    found,
    MirBootstrapHistEntry { message: previous.message, count: previous.count + 1 },
    0,
    [])
end

fn mir_bootstrap_hist_accumulate(
  entries: [MirBootstrapHistEntry],
  errors: [string],
  index: i32
) -> [MirBootstrapHistEntry] = do
  if index >= errors.length() then return entries end
  const message = errors[index]
  const found = mir_bootstrap_hist_find_index(entries, message, 0)
  if found < 0 then
    return mir_bootstrap_hist_accumulate(
      mir_bootstrap_hist_push_new(entries, message), errors, index + 1)
  end
  mir_bootstrap_hist_accumulate(mir_bootstrap_hist_bump(entries, found), errors, index + 1)
end

fn mir_bootstrap_hist_append_one(
  entries: [MirBootstrapHistEntry],
  entry: MirBootstrapHistEntry
) -> [MirBootstrapHistEntry] = do
  let mut next_entries = entries
  next_entries.push(entry)
  next_entries
end

fn mir_bootstrap_hist_append_tail(
  destination: [MirBootstrapHistEntry],
  source: [MirBootstrapHistEntry],
  index: i32
) -> [MirBootstrapHistEntry] = do
  if index >= source.length() then return destination end
  let mut next_destination = destination
  next_destination.push(source[index])
  mir_bootstrap_hist_append_tail(next_destination, source, index + 1)
end

fn mir_bootstrap_hist_insert_sorted(
  sorted: [MirBootstrapHistEntry],
  entry: MirBootstrapHistEntry,
  index: i32,
  accumulated: [MirBootstrapHistEntry]
) -> [MirBootstrapHistEntry] =
  if index >= sorted.length() then
    mir_bootstrap_hist_append_one(accumulated, entry)
  else if entry.count > sorted[index].count then
    mir_bootstrap_hist_append_tail(
      mir_bootstrap_hist_append_one(accumulated, entry),
      sorted,
      index)
  else
    mir_bootstrap_hist_insert_sorted(
      sorted,
      entry,
      index + 1,
      mir_bootstrap_hist_append_one(accumulated, sorted[index]))
  end

fn mir_bootstrap_hist_sort_by_count_desc(
  entries: [MirBootstrapHistEntry],
  index: i32,
  sorted: [MirBootstrapHistEntry]
) -> [MirBootstrapHistEntry] =
  if index >= entries.length() then sorted
  else
    mir_bootstrap_hist_sort_by_count_desc(
      entries,
      index + 1,
      mir_bootstrap_hist_insert_sorted(sorted, entries[index], 0, []))
  end

fn mir_bootstrap_append_hist_lines(
  lines: [string],
  entries: [MirBootstrapHistEntry],
  index: i32
) -> [string] = do
  if index >= entries.length() then return lines end
  const entry = entries[index]
  let mut next_lines = lines
  next_lines.push(`lower_error_hist: ${entry.message}=${entry.count}`)
  mir_bootstrap_append_hist_lines(next_lines, entries, index + 1)
end

fn mir_bootstrap_join_lines(lines: [string]) -> string = do
  if lines.length() == 0 then return "" end
  let mut result = lines[0]
  let mut index = 1
  while index < lines.length() do
    result = result + "\n" + lines[index]
    index = index + 1
  end
  result
end

export fn print_mir_bootstrap_report(report: MirBootstrapReport) -> string = do
  let mut lines: [string] = [
    `mir_functions=${report.mir_function_count} simple=${report.simple_function_count} cpp_ok=${report.cpp_ok_count} cpp_skip=${report.cpp_skip_count} lower_error_count=${report.lower_error_count}`
  ]
  const hist_entries = mir_bootstrap_hist_sort_by_count_desc(
    mir_bootstrap_hist_accumulate([], report.lower_errors, 0),
    0,
    [])
  lines = mir_bootstrap_append_hist_lines(lines, hist_entries, 0)
  lines = mir_bootstrap_append_lower_error_lines(lines, report.lower_errors, 0, 32)
  lines = mir_bootstrap_append_entry_lines(lines, report.entries, 0)
  mir_bootstrap_join_lines(lines)
end

export fn mir_bootstrap_report_cpp_matches_mir(report: MirBootstrapReport) -> bool = do
  let mut index = 0
  while index < report.entries.length() do
    const entry = report.entries[index]
    if entry.cpp_ok && !entry.cpp_signature.contains(entry.function_name) then return false end
    index = index + 1
  end
  true
end
