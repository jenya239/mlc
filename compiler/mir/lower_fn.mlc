// fold → index walk + inline 2-arg callback over accumulator (no VM HOF native).
fn mir_lower_array_fold_hof_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  init: Shared<SemanticExpression>,
  callback: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_resolve_predicate_callback(state, callback, 2) {
    Err(errors) => Err(errors),
    Ok(binding) =>
      if binding.parameter_names.length() != 2 then
        Err(['mir lower: fold callback expects two parameters'])
      else
        match mir_lower_expression_to_local(state, object) {
          Err(errors) => Err(errors),
          Ok(array_step) =>
            match mir_lower_expression_to_local(array_step.state, init) {
              Err(errors) => Err(errors),
              Ok(acc_step) => do
                let mut prep_state = acc_step.state
                const index_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
                prep_state = mir_lower_emit_assign(
                  index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
                const loop_header_step = mir_lower_allocate_block_index(prep_state)
                const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
                const exit_block_step = mir_lower_allocate_block_index(body_block_step.state)
                const hof_blocks_allocated_state = exit_block_step.state
                prep_state = mir_lower_finish_current_block(
                  hof_blocks_allocated_state, MirJump(loop_header_step.block_id))
                prep_state = mir_lower_start_block(
                  prep_state, loop_header_step.block_id, 'hof_fold_loop')
                const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
                prep_state = mir_lower_emit_call_assign(
                  length_step.state,
                  length_step.local_id,
                  '__mir_length',
                  [MirOperandLocal(array_step.local_id)])
                const less_op = "<"
                const compare_step = mir_lower_temp_operand_from_rvalue(
                  prep_state,
                  MirRvalueBinary(
                    less_op,
                    MirOperandLocal(index_step.local_id),
                    MirOperandLocal(length_step.local_id)))
                prep_state = mir_lower_finish_current_block(
                  compare_step.state,
                  MirCondJump(
                    compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
                prep_state = mir_lower_start_block(
                  prep_state, body_block_step.block_id, 'hof_fold_body')
                const element_step = mir_lower_allocate_local(
                  prep_state, '', mir_lower_unknown_type())
                prep_state = mir_lower_emit_call_assign(
                  element_step.state,
                  element_step.local_id,
                  '__mir_array_get',
                  [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
                const next_acc_step = mir_lower_allocate_local(
                  prep_state, '', mir_lower_unknown_type())
                match mir_lower_lambda_inline_body(
                  next_acc_step.state,
                  binding.parameter_names,
                  binding.body,
                  [
                    MirOperandLocal(acc_step.local_id),
                    MirOperandLocal(element_step.local_id)
                  ],
                  next_acc_step.local_id) {
                  Err(errors) => Err(errors),
                  Ok(after_callback) => do
                    let mut body_state = mir_lower_emit_assign(
                      after_callback,
                      acc_step.local_id,
                      MirRvalueUse(MirOperandLocal(next_acc_step.local_id)))
                    const add_op = "+"
                    const next_index_step = mir_lower_temp_operand_from_rvalue(
                      body_state,
                      MirRvalueBinary(
                        add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
                    body_state = mir_lower_emit_assign(
                      next_index_step.state,
                      index_step.local_id,
                      MirRvalueUse(next_index_step.operand))
                    body_state = mir_lower_finish_current_block(
                      body_state, MirJump(loop_header_step.block_id))
                    body_state = mir_lower_start_block(
                      body_state, exit_block_step.block_id, 'hof_fold_exit')
                    Ok(MirLowerLocalStep { state: body_state, local_id: acc_step.local_id })
                  end
                }
              end
            }
        }
      end
  }

fn mir_lower_method_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> =
  if (method_name == 'any' || method_name == 'all') && arguments.length() == 1 then
    mir_lower_array_predicate_hof_to_local(state, object, method_name, arguments[0])
  else if method_name == 'filter' && arguments.length() == 1 then
    mir_lower_array_filter_hof_to_local(state, object, arguments[0])
  else if method_name == 'find_index' && arguments.length() == 1 then
    mir_lower_array_find_index_hof_to_local(state, object, arguments[0])
  else if method_name == 'map' && arguments.length() == 1 then
    mir_lower_array_map_hof_to_local(state, object, arguments[0])
  else if method_name == 'flat_map' && arguments.length() == 1 then
    mir_lower_array_flat_map_hof_to_local(state, object, arguments[0])
  else if method_name == 'fold' && arguments.length() == 2 then
    mir_lower_array_fold_hof_to_local(state, object, arguments[0], arguments[1])
  else if method_name == 'pop' && arguments.length() == 0 then
    match object {
      SemanticExpressionIdent(array_name, _, _) =>
        mir_lower_array_pop_expression(state, array_name),
      _ => Err(['mir lower: pop requires identifier receiver'])
    }
  else
    match object {
      SemanticExpressionIdent(receiver_name, _, _) =>
        if receiver_name == 'Map' && method_name == 'new' && arguments.length() == 0 then
          mir_lower_map_new_local(state)
        else if receiver_name == 'Shared' && method_name == 'new' then
          mir_lower_shared_new_to_local(state, arguments)
        else
          match mir_lower_lookup_local(state, receiver_name) {
            Ok(_) => mir_lower_method_call_on_operand(state, object, method_name, arguments),
            Err(_) =>
              if receiver_name == 'File' then
                mir_lower_file_static_method_to_local(state, method_name, arguments)
              else
                mir_lower_module_qualified_method_to_local(state, method_name, arguments)
              end
          }
        end,
      _ => mir_lower_method_call_on_operand(state, object, method_name, arguments)
    }
  end

fn mir_lower_method_call_on_operand(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_method_native_name(method_name) {
    Err(errors) => Err(errors),
    Ok(native_name) =>
      match mir_lower_operand_from_expression(state, object) {
        Err(errors) => Err(errors),
        Ok(object_step) =>
          match mir_lower_method_operands_with_receiver(
            object_step.state, object_step.operand, arguments) {
            Err(errors) => Err(errors),
            Ok(operands_step) => do
              const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
              Ok(MirLowerLocalStep {
                state: mir_lower_emit_call_assign(
                  local_step.state, local_step.local_id, native_name, operands_step.operands),
                local_id: local_step.local_id
              })
            end
          }
      }
  }

type MirLowerMethodOperandsStep = MirLowerMethodOperandsStep {
  state: MirLowerState,
  operands: [MirOperand]
}

fn mir_lower_collect_method_operands(
  state: MirLowerState,
  object_operand: MirOperand,
  arguments: [Shared<SemanticExpression>],
  index: i32,
  operands: [MirOperand]
) -> Result<MirLowerMethodOperandsStep, [string]> =
  if index >= arguments.length() then
    Ok(MirLowerMethodOperandsStep { state: state, operands: operands })
  else
    match mir_lower_operand_from_expression(state, arguments[index]) {
      Err(errors) => Err(errors),
      Ok(argument_step) => do
        let mut next_operands = operands
        next_operands.push(argument_step.operand)
        mir_lower_collect_method_operands(
          argument_step.state, object_operand, arguments, index + 1, next_operands)
      end
    }
  end

fn mir_lower_method_operands_with_receiver(
  state: MirLowerState,
  object_operand: MirOperand,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerMethodOperandsStep, [string]> = do
  let mut operands: [MirOperand] = [object_operand]
  mir_lower_collect_method_operands(state, object_operand, arguments, 0, operands)
end

fn mir_lower_mutating_method_statement(
  state: MirLowerState,
  local_id: LocalId,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerState, [string]> =
  match mir_lower_method_native_name(method_name) {
    Err(errors) => Err(errors),
    Ok(native_name) =>
      match mir_lower_method_operands_with_receiver(
        state, MirOperandLocal(local_id), arguments) {
        Err(errors) => Err(errors),
        Ok(operands_step) => do
          const result_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
          const call_state = mir_lower_emit_call_assign(
            result_step.state, result_step.local_id, native_name, operands_step.operands)
          Ok(mir_lower_emit_assign(
            call_state, local_id, MirRvalueUse(MirOperandLocal(result_step.local_id))))
        end
      }
  }

type MirLowerCallOperandsStep = MirLowerCallOperandsStep { state: MirLowerState, operands: [MirOperand] }

fn mir_lower_collect_operands(
  state: MirLowerState,
  arguments: [Shared<SemanticExpression>],
  index: i32,
  operands: [MirOperand]
) -> Result<MirLowerCallOperandsStep, [string]> =
  if index >= arguments.length() then
    Ok(MirLowerCallOperandsStep { state: state, operands: operands })
  else
    match mir_lower_operand_from_expression(state, arguments[index]) {
      Err(errors) => Err(errors),
      Ok(step) => do
        let mut next_operands = operands
        next_operands.push(step.operand)
        mir_lower_collect_operands(step.state, arguments, index + 1, next_operands)
      end
    }
  end

fn mir_lower_operands_from_arguments(
  state: MirLowerState,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerCallOperandsStep, [string]> =
  mir_lower_collect_operands(state, arguments, 0, [])

fn mir_lower_record_new_arguments_from_fields(
  state: MirLowerState,
  type_name: string,
  field_values: [Shared<SemanticFieldVal>],
  index: i32,
  arguments: [MirOperand]
) -> Result<MirLowerCallOperandsStep, [string]> =
  if index >= field_values.length() then
    Ok(MirLowerCallOperandsStep { state: state, operands: arguments })
  else
    match mir_lower_operand_from_expression(state, field_values[index].value) {
      Err(errors) => Err(errors),
      Ok(value_step) => do
        let mut next_arguments = arguments
        next_arguments.push(MirOperandConstStr(field_values[index].name))
        next_arguments.push(value_step.operand)
        mir_lower_record_new_arguments_from_fields(
          value_step.state, type_name, field_values, index + 1, next_arguments)
      end
    }
  end

fn mir_lower_record_literal_to_local(
  state: MirLowerState,
  type_name: string,
  field_values: [Shared<SemanticFieldVal>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_record_new_arguments_from_fields(
    state, type_name, field_values, 0, [MirOperandConstStr(type_name)]) {
    Err(errors) => Err(errors),
    Ok(arguments_step) => do
      const local_step = mir_lower_allocate_local(arguments_step.state, '', mir_lower_unknown_type())
      Ok(MirLowerLocalStep {
        state: mir_lower_emit_call_assign(
          local_step.state, local_step.local_id, '__mir_record_new', arguments_step.operands),
        local_id: local_step.local_id
      })
    end
  }

fn mir_lower_record_update_apply_fields(
  state: MirLowerState,
  record_local_id: LocalId,
  field_values: [Shared<SemanticFieldVal>],
  index: i32
) -> Result<MirLowerLocalStep, [string]> =
  if index >= field_values.length() then
    Ok(MirLowerLocalStep { state: state, local_id: record_local_id })
  else
    match mir_lower_operand_from_expression(state, field_values[index].value) {
      Err(errors) => Err(errors),
      Ok(value_step) => do
        const result_step = mir_lower_allocate_local(value_step.state, '', mir_lower_unknown_type())
        const updated_state = mir_lower_emit_call_assign(
          result_step.state,
          result_step.local_id,
          '__mir_record_with_field',
          [
            MirOperandLocal(record_local_id),
            MirOperandConstStr(field_values[index].name),
            value_step.operand
          ])
        mir_lower_record_update_apply_fields(
          updated_state, result_step.local_id, field_values, index + 1)
      end
    }
  end

fn mir_lower_record_update_to_local(
  state: MirLowerState,
  base: Shared<SemanticExpression>,
  field_values: [Shared<SemanticFieldVal>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_expression_to_local(state, base) {
    Err(errors) => Err(errors),
    Ok(base_step) =>
      mir_lower_record_update_apply_fields(
        base_step.state, base_step.local_id, field_values, 0)
  }

fn mir_lower_field_mutating_method_statement(
  state: MirLowerState,
  record_local_id: LocalId,
  field_name: string,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerState, [string]> = do
  const field_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  const field_loaded = mir_lower_emit_call_assign(
    field_step.state,
    field_step.local_id,
    '__mir_record_field',
    [MirOperandLocal(record_local_id), MirOperandConstStr(field_name)])
  match mir_lower_mutating_method_statement(
    field_loaded, field_step.local_id, method_name, arguments) {
    Err(errors) => Err(errors),
    Ok(mutated_state) => do
      const write_step = mir_lower_allocate_local(mutated_state, '', mir_lower_unknown_type())
      const written = mir_lower_emit_call_assign(
        write_step.state,
        write_step.local_id,
        '__mir_record_with_field',
        [
          MirOperandLocal(record_local_id),
          MirOperandConstStr(field_name),
          MirOperandLocal(field_step.local_id)
        ])
      Ok(mir_lower_emit_assign(
        written, record_local_id, MirRvalueUse(MirOperandLocal(write_step.local_id))))
    end
  }
end

fn mir_lower_field_path_writeback(
  state: MirLowerState,
  root_local_id: LocalId,
  field_names: [string],
  chain_locals: [LocalId],
  index: i32
) -> Result<MirLowerState, [string]> =
  if index < 0 then
    Ok(state)
  else do
    const parent_local_id =
      if index == 0 then root_local_id
      else chain_locals[index - 1]
    const child_local_id = chain_locals[index]
    const write_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
    const written = mir_lower_emit_call_assign(
      write_step.state,
      write_step.local_id,
      '__mir_record_with_field',
      [
        MirOperandLocal(parent_local_id),
        MirOperandConstStr(field_names[index]),
        MirOperandLocal(child_local_id)
      ])
    let mut next_state = mir_lower_emit_assign(
      written, parent_local_id, MirRvalueUse(MirOperandLocal(write_step.local_id)))
    if index == 0 then
      next_state = mir_lower_emit_assign(
        next_state, root_local_id, MirRvalueUse(MirOperandLocal(write_step.local_id)))
    end
    mir_lower_field_path_writeback(
      next_state, root_local_id, field_names, chain_locals, index - 1)
  end

fn mir_lower_collect_field_path(
  expression: Shared<SemanticExpression>,
  field_names: [string]
) -> Result<[string], [string]> =
  match expression {
    SemanticExpressionIdent(_, _, _) => Ok(field_names),
    SemanticExpressionField(inner, field_name, _, _) => do
      let mut next_names: [string] = [field_name]
      let mut copy_index = 0
      while copy_index < field_names.length() do
        next_names.push(field_names[copy_index])
        copy_index = copy_index + 1
      end
      mir_lower_collect_field_path(inner, next_names)
    end,
    _ => Err(['mir lower: mutating method requires identifier receiver'])
  }

fn mir_lower_field_path_root_name(
  expression: Shared<SemanticExpression>
) -> Result<string, [string]> =
  match expression {
    SemanticExpressionIdent(name, _, _) => Ok(name),
    SemanticExpressionField(inner, _, _, _) => mir_lower_field_path_root_name(inner),
    _ => Err(['mir lower: mutating method requires identifier receiver'])
  }

fn mir_lower_nested_field_mutating_method_statement(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerState, [string]> =
  match mir_lower_field_path_root_name(object) {
    Err(errors) => Err(errors),
    Ok(record_name) =>
      match mir_lower_lookup_local(state, record_name) {
        Err(errors) => Err(errors),
        Ok(root_local_id) =>
          match mir_lower_collect_field_path(object, []) {
            Err(errors) => Err(errors),
            Ok(field_names) =>
              if field_names.length() == 0 then
                mir_lower_mutating_method_statement(state, root_local_id, method_name, arguments)
              else if field_names.length() == 1 then
                mir_lower_field_mutating_method_statement(
                  state, root_local_id, field_names[0], method_name, arguments)
              else do
                let mut chain_locals: [LocalId] = []
                let mut current_local_id = root_local_id
                let mut current_state = state
                let mut field_index = 0
                while field_index < field_names.length() do
                  const field_step = mir_lower_allocate_local(
                    current_state, '', mir_lower_unknown_type())
                  current_state = mir_lower_emit_call_assign(
                    field_step.state,
                    field_step.local_id,
                    '__mir_record_field',
                    [
                      MirOperandLocal(current_local_id),
                      MirOperandConstStr(field_names[field_index])
                    ])
                  chain_locals.push(field_step.local_id)
                  current_local_id = field_step.local_id
                  field_index = field_index + 1
                end
                match mir_lower_mutating_method_statement(
                  current_state, current_local_id, method_name, arguments) {
                  Err(errors) => Err(errors),
                  Ok(mutated_state) =>
                    mir_lower_field_path_writeback(
                      mutated_state,
                      root_local_id,
                      field_names,
                      chain_locals,
                      field_names.length() - 1)
                }
              end
          }
      }
  }

fn mir_lower_record_field_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  field_name: string
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_operand_from_expression(state, object) {
    Err(errors) => Err(errors),
    Ok(object_step) => do
      const local_step = mir_lower_allocate_local(object_step.state, '', mir_lower_unknown_type())
      Ok(MirLowerLocalStep {
        state: mir_lower_emit_call_assign(
          local_step.state,
          local_step.local_id,
          '__mir_record_field',
          [object_step.operand, MirOperandConstStr(field_name)]),
        local_id: local_step.local_id
      })
    end
  }

type MirLowerOperandStep = MirLowerOperandStep { state: MirLowerState, operand: MirOperand }

fn mir_lower_temp_operand_from_rvalue(state: MirLowerState, rvalue: MirRvalue) -> MirLowerOperandStep = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  const assigned_state = mir_lower_emit_assign(local_step.state, local_step.local_id, rvalue)
  MirLowerOperandStep { state: assigned_state, operand: MirOperandLocal(local_step.local_id) }
end

fn mir_lower_operand_equals_const_int(
  state: MirLowerState,
  left_operand: MirOperand,
  right_value: i32
) -> Result<MirLowerOperandStep, [string]> =
  Ok(mir_lower_temp_operand_from_rvalue(
    state,
    MirRvalueBinary("==", left_operand, MirOperandConstInt(right_value))))

fn mir_lower_operand_equals_const_bool(
  state: MirLowerState,
  left_operand: MirOperand,
  right_value: bool
) -> Result<MirLowerOperandStep, [string]> =
  Ok(mir_lower_temp_operand_from_rvalue(
    state,
    MirRvalueBinary("==", left_operand, MirOperandConstBool(right_value))))

fn mir_lower_operand_from_expression(
  state: MirLowerState,
  expression: Shared<SemanticExpression>
) -> Result<MirLowerOperandStep, [string]> = do
  match expression {
    SemanticExpressionInt(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstInt(value) }),
    SemanticExpressionBool(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstBool(value) }),
    SemanticExpressionStr(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    SemanticExpressionUnit(_, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandUnit }),
    SemanticExpressionTuple(elements, _, _) =>
      if elements.length() == 0 then
        Ok(MirLowerOperandStep { state: state, operand: MirOperandUnit })
      else
        Err(['mir lower: non-empty tuple is not an operand'])
      end,
    SemanticExpressionIdent(name, _, _) =>
      match mir_lower_lookup_local(state, name) {
        Ok(local_id) => Ok(MirLowerOperandStep { state: state, operand: MirOperandLocal(local_id) }),
        Err(_) =>
          if mir_lower_is_variant_ctor_name(name) then
            match mir_lower_expression_to_local(state, expression) {
              Err(errors) => Err(errors),
              Ok(local_step) =>
                Ok(MirLowerOperandStep {
                  state: local_step.state,
                  operand: MirOperandLocal(local_step.local_id)
                })
            }
          else
            match mir_lower_funref_ident_to_local(state, name) {
              Err(errors) => Err(errors),
              Ok(local_step) =>
                Ok(MirLowerOperandStep {
                  state: local_step.state,
                  operand: MirOperandLocal(local_step.local_id)
                })
            }
          end
      },
    SemanticExpressionBin(operation, _, _, _, _) =>
      if mir_lower_is_assign_operation(operation) then
        Err(['mir lower: assignment expression is not an operand'])
      else
        match mir_lower_rvalue_from_expression(state, expression) {
          Err(errors) => Err(errors),
          Ok(rvalue_step) => Ok(mir_lower_temp_operand_from_rvalue(rvalue_step.state, rvalue_step.rvalue))
        }
      end,
    SemanticExpressionUn(operation, _, _, _) =>
      if operation == "move" then
        Err(['mir lower: move expression is not supported in MIR operand context'])
      else
        match mir_lower_rvalue_from_expression(state, expression) {
          Err(errors) => Err(errors),
          Ok(rvalue_step) => Ok(mir_lower_temp_operand_from_rvalue(rvalue_step.state, rvalue_step.rvalue))
        }
      end,
    SemanticExpressionCall(function, arguments, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionArray(_, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionIndex(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionMethod(_, _, _, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionRecord(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionRecordUpdate(_, _, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionField(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionQuestion(_, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
      match mir_lower_if_to_local(state, condition, then_expression, else_expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionBlock(_, _, _, _) =>
      match mir_lower_block_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionMatch(subject, arms, _, _) =>
      match mir_lower_match_to_local(state, subject, arms) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionWith(resource, binder_name, statements, _, _) =>
      match mir_lower_with_to_local(state, resource, binder_name, statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionExtern(_, _, _, _, _) =>
      match mir_lower_extern_to_local(state) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionWhile(condition, body_statements, _, _) =>
      match mir_lower_while_to_local(state, condition, body_statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionFor(variable_name, iterator, body_statements, _, _) =>
      match mir_lower_for_to_local(state, variable_name, iterator, body_statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
      },
    SemanticExpressionChar(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    SemanticExpressionFloat(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    SemanticExpressionI64(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    SemanticExpressionU8(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    SemanticExpressionUsize(value, _, _) =>
      Ok(MirLowerOperandStep { state: state, operand: MirOperandConstStr(value) }),
    _ => Err(['mir lower: unsupported expression in operand context'])
  }
end

type MirLowerRvalueStep = MirLowerRvalueStep { state: MirLowerState, rvalue: MirRvalue }

fn mir_lower_rvalue_from_expression(
  state: MirLowerState,
  expression: Shared<SemanticExpression>
) -> Result<MirLowerRvalueStep, [string]> = do
  match expression {
    SemanticExpressionInt(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstInt(value)) }),
    SemanticExpressionBool(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstBool(value)) }),
    SemanticExpressionStr(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    SemanticExpressionUnit(_, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandUnit) }),
    SemanticExpressionIdent(name, _, _) =>
      match mir_lower_lookup_local(state, name) {
        Ok(local_id) =>
          Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandLocal(local_id)) }),
        Err(_) =>
          if mir_lower_is_variant_ctor_name(name) then
            match mir_lower_expression_to_local(state, expression) {
              Err(errors) => Err(errors),
              Ok(local_step) =>
                Ok(MirLowerRvalueStep {
                  state: local_step.state,
                  rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
                })
            }
          else
            match mir_lower_funref_ident_to_local(state, name) {
              Err(errors) => Err(errors),
              Ok(local_step) =>
                Ok(MirLowerRvalueStep {
                  state: local_step.state,
                  rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
                })
            }
          end
      },
    SemanticExpressionBin(operation, left, right, _, _) =>
      if mir_lower_is_assign_operation(operation) then
        Err(['mir lower: assignment is not an rvalue'])
      else
        match mir_lower_operand_from_expression(state, left) {
          Err(errors) => Err(errors),
          Ok(left_step) =>
            match mir_lower_operand_from_expression(left_step.state, right) {
              Err(errors) => Err(errors),
              Ok(right_step) =>
                Ok(MirLowerRvalueStep {
                  state: right_step.state,
                  rvalue: MirRvalueBinary(operation, left_step.operand, right_step.operand)
                })
            }
        }
      end,
    SemanticExpressionUn(operation, inner, _, _) =>
      if operation == "move" then
        Err(['mir lower: move expression is not supported in MIR rvalue context'])
      else
        match mir_lower_operand_from_expression(state, inner) {
          Err(errors) => Err(errors),
          Ok(inner_step) =>
            Ok(MirLowerRvalueStep {
              state: inner_step.state,
              rvalue: MirRvalueUnary(operation, inner_step.operand)
            })
        }
      end,
    SemanticExpressionCall(function, arguments, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionArray(_, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionIndex(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionMethod(_, _, _, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionRecord(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionRecordUpdate(_, _, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionField(_, _, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionQuestion(_, _, _) =>
      match mir_lower_expression_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
      match mir_lower_if_to_local(state, condition, then_expression, else_expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionBlock(_, _, _, _) =>
      match mir_lower_block_to_local(state, expression) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionMatch(subject, arms, _, _) =>
      match mir_lower_match_to_local(state, subject, arms) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionWith(resource, binder_name, statements, _, _) =>
      match mir_lower_with_to_local(state, resource, binder_name, statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionExtern(_, _, _, _, _) =>
      match mir_lower_extern_to_local(state) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionWhile(condition, body_statements, _, _) =>
      match mir_lower_while_to_local(state, condition, body_statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionFor(variable_name, iterator, body_statements, _, _) =>
      match mir_lower_for_to_local(state, variable_name, iterator, body_statements) {
        Err(errors) => Err(errors),
        Ok(local_step) =>
          Ok(MirLowerRvalueStep {
            state: local_step.state,
            rvalue: MirRvalueUse(MirOperandLocal(local_step.local_id))
          })
      },
    SemanticExpressionChar(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    SemanticExpressionFloat(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    SemanticExpressionI64(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    SemanticExpressionU8(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    SemanticExpressionUsize(value, _, _) =>
      Ok(MirLowerRvalueStep { state: state, rvalue: MirRvalueUse(MirOperandConstStr(value)) }),
    _ => Err(['mir lower: unsupported expression in rvalue context'])
  }
end

fn mir_lower_finish_return(state: MirLowerState, operand: MirOperand) -> MirLowerState =
  mir_lower_finish_current_block(state, MirReturn(operand))

fn mir_lower_return_expression(state: MirLowerState, expression: Shared<SemanticExpression>) -> Result<MirLowerState, [string]> = do
  match expression {
    SemanticExpressionBlock(statements, result_expression, _, _) => do
      match mir_lower_statements(state, statements) {
        Err(errors) => Err(errors),
        Ok(statement_state) => mir_lower_return_expression(statement_state, result_expression)
      }
    end,
    SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
      match mir_lower_operand_from_expression(state, condition) {
        Err(errors) => Err(errors),
        Ok(condition_step) => do
          const then_block_step = mir_lower_allocate_block_index(condition_step.state)
          const else_block_step = mir_lower_allocate_block_index(then_block_step.state)
          let mut branch_state = mir_lower_finish_current_block(
            else_block_step.state,
            MirCondJump(condition_step.operand, then_block_step.block_id, else_block_step.block_id))
          branch_state = mir_lower_start_block(branch_state, then_block_step.block_id, 'then')
          match mir_lower_return_expression(branch_state, then_expression) {
            Err(errors) => Err(errors),
            Ok(then_state) => do
              let mut else_state = mir_lower_start_block(then_state, else_block_step.block_id, 'else')
              mir_lower_return_expression(else_state, else_expression)
            end
          }
        end
      },
    SemanticExpressionUnit(_, _) => Ok(mir_lower_finish_return(state, MirOperandUnit)),
    SemanticExpressionMatch(subject, arms, _, _) => mir_lower_match_return(state, subject, arms),
    SemanticExpressionQuestion(inner, _, _) => mir_lower_question_return(state, inner),
    _ =>
      match mir_lower_operand_from_expression(state, expression) {
        Err(errors) => Err(errors),
        Ok(operand_step) => Ok(mir_lower_finish_return(operand_step.state, operand_step.operand))
      }
  }
end

fn mir_lower_emit_call_to_local(
  state: MirLowerState,
  callee_name: string,
  arguments: [MirOperand]
) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  Ok(MirLowerLocalStep {
    state: mir_lower_emit_call_assign(local_step.state, local_step.local_id, callee_name, arguments),
    local_id: local_step.local_id
  })
end

fn mir_lower_operand_and(
  state: MirLowerState,
  left_operand: MirOperand,
  right_operand: MirOperand
) -> Result<MirLowerOperandStep, [string]> =
  Ok(mir_lower_temp_operand_from_rvalue(
    state,
    MirRvalueBinary('&&', left_operand, right_operand)))

fn mir_lower_operand_variant_is(
  state: MirLowerState,
  scrutinee: MirOperand,
  tag: string
) -> Result<MirLowerOperandStep, [string]> =
  match mir_lower_emit_call_to_local(
    state, '__mir_variant_is', [scrutinee, MirOperandConstStr(tag)]) {
    Err(errors) => Err(errors),
    Ok(local_step) =>
      Ok(MirLowerOperandStep { state: local_step.state, operand: MirOperandLocal(local_step.local_id) })
  }

fn mir_lower_ctor_subpattern_tests(
  state: MirLowerState,
  scrutinee: MirOperand,
  sub_patterns: [Shared<Pattern>],
  accumulated: MirOperand,
  index: i32
) -> Result<MirLowerOperandStep, [string]> =
  if index >= sub_patterns.length() then
    Ok(MirLowerOperandStep { state: state, operand: accumulated })
  else
    match sub_patterns[index] {
      PatternInt(value, _) =>
        match mir_lower_emit_call_to_local(
          state, '__mir_variant_field', [scrutinee, MirOperandConstInt(index)]) {
          Err(errors) => Err(errors),
          Ok(field_step) =>
            match mir_lower_operand_equals_const_int(
              field_step.state, MirOperandLocal(field_step.local_id), value) {
              Err(errors) => Err(errors),
              Ok(eq_step) =>
                match mir_lower_operand_and(eq_step.state, accumulated, eq_step.operand) {
                  Err(errors) => Err(errors),
                  Ok(and_step) =>
                    mir_lower_ctor_subpattern_tests(
                      and_step.state, scrutinee, sub_patterns, and_step.operand, index + 1)
                }
            }
        },
      PatternBool(value, _) =>
        match mir_lower_emit_call_to_local(
          state, '__mir_variant_field', [scrutinee, MirOperandConstInt(index)]) {
          Err(errors) => Err(errors),
          Ok(field_step) =>
            match mir_lower_operand_equals_const_bool(
              field_step.state, MirOperandLocal(field_step.local_id), value) {
              Err(errors) => Err(errors),
              Ok(eq_step) =>
                match mir_lower_operand_and(eq_step.state, accumulated, eq_step.operand) {
                  Err(errors) => Err(errors),
                  Ok(and_step) =>
                    mir_lower_ctor_subpattern_tests(
                      and_step.state, scrutinee, sub_patterns, and_step.operand, index + 1)
                }
            }
        },
      PatternWild(_) | PatternIdent(_, _) | PatternUnit(_) =>
        mir_lower_ctor_subpattern_tests(state, scrutinee, sub_patterns, accumulated, index + 1),
      PatternCtor(_, _, _) =>
        match mir_lower_emit_call_to_local(
          state, '__mir_variant_field', [scrutinee, MirOperandConstInt(index)]) {
          Err(errors) => Err(errors),
          Ok(field_step) =>
            match mir_lower_pattern_matches_operand(
              field_step.state, MirOperandLocal(field_step.local_id), sub_patterns[index]) {
              Err(errors) => Err(errors),
              Ok(nested_step) =>
                match mir_lower_operand_and(nested_step.state, accumulated, nested_step.operand) {
                  Err(errors) => Err(errors),
                  Ok(and_step) =>
                    mir_lower_ctor_subpattern_tests(
                      and_step.state, scrutinee, sub_patterns, and_step.operand, index + 1)
                }
            }
        },
      _ => Err(['mir lower: unsupported variant subpattern in match test'])
    }
  end

fn mir_lower_bind_ctor_subpattern(
  state: MirLowerState,
  scrutinee: MirOperand,
  field_index: i32,
  pattern: Shared<Pattern>
) -> Result<MirLowerState, [string]> =
  match pattern {
    PatternWild(_) | PatternUnit(_) | PatternInt(_, _) | PatternBool(_, _) => Ok(state),
    PatternIdent(name, _) =>
      match mir_lower_emit_call_to_local(
        state, '__mir_variant_field', [scrutinee, MirOperandConstInt(field_index)]) {
        Err(errors) => Err(errors),
        Ok(field_step) => Ok(mir_lower_bind_name(field_step.state, name, field_step.local_id))
      },
    PatternCtor(_, nested_sub_patterns, _) =>
      match mir_lower_emit_call_to_local(
        state, '__mir_variant_field', [scrutinee, MirOperandConstInt(field_index)]) {
        Err(errors) => Err(errors),
        Ok(field_step) =>
          mir_lower_bind_ctor_subpatterns(
            field_step.state,
            MirOperandLocal(field_step.local_id),
            nested_sub_patterns,
            0)
      },
    _ => Err(['mir lower: unsupported variant subpattern binding'])
  }

fn mir_lower_bind_ctor_subpatterns(
  state: MirLowerState,
  scrutinee: MirOperand,
  sub_patterns: [Shared<Pattern>],
  index: i32
) -> Result<MirLowerState, [string]> =
  if index >= sub_patterns.length() then Ok(state)
  else
    match mir_lower_bind_ctor_subpattern(state, scrutinee, index, sub_patterns[index]) {
      Err(errors) => Err(errors),
      Ok(bound_state) => mir_lower_bind_ctor_subpatterns(bound_state, scrutinee, sub_patterns, index + 1)
    }
  end

fn mir_lower_pattern_needs_conditional_test(pattern: Shared<Pattern>) -> bool =
  match pattern {
    PatternInt(_, _) => true,
    PatternBool(_, _) => true,
    PatternCtor(_, _, _) => true,
    _ => false
  }

fn mir_lower_pattern_matches_operand(
  state: MirLowerState,
  scrutinee: MirOperand,
  pattern: Shared<Pattern>
) -> Result<MirLowerOperandStep, [string]> =
  match pattern {
    PatternInt(value, _) => mir_lower_operand_equals_const_int(state, scrutinee, value),
    PatternBool(value, _) => mir_lower_operand_equals_const_bool(state, scrutinee, value),
    PatternCtor(tag, sub_patterns, _) =>
      match mir_lower_operand_variant_is(state, scrutinee, tag) {
        Err(errors) => Err(errors),
        Ok(is_step) =>
          mir_lower_ctor_subpattern_tests(
            is_step.state, scrutinee, sub_patterns, is_step.operand, 0)
      },
    _ => Err(['mir lower: staged match supports int, bool, and variant ctor patterns'])
  }

fn mir_lower_bind_record_field_patterns(
  state: MirLowerState,
  scrutinee: MirOperand,
  field_patterns: [Shared<Pattern>],
  index: i32
) -> Result<MirLowerState, [string]> =
  if index >= field_patterns.length() then Ok(state)
  else
    match field_patterns[index] {
      PatternIdent(field_name, _) =>
        match mir_lower_emit_call_to_local(
          state, '__mir_record_field', [scrutinee, MirOperandConstStr(field_name)]) {
          Err(errors) => Err(errors),
          Ok(field_step) =>
            mir_lower_bind_record_field_patterns(
              mir_lower_bind_name(field_step.state, field_name, field_step.local_id),
              scrutinee,
              field_patterns,
              index + 1)
        },
      PatternWild(_) =>
        mir_lower_bind_record_field_patterns(state, scrutinee, field_patterns, index + 1),
      _ => Err(['mir lower: unsupported record field pattern'])
    }
  end

fn mir_lower_bind_match_arm_pattern(
  state: MirLowerState,
  scrutinee: MirOperand,
  pattern: Shared<Pattern>
) -> Result<MirLowerState, [string]> =
  match pattern {
    PatternIdent(name, _) => do
      const local_step = mir_lower_allocate_local(state, name, mir_lower_unknown_type())
      let mut bound_state = mir_lower_emit_assign(
        local_step.state, local_step.local_id, MirRvalueUse(scrutinee))
      bound_state = mir_lower_bind_name(bound_state, name, local_step.local_id)
      Ok(bound_state)
    end,
    PatternCtor(_, sub_patterns, _) =>
      mir_lower_bind_ctor_subpatterns(state, scrutinee, sub_patterns, 0),
    PatternRecord(_, field_patterns, _) =>
      mir_lower_bind_record_field_patterns(state, scrutinee, field_patterns, 0),
    _ => Ok(state)
  }

fn mir_lower_match_arm_after_bind(
  state: MirLowerState,
  arm: Shared<SemanticMatchArm>,
  guard_fail_block: BlockId
) -> Result<MirLowerState, [string]> =
  if !arm.has_guard then mir_lower_return_expression(state, arm.body)
  else
    match mir_lower_operand_from_expression(state, arm.when_condition) {
      Err(errors) => Err(errors),
      Ok(guard_step) => do
        const body_block_step = mir_lower_allocate_block_index(guard_step.state)
        let mut branch_state = mir_lower_finish_current_block(
          body_block_step.state,
          MirCondJump(guard_step.operand, body_block_step.block_id, guard_fail_block))
        branch_state = mir_lower_start_block(branch_state, body_block_step.block_id, 'match_guard_body')
        mir_lower_return_expression(branch_state, arm.body)
      end
    }
  end

fn mir_lower_match_arm_body_with_binding(
  state: MirLowerState,
  scrutinee: MirOperand,
  arm: Shared<SemanticMatchArm>,
  guard_fail_block: BlockId
) -> Result<MirLowerState, [string]> =
  match mir_lower_bind_match_arm_pattern(state, scrutinee, arm.pattern) {
    Err(errors) => Err(errors),
    Ok(bound_state) => mir_lower_match_arm_after_bind(bound_state, arm, guard_fail_block)
  }

fn mir_lower_finish_unreachable(state: MirLowerState) -> MirLowerState =
  mir_lower_finish_current_block(state, MirUnreachable)

fn mir_lower_match_arms_return(
  state: MirLowerState,
  scrutinee: MirOperand,
  arms: [Shared<SemanticMatchArm>],
  index: i32
) -> Result<MirLowerState, [string]> =
  if index >= arms.length() then Err(['mir lower: empty match'])
  else if index == arms.length() - 1 then do
    const fail_block_step = mir_lower_allocate_block_index(state)
    match mir_lower_match_arm_body_with_binding(
      fail_block_step.state, scrutinee, arms[index], fail_block_step.block_id) {
      Err(errors) => Err(errors),
      Ok(arm_state) => do
        let mut fail_state = mir_lower_start_block(arm_state, fail_block_step.block_id, 'match_guard_fail')
        Ok(mir_lower_finish_unreachable(fail_state))
      end
    }
  end else if !mir_lower_pattern_needs_conditional_test(arms[index].pattern) then do
    const next_test_step = mir_lower_allocate_block_index(state)
    match mir_lower_match_arm_body_with_binding(
      next_test_step.state, scrutinee, arms[index], next_test_step.block_id) {
      Err(errors) => Err(errors),
      Ok(arm_done_state) =>
        mir_lower_match_arms_return(
          mir_lower_start_block(arm_done_state, next_test_step.block_id, 'match_test'),
          scrutinee,
          arms,
          index + 1)
    }
  end else
    match mir_lower_pattern_matches_operand(state, scrutinee, arms[index].pattern) {
      Err(errors) => Err(errors),
      Ok(condition_step) => do
        const arm_block_step = mir_lower_allocate_block_index(condition_step.state)
        const next_test_step = mir_lower_allocate_block_index(arm_block_step.state)
        let mut branch_state = mir_lower_finish_current_block(
          next_test_step.state,
          MirCondJump(
            condition_step.operand, arm_block_step.block_id, next_test_step.block_id))
        branch_state = mir_lower_start_block(branch_state, arm_block_step.block_id, 'match_arm')
        match mir_lower_match_arm_body_with_binding(
          branch_state, scrutinee, arms[index], next_test_step.block_id) {
          Err(errors) => Err(errors),
          Ok(arm_done_state) =>
            mir_lower_match_arms_return(
              mir_lower_start_block(arm_done_state, next_test_step.block_id, 'match_test'),
              scrutinee,
              arms,
              index + 1)
        }
      end
    }
  end

fn mir_lower_match_arm_with_pattern(
  arm: Shared<SemanticMatchArm>,
  pattern: Shared<Pattern>
) -> Shared<SemanticMatchArm> =
  Shared.new(SemanticMatchArm {
    pattern: pattern,
    has_guard: arm.has_guard,
    when_condition: arm.when_condition,
    body: arm.body
  })

fn mir_lower_split_or_arm(arm: Shared<SemanticMatchArm>) -> [Shared<SemanticMatchArm>] =
  match arm.pattern {
    PatternOr(alternatives, _) =>
      alternatives.map(alternative => mir_lower_match_arm_with_pattern(arm, alternative)),
    _ => [arm]
  }

fn mir_lower_expand_or_arms(arms: [Shared<SemanticMatchArm>]) -> [Shared<SemanticMatchArm>] =
  arms.flat_map(arm => mir_lower_split_or_arm(arm))

fn mir_lower_match_return(
  state: MirLowerState,
  subject: Shared<SemanticExpression>,
  arms: [Shared<SemanticMatchArm>]
) -> Result<MirLowerState, [string]> =
  match mir_lower_operand_from_expression(state, subject) {
    Err(errors) => Err(errors),
    Ok(subject_step) =>
      mir_lower_match_arms_return(
        subject_step.state, subject_step.operand, mir_lower_expand_or_arms(arms), 0)
  }

fn mir_lower_match_arm_after_bind_into_local(
  state: MirLowerState,
  arm: Shared<SemanticMatchArm>,
  guard_fail_block: BlockId,
  result_local_id: LocalId,
  continue_block_id: BlockId
) -> Result<MirLowerState, [string]> =
  if !arm.has_guard then
    match mir_lower_expression_into_local(state, arm.body, result_local_id) {
      Err(errors) => Err(errors),
      Ok(body_state) => Ok(mir_lower_finish_current_block(body_state, MirJump(continue_block_id)))
    }
  else
    match mir_lower_operand_from_expression(state, arm.when_condition) {
      Err(errors) => Err(errors),
      Ok(guard_step) => do
        const body_block_step = mir_lower_allocate_block_index(guard_step.state)
        let mut branch_state = mir_lower_finish_current_block(
          body_block_step.state,
          MirCondJump(guard_step.operand, body_block_step.block_id, guard_fail_block))
        branch_state = mir_lower_start_block(branch_state, body_block_step.block_id, 'match_guard_body')
        match mir_lower_expression_into_local(branch_state, arm.body, result_local_id) {
          Err(errors) => Err(errors),
          Ok(body_state) => Ok(mir_lower_finish_current_block(body_state, MirJump(continue_block_id)))
        }
      end
    }
  end

fn mir_lower_match_arm_body_into_local(
  state: MirLowerState,
  scrutinee: MirOperand,
  arm: Shared<SemanticMatchArm>,
  guard_fail_block: BlockId,
  result_local_id: LocalId,
  continue_block_id: BlockId
) -> Result<MirLowerState, [string]> =
  match mir_lower_bind_match_arm_pattern(state, scrutinee, arm.pattern) {
    Err(errors) => Err(errors),
    Ok(bound_state) =>
      mir_lower_match_arm_after_bind_into_local(
        bound_state, arm, guard_fail_block, result_local_id, continue_block_id)
  }

fn mir_lower_match_arms_into_local(
  state: MirLowerState,
  scrutinee: MirOperand,
  arms: [Shared<SemanticMatchArm>],
  index: i32,
  result_local_id: LocalId,
  continue_block_id: BlockId
) -> Result<MirLowerState, [string]> =
  if index >= arms.length() then Err(['mir lower: empty match'])
  else if index == arms.length() - 1 then do
    const fail_block_step = mir_lower_allocate_block_index(state)
    match mir_lower_match_arm_body_into_local(
      fail_block_step.state,
      scrutinee,
      arms[index],
      fail_block_step.block_id,
      result_local_id,
      continue_block_id
    ) {
      Err(errors) => Err(errors),
      Ok(arm_state) => do
        let mut fail_state = mir_lower_start_block(arm_state, fail_block_step.block_id, 'match_guard_fail')
        Ok(mir_lower_finish_unreachable(fail_state))
      end
    }
  end else if !mir_lower_pattern_needs_conditional_test(arms[index].pattern) then do
    const next_test_step = mir_lower_allocate_block_index(state)
    match mir_lower_match_arm_body_into_local(
      next_test_step.state,
      scrutinee,
      arms[index],
      next_test_step.block_id,
      result_local_id,
      continue_block_id
    ) {
      Err(errors) => Err(errors),
      Ok(arm_done_state) =>
        mir_lower_match_arms_into_local(
          mir_lower_start_block(arm_done_state, next_test_step.block_id, 'match_test'),
          scrutinee,
          arms,
          index + 1,
          result_local_id,
          continue_block_id
        )
    }
  end else
    match mir_lower_pattern_matches_operand(state, scrutinee, arms[index].pattern) {
      Err(errors) => Err(errors),
      Ok(condition_step) => do
        const arm_block_step = mir_lower_allocate_block_index(condition_step.state)
        const next_test_step = mir_lower_allocate_block_index(arm_block_step.state)
        let mut branch_state = mir_lower_finish_current_block(
          next_test_step.state,
          MirCondJump(
            condition_step.operand, arm_block_step.block_id, next_test_step.block_id))
        branch_state = mir_lower_start_block(branch_state, arm_block_step.block_id, 'match_arm')
        match mir_lower_match_arm_body_into_local(
          branch_state,
          scrutinee,
          arms[index],
          next_test_step.block_id,
          result_local_id,
          continue_block_id
        ) {
          Err(errors) => Err(errors),
          Ok(arm_done_state) =>
            mir_lower_match_arms_into_local(
              mir_lower_start_block(arm_done_state, next_test_step.block_id, 'match_test'),
              scrutinee,
              arms,
              index + 1,
              result_local_id,
              continue_block_id
            )
        }
      end
    }
  end

fn mir_lower_match_into_local(
  state: MirLowerState,
  subject: Shared<SemanticExpression>,
  arms: [Shared<SemanticMatchArm>],
  result_local_id: LocalId
) -> Result<MirLowerState, [string]> =
  match mir_lower_operand_from_expression(state, subject) {
    Err(errors) => Err(errors),
    Ok(subject_step) => do
      const continue_step = mir_lower_allocate_block_index(subject_step.state)
      match mir_lower_match_arms_into_local(
        continue_step.state,
        subject_step.operand,
        mir_lower_expand_or_arms(arms),
        0,
        result_local_id,
        continue_step.block_id
      ) {
        Err(errors) => Err(errors),
        Ok(arms_state) =>
          Ok(mir_lower_start_block(arms_state, continue_step.block_id, 'match_continue'))
      }
    end
  }

fn mir_lower_match_to_local(
  state: MirLowerState,
  subject: Shared<SemanticExpression>,
  arms: [Shared<SemanticMatchArm>]
) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, 'match_tmp', mir_lower_unknown_type())
  match mir_lower_match_into_local(local_step.state, subject, arms, local_step.local_id) {
    Err(errors) => Err(errors),
    Ok(match_state) =>
      Ok(MirLowerLocalStep { state: match_state, local_id: local_step.local_id })
  }
end

fn mir_lower_bind_lambda_parameters_from_index(
  state: MirLowerState,
  parameter_names: [string],
  argument_operands: [MirOperand],
  index: i32,
  body: Shared<SemanticExpression>,
  result_local_id: LocalId
) -> Result<MirLowerState, [string]> =
  if index >= parameter_names.length() then
    match mir_lower_rvalue_from_expression(state, body) {
      Err(errors) => Err(errors),
      Ok(rvalue_step) => Ok(mir_lower_emit_assign(rvalue_step.state, result_local_id, rvalue_step.rvalue))
    }
  else do
    const local_step = mir_lower_allocate_local(state, parameter_names[index], mir_lower_unknown_type())
    let mut bound_state = mir_lower_emit_assign(
      local_step.state,
      local_step.local_id,
      MirRvalueUse(argument_operands[index]))
    bound_state = mir_lower_bind_name(bound_state, parameter_names[index], local_step.local_id)
    mir_lower_bind_lambda_parameters_from_index(
      bound_state, parameter_names, argument_operands, index + 1, body, result_local_id)
  end

fn mir_lower_lambda_inline_body(
  state: MirLowerState,
  parameter_names: [string],
  body: Shared<SemanticExpression>,
  argument_operands: [MirOperand],
  result_local_id: LocalId
) -> Result<MirLowerState, [string]> =
  if parameter_names.length() != argument_operands.length() then
    Err(['mir lower: lambda argument count mismatch'])
  else
    mir_lower_bind_lambda_parameters_from_index(
      state, parameter_names, argument_operands, 0, body, result_local_id)
  end

fn mir_lower_expression_to_local(
  state: MirLowerState,
  expression: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match expression {
    SemanticExpressionArray(elements, _, _) =>
      mir_lower_array_literal_to_local(state, elements),
    SemanticExpressionRecord(type_name, field_values, _, _) =>
      mir_lower_record_literal_to_local(state, type_name, field_values),
    SemanticExpressionRecordUpdate(_, base, field_values, _, _) =>
      mir_lower_record_update_to_local(state, base, field_values),
    SemanticExpressionWith(resource, binder_name, statements, _, _) =>
      mir_lower_with_to_local(state, resource, binder_name, statements),
    SemanticExpressionExtern(_, _, _, _, _) =>
      mir_lower_extern_to_local(state),
    SemanticExpressionWhile(condition, body_statements, _, _) =>
      mir_lower_while_to_local(state, condition, body_statements),
    SemanticExpressionFor(variable_name, iterator, body_statements, _, _) =>
      mir_lower_for_to_local(state, variable_name, iterator, body_statements),
    SemanticExpressionField(object, field_name, _, _) =>
      mir_lower_record_field_to_local(state, object, field_name),
    SemanticExpressionQuestion(inner, _, _) =>
      mir_lower_question_to_local(state, inner),
    SemanticExpressionIndex(object, index_expression, _, _) =>
      mir_lower_index_to_local(state, object, index_expression),
    SemanticExpressionMethod(object, method_name, arguments, _, _, _) =>
      mir_lower_method_to_local(state, object, method_name, arguments),
    SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
      mir_lower_if_to_local(state, condition, then_expression, else_expression),
    SemanticExpressionCall(function, arguments, _, _, _) =>
      match function {
        SemanticExpressionLambda(parameter_names, body, _, _) =>
          match mir_lower_operands_from_arguments(state, arguments) {
            Err(errors) => Err(errors),
            Ok(operands_step) => do
              const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
              match mir_lower_lambda_inline_body(
                local_step.state,
                parameter_names,
                body,
                operands_step.operands,
                local_step.local_id) {
                Err(errors) => Err(errors),
                Ok(done_state) => Ok(MirLowerLocalStep { state: done_state, local_id: local_step.local_id })
              }
            end
          },
        SemanticExpressionIdent(callee_name, _, _) =>
          match mir_lower_lookup_lambda(state, callee_name) {
            Ok(binding) =>
              match mir_lower_operands_from_arguments(state, arguments) {
                Err(errors) => Err(errors),
                Ok(operands_step) => do
                  const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
                  match mir_lower_lambda_inline_body(
                    local_step.state,
                    binding.parameter_names,
                    binding.body,
                    operands_step.operands,
                    local_step.local_id) {
                    Err(errors) => Err(errors),
                    Ok(done_state) => Ok(MirLowerLocalStep { state: done_state, local_id: local_step.local_id })
                  }
                end
              },
            Err(_) =>
              match mir_lower_operands_from_arguments(state, arguments) {
                Err(errors) => Err(errors),
                Ok(operands_step) => do
                  const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
                  if mir_lower_is_variant_ctor_name(callee_name) then
                    Ok(MirLowerLocalStep {
                      state: mir_lower_emit_call_assign(
                        local_step.state,
                        local_step.local_id,
                        '__mir_variant_new',
                        mir_lower_variant_new_arguments(callee_name, operands_step.operands)),
                      local_id: local_step.local_id
                    })
                  else
                    Ok(MirLowerLocalStep {
                      state: mir_lower_emit_call_assign(
                        local_step.state, local_step.local_id, callee_name, operands_step.operands),
                      local_id: local_step.local_id
                    })
                  end
                end
              }
          },
        _ =>
          match mir_lower_operands_from_arguments(state, arguments) {
            Err(errors) => Err(errors),
            Ok(operands_step) =>
              match mir_lower_call_target_name(function) {
                Err(errors) => Err(errors),
                Ok(callee_name) => do
                  const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
                  if mir_lower_is_variant_ctor_name(callee_name) then
                    Ok(MirLowerLocalStep {
                      state: mir_lower_emit_call_assign(
                        local_step.state,
                        local_step.local_id,
                        '__mir_variant_new',
                        mir_lower_variant_new_arguments(callee_name, operands_step.operands)),
                      local_id: local_step.local_id
                    })
                  else
                    Ok(MirLowerLocalStep {
                      state: mir_lower_emit_call_assign(
                        local_step.state, local_step.local_id, callee_name, operands_step.operands),
                      local_id: local_step.local_id
                    })
                  end
                end
              }
          }
      },
    SemanticExpressionIdent(name, _, _) =>
      match mir_lower_lookup_local(state, name) {
        Ok(_) =>
          match mir_lower_rvalue_from_expression(state, expression) {
            Err(errors) => Err(errors),
            Ok(rvalue_step) => do
              const local_step = mir_lower_allocate_local(rvalue_step.state, '', mir_lower_unknown_type())
              Ok(MirLowerLocalStep {
                state: mir_lower_emit_assign(local_step.state, local_step.local_id, rvalue_step.rvalue),
                local_id: local_step.local_id
              })
            end
          },
        Err(_) =>
          if mir_lower_is_variant_ctor_name(name) then do
            const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
            Ok(MirLowerLocalStep {
              state: mir_lower_emit_call_assign(
                local_step.state,
                local_step.local_id,
                '__mir_variant_new',
                mir_lower_variant_new_arguments(name, [])),
              local_id: local_step.local_id
            })
          end else
            mir_lower_funref_ident_to_local(state, name)
          end
      },
    _ =>
      match mir_lower_rvalue_from_expression(state, expression) {
        Err(errors) => Err(errors),
        Ok(rvalue_step) => do
          const local_step = mir_lower_allocate_local(rvalue_step.state, '', mir_lower_unknown_type())
          Ok(MirLowerLocalStep {
            state: mir_lower_emit_assign(local_step.state, local_step.local_id, rvalue_step.rvalue),
            local_id: local_step.local_id
          })
        end
      }
  }

// `expr?`: if Err → MirReturn whole Result; if Ok → local = Ok payload.
fn mir_lower_question_to_local(
  state: MirLowerState,
  inner: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_expression_to_local(state, inner) {
    Err(errors) => Err(errors),
    Ok(result_step) => do
      const is_error_step = mir_lower_allocate_local(result_step.state, '', mir_lower_unknown_type())
      let mut branch_state = mir_lower_emit_call_assign(
        is_error_step.state,
        is_error_step.local_id,
        '__mir_result_is_err',
        [MirOperandLocal(result_step.local_id)])
      const error_block_step = mir_lower_allocate_block_index(branch_state)
      const ok_block_step = mir_lower_allocate_block_index(error_block_step.state)
      branch_state = mir_lower_finish_current_block(
        ok_block_step.state,
        MirCondJump(
          MirOperandLocal(is_error_step.local_id),
          error_block_step.block_id,
          ok_block_step.block_id))
      branch_state = mir_lower_start_block(branch_state, error_block_step.block_id, 'question_err')
      branch_state = mir_lower_finish_return(branch_state, MirOperandLocal(result_step.local_id))
      branch_state = mir_lower_start_block(branch_state, ok_block_step.block_id, 'question_ok')
      const ok_value_step = mir_lower_allocate_local(branch_state, '', mir_lower_unknown_type())
      branch_state = mir_lower_emit_call_assign(
        ok_value_step.state,
        ok_value_step.local_id,
        '__mir_result_ok_value',
        [MirOperandLocal(result_step.local_id)])
      Ok(MirLowerLocalStep { state: branch_state, local_id: ok_value_step.local_id })
    end
  }

fn mir_lower_question_return(
  state: MirLowerState,
  inner: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match mir_lower_question_to_local(state, inner) {
    Err(errors) => Err(errors),
    Ok(local_step) => Ok(mir_lower_finish_return(local_step.state, MirOperandLocal(local_step.local_id)))
  }

// Discard expression value (side effects only). Used by mid-block `if` arms.
fn mir_lower_discard_expression(
  state: MirLowerState,
  expression: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match expression {
    SemanticExpressionBlock(statements, result_expression, _, _) =>
      match mir_lower_statements(state, statements) {
        Err(errors) => Err(errors),
        Ok(statement_state) => mir_lower_discard_expression(statement_state, result_expression)
      },
    SemanticExpressionUnit(_, _) => Ok(state),
    SemanticExpressionTuple(elements, _, _) =>
      if elements.length() == 0 then Ok(state)
      else Err(['mir lower: non-empty tuple discard not supported']),
    _ =>
      mir_lower_statement(
        state,
        Shared.new(SemanticStatementExpr(expression, sexpr_span(expression))))
  }

// Materialize expression value into an existing local (if-as-rvalue arms).
fn mir_lower_expression_into_local(
  state: MirLowerState,
  expression: Shared<SemanticExpression>,
  local_id: LocalId
) -> Result<MirLowerState, [string]> =
  match expression {
    SemanticExpressionBlock(statements, result_expression, _, _) =>
      match mir_lower_statements(state, statements) {
        Err(errors) => Err(errors),
        Ok(statement_state) =>
          mir_lower_expression_into_local(statement_state, result_expression, local_id)
      },
    SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
      mir_lower_if_into_local(
        state, condition, then_expression, else_expression, local_id),
    SemanticExpressionMatch(subject, arms, _, _) =>
      mir_lower_match_into_local(state, subject, arms, local_id),
    _ =>
      match mir_lower_rvalue_from_expression(state, expression) {
        Err(errors) => Err(errors),
        Ok(rvalue_step) => Ok(mir_lower_emit_assign(rvalue_step.state, local_id, rvalue_step.rvalue))
      }
  }

// Mid-block `if` as rvalue: CondJump → then/else assign shared local → Jump continue.
fn mir_lower_if_into_local(
  state: MirLowerState,
  condition: Shared<SemanticExpression>,
  then_expression: Shared<SemanticExpression>,
  else_expression: Shared<SemanticExpression>,
  result_local_id: LocalId
) -> Result<MirLowerState, [string]> =
  match mir_lower_operand_from_expression(state, condition) {
    Err(errors) => Err(errors),
    Ok(condition_step) => do
      const then_block_step = mir_lower_allocate_block_index(condition_step.state)
      const else_block_step = mir_lower_allocate_block_index(then_block_step.state)
      const continue_block_step = mir_lower_allocate_block_index(else_block_step.state)
      let mut branch_state = mir_lower_finish_current_block(
        continue_block_step.state,
        MirCondJump(condition_step.operand, then_block_step.block_id, else_block_step.block_id))
      branch_state = mir_lower_start_block(branch_state, then_block_step.block_id, 'if_then')
      match mir_lower_expression_into_local(branch_state, then_expression, result_local_id) {
        Err(errors) => Err(errors),
        Ok(then_state) => do
          let mut after_then = mir_lower_finish_current_block(
            then_state, MirJump(continue_block_step.block_id))
          after_then = mir_lower_start_block(after_then, else_block_step.block_id, 'if_else')
          match mir_lower_expression_into_local(after_then, else_expression, result_local_id) {
            Err(errors) => Err(errors),
            Ok(else_state) => do
              let mut after_else = mir_lower_finish_current_block(
                else_state, MirJump(continue_block_step.block_id))
              Ok(mir_lower_start_block(after_else, continue_block_step.block_id, 'if_continue'))
            end
          }
        end
      }
    end
  }

fn mir_lower_if_to_local(
  state: MirLowerState,
  condition: Shared<SemanticExpression>,
  then_expression: Shared<SemanticExpression>,
  else_expression: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  match mir_lower_if_into_local(
    local_step.state, condition, then_expression, else_expression, local_step.local_id) {
    Err(errors) => Err(errors),
    Ok(done_state) => Ok(MirLowerLocalStep { state: done_state, local_id: local_step.local_id })
  }
end

fn mir_lower_block_to_local(
  state: MirLowerState,
  expression: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  match mir_lower_expression_into_local(local_step.state, expression, local_step.local_id) {
    Err(errors) => Err(errors),
    Ok(done_state) => Ok(MirLowerLocalStep { state: done_state, local_id: local_step.local_id })
  }
end

fn mir_lower_with_to_local(
  state: MirLowerState,
  resource: Shared<SemanticExpression>,
  binder_name: string,
  statements: [Shared<SemanticStatement>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_expression_to_local(state, resource) {
    Err(errors) => Err(errors),
    Ok(resource_step) => do
      let mut bound_state = mir_lower_bind_name(
        resource_step.state, binder_name, resource_step.local_id)
      match mir_lower_statements(bound_state, statements) {
        Err(errors) => Err(errors),
        Ok(after_statements) => do
          const unit_step = mir_lower_allocate_local(
            after_statements, '', mir_lower_unknown_type())
          Ok(MirLowerLocalStep {
            state: mir_lower_emit_assign(
              unit_step.state, unit_step.local_id, MirRvalueUse(MirOperandUnit)),
            local_id: unit_step.local_id
          })
        end
      }
    end
  }

fn mir_lower_extern_to_local(state: MirLowerState) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  Ok(MirLowerLocalStep {
    state: mir_lower_emit_assign(
      local_step.state, local_step.local_id, MirRvalueUse(MirOperandUnit)),
    local_id: local_step.local_id
  })
end

// Module-level fn used as a value (HOF injection): stub as ConstStr(name).
fn mir_lower_funref_ident_to_local(
  state: MirLowerState,
  name: string
) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  Ok(MirLowerLocalStep {
    state: mir_lower_emit_assign(
      local_step.state,
      local_step.local_id,
      MirRvalueUse(MirOperandConstStr(name))),
    local_id: local_step.local_id
  })
end

// Mid-block `if` as statement: CondJump → then/else → Jump continue (value discarded).
fn mir_lower_if_statement(
  state: MirLowerState,
  condition: Shared<SemanticExpression>,
  then_expression: Shared<SemanticExpression>,
  else_expression: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match mir_lower_operand_from_expression(state, condition) {
    Err(errors) => Err(errors),
    Ok(condition_step) => do
      const then_block_step = mir_lower_allocate_block_index(condition_step.state)
      const else_block_step = mir_lower_allocate_block_index(then_block_step.state)
      const continue_block_step = mir_lower_allocate_block_index(else_block_step.state)
      let mut branch_state = mir_lower_finish_current_block(
        continue_block_step.state,
        MirCondJump(condition_step.operand, then_block_step.block_id, else_block_step.block_id))
      branch_state = mir_lower_start_block(branch_state, then_block_step.block_id, 'if_then')
      match mir_lower_discard_expression(branch_state, then_expression) {
        Err(errors) => Err(errors),
        Ok(then_state) => do
          let mut after_then = mir_lower_finish_current_block(
            then_state, MirJump(continue_block_step.block_id))
          after_then = mir_lower_start_block(after_then, else_block_step.block_id, 'if_else')
          match mir_lower_discard_expression(after_then, else_expression) {
            Err(errors) => Err(errors),
            Ok(else_state) => do
              let mut after_else = mir_lower_finish_current_block(
                else_state, MirJump(continue_block_step.block_id))
              Ok(mir_lower_start_block(after_else, continue_block_step.block_id, 'if_continue'))
            end
          }
        end
      }
    end
  }

fn mir_lower_while_statement(
  state: MirLowerState,
  condition: Shared<SemanticExpression>,
  body_statements: [Shared<SemanticStatement>]
) -> Result<MirLowerState, [string]> = do
  const loop_header_step = mir_lower_allocate_block_index(state)
  const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
  const exit_block_step = mir_lower_allocate_block_index(body_block_step.state)
  let mut loop_state = mir_lower_finish_current_block(exit_block_step.state, MirJump(loop_header_step.block_id))
  loop_state = mir_lower_start_block(loop_state, loop_header_step.block_id, 'loop')
  match mir_lower_operand_from_expression(loop_state, condition) {
    Err(errors) => Err(errors),
    Ok(condition_step) => do
      loop_state = mir_lower_finish_current_block(
        condition_step.state,
        MirCondJump(condition_step.operand, body_block_step.block_id, exit_block_step.block_id))
      loop_state = mir_lower_start_block(loop_state, body_block_step.block_id, 'loop_body')
      loop_state = mir_lower_push_loop_targets(
        loop_state, exit_block_step.block_id, loop_header_step.block_id)
      match mir_lower_statements(loop_state, body_statements) {
        Err(errors) => Err(errors),
        Ok(body_state) => do
          let mut exit_state = mir_lower_pop_loop_targets(body_state)
          exit_state = mir_lower_finish_current_block(exit_state, MirJump(loop_header_step.block_id))
          Ok(mir_lower_start_block(exit_state, exit_block_step.block_id, 'loop_exit'))
        end
      }
    end
  }
end

// for x in iter { body } → index walk: while index < length(iter) { x = iter[index]; body; index++ }
fn mir_lower_for_statement(
  state: MirLowerState,
  variable_name: string,
  iterator: Shared<SemanticExpression>,
  body_statements: [Shared<SemanticStatement>]
) -> Result<MirLowerState, [string]> =
  match mir_lower_expression_to_local(state, iterator) {
    Err(errors) => Err(errors),
    Ok(iterator_step) => do
      const index_step = mir_lower_allocate_local(iterator_step.state, '', mir_lower_unknown_type())
      let mut prep_state = mir_lower_emit_assign(
        index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
      const loop_header_step = mir_lower_allocate_block_index(prep_state)
      const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
      const exit_block_step = mir_lower_allocate_block_index(body_block_step.state)
      const continue_block_step = mir_lower_allocate_block_index(exit_block_step.state)
      // Bind allocate-chain state under a distinct name: codegen has mis-emitted
      // `continue_block_step.state` as `loop_header_step.state` on the reassignment below
      // (Critic §104-6 s11), dropping id_pool advances → duplicate BlockIds in for+if.
      const for_blocks_allocated_state = continue_block_step.state
      prep_state = mir_lower_finish_current_block(
        for_blocks_allocated_state, MirJump(loop_header_step.block_id))
      prep_state = mir_lower_start_block(prep_state, loop_header_step.block_id, 'for_loop')
      const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
      prep_state = mir_lower_emit_call_assign(
        length_step.state,
        length_step.local_id,
        '__mir_length',
        [MirOperandLocal(iterator_step.local_id)])
      const less_op = "<"
      const compare_step = mir_lower_temp_operand_from_rvalue(
        prep_state,
        MirRvalueBinary(less_op, MirOperandLocal(index_step.local_id), MirOperandLocal(length_step.local_id)))
      prep_state = mir_lower_finish_current_block(
        compare_step.state,
        MirCondJump(compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
      prep_state = mir_lower_start_block(prep_state, body_block_step.block_id, 'for_body')
      const element_step = mir_lower_allocate_local(prep_state, variable_name, mir_lower_unknown_type())
      prep_state = mir_lower_emit_call_assign(
        element_step.state,
        element_step.local_id,
        '__mir_array_get',
        [MirOperandLocal(iterator_step.local_id), MirOperandLocal(index_step.local_id)])
      prep_state = mir_lower_bind_name(prep_state, variable_name, element_step.local_id)
      prep_state = mir_lower_push_loop_targets(
        prep_state, exit_block_step.block_id, continue_block_step.block_id)
      match mir_lower_statements(prep_state, body_statements) {
        Err(errors) => Err(errors),
        Ok(body_state) => do
          let mut after_body = mir_lower_pop_loop_targets(body_state)
          after_body = mir_lower_finish_current_block(
            after_body, MirJump(continue_block_step.block_id))
          after_body = mir_lower_start_block(
            after_body, continue_block_step.block_id, 'for_continue')
          const add_op = "+"
          const next_index_step = mir_lower_temp_operand_from_rvalue(
            after_body,
            MirRvalueBinary(add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
          let mut exit_state = mir_lower_emit_assign(
            next_index_step.state,
            index_step.local_id,
            MirRvalueUse(next_index_step.operand))
          exit_state = mir_lower_finish_current_block(exit_state, MirJump(loop_header_step.block_id))
          Ok(mir_lower_start_block(exit_state, exit_block_step.block_id, 'for_exit'))
        end
      }
    end
  }

fn mir_lower_while_to_local(
  state: MirLowerState,
  condition: Shared<SemanticExpression>,
  body_statements: [Shared<SemanticStatement>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_while_statement(state, condition, body_statements) {
    Err(errors) => Err(errors),
    Ok(after_while) => do
      const unit_step = mir_lower_allocate_local(after_while, '', mir_lower_unknown_type())
      Ok(MirLowerLocalStep {
        state: mir_lower_emit_assign(
          unit_step.state, unit_step.local_id, MirRvalueUse(MirOperandUnit)),
        local_id: unit_step.local_id
      })
    end
  }

fn mir_lower_for_to_local(
  state: MirLowerState,
  variable_name: string,
  iterator: Shared<SemanticExpression>,
  body_statements: [Shared<SemanticStatement>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_for_statement(state, variable_name, iterator, body_statements) {
    Err(errors) => Err(errors),
    Ok(after_for) => do
      const unit_step = mir_lower_allocate_local(after_for, '', mir_lower_unknown_type())
      Ok(MirLowerLocalStep {
        state: mir_lower_emit_assign(
          unit_step.state, unit_step.local_id, MirRvalueUse(MirOperandUnit)),
        local_id: unit_step.local_id
      })
    end
  }

fn mir_lower_break_statement(state: MirLowerState) -> Result<MirLowerState, [string]> =
  match mir_lower_lookup_loop_break_target(state) {
    Err(errors) => Err(errors),
    Ok(target) => Ok(mir_lower_jump_to_loop_target_then_dead(state, target, 'after_break'))
  }

fn mir_lower_continue_statement(state: MirLowerState) -> Result<MirLowerState, [string]> =
  match mir_lower_lookup_loop_continue_target(state) {
    Err(errors) => Err(errors),
    Ok(target) => Ok(mir_lower_jump_to_loop_target_then_dead(state, target, 'after_continue'))
  }

fn mir_lower_assign_identifier(
  state: MirLowerState,
  name: string,
  right: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match mir_lower_lookup_local(state, name) {
    Err(errors) => Err(errors),
    Ok(local_id) =>
      match mir_lower_rvalue_from_expression(state, right) {
        Err(errors) => Err(errors),
        Ok(rvalue_step) => Ok(mir_lower_emit_assign(rvalue_step.state, local_id, rvalue_step.rvalue))
      }
  }

fn mir_lower_bind_lambda_statement(
  state: MirLowerState,
  name: string,
  value: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match value {
    SemanticExpressionLambda(parameter_names, body, _, _) =>
      Ok(mir_lower_bind_lambda(state, name, parameter_names, body)),
    _ => Err(['mir lower: expected lambda binding'])
  }

fn mir_lower_let_pattern_bind_then_jump(
  state: MirLowerState,
  scrutinee: MirOperand,
  pattern: Shared<Pattern>,
  continue_block_id: BlockId
) -> Result<MirLowerState, [string]> =
  match mir_lower_bind_match_arm_pattern(state, scrutinee, pattern) {
    Err(errors) => Err(errors),
    Ok(bound_state) => Ok(mir_lower_finish_current_block(bound_state, MirJump(continue_block_id)))
  }

fn mir_lower_let_pattern_else_then_jump(
  state: MirLowerState,
  has_else: bool,
  else_body: Shared<SemanticExpression>,
  continue_block_id: BlockId
) -> Result<MirLowerState, [string]> =
  if has_else then
    match mir_lower_discard_expression(state, else_body) {
      Err(errors) => Err(errors),
      Ok(else_state) => Ok(mir_lower_finish_current_block(else_state, MirJump(continue_block_id)))
    }
  else
    Ok(mir_lower_finish_unreachable(state))
  end

fn mir_lower_let_pattern_statement(
  state: MirLowerState,
  pattern: Shared<Pattern>,
  value: Shared<SemanticExpression>,
  has_else: bool,
  else_body: Shared<SemanticExpression>
) -> Result<MirLowerState, [string]> =
  match mir_lower_expression_to_local(state, value) {
    Err(errors) => Err(errors),
    Ok(value_step) => do
      const scrutinee = MirOperandLocal(value_step.local_id)
      if !mir_lower_pattern_needs_conditional_test(pattern) then
        mir_lower_bind_match_arm_pattern(value_step.state, scrutinee, pattern)
      else
        match mir_lower_pattern_matches_operand(value_step.state, scrutinee, pattern) {
          Err(errors) => Err(errors),
          Ok(condition_step) => do
            const bind_block_step = mir_lower_allocate_block_index(condition_step.state)
            const else_block_step = mir_lower_allocate_block_index(bind_block_step.state)
            const continue_block_step = mir_lower_allocate_block_index(else_block_step.state)
            let mut branch_state = mir_lower_finish_current_block(
              continue_block_step.state,
              MirCondJump(
                condition_step.operand, bind_block_step.block_id, else_block_step.block_id))
            branch_state = mir_lower_start_block(
              branch_state, bind_block_step.block_id, 'let_pattern_bind')
            match mir_lower_let_pattern_bind_then_jump(
              branch_state, scrutinee, pattern, continue_block_step.block_id) {
              Err(errors) => Err(errors),
              Ok(after_bind) => do
                let mut else_state = mir_lower_start_block(
                  after_bind, else_block_step.block_id, 'let_pattern_else')
                match mir_lower_let_pattern_else_then_jump(
                  else_state, has_else, else_body, continue_block_step.block_id) {
                  Err(errors) => Err(errors),
                  Ok(after_else) =>
                    Ok(mir_lower_start_block(
                      after_else, continue_block_step.block_id, 'let_pattern_continue'))
                }
              end
            }
          end
        }
      end
    end
  }

fn mir_lower_statement(state: MirLowerState, statement: Shared<SemanticStatement>) -> Result<MirLowerState, [string]> = do
  match statement {
    SemanticStatementBreak(_) => mir_lower_break_statement(state),
    SemanticStatementContinue(_) => mir_lower_continue_statement(state),
    SemanticStatementLetPattern(pattern, _, value, _, has_else, else_body, _) =>
      mir_lower_let_pattern_statement(state, pattern, value, has_else, else_body),
    SemanticStatementLet(name, _, value, type_value, _) =>
      match value {
        SemanticExpressionLambda(_, _, _, _) =>
          mir_lower_bind_lambda_statement(state, name, value),
        _ =>
          match mir_lower_rvalue_from_expression(state, value) {
            Err(errors) => Err(errors),
            Ok(rvalue_step) => do
              const local_step = mir_lower_allocate_local(rvalue_step.state, name, type_value)
              let mut next_state = mir_lower_bind_name(local_step.state, name, local_step.local_id)
              Ok(mir_lower_emit_assign(next_state, local_step.local_id, rvalue_step.rvalue))
            end
          }
      },
    SemanticStatementLetConst(name, value, type_value, _) =>
      match value {
        SemanticExpressionLambda(_, _, _, _) =>
          mir_lower_bind_lambda_statement(state, name, value),
        _ =>
          match mir_lower_rvalue_from_expression(state, value) {
            Err(errors) => Err(errors),
            Ok(rvalue_step) => do
              const local_step = mir_lower_allocate_local(rvalue_step.state, name, type_value)
              let mut next_state = mir_lower_bind_name(local_step.state, name, local_step.local_id)
              Ok(mir_lower_emit_assign(next_state, local_step.local_id, rvalue_step.rvalue))
            end
          }
      },
    SemanticStatementReturn(expression, _) =>
      mir_lower_return_expression(state, expression),
    SemanticStatementExpr(expression, _) =>
      match expression {
        SemanticExpressionBin(operation, left, right, _, _) =>
          if mir_lower_is_assign_operation(operation) then
            match left {
              SemanticExpressionIdent(name, _, _) => mir_lower_assign_identifier(state, name, right),
              _ => Err(['mir lower: assignment target must be identifier'])
            }
          else
            match mir_lower_operand_from_expression(state, expression) {
              Err(errors) => Err(errors),
              Ok(operand_step) => Ok(operand_step.state)
            }
          end,
        SemanticExpressionWhile(condition, body_statements, _, _) =>
          mir_lower_while_statement(state, condition, body_statements),
        SemanticExpressionFor(variable_name, iterator, body_statements, _, _) =>
          mir_lower_for_statement(state, variable_name, iterator, body_statements),
        SemanticExpressionMethod(object, method_name, arguments, _, _, _) =>
          if method_name == 'pop' then
            match mir_lower_method_to_local(state, object, method_name, arguments) {
              Err(errors) => Err(errors),
              Ok(local_step) => Ok(local_step.state)
            }
          else if mir_lower_is_mutating_method(method_name) then
            match object {
              SemanticExpressionIdent(name, _, _) =>
                match mir_lower_lookup_local(state, name) {
                  Err(errors) => Err(errors),
                  Ok(local_id) =>
                    mir_lower_mutating_method_statement(state, local_id, method_name, arguments)
                },
              SemanticExpressionField(_, _, _, _) =>
                mir_lower_nested_field_mutating_method_statement(
                  state, object, method_name, arguments),
              _ => Err(['mir lower: mutating method requires identifier receiver'])
            }
          else
            match mir_lower_method_to_local(state, object, method_name, arguments) {
              Err(errors) => Err(errors),
              Ok(local_step) => Ok(local_step.state)
            }
          end,
        SemanticExpressionIf(condition, then_expression, else_expression, _, _) =>
          mir_lower_if_statement(state, condition, then_expression, else_expression),
        SemanticExpressionBlock(_, _, _, _) =>
          mir_lower_discard_expression(state, expression),
        SemanticExpressionUnit(_, _) => Ok(state),
        SemanticExpressionTuple(elements, _, _) =>
          if elements.length() == 0 then Ok(state)
          else Err(['mir lower: non-empty tuple statement not supported']),
        _ =>
          match mir_lower_operand_from_expression(state, expression) {
            Err(errors) => Err(errors),
            Ok(operand_step) => Ok(operand_step.state)
          }
      },
    _ => Err(['mir lower: unsupported statement'])
  }
end

fn mir_lower_statements_from_index(
  state: MirLowerState,
  statements: [Shared<SemanticStatement>],
  index: i32
) -> Result<MirLowerState, [string]> =
  if index >= statements.length() then Ok(state)
  else
    match mir_lower_statement(state, statements[index]) {
      Err(errors) => Err(errors),
      Ok(next_state) => mir_lower_statements_from_index(next_state, statements, index + 1)
    }
  end

fn mir_lower_statements(state: MirLowerState, statements: [Shared<SemanticStatement>]) -> Result<MirLowerState, [string]> =
  mir_lower_statements_from_index(state, statements, 0)

fn mir_lower_param_default(parameter: Shared<Param>) -> MirParamDefault =
  if !parameter.has_default then MirParamDefaultNone
  else
    match parameter.default {
      ExprInt(value, _) => MirParamDefaultInt(value),
      ExprBool(value, _) => MirParamDefaultBool(value),
      ExprStr(value, _) => MirParamDefaultStr(value),
      ExprUnit(_) => MirParamDefaultUnit,
      _ => MirParamDefaultNone
    }
  end

fn mir_lower_build_params(params: [Shared<Param>]) -> [MirParam] = do
  let mut mir_params: [MirParam] = []
  let mut index = 0
  while index < params.length() do
    mir_params.push(MirParam {
      name: params[index].name,
      type_value: mir_lower_unknown_type(),
      default_value: mir_lower_param_default(params[index])
    })
    index = index + 1
  end
  mir_params
end

export fn lower_semantic_function(declaration: Shared<SemanticDeclaration>) -> Result<MirFunction, [string]> = do
  match declaration {
    SemanticDeclarationFn(name, _, _, params, return_type, body, _, _, _) => do
      let mut state = mir_lower_bind_params(mir_lower_state_new(), params)
      match mir_lower_return_expression(state, body) {
        Err(errors) => Err(errors),
        Ok(lowered_state) => Ok(MirFunction {
          name: name,
          params: mir_lower_build_params(params),
          locals: lowered_state.locals,
          blocks: lowered_state.finished_blocks,
          return_type: return_type
        })
      }
    end,
    _ => Err(['mir lower: expected function declaration'])
  }
end
