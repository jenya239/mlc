// Lower typed function bodies to MLC MIR (TRACK_MIR STEP=3).

import {
  Param, Result, Pattern, PatternWild, PatternIdent, PatternInt, PatternBool,
  PatternCtor, PatternUnit, PatternOr, PatternRecord,
  Expr, ExprInt, ExprBool, ExprStr, ExprUnit,
  Span, span_unknown
} from '../frontend/ast'
import {
  SemanticDeclaration, SemanticDeclarationFn,
  SemanticExpression, SemanticStatement, SemanticMatchArm, SemanticFieldVal,
  SemanticExpressionInt, SemanticExpressionBool, SemanticExpressionStr, SemanticExpressionUnit,
  SemanticExpressionIdent, SemanticExpressionBin, SemanticExpressionUn, SemanticExpressionCall,
  SemanticExpressionField, SemanticExpressionMethod, SemanticExpressionIndex,
  SemanticExpressionArray, SemanticExpressionRecord, SemanticExpressionRecordUpdate,
  SemanticExpressionTuple, SemanticExpressionExtern, SemanticExpressionWith,
  SemanticExpressionIf, SemanticExpressionBlock, SemanticExpressionWhile,
  SemanticExpressionFor,
  SemanticExpressionMatch, SemanticExpressionQuestion, SemanticExpressionLambda,
  SemanticExpressionChar, SemanticExpressionFloat,
  SemanticExpressionI64, SemanticExpressionU8, SemanticExpressionUsize,
  SemanticStatementLet, SemanticStatementLetConst, SemanticStatementLetPattern,
  SemanticStatementExpr, SemanticStatementReturn,
  SemanticStatementBreak, SemanticStatementContinue, sexpr_span
} from '../ir/semantic_ir'
import { Type, TUnknown } from '../checker/registry'
import {
  MirFunction, MirParam, MirLocal, MirBlock, MirStmt, MirRvalue, MirOperand,
  MirAssign, MirCallAssign, MirReturn, MirJump, MirCondJump, MirUnreachable, MirTerminator,
  MirRvalueUse, MirRvalueBinary, MirRvalueUnary,
  MirOperandLocal, MirOperandConstInt, MirOperandConstBool, MirOperandConstStr, MirOperandUnit,
  MirParamDefault, MirParamDefaultNone, MirParamDefaultInt, MirParamDefaultBool,
  MirParamDefaultStr, MirParamDefaultUnit,
  LocalId, BlockId, mir_local_id, mir_block_id
} from './mir_types'
import {
  MirIdPool, mir_id_pool_new, mir_id_pool_locals_reserved,
  mir_id_pool_allocate_local, mir_id_pool_allocate_block
} from './mir_ids'

// Bound lambda: not a first-class VmValue. Call site inlines body
// (params → locals, then body). Captures resolve via name_environment.
type MirLambdaBinding = MirLambdaBinding {
  name: string,
  parameter_names: [string],
  body: Shared<SemanticExpression>
}

type MirLowerState = MirLowerState {
  name_environment: Map<string, LocalId>,
  lambda_bindings: [MirLambdaBinding],
  locals: [MirLocal],
  finished_blocks: [MirBlock],
  current_block_id: BlockId,
  current_label: string,
  current_stmts: [MirStmt],
  id_pool: MirIdPool,
  loop_break_targets: [BlockId],
  loop_continue_targets: [BlockId]
}

type MirLowerBlockStep = MirLowerBlockStep { state: MirLowerState, block_id: BlockId }
type MirLowerLocalStep = MirLowerLocalStep { state: MirLowerState, local_id: LocalId }

fn mir_lower_unknown_type() -> Shared<Type> = Shared.new(TUnknown)

fn mir_lower_is_assign_operation(operation: string) -> bool = operation == "="

fn mir_lower_state_new() -> MirLowerState = MirLowerState {
  name_environment: Map.new(),
  lambda_bindings: [],
  locals: [],
  finished_blocks: [],
  current_block_id: mir_block_id(0),
  current_label: 'entry',
  current_stmts: [],
  id_pool: mir_id_pool_new(),
  loop_break_targets: [],
  loop_continue_targets: []
}

fn mir_lower_block_id_stack_without_last(targets: [BlockId]) -> [BlockId] = do
  let mut result: [BlockId] = []
  let mut index = 0
  const limit = targets.length() - 1
  while index < limit do
    result.push(targets[index])
    index = index + 1
  end
  result
end

fn mir_lower_push_loop_targets(
  state: MirLowerState,
  break_target: BlockId,
  continue_target: BlockId
) -> MirLowerState = do
  let mut break_targets = state.loop_break_targets
  let mut continue_targets = state.loop_continue_targets
  break_targets.push(break_target)
  continue_targets.push(continue_target)
  MirLowerState {
    ...state,
    loop_break_targets: break_targets,
    loop_continue_targets: continue_targets
  }
end

fn mir_lower_pop_loop_targets(state: MirLowerState) -> MirLowerState =
  if state.loop_break_targets.length() == 0 then state
  else
    MirLowerState {
      ...state,
      loop_break_targets: mir_lower_block_id_stack_without_last(state.loop_break_targets),
      loop_continue_targets: mir_lower_block_id_stack_without_last(state.loop_continue_targets)
    }
  end

fn mir_lower_lookup_loop_break_target(state: MirLowerState) -> Result<BlockId, [string]> =
  if state.loop_break_targets.length() == 0 then Err(['mir lower: break outside loop'])
  else Ok(state.loop_break_targets[state.loop_break_targets.length() - 1])
  end

fn mir_lower_lookup_loop_continue_target(state: MirLowerState) -> Result<BlockId, [string]> =
  if state.loop_continue_targets.length() == 0 then Err(['mir lower: continue outside loop'])
  else Ok(state.loop_continue_targets[state.loop_continue_targets.length() - 1])
  end

fn mir_lower_bind_lambda(
  state: MirLowerState,
  name: string,
  parameter_names: [string],
  body: Shared<SemanticExpression>
) -> MirLowerState = do
  let mut bindings = state.lambda_bindings
  bindings.push(MirLambdaBinding {
    name: name,
    parameter_names: parameter_names,
    body: body
  })
  MirLowerState { ...state, lambda_bindings: bindings }
end

fn mir_lower_lookup_lambda(
  state: MirLowerState,
  name: string
) -> Result<MirLambdaBinding, [string]> = do
  let mut index = 0
  while index < state.lambda_bindings.length() do
    const binding = state.lambda_bindings[index]
    if binding.name == name then return Ok(binding) end
    index = index + 1
  end
  Err([`mir lower: unknown lambda ${name}`])
end

fn mir_lower_allocate_block_index(state: MirLowerState) -> MirLowerBlockStep = do
  const block_step = mir_id_pool_allocate_block(state.id_pool)
  MirLowerBlockStep {
    state: MirLowerState { ...state, id_pool: block_step.pool },
    block_id: block_step.block_id
  }
end

fn mir_lower_finish_current_block(state: MirLowerState, terminator: MirTerminator) -> MirLowerState = do
  let mut finished_blocks = state.finished_blocks
  finished_blocks.push(MirBlock {
    id: state.current_block_id,
    label: state.current_label,
    stmts: state.current_stmts,
    term: terminator
  })
  MirLowerState { ...state, finished_blocks: finished_blocks, current_stmts: [] }
end

fn mir_lower_start_block(state: MirLowerState, block_id: BlockId, label: string) -> MirLowerState =
  MirLowerState { ...state, current_block_id: block_id, current_label: label, current_stmts: [] }

fn mir_lower_jump_to_loop_target_then_dead(
  state: MirLowerState,
  target: BlockId,
  dead_label: string
) -> MirLowerState = do
  let mut next_state = mir_lower_finish_current_block(state, MirJump(target))
  const dead_step = mir_lower_allocate_block_index(next_state)
  mir_lower_start_block(dead_step.state, dead_step.block_id, dead_label)
end

fn mir_lower_bind_params(state: MirLowerState, params: [Shared<Param>]) -> MirLowerState = do
  let mut environment = state.name_environment
  let mut index = 0
  while index < params.length() do
    environment.set(params[index].name, mir_local_id(index))
    index = index + 1
  end
  MirLowerState { ...state, name_environment: environment, id_pool: mir_id_pool_locals_reserved(state.id_pool, index) }
end

fn mir_lower_allocate_local(state: MirLowerState, name: string, type_value: Shared<Type>) -> MirLowerLocalStep = do
  const local_step = mir_id_pool_allocate_local(state.id_pool)
  let mut locals = state.locals
  locals.push(MirLocal { id: local_step.local_id, name: name, type_value: type_value })
  MirLowerLocalStep {
    state: MirLowerState { ...state, locals: locals, id_pool: local_step.pool },
    local_id: local_step.local_id
  }
end

fn mir_lower_bind_name(state: MirLowerState, name: string, local_id: LocalId) -> MirLowerState = do
  let mut environment = state.name_environment
  environment.set(name, local_id)
  MirLowerState { ...state, name_environment: environment }
end

fn mir_lower_lookup_local(state: MirLowerState, name: string) -> Result<LocalId, [string]> = do
  if state.name_environment.has(name) then Ok(state.name_environment.get(name))
  else Err([`mir lower: unknown local ${name}`])
  end
end

fn mir_lower_emit_assign(state: MirLowerState, local_id: LocalId, rvalue: MirRvalue) -> MirLowerState = do
  let mut statements = state.current_stmts
  statements.push(MirAssign(local_id, rvalue))
  MirLowerState { ...state, current_stmts: statements }
end

fn mir_lower_emit_call_assign(
  state: MirLowerState,
  local_id: LocalId,
  callee_name: string,
  arguments: [MirOperand]
) -> MirLowerState = do
  let mut statements = state.current_stmts
  statements.push(MirCallAssign(local_id, callee_name, arguments))
  MirLowerState { ...state, current_stmts: statements }
end

fn mir_lower_is_variant_ctor_name(name: string) -> bool =
  name.length() > 0 && name.char_at(0) >= "A" && name.char_at(0) <= "Z" && !name.contains("_")

fn mir_lower_call_target_name(expression: Shared<SemanticExpression>) -> Result<string, [string]> =
  match expression {
    SemanticExpressionIdent(name, _, _) => Ok(name),
    SemanticExpressionField(receiver, field_name, _, _) =>
      match receiver {
        SemanticExpressionIdent(type_name, _, _) =>
          if type_name == 'Map' && field_name == 'new' then Ok('__mir_map_empty')
          else Err(['mir lower: unsupported static field call']),
        _ => Err(['mir lower: call target must be identifier'])
      },
    _ => Err(['mir lower: call target must be identifier'])
  }

fn mir_lower_variant_new_arguments(
  tag: string,
  payload_operands: [MirOperand]
) -> [MirOperand] = do
  let mut arguments: [MirOperand] = [MirOperandConstStr(tag)]
  let mut index = 0
  while index < payload_operands.length() do
    arguments.push(payload_operands[index])
    index = index + 1
  end
  arguments
end

fn mir_lower_method_native_name(method_name: string) -> Result<string, [string]> =
  if method_name == 'push' then Ok('__mir_array_push')
  else if method_name == 'pop' then Ok('__mir_array_pop')
  else if method_name == 'get' then Ok('__mir_map_get')
  else if method_name == 'set' then Ok('__mir_map_set')
  else if method_name == 'length' then Ok('__mir_length')
  else if method_name == 'contains' then Ok('__mir_string_contains')
  else if method_name == 'substring' then Ok('__mir_string_substring')
  else if method_name == 'byte_substring' then Ok('__mir_string_byte_substring')
  else if method_name == 'char_at' then Ok('__mir_string_char_at')
  else if method_name == 'to_string' then Ok('__mir_to_string')
  else if method_name == 'join' then Ok('__mir_array_join')
  else if method_name == 'concat' then Ok('__mir_array_concat')
  else if method_name == 'has' then Ok('__mir_map_has')
  else if method_name == 'to_i' then Ok('__mir_string_to_i')
  else if method_name == 'index_of' then Ok('__mir_string_index_of')
  else if method_name == 'trim' then Ok('__mir_string_trim')
  else if method_name == 'drop' then Ok('__mir_array_drop')
  else if method_name == 'byte_size' then Ok('__mir_string_byte_size')
  else if method_name == 'upper' then Ok('__mir_string_upper')
  else if method_name == 'to_lower' then Ok('__mir_string_to_lower')
  else if method_name == 'take' then Ok('__mir_array_take')
  else Err([`mir lower: unsupported method ${method_name}`])

fn mir_lower_module_qualified_method_to_local(
  state: MirLowerState,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_operands_from_arguments(state, arguments) {
    Err(errors) => Err(errors),
    Ok(operands_step) => do
      const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
      Ok(MirLowerLocalStep {
        state: mir_lower_emit_call_assign(
          local_step.state, local_step.local_id, method_name, operands_step.operands),
        local_id: local_step.local_id
      })
    end
  }

fn mir_lower_file_static_method_to_local(
  state: MirLowerState,
  method_name: string,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> =
  if method_name == 'exists' && arguments.length() == 1 then
    match mir_lower_operands_from_arguments(state, arguments) {
      Err(errors) => Err(errors),
      Ok(operands_step) => do
        const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
        Ok(MirLowerLocalStep {
          state: mir_lower_emit_call_assign(
            local_step.state, local_step.local_id, '__mir_file_exists', operands_step.operands),
          local_id: local_step.local_id
        })
      end
    }
  else if method_name == 'read' && arguments.length() == 1 then
    match mir_lower_operands_from_arguments(state, arguments) {
      Err(errors) => Err(errors),
      Ok(operands_step) => do
        const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
        Ok(MirLowerLocalStep {
          state: mir_lower_emit_call_assign(
            local_step.state, local_step.local_id, '__mir_file_read', operands_step.operands),
          local_id: local_step.local_id
        })
      end
    }
  else if method_name == 'write' && arguments.length() == 2 then
    match mir_lower_operands_from_arguments(state, arguments) {
      Err(errors) => Err(errors),
      Ok(operands_step) => do
        const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
        Ok(MirLowerLocalStep {
          state: mir_lower_emit_call_assign(
            local_step.state, local_step.local_id, '__mir_file_write', operands_step.operands),
          local_id: local_step.local_id
        })
      end
    }
  else if method_name == 'make_temp_directory' && arguments.length() == 1 then
    match mir_lower_operands_from_arguments(state, arguments) {
      Err(errors) => Err(errors),
      Ok(operands_step) => do
        const local_step = mir_lower_allocate_local(operands_step.state, '', mir_lower_unknown_type())
        Ok(MirLowerLocalStep {
          state: mir_lower_emit_call_assign(
            local_step.state, local_step.local_id, '__mir_file_make_temp_directory', operands_step.operands),
          local_id: local_step.local_id
        })
      end
    }
  else
    Err([`mir lower: unsupported File.${method_name}`])
  end

fn mir_lower_is_mutating_method(method_name: string) -> bool =
  method_name == 'push' || method_name == 'set' || method_name == 'pop'

fn mir_lower_array_push_elements(
  state: MirLowerState,
  array_local_id: LocalId,
  elements: [Shared<SemanticExpression>],
  index: i32
) -> Result<MirLowerLocalStep, [string]> =
  if index >= elements.length() then
    Ok(MirLowerLocalStep { state: state, local_id: array_local_id })
  else
    match mir_lower_operand_from_expression(state, elements[index]) {
      Err(errors) => Err(errors),
      Ok(element_step) => do
        const push_result_step = mir_lower_allocate_local(element_step.state, '', mir_lower_unknown_type())
        const push_state = mir_lower_emit_call_assign(
          push_result_step.state,
          push_result_step.local_id,
          '__mir_array_push',
          [MirOperandLocal(array_local_id), element_step.operand])
        mir_lower_array_push_elements(push_state, push_result_step.local_id, elements, index + 1)
      end
    }
  end

fn mir_lower_array_literal_to_local(
  state: MirLowerState,
  elements: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> = do
  const empty_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  const empty_state = mir_lower_emit_call_assign(
    empty_step.state, empty_step.local_id, '__mir_array_empty', [])
  mir_lower_array_push_elements(empty_state, empty_step.local_id, elements, 0)
end

fn mir_lower_index_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  index_expression: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_operand_from_expression(state, object) {
    Err(errors) => Err(errors),
    Ok(object_step) =>
      match mir_lower_operand_from_expression(object_step.state, index_expression) {
        Err(errors) => Err(errors),
        Ok(index_step) => do
          const local_step = mir_lower_allocate_local(index_step.state, '', mir_lower_unknown_type())
          Ok(MirLowerLocalStep {
            state: mir_lower_emit_call_assign(
              local_step.state,
              local_step.local_id,
              '__mir_array_get',
              [object_step.operand, index_step.operand]),
            local_id: local_step.local_id
          })
        end
      }
  }

fn mir_lower_map_new_local(state: MirLowerState) -> Result<MirLowerLocalStep, [string]> = do
  const local_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
  Ok(MirLowerLocalStep {
    state: mir_lower_emit_call_assign(local_step.state, local_step.local_id, '__mir_map_empty', []),
    local_id: local_step.local_id
  })
end

fn mir_lower_shared_new_to_local(
  state: MirLowerState,
  arguments: [Shared<SemanticExpression>]
) -> Result<MirLowerLocalStep, [string]> =
  if arguments.length() != 1 then
    Err(['mir lower: Shared.new expects 1 argument'])
  else
    match mir_lower_operand_from_expression(state, arguments[0]) {
      Err(errors) => Err(errors),
      Ok(argument_step) => do
        const local_step = mir_lower_allocate_local(argument_step.state, '', mir_lower_unknown_type())
        Ok(MirLowerLocalStep {
          state: mir_lower_emit_call_assign(
            local_step.state,
            local_step.local_id,
            '__mir_shared_new',
            [argument_step.operand]),
          local_id: local_step.local_id
        })
      end
    }
  end

fn mir_lower_array_pop_expression(
  state: MirLowerState,
  array_name: string
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_lookup_local(state, array_name) {
    Err(errors) => Err(errors),
    Ok(array_local_id) => do
      const length_step = mir_lower_allocate_local(state, '', mir_lower_unknown_type())
      let mut next_state = mir_lower_emit_call_assign(
        length_step.state,
        length_step.local_id,
        '__mir_length',
        [MirOperandLocal(array_local_id)])
      const subtract_op = "-"
      const last_index_step = mir_lower_temp_operand_from_rvalue(
        next_state,
        MirRvalueBinary(subtract_op, MirOperandLocal(length_step.local_id), MirOperandConstInt(1)))
      next_state = last_index_step.state
      const value_step = mir_lower_allocate_local(next_state, '', mir_lower_unknown_type())
      next_state = mir_lower_emit_call_assign(
        value_step.state,
        value_step.local_id,
        '__mir_array_get',
        [MirOperandLocal(array_local_id), last_index_step.operand])
      const popped_step = mir_lower_allocate_local(next_state, '', mir_lower_unknown_type())
      next_state = mir_lower_emit_call_assign(
        popped_step.state,
        popped_step.local_id,
        '__mir_array_pop',
        [MirOperandLocal(array_local_id)])
      next_state = mir_lower_emit_assign(
        next_state, array_local_id, MirRvalueUse(MirOperandLocal(popped_step.local_id)))
      Ok(MirLowerLocalStep { state: next_state, local_id: value_step.local_id })
    end
  }

fn mir_lower_synthetic_callback_parameter_names(expected_arity: i32) -> [string] = do
  let mut parameter_names: [string] = []
  let mut parameter_index = 0
  while parameter_index < expected_arity do
    parameter_names.push(`callback_argument_${parameter_index}`)
    parameter_index = parameter_index + 1
  end
  parameter_names
end

fn mir_lower_named_fn_callback_binding(
  function_name: string,
  expected_arity: i32,
  source_span: Span
) -> MirLambdaBinding = do
  const parameter_names = mir_lower_synthetic_callback_parameter_names(expected_arity)
  let mut call_arguments: [Shared<SemanticExpression>] = []
  let mut parameter_index = 0
  while parameter_index < parameter_names.length() do
    call_arguments.push(Shared.new(SemanticExpressionIdent(
      parameter_names[parameter_index], mir_lower_unknown_type(), source_span)))
    parameter_index = parameter_index + 1
  end
  let empty_named_argument_indices: [i32] = []
  const call_body = Shared.new(SemanticExpressionCall(
    Shared.new(SemanticExpressionIdent(function_name, mir_lower_unknown_type(), source_span)),
    call_arguments,
    empty_named_argument_indices,
    mir_lower_unknown_type(),
    source_span
  ))
  MirLambdaBinding {
    name: function_name,
    parameter_names: parameter_names,
    body: call_body
  }
end

fn mir_lower_resolve_predicate_callback(
  state: MirLowerState,
  callback: Shared<SemanticExpression>,
  expected_arity: i32
) -> Result<MirLambdaBinding, [string]> =
  match callback {
    SemanticExpressionLambda(parameter_names, body, _, _) =>
      Ok(MirLambdaBinding {
        name: '',
        parameter_names: parameter_names,
        body: body
      }),
    SemanticExpressionIdent(name, _, _) =>
      match mir_lower_lookup_lambda(state, name) {
        Ok(binding) => Ok(binding),
        Err(_) =>
          Ok(mir_lower_named_fn_callback_binding(name, expected_arity, sexpr_span(callback)))
      },
    _ => Err(['mir lower: predicate callback must be lambda'])
  }

// any/all → index walk + inline predicate lambda (no VM HOF native).
fn mir_lower_array_predicate_hof_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  method_name: string,
  callback: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_resolve_predicate_callback(state, callback, 1) {
    Err(errors) => Err(errors),
    Ok(binding) =>
      if binding.parameter_names.length() != 1 then
        Err(['mir lower: any/all predicate expects one parameter'])
      else
        match mir_lower_expression_to_local(state, object) {
          Err(errors) => Err(errors),
          Ok(array_step) => do
            const initial_flag = method_name == 'all'
            const result_step = mir_lower_allocate_local(
              array_step.state, '', mir_lower_unknown_type())
            let mut prep_state = mir_lower_emit_assign(
              result_step.state,
              result_step.local_id,
              MirRvalueUse(MirOperandConstBool(initial_flag)))
            const index_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_assign(
              index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
            const loop_header_step = mir_lower_allocate_block_index(prep_state)
            const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
            const early_block_step = mir_lower_allocate_block_index(body_block_step.state)
            const continue_block_step = mir_lower_allocate_block_index(early_block_step.state)
            const exit_block_step = mir_lower_allocate_block_index(continue_block_step.state)
            const hof_blocks_allocated_state = exit_block_step.state
            prep_state = mir_lower_finish_current_block(
              hof_blocks_allocated_state, MirJump(loop_header_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, loop_header_step.block_id, 'hof_predicate_loop')
            const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              length_step.state,
              length_step.local_id,
              '__mir_length',
              [MirOperandLocal(array_step.local_id)])
            const less_op = "<"
            const compare_step = mir_lower_temp_operand_from_rvalue(
              prep_state,
              MirRvalueBinary(
                less_op,
                MirOperandLocal(index_step.local_id),
                MirOperandLocal(length_step.local_id)))
            prep_state = mir_lower_finish_current_block(
              compare_step.state,
              MirCondJump(
                compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, body_block_step.block_id, 'hof_predicate_body')
            const element_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              element_step.state,
              element_step.local_id,
              '__mir_array_get',
              [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
            const predicate_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            match mir_lower_lambda_inline_body(
              predicate_step.state,
              binding.parameter_names,
              binding.body,
              [MirOperandLocal(element_step.local_id)],
              predicate_step.local_id) {
              Err(errors) => Err(errors),
              Ok(after_predicate) => do
                const early_then = method_name == 'any'
                const then_block_id = if early_then then early_block_step.block_id
                  else continue_block_step.block_id
                const else_block_id = if early_then then continue_block_step.block_id
                  else early_block_step.block_id
                let mut branch_state = mir_lower_finish_current_block(
                  after_predicate,
                  MirCondJump(
                    MirOperandLocal(predicate_step.local_id), then_block_id, else_block_id))
                branch_state = mir_lower_start_block(
                  branch_state, early_block_step.block_id, 'hof_predicate_early')
                const early_flag = method_name == 'any'
                branch_state = mir_lower_emit_assign(
                  branch_state,
                  result_step.local_id,
                  MirRvalueUse(MirOperandConstBool(early_flag)))
                branch_state = mir_lower_finish_current_block(
                  branch_state, MirJump(exit_block_step.block_id))
                branch_state = mir_lower_start_block(
                  branch_state, continue_block_step.block_id, 'hof_predicate_continue')
                const add_op = "+"
                const next_index_step = mir_lower_temp_operand_from_rvalue(
                  branch_state,
                  MirRvalueBinary(
                    add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
                let mut exit_state = mir_lower_emit_assign(
                  next_index_step.state,
                  index_step.local_id,
                  MirRvalueUse(next_index_step.operand))
                exit_state = mir_lower_finish_current_block(
                  exit_state, MirJump(loop_header_step.block_id))
                exit_state = mir_lower_start_block(
                  exit_state, exit_block_step.block_id, 'hof_predicate_exit')
                Ok(MirLowerLocalStep { state: exit_state, local_id: result_step.local_id })
              end
            }
          end
        }
      end
  }

// filter → index walk + inline predicate; keep elements via empty/push (no VM HOF native).
fn mir_lower_array_filter_hof_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  callback: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_resolve_predicate_callback(state, callback, 1) {
    Err(errors) => Err(errors),
    Ok(binding) =>
      if binding.parameter_names.length() != 1 then
        Err(['mir lower: filter predicate expects one parameter'])
      else
        match mir_lower_expression_to_local(state, object) {
          Err(errors) => Err(errors),
          Ok(array_step) => do
            const result_step = mir_lower_allocate_local(
              array_step.state, '', mir_lower_unknown_type())
            let mut prep_state = mir_lower_emit_call_assign(
              result_step.state,
              result_step.local_id,
              '__mir_array_empty',
              [])
            const index_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_assign(
              index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
            const loop_header_step = mir_lower_allocate_block_index(prep_state)
            const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
            const keep_block_step = mir_lower_allocate_block_index(body_block_step.state)
            const continue_block_step = mir_lower_allocate_block_index(keep_block_step.state)
            const exit_block_step = mir_lower_allocate_block_index(continue_block_step.state)
            const hof_blocks_allocated_state = exit_block_step.state
            prep_state = mir_lower_finish_current_block(
              hof_blocks_allocated_state, MirJump(loop_header_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, loop_header_step.block_id, 'hof_filter_loop')
            const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              length_step.state,
              length_step.local_id,
              '__mir_length',
              [MirOperandLocal(array_step.local_id)])
            const less_op = "<"
            const compare_step = mir_lower_temp_operand_from_rvalue(
              prep_state,
              MirRvalueBinary(
                less_op,
                MirOperandLocal(index_step.local_id),
                MirOperandLocal(length_step.local_id)))
            prep_state = mir_lower_finish_current_block(
              compare_step.state,
              MirCondJump(
                compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, body_block_step.block_id, 'hof_filter_body')
            const element_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              element_step.state,
              element_step.local_id,
              '__mir_array_get',
              [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
            const predicate_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            match mir_lower_lambda_inline_body(
              predicate_step.state,
              binding.parameter_names,
              binding.body,
              [MirOperandLocal(element_step.local_id)],
              predicate_step.local_id) {
              Err(errors) => Err(errors),
              Ok(after_predicate) => do
                let mut branch_state = mir_lower_finish_current_block(
                  after_predicate,
                  MirCondJump(
                    MirOperandLocal(predicate_step.local_id),
                    keep_block_step.block_id,
                    continue_block_step.block_id))
                branch_state = mir_lower_start_block(
                  branch_state, keep_block_step.block_id, 'hof_filter_keep')
                const pushed_step = mir_lower_allocate_local(
                  branch_state, '', mir_lower_unknown_type())
                branch_state = mir_lower_emit_call_assign(
                  pushed_step.state,
                  pushed_step.local_id,
                  '__mir_array_push',
                  [
                    MirOperandLocal(result_step.local_id),
                    MirOperandLocal(element_step.local_id)
                  ])
                branch_state = mir_lower_emit_assign(
                  branch_state,
                  result_step.local_id,
                  MirRvalueUse(MirOperandLocal(pushed_step.local_id)))
                branch_state = mir_lower_finish_current_block(
                  branch_state, MirJump(continue_block_step.block_id))
                branch_state = mir_lower_start_block(
                  branch_state, continue_block_step.block_id, 'hof_filter_continue')
                const add_op = "+"
                const next_index_step = mir_lower_temp_operand_from_rvalue(
                  branch_state,
                  MirRvalueBinary(
                    add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
                let mut exit_state = mir_lower_emit_assign(
                  next_index_step.state,
                  index_step.local_id,
                  MirRvalueUse(next_index_step.operand))
                exit_state = mir_lower_finish_current_block(
                  exit_state, MirJump(loop_header_step.block_id))
                exit_state = mir_lower_start_block(
                  exit_state, exit_block_step.block_id, 'hof_filter_exit')
                Ok(MirLowerLocalStep { state: exit_state, local_id: result_step.local_id })
              end
            }
          end
        }
      end
  }

// find_index → index walk + inline predicate; first true index or -1.
fn mir_lower_array_find_index_hof_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  callback: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_resolve_predicate_callback(state, callback, 1) {
    Err(errors) => Err(errors),
    Ok(binding) =>
      if binding.parameter_names.length() != 1 then
        Err(['mir lower: find_index predicate expects one parameter'])
      else
        match mir_lower_expression_to_local(state, object) {
          Err(errors) => Err(errors),
          Ok(array_step) => do
            const result_step = mir_lower_allocate_local(
              array_step.state, '', mir_lower_unknown_type())
            let mut prep_state = mir_lower_emit_assign(
              result_step.state,
              result_step.local_id,
              MirRvalueUse(MirOperandConstInt(0 - 1)))
            const index_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_assign(
              index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
            const loop_header_step = mir_lower_allocate_block_index(prep_state)
            const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
            const found_block_step = mir_lower_allocate_block_index(body_block_step.state)
            const continue_block_step = mir_lower_allocate_block_index(found_block_step.state)
            const exit_block_step = mir_lower_allocate_block_index(continue_block_step.state)
            const hof_blocks_allocated_state = exit_block_step.state
            prep_state = mir_lower_finish_current_block(
              hof_blocks_allocated_state, MirJump(loop_header_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, loop_header_step.block_id, 'hof_find_index_loop')
            const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              length_step.state,
              length_step.local_id,
              '__mir_length',
              [MirOperandLocal(array_step.local_id)])
            const less_op = "<"
            const compare_step = mir_lower_temp_operand_from_rvalue(
              prep_state,
              MirRvalueBinary(
                less_op,
                MirOperandLocal(index_step.local_id),
                MirOperandLocal(length_step.local_id)))
            prep_state = mir_lower_finish_current_block(
              compare_step.state,
              MirCondJump(
                compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, body_block_step.block_id, 'hof_find_index_body')
            const element_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              element_step.state,
              element_step.local_id,
              '__mir_array_get',
              [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
            const predicate_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            match mir_lower_lambda_inline_body(
              predicate_step.state,
              binding.parameter_names,
              binding.body,
              [MirOperandLocal(element_step.local_id)],
              predicate_step.local_id) {
              Err(errors) => Err(errors),
              Ok(after_predicate) => do
                let mut branch_state = mir_lower_finish_current_block(
                  after_predicate,
                  MirCondJump(
                    MirOperandLocal(predicate_step.local_id),
                    found_block_step.block_id,
                    continue_block_step.block_id))
                branch_state = mir_lower_start_block(
                  branch_state, found_block_step.block_id, 'hof_find_index_found')
                branch_state = mir_lower_emit_assign(
                  branch_state,
                  result_step.local_id,
                  MirRvalueUse(MirOperandLocal(index_step.local_id)))
                branch_state = mir_lower_finish_current_block(
                  branch_state, MirJump(exit_block_step.block_id))
                branch_state = mir_lower_start_block(
                  branch_state, continue_block_step.block_id, 'hof_find_index_continue')
                const add_op = "+"
                const next_index_step = mir_lower_temp_operand_from_rvalue(
                  branch_state,
                  MirRvalueBinary(
                    add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
                let mut exit_state = mir_lower_emit_assign(
                  next_index_step.state,
                  index_step.local_id,
                  MirRvalueUse(next_index_step.operand))
                exit_state = mir_lower_finish_current_block(
                  exit_state, MirJump(loop_header_step.block_id))
                exit_state = mir_lower_start_block(
                  exit_state, exit_block_step.block_id, 'hof_find_index_exit')
                Ok(MirLowerLocalStep { state: exit_state, local_id: result_step.local_id })
              end
            }
          end
        }
      end
  }

// map → index walk + inline callback; push mapped values (no VM HOF native).
fn mir_lower_array_map_hof_to_local(
  state: MirLowerState,
  object: Shared<SemanticExpression>,
  callback: Shared<SemanticExpression>
) -> Result<MirLowerLocalStep, [string]> =
  match mir_lower_resolve_predicate_callback(state, callback, 1) {
    Err(errors) => Err(errors),
    Ok(binding) =>
      if binding.parameter_names.length() != 1 then
        Err(['mir lower: map callback expects one parameter'])
      else
        match mir_lower_expression_to_local(state, object) {
          Err(errors) => Err(errors),
          Ok(array_step) => do
            const result_step = mir_lower_allocate_local(
              array_step.state, '', mir_lower_unknown_type())
            let mut prep_state = mir_lower_emit_call_assign(
              result_step.state,
              result_step.local_id,
              '__mir_array_empty',
              [])
            const index_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_assign(
              index_step.state, index_step.local_id, MirRvalueUse(MirOperandConstInt(0)))
            const loop_header_step = mir_lower_allocate_block_index(prep_state)
            const body_block_step = mir_lower_allocate_block_index(loop_header_step.state)
            const exit_block_step = mir_lower_allocate_block_index(body_block_step.state)
            const hof_blocks_allocated_state = exit_block_step.state
            prep_state = mir_lower_finish_current_block(
              hof_blocks_allocated_state, MirJump(loop_header_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, loop_header_step.block_id, 'hof_map_loop')
            const length_step = mir_lower_allocate_local(prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              length_step.state,
              length_step.local_id,
              '__mir_length',
              [MirOperandLocal(array_step.local_id)])
            const less_op = "<"
            const compare_step = mir_lower_temp_operand_from_rvalue(
              prep_state,
              MirRvalueBinary(
                less_op,
                MirOperandLocal(index_step.local_id),
                MirOperandLocal(length_step.local_id)))
            prep_state = mir_lower_finish_current_block(
              compare_step.state,
              MirCondJump(
                compare_step.operand, body_block_step.block_id, exit_block_step.block_id))
            prep_state = mir_lower_start_block(
              prep_state, body_block_step.block_id, 'hof_map_body')
            const element_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            prep_state = mir_lower_emit_call_assign(
              element_step.state,
              element_step.local_id,
              '__mir_array_get',
              [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
            const mapped_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            match mir_lower_lambda_inline_body(
              mapped_step.state,
              binding.parameter_names,
              binding.body,
              [MirOperandLocal(element_step.local_id)],
              mapped_step.local_id) {
              Err(errors) => Err(errors),
              Ok(after_mapped) => do
                const pushed_step = mir_lower_allocate_local(
                  after_mapped, '', mir_lower_unknown_type())
                let mut body_state = mir_lower_emit_call_assign(
                  pushed_step.state,
                  pushed_step.local_id,
                  '__mir_array_push',
                  [
                    MirOperandLocal(result_step.local_id),
                    MirOperandLocal(mapped_step.local_id)
                  ])
                body_state = mir_lower_emit_assign(
                  body_state,
                  result_step.local_id,
                  MirRvalueUse(MirOperandLocal(pushed_step.local_id)))
                const add_op = "+"
                const next_index_step = mir_lower_temp_operand_from_rvalue(
                  body_state,
                  MirRvalueBinary(
                    add_op, MirOperandLocal(index_step.local_id), MirOperandConstInt(1)))
                body_state = mir_lower_emit_assign(
                  next_index_step.state,
                  index_step.local_id,
                  MirRvalueUse(next_index_step.operand))
                body_state = mir_lower_finish_current_block(
                  body_state, MirJump(loop_header_step.block_id))
                body_state = mir_lower_start_block(
                  body_state, exit_block_step.block_id, 'hof_map_exit')
                Ok(MirLowerLocalStep { state: body_state, local_id: result_step.local_id })
              end
            }
          end
        }
      end
  }

