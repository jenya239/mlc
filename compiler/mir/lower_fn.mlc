                  body_state, MirJump(loop_header_step.block_id))
                body_state = mir_lower_start_block(
                  body_state, exit_block_step.block_id, 'hof_flat_map_exit')
                Ok(MirLowerLocalStep { state: body_state, local_id: result_step.local_id })
              end
