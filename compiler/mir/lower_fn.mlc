              element_step.state,
              element_step.local_id,
              '__mir_array_get',
              [MirOperandLocal(array_step.local_id), MirOperandLocal(index_step.local_id)])
            const mapped_step = mir_lower_allocate_local(
              prep_state, '', mir_lower_unknown_type())
            match mir_lower_lambda_inline_body(
              mapped_step.state,
              binding.parameter_names,
              binding.body,
              [MirOperandLocal(element_step.local_id)],
              mapped_step.local_id) {
              Err(errors) => Err(errors),
              Ok(after_mapped) => do
                const concat_step = mir_lower_allocate_local(
                  after_mapped, '', mir_lower_unknown_type())
                let mut body_state = mir_lower_emit_call_assign(
                  concat_step.state,
                  concat_step.local_id,
