// Guarded if-chain + string-literal if-chain match codegen. Both the
// string-return-type and CppExpression-IR match entry points funnel through
// this single, flavor-agnostic statement-builder core (the _cpp variants
// wrap eval_expr_cpp_fn through print_expr into a string-producing closure
// and feed it into the same builder as the string-flavor callers).

import { Pattern, PatternWild, PatternStr, PatternStringLit, PatternCtor, PatternIdent, PatternArray } from '../../frontend/ast'
import { SemanticExpression, SemanticStatement, SemanticMatchArm } from '../../ir/semantic_ir'
import { CodegenContext, lookup_ctor_type_info_for_context, lookup_fields_for_context } from '../context'
import { cpp_safe, lower_first } from '../cpp_naming'
import { list_contains } from '../decl/decl_index'
import { pattern_binding_name_list, first_arm_needs_deref, cyclic_sum_subject_member_suffix } from './match_analysis'
import { constructor_payload_binding } from './let_pat'
import { codegen_context_with_ctor_field_bindings } from './match_field_binding'
import { generic_ctor_type_argument } from './match_generic_ctor_type'
import { visit_subject_for_match } from './match_arm_lambda'
import {
  CppExpression,
  CppStatement,
  CppBinary,
  CppIdent,
  CppCall,
  CppMember,
  CppConstDecl,
  CppTypeName,
  CppTypeRef,
  CppInvokedBlockWithReturn,
  CppInvokedBlock
} from '../../cpp_ir/cpp_ast'
import * as emit_helpers from '../../cpp_emit/emit_helpers'
import { print_expr, print_statement } from '../../cpp_emit/print'
import { gen_boolean_literal_cpp, gen_integer_literal_cpp, gen_string_literal_cpp } from './literals'
import { match_return_cpp_type } from './match_result_type'
import { Type } from '../../checker/registry'
import { sem_type_to_cpp } from '../decl/type_gen'

export fn match_visit_uses_void_lambdas(match_result_type: Shared<Type>) -> bool =
  match match_result_type { TUnit => true, _ => false }

fn guarded_literal_condition_cpp(pattern: Shared<Pattern>, variant_access_expression: string) -> Shared<CppExpression> =
  match pattern {
    PatternBool(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(variant_access_expression)),
        gen_boolean_literal_cpp(value))),
    PatternInt(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(variant_access_expression)),
        gen_integer_literal_cpp(value))),
    PatternStr(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(variant_access_expression)),
        gen_string_literal_cpp(value))),
    PatternStringLit(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(variant_access_expression)),
        gen_string_literal_cpp(value))),
    _ => emit_helpers.make_boolean_cpp_expression(false)
  }

fn evaluated_expression_as_cpp(
  expression: Shared<SemanticExpression>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> Shared<CppExpression> =
  emit_helpers.make_identifier_cpp_expression(eval_expr_fn(expression, context, gen_stmts))

// A unit-typed guarded match is used as a statement (arm values discarded). Every
// arm fragment must exit via a bare `return;` rather than `return <value>;`, because
// different arm bodies lower to differently-shaped C++ (some to a value expression like
// `std::make_tuple()`, others to a void-typed IIFE wrapping a loop/if with no trailing
// value) - and the enclosing IIFE has no explicit return type, so clang requires every
// `return` in it to deduce the same type. Evaluating the body as a discarded statement
// before the bare `return;` keeps its side effects while forcing a uniform void shape.
fn return_or_discard_statements(use_void: bool, body_expression: Shared<CppExpression>) -> [Shared<CppStatement>] =
  if use_void then
    [
      emit_helpers.make_expression_cpp_statement(body_expression),
      emit_helpers.make_expression_cpp_statement(emit_helpers.make_identifier_cpp_expression('return'))
    ]
  else
    [emit_helpers.make_return_cpp_statement(body_expression)]
  end

fn append_cpp_statements(
  output: [Shared<CppStatement>],
  statements: [Shared<CppStatement>]
) -> [Shared<CppStatement>] = do
  let mut index = 0
  while index < statements.length() do
    output.push(statements[index])
    index = index + 1
  end
  output
end

fn guarded_arm_tail_statements(
  arm: Shared<SemanticMatchArm>,
  use_void: bool,
  arm_context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const body_expression = evaluated_expression_as_cpp(arm.body, arm_context, gen_stmts, eval_expr_fn)
  const body_statements = return_or_discard_statements(use_void, body_expression)
  if arm.has_guard then
    [
      emit_helpers.make_if_cpp_statement(
        evaluated_expression_as_cpp(arm.when_condition, arm_context, gen_stmts, eval_expr_fn),
        emit_helpers.make_block_cpp_statement(body_statements),
        emit_helpers.make_block_cpp_statement([]))
    ]
  else
    body_statements
  end
end

fn gen_guarded_wild_or_unit_arm_statements(
  arm: Shared<SemanticMatchArm>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] =
  guarded_arm_tail_statements(arm, use_void, context, gen_stmts, eval_expr_fn)

fn gen_guarded_literal_arm_statements(
  arm: Shared<SemanticMatchArm>,
  variant_access_expression: string,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const literal_condition = guarded_literal_condition_cpp(arm.pattern, variant_access_expression)
  const body_expression = evaluated_expression_as_cpp(arm.body, context, gen_stmts, eval_expr_fn)
  const then_block = emit_helpers.make_block_cpp_statement(
    return_or_discard_statements(use_void, body_expression))
  const else_block = emit_helpers.make_block_cpp_statement([])
  if arm.has_guard then
    [
      emit_helpers.make_if_cpp_statement(
        Shared.new(CppBinary(
          '&&',
          literal_condition,
          evaluated_expression_as_cpp(arm.when_condition, context, gen_stmts, eval_expr_fn))),
        then_block,
        else_block)
    ]
  else
    [
      emit_helpers.make_if_cpp_statement(literal_condition, then_block, else_block)
    ]
  end
end

fn gen_guarded_identifier_binding_arm_statements(
  arm: Shared<SemanticMatchArm>,
  binding_name: string,
  subject_holder_name: string,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const binding_cpp_safe = cpp_safe(binding_name)
  const extended_context = context.add_value(binding_name)
  let mut block_statements: [Shared<CppStatement>] = []
  block_statements.push(emit_helpers.make_auto_cpp_statement(
    binding_cpp_safe,
    emit_helpers.make_identifier_cpp_expression(subject_holder_name)))
  block_statements = append_cpp_statements(
    block_statements,
    guarded_arm_tail_statements(arm, use_void, extended_context, gen_stmts, eval_expr_fn))
  const block_result = [emit_helpers.make_block_cpp_statement(block_statements)]
  block_result
end

fn variant_holds_alternative_expression(
  variant_type_name: string,
  variant_access_expression: string
) -> Shared<CppExpression> =
  Shared.new(CppCall(
    Shared.new(CppIdent('std::holds_alternative<' + variant_type_name + ">")),
    [Shared.new(CppIdent(variant_access_expression))]))

fn variant_get_const_ref_statement(
  variant_type_name: string,
  binding_name: string,
  variant_access_expression: string
) -> Shared<CppStatement> =
  Shared.new(CppConstDecl(
    binding_name,
    Shared.new(CppTypeRef(Shared.new(CppTypeName(variant_type_name)))),
    Shared.new(CppCall(
      Shared.new(CppIdent('std::get<' + variant_type_name + ">")),
      [Shared.new(CppIdent(variant_access_expression))]))))

fn record_field_const_auto_ref_statement(field_cpp_safe: string, variant_lower_name: string) -> Shared<CppStatement> =
  Shared.new(CppConstDecl(
    field_cpp_safe,
    Shared.new(CppTypeRef(Shared.new(CppTypeName('auto')))),
    Shared.new(CppMember(
      emit_helpers.make_identifier_cpp_expression(variant_lower_name),
      field_cpp_safe,
      false))))

type RecordFieldBindCppResult = RecordFieldBindCppResult {
  field_binding_statements: [Shared<CppStatement>],
  arm_context: CodegenContext
}

type NestedMatchResume = NestedMatchResume {
  constructor_name: string,
  lower_name: string,
  cursor: i32,
  indexes: [i32],
  patterns: [Shared<Pattern>]
}

fn record_field_binding_cpp_result(
  constructor_name: string,
  field_patterns: [Shared<Pattern>],
  lower_name: string,
  start_context: CodegenContext
) -> RecordFieldBindCppResult = do
  const constructor_info = lookup_ctor_type_info_for_context(start_context, constructor_name)
  let mut field_binding_statements: [Shared<CppStatement>] = []
  let mut arm_context = start_context
  let mut field_index = 0
  while field_index < field_patterns.length() do
    match field_patterns[field_index] {
      PatternIdent(field_name, _) => do
        const field_cpp_safe = cpp_safe(field_name)
        if constructor_info.boxed_positions.contains(field_index) then
          field_binding_statements.push(emit_helpers.make_fragment_cpp_statement(
            'const auto& ' + field_cpp_safe + ' = (*' + lower_name + "." + field_cpp_safe + '); '))
        else
          field_binding_statements.push(
            record_field_const_auto_ref_statement(field_cpp_safe, lower_name))
        end
        arm_context = arm_context.add_value(field_name)
      end,
      _ => do end
    }
    field_index = field_index + 1
  end
  RecordFieldBindCppResult {
    field_binding_statements: field_binding_statements,
    arm_context: arm_context
  }
end

fn constructor_payload_binding_statement(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  lower_name: string,
  context: CodegenContext
) -> Shared<CppStatement> = do
  const constructor_info = lookup_ctor_type_info_for_context(context, constructor_name)
  if constructor_info.boxed_positions.length() == 0 then
    emit_helpers.make_structured_binding_cpp_statement(
      pattern_binding_name_list(sub_patterns),
      emit_helpers.make_identifier_cpp_expression(lower_name))
  else
    emit_helpers.make_fragment_cpp_statement(
      constructor_payload_binding(
        constructor_name,
        pattern_binding_name_list(sub_patterns),
        lower_name,
        context))
  end
end

fn cyclic_option_field_sum_name_at(
  constructor_name: string,
  field_index: i32,
  context: CodegenContext
) -> string = do
  const constructor_info = lookup_ctor_type_info_for_context(context, constructor_name)
  if field_index < constructor_info.cyclic_option_field_names.length() then
    constructor_info.cyclic_option_field_names[field_index]
  else ''
  end
end

fn subpattern_is_constructor(sub_pattern: Shared<Pattern>) -> bool =
  match sub_pattern {
    PatternCtor(_, _, _) => true,
    _ => false
  }

fn constructor_subpatterns_use_cyclic_option(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  context: CodegenContext
) -> bool = do
  let mut index = 0
  let mut found = false
  while index < sub_patterns.length() do
    if subpattern_is_constructor(sub_patterns[index]) &&
        cyclic_option_field_sum_name_at(constructor_name, index, context) != '' then
      found = true
    end
    index = index + 1
  end
  found
end

fn pattern_is_cyclic_option_nested_constructor(pattern: Shared<Pattern>, context: CodegenContext) -> bool =
  match pattern {
    PatternCtor(constructor_name, sub_patterns, _) =>
      constructor_subpatterns_use_cyclic_option(constructor_name, sub_patterns, context),
    _ => false
  }

export fn arms_have_cyclic_option_nested_constructor(
  arms: [Shared<SemanticMatchArm>],
  context: CodegenContext
) -> bool =
  arms.any(arm => pattern_is_cyclic_option_nested_constructor(arm.pattern, context))

fn cyclic_array_field_sum_name_at(
  constructor_name: string,
  field_index: i32,
  context: CodegenContext
) -> string = do
  const constructor_info = lookup_ctor_type_info_for_context(context, constructor_name)
  if field_index < constructor_info.cyclic_array_field_names.length() then
    constructor_info.cyclic_array_field_names[field_index]
  else ''
  end
end

fn pattern_is_name_binding(pattern: Shared<Pattern>) -> bool =
  match pattern {
    PatternIdent(_, _) => true,
    PatternWild(_) => true,
    _ => false
  }

fn constructor_subpatterns_are_name_bindings(sub_patterns: [Shared<Pattern>]) -> bool = do
  let mut index = 0
  let mut names_only = true
  while index < sub_patterns.length() do
    if pattern_is_name_binding(sub_patterns[index]) then do end
    else do
      names_only = false
    end
    end
    index = index + 1
  end
  names_only
end

fn constructor_subpatterns_are_supported_fields(sub_patterns: [Shared<Pattern>]) -> bool = do
  let mut index = 0
  let mut supported = true
  while index < sub_patterns.length() do
    match sub_patterns[index] {
      PatternIdent(_, _) => do end,
      PatternWild(_) => do end,
      PatternCtor(_, inner_patterns, _) => do
        if constructor_subpatterns_are_supported_fields(inner_patterns) then do end
        else do
          supported = false
        end
        end
      end,
      _ => do supported = false end
    }
    index = index + 1
  end
  supported
end

fn array_elements_are_bindings(element_patterns: [Shared<Pattern>]) -> bool = do
  let mut index = 0
  let mut bindings_only = true
  while index < element_patterns.length() do
    match element_patterns[index] {
      PatternIdent(_, _) => do end,
      PatternWild(_) => do end,
      PatternCtor(_, sub_patterns, _) => do
        if sub_patterns.length() != 0 && constructor_subpatterns_are_supported_fields(sub_patterns) == false then do
          bindings_only = false
        end
        end
      end,
      _ => do bindings_only = false end
    }
    index = index + 1
  end
  bindings_only
end

fn array_pattern_is_element_binding(pattern: Shared<Pattern>) -> bool =
  match pattern {
    PatternArray(element_patterns, _, _) =>
      array_elements_are_bindings(element_patterns),
    _ => false
  }

fn constructor_subpatterns_use_cyclic_array(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  context: CodegenContext
) -> bool = do
  let mut index = 0
  let mut found = false
  while index < sub_patterns.length() do
    if array_pattern_is_element_binding(sub_patterns[index]) &&
        cyclic_array_field_sum_name_at(constructor_name, index, context) != '' then
      found = true
    end
    index = index + 1
  end
  found
end

fn pattern_is_cyclic_array_nested(pattern: Shared<Pattern>, context: CodegenContext) -> bool =
  match pattern {
    PatternCtor(constructor_name, sub_patterns, _) =>
      constructor_subpatterns_use_cyclic_array(constructor_name, sub_patterns, context),
    _ => false
  }

export fn arms_have_cyclic_array_nested_pattern(
  arms: [Shared<SemanticMatchArm>],
  context: CodegenContext
) -> bool =
  arms.any(arm => pattern_is_cyclic_array_nested(arm.pattern, context))

fn constructor_field_member_name(context: CodegenContext, constructor_name: string, field_index: i32) -> string = do
  const field_names = lookup_fields_for_context(context, constructor_name)
  if field_index < field_names.length() && field_names[field_index] != '' then
    cpp_safe(field_names[field_index])
  else
    'field' + field_index.to_string()
  end
end

fn cyclic_option_nested_inner_statements(
  sub_pattern: Shared<Pattern>,
  option_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  let mut arm_context = context
  let mut statements: [Shared<CppStatement>] = []
  let mut payload_constructor = ''
  let mut payload_patterns_value: [Shared<Pattern>] = []
  match sub_pattern {
    PatternCtor(constructor_name, inner_patterns, _) =>
      if constructor_name == 'Some' && inner_patterns.length() == 1 then
        match inner_patterns[0] {
          PatternIdent(binding_name, _) => do
            arm_context = arm_context.add_value(binding_name)
            statements.push(emit_helpers.make_fragment_cpp_statement(
              'const auto& ' + cpp_safe(binding_name) + ' = *(*' + option_access + '); '))
          end,
          PatternCtor(payload_name, payload_patterns, _) => do
            payload_constructor = payload_name
            payload_patterns_value = payload_patterns
          end,
          _ => do end
        }
      end,
    _ => do end
  }
  if payload_constructor != '' then
    append_cpp_statements(
      [emit_helpers.make_fragment_cpp_statement(
        'const auto& __cyclic_payload_sum = (*(*' + option_access + '))._; ')],
      gen_guarded_constructor_arm_statements(
        arm,
        payload_constructor,
        payload_patterns_value,
        '__cyclic_payload_sum',
        subject,
        use_void,
        context,
        gen_stmts,
        eval_expr_fn))
  else
    append_cpp_statements(
      statements,
      guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn))
  end
end

fn cyclic_option_nested_if_statement(
  sub_pattern: Shared<Pattern>,
  option_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> Shared<CppStatement> = do
  const is_some = match sub_pattern {
    PatternCtor(constructor_name, _, _) => constructor_name == 'Some',
    _ => false
  }
  const condition =
    if is_some then "(" + option_access + '.has_value() && *' + option_access + ")"
    else "!" + option_access + '.has_value()'
    end
  emit_helpers.make_if_cpp_statement(
    emit_helpers.make_identifier_cpp_expression(condition),
    emit_helpers.make_block_cpp_statement(cyclic_option_nested_inner_statements(
      sub_pattern, option_access, arm, subject, use_void, context, gen_stmts, eval_expr_fn)),
    emit_helpers.make_block_cpp_statement([]))
end

fn cyclic_option_constructor_arm_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  variant_access_expression: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const qualified_name = context.resolve(constructor_name)
  const lower_name = cpp_safe(lower_first(constructor_name))
  const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
  const variant_type_name = qualified_name + type_argument
  let mut then_statements: [Shared<CppStatement>] = []
  then_statements.push(
    variant_get_const_ref_statement(variant_type_name, lower_name, variant_access_expression))
  let mut index = 0
  while index < sub_patterns.length() do
    if subpattern_is_constructor(sub_patterns[index]) &&
        cyclic_option_field_sum_name_at(constructor_name, index, context) != '' then
      const member_name = constructor_field_member_name(context, constructor_name, index)
      then_statements.push(cyclic_option_nested_if_statement(
        sub_patterns[index],
        lower_name + "." + member_name,
        arm,
        subject,
        use_void,
        context,
        gen_stmts,
        eval_expr_fn))
    end
    index = index + 1
  end
  [
    emit_helpers.make_if_cpp_statement(
      variant_holds_alternative_expression(variant_type_name, variant_access_expression),
      emit_helpers.make_block_cpp_statement(then_statements),
      emit_helpers.make_block_cpp_statement([]))
  ]
end

fn array_name_constructor_statements(
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if payload_cursor >= payload_indexes.length() then
    guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn)
  else
    one_array_name_constructor_statements(
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end
end

fn one_array_name_constructor_statements(
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const element_index = payload_indexes[payload_cursor]
  let mut statements: [Shared<CppStatement>] = []
  match element_patterns[element_index] {
    PatternCtor(constructor_name, sub_patterns, _) => do
      const payload_sum_name = '__cyclic_payload_sum_' + element_index.to_string()
      const lower_name = cpp_safe(lower_first(constructor_name)) + "_" + element_index.to_string()
      const qualified_name = context.resolve(constructor_name)
      const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
      const variant_type_name = qualified_name + type_argument
      statements.push(emit_helpers.make_fragment_cpp_statement(
        'const auto& ' + payload_sum_name + ' = (*' + array_access + "[" + element_index.to_string() + "])._; "))
      let mut then_statements: [Shared<CppStatement>] = []
      then_statements.push(
        variant_get_const_ref_statement(variant_type_name, lower_name, payload_sum_name))
      if constructor_subpatterns_are_name_bindings(sub_patterns) then do
        const no_nested_indexes: [i32] = []
        const bound_fields = constructor_field_ident_statements(
          constructor_name, sub_patterns, lower_name, no_nested_indexes, arm_context, context)
        then_statements = append_cpp_statements(then_statements, bound_fields.field_binding_statements)
        then_statements = append_cpp_statements(
          then_statements,
          array_name_constructor_statements(
            element_patterns,
            payload_indexes,
            payload_cursor + 1,
            array_access,
            arm,
            subject,
            use_void,
            bound_fields.arm_context,
            context,
            gen_stmts,
            eval_expr_fn))
      end
      end
      if constructor_subpatterns_are_name_bindings(sub_patterns) == false then do
        const empty_patterns: [Shared<Pattern>] = []
        const empty_indexes: [i32] = []
        const empty_resume: [NestedMatchResume] = []
        then_statements = append_cpp_statements(
          then_statements,
          constructor_inner_statements(
            arm,
            constructor_name,
            sub_patterns,
            lower_name,
            subject,
            use_void,
            arm_context,
            '',
            empty_patterns,
            '',
            empty_indexes,
            0,
            empty_resume,
            element_patterns,
            payload_indexes,
            payload_cursor + 1,
            array_access,
            context,
            gen_stmts,
            eval_expr_fn))
      end
      end
      statements.push(emit_helpers.make_if_cpp_statement(
        variant_holds_alternative_expression(variant_type_name, payload_sum_name),
        emit_helpers.make_block_cpp_statement(then_statements),
        emit_helpers.make_block_cpp_statement([])))
    end,
    _ => do end
  }
  statements
end

fn cyclic_array_nested_if_statement(
  element_patterns: [Shared<Pattern>],
  rest_name: string,
  sum_name: string,
  array_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> Shared<CppStatement> = do
  let mut arm_context = context
  let mut inner_statements: [Shared<CppStatement>] = []
  const size_comparison = if rest_name == '' then ' == ' else ' >= ' end
  let mut condition_text = array_access + '.size()' + size_comparison + element_patterns.length().to_string()
  let mut payload_indexes: [i32] = []
  let mut element_index = 0
  while element_index < element_patterns.length() do
    match element_patterns[element_index] {
      PatternIdent(binding_name, _) => do
        arm_context = arm_context.add_value(binding_name)
        inner_statements.push(emit_helpers.make_fragment_cpp_statement(
          'const auto& ' + cpp_safe(binding_name) + ' = (*' + array_access + "[" + element_index.to_string() + "]); "))
      end,
      PatternCtor(constructor_name, sub_patterns, _) => do
        if sub_patterns.length() == 0 then do
          condition_text = condition_text + ' && std::holds_alternative<' + context.resolve(constructor_name) + '>((*' + array_access + "[" + element_index.to_string() + "])._)"
        end
        end
        if sub_patterns.length() != 0 then do
          payload_indexes.push(element_index)
        end
        end
      end,
      _ => do end
    }
    element_index = element_index + 1
  end
  if rest_name != '' then
    arm_context = arm_context.add_value(rest_name)
    inner_statements.push(emit_helpers.make_fragment_cpp_statement(
      'const auto ' + cpp_safe(rest_name) + ' = mlc::Array<std::shared_ptr<' + sum_name + '>>(' + array_access + '.cbegin() + ' + element_patterns.length().to_string() + ', ' + array_access + '.cend()); '))
  end
  let mut then_statements = inner_statements
  if payload_indexes.length() > 0 then do
    then_statements = append_cpp_statements(
      then_statements,
      array_name_constructor_statements(
        element_patterns,
        payload_indexes,
        0,
        array_access,
        arm,
        subject,
        use_void,
        arm_context,
        context,
        gen_stmts,
        eval_expr_fn))
  end
  end
  if payload_indexes.length() == 0 then do
    then_statements = append_cpp_statements(
      then_statements,
      guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn))
  end
  end
  emit_helpers.make_if_cpp_statement(
    emit_helpers.make_identifier_cpp_expression(condition_text),
    emit_helpers.make_block_cpp_statement(then_statements),
    emit_helpers.make_block_cpp_statement([]))
end

fn cyclic_array_constructor_arm_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  variant_access_expression: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const qualified_name = context.resolve(constructor_name)
  const lower_name = cpp_safe(lower_first(constructor_name))
  const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
  const variant_type_name = qualified_name + type_argument
  let mut then_statements: [Shared<CppStatement>] = []
  then_statements.push(
    variant_get_const_ref_statement(variant_type_name, lower_name, variant_access_expression))
  let mut index = 0
  while index < sub_patterns.length() do
    if array_pattern_is_element_binding(sub_patterns[index]) &&
        cyclic_array_field_sum_name_at(constructor_name, index, context) != '' then
      match sub_patterns[index] {
        PatternArray(element_patterns, rest_name, _) =>
          then_statements.push(cyclic_array_nested_if_statement(
            element_patterns,
            rest_name,
            cyclic_array_field_sum_name_at(constructor_name, index, context),
            lower_name + "." + constructor_field_member_name(context, constructor_name, index),
            arm,
            subject,
            use_void,
            context,
            gen_stmts,
            eval_expr_fn)),
        _ => do end
      }
    end
    index = index + 1
  end
  [
    emit_helpers.make_if_cpp_statement(
      variant_holds_alternative_expression(variant_type_name, variant_access_expression),
      emit_helpers.make_block_cpp_statement(then_statements),
      emit_helpers.make_block_cpp_statement([]))
  ]
end

fn boxed_nested_constructor_indexes(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  context: CodegenContext
) -> [i32] = do
  const constructor_info = lookup_ctor_type_info_for_context(context, constructor_name)
  let mut indexes: [i32] = []
  let mut index = 0
  while index < sub_patterns.length() do
    match sub_patterns[index] {
      PatternCtor(_, inner_patterns, _) => do
        if constructor_subpatterns_are_supported_fields(inner_patterns) &&
            constructor_info.boxed_positions.contains(index) then do
          indexes.push(index)
        end
        end
      end,
      _ => do end
    }
    index = index + 1
  end
  indexes
end

fn constructor_field_ident_statements(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  lower_name: string,
  nested_indexes: [i32],
  arm_context: CodegenContext,
  context: CodegenContext
) -> RecordFieldBindCppResult = do
  const constructor_info = lookup_ctor_type_info_for_context(context, constructor_name)
  let mut field_binding_statements: [Shared<CppStatement>] = []
  let mut bound_context = arm_context
  let mut index = 0
  while index < sub_patterns.length() do
    if nested_indexes.contains(index) == false then
      match sub_patterns[index] {
        PatternIdent(binding_name, _) => do
          bound_context = bound_context.add_value(binding_name)
          const member_name = constructor_field_member_name(context, constructor_name, index)
          if constructor_info.boxed_positions.contains(index) then do
            field_binding_statements.push(emit_helpers.make_fragment_cpp_statement(
              'const auto& ' + cpp_safe(binding_name) + ' = (*' + lower_name + "." + member_name + "); "))
          end
          end
          if constructor_info.boxed_positions.contains(index) == false then do
            field_binding_statements.push(emit_helpers.make_fragment_cpp_statement(
              'const auto& ' + cpp_safe(binding_name) + ' = ' + lower_name + "." + member_name + "; "))
          end
          end
        end,
        _ => do end
      }
    end
    index = index + 1
  end
  RecordFieldBindCppResult {
    field_binding_statements: field_binding_statements,
    arm_context: bound_context
  }
end

fn resume_stack_without_last(resume_stack: [NestedMatchResume]) -> [NestedMatchResume] = do
  let mut kept: [NestedMatchResume] = []
  let mut index = 0
  while index + 1 < resume_stack.length() do
    kept.push(resume_stack[index])
    index = index + 1
  end
  kept
end

fn nested_constructor_field_if(
  arm: Shared<SemanticMatchArm>,
  parent_name: string,
  parent_patterns: [Shared<Pattern>],
  parent_lower_name: string,
  field_index: i32,
  next_indexes: [i32],
  next_cursor: i32,
  resume_stack: [NestedMatchResume],
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  let mut statements: [Shared<CppStatement>] = []
  match parent_patterns[field_index] {
    PatternCtor(inner_name, inner_patterns, _) => do
      const member_name = constructor_field_member_name(context, parent_name, field_index)
      const inner_sum_name = '__cyclic_inner_sum_' + field_index.to_string()
      const qualified_name = context.resolve(inner_name)
      const lower_name = parent_lower_name + "_" + field_index.to_string()
      const type_argument = generic_ctor_type_argument(context, inner_name, subject)
      const variant_type_name = qualified_name + type_argument
      const variant_access = inner_sum_name + "._"
      statements.push(emit_helpers.make_fragment_cpp_statement(
        'const auto& ' + inner_sum_name + ' = (*' + parent_lower_name + "." + member_name + "); "))
      let mut then_statements: [Shared<CppStatement>] = []
      then_statements.push(
        variant_get_const_ref_statement(variant_type_name, lower_name, variant_access))
      then_statements = append_cpp_statements(
        then_statements,
        constructor_inner_statements(
          arm,
          inner_name,
          inner_patterns,
          lower_name,
          subject,
          use_void,
          arm_context,
          parent_name,
          parent_patterns,
          parent_lower_name,
          next_indexes,
          next_cursor,
          resume_stack,
          element_patterns,
          payload_indexes,
          payload_cursor,
          array_access,
          context,
          gen_stmts,
          eval_expr_fn))
      statements.push(emit_helpers.make_if_cpp_statement(
        variant_holds_alternative_expression(variant_type_name, variant_access),
        emit_helpers.make_block_cpp_statement(then_statements),
        emit_helpers.make_block_cpp_statement([])))
    end,
    _ => do end
  }
  statements
end

fn statements_after_constructor(
  arm: Shared<SemanticMatchArm>,
  use_void: bool,
  arm_context: CodegenContext,
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  subject: Shared<SemanticExpression>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if payload_cursor < payload_indexes.length() then
    array_name_constructor_statements(
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
  else
    guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn)
  end
end

fn constructor_inner_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  lower_name: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  outer_name: string,
  outer_patterns: [Shared<Pattern>],
  outer_lower_name: string,
  outer_indexes: [i32],
  outer_cursor: i32,
  resume_stack: [NestedMatchResume],
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const nested_indexes = boxed_nested_constructor_indexes(constructor_name, sub_patterns, context)
  const bound_fields = constructor_field_ident_statements(
    constructor_name, sub_patterns, lower_name, nested_indexes, arm_context, context)
  if nested_indexes.length() > 0 then do
    let mut saved_stack = resume_stack
    if outer_cursor < outer_indexes.length() then do
      saved_stack.push(NestedMatchResume {
        constructor_name: outer_name,
        lower_name: outer_lower_name,
        cursor: outer_cursor,
        indexes: outer_indexes,
        patterns: outer_patterns
      })
    end
    end
    append_cpp_statements(
      bound_fields.field_binding_statements,
      nested_constructor_field_if(
        arm,
        constructor_name,
        sub_patterns,
        lower_name,
        nested_indexes[0],
        nested_indexes,
        1,
        saved_stack,
        element_patterns,
        payload_indexes,
        payload_cursor,
        array_access,
        subject,
        use_void,
        bound_fields.arm_context,
        context,
        gen_stmts,
        eval_expr_fn))
  end else if outer_cursor < outer_indexes.length() then
    append_cpp_statements(
      bound_fields.field_binding_statements,
      nested_constructor_field_if(
        arm,
        outer_name,
        outer_patterns,
        outer_lower_name,
        outer_indexes[outer_cursor],
        outer_indexes,
        outer_cursor + 1,
        resume_stack,
        element_patterns,
        payload_indexes,
        payload_cursor,
        array_access,
        subject,
        use_void,
        bound_fields.arm_context,
        context,
        gen_stmts,
        eval_expr_fn))
  else if resume_stack.length() > 0 then do
    const frame = resume_stack[resume_stack.length() - 1]
    append_cpp_statements(
      bound_fields.field_binding_statements,
      nested_constructor_field_if(
        arm,
        frame.constructor_name,
        frame.patterns,
        frame.lower_name,
        frame.indexes[frame.cursor],
        frame.indexes,
        frame.cursor + 1,
        resume_stack_without_last(resume_stack),
        element_patterns,
        payload_indexes,
        payload_cursor,
        array_access,
        subject,
        use_void,
        bound_fields.arm_context,
        context,
        gen_stmts,
        eval_expr_fn))
  end else
    append_cpp_statements(
      bound_fields.field_binding_statements,
      statements_after_constructor(
        arm,
        use_void,
        bound_fields.arm_context,
        element_patterns,
        payload_indexes,
        payload_cursor,
        array_access,
        subject,
        context,
        gen_stmts,
        eval_expr_fn))
  end
end

fn gen_boxed_nested_constructor_arm_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  variant_access_expression: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const qualified_name = context.resolve(constructor_name)
  const lower_name = cpp_safe(lower_first(constructor_name))
  const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
  const variant_type_name = qualified_name + type_argument
  let mut then_statements: [Shared<CppStatement>] = []
  const empty_patterns: [Shared<Pattern>] = []
  const empty_indexes: [i32] = []
  const empty_resume: [NestedMatchResume] = []
  then_statements.push(
    variant_get_const_ref_statement(variant_type_name, lower_name, variant_access_expression))
  then_statements = append_cpp_statements(
    then_statements,
    constructor_inner_statements(
      arm,
      constructor_name,
      sub_patterns,
      lower_name,
      subject,
      use_void,
      context,
      '',
      empty_patterns,
      '',
      empty_indexes,
      0,
      empty_resume,
      empty_patterns,
      empty_indexes,
      0,
      '',
      context,
      gen_stmts,
      eval_expr_fn))
  const constructor_arm_result = [
    emit_helpers.make_if_cpp_statement(
      variant_holds_alternative_expression(variant_type_name, variant_access_expression),
      emit_helpers.make_block_cpp_statement(then_statements),
      emit_helpers.make_block_cpp_statement([]))
  ]
  constructor_arm_result
end

fn gen_guarded_constructor_arm_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  variant_access_expression: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if constructor_subpatterns_use_cyclic_option(constructor_name, sub_patterns, context) then
    return cyclic_option_constructor_arm_statements(
      arm, constructor_name, sub_patterns, variant_access_expression, subject, use_void, context, gen_stmts, eval_expr_fn)
  end
  if constructor_subpatterns_use_cyclic_array(constructor_name, sub_patterns, context) then
    return cyclic_array_constructor_arm_statements(
      arm, constructor_name, sub_patterns, variant_access_expression, subject, use_void, context, gen_stmts, eval_expr_fn)
  end
  const nested_constructor_indexes = boxed_nested_constructor_indexes(constructor_name, sub_patterns, context)
  if nested_constructor_indexes.length() > 0 then
    return gen_boxed_nested_constructor_arm_statements(
      arm, constructor_name, sub_patterns, variant_access_expression, subject, use_void, context, gen_stmts, eval_expr_fn)
  end
  const qualified_name = context.resolve(constructor_name)
  const lower_name = cpp_safe(lower_first(constructor_name))
  const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
  const variant_type_name = qualified_name + type_argument
  const arm_context = codegen_context_with_ctor_field_bindings(constructor_name, sub_patterns, context)
  let mut then_statements: [Shared<CppStatement>] = []
  then_statements.push(
    variant_get_const_ref_statement(variant_type_name, lower_name, variant_access_expression))
  if sub_patterns.length() > 0 then
    then_statements.push(constructor_payload_binding_statement(
      constructor_name, sub_patterns, lower_name, context))
  end
  then_statements = append_cpp_statements(
    then_statements,
    guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn))
  const constructor_arm_result = [
    emit_helpers.make_if_cpp_statement(
      variant_holds_alternative_expression(variant_type_name, variant_access_expression),
      emit_helpers.make_block_cpp_statement(then_statements),
      emit_helpers.make_block_cpp_statement([]))
  ]
  constructor_arm_result
end

fn gen_guarded_record_arm_statements(
  arm: Shared<SemanticMatchArm>,
  record_name: string,
  field_patterns: [Shared<Pattern>],
  variant_access_expression: string,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const qualified_name = context.resolve(record_name)
  const lower_name = cpp_safe(lower_first(record_name))
  const type_argument = if list_contains(context.generic_variants, record_name) then '<auto>' else '' end
  const variant_type_name = qualified_name + type_argument
  const field_bindings = record_field_binding_cpp_result(record_name, field_patterns, lower_name, context)
  let mut then_statements: [Shared<CppStatement>] = []
  then_statements.push(
    variant_get_const_ref_statement(variant_type_name, lower_name, variant_access_expression))
  then_statements = append_cpp_statements(then_statements, field_bindings.field_binding_statements)
  then_statements = append_cpp_statements(
    then_statements,
    guarded_arm_tail_statements(arm, use_void, field_bindings.arm_context, gen_stmts, eval_expr_fn))
  const record_arm_result = [
    emit_helpers.make_if_cpp_statement(
      variant_holds_alternative_expression(variant_type_name, variant_access_expression),
      emit_helpers.make_block_cpp_statement(then_statements),
      emit_helpers.make_block_cpp_statement([]))
  ]
  record_arm_result
end

fn gen_guarded_arm_statements(
  arm: Shared<SemanticMatchArm>,
  variant_access_expression: string,
  subject_holder_name: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] =
  match arm.pattern {
    PatternCtor(name, sub_patterns, _) =>
      gen_guarded_constructor_arm_statements(arm, name, sub_patterns, variant_access_expression, subject, use_void, context, gen_stmts, eval_expr_fn),
    PatternRecord(name, field_patterns, _) =>
      gen_guarded_record_arm_statements(arm, name, field_patterns, variant_access_expression, use_void, context, gen_stmts, eval_expr_fn),
    PatternWild(_) =>
      gen_guarded_wild_or_unit_arm_statements(arm, use_void, context, gen_stmts, eval_expr_fn),
    PatternUnit(_) =>
      gen_guarded_wild_or_unit_arm_statements(arm, use_void, context, gen_stmts, eval_expr_fn),
    PatternBool(_, _) =>
      gen_guarded_literal_arm_statements(arm, variant_access_expression, use_void, context, gen_stmts, eval_expr_fn),
    PatternInt(_, _) =>
      gen_guarded_literal_arm_statements(arm, variant_access_expression, use_void, context, gen_stmts, eval_expr_fn),
    PatternStr(_, _) =>
      gen_guarded_literal_arm_statements(arm, variant_access_expression, use_void, context, gen_stmts, eval_expr_fn),
    PatternStringLit(_, _) =>
      gen_guarded_literal_arm_statements(arm, variant_access_expression, use_void, context, gen_stmts, eval_expr_fn),
    PatternIdent(binding_name, _) =>
      gen_guarded_identifier_binding_arm_statements(arm, binding_name, subject_holder_name, use_void, context, gen_stmts, eval_expr_fn),
    PatternTuple(_, _) =>
      [],
    PatternArray(_, _, _) =>
      [],
    PatternOr(_, _) =>
      []
  }

fn string_match_literal_condition_cpp(pattern: Shared<Pattern>, subject_holder: string) -> Shared<CppExpression> =
  match pattern {
    PatternStr(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(subject_holder)),
        gen_string_literal_cpp(value))),
    PatternStringLit(value, _) =>
      Shared.new(CppBinary(
        '==',
        Shared.new(CppIdent(subject_holder)),
        gen_string_literal_cpp(value))),
    _ => emit_helpers.make_boolean_cpp_expression(false)
  }

fn string_match_return_block_cpp(
  arm: Shared<SemanticMatchArm>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_cpp_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppExpression>
) -> Shared<CppStatement> =
  emit_helpers.make_block_cpp_statement([
    emit_helpers.make_return_cpp_statement(
      eval_expr_cpp_fn(arm.body, context, gen_stmts))])

fn string_match_return_block_string(
  arm: Shared<SemanticMatchArm>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> Shared<CppStatement> =
  emit_helpers.make_block_cpp_statement([
    emit_helpers.make_return_cpp_statement(
      emit_helpers.make_identifier_cpp_expression(
        eval_expr_fn(arm.body, context, gen_stmts)))])

fn string_match_arm_else_branch(
  arms: [Shared<SemanticMatchArm>],
  start_index: i32,
  subject_holder: string,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  build_return_block: (Shared<SemanticMatchArm>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppStatement>
) -> Shared<CppStatement> =
  if start_index >= arms.length() then
    emit_helpers.make_expression_cpp_statement(
      emit_helpers.make_identifier_cpp_expression('std::abort()'))
  else
    const arm = arms[start_index]
    const return_block = build_return_block(arm, context, gen_stmts)
    match arm.pattern {
      PatternWild(_) => return_block,
      PatternStr(_, _) =>
        emit_helpers.make_if_cpp_statement(
          string_match_literal_condition_cpp(arm.pattern, subject_holder),
          return_block,
          string_match_arm_else_branch(
            arms, start_index + 1, subject_holder, context, gen_stmts, build_return_block)),
      PatternStringLit(_, _) =>
        emit_helpers.make_if_cpp_statement(
          string_match_literal_condition_cpp(arm.pattern, subject_holder),
          return_block,
          string_match_arm_else_branch(
            arms, start_index + 1, subject_holder, context, gen_stmts, build_return_block)),
      _ => return_block
    }
  end

fn string_match_statements_cpp(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_cpp_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppExpression>
) -> [Shared<CppStatement>] = do
  let statements: [Shared<CppStatement>] = []
  statements.push(
    emit_helpers.make_auto_cpp_statement(
      '__match_subject',
      eval_expr_cpp_fn(subject, context, gen_stmts)))
  statements.push(
    string_match_arm_else_branch(
      expanded_arms,
      0,
      '__match_subject',
      context,
      gen_stmts,
      (arm, arm_context, gen_stmts_fn) =>
        string_match_return_block_cpp(arm, arm_context, gen_stmts_fn, eval_expr_cpp_fn)))
  statements
end

fn string_match_statements_string(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  let statements: [Shared<CppStatement>] = []
  statements.push(
    emit_helpers.make_auto_cpp_statement(
      '__match_subject',
      emit_helpers.make_identifier_cpp_expression(
        eval_expr_fn(subject, context, gen_stmts))))
  statements.push(
    string_match_arm_else_branch(
      expanded_arms,
      0,
      '__match_subject',
      context,
      gen_stmts,
      (arm, arm_context, gen_stmts_fn) =>
        string_match_return_block_string(arm, arm_context, gen_stmts_fn, eval_expr_fn)))
  statements
end

fn string_match_statements_to_source(statements: [Shared<CppStatement>]) -> string = do
  let mut body_source = ''
  let mut statement_index = 0
  while statement_index < statements.length() do
    body_source = body_source + print_statement(statements[statement_index]) + `\n`
    statement_index = statement_index + 1
  end
  body_source
end

fn gen_string_match_body(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> string =
  string_match_statements_to_source(
    string_match_statements_string(subject, expanded_arms, context, gen_stmts, eval_expr_fn))

export fn gen_match_string_literal_expression(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> string = do
  const return_cpp = sem_type_to_cpp(context, match_result_type)
  const inner_body = gen_string_match_body(subject, expanded_arms, context, gen_stmts, eval_expr_fn)
  `[&]() -> ${return_cpp} {\n${inner_body}}()`
end

export fn gen_match_string_literal_expression_cpp(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_cpp_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppExpression>
) -> Shared<CppExpression> = do
  const return_cpp = match_return_cpp_type(context, match_result_type, subject)
  Shared.new(CppInvokedBlockWithReturn(
    return_cpp,
    string_match_statements_cpp(subject, expanded_arms, context, gen_stmts, eval_expr_cpp_fn)))
end

fn gen_match_guarded_body_from_subject_expression(
  subject_expression: Shared<CppExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  subject: Shared<SemanticExpression>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const needs_dereference =
    if expanded_arms.length() > 0 then first_arm_needs_deref(expanded_arms[0], subject, context) else true end
  const variant_access =
    visit_subject_for_match('__match_subject', needs_dereference) +
      cyclic_sum_subject_member_suffix(subject, context)
  const use_void = match_visit_uses_void_lambdas(match_result_type)
  let statements: [Shared<CppStatement>] = []
  statements.push(emit_helpers.make_auto_cpp_statement('__match_subject', subject_expression))
  let mut arm_index = 0
  while arm_index < expanded_arms.length() do
    const arm_statements = gen_guarded_arm_statements(
      expanded_arms[arm_index],
      variant_access,
      '__match_subject',
      subject,
      use_void,
      context,
      gen_stmts,
      eval_expr_fn)
    let mut statement_index = 0
    while statement_index < arm_statements.length() do
      statements.push(arm_statements[statement_index])
      statement_index = statement_index + 1
    end
    arm_index = arm_index + 1
  end
  statements.push(
    emit_helpers.make_expression_cpp_statement(
      emit_helpers.make_identifier_cpp_expression('std::abort()')))
  statements
end

export fn gen_match_guarded_body(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] =
  gen_match_guarded_body_from_subject_expression(
    emit_helpers.make_identifier_cpp_expression(eval_expr_fn(subject, context, gen_stmts)),
    expanded_arms,
    match_result_type,
    subject,
    context,
    gen_stmts,
    eval_expr_fn)

export fn gen_match_guarded_body_cpp(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_cpp_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppExpression>
) -> [Shared<CppStatement>] =
  gen_match_guarded_body_from_subject_expression(
    eval_expr_cpp_fn(subject, context, gen_stmts),
    expanded_arms,
    match_result_type,
    subject,
    context,
    gen_stmts,
    (expression, eval_context, gen_stmts_fn) =>
      print_expr(eval_expr_cpp_fn(expression, eval_context, gen_stmts_fn)))

export fn gen_match_guarded_expression(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> string = do
  const inner_body = string_match_statements_to_source(
    gen_match_guarded_body(subject, expanded_arms, match_result_type, context, gen_stmts, eval_expr_fn))
  // A match with unit result type is used as a statement (arm values discarded);
  // its own type, not the enclosing function's return type, decides the IIFE
  // return type. Omit the explicit annotation entirely and let the (identical,
  // unit-shaped) arm return statements deduce it - matching enclosing_function_return_type
  // here would be wrong whenever this match is not itself the function's tail expression.
  if match_visit_uses_void_lambdas(match_result_type) then `[&]() {\n${inner_body}}()`
  else
    const return_cpp = match_return_cpp_type(context, match_result_type, subject)
    `[&]() -> ${return_cpp} {\n${inner_body}}()`
  end
end

export fn gen_match_guarded_expression_cpp(
  subject: Shared<SemanticExpression>,
  expanded_arms: [Shared<SemanticMatchArm>],
  match_result_type: Shared<Type>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_cpp_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> Shared<CppExpression>
) -> Shared<CppExpression> = do
  const body_statements = gen_match_guarded_body_cpp(
    subject,
    expanded_arms,
    match_result_type,
    context,
    gen_stmts,
    eval_expr_cpp_fn)
  // See gen_match_guarded_expression above for why unit results skip the
  // enclosing-function-return-type-derived annotation.
  if match_visit_uses_void_lambdas(match_result_type) then
    Shared.new(CppInvokedBlock(body_statements))
  else
    const return_cpp = match_return_cpp_type(context, match_result_type, subject)
    Shared.new(CppInvokedBlockWithReturn(return_cpp, body_statements))
  end
end
