import { Pattern, PatternWild, PatternCtor, PatternIdent, PatternArray, PatternOr } from '../../frontend/ast'
import { SemanticExpression, SemanticStatement, SemanticMatchArm } from '../../ir/semantic_ir'
import { CodegenContext } from '../context'
import { cpp_safe, lower_first } from '../cpp_naming'
import { generic_ctor_type_argument } from './match_generic_ctor_type'
import {
  CppStatement
} from '../../cpp_ir/cpp_ast'
import * as emit_helpers from '../../cpp_emit/emit_helpers'
import { NestedMatchResume, append_cpp_statements, guarded_arm_tail_statements, variant_holds_alternative_expression, variant_get_const_ref_statement } from './match_guarded_support'
import {
  constructor_subpatterns_are_name_bindings,
  constructor_field_ident_statements,
  no_finish_statements,
  constructor_field_member_name,
  boxed_nested_constructor_indexes,
  context_with_cyclic_array_pattern_bindings,
  resume_stack_without_last,
  cyclic_array_pattern_field_indexes,
  cyclic_array_field_sum_name_at,
  constructor_subpatterns_are_supported_fields,
  cyclic_array_element_lower_name
} from './match_guarded_patterns'

fn cyclic_array_constructor_alternative_statements(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  element_index: i32,
  array_access: string,
  continuation: [Shared<CppStatement>],
  else_statements: [Shared<CppStatement>],
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const qualified_name = context.resolve(constructor_name)
  const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
  const variant_type_name = qualified_name + type_argument
  const holds_text = 'std::holds_alternative<' + variant_type_name + '>((*' + array_access + "[" + element_index.to_string() + "])._)"
  let mut then_statements: [Shared<CppStatement>] = []
  if sub_patterns.length() == 0 then do
    then_statements = continuation
  end else do
    const payload_sum_name = '__cyclic_payload_sum_' + element_index.to_string()
    const lower_name = cyclic_array_element_lower_name(array_access, constructor_name, element_index)
    then_statements.push(emit_helpers.make_fragment_cpp_statement(
      'const auto& ' + payload_sum_name + ' = (*' + array_access + "[" + element_index.to_string() + "])._; "))
    then_statements.push(
      variant_get_const_ref_statement(variant_type_name, lower_name, payload_sum_name))
    if constructor_subpatterns_are_name_bindings(sub_patterns) then do
      const no_nested_indexes: [i32] = []
      const bound_fields = constructor_field_ident_statements(
        constructor_name, sub_patterns, lower_name, no_nested_indexes, arm_context, context)
      then_statements = append_cpp_statements(then_statements, bound_fields.field_binding_statements)
      then_statements = append_cpp_statements(then_statements, continuation)
    end
    end
    if constructor_subpatterns_are_name_bindings(sub_patterns) == false then do
      const empty_patterns: [Shared<Pattern>] = []
      const empty_indexes: [i32] = []
      const empty_resume: [NestedMatchResume] = []
      then_statements = append_cpp_statements(
        then_statements,
        constructor_inner_statements(
          arm,
          constructor_name,
          sub_patterns,
          lower_name,
          subject,
          use_void,
          arm_context,
          '',
          empty_patterns,
          '',
          empty_indexes,
          0,
          empty_resume,
          empty_patterns,
          empty_indexes,
          0,
          '',
          continuation,
          context,
          gen_stmts,
          eval_expr_fn))
    end
    end
  end
  end
  let mut alternative_statements: [Shared<CppStatement>] = []
  alternative_statements.push(emit_helpers.make_if_cpp_statement(
    emit_helpers.make_identifier_cpp_expression(holds_text),
    emit_helpers.make_block_cpp_statement(then_statements),
    emit_helpers.make_block_cpp_statement(else_statements)))
  alternative_statements
end

fn cyclic_array_or_alternative_statements(
  alternatives: [Shared<Pattern>],
  alternative_cursor: i32,
  element_index: i32,
  array_access: string,
  continuation: [Shared<CppStatement>],
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if alternative_cursor >= alternatives.length() then do
    let mut empty_statements: [Shared<CppStatement>] = []
    empty_statements
  end else do
    const else_statements = cyclic_array_or_alternative_statements(
      alternatives,
      alternative_cursor + 1,
      element_index,
      array_access,
      continuation,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
    match alternatives[alternative_cursor] {
      PatternCtor(constructor_name, sub_patterns, _) =>
        cyclic_array_constructor_alternative_statements(
          constructor_name,
          sub_patterns,
          element_index,
          array_access,
          continuation,
          else_statements,
          arm,
          subject,
          use_void,
          arm_context,
          context,
          gen_stmts,
          eval_expr_fn),
      _ => else_statements
    }
  end
  end
end

fn name_constructor_element_statements(
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  continuation: [Shared<CppStatement>],
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if payload_cursor >= payload_indexes.length() then
    continuation
  else do
    const element_index = payload_indexes[payload_cursor]
    let mut statements: [Shared<CppStatement>] = []
    match element_patterns[element_index] {
      PatternCtor(constructor_name, sub_patterns, _) => do
        const payload_sum_name = '__cyclic_payload_sum_' + element_index.to_string()
        const lower_name = cyclic_array_element_lower_name(array_access, constructor_name, element_index)
        const qualified_name = context.resolve(constructor_name)
        const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
        const variant_type_name = qualified_name + type_argument
        statements.push(emit_helpers.make_fragment_cpp_statement(
          'const auto& ' + payload_sum_name + ' = (*' + array_access + "[" + element_index.to_string() + "])._; "))
        let mut then_statements: [Shared<CppStatement>] = []
        then_statements.push(
          variant_get_const_ref_statement(variant_type_name, lower_name, payload_sum_name))
        const later_elements = name_constructor_element_statements(
          element_patterns,
          payload_indexes,
          payload_cursor + 1,
          array_access,
          continuation,
          arm,
          subject,
          use_void,
          arm_context,
          context,
          gen_stmts,
          eval_expr_fn)
        if constructor_subpatterns_are_name_bindings(sub_patterns) then do
          const no_nested_indexes: [i32] = []
          const bound_fields = constructor_field_ident_statements(
            constructor_name, sub_patterns, lower_name, no_nested_indexes, arm_context, context)
          then_statements = append_cpp_statements(then_statements, bound_fields.field_binding_statements)
          then_statements = append_cpp_statements(then_statements, later_elements)
        end
        end
        if constructor_subpatterns_are_name_bindings(sub_patterns) == false then do
          const empty_patterns: [Shared<Pattern>] = []
          const empty_indexes: [i32] = []
          const empty_resume: [NestedMatchResume] = []
          then_statements = append_cpp_statements(
            then_statements,
            constructor_inner_statements(
              arm,
              constructor_name,
              sub_patterns,
              lower_name,
              subject,
              use_void,
              arm_context,
              '',
              empty_patterns,
              '',
              empty_indexes,
              0,
              empty_resume,
              empty_patterns,
              empty_indexes,
              0,
              '',
              later_elements,
              context,
              gen_stmts,
              eval_expr_fn))
        end
        end
        statements.push(emit_helpers.make_if_cpp_statement(
          variant_holds_alternative_expression(variant_type_name, payload_sum_name),
          emit_helpers.make_block_cpp_statement(then_statements),
          emit_helpers.make_block_cpp_statement([])))
      end,
      PatternOr(alternatives, _) => do
        const later_elements = name_constructor_element_statements(
          element_patterns,
          payload_indexes,
          payload_cursor + 1,
          array_access,
          continuation,
          arm,
          subject,
          use_void,
          arm_context,
          context,
          gen_stmts,
          eval_expr_fn)
        statements = cyclic_array_or_alternative_statements(
          alternatives,
          0,
          element_index,
          array_access,
          later_elements,
          arm,
          subject,
          use_void,
          arm_context,
          context,
          gen_stmts,
          eval_expr_fn)
      end,
      _ => do end
    }
    statements
  end
  end
end

fn cyclic_array_pattern_if_statement(
  element_patterns: [Shared<Pattern>],
  rest_name: string,
  sum_name: string,
  array_access: string,
  continuation: [Shared<CppStatement>],
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> Shared<CppStatement> = do
  const size_comparison = if rest_name == '' then ' == ' else ' >= ' end
  let mut condition_text = array_access + '.size()' + size_comparison + element_patterns.length().to_string()
  let mut inner_statements: [Shared<CppStatement>] = []
  let mut payload_indexes: [i32] = []
  let mut element_index = 0
  while element_index < element_patterns.length() do
    match element_patterns[element_index] {
      PatternIdent(binding_name, _) => do
        inner_statements.push(emit_helpers.make_fragment_cpp_statement(
          'const auto& ' + cpp_safe(binding_name) + ' = (*' + array_access + "[" + element_index.to_string() + "]); "))
      end,
      PatternCtor(inner_name, sub_patterns, _) => do
        if sub_patterns.length() == 0 then
          condition_text = condition_text + ' && std::holds_alternative<' + context.resolve(inner_name) + '>((*' + array_access + "[" + element_index.to_string() + "])._)"
        end
        if sub_patterns.length() != 0 && constructor_subpatterns_are_supported_fields(sub_patterns) then
          payload_indexes.push(element_index)
        end
      end,
      PatternOr(_, _) => do
        payload_indexes.push(element_index)
      end,
      _ => do end
    }
    element_index = element_index + 1
  end
  if rest_name != '' then
    inner_statements.push(emit_helpers.make_fragment_cpp_statement(
      'const auto ' + cpp_safe(rest_name) + ' = mlc::Array<std::shared_ptr<' + sum_name + '>>(' + array_access + '.cbegin() + ' + element_patterns.length().to_string() + ', ' + array_access + '.cend()); '))
  end
  let mut body = continuation
  if payload_indexes.length() > 0 then
    body = name_constructor_element_statements(
      element_patterns,
      payload_indexes,
      0,
      array_access,
      continuation,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end
  inner_statements = append_cpp_statements(inner_statements, body)
  emit_helpers.make_if_cpp_statement(
    emit_helpers.make_identifier_cpp_expression(condition_text),
    emit_helpers.make_block_cpp_statement(inner_statements),
    emit_helpers.make_block_cpp_statement([]))
end

fn statements_inside_cyclic_array_fields(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  lower_name: string,
  continuation: [Shared<CppStatement>],
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const field_indexes = cyclic_array_pattern_field_indexes(constructor_name, sub_patterns, context)
  let mut wrapped = continuation
  let mut cursor = field_indexes.length()
  while cursor > 0 do
    cursor = cursor - 1
    const field_index = field_indexes[cursor]
    match sub_patterns[field_index] {
      PatternArray(element_patterns, rest_name, _) => do
        const array_if = cyclic_array_pattern_if_statement(
          element_patterns,
          rest_name,
          cyclic_array_field_sum_name_at(constructor_name, field_index, context),
          lower_name + "." + constructor_field_member_name(context, constructor_name, field_index),
          wrapped,
          arm,
          subject,
          use_void,
          arm_context,
          context,
          gen_stmts,
          eval_expr_fn)
        wrapped = [array_if]
      end,
      _ => do end
    }
  end
  wrapped
end

fn statements_after_constructor(
  arm: Shared<SemanticMatchArm>,
  use_void: bool,
  arm_context: CodegenContext,
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  finish_statements: [Shared<CppStatement>],
  subject: Shared<SemanticExpression>,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if payload_cursor < payload_indexes.length() then
    array_name_constructor_statements(
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
  else if finish_statements.length() > 0 then
    finish_statements
  else
    guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn)
  end
end

fn nested_constructor_field_if(
  arm: Shared<SemanticMatchArm>,
  parent_name: string,
  parent_patterns: [Shared<Pattern>],
  parent_lower_name: string,
  field_index: i32,
  next_indexes: [i32],
  next_cursor: i32,
  resume_stack: [NestedMatchResume],
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  finish_statements: [Shared<CppStatement>],
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  let mut statements: [Shared<CppStatement>] = []
  match parent_patterns[field_index] {
    PatternCtor(inner_name, inner_patterns, _) => do
      const member_name = constructor_field_member_name(context, parent_name, field_index)
      const inner_sum_name = '__cyclic_inner_sum_' + field_index.to_string()
      const qualified_name = context.resolve(inner_name)
      const lower_name = parent_lower_name + "_" + field_index.to_string()
      const type_argument = generic_ctor_type_argument(context, inner_name, subject)
      const variant_type_name = qualified_name + type_argument
      const variant_access = inner_sum_name + "._"
      statements.push(emit_helpers.make_fragment_cpp_statement(
        'const auto& ' + inner_sum_name + ' = (*' + parent_lower_name + "." + member_name + "); "))
      let mut then_statements: [Shared<CppStatement>] = []
      then_statements.push(
        variant_get_const_ref_statement(variant_type_name, lower_name, variant_access))
      then_statements = append_cpp_statements(
        then_statements,
        constructor_inner_statements(
          arm,
          inner_name,
          inner_patterns,
          lower_name,
          subject,
          use_void,
          arm_context,
          parent_name,
          parent_patterns,
          parent_lower_name,
          next_indexes,
          next_cursor,
          resume_stack,
          element_patterns,
          payload_indexes,
          payload_cursor,
          array_access,
          finish_statements,
          context,
          gen_stmts,
          eval_expr_fn))
      statements.push(emit_helpers.make_if_cpp_statement(
        variant_holds_alternative_expression(variant_type_name, variant_access),
        emit_helpers.make_block_cpp_statement(then_statements),
        emit_helpers.make_block_cpp_statement([])))
    end,
    _ => do end
  }
  statements
end

export fn constructor_inner_statements(
  arm: Shared<SemanticMatchArm>,
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  lower_name: string,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  outer_name: string,
  outer_patterns: [Shared<Pattern>],
  outer_lower_name: string,
  outer_indexes: [i32],
  outer_cursor: i32,
  resume_stack: [NestedMatchResume],
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  finish_statements: [Shared<CppStatement>],
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const nested_indexes = boxed_nested_constructor_indexes(constructor_name, sub_patterns, context)
  const bound_fields = constructor_field_ident_statements(
    constructor_name, sub_patterns, lower_name, nested_indexes, arm_context, context)
  const pattern_context = context_with_cyclic_array_pattern_bindings(
    bound_fields.arm_context, constructor_name, sub_patterns, context)
  let mut continuation: [Shared<CppStatement>] = []
  if nested_indexes.length() > 0 then do
    let mut saved_stack = resume_stack
    if outer_cursor < outer_indexes.length() then do
      saved_stack.push(NestedMatchResume {
        constructor_name: outer_name,
        lower_name: outer_lower_name,
        cursor: outer_cursor,
        indexes: outer_indexes,
        patterns: outer_patterns
      })
    end
    end
    continuation = nested_constructor_field_if(
      arm,
      constructor_name,
      sub_patterns,
      lower_name,
      nested_indexes[0],
      nested_indexes,
      1,
      saved_stack,
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      finish_statements,
      subject,
      use_void,
      pattern_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end else if outer_cursor < outer_indexes.length() then do
    continuation = nested_constructor_field_if(
      arm,
      outer_name,
      outer_patterns,
      outer_lower_name,
      outer_indexes[outer_cursor],
      outer_indexes,
      outer_cursor + 1,
      resume_stack,
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      finish_statements,
      subject,
      use_void,
      pattern_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end else if resume_stack.length() > 0 then do
    const frame = resume_stack[resume_stack.length() - 1]
    continuation = nested_constructor_field_if(
      arm,
      frame.constructor_name,
      frame.patterns,
      frame.lower_name,
      frame.indexes[frame.cursor],
      frame.indexes,
      frame.cursor + 1,
      resume_stack_without_last(resume_stack),
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      finish_statements,
      subject,
      use_void,
      pattern_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end else do
    continuation = statements_after_constructor(
      arm,
      use_void,
      pattern_context,
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      finish_statements,
      subject,
      context,
      gen_stmts,
      eval_expr_fn)
  end
  end
  const wrapped_continuation = statements_inside_cyclic_array_fields(
    constructor_name,
    sub_patterns,
    lower_name,
    continuation,
    arm,
    subject,
    use_void,
    pattern_context,
    context,
    gen_stmts,
    eval_expr_fn)
  append_cpp_statements(bound_fields.field_binding_statements, wrapped_continuation)
end

fn one_array_name_constructor_statements(
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  const element_index = payload_indexes[payload_cursor]
  let mut statements: [Shared<CppStatement>] = []
  match element_patterns[element_index] {
    PatternCtor(constructor_name, sub_patterns, _) => do
      const payload_sum_name = '__cyclic_payload_sum_' + element_index.to_string()
      const lower_name = cpp_safe(lower_first(constructor_name)) + "_" + element_index.to_string()
      const qualified_name = context.resolve(constructor_name)
      const type_argument = generic_ctor_type_argument(context, constructor_name, subject)
      const variant_type_name = qualified_name + type_argument
      statements.push(emit_helpers.make_fragment_cpp_statement(
        'const auto& ' + payload_sum_name + ' = (*' + array_access + "[" + element_index.to_string() + "])._; "))
      let mut then_statements: [Shared<CppStatement>] = []
      then_statements.push(
        variant_get_const_ref_statement(variant_type_name, lower_name, payload_sum_name))
      if constructor_subpatterns_are_name_bindings(sub_patterns) then do
        const no_nested_indexes: [i32] = []
        const bound_fields = constructor_field_ident_statements(
          constructor_name, sub_patterns, lower_name, no_nested_indexes, arm_context, context)
        then_statements = append_cpp_statements(then_statements, bound_fields.field_binding_statements)
        then_statements = append_cpp_statements(
          then_statements,
          array_name_constructor_statements(
            element_patterns,
            payload_indexes,
            payload_cursor + 1,
            array_access,
            arm,
            subject,
            use_void,
            bound_fields.arm_context,
            context,
            gen_stmts,
            eval_expr_fn))
      end
      end
      if constructor_subpatterns_are_name_bindings(sub_patterns) == false then do
        const empty_patterns: [Shared<Pattern>] = []
        const empty_indexes: [i32] = []
        const empty_resume: [NestedMatchResume] = []
        then_statements = append_cpp_statements(
          then_statements,
          constructor_inner_statements(
            arm,
            constructor_name,
            sub_patterns,
            lower_name,
            subject,
            use_void,
            arm_context,
            '',
            empty_patterns,
            '',
            empty_indexes,
            0,
            empty_resume,
            element_patterns,
            payload_indexes,
            payload_cursor + 1,
            array_access,
            no_finish_statements(),
            context,
            gen_stmts,
            eval_expr_fn))
      end
      end
      statements.push(emit_helpers.make_if_cpp_statement(
        variant_holds_alternative_expression(variant_type_name, payload_sum_name),
        emit_helpers.make_block_cpp_statement(then_statements),
        emit_helpers.make_block_cpp_statement([])))
    end,
    PatternOr(alternatives, _) => do
      const later_elements = array_name_constructor_statements(
        element_patterns,
        payload_indexes,
        payload_cursor + 1,
        array_access,
        arm,
        subject,
        use_void,
        arm_context,
        context,
        gen_stmts,
        eval_expr_fn)
      statements = cyclic_array_or_alternative_statements(
        alternatives,
        0,
        element_index,
        array_access,
        later_elements,
        arm,
        subject,
        use_void,
        arm_context,
        context,
        gen_stmts,
        eval_expr_fn)
    end,
    _ => do end
  }
  statements
end

export fn array_name_constructor_statements(
  element_patterns: [Shared<Pattern>],
  payload_indexes: [i32],
  payload_cursor: i32,
  array_access: string,
  arm: Shared<SemanticMatchArm>,
  subject: Shared<SemanticExpression>,
  use_void: bool,
  arm_context: CodegenContext,
  context: CodegenContext,
  gen_stmts: ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>],
  eval_expr_fn: (Shared<SemanticExpression>, CodegenContext, ([Shared<SemanticStatement>], CodegenContext) -> [Shared<CppStatement>]) -> string
) -> [Shared<CppStatement>] = do
  if payload_cursor >= payload_indexes.length() then
    guarded_arm_tail_statements(arm, use_void, arm_context, gen_stmts, eval_expr_fn)
  else
    one_array_name_constructor_statements(
      element_patterns,
      payload_indexes,
      payload_cursor,
      array_access,
      arm,
      subject,
      use_void,
      arm_context,
      context,
      gen_stmts,
      eval_expr_fn)
  end
end

