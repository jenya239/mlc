// Record/ctor field-binding helpers shared by all 3 match-arm codegen strategies
// (std::visit string-lambda, std::visit CppExpression IR, guarded if-chain).
// No injected gen_stmts/eval_expr_fn — only CodegenContext/Pattern/string in, CodegenContext/RecordFieldBindAccum out.

import { Pattern } from '../../frontend/ast'
import { CodegenContext, CtorTypeInfo, lookup_ctor_type_info_for_context } from '../context'
import { cpp_safe } from '../cpp_naming'
import { record_pattern_field_binding } from './match_arm_lambda'

type RecordFieldBindAccum = RecordFieldBindAccum {
  field_bindings: string,
  arm_context: CodegenContext,
  next_field_index: i32
}

fn record_field_binding_text(field_cpp_safe: string, lower_name: string, boxed: bool) -> string =
  if boxed then
    'const auto& ' + field_cpp_safe + ' = (*' + lower_name + "." + field_cpp_safe + '); '
  else
    record_pattern_field_binding(field_cpp_safe, lower_name)
  end

fn record_field_bind_step(
  accumulated: RecordFieldBindAccum,
  field_pattern: Shared<Pattern>,
  lower_name: string,
  constructor_info: Shared<CtorTypeInfo>
) -> RecordFieldBindAccum =
  match field_pattern {
    PatternIdent(field_name, _) =>
      RecordFieldBindAccum {
        field_bindings: accumulated.field_bindings +
          record_field_binding_text(
            cpp_safe(field_name),
            lower_name,
            constructor_info.boxed_positions.contains(accumulated.next_field_index)),
        arm_context: accumulated.arm_context.add_value(field_name),
        next_field_index: accumulated.next_field_index + 1
      },
    _ => RecordFieldBindAccum {
      field_bindings: accumulated.field_bindings,
      arm_context: accumulated.arm_context,
      next_field_index: accumulated.next_field_index + 1
    }
  }

export fn record_pattern_field_bindings_and_context(
  constructor_name: string,
  field_patterns: [Shared<Pattern>],
  lower_name: string,
  start_context: CodegenContext
) -> RecordFieldBindAccum = do
  const constructor_info = lookup_ctor_type_info_for_context(start_context, constructor_name)
  field_patterns.fold(
    RecordFieldBindAccum { field_bindings: '', arm_context: start_context, next_field_index: 0 },
    (accumulated, field_pattern) =>
      record_field_bind_step(accumulated, field_pattern, lower_name, constructor_info))
end

export fn codegen_context_with_ctor_field_bindings(
  constructor_name: string,
  sub_patterns: [Shared<Pattern>],
  base_context: CodegenContext
) -> CodegenContext = do
  const ctor_type_information: Shared<CtorTypeInfo> = lookup_ctor_type_info_for_context(base_context, constructor_name)
  let mut arm_context = base_context
  let mut pattern_index = 0
  while pattern_index < sub_patterns.length() do
    match sub_patterns[pattern_index] {
      PatternIdent(pattern_name, _) => do
        if ctor_type_information.shared_pos.contains(pattern_index) then
          arm_context = arm_context.add_shared(pattern_name)
        end
        if ctor_type_information.shared_arr_pos.contains(pattern_index) then
          arm_context = arm_context.add_shared_array(pattern_name)
        end
        if (!ctor_type_information.shared_pos.contains(pattern_index)) && (!ctor_type_information.shared_arr_pos.contains(pattern_index)) then
          arm_context = arm_context.add_value(pattern_name)
        end
      end,
      _ => do end
    }
    pattern_index = pattern_index + 1
  end
  arm_context
end
