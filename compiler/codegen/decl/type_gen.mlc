// Type expression → C++ string generation.

import { TypeVariant, TypeExpr, FieldDef, Decl, Param, TyI32, TyBool, TyString, VarUnit, VarTuple, VarRecord } from '../../frontend/ast'
import { Type } from '../../checker/registry'
import {
  record_field_default_expression_is_static_initializer
} from '../../ir/record_field_default_validate'
import { record_field_default_expression_cpp_initializer } from '../record_field_default_emit'
import { CodegenContext, CtorTypeInfo, trait_has_associated_types } from '../context'
import { list_contains } from './decl_index'
import { cpp_safe, lower_first, template_prefix } from '../cpp_naming'

export fn cpp_array_type_element(inner_type_cpp: string) -> string =
  `mlc::Array<${inner_type_cpp}>`

export fn cpp_shared_pointer_type(inner_type_cpp: string) -> string =
  `std::shared_ptr<${inner_type_cpp}>`

export fn cpp_raw_pointer_type(inner_type_cpp: string) -> string =
  `${inner_type_cpp}*`

export fn cpp_template_single_type_argument(template_name_cpp: string, type_argument_cpp: string) -> string =
  `${template_name_cpp}<${type_argument_cpp}>`

export fn cpp_template_two_type_arguments(
  template_name_cpp: string,
  first_type_argument_cpp: string,
  second_type_argument_cpp: string
) -> string =
  `${template_name_cpp}<${first_type_argument_cpp}, ${second_type_argument_cpp}>`

export fn cpp_std_function_type(return_type_cpp: string, parameter_types_csv: string) -> string =
  `std::function<${return_type_cpp}(${parameter_types_csv})>`

// Wrap in type_identity_t so `T name` param syntax is valid C++
// (`int(*)(int) name` is a parse error; `std::type_identity_t<int(*)(int)> name` is ok).
export fn cpp_c_function_pointer_type(return_type_cpp: string, parameter_types_csv: string) -> string =
  `std::type_identity_t<${return_type_cpp}(*)(${parameter_types_csv})>`

export fn cpp_lvalue_reference_suffix(inner_type_cpp: string) -> string =
  `${inner_type_cpp}&`

export fn struct_empty_definition(resolved_struct_name: string) -> string =
  `struct ${resolved_struct_name} {};\n`

export fn struct_with_inline_members_definition(resolved_struct_name: string, member_declarations_concatenated: string) -> string =
  `struct ${resolved_struct_name} {${member_declarations_concatenated}};\n`

export fn struct_forward_declaration_line(template_prefix_before_keyword: string, resolved_struct_name: string) -> string =
  `${template_prefix_before_keyword}struct ${resolved_struct_name};\n`

export fn variant_using_alias_definition_line(
  template_prefix_before_using: string,
  resolved_alias_name: string,
  variant_alternatives_csv: string
) -> string =
  `${template_prefix_before_using}using ${resolved_alias_name} = std::variant<${variant_alternatives_csv}>;\n`

export fn concept_requires_clause_line(requires_predicates_joined: string) -> string =
  `requires ${requires_predicates_joined}\n`

export fn concept_trait_constraint_on_type_parameter(trait_name_cpp_safe: string, type_parameter_name: string) -> string =
  `${trait_name_cpp_safe}<${type_parameter_name}>`

export fn concept_trait_constraint_with_result_and_implementor(
  trait_name_cpp_safe: string,
  result_type_parameter_name: string,
  implementor_type_parameter_name: string
) -> string =
  `${trait_name_cpp_safe}<${result_type_parameter_name}, ${implementor_type_parameter_name}>`

export fn noexcept_function_prototype(return_type_cpp: string, name_cpp: string, parameter_list: string) -> string =
  `${return_type_cpp} ${name_cpp}(${parameter_list}) noexcept;\n`

export fn cpp_template_typename_header_line(template_parameter_list: string) -> string =
  `template<typename ${template_parameter_list}>\n`

export fn concept_requires_expression_method_returns_convertible(
  callee_name: string,
  declval_arguments_csv: string,
  destination_type_cpp: string
) -> string =
  if declval_arguments_csv.length() > 0 then
    `{ ${callee_name}(self, ${declval_arguments_csv}) } -> std::convertible_to<${destination_type_cpp}>`
  else
    `{ ${callee_name}(self) } -> std::convertible_to<${destination_type_cpp}>`
  end

export fn trait_vtable_struct_cpp_name(trait_cpp_safe: string) -> string =
  `${trait_cpp_safe}_vtable`

export fn function_call_parentheses(callee_code: string, argument_list: string) -> string =
  `${callee_code}(${argument_list})`

export fn runtime_to_string_call(expression_code: string) -> string =
  `mlc::to_string(${expression_code})`

export fn struct_tuple_field_declaration(element_type_cpp: string, field_index_text: string) -> string =
  `${element_type_cpp} field${field_index_text};`

export fn struct_named_field_declaration(field_type_cpp: string, field_name_cpp_safe: string) -> string =
  `${field_type_cpp} ${field_name_cpp_safe};`

fn cpp_generic_base_name(context: CodegenContext, type_name: string) -> string =
  if type_name == 'Map' then 'mlc::HashMap'
  else if type_name == 'Shared' then 'std::shared_ptr'
  else if type_name == 'Weak' then 'std::weak_ptr'
  else if type_name == 'Task' then 'mlc::Task'
  else if type_name == 'Future' then 'mlc::Task'
  else if type_name == 'Channel' then 'mlc::concurrency::Channel'
  else if type_name == 'Arc' then 'mlc::concurrency::Arc'
  else if type_name == 'Mutex' then 'mlc::concurrency::Mutex'
  else if type_name == 'Isolate' then 'mlc::concurrency::Isolate'
  else if type_name == 'TaskScope' then 'mlc::concurrency::TaskScope'
  else if type_name == 'ChannelReceiveResult' then 'mlc::concurrency::ChannelReceiveResult'
  else if type_name == 'RegionHandle' then 'mlc::memory::RegionHandle'
  else if type_name == 'Region' then 'mlc::memory::RegionPtr'
  else context.resolve(type_name)
  end

export fn maps_option_to_std_optional(context: CodegenContext) -> bool =
  !context.sum_type_parameter_names.has('Option')
    && context.variant_types.get('Some') != 'Option'
    && context.variant_types.get('None') != 'Option'

export fn maps_result_to_runtime_result(context: CodegenContext) -> bool =
  !context.sum_type_parameter_names.has('Result')
    && context.variant_types.get('Ok') != 'Result'
    && context.variant_types.get('Err') != 'Result'

fn semantic_cyclic_sum_pointer_cpp(context: CodegenContext, semantic_type: Shared<Type>) -> string =
  match semantic_type {
    TNamed(type_name) =>
      if list_contains(context.cyclic_sum_type_names, type_name) then
        cpp_shared_pointer_type(context.resolve(type_name))
      else ''
      end,
    _ => ''
  }

fn type_expression_cyclic_sum_pointer_cpp(context: CodegenContext, type_expression: Shared<TypeExpr>) -> string =
  match type_expression {
    TyNamed(type_name) =>
      if list_contains(context.cyclic_sum_type_names, type_name) then
        cpp_shared_pointer_type(context.resolve(type_name))
      else ''
      end,
    _ => ''
  }

export fn cyclic_option_sum_cpp_name(context: CodegenContext, semantic_type: Shared<Type>) -> string =
  match semantic_type {
    TGeneric(type_name, type_arguments) =>
      if type_name == 'Option' && type_arguments.length() == 1 then
        match type_arguments[0] {
          TNamed(inner_name) =>
            if list_contains(context.cyclic_sum_type_names, inner_name) then
              context.resolve(inner_name)
            else ''
            end,
          _ => ''
        }
      else ''
      end,
    TFn(_, return_type) => cyclic_option_sum_cpp_name(context, return_type),
    _ => ''
  }

// Converts a semantic Type (from checker/registry) to a C++ type string.
export fn sem_type_to_cpp(context: CodegenContext, semantic_type: Shared<Type>) -> string =
  match semantic_type {
    TI32     => 'int',
    TString  => 'mlc::String',
    TBool    => 'bool',
    TUnit    => 'void',
    TI64     => 'int64_t',
    TF64     => 'double',
    TU8      => 'uint8_t',
    TUsize   => 'size_t',
    TChar    => 'char32_t',
    TUnknown => 'auto',
    TArray(inner)  => do
      const pointer_type = semantic_cyclic_sum_pointer_cpp(context, inner)
      if pointer_type != '' then cpp_array_type_element(pointer_type)
      else cpp_array_type_element(sem_type_to_cpp(context, inner))
      end
    end,
    TShared(inner) => cpp_shared_pointer_type(sem_type_to_cpp(context, inner)),
    TNamed(type_name)  =>
      if type_name == 'TaskScope' then 'mlc::concurrency::TaskScope'
      else if type_name == 'StopSource' then 'mlc::concurrency::StopSource'
      else if type_name == 'StopToken' then 'mlc::concurrency::StopToken'
      else if type_name == 'ChannelStatus' then 'mlc::concurrency::ChannelStatus'
      else if type_name == 'AtomicBool' then 'mlc::concurrency::AtomicBool'
      else if type_name == 'AtomicI32' then 'mlc::concurrency::AtomicI32'
      else if type_name == 'AtomicI64' then 'mlc::concurrency::AtomicI64'
      else if type_name == 'AtomicU64' then 'mlc::concurrency::AtomicU64'
      else if type_name == 'Supervisor' then 'mlc::concurrency::Supervisor'
      else if type_name == 'RestartPolicy' then 'mlc::concurrency::RestartPolicy'
      else if type_name == 'TestRuntime' then 'mlc::concurrency::testing::TestScheduler'
      else if type_name.length() >= 10 && type_name.substring(0, 10) == 'RegionTag_' then 'void'
      else context.resolve(type_name)
      end,
    TTuple(types) =>
      `std::tuple<${types.map(type_value => sem_type_to_cpp(context, type_value)).join(', ')}>`,
    TPair(left, right) =>
      `std::pair<${sem_type_to_cpp(context, left)}, ${sem_type_to_cpp(context, right)}>`,
    TGeneric(type_name, type_arguments) =>
      if type_name == 'Option' && type_arguments.length() == 1 &&
         semantic_cyclic_sum_pointer_cpp(context, type_arguments[0]) != '' then
        cpp_template_single_type_argument(
          'std::optional',
          semantic_cyclic_sum_pointer_cpp(context, type_arguments[0]))
      else if type_name == 'Option' && type_arguments.length() == 1 &&
         maps_option_to_std_optional(context) then
        `std::optional<${sem_type_to_cpp(context, type_arguments[0])}>`
      else if type_name == 'RegionHandle' then
        'mlc::memory::RegionHandle'
      else if type_name == 'Region' && type_arguments.length() == 2 then
        cpp_template_single_type_argument(
          'mlc::memory::RegionPtr',
          sem_type_to_cpp(context, type_arguments[1]))
      else if type_name == 'RawPointer' && type_arguments.length() == 1 then
        cpp_raw_pointer_type(sem_type_to_cpp(context, type_arguments[0]))
      else if type_name == '__ExternFn' && type_arguments.length() >= 1 then do
        const return_type_cpp = sem_type_to_cpp(context, type_arguments[0])
        let mut parameter_types_csv = ''
        let mut argument_index = 1
        while argument_index < type_arguments.length() do
          if argument_index > 1 then parameter_types_csv = parameter_types_csv + ', ' end
          parameter_types_csv = parameter_types_csv + sem_type_to_cpp(context, type_arguments[argument_index])
          argument_index = argument_index + 1
        end
        cpp_c_function_pointer_type(return_type_cpp, parameter_types_csv)
      end
      else if type_arguments.length() == 0 then cpp_generic_base_name(context, type_name)
      else if type_arguments.length() == 1 then
        cpp_template_single_type_argument(
          cpp_generic_base_name(context, type_name),
          sem_type_to_cpp(context, type_arguments[0]))
      else
        cpp_template_two_type_arguments(
          cpp_generic_base_name(context, type_name),
          sem_type_to_cpp(context, type_arguments[0]),
          sem_type_to_cpp(context, type_arguments[1]))
      end,
    TFn(param_types, return_type) =>
      cpp_std_function_type(
        sem_type_to_cpp(context, return_type),
        param_types.map(type_value => sem_type_to_cpp(context, type_value)).join(', ')),
    TAssoc(param, assoc) => `typename ${cpp_safe(param)}::${assoc}`
  }

fn type_alias_annotation_cpp(context: CodegenContext, alias_name: string) -> string =
  if context.type_alias_annotations.has(alias_name) then
    type_to_cpp(context, context.type_alias_annotations.get(alias_name))
  else
    ''
  end

fn type_name_to_cpp_literal(type_name: string) -> string =
  if type_name == 'i32' then 'int'
  else if type_name == 'string' then 'mlc::String'
  else if type_name == 'bool' then 'bool'
  else if type_name == 'unit' then 'void'
  else if type_name == 'i64' then 'int64_t'
  else if type_name == 'f64' then 'double'
  else if type_name == 'i8' then 'int8_t'
  else if type_name == 'i16' then 'int16_t'
  else if type_name == 'u8' then 'uint8_t'
  else if type_name == 'u16' then 'uint16_t'
  else if type_name == 'u32' then 'uint32_t'
  else if type_name == 'u64' then 'uint64_t'
  else if type_name == 'usize' then 'size_t'
  else if type_name == 'char' then 'char32_t'
  else ''
  end

fn type_name_to_cpp_self(context: CodegenContext) -> string =
  if context.self_type.length() > 0 then type_name_to_cpp(context, context.self_type) else 'void' end

fn associated_type_name_cpp(context: CodegenContext, associated_type_name: string) -> string =
  if trait_has_associated_types(context, context.self_type) then
    `typename Self::${cpp_safe(associated_type_name)}`
  else
    associated_type_name
  end

fn resolved_type_name_cpp(context: CodegenContext, type_name: string) -> string =
  context.resolve(type_name)

fn concurrency_builtin_type_name_to_cpp(type_name: string) -> string =
  if type_name == 'TaskScope' then 'mlc::concurrency::TaskScope'
  else if type_name == 'StopSource' then 'mlc::concurrency::StopSource'
  else if type_name == 'StopToken' then 'mlc::concurrency::StopToken'
  else if type_name == 'ChannelStatus' then 'mlc::concurrency::ChannelStatus'
  else if type_name == 'AtomicBool' then 'mlc::concurrency::AtomicBool'
  else if type_name == 'AtomicI32' then 'mlc::concurrency::AtomicI32'
  else if type_name == 'AtomicI64' then 'mlc::concurrency::AtomicI64'
  else if type_name == 'AtomicU64' then 'mlc::concurrency::AtomicU64'
  else if type_name == 'Supervisor' then 'mlc::concurrency::Supervisor'
  else if type_name == 'RestartPolicy' then 'mlc::concurrency::RestartPolicy'
  else if type_name == 'Isolate' then 'mlc::concurrency::Isolate'
  else if type_name == 'TestRuntime' then 'mlc::concurrency::testing::TestScheduler'
  else ''
  end

export fn type_name_to_cpp(context: CodegenContext, type_name: string) -> string =
  if type_alias_annotation_cpp(context, type_name) != '' then
    type_alias_annotation_cpp(context, type_name)
  else if type_name == 'Self' || type_name == 'self' then type_name_to_cpp_self(context)
  else if trait_has_associated_types(context, context.self_type) &&
          context.trait_associated_type_names.get(context.self_type).any(entry => entry == type_name) then
    associated_type_name_cpp(context, type_name)
  else if type_name_to_cpp_literal(type_name) != '' then type_name_to_cpp_literal(type_name)
  else if concurrency_builtin_type_name_to_cpp(type_name) != '' then
    concurrency_builtin_type_name_to_cpp(type_name)
  else resolved_type_name_cpp(context, type_name)
  end

export fn type_to_cpp(context: CodegenContext, type_expr: Shared<TypeExpr>) -> string =
  match type_expr {
    TyI32     => 'int',
    TyString  => 'mlc::String',
    TyBool    => 'bool',
    TyUnit    => 'void',
    TyNamed(name)   => type_name_to_cpp(context, name),
    TyArray(inner)  => do
      const pointer_type = type_expression_cyclic_sum_pointer_cpp(context, inner)
      if pointer_type != '' then cpp_array_type_element(pointer_type)
      else cpp_array_type_element(type_to_cpp(context, inner))
      end
    end,
    TyShared(inner) => cpp_shared_pointer_type(type_to_cpp(context, inner)),
    TyGeneric(name, type_arguments) => do
      if name == 'Option' && type_arguments.length() == 1 &&
         type_expression_cyclic_sum_pointer_cpp(context, type_arguments[0]) != '' then
        cpp_template_single_type_argument(
          'std::optional',
          type_expression_cyclic_sum_pointer_cpp(context, type_arguments[0]))
      else if name == 'ref' && type_arguments.length() == 1 then
        cpp_lvalue_reference_suffix(type_to_cpp(context, type_arguments[0]))
      else if name == 'RawPointer' && type_arguments.length() == 1 then
        cpp_raw_pointer_type(type_to_cpp(context, type_arguments[0]))
      else if name == 'Option' && type_arguments.length() == 1 &&
              maps_option_to_std_optional(context) then
        cpp_template_single_type_argument(
          'std::optional',
          type_to_cpp(context, type_arguments[0]))
      else if name == '__ExternFn' && type_arguments.length() >= 1 then do
        const return_type_cpp = type_to_cpp(context, type_arguments[0])
        let mut parameter_types_csv = ''
        let mut argument_index = 1
        while argument_index < type_arguments.length() do
          if argument_index > 1 then parameter_types_csv = parameter_types_csv + ', ' end
          parameter_types_csv = parameter_types_csv + type_to_cpp(context, type_arguments[argument_index])
          argument_index = argument_index + 1
        end
        cpp_c_function_pointer_type(return_type_cpp, parameter_types_csv)
      end
      else
        const safe = cpp_generic_base_name(context, name)
        if type_arguments.length() == 0 then safe
        else if type_arguments.length() == 1 then
          cpp_template_single_type_argument(safe, type_to_cpp(context, type_arguments[0]))
        else
          cpp_template_two_type_arguments(
            safe,
            type_to_cpp(context, type_arguments[0]),
            type_to_cpp(context, type_arguments[1])
          )
        end
      end
    end,
    TyFn(parameter_types, return_type_expression) =>
      cpp_std_function_type(
        type_to_cpp(context, return_type_expression),
        parameter_types.map(parameter_type => type_to_cpp(context, parameter_type)).join(', ')),
    TyAssoc(param, assoc) => `typename ${cpp_safe(param)}::${assoc}`
  }

// --- Type parameter helpers --------------------------------------------------

export fn type_param_in_typeexpr(param: string, type_expression: Shared<TypeExpr>) -> bool =
  match type_expression {
    TyNamed(name)       => name == param,
    TyArray(inner)      => type_param_in_typeexpr(param, inner),
    TyShared(inner)     => type_param_in_typeexpr(param, inner),
    TyGeneric(_, type_arguments) => type_param_in_typeexpr_list(param, type_arguments),
    TyFn(parameter_types, return_type_expression) =>
      type_param_in_typeexpr_list(param, parameter_types) || type_param_in_typeexpr(param, return_type_expression),
    TyAssoc(associated_parameter, _) => associated_parameter == param,
    _                   => false
  }

export fn type_param_in_typeexpr_list(param: string, types: [Shared<TypeExpr>]) -> bool =
  types.any(candidate => type_param_in_typeexpr(param, candidate))

export fn variant_field_typeexprs(variant: Shared<TypeVariant>) -> [Shared<TypeExpr>] =
  match variant {
    VarTuple(_, field_types, _)  => field_types,
    VarRecord(_, field_definitions, _) => field_definitions.map(field_definition => field_definition.type_value),
    VarUnit(_, _)        => do let empty: [Shared<TypeExpr>] = []; empty end
  }

export fn variant_used_type_parameters(type_parameters: [string], variant: Shared<TypeVariant>) -> [string] = do
  const field_types = variant_field_typeexprs(variant)
  type_parameters.filter(type_parameter => type_param_in_typeexpr_list(type_parameter, field_types))
end

export fn union_string_lists(first: [string], second: [string]) -> [string] =
  first.concat(second.filter(element => !first.any(existing => existing == element)))

export fn type_phantom_params_for_variants(type_parameters: [string], variants: [Shared<TypeVariant>]) -> [string] = do
  const all_fields = variants.flat_map(variant => variant_field_typeexprs(variant))
  type_parameters.filter(type_parameter => !type_param_in_typeexpr_list(type_parameter, all_fields))
end

export fn variant_field_type_cpp(context: CodegenContext, field_type: Shared<TypeExpr>, box_cyclic_fields: bool) -> string =
  match field_type {
    TyNamed(name) =>
      if box_cyclic_fields && list_contains(context.cyclic_sum_type_names, name) then
        `std::shared_ptr<${context.resolve(name)}>`
      else type_to_cpp(context, field_type)
      end,
    _ => type_to_cpp(context, field_type)
  }

fn field_def_member_declaration(context: CodegenContext, field_definition: Shared<FieldDef>, box_cyclic_fields: bool) -> string = do
  const base = struct_named_field_declaration(
    variant_field_type_cpp(context, field_definition.type_value, box_cyclic_fields), cpp_safe(field_definition.name))
  if field_definition.has_default_expression &&
     record_field_default_expression_is_static_initializer(field_definition.default_expression) then
    base + ' = ' + record_field_default_expression_cpp_initializer(field_definition.default_expression, context)
  else base
  end
end

fn variant_record_struct_inline_member_declarations(context: CodegenContext, field_definitions: [Shared<FieldDef>], box_cyclic_fields: bool) -> string =
  field_definitions.map(field_definition => field_def_member_declaration(context, field_definition, box_cyclic_fields)).join('')

// --- Variant struct generation -----------------------------------------------

export fn variant_ctor_name(variant: Shared<TypeVariant>) -> string =
  match variant { VarUnit(name, _) => name, VarTuple(name, _, _) => name, VarRecord(name, _, _) => name }

type TupleStructCodegenFoldState = TupleStructCodegenFoldState { field_slot_index: i32, declaration_text_so_far: string }

fn tuple_variant_struct_members_fragment(context: CodegenContext, field_types: [Shared<TypeExpr>], box_cyclic_fields: bool) -> string =
  field_types.fold(
    TupleStructCodegenFoldState { field_slot_index: 0, declaration_text_so_far: '' },
    (accumulated_tuple_state, field_type_expression_under_tuple) =>
      TupleStructCodegenFoldState {
        field_slot_index: accumulated_tuple_state.field_slot_index + 1,
        declaration_text_so_far: accumulated_tuple_state.declaration_text_so_far +
          struct_tuple_field_declaration(
            variant_field_type_cpp(context, field_type_expression_under_tuple, box_cyclic_fields),
            accumulated_tuple_state.field_slot_index.to_string())
      }
  ).declaration_text_so_far

fn gen_variant_struct(context: CodegenContext, type_name: string, variant: Shared<TypeVariant>) -> string = do
  const box_cyclic_fields = list_contains(context.cyclic_sum_type_names, type_name)
  match variant {
    VarUnit(name, _) => struct_empty_definition(context.resolve(name)),
    VarTuple(name, field_types, _) =>
      struct_with_inline_members_definition(
        context.resolve(name),
        tuple_variant_struct_members_fragment(context, field_types, box_cyclic_fields)),
    VarRecord(name, field_defs, _) =>
      struct_with_inline_members_definition(
        context.resolve(name),
        variant_record_struct_inline_member_declarations(context, field_defs, box_cyclic_fields))
  }
end

fn struct_extra_using(context: CodegenContext, type_name: string) -> string =
  if context.struct_using_lines.has(type_name) then
    context.struct_using_lines.get(type_name).join('')
  else '' end

fn gen_single_variant(context: CodegenContext, type_name: string, variant: Shared<TypeVariant>) -> string =
  match variant {
    VarRecord(_, field_defs, _) =>
      struct_with_inline_members_definition(
        context.resolve(type_name),
        variant_record_struct_inline_member_declarations(context, field_defs, false) + struct_extra_using(context, type_name)),
    VarTuple(_, field_types, _) =>
      struct_with_inline_members_definition(
        context.resolve(type_name),
        tuple_variant_struct_members_fragment(context, field_types, false) + struct_extra_using(context, type_name)),
    VarUnit(_, _) => struct_empty_definition(context.resolve(type_name))
  }

fn variant_forward_decl_line(context: CodegenContext, type_parameters: [string], phantom: [string], variant: Shared<TypeVariant>) -> string = do
  const variant_name = context.resolve(variant_ctor_name(variant))
  const used = union_string_lists(variant_used_type_parameters(type_parameters, variant), phantom)
  struct_forward_declaration_line(template_prefix(used), variant_name)
end

fn variant_type_argument_suffix(
  type_parameters: [string],
  phantom: [string],
  variant: Shared<TypeVariant>
) -> string = do
  const used = union_string_lists(variant_used_type_parameters(type_parameters, variant), phantom)
  if used.length() > 0 then `<${used.join(', ')}>` else '' end
end

fn variant_alias_part(context: CodegenContext, type_parameters: [string], phantom: [string], variant: Shared<TypeVariant>) -> string =
  context.resolve(variant_ctor_name(variant)) + variant_type_argument_suffix(type_parameters, phantom, variant)

export fn cyclic_sum_wrapper_definition(context: CodegenContext, type_name: string, variants: [Shared<TypeVariant>]) -> string = do
  const resolved_name = context.resolve(type_name)
  const variant_names = variants.map(variant => context.resolve(variant_ctor_name(variant))).join(', ')
  const constructors = variants.map(variant =>
    resolved_name + "(" + context.resolve(variant_ctor_name(variant)) + " value) : _(std::move(value)) {}"
  ).join(" ")
  `struct ${resolved_name} { std::variant<${variant_names}> _; ${constructors} };\n`
end

export fn gen_adt_fwd(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string = do
  const full_prefix = template_prefix(type_parameters)
  const phantom     = type_phantom_params_for_variants(type_parameters, variants)
  const forward_decls =
    variants.map(variant => variant_forward_decl_line(context, type_parameters, phantom, variant)).join('')
  if list_contains(context.cyclic_sum_type_names, type_name) then
    struct_forward_declaration_line('', context.resolve(type_name)) + forward_decls
  else
    const alias_parts =
      variants.map(variant => variant_alias_part(context, type_parameters, phantom, variant)).join(', ')
    forward_decls +
      variant_using_alias_definition_line(full_prefix, context.resolve(type_name), alias_parts)
  end
end

fn variant_def_with_prefix(
  context: CodegenContext,
  type_name: string,
  type_parameters: [string],
  phantom: [string],
  variant: Shared<TypeVariant>
) -> string = do
  const used = union_string_lists(variant_used_type_parameters(type_parameters, variant), phantom)
  template_prefix(used) + gen_variant_struct(context, type_name, variant)
end

export fn gen_adt_defs(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string = do
  const phantom = type_phantom_params_for_variants(type_parameters, variants)
  const variant_definitions =
    variants.map(variant => variant_def_with_prefix(context, type_name, type_parameters, phantom, variant)).join('')
  if list_contains(context.cyclic_sum_type_names, type_name) then
    variant_definitions + cyclic_sum_wrapper_definition(context, type_name, variants)
  else variant_definitions
  end
end

fn gen_type_decl_fwd(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string =
  if variants.length() == 1 then ''
  else gen_adt_fwd(context, type_name, type_parameters, variants)
  end

fn gen_type_decl_body(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string =
  if variants.length() == 1 then
    template_prefix(type_parameters) + gen_single_variant(context, type_name, variants[0])
  else gen_adt_defs(context, type_name, type_parameters, variants)
  end

export fn gen_type_decl(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string =
  gen_type_decl_fwd(context, type_name, type_parameters, variants) + gen_type_decl_body(context, type_name, type_parameters, variants)


export fn gen_type_decl_fwd_only(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string =
  gen_type_decl_fwd(context, type_name, type_parameters, variants)

export fn gen_type_decl_body_only(context: CodegenContext, type_name: string, type_parameters: [string], variants: [Shared<TypeVariant>]) -> string =
  gen_type_decl_body(context, type_name, type_parameters, variants)

// --- Requires clause ---------------------------------------------------------

fn requires_clause_bound_part(type_parameters: [string], type_parameter_index: i32, bound_trait_name: string) -> string =
  if bound_trait_name == 'ExprVisitor' && type_parameters.length() >= 2 then
    concept_trait_constraint_with_result_and_implementor(
      cpp_safe(bound_trait_name),
      type_parameters[0],
      type_parameters[type_parameter_index])
  else
    concept_trait_constraint_on_type_parameter(
      cpp_safe(bound_trait_name),
      type_parameters[type_parameter_index])
  end

export fn requires_clause(type_parameters: [string], type_bounds: [[string]]) -> string = do
  let mut parts: [string] = []
  let mut type_parameter_index = 0
  while type_parameter_index < type_parameters.length() do
    if type_parameter_index < type_bounds.length() then
      parts = parts.concat(
        type_bounds[type_parameter_index].map(
          bound_trait_name =>
            requires_clause_bound_part(type_parameters, type_parameter_index, bound_trait_name)))
    end
    type_parameter_index = type_parameter_index + 1
  end
  if parts.length() > 0 then concept_requires_clause_line(parts.join(' && ')) else '' end
end