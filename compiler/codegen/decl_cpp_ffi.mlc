// FFI/extern codegen (extern-type wrappers, FFI fn proto/def, header
// collection), split out of decl_cpp.mlc (§104-13 slice 5). Shared leaf of
// the remaining extend/decl-segment group still in decl_cpp.mlc — pure leaf,
// no calls back.

import { Param } from '../frontend/ast'
import { SemanticDeclaration, SemanticExpression, SemanticDeclarationFn, SemanticDeclarationExternType, SemanticDeclarationExported, SemanticExpressionExtern, sdecl_inner, FnEscapeInfo } from '../ir/semantic_ir'
import { Type } from '../checker/registry'
import { CppDeclaration, CppExpression, CppCall, CppCast, CppCastStatic, CppTypeName, CppTypePtr, CppUnary, CppUsing, CppClassDeclaration, CppClassDefinition, CppClassMemberFunctionDef, CppFunctionPrototype, CppParam, CppFnModifiers, CppIdent, CppFnDef } from '../cpp_ir/cpp_ast'
import * as emit_helpers from '../cpp_emit/emit_helpers'
import { CodegenContext } from './context'
import { compute_fn_body_context } from './decl/decl'
import { sem_type_to_cpp, type_to_cpp, template_prefix, requires_clause } from './decl/type_gen'
import { cpp_safe } from './cpp_naming'
import { empty_cpp_declaration, cpp_decl_from_native_declarations } from './decl_cpp_helpers'
import { function_parameter_def_items, context_with_fn_escape_cpp, merged_function_type_parameters_cpp, gen_fn_proto_cpp_with_escape } from './decl_cpp_fn'

export fn semantic_expression_is_extern(expression: Shared<SemanticExpression>) -> bool =
  match expression {
    SemanticExpressionExtern(_, _, _, _, _) => true,
    _ => false
  }

fn semantic_extern_ffi_c_name(expression: Shared<SemanticExpression>) -> string =
  match expression {
    SemanticExpressionExtern(_, extern_c_name, _, _, _) => extern_c_name,
    _ => ''
  }

fn semantic_extern_ffi_header(expression: Shared<SemanticExpression>) -> string =
  match expression {
    SemanticExpressionExtern(_, _, extern_header, _, _) => extern_header,
    _ => ''
  }

export fn semantic_expression_is_ffi_extern(expression: Shared<SemanticExpression>) -> bool =
  semantic_extern_ffi_c_name(expression).length() > 0

export fn semantic_expression_is_bare_extern(expression: Shared<SemanticExpression>) -> bool =
  semantic_expression_is_extern(expression) && !semantic_expression_is_ffi_extern(expression)

fn ffi_header_include_line(extern_header: string) -> string = do
  if extern_header.length() >= 2
     && extern_header.char_at(0) == "<"
     && extern_header.char_at(extern_header.length() - 1) == ">" then
    "#include <" + extern_header.substring(1, extern_header.length() - 2) + ">\n"
  else if extern_header.length() > 0 then
    "#include \"" + extern_header + "\"\n"
  else
    ""
  end
end

fn collect_ffi_include_lines_from_declaration(declaration: Shared<SemanticDeclaration>) -> string =
  match declaration {
    SemanticDeclarationFn(_, _, _, _, _, body, _, _, _) =>
      if semantic_expression_is_ffi_extern(body) then ffi_header_include_line(semantic_extern_ffi_header(body))
      else ''
      end,
    SemanticDeclarationExternType(_, _, extern_header, drop_function_name, _, _) => do
      let include_text = ffi_header_include_line(extern_header)
      if drop_function_name.length() > 0 then include_text + "#include <memory>\n"
      else include_text
      end
    end,
    SemanticDeclarationExported(inner_declaration) =>
      collect_ffi_include_lines_from_declaration(sdecl_inner(inner_declaration)),
    _ => ''
  }

export fn gen_extern_type_decl_cpp(
  type_name: string,
  c_type_name: string,
  drop_function_name: string
) -> Shared<CppDeclaration> = do
  let mut declarations: [Shared<CppDeclaration>] = []
  declarations.push(Shared.new(CppUsing(cpp_safe(type_name), "::" + c_type_name)))
  if drop_function_name.length() > 0 then
    const safe_type_name = cpp_safe(type_name)
    const deleter_name = "mlc_ffi_drop_" + safe_type_name
    const owned_name = "Owned" + safe_type_name
    const pointer_parameter = Shared.new(CppParam {
      name: "pointer",
      parameter_type: Shared.new(CppTypePtr(Shared.new(CppTypeName(safe_type_name)))),
    })
    const operator_modifiers = CppFnModifiers {
      is_const: true,
      is_virtual: false,
      is_override: false,
      is_static: false,
      is_explicit: false,
      is_noexcept: true,
      is_deleted: false,
      is_defaulted: false,
      is_pure_virtual: false,
    }
    const operator_prototype = Shared.new(CppFunctionPrototype {
      template_prefix: "",
      return_type: Shared.new(CppTypeName("void")),
      name: "operator()",
      parameters: [pointer_parameter],
      modifiers: operator_modifiers,
    })
    const drop_call = Shared.new(CppCall(
      Shared.new(CppIdent("::" + drop_function_name)),
      [Shared.new(CppIdent("pointer"))]
    ))
    const drop_if = emit_helpers.make_if_cpp_statement(
      Shared.new(CppIdent("pointer")),
      emit_helpers.make_expression_cpp_statement(drop_call),
      emit_helpers.make_block_cpp_statement([])
    )
    declarations.push(Shared.new(CppClassDeclaration(CppClassDefinition {
      is_struct: true,
      template_prefix: "",
      name: deleter_name,
      base_classes: [],
      members: [CppClassMemberFunctionDef(operator_prototype, [drop_if])],
    })))
    declarations.push(Shared.new(CppUsing(
      owned_name,
      "std::unique_ptr<" + safe_type_name + ", " + deleter_name + ">"
    )))
  end
  cpp_decl_from_native_declarations(declarations)
end

export fn collect_ffi_include_lines(declarations: [Shared<SemanticDeclaration>]) -> string = do
  let mut include_text = ''
  let mut declaration_index = 0
  while declaration_index < declarations.length() do
    include_text = include_text + collect_ffi_include_lines_from_declaration(declarations[declaration_index])
    declaration_index = declaration_index + 1
  end
  include_text
end

fn ffi_parameter_type_items(params: [Shared<Param>], context: CodegenContext) -> [string] = do
  let mut type_items: [string] = []
  let mut parameter_index = 0
  while parameter_index < params.length() do
    type_items.push(type_to_cpp(context, params[parameter_index].type_value))
    parameter_index = parameter_index + 1
  end
  type_items
end

fn ffi_parameter_name_items(params: [Shared<Param>]) -> [string] = do
  let mut name_items: [string] = []
  let mut parameter_index = 0
  while parameter_index < params.length() do
    name_items.push(cpp_safe(params[parameter_index].name))
    parameter_index = parameter_index + 1
  end
  name_items
end

// Hybrid FFI dedup (TRACK_FFI_EXTERN_DEDUP): if an import already exports this
// MLC name, skip local FFI wrapper emit. Otherwise resolve() would emit
// `imported_ns::name` inside the consumer namespace → clang enclose-namespace error.
fn ffi_extern_reuses_imported_binding(name: string, context: CodegenContext) -> bool =
  context.qualified.has(name)

export fn gen_ffi_fn_proto_cpp(
  name: string,
  type_params: [string],
  type_bounds: [[string]],
  params: [Shared<Param>],
  return_type: Shared<Type>,
  escape_info: FnEscapeInfo,
  context: CodegenContext
) -> Shared<CppDeclaration> =
  if ffi_extern_reuses_imported_binding(name, context) then empty_cpp_declaration()
  else gen_fn_proto_cpp_with_escape(name, type_params, type_bounds, params, return_type, escape_info, context)

export fn gen_ffi_fn_decl_cpp(
  name: string,
  type_params: [string],
  type_bounds: [[string]],
  params: [Shared<Param>],
  return_type: Shared<Type>,
  body: Shared<SemanticExpression>,
  escape_info: FnEscapeInfo,
  context: CodegenContext
) -> Shared<CppDeclaration> =
  if ffi_extern_reuses_imported_binding(name, context) then empty_cpp_declaration()
  else do
    const escape_context = context_with_fn_escape_cpp(context, escape_info)
    const body_context = compute_fn_body_context(name, params, escape_context)
      .with_enclosing_function_return_type(return_type)
    const prototype_context = if params.length() > 0 && params[0].name == 'self' then body_context else escape_context end
    // Local definition must not use imported qualification (qualified map).
    const safe_name = cpp_safe(name)
    const return_type_cpp = sem_type_to_cpp(prototype_context, return_type)
    const parameters = function_parameter_def_items(name, params, prototype_context)
    const extern_c_name = semantic_extern_ffi_c_name(body)
    const binder_name = "mlc_ffi_bind_" + cpp_safe(name)
    const signature_params = ffi_parameter_type_items(params, prototype_context).join(', ')
    const call_argument_expressions = ffi_parameter_name_items(params).map(parameter_name =>
      emit_helpers.make_identifier_cpp_expression(parameter_name))
    const function_pointer_type = Shared.new(CppTypeName(
      return_type_cpp + "(*)(" + signature_params + ")"))
    const binder_statement = emit_helpers.make_static_auto_cpp_statement(
      binder_name,
      Shared.new(CppCast(
        CppCastStatic,
        function_pointer_type,
        Shared.new(CppUnary(
          "&",
          emit_helpers.make_identifier_cpp_expression("::" + extern_c_name))))))
    const return_statement = emit_helpers.make_return_cpp_statement(
      Shared.new(CppCall(
        emit_helpers.make_identifier_cpp_expression(binder_name),
        call_argument_expressions)))
    const all_type_params = merged_function_type_parameters_cpp(type_params, escape_info)
    Shared.new(CppFnDef(
      template_prefix(all_type_params) + requires_clause(type_params, type_bounds),
      return_type_cpp,
      safe_name,
      parameters,
      [binder_statement, return_statement],
      1))
  end

export fn semantic_fn_body_is_extern(method: Shared<SemanticDeclaration>) -> bool =
  match method {
    SemanticDeclarationFn(_, _, _, _, _, body, _, _, _) => semantic_expression_is_extern(body),
    _ => false
  }
