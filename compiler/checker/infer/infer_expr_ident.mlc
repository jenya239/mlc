// Identifier resolution for expression inference (no calls to infer_expr).

import { CheckContext } from '../check/check_context'
import { InferResult, infer_ok } from './infer_result'
import { Type, TUnknown, TNamed, TGeneric, TypeRegistry } from '../registry'
import { named_type_name_from_type } from '../semantic_type_structure'

fn generic_type_with_unknown_arguments(type_name: string, argument_count: i32) -> Shared<Type> = do
  let type_arguments: [Shared<Type>] = []
  let mut index = 0
  while index < argument_count do
    type_arguments.push(Shared.new(TUnknown))
    index = index + 1
  end
  Shared.new(TGeneric(type_name, type_arguments))
end

export fn instantiated_constructor_value_type(
  registry: TypeRegistry,
  constructor_name: string,
  expected_type: Shared<Type>
) -> Shared<Type> = do
  const constructor_type = registry.ctor_type(constructor_name)
  const owner_name = named_type_name_from_type(constructor_type)
  const type_parameter_names = registry.algebraic_decl_type_parameter_names_for(owner_name)
  if type_parameter_names.length() == 0 then return constructor_type end
  match expected_type {
    TGeneric(expected_name, expected_arguments) =>
      if expected_name == owner_name && expected_arguments.length() == type_parameter_names.length() then
        expected_type
      else
        generic_type_with_unknown_arguments(owner_name, type_parameter_names.length())
      end,
    _ => generic_type_with_unknown_arguments(owner_name, type_parameter_names.length())
  }
end

export fn infer_expr_identifier(name: string, inference_context: CheckContext) -> InferResult =
  if inference_context.type_env.has(name) then infer_ok(inference_context.type_env.get(name))
  else if inference_context.registry.has_fn(name) then infer_ok(inference_context.registry.fn_type(name))
  else if inference_context.registry.has_ctor(name) then
    infer_ok(instantiated_constructor_value_type(
      inference_context.registry, name, inference_context.expected_return_type))
  else if inference_context.registry.adt_index.algebraic_decl_type_parameter_names.has(name) then
    infer_ok(Shared.new(TNamed(name)))
  else infer_ok(Shared.new(TUnknown))
  end
