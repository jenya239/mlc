// Call-argument dispatch helpers for AST -> SemanticIR transform.
// Extracted from transform.mlc (§104-12 slice 3, compiler architecture hygiene):
// transform_expr / transform_exprs / transform_expr_lambda_with_param_types stay in
// transform.mlc, so the functions below take them as injected parameters to avoid
// recreating the cycle transform_context.mlc (slice 2) was built to break.

import { Expr, Stmt, Span } from '../../frontend/ast'
import { Type, TUnknown } from '../registry'
import { SemanticExpression, sexpr_type } from '../../ir/semantic_ir'
import { coerce_expr_to_type } from './transform_coerce'
import { partial_application_desugar_expr } from './partial_application_desugar'
import { TransformContext, TransformStmtsResult } from './transform_context'

export fn callee_semantic_type_is_function(type_value: Shared<Type>) -> bool =
  match type_value {
    TFn(_, _) => true,
    TGeneric(name, _) => name == '__ExternFn',
    TI32 => false,
    TString => false,
    TBool => false,
    TUnit => false,
    TI64 => false,
    TF64 => false,
    TU8 => false,
    TUsize => false,
    TChar => false,
    TShared(_) => false,
    TNamed(_) => false,
    TArray(_) => false,
    TPair(_, _) => false,
    TTuple(_) => false,
    TAssoc(_, _) => false,
    TUnknown => false
  }

export fn function_parameter_types_from_callee_type(type_value: Shared<Type>) -> [Shared<Type>] =
  match type_value {
    TFn(parameter_types, _) => parameter_types,
    TGeneric(name, type_arguments) =>
      if name == '__ExternFn' then type_arguments.drop(1)
      else do const empty: [Shared<Type>] = []; empty end
      end,
    TI32 => do const empty: [Shared<Type>] = []; empty end,
    TString => do const empty: [Shared<Type>] = []; empty end,
    TBool => do const empty: [Shared<Type>] = []; empty end,
    TUnit => do const empty: [Shared<Type>] = []; empty end,
    TI64 => do const empty: [Shared<Type>] = []; empty end,
    TF64 => do const empty: [Shared<Type>] = []; empty end,
    TU8 => do const empty: [Shared<Type>] = []; empty end,
    TUsize => do const empty: [Shared<Type>] = []; empty end,
    TChar => do const empty: [Shared<Type>] = []; empty end,
    TShared(_) => do const empty: [Shared<Type>] = []; empty end,
    TNamed(_) => do const empty: [Shared<Type>] = []; empty end,
    TArray(_) => do const empty: [Shared<Type>] = []; empty end,
    TPair(_, _) => do const empty: [Shared<Type>] = []; empty end,
    TTuple(_) => do const empty: [Shared<Type>] = []; empty end,
    TAssoc(_, _) => do const empty: [Shared<Type>] = []; empty end,
    TUnknown => do const empty: [Shared<Type>] = []; empty end
  }

export fn call_argument_is_lambda(argument_expression: Shared<Expr>) -> bool =
  match argument_expression {
    ExprLambda(_, _, _) => true,
    ExprInt(_, _) => false,
    ExprStr(_, _) => false,
    ExprBool(_, _) => false,
    ExprUnit(_) => false,
    ExprFloat(_, _) => false,
    ExprI64(_, _) => false,
    ExprU8(_, _) => false,
    ExprUsize(_, _) => false,
    ExprChar(_, _) => false,
    ExprIdent(_, _) => false,
    ExprBin(_, _, _, _) => false,
    ExprUn(_, _, _) => false,
    ExprCall(_, _, _) => false,
    ExprMethod(_, _, _, _) => false,
    ExprField(_, _, _) => false,
    ExprIndex(_, _, _) => false,
    ExprIf(_, _, _, _) => false,
    ExprBlock(_, _, _) => false,
    ExprWhile(_, _, _) => false,
    ExprFor(_, _, _, _) => false,
    ExprMatch(_, _, _) => false,
    ExprRecord(_, _, _) => false,
    ExprRecordUpdate(_, _, _, _) => false,
    ExprArray(_, _) => false,
    ExprTuple(_, _) => false,
    ExprQuestion(_, _) => false,
    ExprExtern(_, _, _, _) => false,
    ExprSpawn(_, _) => false,
    ExprNamedArg(_, _, _) => false,
    ExprWith(_, _, _, _) => false,
    ExprScope(_, _, _) => false,
    ExprRegion(_, _, _) => false
  }

export fn expected_call_argument_type_at_index(
  argument_index: i32,
  expected_formal_parameter_types: [Shared<Type>]
) -> Shared<Type> =
  if argument_index < expected_formal_parameter_types.length() then
    expected_formal_parameter_types[argument_index]
  else Shared.new(TUnknown) end

export fn transform_lambda_call_argument(
  parameter_names: [string],
  lambda_body: Shared<Expr>,
  lambda_span: Span,
  expected_formal_parameter_type: Shared<Type>,
  argument_expression_shared: Shared<Expr>,
  transform_context: TransformContext,
  stmts_fn: ([Shared<Stmt>], TransformContext) -> TransformStmtsResult,
  transform_expr_fn: (Shared<Expr>, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>,
  transform_expr_lambda_with_param_types_fn: ([string], [Shared<Type>], Shared<Expr>, Span, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>
) -> Shared<SemanticExpression> = do
  if callee_semantic_type_is_function(expected_formal_parameter_type) then
    transform_expr_lambda_with_param_types_fn(
      parameter_names,
      function_parameter_types_from_callee_type(expected_formal_parameter_type),
      lambda_body,
      lambda_span,
      transform_context,
      stmts_fn)
  else transform_expr_fn(argument_expression_shared, transform_context, stmts_fn) end
end

export fn transform_one_call_argument_using_optional_expected_type(
  argument_expression_shared: Shared<Expr>,
  expected_formal_parameter_type: Shared<Type>,
  transform_context: TransformContext,
  stmts_fn: ([Shared<Stmt>], TransformContext) -> TransformStmtsResult,
  transform_expr_fn: (Shared<Expr>, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>,
  transform_expr_lambda_with_param_types_fn: ([string], [Shared<Type>], Shared<Expr>, Span, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>
) -> Shared<SemanticExpression> = do
  const argument_partially_desugared_shared_expression = partial_application_desugar_expr(argument_expression_shared)
  if call_argument_is_lambda(argument_partially_desugared_shared_expression) then
    match argument_partially_desugared_shared_expression {
      ExprLambda(parameter_names, lambda_body, lambda_span) =>
        transform_lambda_call_argument(
          parameter_names,
          lambda_body,
          lambda_span,
          expected_formal_parameter_type,
          argument_expression_shared,
          transform_context,
          stmts_fn,
          transform_expr_fn,
          transform_expr_lambda_with_param_types_fn),
      ExprInt(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprStr(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprBool(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprUnit(_) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprFloat(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprI64(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprU8(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprUsize(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprChar(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprIdent(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprBin(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprUn(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprCall(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprMethod(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprField(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprIndex(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprIf(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprBlock(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprWhile(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprFor(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprMatch(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprRecord(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprRecordUpdate(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprArray(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprTuple(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprQuestion(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprExtern(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprSpawn(_, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprNamedArg(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprWith(_, _, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprScope(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type),
      ExprRegion(_, _, _) =>
        coerce_expr_to_type(
          transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
          expected_formal_parameter_type)
    }
  else
    coerce_expr_to_type(
      transform_expr_fn(argument_expression_shared, transform_context, stmts_fn),
      expected_formal_parameter_type)
  end
end

type Transform_call_arguments_fold_state = Transform_call_arguments_fold_state {
  transformed_arguments: [Shared<SemanticExpression>],
  next_argument_index:   i32,
}

export fn function_return_type_from_callee_type(type_value: Shared<Type>) -> Shared<Type> =
  match type_value {
    TFn(_, return_type) => return_type,
    TGeneric(name, type_arguments) =>
      if name == '__ExternFn' && type_arguments.length() >= 1 then type_arguments[0]
      else Shared.new(TUnknown)
      end,
    TI32 => Shared.new(TUnknown),
    TString => Shared.new(TUnknown),
    TBool => Shared.new(TUnknown),
    TUnit => Shared.new(TUnknown),
    TI64 => Shared.new(TUnknown),
    TF64 => Shared.new(TUnknown),
    TU8 => Shared.new(TUnknown),
    TUsize => Shared.new(TUnknown),
    TChar => Shared.new(TUnknown),
    TShared(_) => Shared.new(TUnknown),
    TNamed(_) => Shared.new(TUnknown),
    TArray(_) => Shared.new(TUnknown),
    TPair(_, _) => Shared.new(TUnknown),
    TTuple(_) => Shared.new(TUnknown),
    TAssoc(_, _) => Shared.new(TUnknown),
    TUnknown => Shared.new(TUnknown)
  }

fn transform_call_arguments_fold_step(
  state: Transform_call_arguments_fold_state,
  argument_expression: Shared<Expr>,
  expected_formal_parameter_types: [Shared<Type>],
  transform_context: TransformContext,
  stmts_fn: ([Shared<Stmt>], TransformContext) -> TransformStmtsResult,
  transform_expr_fn: (Shared<Expr>, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>,
  transform_expr_lambda_with_param_types_fn: ([string], [Shared<Type>], Shared<Expr>, Span, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>
) -> Transform_call_arguments_fold_state =
  Transform_call_arguments_fold_state {
    transformed_arguments: state.transformed_arguments.concat([
      transform_one_call_argument_using_optional_expected_type(
        argument_expression,
        expected_call_argument_type_at_index(state.next_argument_index, expected_formal_parameter_types),
        transform_context,
        stmts_fn,
        transform_expr_fn,
        transform_expr_lambda_with_param_types_fn)]),
    next_argument_index: state.next_argument_index + 1,
  }

export fn transform_call_arguments_using_callee_semantic_type(
  callee_semantic_expression: Shared<SemanticExpression>,
  argument_expressions_under_call: [Shared<Expr>],
  transform_context: TransformContext,
  stmts_fn: ([Shared<Stmt>], TransformContext) -> TransformStmtsResult,
  transform_expr_fn: (Shared<Expr>, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>,
  transform_expr_lambda_with_param_types_fn: ([string], [Shared<Type>], Shared<Expr>, Span, TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> Shared<SemanticExpression>,
  transform_exprs_fn: ([Shared<Expr>], TransformContext, ([Shared<Stmt>], TransformContext) -> TransformStmtsResult) -> [Shared<SemanticExpression>]
) -> [Shared<SemanticExpression>] = do
  const callee_type = sexpr_type(callee_semantic_expression)
  if callee_semantic_type_is_function(callee_type) then
    argument_expressions_under_call
      .fold(
        Transform_call_arguments_fold_state {
          transformed_arguments: [],
          next_argument_index:   0,
        },
        (state, argument_expression) =>
          transform_call_arguments_fold_step(
            state,
            argument_expression,
            function_parameter_types_from_callee_type(callee_type),
            transform_context,
            stmts_fn,
            transform_expr_fn,
            transform_expr_lambda_with_param_types_fn))
      .transformed_arguments
  else transform_exprs_fn(argument_expressions_under_call, transform_context, stmts_fn) end
end
