import { Pattern } from '../../frontend/ast'
import { Type, TypeRegistry, TNamed, TGeneric, TArray, TUnknown } from '../registry'
import { substitute_type } from '../semantic_type_structure'
import { substitution_from_generic } from '../substitution'

type Constructor_pattern_environment_fold_state = Constructor_pattern_environment_fold_state {
  environment:                             Map<string, Shared<Type>>,
  next_constructor_subpattern_index: i32,
}

fn array_pattern_element_type(type_value: Shared<Type>) -> Shared<Type> =
  match type_value {
    TArray(element_type) => element_type,
    _ => Shared.new(TUnknown)
  }

fn environment_after_array_pattern_elements(
  type_environment: Map<string, Shared<Type>>,
  element_patterns: [Shared<Pattern>],
  element_type: Shared<Type>,
  registry: TypeRegistry
) -> Map<string, Shared<Type>> =
  element_patterns.fold(
    type_environment,
    (environment, element_pattern) =>
      env_for_pattern_with_type(environment, element_pattern, element_type, registry))

fn semantic_type_nominal_name(type_value: Shared<Type>) -> string =
  match type_value {
    TNamed(name) => name,
    TGeneric(name, _) => name,
    _ => ''
  }

fn substitution_for_constructor_scrutinee(
  constructor_name: string,
  scrutinee_type: Shared<Type>,
  registry: TypeRegistry
) -> Map<string, Shared<Type>> = do
  const empty_substitution: Map<string, Shared<Type>> = Map.new()
  if !registry.has_ctor(constructor_name) then empty_substitution
  else do
    const constructor_type_name = semantic_type_nominal_name(registry.ctor_type(constructor_name))
    const scrutinee_type_name = semantic_type_nominal_name(scrutinee_type)
    if constructor_type_name != '' && constructor_type_name == scrutinee_type_name then
      substitution_from_generic(scrutinee_type, registry)
    else empty_substitution
    end
  end
  end
end

export fn env_for_pattern_with_type(type_environment: Map<string, Shared<Type>>, pattern: Shared<Pattern>, type_value: Shared<Type>, registry: TypeRegistry) -> Map<string, Shared<Type>> = do
  match pattern {
    PatternIdent(binding_name, _) => do let environment = type_environment; environment.set(binding_name, type_value); environment end,
    PatternOr(alts, _) => if alts.length() > 0 then env_for_pattern_with_type(type_environment, alts[0], type_value, registry) else type_environment end,
    PatternCtor(constructor_name, sub_patterns, _) => do
      const parameter_types = registry.ctor_params_for(constructor_name)
      const substitution = substitution_for_constructor_scrutinee(constructor_name, type_value, registry)
      environment_after_all_constructor_subpatterns(
        type_environment, sub_patterns, parameter_types, substitution, registry)
    end,
    PatternArray(element_patterns, _, _) =>
      environment_after_array_pattern_elements(
        type_environment, element_patterns, array_pattern_element_type(type_value), registry),
    _ => env_for_pattern(type_environment, pattern, registry)
  }
end

fn constructor_subpattern_environment_fold_step(
  accumulator: Constructor_pattern_environment_fold_state,
  sub_pattern_value: Shared<Pattern>,
  parameter_types: [Shared<Type>],
  parameter_type_substitution: Map<string, Shared<Type>>,
  registry: TypeRegistry
) -> Constructor_pattern_environment_fold_state = do
  const current_subpattern_index = accumulator.next_constructor_subpattern_index
  const raw_constructor_parameter_type =
    if current_subpattern_index < parameter_types.length()
    then parameter_types[current_subpattern_index]
    else Shared.new(TUnknown)
    end
  const resolved_constructor_subpattern_type =
    substitute_type(raw_constructor_parameter_type, parameter_type_substitution)
  const next_environment_after_subpattern =
    env_for_pattern_with_type(
      accumulator.environment,
      sub_pattern_value,
      resolved_constructor_subpattern_type,
      registry)
  Constructor_pattern_environment_fold_state {
    environment:                       next_environment_after_subpattern,
    next_constructor_subpattern_index: current_subpattern_index + 1,
  }
end

fn environment_after_all_constructor_subpatterns(
  initial_environment: Map<string, Shared<Type>>,
  sub_patterns: [Shared<Pattern>],
  parameter_types: [Shared<Type>],
  parameter_type_substitution: Map<string, Shared<Type>>,
  registry: TypeRegistry
) -> Map<string, Shared<Type>> =
  sub_patterns
    .fold(
      Constructor_pattern_environment_fold_state {
        environment:                             initial_environment,
        next_constructor_subpattern_index:       0,
      },
      (accumulator, sub_pattern_value) =>
        constructor_subpattern_environment_fold_step(
          accumulator,
          sub_pattern_value,
          parameter_types,
          parameter_type_substitution,
          registry))
    .environment

export fn env_for_pattern(type_environment: Map<string, Shared<Type>>, pattern: Shared<Pattern>, registry: TypeRegistry) -> Map<string, Shared<Type>> = do
  match pattern {
    PatternIdent(binding_name, _) => do let environment = type_environment; environment.set(binding_name, Shared.new(TUnknown)); environment end,
    PatternCtor(constructor_name, sub_patterns, _) => do
      const parameter_types = registry.ctor_params_for(constructor_name)
      const empty_type_parameter_substitution: Map<string, Shared<Type>> = Map.new()
      environment_after_all_constructor_subpatterns(
        type_environment, sub_patterns, parameter_types, empty_type_parameter_substitution, registry)
    end,
    PatternOr(alts, _) => if alts.length() > 0 then env_for_pattern(type_environment, alts[0], registry) else type_environment end,
    _ => type_environment
  }
end

export fn env_for_pattern_substituted(
  type_environment: Map<string, Shared<Type>>,
  pattern: Shared<Pattern>,
  registry: TypeRegistry,
  substitution: Map<string, Shared<Type>>,
  scrutinee_type: Shared<Type>
) -> Map<string, Shared<Type>> = do
  match pattern {
    PatternIdent(binding_name, _) => do
      let environment = type_environment
      environment.set(binding_name, substitute_type(scrutinee_type, substitution))
      environment
    end,
    PatternCtor(constructor_name, sub_patterns, _) => do
      const parameter_types = registry.ctor_params_for(constructor_name)
      environment_after_all_constructor_subpatterns(
        type_environment, sub_patterns, parameter_types, substitution, registry)
    end,
    PatternOr(alts, _) =>
      if alts.length() > 0
      then env_for_pattern_substituted(type_environment, alts[0], registry, substitution, scrutinee_type)
      else type_environment
      end,
    _ => type_environment
  }
end