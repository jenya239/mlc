//! @module std/net/https_client
//! @category net
//! @type mixed
//!
//! Blocking HTTPS. Validation and header parsing stay in https_request.mlc.
//! Curl is reached only through curl_abi.hpp.
//! https_send opens one easy handle per call. A session keeps one easy handle
//! across https_session_send calls. https_live_handle_count exists for leak checks.

module HttpsClient

import {
  https_request_problem,
  https_header_lines,
  parse_response_header_block,
  https_failure_kind_from_code,
  HttpsHeader,
  HttpsRequest,
  HttpsResponse,
  HttpsFailure,
  HttpsResult,
  HttpsOk,
  HttpsErr,
  InvalidRequest,
  TransportFailed
} from './https_request.mlc'

extern lib "curl"

extern fn perform_request(
  method: string,
  url: string,
  header_lines: string,
  body: string,
  timeout_milliseconds: i32,
  max_response_bytes: i32,
  ca_bundle_path: string,
  proxy_url: string
) -> i32 =
  "mlc::curl_abi::perform_request" from "mlc/net/curl_abi.hpp" blocking

extern fn perform_request_with_stop(
  method: string,
  url: string,
  header_lines: string,
  body: string,
  timeout_milliseconds: i32,
  max_response_bytes: i32,
  ca_bundle_path: string,
  proxy_url: string,
  stop_token: StopToken
) -> i32 =
  "mlc::curl_abi::perform_request_with_stop" from "mlc/net/curl_abi.hpp" blocking

extern fn result_status(handle: i32) -> i32 =
  "mlc::curl_abi::result_status" from "mlc/net/curl_abi.hpp" thread_safe

extern fn result_failure_code(handle: i32) -> i32 =
  "mlc::curl_abi::result_failure_code" from "mlc/net/curl_abi.hpp" thread_safe

extern fn result_message(handle: i32) -> string =
  "mlc::curl_abi::result_message" from "mlc/net/curl_abi.hpp" thread_safe

extern fn result_header_block(handle: i32) -> string =
  "mlc::curl_abi::result_header_block" from "mlc/net/curl_abi.hpp" thread_safe

extern fn result_body(handle: i32) -> string =
  "mlc::curl_abi::result_body" from "mlc/net/curl_abi.hpp" thread_safe

extern fn release_result(handle: i32) -> i32 =
  "mlc::curl_abi::release_result" from "mlc/net/curl_abi.hpp" thread_safe

extern fn live_result_count() -> i32 =
  "mlc::curl_abi::live_result_count" from "mlc/net/curl_abi.hpp" thread_safe

extern fn session_open() -> i32 =
  "mlc::curl_abi::session_open" from "mlc/net/curl_abi.hpp" thread_safe

extern fn session_close(session: i32) -> i32 =
  "mlc::curl_abi::session_close" from "mlc/net/curl_abi.hpp" thread_safe

extern fn live_session_count() -> i32 =
  "mlc::curl_abi::live_session_count" from "mlc/net/curl_abi.hpp" thread_safe

extern fn session_perform(
  session: i32,
  method: string,
  url: string,
  header_lines: string,
  body: string,
  timeout_milliseconds: i32,
  max_response_bytes: i32,
  ca_bundle_path: string,
  proxy_url: string
) -> i32 =
  "mlc::curl_abi::session_perform" from "mlc/net/curl_abi.hpp" blocking

fn result_from_handle(handle: i32) -> HttpsResult = do
  const status = result_status(handle)
  const failure_code = result_failure_code(handle)
  const message = result_message(handle)
  const header_block = result_header_block(handle)
  const body = result_body(handle)
  release_result(handle)
  if failure_code != 0 then
    HttpsErr(HttpsFailure {
      kind: https_failure_kind_from_code(failure_code),
      message: message
    })
  else
    HttpsOk(HttpsResponse {
      status: status,
      headers: parse_response_header_block(header_block),
      body: body
    })
  end
end

fn send_after_validation(request: HttpsRequest) -> HttpsResult = do
  const handle = perform_request(
    request.method,
    request.url,
    https_header_lines(request.headers),
    request.body,
    request.timeout_milliseconds,
    request.max_response_bytes,
    request.ca_bundle_path,
    request.proxy_url
  )
  if handle < 0 then
    HttpsErr(HttpsFailure { kind: TransportFailed, message: "result table full" })
  else
    result_from_handle(handle)
  end
end

export fn https_send(request: HttpsRequest) -> HttpsResult = do
  const problem = https_request_problem(request)
  if problem != "" then
    HttpsErr(HttpsFailure { kind: InvalidRequest, message: problem })
  else
    send_after_validation(request)
  end
end

fn send_with_stop_after_validation(request: HttpsRequest, stop_token: StopToken) -> HttpsResult = do
  const handle = perform_request_with_stop(
    request.method,
    request.url,
    https_header_lines(request.headers),
    request.body,
    request.timeout_milliseconds,
    request.max_response_bytes,
    request.ca_bundle_path,
    request.proxy_url,
    stop_token
  )
  if handle < 0 then
    HttpsErr(HttpsFailure { kind: TransportFailed, message: "result table full" })
  else
    result_from_handle(handle)
  end
end

export fn https_send_with_stop(request: HttpsRequest, stop_token: StopToken) -> HttpsResult = do
  const problem = https_request_problem(request)
  if problem != "" then
    HttpsErr(HttpsFailure { kind: InvalidRequest, message: problem })
  else
    send_with_stop_after_validation(request, stop_token)
  end
end

fn request_with_defaults(
  method: string,
  url: string,
  headers: [HttpsHeader],
  body: string
) -> HttpsRequest =
  HttpsRequest {
    method: method,
    url: url,
    headers: headers,
    body: body,
    timeout_milliseconds: 30000,
    max_response_bytes: 4194304,
    ca_bundle_path: "",
    proxy_url: ""
  }

export fn https_get(url: string, headers: [HttpsHeader]) -> HttpsResult =
  https_send(request_with_defaults("GET", url, headers, ""))

export fn https_head(url: string, headers: [HttpsHeader]) -> HttpsResult =
  https_send(request_with_defaults("HEAD", url, headers, ""))

export fn https_post(url: string, headers: [HttpsHeader], body: string) -> HttpsResult =
  https_send(request_with_defaults("POST", url, headers, body))

export fn https_put(url: string, headers: [HttpsHeader], body: string) -> HttpsResult =
  https_send(request_with_defaults("PUT", url, headers, body))

export fn https_patch(url: string, headers: [HttpsHeader], body: string) -> HttpsResult =
  https_send(request_with_defaults("PATCH", url, headers, body))

export fn https_delete(url: string, headers: [HttpsHeader], body: string) -> HttpsResult =
  https_send(request_with_defaults("DELETE", url, headers, body))

export fn https_live_handle_count() -> i32 =
  live_result_count()

fn session_send_after_validation(session: i32, request: HttpsRequest) -> HttpsResult = do
  const handle = session_perform(
    session,
    request.method,
    request.url,
    https_header_lines(request.headers),
    request.body,
    request.timeout_milliseconds,
    request.max_response_bytes,
    request.ca_bundle_path,
    request.proxy_url
  )
  if handle < 0 then
    HttpsErr(HttpsFailure { kind: TransportFailed, message: "result table full" })
  else
    result_from_handle(handle)
  end
end

export fn https_session_open() -> i32 =
  session_open()

export fn https_session_close(session: i32) -> i32 =
  session_close(session)

export fn https_live_session_count() -> i32 =
  live_session_count()

export fn https_session_send(session: i32, request: HttpsRequest) -> HttpsResult = do
  const problem = https_request_problem(request)
  if problem != "" then
    HttpsErr(HttpsFailure { kind: InvalidRequest, message: problem })
  else
    session_send_after_validation(session, request)
  end
end
